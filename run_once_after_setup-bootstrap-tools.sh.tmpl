#!/bin/bash
set -eufo pipefail

echo "🔧  Ensuring user directory for system sockets exists..."
RUNTIME_DIR="$TMPDIR/runtime-$UID"
\mkdir -p "$RUNTIME_DIR"
\chmod 0700 "$RUNTIME_DIR"

# system-update is the canonical "everything at latest" implementation
# (also exposed as the user-facing `system-update` command). On a fresh
# machine it installs Brewfile contents + mise tools + Yazi plugins +
# NeoVim plugins + z4h. On an already-bootstrapped machine, it brings
# everything to latest. Either way the post-state is identical, which
# closes the gap where this script previously assumed mise/gh/nvim/etc.
# were already installed.
echo "♻️  Running system-update to converge tools to latest..."
"$HOME/.local/bin/system-update"

# Rust nightly isn't pinned in any tool manifest, so `mise upgrade` inside
# system-update doesn't catch it. Add it once mise itself is installed.
echo "🦀  Installing Rust nightly..."
mise install rust@nightly -q

# vim:ft=sh
