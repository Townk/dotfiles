{{- $p := index .theme.palettes .theme.active -}}
{{- $r := .theme.roles -}}
# chezmoi-system tmux theme — GENERATED from .chezmoidata/theme.yaml. DO NOT EDIT.
# ({{ $p.meta.name }})
#
# Canonical file: rendered to ~/.config/tmux/themes/chezmoi-system-base.conf by
# custom-builds/theme/generate-theme.sh. theme-apply derives the effective
# chezmoi-system.conf from it by substituting any per-machine override tokens
# (#hex → #hex, remote sessions only) and live-reloads running tmux servers via
# `source-file` (D15). Substitution contract: colors are lowercase #rrggbb
# literals; every hex here MUST come from a theme.yaml slot so theme-apply can
# map override tokens back to it.
#
# Scope: dialogs/popups, panes, copy-mode (Phase 0) + the status-bar palette
# (Phase 4, D6). Layout/assembly lives in status.conf — this file carries
# every static COLOR the bar uses, as %hidden window-pill fragments where
# color and content are inseparable. The right-side gradient ribbon is
# rendered live by tmux-status-right (colors from the theme JSON).

# Status line (Phase 4, D6) — the zj-hud bar look. The bar canvas follows
# the zellij bar's resolve_bar_bg (text_unselected background = ui.bg, the
# BASE — not the dialog mantle).
set -g status-style "bg=#{{ index $p $r.ui.bg }},fg=#{{ index $p $r.ui.fg_dim }}"

# Window "tab" pills — zj-hud tab chrome ($p.tab: the SAME slots the zellij
# bar uses): a bold pill closed by a ▌ edge glyph in the pill color over
# the bar. Body mirrors compose_tab_title's priority: user-renamed window ->
# tab icon + name; shell -> home/folder icon + ~-collapsed cwd (tail-kept
# truncation); any other command -> run icon + name. Extra icons: zoom,
# synced panes, alarm armed (monitor option set) / fired (alert flag, in
# attention yellow). Composed into window-status-format by status.conf.
%hidden win_alarm="#{?window_activity_flag, #[fg=#{{ index $p $r.action.attention }}]󰂞,#{?window_silence_flag, #[fg=#{{ index $p $r.action.attention }}]󰂠,#{?#{||:#{==:#{monitor-activity},on},#{!=:#{monitor-silence},0}}, ,}}}"
%hidden win_extras="#{?window_zoomed_flag, 󰖯,}#{?#{==:#{synchronize-panes},on}, ,}$win_alarm"
{{/* Per-process icon, generated from .muxTabIcons — the tmux half of
     zj-hud's icons::process_icon. A nested #{?} chain rather than a #()
     lookup: the pill is expanded for every window on every redraw, and a
     format costs nothing where a fork would cost one process per window.
     Unlisted commands fall through to the generic run glyph. */ -}}
{{- $icon := "󰜎" -}}
{{- range $proc, $glyph := .muxTabIcons -}}
{{- $icon = printf "#{?#{==:#{pane_current_command},%s},%s,%s}" $proc $glyph $icon -}}
{{- end -}}
%hidden win_proc_icon="{{ $icon }}"
%hidden win_body="#{?#{automatic-rename},#{?#{||:#{==:#{pane_current_command},zsh},#{==:#{pane_current_command},bash}},#{?#{==:#{pane_current_path},{{ .chezmoi.homeDir }}},󰋜 ~,󰝰 #{?#{@win_path},#{@win_path},#{=|-28|…:#{s|^{{ .chezmoi.homeDir }}|~|:#{pane_current_path}}}}},$win_proc_icon #W},#{?#{@win_icon},#{@win_icon} #W,󰓩 #W}}"
%hidden win_pill="#[bold,bg=#{{ $p.tab.bg }},fg=#{{ $p.tab.fg }}] #I $win_body$win_extras #[bg=#{{ index $p $r.ui.bg }},fg=#{{ $p.tab.bg }}]▌"
%hidden win_pill_current="#[bold,bg=#{{ $p.tab.active_bg }},fg=#{{ $p.tab.active_fg }}] #I $win_body$win_extras #[bg=#{{ index $p $r.ui.bg }},fg=#{{ $p.tab.active_bg }}]▌"
# Reassemble these here as well as in status.conf: theme-apply live-reloads
# this file alone, and %hidden variables do not retroactively update options
# that expanded them during tmux startup.
setw -g window-status-format "$win_pill"
setw -g window-status-current-format "$win_pill_current"

# Command prompt / messages (mirrors the dialog canvas).
set -g message-style "bg=#{{ index $p $r.ui.dialog_bg }},fg=#{{ index $p $r.ui.fg }}"
set -g message-command-style "bg=#{{ index $p $r.ui.dialog_bg }},fg=#{{ index $p $r.ui.fg }}"

# Popups (display-popup) — the modal canvas: dialog_bg body, border_focus
# frame, rounded corners (parity with zellij's ui.pane_frames.rounded_corners
# on framed dialogs).
set -g popup-style "bg=#{{ index $p $r.ui.dialog_bg }},fg=#{{ index $p $r.ui.fg }}"
set -g popup-border-style "bg=#{{ index $p $r.ui.dialog_bg }},fg=#{{ index $p $r.ui.border_focus }}"
set -g popup-border-lines rounded

# Pane borders — focus follows ui.border_focus, rest are explicit-dim
# (parity with zellij frame_selected / pane_frames false aesthetics).
set -g pane-border-style "fg=#{{ index $p $r.ui.border_inactive }}"
set -g pane-active-border-style "fg=#{{ index $p $r.ui.border_focus }}"

# Pane-frame titles (prefix f toggle — zellij TogglePaneFrames twin; the
# toggle + default-off live in status.conf/keymap). Active title follows
# border_focus so the focused frame reads like zellij's selected frame.
setw -g pane-border-format " #{?pane_active,#[fg=#{{ index $p $r.ui.border_focus }}],#[fg=#{{ index $p $r.ui.border_inactive }}]}#{pane_index} #{pane_title}#[default] "

# Copy-mode: selection + search-match washes (search dialog proper is D12).
set -g mode-style "bg=#{{ index $p $r.ui.selection }},fg=#{{ index $p $r.ui.fg }}"
set -g copy-mode-match-style "bg=#{{ $p.find_highlight }},fg=#{{ index $p $r.ui.fg }}"
set -g copy-mode-current-match-style "bg=#{{ index $p $r.action.attention }},fg=#{{ index $p $r.ui.bg }}"

# Misc chrome.
set -g display-panes-active-colour "#{{ index $p $r.ui.border_focus }}"
set -g display-panes-colour "#{{ index $p $r.ui.muted }}"
setw -g clock-mode-colour "#{{ index $p $r.ui.accent }}"
