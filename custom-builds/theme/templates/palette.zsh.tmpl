#!/usr/bin/env zsh
{{ $p := index .theme.palettes .theme.active -}}
{{ $r := .theme.roles -}}
# palette.zsh — GENERATED from .chezmoidata/theme.yaml by chezmoi. DO NOT EDIT.
#
# The single-source palette projected for the shell layer, resolved from the
# ACTIVE theme ({{ $p.meta.name }}):
#   * C_HEX_*  — bare hex, ungated (always set; safe when stdout is captured,
#     e.g. passed as --theme-* args to ai-playbook input). The full canonical
#     vocabulary, plus the dialog variants (C_HEX_DIALOG_*) and the zj-hud
#     tab chrome (C_HEX_TAB_*).
#   * C_ROLE_* — bare hex for the shared SEMANTIC roles (ui/state/action),
#     resolved from the active palette. Prefer these over raw slots so a theme
#     switch re-colors callers automatically.
#   * C_*      — truecolor SGR foreground twins for the dialog/log family, gated
#     on an interactive stdout. Built with builtin arithmetic (no subshells), so
#     sourcing this at interactive startup is fork-free.
# Sourced by ~/.local/lib/common.zsh, and directly by completion.sh (fzf colors).

[ -n "${__THEME_PALETTE_LOADED:-}" ] && return 0
__THEME_PALETTE_LOADED=1

# --- canonical vocabulary (bare hex, ungated) ------------------------------
C_HEX_ROSEWATER="#{{ $p.rosewater }}"
C_HEX_FLAMINGO="#{{ $p.flamingo }}"
C_HEX_PINK="#{{ $p.pink }}"
C_HEX_MAUVE="#{{ $p.mauve }}"
C_HEX_RED="#{{ $p.red }}"
C_HEX_MAROON="#{{ $p.maroon }}"
C_HEX_PEACH="#{{ $p.peach }}"
C_HEX_YELLOW="#{{ $p.yellow }}"
C_HEX_GREEN="#{{ $p.green }}"
C_HEX_TEAL="#{{ $p.teal }}"
C_HEX_SKY="#{{ $p.sky }}"
C_HEX_SAPPHIRE="#{{ $p.sapphire }}"
C_HEX_BLUE="#{{ $p.blue }}"
C_HEX_LAVENDER="#{{ $p.lavender }}"
C_HEX_TEXT="#{{ $p.text }}"
C_HEX_SUBTEXT1="#{{ $p.subtext1 }}"
C_HEX_SUBTEXT0="#{{ $p.subtext0 }}"
C_HEX_SUBTEXT="#{{ $p.subtext0 }}"
C_HEX_OVERLAY2="#{{ $p.overlay2 }}"
C_HEX_OVERLAY1="#{{ $p.overlay1 }}"
C_HEX_OVERLAY0="#{{ $p.overlay0 }}"
C_HEX_SURFACE2="#{{ $p.surface2 }}"
C_HEX_SURFACE1="#{{ $p.surface1 }}"
C_HEX_SURFACE0="#{{ $p.surface0 }}"
C_HEX_BASE="#{{ $p.base }}"
C_HEX_MANTLE="#{{ $p.mantle }}"
C_HEX_CRUST="#{{ $p.crust }}"
C_HEX_WHITE="#{{ $p.white }}"
# Semantic alias kept for back-compat (canonical red).
C_HEX_DANGER="#{{ $p.red }}"

# --- dialog variant accents (brighter red / warmer yellow than the base) ----
C_HEX_DIALOG_DANGER="#{{ $p.dialog.danger }}"
C_HEX_DIALOG_WARNING="#{{ $p.dialog.warning }}"

# --- zj-hud status-bar tab chrome -------------------------------------------
C_HEX_TAB_BG="#{{ $p.tab.bg }}"
C_HEX_TAB_FG="#{{ $p.tab.fg }}"
C_HEX_TAB_ACTIVE_BG="#{{ $p.tab.active_bg }}"
C_HEX_TAB_ACTIVE_FG="#{{ $p.tab.active_fg }}"

# --- semantic roles (bare hex; resolved from the active palette) ------------
{{- range $k, $v := $r.ui }}
C_ROLE_UI_{{ $k | upper }}="#{{ index $p $v }}"
{{- end }}
{{- range $k, $v := $r.state }}
C_ROLE_STATE_{{ $k | upper }}="#{{ index $p $v }}"
{{- end }}
{{- range $k, $v := $r.action }}
C_ROLE_ACTION_{{ $k | upper }}="#{{ index $p $v }}"
{{- end }}

# --- truecolor SGR foreground twins (gated; fork-free arithmetic) -----------
if [ -t 1 ]; then
  C_WHITE=$'\e[38;2;'$(( 16#${C_HEX_WHITE:1:2} ))';'$(( 16#${C_HEX_WHITE:3:2} ))';'$(( 16#${C_HEX_WHITE:5:2} ))'m'
  C_MAUVE=$'\e[38;2;'$(( 16#${C_HEX_MAUVE:1:2} ))';'$(( 16#${C_HEX_MAUVE:3:2} ))';'$(( 16#${C_HEX_MAUVE:5:2} ))'m'
  C_TEXT=$'\e[38;2;'$(( 16#${C_HEX_TEXT:1:2} ))';'$(( 16#${C_HEX_TEXT:3:2} ))';'$(( 16#${C_HEX_TEXT:5:2} ))'m'
  C_SUBTEXT=$'\e[38;2;'$(( 16#${C_HEX_SUBTEXT:1:2} ))';'$(( 16#${C_HEX_SUBTEXT:3:2} ))';'$(( 16#${C_HEX_SUBTEXT:5:2} ))'m'
  C_SURFACE0=$'\e[38;2;'$(( 16#${C_HEX_SURFACE0:1:2} ))';'$(( 16#${C_HEX_SURFACE0:3:2} ))';'$(( 16#${C_HEX_SURFACE0:5:2} ))'m'
  C_SURFACE2=$'\e[38;2;'$(( 16#${C_HEX_SURFACE2:1:2} ))';'$(( 16#${C_HEX_SURFACE2:3:2} ))';'$(( 16#${C_HEX_SURFACE2:5:2} ))'m'
  C_OVERLAY0=$'\e[38;2;'$(( 16#${C_HEX_OVERLAY0:1:2} ))';'$(( 16#${C_HEX_OVERLAY0:3:2} ))';'$(( 16#${C_HEX_OVERLAY0:5:2} ))'m'
  C_BASE=$'\e[38;2;'$(( 16#${C_HEX_BASE:1:2} ))';'$(( 16#${C_HEX_BASE:3:2} ))';'$(( 16#${C_HEX_BASE:5:2} ))'m'
  C_DANGER=$'\e[38;2;'$(( 16#${C_HEX_DANGER:1:2} ))';'$(( 16#${C_HEX_DANGER:3:2} ))';'$(( 16#${C_HEX_DANGER:5:2} ))'m'
  C_BOLD=$'\e[1m'
else
  C_WHITE="" C_MAUVE="" C_TEXT="" C_SUBTEXT="" C_SURFACE0="" C_SURFACE2="" \
    C_OVERLAY0="" C_BASE="" C_DANGER="" C_BOLD=""
fi
