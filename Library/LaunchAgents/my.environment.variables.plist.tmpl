<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>my.environment.variables</string>
    <key>ProgramArguments</key>
    <array>
        <string>sh</string>
        <string>-c</string>
        <string>
            launchctl setenv XDG_CONFIG_HOME {{ .chezmoi.homeDir }}/.config;
            launchctl setenv XDG_CACHE_HOME {{ .chezmoi.homeDir }}/.cache;
            launchctl setenv XDG_DATA_HOME {{ .chezmoi.homeDir }}/.local/share;
            launchctl setenv XDG_STATE_HOME {{ .chezmoi.homeDir }}/.local/state;
            launchctl setenv XDG_BIN_HOME {{ .chezmoi.homeDir }}/.local/bin;
        </string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
