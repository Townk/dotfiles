{{- /*
  Files pulled from elsewhere rather than kept in this repo.

  svaloverlay — the Svalboard layer overlay that Hammerspoon's `svalboard`
  module runs (modules/svalboard). Built by the keyboard userspace's CI
  (Townk/qmk-config, tools/svalwatch) and attached to every firmware release
  as one archive: svaloverlay and svalwatch (universal, ad-hoc signed) at its
  root, the overlay page under share/svaloverlay. The URL names the newest
  firmware release's tag, so the overlay's layers always match the firmware's
  keymap. A versioned URL, not releases/latest/download: chezmoi caches an
  external by its URL, so a fixed `latest` URL kept serving the cached
  archive until refreshPeriod ran out, and an apply on a Mac that already
  had it put back the previous release's overlay. Each tag's archive never
  changes, so it needs no refreshPeriod; a new release is a new URL and the
  next `chezmoi apply` fetches it. gitHubLatestRelease is one small API call,
  cached by chezmoi (github.refreshPeriod).

  Every Mac gets it: the overlay stays hidden until a Svalboard is plugged in,
  so a Mac without one never sees it. Files fetched this way carry no
  quarantine flag, so Gatekeeper does not ask for a Developer ID.
*/ -}}
{{- if eq .chezmoi.os "darwin" }}
{{-   $tag := (gitHubLatestRelease "Townk/qmk-config").GetTagName }}
{{-   $overlay := printf "https://github.com/Townk/qmk-config/releases/download/%s/svaloverlay-macos.tar.gz" $tag }}
[".local/bin/svaloverlay"]
    type = "archive-file"
    url = {{ $overlay | quote }}
    path = "svaloverlay"
    executable = true

[".local/bin/svalwatch"]
    type = "archive-file"
    url = {{ $overlay | quote }}
    path = "svalwatch"
    executable = true

[".local/share/svaloverlay"]
    type = "archive"
    url = {{ $overlay | quote }}
    include = ["share/svaloverlay/**"]
    stripComponents = 2
    exact = true
{{- end }}
