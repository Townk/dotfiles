# Personal Zsh configuration file. It is strongly recommended to keep all
# shell customization and configuration (including exported environment
# variables such as PATH) in this file or in files sourced from it.
#
# Documentation: https://github.com/romkatv/zsh4humans/blob/v5/README.md.

# Auto-attach Zellij for interactive shells.
# Done before z4h init so the outer shell doesn't pay for setup twice —
# the shell spawned inside Zellij will run .zshrc again with $ZELLIJ set,
# skipping this block.
#
# "Main" session reuse:
#   - doesn't exist (or only as EXITED) → wipe stale record, create+attach
#   - live, no clients                  → reattach (resume the existing one)
#   - live, has a client                → spawn a fresh anonymous session
#                                         (so Cmd+N etc. get their own mux)
if [[ -z "$ZELLIJ" ]]; then
  for _zellij in /opt/homebrew/bin/zellij /usr/local/bin/zellij /snap/bin/zellij ~/.local/bin/zellij; do
    [[ -x "$_zellij" ]] || continue
    if "$_zellij" list-sessions -n 2>/dev/null | grep -v EXITED | grep -qE '^Main\b'; then
      if "$_zellij" --session Main action list-clients 2>/dev/null \
           | tail -n +2 | grep -q .; then
        exec "$_zellij" --new-session-with-layout default
      else
        # Main is idle → reattach. If the session record is stale, discard it
        # and create a fresh Main with the configured default layout.
        exec "$_zellij" attach Main || {
          "$_zellij" delete-session Main -f &>/dev/null
          exec "$_zellij" --session Main --new-session-with-layout default
        }
      fi
    else
      "$_zellij" delete-session Main -f &>/dev/null
      exec "$_zellij" --session Main --new-session-with-layout default
    fi
  done
  unset _zellij
fi

# Periodic auto-update on Zsh startup: 'ask' or 'no'.
# You can manually run `z4h update` to update everything.
zstyle ':z4h:' auto-update 'no'
# Ask whether to auto-update this often; has no effect if auto-update is 'no'.
zstyle ':z4h:' auto-update-days '28'

# Keyboard type: 'mac' or 'pc'.
zstyle ':z4h:bindkey' keyboard 'mac'

# Don't start tmux.
zstyle ':z4h:' start-tmux no

# Mark up shell's output with semantic information.
zstyle ':z4h:' term-shell-integration 'yes'

# Prevent terminal resize to break scrollback
zstyle ':z4h:' term-vresize top

# Right-arrow key accepts one character ('partial-accept') from
# command autosuggestions or the whole thing ('accept')?
zstyle ':z4h:autosuggestions' forward-char 'accept'

# Recursively traverse directories when TAB-completing files.
zstyle ':z4h:fzf-complete' recurse-dirs 'yes'
# All bindings must go in a single `zstyle` call — each invocation
# replaces the previous values for the same (pattern, style) pair, so
# four separate lines would leave only the last one in effect. fzf
# also wants `ctrl-X`, not `ctrl+X`, or it rejects the whole --bind.
#
# `:z4h:*` covers super-cd, fzf-history, fzf-dir-history, etc.
# `:z4h:fzf-complete` is more specific and takes precedence for TAB
# (where we also want `tab:repeat`). zstyle returns values from only
# the most specific match, so the bindings must be repeated.
zstyle ':z4h:*' fzf-bindings \
  'ctrl-space:toggle-preview' \
  'ctrl-j:down' \
  'ctrl-k:up' \
  'shift-up:preview-up' \
  'shift-down:preview-down' \
  'alt-up:preview-page-up' \
  'alt-down:preview-page-down' \
  'alt-page-up:preview-page-up' \
  'alt-page-down:preview-page-down' \
  'alt-home:preview-top' \
  'alt-end:preview-bottom' \
  'ctrl-f:change-preview(FZF_PREVIEW_FULL=1 preview {} | sed "s/^/ /")' \
  'ctrl-alt-f:change-preview(preview {} | sed "s/^/ /")'
zstyle ':z4h:fzf-complete' fzf-bindings \
  'tab:repeat' \
  'ctrl-space:toggle-preview' \
  'ctrl-j:down' \
  'ctrl-k:up' \
  'shift-up:preview-up' \
  'shift-down:preview-down' \
  'alt-up:preview-page-up' \
  'alt-down:preview-page-down' \
  'alt-page-up:preview-page-up' \
  'alt-page-down:preview-page-down' \
  'alt-home:preview-top' \
  'alt-end:preview-bottom' \
  'ctrl-f:change-preview(FZF_PREVIEW_FULL=1 preview {-1} | sed "s/^/ /")' \
  'ctrl-alt-f:change-preview(preview {-1} | sed "s/^/ /")'

# Use the fzf on PATH (mise's github build on the dev-shell, Homebrew on
# macOS) for z4h's fzf widgets instead of z4h's bundled binary. The
# bundled one can be ancient (apt's 0.29 on Linux, 0.25 on macOS) and
# rejects the modern --bind keys above (e.g. alt-page-up), which broke
# TAB-completion. Guard on $commands so an absent fzf falls back to the
# z4h default rather than an empty command.
[[ -n ${commands[fzf]} ]] && {
  zstyle ':z4h:*' fzf-command ${commands[fzf]}
  zstyle ':z4h:fzf-complete' fzf-command ${commands[fzf]}
}

# Enable ('yes') or disable ('no') automatic teleportation of z4h over
# SSH when connecting to these hosts.
zstyle ':z4h:ssh:cloud-desktop' enable 'yes'
# zstyle ':z4h:ssh:*.example-hostname2' enable 'no'
# The default value if none of the overrides above match the hostname.
zstyle ':z4h:ssh:*' enable 'no'

# Send these files over to the remote host when connecting over SSH to the
# enabled hosts.
zstyle ':z4h:ssh:*' send-extra-files '~/.config/zsh/aliases.sh'
zstyle ':z4h:ssh:*' send-extra-files '~/.config/zsh/aliases.d'
zstyle ':z4h:ssh:*' send-extra-files '~/.config/zsh/functions.sh'
zstyle ':z4h:ssh:*' send-extra-files '~/.config/zsh/functions.d'
zstyle ':z4h:ssh:*' send-extra-files "~/.atuin/bin/env"
zstyle ':z4h:ssh:*' send-extra-files "~/.config/nvim"

export FZF_DEFAULT_COMMAND="fd --type f"
# Shared between :z4h:* and :z4h:fzf-complete fzf-flags. Pulled out
# because zstyle returns only the most-specific match's value (no
# accumulation across patterns), so without this we'd have to
# duplicate the entire flag list whenever we override any single
# flag. The only thing that actually differs between bare fzf and
# tab-complete is the preview command's placeholder — see below.
typeset -ga _z4h_fzf_common_flags=(
  # Catppuccin Mocha palette — official mapping from catppuccin/fzf.
  --color=bg:"#1e1e2e"
  --color=bg+:"#313244"
  --color=fg:"#cdd6f4"
  --color=fg+:"#cdd6f4"
  --color=hl:"#f38ba8"
  --color=hl+:"#f38ba8"
  --color=prompt:"#cba6f7"
  --color=pointer:"#f5e0dc"
  --color=marker:"#b4befe"
  --color=info:"#cba6f7"
  --color=gutter:"#1e1e2e"
  --color=header:"#f38ba8"
  --color=spinner:"#f5e0dc"
  --color=border:"#313244"
  --filepath-word
  --border
  --height=45%
  --layout=reverse
  --info=default
  --exit-0
  --select-1
  --padding='0,2,0,0'
  --prompt='    '
  --pointer='➔'
  --marker='✔'
  --preview-window=right:60%:hidden,border-line,noinfo
)

# Bare fzf, super-cd, history, etc.: each input line is the whole
# path with whitespace as fzf's default field delimiter. `{}` is
# the entire selection — works for paths with spaces. `{-1}` here
# would slice at whitespace and lose everything before the last
# token.
zstyle ':z4h:*' fzf-flags \
  "${_z4h_fzf_common_flags[@]}" \
  --preview 'preview {} | sed "s/^/ /"'

# z4h tab-complete (-z4h-comp-files / -z4h-comp-words) feeds fzf
# NUL-separated records like `<raw-path>\0<display>` via
# `--delimiter=NUL`. `{-1}` resolves to the last NUL-field = the
# display (shell-quoted), which the preview script ${(Q)}-unquotes.
# `{}` does *not* work here: fzf replaces embedded NULs with
# spaces during substitution, yielding a bogus "rawpath display"
# arg.
#
# zstyle returns only the most-specific match's value, so this
# stanza must include every flag tab-complete needs — hence the
# shared array.
zstyle ':z4h:fzf-complete' fzf-flags \
  "${_z4h_fzf_common_flags[@]}" \
  --preview 'preview {-1} | sed "s/^/ /"'

