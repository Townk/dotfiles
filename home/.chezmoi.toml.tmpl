{{- /*
  Init template. Runs on `chezmoi init` to generate
  ~/.config/chezmoi/chezmoi.toml. Templates elsewhere branch on the
  `.profile` data value via:

      {{`{{ if eq .profile "personal" }}…{{ end }}`}}

  Profile is resolved in this order:
    1. CHEZMOI_PROFILE env var (set by `.setup.sh` from --work/--personal).
    2. Interactive prompt (TTY required), defaulting to "personal".

  Profile is NOT cached in chezmoi state — each `chezmoi init` either
  uses the env var or prompts. setup.sh handles non-TTY contexts
  (curl | bash without a flag) by exporting CHEZMOI_PROFILE=personal
  itself, so the template never hits an unanswerable prompt.
*/ -}}
{{- /*
  Profile resolution order:
    1. CHEZMOI_PROFILE env var (set by .setup.sh from --work/--personal).
    2. `chezmoi init --promptString profile=<value>` flag (when invoking
       chezmoi init by hand). The prompt key is the literal text
       "profile" — `--promptString` matches against the prompt text,
       so keep it short and unique.
    3. Interactive prompt (TTY required), defaulting to "personal".
*/ -}}
{{- $profile := env "CHEZMOI_PROFILE" -}}
{{- if eq $profile "" -}}
  {{- $profile = promptString "profile" "personal" -}}
{{- end -}}
{{- $profile = lower $profile -}}

{{- /*
  Auto-detect pi extension dev mode by checking for the working tree.
  If present, the symlink template uses this path and the consumer-mode
  `pi install` in the run_once bootstrap is skipped. Empty otherwise.
*/ -}}
{{- $piCockpitDev := "" -}}
{{- $piCockpitDevCandidate := joinPath .chezmoi.homeDir "Projects/apps/pi/pi-cockpit" -}}
{{- if stat $piCockpitDevCandidate -}}
  {{- $piCockpitDev = $piCockpitDevCandidate -}}
{{- end -}}
{{- $piPlannotatorBridgeDev := "" -}}
{{- $piPlannotatorBridgeDevCandidate := joinPath .chezmoi.homeDir "Projects/apps/pi/pi-plannotator-bridge" -}}
{{- if stat $piPlannotatorBridgeDevCandidate -}}
  {{- $piPlannotatorBridgeDev = $piPlannotatorBridgeDevCandidate -}}
{{- end -}}

encryption = "gpg"

[gpg]
    recipient = "A9C4A3D8CA995D91"

[onepassword]
    prompt = false

[data]
    profile = {{ $profile | quote }}
    [data.pi]
        [data.pi.devExtensions]
            pi-cockpit = {{ $piCockpitDev | quote }}
            pi-plannotator-bridge = {{ $piPlannotatorBridgeDev | quote }}

# vim:ft=toml
