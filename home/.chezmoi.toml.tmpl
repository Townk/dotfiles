{{- /*
  Init template. Runs on `chezmoi init` to generate
  ~/.config/chezmoi/chezmoi.toml. Templates elsewhere branch on the
  `.profile` data value (`personal`, `work`, `dev-shell`, `server`) via:

      {{`{{ if eq .profile "personal" }}…{{ end }}`}}

  Profile is resolved in this order:
    1. CHEZMOI_PROFILE env var (set by `.setup.sh` from --work/--personal).
    2. Interactive prompt (TTY required), defaulting to "personal".

  Profile is NOT cached in chezmoi state — each `chezmoi init` either
  uses the env var or prompts. setup.sh handles non-TTY contexts
  (curl | bash without a flag) by exporting CHEZMOI_PROFILE=personal
  itself, so the template never hits an unanswerable prompt.
*/ -}}
{{- /*
  Profile resolution order:
    1. CHEZMOI_PROFILE env var (set by .setup.sh from --work/--personal).
    2. `chezmoi init --promptString profile=<value>` flag (when invoking
       chezmoi init by hand). The prompt key is the literal text
       "profile" — `--promptString` matches against the prompt text,
       so keep it short and unique.
    3. Interactive prompt (TTY required), defaulting to "personal".
*/ -}}
{{- $profile := env "CHEZMOI_PROFILE" -}}
{{- if eq $profile "" -}}
  {{- $profile = promptString "profile" "personal" -}}
{{- end -}}
{{- $profile = lower $profile -}}

{{- /*
  Per-machine secrets slot. Opaque, non-identifying token (e.g. slot-7f3a9c)
  that names this host's secret fragment + SOPS blob. Passed at onboarding via
  CHEZMOI_SECRETS_SLOT and persisted here (local, never committed). Empty until
  the machine is onboarded with `system-onboard`; templates guard on that.

  Unlike the profile, the slot is CARRIED FORWARD from the config this init is
  regenerating, because it has no prompt to re-answer it with: env var or
  nothing. Without that, any bare `chezmoi init` — the one chezmoi itself asks
  for when this template changes — silently emptied it, which does not fail.
  It un-ignores nothing and breaks nothing on the spot; the already-rendered
  fragment stays on disk at 0600 and keeps being sourced. chezmoi just stops
  managing it, and the host quietly drifts until a secret changes months later.
  Observed on the dev-shell, 2026-08-10. Only an explicit value changes it now.
*/ -}}
{{- $slot := env "CHEZMOI_SECRETS_SLOT" -}}
{{- if and (eq $slot "") (hasKey . "secretsSlot") -}}
  {{- $slot = .secretsSlot -}}
{{- end -}}

{{- /*
  No [onepassword] block: human slots cache their rendered secret fragment and
  resolve op:// references with direct `op read` calls only on first materialize,
  when the committed reference set changes, or when CHEZMOI_REFRESH_SECRETS=1.
  That keeps chezmoi's static onepassword.mode out of the loop — on refresh, `op`
  chooses its own mode from the environment: OP_SERVICE_ACCOUNT_TOKEN present →
  service (set only over SSH by environment.sh), absent → account (local /
  Touch ID). So the same machine uses Touch ID when you're physically there and
  the service-account token when you're over SSH, with no config to flip.
*/ -}}

{{- /*
  Auto-detect pi extension dev mode by checking for the working tree.
  If present, the symlink template uses this path and the consumer-mode
  `pi install` in the run_once bootstrap is skipped. Empty otherwise.
*/ -}}
{{- $piCockpitDev := "" -}}
{{- $piCockpitDevCandidate := joinPath .chezmoi.homeDir "Projects/apps/pi/pi-cockpit" -}}
{{- if stat $piCockpitDevCandidate -}}
  {{- $piCockpitDev = $piCockpitDevCandidate -}}
{{- end -}}
{{- $piPlannotatorBridgeDev := "" -}}
{{- $piPlannotatorBridgeDevCandidate := joinPath .chezmoi.homeDir "Projects/apps/pi/pi-plannotator-bridge" -}}
{{- if stat $piPlannotatorBridgeDevCandidate -}}
  {{- $piPlannotatorBridgeDev = $piPlannotatorBridgeDevCandidate -}}
{{- end -}}

encryption = "gpg"

[gpg]
    recipient = "A9C4A3D8CA995D91"
{{/*
  Headless profiles decrypt SOPS+age secret fragments at apply. Keep this
  set in sync with .chezmoitemplates/profile-traits.tmpl (not includable
  here: at init time the data values it is normally fed do not exist yet).
*/}}
{{- $headless := or (eq $profile "dev-shell") (eq $profile "server") -}}
{{ if $headless }}
{{- /*
  Headless hosts decrypt their SOPS+age secret fragment at apply via the
  `output "sops"` template function. SOPS finds the age identity through
  SOPS_AGE_KEY_FILE; chezmoi's [env] makes it available to that command.
  The identity lives off git, 0600, under ~/.local/state/chezmoi/secrets/.
*/ -}}
[env]
    SOPS_AGE_KEY_FILE = {{ (joinPath .chezmoi.homeDir ".local/state/chezmoi/secrets/key.txt") | quote }}
{{ end }}
[data]
    profile = {{ $profile | quote }}
    secretsSlot = {{ $slot | quote }}
    [data.pi]
        [data.pi.devExtensions]
            pi-cockpit = {{ $piCockpitDev | quote }}
            pi-plannotator-bridge = {{ $piPlannotatorBridgeDev | quote }}

# vim:ft=toml
