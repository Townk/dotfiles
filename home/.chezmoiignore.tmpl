{{- /*
  Skip paths that are generated at runtime or are never rendered into $HOME.
    - .config/nvim/lazy-lock.json: managed by lazy.nvim, not chezmoi
  Skip macOS-only artifacts on other platforms.
    - .local/bin/nvim-wez.sh: WezTerm/Shortcuts launcher (uses `open -a`,
      AppleScript, and the WezTerm GUI socket)
*/ -}}
.config/nvim/lazy-lock.json
{{/* bin/README.md documents the scripts in-repo; it must never deploy to
     ~/.local/bin (it's reference material, not a runtime artifact). */}}
.local/bin/README.md
{{/* ~/.ssh/config is local-only: work SSH tooling rewrites it on every run, so
     it stays unmanaged. Managed fragments are pulled in via the file's
     `Include ~/.ssh/config.d/*` (see ~/.ssh/config.example). */}}
.ssh/config
{{ if ne .chezmoi.os "darwin" -}}
.local/bin/nvim-wez.sh
{{/* pinentry-auto routes to Touch ID / pinentry-mac (macOS-only binaries);
     trust.json is Homebrew tap-trust state. Neither is meaningful off a Mac. */}}
.local/bin/pinentry-auto
.config/homebrew/trust.json
{{/* macOS-only run scripts. Scripts live under .chezmoiscripts/ in the
     source root, and chezmoi strips run_* attributes in the managed name. */}}
.chezmoiscripts/*-symbols-nerd-font-prompt.sh
.chezmoiscripts/*-generate-open-in-neovim-app.sh
.chezmoiscripts/*-reload-environment-launchagent.sh
.chezmoiscripts/*-enable-sudo-touchid.sh
.chezmoiscripts/*-symbols-db.sh
.chezmoiscripts/*-symbols-nerd-font.sh
.chezmoiscripts/*-setup-system-settings.sh
.chezmoiscripts/*-setup-gpg-key.sh
{{- end }}
{{ if not (and (eq .chezmoi.os "linux") (eq .profile "dev-shell")) -}}
{{/* Linux dev-shell artifacts. Keep these off Macs and other profiles. */}}
.config/mise/conf.d/dev-shell.toml
.config/packages/Snapfile
.chezmoiscripts/*-setup-dev-shell-tools.sh
.chezmoiscripts/*-install-dev-shell-sudo-tool-links.sh
.chezmoiscripts/*-install-snaps.sh
{{/* snap only exists on the dev-shell; omit the worker elsewhere so the
     system-package dispatcher discovers only ecosystems this host can run
     (the inverse of the system-package-brew exclusion below). */}}
.local/bin/system-package-snap
{{- end }}
{{ if and (eq .chezmoi.os "linux") (eq .profile "dev-shell") -}}
{{/* Homebrew is not available in the dev-shell profile. Omit the worker so
     system-package discovers only ecosystems this host can run. */}}
.local/bin/system-package-brew
{{- end }}
{{/* platform:: module — deploy only the active OS's implementation; the
     platform.sh shim (which dispatches to it) ships everywhere. */}}
{{ if eq .chezmoi.os "darwin" -}}
.local/lib/platform-linux.sh
{{- else -}}
.local/lib/platform-macos.sh
{{- end }}

# pi-coding-agent: paths managed by pi itself at runtime, or sensitive.
# We track specific configs under ~/.pi/agent/ but never these dirs.
.pi/.DS_Store
.pi/depot
.pi/prompt-history
.pi/review-enhanced-input.md
.pi/agent/auth.json
.pi/agent/git
.pi/agent/npm
.pi/agent/sessions

# pi-cockpit symlink is only deployed when the dev working tree exists
# (data.pi.devExtensions["pi-cockpit"] is non-empty in chezmoi.toml).
# On consumer machines the symlink is suppressed and a run_once script
# runs `pi install git:github.com/Townk/pi-cockpit` instead.
{{ if not (index .pi.devExtensions "pi-cockpit") -}}
.pi/agent/extensions/pi-cockpit
{{- end }}

# pi-plannotator-bridge follows the same dev-vs-consumer pattern as
# pi-cockpit. Symlinked when the working tree is present; installed
# from GitHub by the run_once bootstrap otherwise.
{{ if not (index .pi.devExtensions "pi-plannotator-bridge") -}}
.pi/agent/extensions/pi-plannotator-bridge
{{- end }}

{{/* Per-machine secret fragments. Each committed fragment
     dot_config/zsh/secrets.d/private_<slot>.sh.tmpl renders to
     ~/.config/zsh/secrets.d/<slot>.sh, but only THIS host's slot may
     materialize: foreign fragments carry `output "sops"` / `output "op"`
     calls that must never run here, so we ignore (don't render) them rather
     than empty them. When secretsSlot is unset (machine not yet onboarded
     with `system-onboard`), every fragment is ignored. Slot ids are opaque,
     so emitting them here leaks nothing. */}}
{{- $slot := "" -}}
{{- if hasKey . "secretsSlot" -}}{{ $slot = .secretsSlot -}}{{- end -}}
{{- range $f := (glob (joinPath .chezmoi.sourceDir "dot_config/zsh/private_secrets.d/private_*.sh.tmpl")) -}}
{{-   $name := base $f | trimSuffix ".tmpl" | trimPrefix "private_" -}}
{{-   if ne $name (printf "%s.sh" $slot) }}
.config/zsh/secrets.d/{{ $name }}
{{-   end -}}
{{- end }}

# vim:ft=gitignore
