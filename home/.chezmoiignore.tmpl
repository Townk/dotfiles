{{- /*
  Skip paths that are generated at runtime or are never rendered into $HOME.
    - .config/nvim/lazy-lock.json: managed by lazy.nvim, not chezmoi
  Skip macOS-only artifacts on other platforms.
    - .local/libexec/tab-edit ships on macOS AND graphical Linux (opens files in a
      new WezTerm/Zellij tab; OS-specific bits live behind the platform::
      module). Only the headless dev-shell and other non-GUI hosts skip it.
*/ -}}
{{- $traits := includeTemplate "profile-traits.tmpl" . | fromJson -}}
{{- $guiLinux := and (eq .chezmoi.os "linux") (not $traits.headless) -}}
{{- $headlessLinux := and (eq .chezmoi.os "linux") $traits.headless -}}
.config/nvim/lazy-lock.json
{{/* bin/README.md documents the scripts in-repo; it must never deploy to
     ~/.local/bin (it's reference material, not a runtime artifact). */}}
.local/bin/README.md
{{/* ~/.ssh/config is local-only: work SSH tooling rewrites it on every run, so
     it stays unmanaged. Managed fragments are pulled in via the file's
     `Include ~/.ssh/config.d/*` (see ~/.ssh/config.example). */}}
.ssh/config
{{/* Cursor MCP config can contain provider URLs, auth headers, and other
     local-only endpoints. Keep it out of chezmoi on every profile. */}}
.cursor/mcp.json
{{/* ~/.config/packages/images.toml is the loose, per-machine sparse-image
     manifest for `system-images`. An image name/mountpoint can name a work
     resource, so it stays local and is never tracked (the committed
     images.toml.example documents the format). */}}
.config/packages/images.toml
{{/* ~/.config/share/endpoints.toml is the loose, per-machine manifest for
     `share`. An endpoint hostname can name a work resource, so it stays local
     and is never tracked (the committed endpoints.toml.example documents the
     format). */}}
.config/share/endpoints.toml
{{/* ~/.config/qmk-flash/config.toml is the loose, per-machine default set for
     `qmk-flash`. It names the ONE machine on this network that builds the
     firmware, which is a property of where you are sitting rather than of the
     dotfiles, so it stays local (the committed config.toml.example documents
     the format). Without it the script reads the firmware off this machine. */}}
.config/qmk-flash/config.toml
{{ if ne .chezmoi.os "darwin" -}}
{{/* trust.json is Homebrew tap-trust state, meaningless off a Mac.
     pinentry-auto and its askpass-auto symlink used to be ignored here too,
     because the dispatcher only knew macOS surfaces (Touch ID, VNC,
     pinentry-mac). It now gates that tail on Darwin and routes everything else
     to pinentry-ui with the stock curses pinentry underneath, so both belong on
     every host — and shipping the link without its target was what left Linux
     hosts a dangling one. */}}
.config/homebrew/trust.json
{{/* system-images manages macOS sparse disk images (hdiutil/diskutil); the
     tool, its completion, and the example manifest are meaningless off a Mac. */}}
.local/bin/system-images
.local/share/zsh/site-functions/_system-images
.config/packages/images.toml.example
{{/* qmk-flash flashes RP2040 keyboard halves through picotool and diskutil,
     neither of which exists off a Mac. */}}
.local/bin/qmk-flash
.config/qmk-flash/config.toml.example
{{/* disk-image-view previews macOS disk images via hdiutil; preview's
     dispatcher already gates on Darwin + executable presence. */}}
.local/libexec/disk-image-view
{{/* macOS-only run scripts. Scripts live under .chezmoiscripts/ in the
     source root, and chezmoi strips run_* attributes in the managed name. */}}
.chezmoiscripts/*-symbols-nerd-font-prompt.sh
.chezmoiscripts/*-generate-open-in-neovim-app.sh
.chezmoiscripts/*-reload-environment-launchagent.sh
.chezmoiscripts/*-enable-sudo-touchid.sh
.chezmoiscripts/*-symbols-db.sh
.chezmoiscripts/*-symbols-nerd-font.sh
.chezmoiscripts/*-setup-system-settings.sh
.chezmoiscripts/*-setup-gpg-key.sh
{{/* ~/Library is macOS territory: the launchd environment agent has no
     launchd to load it off a Mac, and the Application Support tealdeer
     symlink only papers over macOS tealdeer ignoring XDG (Linux tealdeer
     reads ~/.config/tealdeer directly). */}}
Library
Library/**
{{/* launchd + brew are macOS service backends; off a Mac the dispatcher
     discovers only workers this host can run (the system-package-brew
     convention, now applied to the service side too). */}}
.local/bin/system-service-launchd
.local/bin/system-service-brew
.local/share/zsh/site-functions/_system-service-launchd
.local/share/zsh/site-functions/_system-service-brew
{{- end }}
{{/* tab-edit ships on macOS and graphical Linux (it needs a GUI WezTerm + a
     file manager to be useful); skip it on the headless dev-shell and any
     other non-GUI host. */}}
{{ if not (or (eq .chezmoi.os "darwin") $guiLinux) -}}
.local/libexec/tab-edit
{{- end }}
{{/* The Linux .desktop handler generator only makes sense on a graphical
     Linux: macOS uses the Finder droplet instead, and headless hosts have no
     file manager to register with. */}}
{{ if not $guiLinux -}}
.chezmoiscripts/*-generate-tab-edit-desktop.sh
{{- end }}
{{ if ne .chezmoi.os "linux" -}}
{{/* Linux login-shell shims. Every Linux host gets them (bash is the
     distro default shell until zsh takes over); keep them off Macs. */}}
.bash_profile
.bashrc
.profile
{{- end }}
{{ if not $headlessLinux -}}
{{/* Headless-Linux stack (dev-shell + server): SSH-ergonomics units and the
     mise+apt provisioning path. gpg-agent is forwarded TO these boxes over
     SSH; the clipboard bridge store serves the laptop→remote mirror. */}}
.config/systemd/user/gpg-forward-socketdir.service
.config/systemd/user/clipboard-bridge.socket
.config/systemd/user/clipboard-bridge.service
.config/systemd/user/clipboard-bridge-trusted.socket
.local/libexec/gpg-agent-forward-provision
.chezmoiscripts/*-setup-gpg-agent-forwarding.sh
.chezmoiscripts/*-setup-dev-shell-tools.sh
.chezmoiscripts/*-setup-clipboard-bridge.sh
.chezmoiscripts/*-install-dev-shell-sudo-tool-links.sh
{{- end }}
{{ if not (and (eq .chezmoi.os "linux") $traits.ephemeral) -}}
{{/* Ephemeral (dev-shell) only: the snap ecosystem, the mise 403-workaround
     conf, and the state prune that compensates ignore-vs-remove gaps. */}}
.config/mise/conf.d/dev-shell.toml
.config/packages/Snapfile
.chezmoiscripts/*-install-snaps.sh
.chezmoiscripts/*-prune-dev-shell-state.sh
{{/* snap only exists on the dev-shell; omit the worker elsewhere so the
     system-package dispatcher discovers only ecosystems this host can run
     (the inverse of the system-package-brew exclusion below). */}}
.local/bin/system-package-snap
{{- end }}
{{ if ne .chezmoi.os "linux" -}}
{{/* systemd user units exist only on Linux; hide the worker elsewhere so
     worker discovery stays truthful (mirror of the launchd/brew exclusion
     above). */}}
.local/bin/system-service-systemd
.local/share/zsh/site-functions/_system-service-systemd
{{- end }}
{{ if eq .chezmoi.os "linux" -}}
{{/* Homebrew is macOS-only in this system (no linuxbrew). Omit the worker so
     system-package discovers only ecosystems this host can run. */}}
.local/bin/system-package-brew
{{/* The brew manifests are equally meaningless without brew — the Snapfile's
     mirror image (it hides on every non-dev-shell host). */}}
.config/packages/Brewfile
.config/packages/Brewfile.bootstrap
{{- end }}
{{ if $traits.headless -}}
{{/* Terminal Time Machine (system-backup silo) is not provisioned for
     headless profiles: BACKUP_REPO_PASSPHRASE is requiredFor personal+work only, so
     the stack can never run there. The launchd agents are darwin-gated in
     services.toml already; this hides the tools, libs, completions, and
     config. Consumers are guarded: tm() probes
     command -v, yazi's g-t binding is template-gated, backup-drift.sh
     already [[ -r ]]-guards its lib. */}}
.local/bin/system-backup
.local/bin/system-backup-capture
.local/bin/system-backup-reconcile
.local/libexec/system-backup-tm
.local/libexec/tm-tab
.local/lib/backup.zsh
.local/lib/backup-tm.zsh
.local/lib/backup-drift.zsh
.local/share/zsh/site-functions/_system-backup
.local/share/zsh/site-functions/_system-backup-capture
.local/share/zsh/site-functions/_system-backup-reconcile
.local/share/zsh/site-functions/_tm
.config/backup
.config/backup/**
{{/* Headless dev shells should not receive GUI terminal/app config or local
     inference services. */}}
.config/espanso
.config/espanso/**
.config/ghostty
.config/ghostty/**
.config/hammerspoon
.config/hammerspoon/**
.config/homebrew
.config/homebrew/**
.config/wezterm
.config/wezterm/**
{{- end }}
{{/* platform:: module — deploy only the active OS's implementation; the
     platform.zsh shim (which dispatches to it) ships everywhere. */}}
{{ if eq .chezmoi.os "darwin" -}}
.local/lib/platform-linux.zsh
{{- else -}}
.local/lib/platform-macos.zsh
{{- end }}

{{/* Cursor is work-only: the cursor-agent CLI lives on the work machine, so its
     whole footprint is isolated to the work profile and never deploys on
     personal or dev-shell hosts —
       .cursor                          agent config (agents, rules, skills)
       .local/bin/ai-commit-cursor      cursor harness for the ai-commit dispatcher
       …/_ai-commit-cursor              that harness's completion
     ai-commit auto-discovers its `ai-commit-*` workers and probe-gates them, so
     dropping the worker just leaves `pi` as the sole harness; the templated
     _ai-commit completion likewise omits the cursor option off-work. Matching
     prunes live in .chezmoiremove. */}}
{{ if ne .profile "work" -}}
.cursor
.cursor/**
.local/bin/ai-commit-cursor
.local/share/zsh/site-functions/_ai-commit-cursor
{{/* Atlassian (acli) agent skills are work tooling; keep them off personal
     and dev-shell agent homes. Stale copies: dev-shell prunes via the
     90-prune script; personal Macs were cleaned by hand once (ignored
     targets are invisible to .chezmoiremove). */}}
.claude/skills/jira-acli
.claude/skills/jira-acli/**
.claude/skills/confluence-acli
.claude/skills/confluence-acli/**
.config/agent-skills/jira-acli
.config/agent-skills/jira-acli/**
.config/agent-skills/confluence-acli
.config/agent-skills/confluence-acli/**
.pi/agent/skills/jira-acli
.pi/agent/skills/jira-acli/**
.pi/agent/skills/confluence-acli
.pi/agent/skills/confluence-acli/**
{{- end }}

# pi-coding-agent: paths managed by pi itself at runtime, or sensitive.
# We track specific configs under ~/.pi/agent/ but never these dirs.
.pi/.DS_Store
.pi/depot
.pi/prompt-history
.pi/review-enhanced-input.md
.pi/agent/auth.json
.pi/agent/git
.pi/agent/npm
.pi/agent/sessions
{{ if $traits.headless -}}
{{/* The local/32K Pi home is for human machines; headless hosts only
     keep the primary ~/.pi/agent home. */}}
.pi/agent-local
.pi/agent-local/**
{{- end }}
.pi/agent-local/auth.json
.pi/agent-local/git
.pi/agent-local/npm
.pi/agent-local/sessions

# pi-cockpit symlink is only deployed when the dev working tree exists
# (data.pi.devExtensions["pi-cockpit"] is non-empty in chezmoi.toml).
# On consumer machines the symlink is suppressed and a run_once script
# runs `pi install git:github.com/Townk/pi-cockpit` instead.
{{ if not (index .pi.devExtensions "pi-cockpit") -}}
.pi/agent/extensions/pi-cockpit
{{- end }}

# pi-plannotator-bridge follows the same dev-vs-consumer pattern as
# pi-cockpit. Symlinked when the working tree is present; installed
# from GitHub by the run_once bootstrap otherwise.
{{ if not (index .pi.devExtensions "pi-plannotator-bridge") -}}
.pi/agent/extensions/pi-plannotator-bridge
{{- end }}

{{/* Per-machine secret fragments. Each committed fragment
     dot_config/zsh/secrets.d/private_<slot>.sh.tmpl renders to
     ~/.config/zsh/secrets.d/<slot>.sh, but only THIS host's slot may
     materialize: foreign fragments carry `output "sops"` / `output "op"`
     calls that must never run here, so we ignore (don't render) them rather
     than empty them. When secretsSlot is unset (machine not yet onboarded
     with `system-onboard`), every fragment is ignored. Slot ids are opaque,
     so emitting them here leaks nothing. */}}
{{- $slot := "" -}}
{{- if hasKey . "secretsSlot" -}}{{ $slot = .secretsSlot -}}{{- end -}}
{{- range $f := (glob (joinPath .chezmoi.sourceDir "dot_config/zsh/private_secrets.d/private_*.sh.tmpl")) -}}
{{-   $name := base $f | trimSuffix ".tmpl" | trimPrefix "private_" -}}
{{-   if ne $name (printf "%s.sh" $slot) }}
.config/zsh/secrets.d/{{ $name }}
{{-   end -}}
{{- end }}

# vim:ft=gitignore
