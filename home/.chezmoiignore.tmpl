{{- /*
  Skip paths that are generated at runtime or are never rendered into $HOME.
    - .config/nvim/lazy-lock.json: managed by lazy.nvim, not chezmoi
    - .config/bin/config.json: generated by a tool, not a dotfile
  Skip macOS-only artifacts on other platforms.
    - .local/bin/nvim-wez.sh: WezTerm/Shortcuts launcher (uses `open -a`,
      AppleScript, and the WezTerm GUI socket)
    - .local/share/shortcuts/: exported macOS Shortcuts (.shortcut files,
      only meaningful to Shortcuts.app)
*/ -}}
.config/nvim/lazy-lock.json
.config/bin/config.json
{{ if ne .chezmoi.os "darwin" -}}
.local/bin/nvim-wez.sh
.local/share/shortcuts
{{/* macOS-only run scripts: these `set -o pipefail` before their own
     darwin guard, which breaks under Linux's dash. Skip them entirely
     off macOS (the dev-shell toolbox is handled by its own run_once).
     chezmoi strips the run_* attributes, so match the bare script name. */}}
symbols-nerd-font-prompt.sh
install-macos-shortcut.sh
reload-environment-launchagent.sh
symbols-nerd-font.sh
setup-system-settings.sh
{{- end }}
{{ if not (and (eq .chezmoi.os "linux") (eq .profile "dev-shell")) -}}
{{/* Linux dev-shell artifacts. Keep these off Macs and other profiles. */}}
.config/mise/conf.d/dev-shell.toml
.config/packages/Snapfile
setup-dev-shell-tools.sh
grant-zellij-plugin-permissions.sh
install-snaps.sh
{{- end }}

# pi-coding-agent: paths managed by pi itself at runtime, or sensitive.
# We track specific configs under ~/.pi/agent/ but never these dirs.
.pi/.DS_Store
.pi/depot
.pi/prompt-history
.pi/review-enhanced-input.md
.pi/agent/auth.json
.pi/agent/git
.pi/agent/npm
.pi/agent/sessions

# pi-cockpit symlink is only deployed when the dev working tree exists
# (data.pi.devExtensions["pi-cockpit"] is non-empty in chezmoi.toml).
# On consumer machines the symlink is suppressed and a run_once script
# runs `pi install git:github.com/Townk/pi-cockpit` instead.
{{ if not (index .pi.devExtensions "pi-cockpit") -}}
.pi/agent/extensions/pi-cockpit
{{- end }}

# pi-plannotator-bridge follows the same dev-vs-consumer pattern as
# pi-cockpit. Symlinked when the working tree is present; installed
# from GitHub by the run_once bootstrap otherwise.
{{ if not (index .pi.devExtensions "pi-plannotator-bridge") -}}
.pi/agent/extensions/pi-plannotator-bridge
{{- end }}

# vim:ft=gitignore
