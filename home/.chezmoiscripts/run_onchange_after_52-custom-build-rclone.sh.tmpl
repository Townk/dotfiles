{{- /*

  Mount-capable rclone — install hook (macOS personal profile only).

  Installs the OFFICIAL rclone binary from downloads.rclone.org instead of
  Homebrew's, because Homebrew's build hard-refuses `rclone mount` on macOS
  ("rclone mount is not supported on MacOS when rclone is installed via
  Homebrew"). See custom-builds/rclone/install-rclone.sh for the full
  rationale and install recipe.

  run_onchange_after_*: chezmoi re-runs this whenever the rendered output
  changes. We bake the SHA256 of install-rclone.sh into the script below, so
  editing the installer (e.g. bumping RCLONE_VERSION) re-fires it. The
  installer is otherwise idempotent — a no-op fast path when the pinned
  version is already installed and linked — so routine applies don't
  re-download.

  Scope: macOS, personal profile only. Mount support needs macFUSE
  (cask 'macfuse' in Brewfile.tmpl), which is personal-profile-only —
  rclone-for-mount has no reason to install anywhere else.
*/ -}}
{{- $target := and (eq .chezmoi.os "darwin") (eq .profile "personal") -}}
{{- $installSHA := "" -}}
{{- if $target -}}
  {{- $installSHA = output "shasum" "-a" "256" (joinPath .chezmoi.workingTree "custom-builds/rclone/install-rclone.sh") | trim -}}
{{- end -}}
#!/bin/bash
# Mount-capable rclone — install hook.
#
# Re-runs whenever the installer changes:
#   install-rclone.sh sha256 : {{ if $installSHA }}{{ $installSHA }}{{ else }}(out of scope){{ end }}
#
# To force a clean reinstall:
#   rm -rf ~/.local/opt/rclone && chezmoi apply

set -eu

{{- if not $target }}
# Only installed on the macOS personal profile; nothing to do here.
exit 0
{{- end }}

INSTALL="{{ .chezmoi.workingTree }}/custom-builds/rclone/install-rclone.sh"

if [ ! -f "$INSTALL" ]; then
  echo "[rclone-install] installer missing at $INSTALL — skipping." >&2
  exit 0
fi

exec bash "$INSTALL"

# vim:ft=sh
