{{- /*

  pinentry-touchid backend repair — idempotent, runs every apply.

  gpg-agent.conf points `pinentry-program` at our pinentry-auto wrapper, which
  dispatches to pinentry-touchid. pinentry-touchid does NOT render the prompt
  itself: it delegates to pinentry-mac, located by asking `gpgconf` for the
  pinentry path. gpgconf returns GnuPG's compiled-in default — the symlink
  $HOMEBREW_PREFIX/opt/pinentry/bin/pinentry — NOT the pinentry-program override.

  That symlink is owned by the Homebrew `pinentry` formula (curses), a dependency
  of gnupg/gpgme/pinentry-touchid. Every `brew upgrade`/reinstall of `pinentry`
  resets it to pinentry-curses, so pinentry-touchid resolves the wrong backend,
  refuses to run, and gpg reports "signing failed: Operation cancelled".

  `pinentry-touchid -fix` repoints that symlink to pinentry-mac. It must re-run on
  every apply (not run_onchange) because a bare `brew upgrade` can clobber the
  symlink without touching any chezmoi-managed source.

  We do NOT probe with `pinentry-touchid -check`: in 0.0.3 that subcommand never
  exits — it launches pinentry-mac and blocks on the Assuan protocol forever when
  a tty is on stdin (and exits non-zero when stdin is closed), so it can never
  report "already correct". Running it wedged `system-update`, which invokes this
  script via `chezmoi apply`, right after the source sync. Inspect the managed
  symlink directly instead, and only shell out to `-fix` (bounded by a timeout,
  stdin closed) when it actually points at the wrong backend. Both steps are
  ~/.local/libexec/pinentry-backend-repair, which system-update calls too.

  Second repair: pinentry-mac must never write to the keychain itself.
  pinentry-touchid owns the item (service `GnuPG`, account = keygrip). When that
  item is missing it falls back to pinentry-mac, and if pinentry-mac's "Save in
  Keychain" checkbox is ticked (it remembers the last state) pinentry-mac writes
  an item under the SAME service/account, readable only by pinentry-mac.app.
  pinentry-touchid's own store then fails with -25299 "already exists" and gpg
  reports "signing failed: Operation cancelled" — on every retry, because each
  retry recreates the item. `DisableKeychain` in org.gpgtools.common hides the
  checkbox and stops pinentry-mac from saving, so only pinentry-touchid ever
  writes the item. Hit for real on 2026-11-02 after deleting a stale item.
*/ -}}
#!/bin/sh
set -eu

{{- if eq .chezmoi.os "darwin" }}
command -v pinentry-touchid >/dev/null 2>&1 || exit 0

mac="$(command -v pinentry-mac 2>/dev/null || true)"
[ -n "$mac" ] || exit 0

# Keep pinentry-mac out of the keychain (see header). Idempotent: write only
# when the preference is not already on.
if [ "$(defaults read org.gpgtools.common DisableKeychain 2>/dev/null || true)" != 1 ]; then
  defaults write org.gpgtools.common DisableKeychain -bool yes
  echo "pinentry-touchid: disabled pinentry-mac's own keychain saving" >&2
fi

# Check and repair live in one helper, shared with system-update. This is a
# run_after hook, so ~/.local is already in place; if the helper is missing
# anyway, say so and leave the link alone: a second copy of the check here
# is what the helper replaced, and an unbounded `-fix` could wedge the apply.
helper="$HOME/.local/libexec/pinentry-backend-repair"
if [ ! -x "$helper" ]; then
  echo "pinentry-touchid: $helper is missing; backend not checked" >&2
  exit 0
fi

# 1 is "wrong backend"; 0 (already pinentry-mac) and 2 (nothing to check) end here.
rc=0
"$helper" check || rc=$?
[ "$rc" -eq 1 ] || exit 0

echo "pinentry-touchid: backend pinentry is not pinentry-mac; repairing symlink" >&2
"$helper" fix || true

# `-fix` can exit 0 without re-pointing the link, so look again.
if "$helper" check; then
  echo "pinentry-touchid: backend repaired -> pinentry-mac" >&2
else
  echo "pinentry-touchid: could not repair backend; run 'pinentry-touchid -fix' manually" >&2
fi
{{- end }}

# vim:ft=sh
