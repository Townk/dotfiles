#!/bin/sh
set -eu
{{/*
  Enable the clipboard-bridge socket unit and (re)start it immediately, so
  `chezmoi apply` has instant effect. The unit itself -- not this script --
  is what makes the bridge survive an image recycle: unit file + enable
  symlink live under ~/.config/systemd/user (homedir persists), so the user
  manager rebinds 127.0.0.1:2489 at first login with no chezmoi run.
*/ -}}
{{ if and (eq .chezmoi.os "linux") (eq .profile "dev-shell") }}
# Re-run when the units or the dispatcher stack changes:
# clipboard-bridge.socket: {{ include "dot_config/systemd/user/clipboard-bridge.socket" | sha256sum }}
# clipboard-bridge@.service: {{ include "dot_config/systemd/user/clipboard-bridge@.service" | sha256sum }}
# clipboard-bridge-dispatch: {{ include "dot_local/libexec/executable_clipboard-bridge-dispatch" | sha256sum }}
# clipboard-store-core.zsh: {{ include "dot_local/lib/clipboard-store-core.zsh" | sha256sum }}
# clipboard-platform-linux-headless.zsh: {{ include "dot_local/lib/clipboard-platform-linux-headless.zsh" | sha256sum }}

if systemctl --user show-environment >/dev/null 2>&1; then
  systemctl --user daemon-reload
  systemctl --user enable clipboard-bridge.socket
  systemctl --user restart clipboard-bridge.socket
else
  echo "clipboard-bridge: no user systemd instance reachable; will activate at next login/boot." >&2
fi
{{ end }}

# vim:ft=sh
