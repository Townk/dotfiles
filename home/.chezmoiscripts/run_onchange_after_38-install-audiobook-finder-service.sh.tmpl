{{- $serviceSig := "" -}}
{{- if eq .chezmoi.os "darwin" -}}
  {{- $serviceSig = output "sh" "-c" (printf "find %q -type f 2>/dev/null | LC_ALL=C sort | while read -r f; do shasum -a 256 \"$f\"; done | shasum -a 256 | cut -c1-16" (joinPath .chezmoi.sourceDir "dot_local/share/services/browse-audiobook-folder")) | trim -}}
{{- end -}}
#!/bin/sh
set -eu

{{ if eq .chezmoi.os "darwin" -}}
# Install the "Browse Audiobook Folder" Finder Quick Action by symlinking the
# chezmoi-managed workflow bundle
# (~/.local/share/services/browse-audiobook-folder) into ~/Library/Services,
# then flushing Launch Services' Quick Action cache so Finder notices without
# a restart. ~/.local/share/services is a directory OF bundles, one
# subdirectory per Quick Action — this script only ever touches its own
# (browse-audiobook-folder), so a sibling service added later gets its own
# subdirectory and its own run_onchange script rather than colliding here.
# A symlink (not a copy) means an edit to the plists is live the moment
# chezmoi applies it — this script only needs to re-run to (re)create the
# symlink and reflush pbs, which is why its own content embeds a hash of
# JUST this bundle's subtree below: that is what makes run_onchange re-fire
# when THIS service's Info.plist or document.wflow changes, and NOT when an
# unrelated sibling service under services/ changes.
#
# services content hash: {{ $serviceSig }}

bundle_name="Browse Audiobook Folder.workflow"
src="$HOME/.local/share/services/browse-audiobook-folder"
dest="$HOME/Library/Services/$bundle_name"

mkdir -p "$HOME/Library/Services"

# `ln -sfn` ALONE IS NOT ENOUGH, and its failure mode is silent (review
# finding, 2026-08-25). -n only affects an existing SYMLINK. Against a REAL
# DIRECTORY at $dest, ln(1) creates the link INSIDE it — leaving
# "$dest/browse-audiobook-folder" — and exits 0, after which this script
# flushes Launch Services and reports success while Finder goes on running
# whatever stale bundle is sitting at $dest.
#
# That precondition is reachable through this epic's OWN documented fallback:
# if `pbs -flush` turns out not to register a SYMLINKED .workflow, the remedy
# is to `cp -R` the bundle here instead, which leaves exactly a real
# directory. Every re-run after that would nest again.
#
# So the three shapes are handled explicitly, and copy mode is REFRESHED in
# place rather than silently converted back to a symlink: if someone
# deliberately replaced the link with a copy, undoing that on the next
# `chezmoi apply` would re-break Finder for the same reason the copy was made.
# The refresh stages beside the destination and swaps, so an interrupted
# copy never leaves a half-written bundle where Finder can find one.
if [ -L "$dest" ]; then
  ln -sfn "$src" "$dest"
elif [ -d "$dest" ]; then
  printf '%s\n' "audiobook Quick Action: $dest is a real directory (copy mode) — refreshing it from the managed bundle"
  rm -rf "$dest.new"
  cp -R "$src" "$dest.new"
  rm -rf "$dest"
  mv "$dest.new" "$dest"
elif [ -e "$dest" ]; then
  # A plain file where a bundle belongs. Nothing here owns it but us.
  rm -f "$dest"
  ln -sfn "$src" "$dest"
else
  ln -sfn "$src" "$dest"
fi

/System/Library/CoreServices/pbs -flush
{{- else }}
# macOS-only; no-op on this platform.
exit 0
{{- end }}

# vim:ft=sh
