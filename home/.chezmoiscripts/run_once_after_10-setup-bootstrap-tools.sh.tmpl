#!/bin/bash
set -eufo pipefail
{{- if and (eq .chezmoi.os "linux") (eq .profile "dev-shell") }}

# The Linux dev-shell profile provisions tools via
# run_once_after_15-setup-dev-shell-tools (mise + apt). The brew-based
# `system-update` path below does not apply here, so stop early.
exit 0
{{- end }}

# Pull in this machine's secret env (MISE_GITHUB_TOKEN, HOMEBREW_GITHUB_API_TOKEN)
# so the GitHub-heavy `mise install` below is authenticated. The zsh
# `system-update` self-sources this via .zshenv, but this bash script does not,
# and the fragment exists here when self-onboard ran before the first apply.
[ -r "$HOME/.config/zsh/secrets.sh" ] && . "$HOME/.config/zsh/secrets.sh"

echo "🔧  Ensuring user directory for system sockets exists..."
RUNTIME_DIR="$TMPDIR/runtime-$UID"
\mkdir -p "$RUNTIME_DIR"
\chmod 0700 "$RUNTIME_DIR"

# Provision the runtimes declared in ~/.config/mise/config.toml (now
# deployed by chezmoi). This puts python/node/go/rust/uv on disk so
# that system-update's uv/npm/go syncs have working interpreters.
# `mise install` (no args) installs everything in the active config;
# it's idempotent on re-runs.
echo "🛠️  Installing mise-managed runtimes..."
mise install

# Make the just-installed mise shims discoverable by subsequent
# commands in this script. `eval mise activate` covers it for bash
# subshells; the durable PATH addition for zsh scripts lives in
# environment.sh.
eval "$(mise activate bash --shims)"

# system-update is the canonical "everything at latest" implementation
# (also exposed as the user-facing `system-update` command). On a fresh
# machine it installs Brewfile contents + Yazi plugins + NeoVim plugins,
# pulls the cloned zsh plugins, and converges everything else. On an
# already-bootstrapped machine it brings everything to latest.
echo "♻️  Running system-update to converge tools to latest..."
"$HOME/.local/bin/system-update"

{{- if not (index .pi.devExtensions "pi-cockpit") }}

# Install pi-cockpit from GitHub on consumer machines (machines without
# the dev working tree at ~/Projects/apps/pi/pi-cockpit). On dev
# machines this block is omitted entirely; the symlink template under
# dot_pi/agent/extensions/ points pi at the live working tree instead.
echo "🧩  Installing pi-cockpit from GitHub..."
if command -v pi >/dev/null 2>&1; then
  if ! pi list 2>/dev/null | grep -q pi-cockpit; then
    pi install git:github.com/Townk/pi-cockpit
  else
    echo "✅  pi-cockpit already installed"
  fi
else
  echo "⚠️   pi CLI not on PATH; skipping pi-cockpit install (run \`pi install git:github.com/Townk/pi-cockpit\` manually)"
fi
{{- end }}

{{- if not (index .pi.devExtensions "pi-plannotator-bridge") }}

# Install pi-plannotator-bridge from GitHub on consumer machines.
# Same dev-vs-consumer pattern as pi-cockpit above. Update the
# `pi install` URL once the GitHub repo is published.
echo "🧩  Installing pi-plannotator-bridge from GitHub..."
if command -v pi >/dev/null 2>&1; then
  if ! pi list 2>/dev/null | grep -q pi-plannotator-bridge; then
    pi install git:github.com/Townk/pi-plannotator-bridge
  else
    echo "✅  pi-plannotator-bridge already installed"
  fi
else
  echo "⚠️   pi CLI not on PATH; skipping pi-plannotator-bridge install (run \`pi install git:github.com/Townk/pi-plannotator-bridge\` manually)"
fi
{{- end }}

# vim:ft=sh
