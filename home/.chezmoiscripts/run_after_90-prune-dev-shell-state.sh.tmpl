{{- $traits := includeTemplate "profile-traits.tmpl" . | fromJson -}}
{{- if $traits.ephemeral -}}
#!/bin/sh
set -eu

# These paths are intentionally ignored on headless dev shells. Because ignored
# targets are skipped by .chezmoiremove, prune stale copies explicitly.
#   - ~/Library: the launchd environment agent + Application Support tealdeer
#     symlink deployed before the off-darwin ignore existed (2026-08-03).
#   - system-service-{launchd,brew} + completions: macOS service workers that
#     deployed before workers became per-platform (systemd worker era).
rm -rf -- \
  "$HOME/.pi/agent-local" \
  "$HOME/.config/espanso" \
  "$HOME/.config/ghostty" \
  "$HOME/.config/hammerspoon" \
  "$HOME/.config/homebrew" \
  "$HOME/.config/wezterm" \
  "$HOME/Library" \
  "$HOME/.local/bin/system-service-launchd" \
  "$HOME/.local/bin/system-service-brew" \
  "$HOME/.local/share/zsh/site-functions/_system-service-launchd" \
  "$HOME/.local/share/zsh/site-functions/_system-service-brew" \
  "$HOME/.local/libexec/disk-image-view" \
  "$HOME/.local/bin/system-backup" \
  "$HOME/.local/bin/system-backup-capture" \
  "$HOME/.local/bin/system-backup-reconcile" \
  "$HOME/.local/libexec/system-backup-tm" \
  "$HOME/.local/libexec/tm-tab" \
  "$HOME/.local/lib/backup.zsh" \
  "$HOME/.local/lib/backup-tm.zsh" \
  "$HOME/.local/lib/backup-drift.zsh" \
  "$HOME/.local/share/zsh/site-functions/_system-backup" \
  "$HOME/.local/share/zsh/site-functions/_system-backup-capture" \
  "$HOME/.local/share/zsh/site-functions/_system-backup-reconcile" \
  "$HOME/.local/share/zsh/site-functions/_tm" \
  "$HOME/.config/backup" \
  "$HOME/.config/packages/Brewfile" \
  "$HOME/.config/packages/Brewfile.bootstrap" \
  "$HOME/.claude/skills/jira-acli" \
  "$HOME/.claude/skills/confluence-acli" \
  "$HOME/.config/agent-skills/jira-acli" \
  "$HOME/.config/agent-skills/confluence-acli" \
  "$HOME/.pi/agent/skills/jira-acli" \
  "$HOME/.pi/agent/skills/confluence-acli"
{{- end }}
