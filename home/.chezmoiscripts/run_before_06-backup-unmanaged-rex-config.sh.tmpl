#!/bin/sh
set -eu

# Keep ONE copy of the Rex config that existed before chezmoi owned the file.
#
# ~/.config/rex/init.lua is written by Rex's onboarding importer (it migrates
# tmux/zellij/Ghostty/WezTerm settings) and is the user's working config until
# the first `chezmoi apply` that carries home/dot_config/rex/init.lua.tmpl —
# which replaces it wholesale. Nothing in the old file is carried over, but it
# should not vanish without a copy.
#
# A `before` script, because by the time an `after` script runs the file has
# already been overwritten. It runs on every apply and is a no-op on all but
# one: the generated file carries a marker line, so a file WITH the marker is
# ours and is never backed up, and an existing backup is never overwritten.

conf="$HOME/.config/rex/init.lua"
backup="${XDG_STATE_HOME:-$HOME/.local/state}/rex/init.lua.pre-chezmoi"

[ -f "$conf" ] || exit 0
[ ! -e "$backup" ] || exit 0
if grep -q 'GENERATED by chezmoi' "$conf" 2>/dev/null; then
  exit 0
fi

mkdir -p "${backup%/*}"
cp -p "$conf" "$backup"
echo "📦  Kept the previous Rex config at $backup"

# vim:ft=sh
