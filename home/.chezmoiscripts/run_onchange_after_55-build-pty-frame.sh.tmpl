{{- /*
  pty-frame — rebuild the picker-modal compositor when its Go source changes.

  pty-frame draws the floating-picker chrome (outer box + "▓▓▓ <title>" header +
  rule) and runs fzf in a sub-pty composited inside it, so the borderless modal
  matches the dialog spec exactly (the input→list blank fzf alone can't render).
  pick-common.zsh calls ~/.local/libexec/pty-frame when present, else falls back
  to the fzf-owns-the-box layout — so a box without it (or without Go) still works.

  The source SHA fingerprints below are baked into the rendered script, so
  run_onchange re-fires whenever main.go or go.mod change. `go build` is fast and
  non-interactive, so we build inline (no marker/prompt dance the font hook needs).
*/ -}}
{{- $mainSHA := include "../custom-builds/pty-frame/main.go" | sha256sum -}}
{{- $modSHA := include "../custom-builds/pty-frame/go.mod" | sha256sum -}}
#!/usr/bin/env bash
# pty-frame compositor — rebuild-on-change hook.
#   main.go : {{ $mainSHA }}
#   go.mod  : {{ $modSHA }}
#
# To rebuild manually:
#   make -C ~/.local/share/chezmoi/custom-builds/pty-frame install

set -euo pipefail

SRC="{{ .chezmoi.workingTree }}/custom-builds/pty-frame"

if ! command -v go >/dev/null 2>&1; then
  echo "[pty-frame] go not found; skipping build (pickers fall back to fzf-owns-the-box)." >&2
  exit 0
fi
if [ ! -d "$SRC" ]; then
  echo "[pty-frame] source missing at $SRC; skipping." >&2
  exit 0
fi

echo "[pty-frame] building → ~/.local/libexec/pty-frame"
make -C "$SRC" install

# vim:ft=sh
