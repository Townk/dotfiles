{{- /*
  dev-shell tool provisioning (Linux only).

  Owns the Linux dev-shell equivalent of
  run_once_after_10-setup-bootstrap-tools:

    1. mise install  — language runtimes (config.toml) + the CLI toolbox
                       declared in conf.d/dev-shell.toml.
    2. apt-get       — system libraries that aren't single Go/Rust
                       binaries (media/doc tooling many CLIs and the
                       `preview` script depend on).
    3. system-update — Homebrew-less convergence for package manifests,
                       Neovim plugins, and refreshable ecosystems.

  Every install step is best-effort: a single unavailable package must
  never abort the run (and thus block later chezmoi scripts). Failures
  are collected and reported at the end.

  Only runs on linux + dev-shell.
*/ -}}
{{- if and (eq .chezmoi.os "linux") (eq .profile "dev-shell") -}}
#!/bin/bash
set -uo pipefail

echo "🧰  Provisioning dev-shell tools..."

# chezmoi may run this with a minimal PATH; make sure the bootstrap
# binaries are reachable.
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:/snap/bin:$PATH"

failures=()

RUNTIME_DIR="${TMPDIR:-/tmp}/runtime-${UID:-$(id -u)}"
mkdir -p "$RUNTIME_DIR"
chmod 0700 "$RUNTIME_DIR"

# 1. mise: language runtimes + conf.d CLI toolbox. Best-effort — mise
#    installs every tool it can and reports the rest; we don't let a
#    single failure abort provisioning.
if command -v mise >/dev/null 2>&1; then
  echo "🛠️  Installing mise-managed runtimes and CLI toolbox..."
  mise install -y || failures+=("mise install (some tools failed; rerun 'mise install')")
else
  failures+=("mise not found on PATH")
fi

# 2. System libraries via apt. These back the media/document handlers in
#    the `preview` script, yazi previews, and assorted CLI tools that
#    aren't distributed as standalone Go/Rust binaries.
APT_PACKAGES=(
  figlet                 # lolbanner
  lolcat                 # lolbanner
  pandoc                 # universal document converter
  ffmpeg                 # yazi media
  ffmpegthumbnailer      # yazi video thumbnails
  poppler-utils          # pdftocairo (preview-pdf)
  mediainfo              # preview-mediainfo
  libimage-exiftool-perl # exiftool (yazi)
  imagemagick            # image conversion
  p7zip-full             # 7z archives
  unar                   # rar/other archive extraction
  graphviz               # dot/plantuml
  expect                 # unbuffer (preview force-tty / glow)
  aspell                 # spell checking
  hunspell               # spell checking
  rsync                  # file sync
  netcat-openbsd         # nc -U for trusted local clipboard socket
  file                   # mime detection (preview dispatch)
  git-lfs                # large files in git
  build-essential        # local source builds (tmux)
  libncurses-dev         # tmux build dependency
  clang                  # bindgen/libclang headers for Rust crates (tree-sitter-cli)
  libclang-dev           # libclang development files for bindgen
)

# sudo runs with env_reset, so these have to ride on the command line rather
# than be exported. DEBIAN_FRONTEND stops debconf from opening a dialog;
# NEEDRESTART_SUSPEND stops apt's post-invoke hook from asking which daemons to
# restart. Either prompt blocks the run forever when chezmoi is attached to a
# tty, and restarting system daemons is not this script's business.
APT_ENV=(DEBIAN_FRONTEND=noninteractive NEEDRESTART_SUSPEND=1)

if command -v apt-get >/dev/null 2>&1; then
  echo "📦  Installing system libraries via apt (this can take several minutes)..."
  sudo "${APT_ENV[@]}" apt-get update -qq || failures+=("apt-get update")
  if ! sudo "${APT_ENV[@]}" apt-get install -y -qq "${APT_PACKAGES[@]}"; then
    failures+=("apt: batch install")
    echo "📦  apt batch install failed; retrying packages individually..."
    for pkg in "${APT_PACKAGES[@]}"; do
      if ! sudo "${APT_ENV[@]}" apt-get install -y -qq "$pkg" >/dev/null 2>&1; then
        failures+=("apt: $pkg")
      fi
    done
  fi
else
  failures+=("apt-get not found (skipped system libraries)")
fi

# 3. Zsh plugins (zsh-abbr included) are cloned by the cross-platform
#    run_onchange_after_20-setup-zsh-plugins script into
#    ~/.local/share/zsh/plugins; nothing to do here.

# 4. Run the same Homebrew-less convergence path the user gets from
#    `system-update`. CHEZMOI=1 prevents source pull/apply recursion.
if command -v system-update >/dev/null 2>&1; then
  echo "♻️  Running system-update to converge dev-shell tools..."
  CHEZMOI=1 system-update || failures+=("system-update")
else
  failures+=("system-update not found on PATH")
fi

if (( ${#failures[@]} )); then
  echo "⚠️  dev-shell provisioning finished with some skipped items:"
  printf '   - %s\n' "${failures[@]}"
  echo "   (these are best-effort; the shell is still usable)"
else
  echo "👍  dev-shell tools provisioned successfully!"
fi

# vim:ft=sh
{{- end }}
