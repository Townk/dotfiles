{{/*
  Resolve each managed plugin's load path through the shared
  .chezmoitemplates/zellij-plugin-path.tmpl helper, the same way config.kdl
  and ensure-plugins do.
  Zellij keys the permission cache by this exact path (the `file:` prefix is
  stripped), so we grant against the resolved path.
*/ -}}
{{- $paths := list -}}
{{- range .zellijPlugins -}}
{{- $paths = append $paths (includeTemplate "zellij-plugin-path.tmpl" (dict "root" $ "plugin" .) | trim) -}}
{{- end -}}
#!/bin/bash
# Pre-grant Zellij plugin permissions.
#
# Our headless plugins (loaded via `load_plugins` and the zj-hud bar /
# which-key / search instances the layout spawns) can never be granted
# permissions interactively: Zellij's dialog only works for a plugin that
# owns a visible pane (upstream #4982), and over SSH / nested sessions even
# that is unreliable. Without a grant the plugin silently fails — e.g.
# Ctrl+hjkl pane navigation dies on remote sessions. The supported
# workaround is to pre-populate the permission cache, which the loader
# checks before prompting.
#
# Runs on every machine, every `chezmoi apply`. The granted paths are
# resolved from the shared manifest at template time (see the header), so
# they always match what config.kdl loads.
set -euo pipefail

# Zellij keys its permission cache under an OS-specific cache dir (the
# `directories` crate: Library/Caches/<bundle> on macOS, ~/.cache/<app>
# elsewhere). macOS ignores XDG_CACHE_HOME, so don't honour it there.
case "$(uname -s)" in
  Darwin) cache_dir="$HOME/Library/Caches/org.Zellij-Contributors.Zellij" ;;
  *)      cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zellij" ;;
esac
perms="$cache_dir/permissions.kdl"
mkdir -p "$cache_dir"
tmp="${TMPDIR:-/tmp}/zellij-permissions.$$"
trap 'rm -f "$tmp"' EXIT HUP INT TERM

# Grant the full permission set (all 17 PermissionType variants) so a future
# plugin version that requests an extra permission doesn't reintroduce the
# un-acceptable prompt. Overwrites the cache: only the manifest's plugins are
# trusted, and a removed plugin's stale grant should not linger.
cat > "$tmp" <<'KDL'
{{ range $paths -}}
"{{ . }}" {
    ReadApplicationState
    ChangeApplicationState
    OpenFiles
    RunCommands
    OpenTerminalsOrPlugins
    WriteToStdin
    WebAccess
    ReadCliPipes
    MessageAndLaunchOtherPlugins
    Reconfigure
    FullHdAccess
    StartWebServer
    InterceptInput
    ReadPaneContents
    RunActionsAsUser
    WriteToClipboard
    ReadSessionEnvironmentVariables
}
{{ end -}}
KDL

if [ -f "$perms" ] && cmp -s "$tmp" "$perms"; then
  exit 0
fi

mv "$tmp" "$perms"
trap - EXIT HUP INT TERM
