{{- /*

  Symbols Nerd Font — static change detection hook.

  Strategy:
    - run_onchange_after_*: chezmoi hashes this template's rendered
      output and re-runs the script whenever the hash changes.
    - We bake static FONT fingerprints into the rendered script as comments:
        1. The SHA256 of build-updated-font.sh itself. Editing the
           builder also triggers a rebuild on next apply.
        2. The SHA256 of unicode-donor-glyphs.txt.
        3. A digest of custom icon inputs that affect the font itself:
           every *.svg and the optional metadata.json `code` pins.
    - We also bake the full metadata.json hash to make metadata-only edits
      execute this hook, but those do NOT set the font marker. The DB hook
      owns metadata-only search fields.

  This hook tracks only repo inputs that change the FONT (and therefore
  glyphs.json). DB-only inputs — metadata-only custom icon fields, the WezTerm
  font fallback, and build-symbols-db.py itself — live in the sibling DB hook
  and the run_after_80 runtime detector.
  (Accepting a font rebuild here still rebuilds the DB afterwards, since
  new glyphs.json must be re-ingested.)

  This script's only job is DETECTION: when a trigger fires it writes a
  marker file and exits 0.  The companion run_after_80-symbols-nerd-
  font-prompt.sh.tmpl (which runs on EVERY chezmoi apply) reads the marker
  and shows the interactive build prompt when a TTY is available.

  Separating detection from prompting means:
    * A non-interactive apply (CI, editor hook, cron) writes the marker
      and commits the hash — it doesn't loop.
    * The very next interactive `chezmoi apply` sees the marker and shows
      the prompt.
    * No `chezmoi apply` ever exits non-zero due to this hook.

  On Linux, the whole script short-circuits to `exit 0` early anyway.
*/ -}}
{{- $builderSHA := "" -}}
{{- $donorGlyphs := "" -}}
{{- $customFontInputs := "" -}}
{{- $customMetaSHA := "" -}}
{{- $fontStaticSig := "" -}}
{{- if eq .chezmoi.os "darwin" -}}
  {{- $builderSHA = include "../custom-builds/nerd-fonts/build-updated-font.sh" | sha256sum -}}
  {{- $donorGlyphs = include "../custom-builds/nerd-fonts/unicode-donor-glyphs.txt" | sha256sum -}}
  {{- $customMetaSHA = include "../custom-builds/nerd-fonts/custom-icons/metadata.json" | sha256sum -}}
  {{- $customFontInputs = output "sh" "-c" (printf "python3 - %q <<'PY'\nimport hashlib, json, os, sys\nroot = sys.argv[1]\nh = hashlib.sha256()\nif os.path.isdir(root):\n    for dirpath, _, filenames in os.walk(root):\n        for name in sorted(filenames):\n            if not name.endswith('.svg'):\n                continue\n            path = os.path.join(dirpath, name)\n            rel = os.path.relpath(path, root)\n            h.update(b'svg\\0')\n            h.update(rel.encode('utf-8', 'surrogateescape'))\n            h.update(b'\\0')\n            with open(path, 'rb') as fh:\n                h.update(fh.read())\nmeta = os.path.join(root, 'metadata.json')\ntry:\n    with open(meta, 'r', encoding='utf-8') as fh:\n        data = json.load(fh)\n    icons = data.get('icons', data) if isinstance(data, dict) else {}\n    for key in sorted(k for k in icons if not str(k).startswith(('_', '$'))):\n        value = icons[key]\n        if isinstance(value, dict) and 'code' in value:\n            h.update(b'code\\0')\n            h.update(str(key).encode('utf-8'))\n            h.update(b'\\0')\n            h.update(str(value['code']).encode('utf-8'))\n            h.update(b'\\0')\nexcept Exception:\n    pass\nprint(h.hexdigest()[:16])\nPY" (joinPath .chezmoi.workingTree "custom-builds/nerd-fonts/custom-icons")) | trim -}}
  {{- $fontStaticSig = printf "builder:%s\ndonor:%s\ncustom-font:%s\n" $builderSHA $donorGlyphs $customFontInputs | sha256sum -}}
{{- end -}}
#!/bin/bash
# Symbols Nerd Font (custom build) — change-detection hook.
#
# Re-runs automatically when any of the static fingerprints below changes:
#   builder script SHA256 : {{ if $builderSHA }}{{ $builderSHA }}{{ else }}(not macOS){{ end }}
#   donor glyphs SHA256   : {{ if $donorGlyphs }}{{ $donorGlyphs }}{{ else }}(none / not macOS){{ end }}
#   custom font inputs    : {{ if $customFontInputs }}{{ $customFontInputs }}{{ else }}(none / not macOS){{ end }}
#   custom metadata SHA   : {{ if $customMetaSHA }}{{ $customMetaSHA }}{{ else }}(none / not macOS){{ end }}
#   combined font sig     : {{ if $fontStaticSig }}{{ $fontStaticSig }}{{ else }}(not macOS){{ end }}
#
# `custom metadata SHA` is present only to execute this hook on metadata edits.
# Only `combined font sig` changes write the font marker. Metadata-only search
# edits are routed to the DB hook.
#
# When a change is detected this script writes a marker file so that the
# companion run_after_80-symbols-nerd-font-prompt.sh can show the build
# prompt on the next interactive `chezmoi apply`, regardless of whether
# this detection script was run interactively or not.
#
# To force a rebuild without changing anything else:
#   touch ~/.local/state/chezmoi/nerd-font-build-pending
#   chezmoi apply   # (interactively)
# or invoke the builder directly:
#   ~/.local/share/chezmoi/custom-builds/nerd-fonts/build-updated-font.sh --install

set -eu

{{- if ne .chezmoi.os "darwin" }}
# Builder relies on Homebrew + the `font-fontawesome` cask. macOS-only
# for now. Exit cleanly so chezmoi apply succeeds on Linux/WSL.
exit 0
{{- end }}

SCRIPT="{{ .chezmoi.workingTree }}/custom-builds/nerd-fonts/build-updated-font.sh"
MARKER="${HOME}/.local/state/chezmoi/nerd-font-build-pending"
STATE="${HOME}/.local/state/chezmoi/nerd-font-static.sig"
STATIC_SIG="{{ $fontStaticSig }}"

if [ ! -x "$SCRIPT" ]; then
  echo "[symbols-nerd-font] builder missing at $SCRIPT — skipping." >&2
  exit 0
fi

mkdir -p "$(dirname "$MARKER")"
previous=""
[ -f "$STATE" ] && previous="$(cat "$STATE" 2>/dev/null || true)"
printf '%s\n' "$STATIC_SIG" > "$STATE"

if [ -n "$previous" ] && [ "$previous" != "$STATIC_SIG" ]; then
  printf '%s\n' "static font inputs changed" > "$MARKER"
  echo "[symbols-nerd-font] static font input change detected; build pending (marker written)."
else
  echo "[symbols-nerd-font] static font fingerprint initialized/unchanged."
fi

# vim:ft=sh
