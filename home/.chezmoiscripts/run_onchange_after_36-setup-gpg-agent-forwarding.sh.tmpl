#!/bin/sh
set -eu
{{/*
  Enable the gpg-agent-forwarding systemd unit and (re)run it immediately, so
  `chezmoi apply` has instant effect. The unit itself — not this script — is
  what makes forwarding survive a reboot: this dev shell wipes everything
  outside $HOME (including /etc) on every reboot, so the actual socket-dir +
  sshd StreamLocalBindUnlink provisioning (gpg-agent-forward-provision) must
  run from systemd on every boot, not from a chezmoi run_onchange step that
  only fires again when ITS OWN template content changes — which it wouldn't,
  even though /etc had been wiped underneath it.
*/ -}}
{{- $traits := includeTemplate "profile-traits.tmpl" . | fromJson -}}
{{ if and (eq .chezmoi.os "linux") $traits.headless }}
# Re-run when the unit or its script changes:
# gpg-forward-socketdir.service: {{ include "dot_config/systemd/user/gpg-forward-socketdir.service" | sha256sum }}
# gpg-agent-forward-provision: {{ include "dot_local/libexec/executable_gpg-agent-forward-provision" | sha256sum }}

if systemctl --user show-environment >/dev/null 2>&1; then
  systemctl --user daemon-reload
  systemctl --user enable gpg-forward-socketdir.service
  systemctl --user restart gpg-forward-socketdir.service
else
  echo "gpg-agent forwarding: no user systemd instance reachable; will provision at next login/boot." >&2
fi
{{ end }}

# vim:ft=sh
