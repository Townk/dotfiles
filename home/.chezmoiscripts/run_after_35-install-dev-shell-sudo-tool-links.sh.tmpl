#!/bin/sh
set -eu
{{/*
  On the Linux dev shell, a couple of mise-managed network tools need root
  privileges. Running their mise shims under sudo is wrong: the shim executes
  mise as root, which uses root's trust/config/install context. Instead, expose
  root-visible links to the actual installed binaries.
*/}}
{{ if and (eq .chezmoi.os "linux") (eq .profile "dev-shell") }}
install_sudo_link() {
  name="$1"
  backend_dir="$2"

  target="$(
    find -L "$HOME/.local/share/mise/installs/$backend_dir/latest" \
      -type f -name "$name" -perm -111 -print -quit 2>/dev/null || true
  )"

  if [ -z "$target" ]; then
    echo "sudo tool link: $name is not installed by mise yet; skipping" >&2
    return 0
  fi

  if sudo -n mkdir -p /usr/local/bin 2>/dev/null &&
     sudo -n ln -sfn "$target" "/usr/local/bin/$name" 2>/dev/null; then
    echo "sudo tool link: /usr/local/bin/$name -> $target"
  elif [ -t 0 ]; then
    echo "sudo tool link: installing /usr/local/bin/$name (sudo authentication required)"
    sudo mkdir -p /usr/local/bin
    sudo ln -sfn "$target" "/usr/local/bin/$name"
  else
    echo "sudo tool link: sudo credentials unavailable; run 'chezmoi apply' interactively" >&2
  fi
}

install_sudo_link bandwhich aqua-imsnif-bandwhich
install_sudo_link trip aqua-fujiapple852-trippy
{{ end }}

# vim:ft=sh
