{{- /*
  tm-timeline — rebuild the scrub-session timeline pane when its Go source
  changes.

  The compiled pane gives the tm scrub session what a zsh read -k loop can't:
  raw-mode input, event-driven flicker-free redraws, resize handling, and
  near-instant focus-aware highlighting — with the truecolor theme passed in
  as flags from the single-source palette. system-backup-tm falls back to
  its shell timeline loop when the binary (or Go) is missing, so nothing
  breaks without it.

  Source SHA fingerprints below re-fire this run_onchange script whenever
  main.go or go.mod change; `go build` is fast and non-interactive.
*/ -}}
{{- $mainSHA := include "../custom-builds/tm-timeline/main.go" | sha256sum -}}
{{- $modSHA := include "../custom-builds/tm-timeline/go.mod" | sha256sum -}}
#!/usr/bin/env bash
# tm-timeline scrub pane — rebuild-on-change hook.
#   main.go : {{ $mainSHA }}
#   go.mod  : {{ $modSHA }}
#
# To rebuild manually:
#   make -C ~/.local/share/chezmoi/custom-builds/tm-timeline install

set -euo pipefail

SRC="{{ .chezmoi.workingTree }}/custom-builds/tm-timeline"

if ! command -v go >/dev/null 2>&1; then
  echo "[tm-timeline] go not found; skipping build (timeline falls back to the shell loop)." >&2
  exit 0
fi
if [ ! -d "$SRC" ]; then
  echo "[tm-timeline] source missing at $SRC; skipping." >&2
  exit 0
fi

echo "[tm-timeline] building → ~/.local/libexec/tm-timeline"
make -C "$SRC" install

# vim:ft=sh
