# Prune targets orphaned by the 2026-06 refactors. chezmoi converges files
# that exist in the source but never deletes targets whose source entry was
# renamed or removed — so without this, other machines would keep stale copies
# alongside the new ones. Each pattern is gitignore-style relative to $HOME and
# ALL are anchored (leading slash) so they match ONLY the old path, never a
# relocated equivalent (e.g. an unanchored ".zshrc" would also hit the new
# ~/.config/zsh/.zshrc). Removing only affects machines that still have them.

# ── zsh: de-zsh4humans migration ────────────────────────────────────────────
# .zshrc + p10k.zsh moved under ~/.config/zsh (via ZDOTDIR); also drop p10k's
# stale z4h-era wordcode.
/.zshrc
/.p10k.zsh
/.p10k.zsh.zwc

# ── ~/.local/bin: scripts renamed / moved to libexec ────────────────────────
/.local/bin/nvim-wez.sh
/.local/bin/commit-ai
/.local/bin/commit-cursor
/.local/bin/pick-gitmoji
/.local/bin/pick-glyph
/.local/bin/pinentry-auto
/.local/bin/local-llm-bench
/.local/bin/local-llm-gateway
/.local/bin/ics-view
/.local/bin/sqlite-view
/.local/bin/disk-image-view
/.local/bin/tm-tab
/.local/bin/tab-edit
/.local/bin/fzf-tab-preview-open
/.local/bin/system-backup-tm
# tab-edit's completion was removed outright — it was never a typed command.
/.local/share/zsh/site-functions/_tab-edit

# ── clipboard reverse-forward folded into system-onboard ────────────────────
# The committed clipboard.config (a hardcoded Host + RemoteForward) is gone; the
# forward is now written per-alias into the loose ~/.ssh/config.d/<alias>.conf by
# system-onboard (default on; --no-clipboard / `onboard update <alias>
# --clipboard|--no-clipboard` to toggle). Prune the old committed copy.
/.ssh/config.d/clipboard.config

# ── local-LLM stack retired (llama-swap/gateway/headroom → mlx-gemma direct) ──
# pi-local was repointed to the [mlx-gemma] launchd service talking straight to
# mlx_vlm.server on :8799, orphaning the old chain. Drop the libexec helpers and
# the llama-swap config dir (the services.toml sections, brew formula, and uv
# tools are removed in their own manifests).
/.local/libexec/local-llm-bench
/.local/libexec/local-llm-gateway
/.config/llama-swap

# ── ~/.local/libexec: sync-remote-assets renamed to ssh-prepare-connection ──
# The pre-connect helper gained a gpg-socketdir-prep step (beyond the glyph DB +
# theme rsyncs), so it was renamed to reflect the wider scope. Drop the old name.
/.local/libexec/sync-remote-assets

