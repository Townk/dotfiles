/.local/lib/image-protocol-support
/.local/lib/system-package-common.sh
/.local/lib/system-secrets-common.sh

# ── ~/.config/zellij/scripts/lib: consolidated to zsh (.sh → .zsh) ──────────
/.config/zellij/scripts/lib/command.sh
/.config/zellij/scripts/lib/config.sh
/.config/zellij/scripts/lib/dispatch.sh
/.config/zellij/scripts/lib/zellij-session.sh

# ── z4h-era leftovers (never chezmoi-managed) ───────────────────────────────
# HISTFILE is now ~/.local/state/zsh/history and the compdump ~/.cache/zsh; the
# old default-path files are dead. NOTE: ~/.zsh_history is a real history file —
# removing it on a machine whose atuin hasn't imported it yet loses that history.
/.zsh_history
/.zcompdump

# ── cursor: isolated to the work profile ────────────────────────────────────
# The whole cursor footprint now deploys ONLY on the work profile (see
# .chezmoiignore.tmpl): ~/.cursor (agent config) plus the ai-commit-cursor
# harness and its completion. Prune any copy left behind on non-work machines
# from before the split. Gated so the work profile — where these are
# legitimately managed — never removes its own files.
{{ if ne .profile "work" -}}
/.cursor
/.local/bin/ai-commit-cursor
/.local/share/zsh/site-functions/_ai-commit-cursor
{{- end }}

