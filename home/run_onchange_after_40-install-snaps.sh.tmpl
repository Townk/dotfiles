{{- /*
  Install snap packages declared in ~/.config/packages/Snapfile.

  This is run_onchange and embeds the Snapfile's hash below, so chezmoi
  re-runs it whenever the Snapfile changes (the manifest-sync pattern,
  mirroring Brewfile -> system-package on macOS). `system-update` keeps
  installed snaps refreshed afterwards.

  Linux + dev-shell only.
*/ -}}
{{- if and (eq .chezmoi.os "linux") (eq .profile "dev-shell") -}}
#!/bin/bash
# Snapfile hash: {{ include "dot_config/packages/Snapfile" | sha256sum }}
# (changing the Snapfile changes this line, so chezmoi re-runs the script)
set -uo pipefail

SNAPFILE="$HOME/.config/packages/Snapfile"
command -v snap >/dev/null 2>&1 || { echo "snap not available; skipping Snapfile."; exit 0; }
[ -r "$SNAPFILE" ] || { echo "no Snapfile at $SNAPFILE; skipping."; exit 0; }

echo "🫰  Syncing snap packages from Snapfile..."
fail=0
while IFS= read -r line || [ -n "$line" ]; do
  line="${line%%#*}"                          # strip comments
  line="${line#"${line%%[![:space:]]*}"}"     # left-trim
  [ -z "$line" ] && continue
  # shellcheck disable=SC2086
  set -- $line                                # split name + flags
  name="$1"; shift; flags="$*"
  if snap list "$name" >/dev/null 2>&1; then
    continue
  fi
  echo "   installing snap: $name $flags"
  # shellcheck disable=SC2086
  sudo snap install "$name" $flags || { echo "   ⚠ failed: $name"; fail=1; }
done < "$SNAPFILE"

[ "$fail" -eq 0 ] && echo "👍  snaps in sync" || echo "⚠  some snaps failed (see above)"
exit 0
{{- end }}
