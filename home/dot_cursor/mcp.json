{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp"
    },
    "headroom": {
      "type": "stdio",
      "command": "headroom",
      "args": [
        "mcp",
        "serve",
        "--proxy-url",
        "http://127.0.0.1:8787"
      ],
      "env": {
        "HEADROOM_TELEMETRY": "off"
      }
    },
    "wezterm": {
      "command": "wezterm-mcp"
    },
    "zellij": {
      "command": "bash",
      "args": [
        "-c",
        "exec node \"$(npm root -g)/zellij-mcp-server/dist/index.js\""
      ]
    },
    "ghostty": {
      "command": "bash",
      "args": [
        "-c",
        "ROOT=\"$(npm root -g)/ghostty-mcp\"; test -f \"$ROOT/dist/index.js\" || (cd \"$ROOT\" && npm run build --silent); exec node \"$ROOT/dist/index.js\""
      ]
    }
  }
}
