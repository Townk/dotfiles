# Personal Zsh configuration.
#
# Assembled explicitly (no framework): standalone powerlevel10k for the
# prompt, git-cloned plugins under ~/.local/share/zsh/plugins, and
# zsh-defer to push non-critical loads past the first prompt. Instant
# prompt keeps the perceived startup at ~zero; the heavy work (compinit,
# ZLE plugins, tool init) runs asynchronously right after.

# A scripted Ghostty surface carries its direct command in the environment so
# it can run before any prompt or shell input is painted. quick-launch-window
# supplies a shell-quoted command and an optional validated tint. Clear both
# before launching so the remote process cannot inherit/replay them.
if [[ -n "${MUX_INITIAL_COMMAND:-}" ]]; then
  _mux_initial_command="$MUX_INITIAL_COMMAND"
  _mux_initial_tint="${MUX_INITIAL_TINT:-}"
  unset MUX_INITIAL_COMMAND MUX_INITIAL_TINT

  if [[ "$_mux_initial_tint" =~ '^#[[:xdigit:]]{6}$' ]]; then
    printf '\e]11;%s\e\\' "$_mux_initial_tint"
  else
    _mux_initial_tint=""
  fi

  eval "$_mux_initial_command"
  _mux_initial_status=$?
  [[ -z "$_mux_initial_tint" ]] || printf '\e]111\e\\'
  unset _mux_initial_command _mux_initial_tint
  exit $_mux_initial_status
fi

_zsh_should_autoattach_mux() {
  # Cross-nesting guard (mux migration spec §2/D17, pulled forward in Phase 0):
  # never autostart a multiplexer inside *either* mux's pane. tmux.conf scrubs
  # the stale ZELLIJ* vars from pane envs (cross-mux hygiene), so without the
  # $TMUX check a tmux pane's shell would pass the $ZELLIJ test and nest.
  [[ -z "$ZELLIJ" ]] || return 1
  [[ -z "$TMUX" ]] || return 1
  [[ -t 0 && -t 1 ]] || return 1

  # GUI helpers can launch interactive zsh at login without a real terminal.
  # Only auto-attach when the shell is backed by a terminal emulator or SSH.
  [[ -n "${TERM_PROGRAM:-}" ]] && return 0
  [[ -n "${WEZTERM_PANE:-}" || -n "${WEZTERM_UNIX_SOCKET:-}" ]] && return 0
  [[ -n "${GHOSTTY_RESOURCES_DIR:-}" ]] && return 0
  [[ -n "${SSH_CONNECTION:-}" || -n "${SSH_CLIENT:-}" || -n "${SSH_TTY:-}" ]] && return 0

  return 1
}

# Theme override layer: resolve the effective palette + Zellij `system` theme
# (canonical ⊕ loose ~/.config/theme/override.toml) BEFORE the Zellij attach
# below, so the session loads the tinted theme and zj-hud's bar follows it.
# Exports the palette env vars for the shell/fzf/dialogs/viewers (inherited
# across the exec and by the panes). A no-op when no override.toml exists.
# Absolute path — libexec is never on PATH (and PATH isn't set up yet here anyway).
~/.local/libexec/theme-apply 2>/dev/null
[[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/theme/chezmoi-system.zsh" ]] \
  && export THEME_PALETTE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/theme/chezmoi-system.zsh" \
            THEME_PALETTE_JSON="${XDG_CACHE_HOME:-$HOME/.cache}/theme/chezmoi-system.json"
# Load the palette into this shell so the prompt (p10k), _lib.sh, completion.sh,
# and the welcome separator can reference C_HEX_* (the effective palette when an
# override is active, else canonical). chezmoi-system.zsh is fork-free and guarded.
source "${THEME_PALETTE_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/theme/chezmoi-system.zsh}"

# gpg-agent forward drift notice — SSH login shells only, BEFORE the Zellij
# attach below. The forwarded agent socket path embeds the remote uid + gpgconf's
# homedir hash, so a re-provisioned box can leave the client's
# ~/.ssh/config.d/<host>.conf pointing at a stale path. ssh-prepare-connection
# heals it, but only for the NEXT connection, so when it does it arms this marker
# here (its existence is the whole signal — the client's heal is the drift
# oracle, so nothing pokes at sockets). This session is still on the stale
# forward, so prompt — BLOCKING (a short-lived window can't flash-and-close
# before you notice) — and clear the marker so it fires once. Choosing Reconnect
# exits the login shell, closing the connection so the next connect picks up the
# healed forward (its heal then finds nothing to change and never re-arms); Stay
# drops you into this (stale-forward) session. Colors come from the system
# palette loaded just above (C_HEX_*), with named fallbacks. Gated to the
# pre-attach login shell (ZELLIJ unset ⇒ once per connection; panes re-run .zshrc
# with ZELLIJ set and skip) on a real TTY.
_gpgfwd_marker="${XDG_STATE_HOME:-$HOME/.local/state}/ssh/new-socket"
if [[ -o interactive && -z "$ZELLIJ" && -n "${SSH_CONNECTION:-}" && -t 2 && -f "$_gpgfwd_marker" ]]; then
  rm -f "$_gpgfwd_marker"
  _gpgfwd_msg='gpg-agent socket moved since this box was provisioned — reconnect to refresh the gpg forward.'
  if command -v gum >/dev/null 2>&1; then
    if COLORTERM=truecolor \
       GUM_CONFIRM_PROMPT_FOREGROUND="${C_HEX_DIALOG_WARNING:-${C_HEX_YELLOW:-yellow}}" \
       GUM_CONFIRM_SELECTED_BACKGROUND="${C_HEX_DIALOG_WARNING:-${C_HEX_YELLOW:-yellow}}" \
       GUM_CONFIRM_SELECTED_FOREGROUND="${C_HEX_CRUST:-${C_HEX_BASE:-black}}" \
       GUM_CONFIRM_UNSELECTED_FOREGROUND="${C_HEX_SUBTEXT:-white}" \
       GUM_CONFIRM_UNSELECTED_BACKGROUND="${C_HEX_SURFACE0:-black}" \
       gum confirm --default --affirmative='Reconnect' --negative='Stay' \
         "$_gpgfwd_msg" </dev/tty >/dev/tty 2>&1; then
      unset _gpgfwd_msg _gpgfwd_marker
      exit 0
    fi
  else
    print -u2 -P -- "%F{yellow}⚠ ${_gpgfwd_msg}%f"
    if read -q "?Reconnect now? [y/N] " </dev/tty; then
      print; unset _gpgfwd_msg _gpgfwd_marker; exit 0
    fi
    print
  fi
  unset _gpgfwd_msg
fi
unset _gpgfwd_marker

# Auto-attach the multiplexer for interactive shells.
# Done before the rest of init so the outer shell doesn't pay for setup
# twice — the shell spawned inside the mux re-runs .zshrc with $ZELLIJ or
# $TMUX set, so the guard above short-circuits this block.
#
# WHICH mux starts here is the "outside a session" knob (spec §2): the loose
# ~/.config/mux/backend file if it names one, else the chezmoi .muxBackend
# default baked in below. This is *only* about what a bare terminal launches
# — dispatch inside a live session is runtime detection (mux::backend reading
# $TMUX/$ZELLIJ), so flipping this knob never strands an open session.
#
# "Main" session reuse, mirrored on both backends:
#   - doesn't exist (or only as EXITED) → wipe stale record, create+attach
#   - live, no clients                  → reattach (resume the existing one)
#   - live, has a client                → spawn a fresh anonymous session
#                                         (so Cmd+N etc. get their own mux)
if _zsh_should_autoattach_mux; then
  # Remote logins print a full-screen MOTD (pam_motd) before Zellij grabs the
  # alternate screen. Wipe the primary buffer + scrollback first so it doesn't
  # flash on attach, nor reappear when Zellij restores the primary buffer on
  # exit. SSH-scoped so local startup is untouched.
  [[ -n "$SSH_CONNECTION" ]] && printf '\e[H\e[2J\e[3J'
  # Record "Main" as the most-recently-used workspace in the quick-launch
  # picker's recency cache, so after switching to another workspace you can
  # flip straight back to Main (it sorts to the top of the picker). This boot
  # path doesn't go through quick-launch — which is what normally records a
  # pick — so we prepend it by hand (dedupe, cap at 50, like pick::record).
  # "default" is the workspace *id* whose session name is "Main"
  # (~/.config/mux/quick-launch/default.yaml); the recency file keys on id.
  _ql_seed_main() {
    local f="${XDG_CACHE_HOME:-$HOME/.cache}/quick-launch/usage-workspace"
    mkdir -p "${f:h}" 2>/dev/null || return 0
    local tmp="$f.$$"
    { print -r -- default; [[ -f "$f" ]] && grep -vFx default "$f"; } 2>/dev/null \
      | head -n 50 >| "$tmp" 2>/dev/null && mv -f "$tmp" "$f" 2>/dev/null
    return 0
  }
  # Resolve the knob: loose per-machine file wins, chezmoi data is the default.
  # Anything unrecognised in the loose file is ignored rather than obeyed — a
  # typo there must not leave the login shell with no multiplexer at all.
  _mux_backend="{{ .muxBackend }}"
  if [[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/mux/backend" ]]; then
    _mux_pin="$(<"${XDG_CONFIG_HOME:-$HOME/.config}/mux/backend")"
    _mux_pin="${_mux_pin//[[:space:]]/}"
    [[ "$_mux_pin" == (tmux|zellij) ]] && _mux_backend="$_mux_pin"
    unset _mux_pin
  fi

  if [[ "$_mux_backend" == tmux ]]; then
    for _tmux in /opt/homebrew/bin/tmux /usr/local/bin/tmux "$HOME/.local/share/mise/shims/tmux" ~/.local/bin/tmux /usr/bin/tmux; do
      [[ -x "$_tmux" ]] || continue
      # tmux tears a session down as soon as its last process exits, so there
      # is no EXITED record to sweep the way Zellij needs — has-session is the
      # entire liveness test. `-t=` anchors an exact match; a bare `-t Main`
      # would also match a session called "Main2".
      if "$_tmux" has-session -t=Main 2>/dev/null; then
        if "$_tmux" list-clients -t=Main 2>/dev/null | grep -q .; then
          exec "$_tmux" new-session
        else
          _ql_seed_main
          exec "$_tmux" attach-session -t=Main
        fi
      else
        _ql_seed_main
        exec "$_tmux" new-session -s Main
      fi
    done
  else
    for _zellij in /opt/homebrew/bin/zellij /usr/local/bin/zellij "$HOME/.local/share/mise/shims/zellij" ~/.local/bin/zellij; do
      [[ -x "$_zellij" ]] || continue
      # Make sure the managed plugin wasms exist before launch. We fetch them
      # ourselves (config.kdl loads them via file:) instead of trusting Zellij's
      # downloader, which caches transient 404/504 error pages as the plugin and
      # never retries. No-op once the wasms are present.
      [[ -x ~/.config/zellij/ensure-plugins ]] && ~/.config/zellij/ensure-plugins
      if "$_zellij" list-sessions -n 2>/dev/null | grep -v EXITED | grep -qE '^Main\b'; then
        if "$_zellij" --session Main action list-clients 2>/dev/null \
             | tail -n +2 | grep -q .; then
          exec "$_zellij" --new-session-with-layout default
        else
          # Main is idle → reattach. If the session record is stale, discard it
          # and create a fresh Main with the configured default layout.
          _ql_seed_main
          exec "$_zellij" attach Main || {
            "$_zellij" delete-session Main -f &>/dev/null
            exec "$_zellij" --session Main --new-session-with-layout default
          }
        fi
      else
        "$_zellij" delete-session Main -f &>/dev/null
        _ql_seed_main
        exec "$_zellij" --session Main --new-session-with-layout default
      fi
    done
  fi
  # Reached only when no backend binary was found — fall through to a plain
  # shell rather than leaving the terminal with nothing.
  unset _zellij _tmux _mux_backend
  unset -f _ql_seed_main 2>/dev/null
fi
unset -f _zsh_should_autoattach_mux 2>/dev/null

# Powerlevel10k instant prompt. Must stay near the top, before anything
# that prints to the terminal, so the cached prompt can render immediately
# while the rest of init runs. Quiet mode suppresses warnings about console
# output during init. The cache is (re)generated on each prompt once p10k
# is configured below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# zsh-defer: queues commands to run on the first precmd (just before the
# first real prompt), keeping them off the critical path to the prompt.
ZSH_PLUGIN_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins"
source "$ZSH_PLUGIN_DIR/zsh-defer/zsh-defer.plugin.zsh"

# ── Environment ──────────────────────────────────────────────────────────
# Core Go paths
export GOPATH="$XDG_DATA_HOME/go"
export GOMODCACHE="$XDG_CACHE_HOME/go-mod"
export GOCACHE="$XDG_CACHE_HOME/go-build"
export GOPROXY='https://proxy.golang.org,direct'

export HOMEBREW_NO_ENV_HINTS=1
export MANPAGER="less -R --use-color -Dd+r -Du+b"
export GPG_TTY=$TTY
export EDITOR=nvim
export USERNAME='Thiago Alves'

# pi-memctx: auto-persist durable memory candidates without /memctx-review
export MEMCTX_AUTOSAVE=auto

# Make terminal emulators use truecolor if they can
export COLORTERM=truecolor

# mise activates synchronously: it injects mise-managed tool dirs onto $PATH,
# and on Linux atuin/zoxide/etc. live there. Keeping it on the critical path
# guarantees PATH is correct before the first command. (The lighter tool
# inits — atuin/zoxide/wezterm — are deferred below.)
command -v mise >/dev/null && eval "$(mise activate zsh)"

# mise's Go backend exports GOBIN as the toolchain's own bin directory.
# Override it after activation so `go install` binaries stay separate from
# the compiler and can be reconciled safely by system-package-go.
export GOBIN="$GOPATH/bin"

# Extend PATH.
path=(~/.local/bin "$GOPATH/bin" /Applications/Obsidian.app/Contents/MacOS $path)

# ── History ──────────────────────────────────────────────────────────────
# atuin (deferred, below) owns interactive history search; this is the
# plain on-disk history that atuin imports from and that backs the session.
HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/history"
[[ -d "${HISTFILE:h}" ]] || mkdir -p "${HISTFILE:h}"
HISTSIZE=100000
SAVEHIST=100000
setopt extended_history hist_expire_dups_first hist_ignore_dups \
       hist_ignore_all_dups hist_ignore_space hist_find_no_dups \
       hist_verify inc_append_history share_history

# ── Shell options ─────────────────────────────────────────────────────────
setopt extended_glob    # ^ # ~ globbing operators (used by functions.sh/aliases.sh loaders)
setopt glob_dots        # no special treatment for file names with a leading dot
setopt auto_menu         # require an extra TAB press to open the completion menu
setopt combining_chars   # let ZLE combine zero-width marks onto the base char
setopt interactive_comments  # allow `# comments` on the command line
setopt auto_pushd pushd_ignore_dups pushd_silent  # cd builds $dirstack (super-cd `cd -`)

# substring-search highlight + match config (read when the plugin loads below)
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND="bg=none,fg=yellow,bold"
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_NOT_FOUND="bg=none,fg=red,bold"
HISTORY_SUBSTRING_SEARCH_GLOBBING_FLAGS="l"

# ── compdef shim ───────────────────────────────────────────────────────────
# The real `compdef` is provided by `compinit`, which is deferred (see
# completion.sh). Queue any compdef calls made during synchronous sourcing
# (e.g. in functions.d/commands.sh) and replay them after compinit runs.
typeset -ga _pending_compdefs
compdef() { _pending_compdefs+=("${(j: :)@}") }

# ── Synchronous config: abbreviations, functions, aliases ──────────────────
# zsh-abbr — provides the abbreviation engine used by smart-space expansion.
ABBR_USER_ABBREVIATIONS_FILE="${HOME}/.config/zsh/user-abbreviations.sh"
ABBR_DEFAULT_BINDINGS=0
source "$ZSH_PLUGIN_DIR/zsh-abbr/zsh-abbr.zsh"

# Autoload functions.
autoload -Uz zmv

# My own functions (super-cd, take, g, widgets, …). Sourced before aliases so
# the aliases that point at these functions resolve.
source ~/.config/zsh/functions.sh

# Mirror the already-loaded abbreviation maps into real aliases so syntax
# highlighting sees them even when they are not the first word on the line.
# Do this in-memory: `abbr export-aliases` acquires zsh-abbr's cross-session
# job queue on every shell startup. tmux starts and tears down shells close
# together, and a shell killed while exporting leaves a stale queue job that
# reports a timeout on a later login.
for _abbr_name in ${(iko)ABBR_GLOBAL_USER_ABBREVIATIONS}; do
  alias -g -- "${(Q)_abbr_name}=${(Q)ABBR_GLOBAL_USER_ABBREVIATIONS[$_abbr_name]}"
done
for _abbr_name in ${(iko)ABBR_REGULAR_USER_ABBREVIATIONS}; do
  alias -- "${(Q)_abbr_name}=${(Q)ABBR_REGULAR_USER_ABBREVIATIONS[$_abbr_name]}"
done
for _abbr_name in ${(iko)ABBR_GLOBAL_SESSION_ABBREVIATIONS}; do
  alias -g -- "${(Q)_abbr_name}=${(Q)ABBR_GLOBAL_SESSION_ABBREVIATIONS[$_abbr_name]}"
done
for _abbr_name in ${(iko)ABBR_REGULAR_SESSION_ABBREVIATIONS}; do
  alias -- "${(Q)_abbr_name}=${(Q)ABBR_REGULAR_SESSION_ABBREVIATIONS[$_abbr_name]}"
done
unset _abbr_name
# Then load my aliases, which may override anything from the abbreviations.
source ~/.config/zsh/aliases.sh

# ── Prompt ─────────────────────────────────────────────────────────────────
typeset -g POWERLEVEL9K_INSTANT_PROMPT=quiet
source "$ZSH_PLUGIN_DIR/powerlevel10k/powerlevel10k.zsh-theme"
[[ -r ~/.config/zsh/p10k.zsh ]] && source ~/.config/zsh/p10k.zsh

# ── Deferred: completion, ZLE plugins, tool init, keybindings ──────────────
# Order matters and is preserved by zsh-defer's FIFO queue:
#   1. completion system (compinit) + fzf completion  → defines `compdef`
#   2. zsh-autosuggestions                            → before syntax-highlighting
#   3. zsh-syntax-highlighting                        → after autosuggestions
#   4. zsh-history-substring-search                   → MUST be after syntax-highlighting
#   5. tool init (atuin/zoxide/wezterm)               → defines atuin widget
#   6. keybindings                                    → binds widgets from all of the above
zsh-defer source ~/.config/zsh/completion.sh
zsh-defer source "$ZSH_PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh"
zsh-defer source "$ZSH_PLUGIN_DIR/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
zsh-defer source "$ZSH_PLUGIN_DIR/zsh-history-substring-search/zsh-history-substring-search.zsh"

zsh-defer eval 'command -v atuin   >/dev/null && eval "$(atuin init zsh)"'
zsh-defer eval 'command -v zoxide  >/dev/null && eval "$(zoxide init zsh)"'
zsh-defer eval 'command -v wezterm >/dev/null && eval "$(wezterm shell-completion --shell zsh)"'

# Homebrew's command-not-found handler (macOS only; no-op where absent).
zsh-defer eval '[[ -r ${HOMEBREW_PREFIX:-/opt/homebrew}/Library/Taps/homebrew/homebrew-command-not-found/handler.sh ]] && source ${HOMEBREW_PREFIX:-/opt/homebrew}/Library/Taps/homebrew/homebrew-command-not-found/handler.sh'

zsh-defer source ~/.config/zsh/keybindings.sh

# ── Welcome screen ─────────────────────────────────────────────────────────
# Shown only when this is the lone pane of the current Zellij session (i.e.
# just opened a terminal). Summing every tab's selectable tiled + floating
# panes ignores HUD/which-key/notify plugin panes, so the count is 1 only on a
# fresh session; new tabs, panes, and reattaches read > 1 and stay quiet. A new
# window (Cmd+N) is a new session, so it shows again.
if [[ -n "$ZELLIJ" ]] && \
   [[ "$(zellij action list-tabs -p --json 2>/dev/null \
         | jq 'map(.selectable_tiled_panes_count + .selectable_floating_panes_count) | add' 2>/dev/null)" -eq 1 ]]; then
  type motd >/dev/null 2>&1 && motd
  print -P -- "                                        %F{$C_HEX_OVERLAY0}━━━━━━━━ ❖ ━━━━━━━━%f\n"
  type terminal_commands >/dev/null 2>&1 && terminal_commands
fi

# Run unalias -a when starting a shell session within OpenCode
if [[ -n "$OPENCODE" ]]; then
  unalias -a
fi
