{{- /*
  headless-Linux toolbox — mise-managed CLI tools for the headless Linux
  profiles (dev-shell, server, appliance). On a Mac these tools come from
  Brewfile.tmpl; here mise is the package manager, so the file renders empty
  everywhere else.

  mise loads every ~/.config/mise/conf.d/*.toml in addition to the main
  config.toml, so these tools install alongside the language runtimes
  without touching that file (no `mise use -g` drift).

  Names that resolve in mise's registry are used bare; the rest pin an
  explicit backend — aqua: (curated registry) for tools it covers, else
  github: (the successor to the now-deprecated ubi backend) straight off
  GitHub releases, http: for binaries hosted elsewhere, or cargo: when
  there's no usable release asset.
  `[exe=...]` overrides the installed binary name when it differs from
  the repo name.

  Authoring aids (benchmarking, changelogs, structural search, regex
  authoring, repo stats) are gated on the devTooling trait; the appliance
  profile leaves them out.
*/ -}}
{{- $traits := includeTemplate "profile-traits.tmpl" . | fromJson -}}
{{- if and (eq .chezmoi.os "linux") $traits.headless }}
{{- if eq .profile "dev-shell" }}
[settings]
# The hosted mise-versions API currently returns 403 for several aqua-backed
# GitHub release lookups on the dev shell. Disable it there so mise queries
# the backend directly instead of warning and falling back on every update.
# Measured on the dev-shell only; the server keeps mise defaults.
use_versions_host = false
{{- end }}

[tools]
# Registry-resolved (prebuilt binaries)
"zellij" = "latest"
# Build tmux locally because upstream publishes source only and the Aqua
# binaries omit native Sixel support. The asdf backend compiles the pinned
# release and owns the resulting mise shim.
"asdf:mise-plugins/mise-tmux" = { version = "3.7b", install_env = { TMUX_EXTRA_CONFIGURE_OPTIONS = "--enable-sixel" } }
"neovim" = "latest"
"bat" = "latest"
"eza" = "latest"
"fd" = "latest"
"jq" = "latest"
"yq" = "latest"
"ripgrep" = "latest"
"delta" = "latest"
"bottom" = "latest"
"duf" = "latest"
{{ if $traits.devTooling -}}
"hyperfine" = "latest"
{{- end }}
"jless" = "latest"
# tokei is NOT here: it ships no prebuilt binaries, so it must be built from
# source, and mise's cargo backend runs inside the same `mise install` that
# installs Rust — before rustup has a default toolchain. It lives in the
# Cargofile instead (built later by the cargo worker, once Rust is ready).
"gping" = "latest"
{{ if $traits.devTooling -}}
"grex" = "latest"
{{- end }}
"gron" = "latest"
"zoxide" = "latest"
"yazi" = "latest"
"lazygit" = "latest"
"glow" = "latest"
"gum" = "latest"
"doggo" = "latest"
"atuin" = "latest"
{{ if $traits.devTooling -}}
"git-cliff" = "latest"
"ast-grep" = "latest"
{{- end }}
"hexyl" = "latest"

# Secret decryption at chezmoi apply. A headless host's secrets fragment runs
# `output sops --decrypt` against its SOPS+age blob; age covers key rotation.
# See `system-onboard` / `system-secrets`.
"sops" = "latest"
"age" = "latest"

# sqlite3 CLI for the clipboard store (Phase 7). MUST be mise-managed, not
# apt: the image wipes everything outside $HOME on reboot, and the bridge
# dispatcher + pick-clipboard shell out to sqlite3 (incl. its readfile()/
# writefile() shell functions) on every store op.
"sqlite" = "latest"

# fzf straight from GitHub releases. The registry/apt fzf is too old
# (0.29) for the modern --bind keys z4h's completion widgets use (e.g.
# alt-page-up), which made TAB-completion error out. Pin the backend so
# we always get current upstream.
"github:junegunn/fzf" = "latest"

# Upstream's GitHub release only contains source. Install the official static
# binary directly; Ubuntu 22.04's chafa package is too old for tmux passthrough.
"http:chafa" = { version = "1.18.2", url = "https://hpjansson.org/chafa/releases/static/chafa-{{`{{ version }}`}}-1-x86_64-linux-gnu.tar.gz", checksum = "sha256:deb149bc8823589f635f24db3ecc83b7daa86e4c20d8a9f58e9ce53bd97bdda9" }

# Not in the registry — pinned to a GitHub-release backend.
"aqua:dalance/procs" = "latest"
{{ if $traits.devTooling -}}
"aqua:o2sh/onefetch" = "latest"
{{- end }}
"aqua:ouch-org/ouch" = "latest"
"aqua:imsnif/bandwhich" = "latest"
"aqua:fujiapple852/trippy" = "latest"
"github:printfn/fend" = "latest"
"github:NerdyPepper/eva" = "latest"
"github:Macchina-CLI/macchina" = "latest"
"github:sibprogrammer/xq" = "latest"
"github:tldr-pages/tlrc[exe=tldr]" = "latest"
# NOTE: t-rec (terminal recorder) was dropped — the upstream repo
# sassman/t-rec no longer exists (404), and screen recording is of
# little use on a headless SSH box.
{{- end }}
