{{- $p := index .theme.palettes .theme.active -}}
# Optimized bottom (btm) Configuration

[flags]
# Sets how often data is refreshed (1 second is the sweet spot for accuracy vs overhead)
rate = "1s"

# Shows the list scroll position tracker in the widget titles
show_table_scroll_position = true

# Hides unnecessary spacing inside tables to display more information at once
hide_table_gap = true

# Temperatures are displayed in Celsius (change to "f" if preferred)
temperature_type = "c"

# Better defaults for the process monitoring widget
[processes]
# Groups processes with the same name together by default (like htop)
default_grouped = true

# Shows the full command path instead of just the process name
process_command = true

# Uses regular expressions by default when searching with the '/' key
regex = true

# Sets CPU% metrics relative to the current usage rather than overall system capacity
current_usage = true

[network]
# Displays network speeds in bytes instead of bits (easier to read for file transfers)
network_use_bytes = true

# Catppuccin Mocha is NOT a bottom built-in (it only ships default/nord/gruvbox
# + -light), so there is no `theme=` to lean on — the theme is expressed entirely
# as [styles] projected from the single-source palette (.chezmoidata/theme.yaml).
# DO NOT edit hex here; change the palette there and re-apply. Anything not styled
# below keeps bottom's default (the bg stays the terminal background).
[styles.cpu]
all_entry_color = "#{{ $p.rosewater }}"
avg_entry_color = "#{{ $p.maroon }}"
cpu_core_colors = ["#{{ $p.red }}","#{{ $p.peach }}","#{{ $p.yellow }}","#{{ $p.green }}","#{{ $p.sapphire }}","#{{ $p.mauve }}"]
[styles.memory]
ram_color = "#{{ $p.green }}"
cache_color = "#{{ $p.red }}"
swap_color = "#{{ $p.peach }}"
gpu_colors = ["#{{ $p.sapphire }}","#{{ $p.mauve }}","#{{ $p.red }}","#{{ $p.peach }}","#{{ $p.yellow }}","#{{ $p.green }}"]
arc_color = "#{{ $p.sky }}"
[styles.network]
rx_color = "#{{ $p.green }}"
tx_color = "#{{ $p.red }}"
rx_total_color = "#{{ $p.sky }}"
tx_total_color = "#{{ $p.green }}"
[styles.battery]
high_battery_color = "#{{ $p.green }}"
medium_battery_color = "#{{ $p.yellow }}"
low_battery_color = "#{{ $p.red }}"
[styles.tables]
headers = {color = "#{{ $p.rosewater }}"}
[styles.graphs]
graph_color = "#{{ $p.subtext0 }}"
legend_text = {color = "#{{ $p.subtext0 }}"}
[styles.widgets]
border_color = "#{{ $p.surface2 }}"
selected_border_color = "#{{ $p.pink }}"
widget_title = {color = "#{{ $p.flamingo }}"}
text = {color = "#{{ $p.text }}"}
selected_text = {color = "#{{ $p.crust }}", bg_color = "#{{ $p.mauve }}"}
disabled_text = {color = "#{{ $p.base }}"}
