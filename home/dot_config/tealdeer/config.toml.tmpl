{{- $p := index .theme.palettes .theme.active -}}
{{- $desc := includeTemplate "hex2rgb.tmpl" $p.subtext0 | trim | splitList " " -}}
{{- $name := includeTemplate "hex2rgb.tmpl" $p.mauve | trim | splitList " " -}}
{{- $etext := includeTemplate "hex2rgb.tmpl" $p.text | trim | splitList " " -}}
{{- $ecode := includeTemplate "hex2rgb.tmpl" $p.blue | trim | splitList " " -}}
{{- $evar := includeTemplate "hex2rgb.tmpl" $p.peach | trim | splitList " " -}}
# tealdeer style — GENERATED from .chezmoidata/theme.yaml ({{ $p.meta.name }}) by
# chezmoi. DO NOT EDIT hex here; change the palette in theme.yaml and re-apply.

[style.description]
# subtext0
foreground = { rgb = { r = {{ index $desc 0 }}, g = {{ index $desc 1 }}, b = {{ index $desc 2 }} } }

[style.command_name]
# mauve
foreground = { rgb = { r = {{ index $name 0 }}, g = {{ index $name 1 }}, b = {{ index $name 2 }} } }
bold = true

[style.example_text]
# text
foreground = { rgb = { r = {{ index $etext 0 }}, g = {{ index $etext 1 }}, b = {{ index $etext 2 }} } }
italic = true

[style.example_code]
# blue
foreground = { rgb = { r = {{ index $ecode 0 }}, g = {{ index $ecode 1 }}, b = {{ index $ecode 2 }} } }

[style.example_variable]
# peach
foreground = { rgb = { r = {{ index $evar 0 }}, g = {{ index $evar 1 }}, b = {{ index $evar 2 }} } }
italic = true

[display]
show_title = true

[updates]
auto_update = true
auto_update_interval_hours = 168

[directories]
cache_dir = "{{ .chezmoi.homeDir }}/.cache/tealdeer"
custom_pages_dir = "{{ .chezmoi.homeDir }}/.local/share/tealdeer/pages"

# vim:ft=toml
