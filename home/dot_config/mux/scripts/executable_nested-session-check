#!/usr/bin/env zsh
# nested-session-check <client_pid>
#
# Exit 0 if the mux client process <client_pid> is attached to a nested
# workspace session, else exit non-zero. WezTerm's Lua (Cmd+Shift+S) calls
# this with the focused pane's foreground-process pid (the mux client) to
# decide whether to send Ctrl+Alt+Space — summoning the local workspace picker
# from inside a nested, locked-passthrough session — instead of MEH-s (which
# would otherwise pass straight through to the remote's own mux).
#
# The chord was Cmd+Shift+P until 2026-07-28: the split belongs to whichever
# key opens the WORKSPACE picker, and that is now Cmd+Shift+S. Reaching the
# REMOTE's picker deliberately is Cmd+Shift+Alt+S.
#
# The session is resolved LIVE through the shim (mux::resolve_session, which
# reads the backend from the client PROCESS — this runs in WezTerm's GUI
# environment, where $ZELLIJ/$TMUX say nothing), so it tracks a switch in
# place. Membership is checked against the registry quick-launch writes
# whenever it launches a nested workspace.
emulate -L zsh
set -u

source "${MUX_LIB:-$HOME/.local/lib}/mux.zsh"

name="$(mux::resolve_session "${1:?usage: nested-session-check <client_pid>}" 2>/dev/null)" || exit 1
reg="${XDG_CACHE_HOME:-$HOME/.cache}/quick-launch/nested-sessions"
grep -Fxq "$name" "$reg" 2>/dev/null
