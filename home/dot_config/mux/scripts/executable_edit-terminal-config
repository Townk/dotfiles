#!/usr/bin/env zsh

set -eu -o pipefail

# 1. Dynamic path lookups for cross-platform compatibility
NVIM=${commands[nvim]:-${commands[vim]:-vi}}

# The dependency-free mux layer: the canonical remote-detection pair lives
# here.
source "${MUX_LIB:-$HOME/.local/lib}/mux-bootstrap.zsh"
# $REX_SESSION, not mux::in_rex ($REX_BLOCK): everything below acts on the
# session, and the Rex key action that runs this can name one with no block.
_on_rex=0
[[ -z "${TMUX:-}" && -n "${REX_SESSION:-}" ]] && _on_rex=1

# Inside tmux TERM_PROGRAM lies (= "tmux"); the outer terminal's identity is
# kept in the tmux SESSION env by update-environment (see tmux.conf — the
# same trick image-protocol-support.zsh and yazi use).
if [[ -n "${TMUX:-}" ]]; then
  _outer=$(tmux show-environment TERM_PROGRAM 2>/dev/null) || _outer=""
  [[ -n "${_outer#TERM_PROGRAM=}" ]] && TERM_PROGRAM="${_outer#TERM_PROGRAM=}"
fi

# 2. Environment Detection Logic
#
# Read SSH state from the tmux SESSION env (mux::session_is_remote), the
# attach-time truth, NOT this process's env. As a tmux keybinding this runs in
# the server's BIRTH env, so the old process-triple test opened ~/.ssh/config
# for a locally-attached session whose server merely happened to be born over
# ssh (and vice versa). DECISION 4 (2026-08-01): accept that behavior change —
# a server-vs-client SSH mismatch now edits the config the CLIENT is really on.
# (Worth a Mode B eyeball. Outside tmux this reports local; the SSH branch
# there was already best-effort.)
# Rex first: it is the terminal itself, so there is no outer one to ask
# about, and mux::session_is_remote (a tmux session-env question) has nothing
# to say there. Same precedence as everywhere else — an inner tmux started
# inside a Rex pane is handled by the branches below.
if (( _on_rex )); then
  ENV_TYPE="REX"
elif mux::session_is_remote; then
  ENV_TYPE="SSH"
# Match TERM_PROGRAM case-INSENSITIVELY: Ghostty sets it to `ghostty` (lowercase)
# — the value the tmux session env carries and we recover above — so a literal
# `== "Ghostty"` fell through to UNKNOWN → exit 1. (${(L)…} lowercases; zsh.)
elif [[ "${(L)TERM_PROGRAM:-}" == "ghostty" ]]; then
  ENV_TYPE="GHOSTTY"
elif [[ "${(L)TERM_PROGRAM:-}" == "wezterm" || -n "${WEZTERM_UNIX_SOCKET:-}" ]]; then
  ENV_TYPE="WEZTERM"
else
  ENV_TYPE="UNKNOWN"
fi

# 3. Environment Configuration Logic (Sets Variables Only)
case "$ENV_TYPE" in
  "SSH")
    TAB_NAME="Remote SSH Config"
    TARGET_FILE="$HOME/.ssh/config"
    ;;

  "GHOSTTY")
    TAB_NAME="Ghostty Config"
    TARGET_FILE="$HOME/.config/ghostty/config"
    ;;

  "REX")
    TAB_NAME="Rex Config"
    TARGET_FILE="$HOME/.config/rex/init.lua"
    ;;
  "WEZTERM")
    TAB_NAME="Wezterm Config"
    TARGET_FILE="$HOME/.config/wezterm/wezterm.lua"
    ;;

  "UNKNOWN" | *)
    print "Error: Unsupported environment. Script must be run inside Ghostty, Wezterm, or an SSH session." >&2
    exit 1
    ;;
esac

# 4. Focus-or-create the config tab/window in whichever mux hosts us
# (mux migration Phase 1: dual-path; the shared logic collapses onto
# mux::* calls when the Panes group lands in Phase 6).
if [[ "$ENV_TYPE" == REX ]]; then
  # Focus the config tab if it is already open, else open it; either way the
  # app is told to show it. Windows are found by label, the same identity
  # quick-launch uses on Rex. The Rex verb itself, not mux::new_tab: this
  # branch is chosen by $REX_SESSION alone, and must not follow $MUX_BACKEND.
  _mux_rx_new_tab "$REX_SESSION" "$TAB_NAME" "" focus -- "$NVIM" "$TARGET_FILE"
elif [[ -n "${TMUX:-}" ]]; then
  TMUX_BIN=${commands[tmux]:-tmux}
  if "$TMUX_BIN" list-windows -F '#{window_name}' 2>/dev/null | grep -Fxq "$TAB_NAME"; then
    "$TMUX_BIN" select-window -t "=$TAB_NAME"
  else
    "$TMUX_BIN" new-window -n "$TAB_NAME" "$NVIM $TARGET_FILE"
  fi
else
  print "Error: not inside tmux or Rex — no tab to open the config in." >&2
  exit 1
fi
