#!/usr/bin/env zsh
# copy-pwd — copy the focused zellij pane's working directory to the macOS
#            clipboard, then show a Hammerspoon OSD (and play a short sound).
#
# Lives under ~/.config/mux/scripts/ — a mux-internal helper, not a shell
# command; both backends call it (zellij through the context-keys plugin,
# tmux through a run-shell bind). It is invoked *headlessly* by the zj-context-keys
# ("context-keys") plugin via its `run` action, wired to the `Alt+w Y`
# (and `Alt+w Ctrl+y`) leader chords in ~/.config/zellij/config.kdl.
# Because the plugin runs the command through Zellij's host `run_command`
# API, NO pane is spawned — so there's none of the visual flash a
# `Run {}` keybind block produces.
#
# Why a PID argument instead of querying zellij:
#   Commands launched by `run_command` do NOT reliably inherit the
#   ZELLIJ / ZELLIJ_SESSION_NAME environment, so `zellij action
#   list-panes` from here could fail or target the wrong session. The
#   plugin instead passes the focused pane's ROOT PROCESS PID (its
#   `{pid}` placeholder). We resolve that PID's current working directory
#   straight from the kernel (/proc on Linux, `lsof` on macOS), which needs no
#   zellij context.
#   For a normal shell pane the root process IS the shell, so its cwd is
#   exactly the pane's $PWD (and tracks every `cd`).
#
# Usage:  copy-pwd [--relative|--absolute] <pid>
#
#   --relative  (default) Copy a $HOME-relative path: when the cwd is under
#               $HOME it's collapsed to `~/…` (or bare `~` at $HOME itself).
#               Outside $HOME it's identical to --absolute.
#   --absolute  Copy the full, literal absolute path.
#
# Env overrides:
#   COPY_PWD_ICON    OSD icon spec (SVG name, glyph:<name>, or swatch:#RRGGBB).
#                    Default: glyph:nf-cod-copy. Used by both toasts of the
#                    over-bridge pair; a failure switches to glyph:nf-cod-error.
#   COPY_PWD_SOUND   Notification sound name (as shown in System Settings →
#                    Sound, e.g. Frog/Glass/Tink, or `default`). Default: Frog.
#                    Set empty to show the notification silently. Plays on the
#                    keypress; the completion toast is silent, a failure is Basso.

set -euo pipefail

# macOS has no /proc, so the cwd comes from lsof at its ABSOLUTE path (this runs
# headless, with no PATH). Linux resolves it from /proc instead — the Linux
# dev-shell keeps lsof in /usr/bin, so a hardcoded /usr/sbin was a silent 127.
LSOF="/usr/sbin/lsof"
# Route the copy through the pbcopy SHIM, which owns the tier logic (local
# pasteboard, and under SSH the bridge/OSC-52 mirror to the attached client) —
# so this no longer hand-rolls a `tmux load-buffer` OSC-52 copy. The shim is
# addressed by ABSOLUTE path because copy-pwd runs headlessly (zellij/tmux
# run_command) with no PATH; /usr/bin/pbcopy is the fallback when it's missing.
PBCOPY="$HOME/.local/bin/pbcopy"
[[ -x "$PBCOPY" ]] || PBCOPY="/usr/bin/pbcopy"

COPY_PWD_ICON="${COPY_PWD_ICON:-glyph:nf-cod-copy}"
COPY_PWD_SOUND="${COPY_PWD_SOUND-Frog}"

# Parse an optional path-mode flag in any position; the lone positional is
# the PID. Default mode is $HOME-relative.
mode="relative"
pid=""
for arg in "$@"; do
  case "$arg" in
    -r | --relative) mode="relative" ;;
    -a | --absolute) mode="absolute" ;;
    *) pid="$arg" ;;
  esac
done

[[ -n "$pid" && "$pid" =~ ^[0-9]+$ ]] || {
  echo "copy-pwd: expected a numeric PID argument, got '${pid}'" >&2
  exit 1
}

# On Linux the kernel hands the cwd over directly as a symlink (readable by the
# owning uid, and a pane's root process is always ours). Elsewhere, pull it from
# lsof's field output: `-Fn` emits one field per line, and the cwd's path is the
# `n`-prefixed line of the `cwd` fd row.
#
# Both forms end in `|| cwd=""` so a failure lands on the "could not resolve"
# message below instead of tripping errexit — a missing lsof exits 127 through
# pipefail, and with stderr silenced that reaches tmux as a bare exit code.
if [[ -L "/proc/$pid/cwd" ]]; then
  cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null) || cwd=""
else
  cwd=$(
    "$LSOF" -a -p "$pid" -d cwd -Fn 2>/dev/null |
      awk '/^n/ { print substr($0, 2); exit }'
  ) || cwd=""
fi

[[ -n "$cwd" ]] || {
  echo "copy-pwd: could not resolve cwd for pid $pid" >&2
  exit 1
}

# Resolve the path in the requested form. In --relative mode, collapse a
# $HOME prefix to `~` (exact $HOME → bare `~`); otherwise keep it absolute.
#
# NB: the variable is `out`, NOT `path`. Under zsh `path` is the array tied to
# `$PATH`, so `path="$cwd"` would clobber PATH for the rest of the script.
out="$cwd"
if [[ "$mode" == "relative" ]]; then
  if [[ "$cwd" == "$HOME" ]]; then
    out="~"
  elif [[ "$cwd" == "$HOME"/* ]]; then
    out="~${cwd#"$HOME"}"
  fi
fi

# Keep the OSD focused on the action; the clipboard already carries the path.
if [[ "$mode" == "absolute" ]]; then
  display="Absolute path copied to clipboard"
else
  display="Path copied to clipboard"
fi

# Feedback goes to the OSD when it lands somewhere the user can see, and to the
# tmux status line otherwise — never BOTH. Locally the pair painted the message
# over the status bar on top of a Hammerspoon OSD already saying the same thing.
#
# Which of the two applies is notify's call, not this script's: over ssh it now
# routes the OSD to the CLIENT's machine across the clipboard bridge, so "does
# a local hs exist" no longer decides anything. The one fact notify cannot
# learn by itself is whether the attached client is remote — the tmux server's
# own environment predates that client — so pass it in, pinned to THIS client's
# session (list-clients) via the shared mux::session_is_remote probe.
#
# Resolved BEFORE the copy: the same verdict decides whether the copy is slow
# enough to deserve a progress toast (below), and these tmux queries cost a few
# ms against the ~750ms of bridge round trips the copy itself pays.
have_notify=""
if source "$HOME/.local/lib/common.zsh" 2>/dev/null; then
  have_notify=1
  source "$HOME/.local/lib/mux-bootstrap.zsh" 2>/dev/null || true
fi
if [[ -n "$have_notify" && -n "${TMUX:-}" ]]; then
  sess="$(tmux list-clients -F '#{client_session}' 2>/dev/null | head -1)" || sess=""
  if [[ -n "$sess" ]] && mux::session_is_remote "$sess"; then
    export NOTIFY_VIA_BRIDGE=1
  fi
fi

# A copy that crosses the bridge costs ~750ms (frames to the far machine), so the
# completion toast on its own reads as a dead key. Announce FIRST and let the
# completion toast replace it: the OSD owns a single canvas and repaints it in
# place, cancelling the pending dismiss, so the second call updates the visible
# toast instead of stacking a second one. The SOUND rides on this first toast —
# it is the acknowledgement of the keypress, not of the result.
#
# Only over the bridge. Sitting at the machine the copy is ~10ms and the two
# toasts would land together as a flicker, so the local path stays single-shot.
phase1=""
if [[ -n "$have_notify" && -n "${NOTIFY_VIA_BRIDGE:-}" ]]; then
  notify --icon "$COPY_PWD_ICON" --sound "$COPY_PWD_SOUND" "Copying path…" >/dev/null 2>&1 &
  phase1=$!
fi

# Clipboard gets the chosen path with no trailing newline (so it doesn't
# auto-execute if pasted at a shell prompt). The shim owns the tier logic — over
# ssh it sets the attached client's clipboard through the bridge.
#
# The failure is CAUGHT rather than left to errexit: a copy that fails is exactly
# when the user needs telling, and dying here would take the toast down with it.
copy_ok=1
if ! copy_err=$(printf '%s' "$out" | "$PBCOPY" 2>&1); then
  copy_ok=0
fi

# The announcement must never land AFTER the result, which would leave "Copying
# path…" on screen as the last word. It has normally finished long before the
# copy has; this only bites when the OSD path itself is slow.
if [[ -n "$phase1" ]]; then
  wait "$phase1" 2>/dev/null || true
fi

if (( copy_ok )); then
  final_icon="$COPY_PWD_ICON"
  final_display="$display"
  # Silent only when the announcement already played the sound. On the local
  # single-toast path this IS the acknowledgement, so it keeps it.
  if [[ -n "$phase1" ]]; then
    final_sound=""
  else
    final_sound="$COPY_PWD_SOUND"
  fi
else
  final_icon="glyph:nf-cod-error"
  final_sound="Basso"
  final_display="Copy failed${copy_err:+: $copy_err}"
fi

# Backgrounded so any OSD hiccup never delays or fails the clipboard copy. The
# status-line fallback rides along inside the background job, driven by what
# notify actually did rather than by a guess made before trying.
if [[ -n "$have_notify" ]]; then
  {
    notify --icon "$final_icon" --sound "$final_sound" "$final_display" >/dev/null 2>&1 ||
      { [[ -n "${TMUX:-}" ]] && tmux display-message "$final_display" 2>/dev/null }
  } &
elif [[ -n "${TMUX:-}" ]]; then
  tmux display-message "$final_display" 2>/dev/null
fi

(( copy_ok )) || exit 1
exit 0
