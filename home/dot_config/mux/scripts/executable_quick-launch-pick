#!/usr/bin/env zsh
# quick-launch-pick — fzf picker for quick-launch targets, built on the
# shared pick-common.zsh facility (the same one pick-glyph / pick-gitmoji
# use). It inherits the catppuccin-mocha palette, border/input-border
# handling, the NBSP-terminated header, the standard prompt/pointer/marker
# glyphs — so the Quick Launch menu looks and behaves like the other pickers.
# Panes/tabs stay in their defined (file) order; workspaces opt into the
# library's `--cache-usage` recency so the most-recently-used session floats to
# the top for a quick "flip back".
#
#   quick-launch-pick <pane|tab|workspace> [--no-border]
#
# It prints the chosen target's `id` to stdout (one line); `quick-launch`
# captures that and performs the actual zellij action. On cancel it exits
# 130 with no output (pick-common's clean-cancel convention).
#
# Two INTERNAL modes serve the workspace picker's Ctrl+D (kill a session):
# `--kill <tail>` ends that row's session and `--emit` re-prints the rows. fzf
# runs both itself, in a fresh child shell, as an execute-silent + reload pair
# — so they are re-entries into this script rather than functions.
#
# Targets are read from $QUICK_LAUNCH_TARGETS (default
# ~/.config/mux/quick-launch/default.yaml; yaml/json/toml accepted). When
# launched via `quick-launch menu` this points at a pre-merged JSON cache
# (default.yaml + launch.d/*), so the picker shows the same merged set the
# dispatcher acts on.
# Floating-pane geometry comes from QUICK_LAUNCH_HEIGHT / _MARGIN /
# _PADDING / _INPUT_BORDER, and --no-border (or QUICK_LAUNCH_NO_BORDER=1)
# suppresses fzf's frame for embedders that draw their own.

set -eu -o pipefail

# Shared picker scaffolding + jq wire-format/colour module (off-PATH libs
# in ~/.local/lib; override with PICK_LIB_DIR / PICK_COMMON_LIB for tests).
PICK_NAME=quick-launch-pick
PICK_LIB_DIR="${PICK_LIB_DIR:-$HOME/.local/lib}"
PICK_JQ="$PICK_LIB_DIR/pick.jq"
source "${PICK_COMMON_LIB:-$PICK_LIB_DIR/pick-common.zsh}" ||
  {
    print -ru2 -- "quick-launch-pick: cannot source pick-common.zsh from $PICK_LIB_DIR"
    exit 1
  }

kind=""
emit=0
do_kill=0
kill_id=""
no_border="${QUICK_LAUNCH_NO_BORDER:+1}"
no_border="${no_border:-0}"
while (($# > 0)); do
  case "$1" in
    pane | tab | workspace)
      kind="$1"
      shift
      ;;
    --no-border)
      no_border=1
      shift
      ;;
    --emit)
      emit=1
      shift
      ;;
    --kill)
      do_kill=1
      kill_id="${2-}"
      shift 2
      ;;
    -h | --help)
      print -r -- "usage: quick-launch-pick <pane|tab|workspace> [--no-border]"
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *) die "unknown arg: $1 (want pane|tab|workspace)" ;;
  esac
done
[[ -n "$kind" ]] || die "missing kind (pane|tab|workspace)"

require_cmd yq
require_cmd jq

TARGETS="${QUICK_LAUNCH_TARGETS:-$HOME/.config/mux/quick-launch/default.yaml}"
[[ -r "$TARGETS" ]] || die "cannot read targets file: $TARGETS"

case "$kind" in
  pane) key="panes" ;;
  tab) key="tabs" ;;
  workspace) key="workspaces" ;;
esac

# The shim, sourced up front: every question this script asks about live
# sessions and tabs has to be asked of the backend the CALLING PANE is in.
# Until Phase 6 Mode B these were direct `zellij …` calls, which is the
# dangerous kind of off-backend call — zellij keeps answering under tmux, with
# its own (resurrectable, therefore stale) sessions, so the workspace list
# described a mux the user was not in and its "(other window)" tag could never
# clear.
source "${MUX_LIB:-$HOME/.local/lib}/mux.zsh" 2>/dev/null || true

# --kill (internal): Ctrl+D on a workspace row. fzf hands us the whole hidden
# tail — "<id>\x1e@window:<id>\x1e<session>" — and it is the THIRD field that
# dies: the id is the dispatch key, the session name is what the backend knows
# (see the field list in the assembler). The row is gone from the reload that
# follows either way: an ad-hoc session disappears with its session, and a
# configured workspace comes back without the "(detached)" / "(other window)"
# suffix, since both are derived from the live session list. The session WE are
# in is not offered as a row, but a race (or a hand-typed call) must not take
# the terminal down with it.
#
# The mode is a FLAG, not "did we get a name": with a search query that matches
# nothing fzf still fires the bind, with an empty {3}, and a name test alone
# would fall through and start a second, interactive picker in the background.
if ((do_kill)); then
  local -a kill_fields
  local victim
  kill_fields=("${(@ps:\x1e:)kill_id}")
  victim="${kill_fields[3]:-}"
  [[ -n "$victim" && "$victim" != "$(mux::current_session 2>/dev/null || true)" ]] || exit 0
  mux::kill_session "$victim" || true
  exit 0
fi

# Active scope (panes only). Wezterm's make_panes_choices offers the active
# tab's panes + the active workspace's panes + the global top-level panes — so
# a pane nested under a workspace is reachable only while that workspace is
# live. A workspace == a session on either backend (a zellij session, a tmux
# session), and a tab == a zellij tab or a tmux window. Outside any mux (e.g.
# standalone testing) both stay empty and only the global panes are offered.
active_ws="$(mux::current_session 2>/dev/null || true)"
active_tab="$(mux::current_tab_name 2>/dev/null || true)"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/quick-launch"
mkdir -p "$CACHE_DIR"
# Workspaces are filtered/ordered/annotated by LIVE session state — which
# sessions exist right now (a session is named after the workspace id) minus
# the one we're in — so their list can't use the static mtime cache; rebuild it
# every launch. Panes likewise depend on the live workspace/tab, so their cache
# key encodes the scope; otherwise switching workspaces would serve a stale list.
force_build=0
live_json='[]'
windowed_json='[]'
usage_file=""
current_ws="${active_ws}"
if [[ "$kind" == pane ]]; then
  # The sanitized tokens keep the filename human-readable, but sanitization is
  # LOSSY — two distinct scopes can collapse to the same token (workspace `a/b`
  # vs `a b` both → `a_b`). The cache CONTENTS use the RAW scope and
  # pick::cache_stale only compares mtimes, so a collision served the second
  # scope the first's pane list. Fold a hash of the RAW pair into the identity
  # so distinct scopes never share a file, while an identical scope still lands
  # on the same file (cache hit unchanged). shasum (perl, macOS) or sha256sum
  # (minimal Linux) — either gives a stable hex digest; the first 16 chars are
  # ample to separate scopes on one machine.
  scope_ws="${active_ws//[^A-Za-z0-9._-]/_}"
  scope_tab="${active_tab//[^A-Za-z0-9._-]/_}"
  if (( $+commands[shasum] )); then
    scope_hash="$(printf '%s\0%s' "$active_ws" "$active_tab" | shasum | cut -c1-16)"
  else
    scope_hash="$(printf '%s\0%s' "$active_ws" "$active_tab" | sha256sum | cut -c1-16)"
  fi
  LINES_CACHE="$CACHE_DIR/lines-$kind-${scope_ws}-${scope_tab}-${scope_hash}.txt"
elif [[ "$kind" == workspace ]]; then
  # Fixed path, but force_build=1 rebuilds it every launch (the assembler
  # writes atomically via a temp + mv), so it always reflects current live
  # session state without leaking per-launch temp files.
  LINES_CACHE="$CACHE_DIR/lines-$kind.txt"
  force_build=1
  usage_file="$CACHE_DIR/usage-workspace"
  live_json="$({ mux::list_sessions 2>/dev/null | sed '/^$/d' | jq -R . | jq -s -c .; } 2>/dev/null || true)"
  [[ -n "$live_json" ]] || live_json='[]'
  # Which live sessions currently have a client attached (i.e. own an OS window):
  # tagged "(other window)" instead of "(detached)", and selecting one raises
  # that window. The precise WezTerm window is resolved lazily at dispatch by
  # quick-launch-window, so the menu doesn't pay for it. Empty on Ghostty /
  # when nothing is attached → all live workspaces read as "(detached)".
  windowed_json="$({ mux::attached_sessions 2>/dev/null | sed '/^$/d' | jq -R . | jq -s -c .; } 2>/dev/null || true)"
  [[ -n "$windowed_json" ]] || windowed_json='[]'
else
  LINES_CACHE="$CACHE_DIR/lines-$kind.txt"
fi
SCRIPT_PATH="${(%):-%x}"

# Assemble the fzf lines cache when stale (the targets file, this script, or
# the shared pick.jq being newer). Each line is
#
#   <icon>  <label>\x1f<id>
#
# with the icon + label colour-wrapped via pick.jq's palette (so it matches
# the other pickers) and the bare `id` hidden behind \x1f as the only tail
# field. Selector-mode numbering/search-display swaps are added by
# pick-common when enabled below; the cache keeps the normal picker contract.
if ((force_build)) || pick::cache_stale "$LINES_CACHE" "$TARGETS" "$SCRIPT_PATH" "$PICK_JQ"; then
  local ql_json
  case "$TARGETS" in
    *.json) ql_json="$(yq -p=json -o=json -I=0 '.' "$TARGETS")" ;;
    *.toml) ql_json="$(yq -p=toml -o=json -I=0 '.' "$TARGETS")" ;;
    *) ql_json="$(yq -p=yaml -o=json -I=0 '.' "$TARGETS")" ;;
  esac

  local tmp
  tmp=$(mktemp "${LINES_CACHE}.XXXXXX") || die "could not create temp cache"
  trap 'rm -f "$tmp"' EXIT INT TERM

  # Nerd-font icons embedded as literal glyphs (jq's \u escapes are BMP-only,
  # and several of these live in the supplementary PUA), matching the icon
  # map in the Lua plugin's make_element_menu_item.
  print -r -- "$ql_json" | jq -r -L "$PICK_LIB_DIR" \
    --arg k "$key" --arg ws "$active_ws" --arg tab "$active_tab" \
    --arg cur "$current_ws" --argjson live "$live_json" --argjson windowed "$windowed_json" \
    --argjson palette "$(cat "$(theme::json_path)")" '
    include "pick";
    def icon($t):
      if   $t == "Shell"  then "\uf07c"
      elif $t == "Edit"   then "󱇧"
      elif $t == "Remote" then "󰢹"
      elif $t == "Run"    then "󱤶"
      else "󰙀" end;
    # Pane choices mirror the wezterm plugin: the active tab is panes +
    # the active workspace is panes + the global top-level panes, deduped
    # first-id-wins. A workspace==a zellij session, so a pane nested under a
    # workspace surfaces only while that workspace is the live one ($ws); a
    # pane nested under a tab surfaces only while that tab is active ($tab).
    # Tabs/workspaces themselves are listed at the top level only.
    def collect:
      if $k == "panes" then
        ( (.workspaces // []) | map(select(.id == $ws or .name == $ws)) | (.[0] // null) ) as $aws
        | ( ( (.tabs // []) | map(select(.name == $tab or .id == $tab)) | .[0] )
            // ( ($aws.tabs // []) | map(select(.name == $tab or .id == $tab)) | .[0] )
          ) as $atab
        | [ ($atab.panes // [])[], ($aws.panes // [])[], (.panes // [])[] ]
        | reduce .[] as $p ([]; if any(.[]; .id == $p.id) then . else . + [$p] end)
        | .[]
      else
        .[$k][]?
      end;
    # Match the tmux-status-right session treatment: kebab-case -> Title Case.
    # A configured action label remains authoritative; this transforms the
    # underlying session name used by ad-hoc/live workspace rows.
    def session_title:
      split("-")
      | map(if length == 0 then . else (.[0:1] | ascii_upcase) + .[1:] end)
      | join(" ");
    # One picker line for an element, with an optional trailing $suffix
    # (already colour-wrapped) appended to the visible label and an explicit
    # hidden-tail $fields array. Prefers the element icon field (trailing space
    # trimmed), else the per-action-type glyph — mirroring the Lua plugin, which
    # honours an explicit icon first. Field 1 is always the id (the --output and
    # recency key); workspaces add a field 2 for the Alt+Enter new-window path.
    def entry_line($suffix; $fields):
      (.action.type // "") as $t
      | ((.icon // "") | sub("\\s+$"; "")) as $cfg_icon
      | (if ($cfg_icon | length) > 0 then $cfg_icon else icon($t) end) as $ic
      | (if $k == "workspaces"
           then (.action.label // ((.name // .id) | session_title))
           else (.action.label // .name // .id)
         end) as $label
      | emit_line(
          ($ic | paint(c_glyph)) + "  " + ($label | paint(c_key)) + $suffix;
          $fields
        );
    # The Zellij session name is the workspace `name` (default `id`) — the same
    # join key dispatch and the .zshrc boot session use; `id` is only the
    # dedup/CLI key. A workspace is "live" when a session of that name exists
    # ($live is the running session names). Capture the workspace before piping
    # into $live so the fields resolve against it.
    def sname: .name // .id;
    def is_live: . as $w | ($live | index($w.name // $w.id)) != null;
    def in_window: . as $w | ($windowed | index($w.name // $w.id)) != null;
    # Workspace metadata is assembled as independent facts, then rendered as
    # one comma-separated parenthesized suffix. Synthesized live sessions are
    # ad-hoc; every live session also says whether it is detached or attached
    # in another terminal window.
    def info_suffix:
      [ if (.ad_hoc // false) then "ad-hoc" else empty end,
        if ((.ad_hoc // false) or is_live)
          then (if in_window then "other window" else "detached" end)
          else empty
        end
      ]
      | if length > 0
        then "  " + (("(" + join(", ") + ")") | paint(c_code))
        else ""
        end;
    if $k == "workspaces" then
      # Drop the session we are in (matched on session name, the key dispatch
      # uses to create/switch sessions), then list the live workspaces first —
      # each tagged "(other window)" when it owns a separate OS window, else
      # "(detached)" — followed by the not-yet-created ones, both in file order.
      # The --cache-usage recency in pick-common then floats the most-recently-
      # picked rows above this baseline (and since a picked workspace becomes
      # live, recents stay within the live group). Ad-hoc live sessions sit
      # between the two groups: they ARE live, so they belong with the live
      # ones, but after the workspaces you actually configured.
      #
      # AD-HOC sessions: a live session with no entry in the targets file was
      # unreachable from here — you could see it in `list-sessions` but not
      # switch to it. They are synthesised as minimal workspaces {id, name} =
      # the session name, and carry NO icon field on purpose, so they fall
      # through to the same default a defined workspace without one gets.
      # `ad_hoc` is presentation metadata only; id/name remain the raw session
      # name used for dispatch.
      # Dispatch resolves an id it cannot find in the file the same way (the
      # live-session fallback in ql_get_element).
      ( [ .workspaces[]? | select(sname != $cur) ] ) as $wss
      | ( $wss | map(sname) ) as $defined
      | ( [ $live[] | select(. != $cur) | select(IN($defined[]) | not)
            | { id: ., name: ., ad_hoc: true } ] ) as $adhoc
      | ( ( $wss | map(select(is_live)) )
          + $adhoc
          + ( $wss | map(select(is_live | not)) ) )
      | .[]
      # Field 2 (@window:<id>) is what Alt+Enter (--key-output) emits so the
      # caller can route the pick to the separate-window path. Field 3 is the
      # SESSION name, which Ctrl+D kills — not the same string as the id: a
      # configured workspace is keyed by `id` (`default`) and its session is
      # named after `name` (`Main`), so a kill aimed at field 1 asked tmux for
      # a session that never existed. Ad-hoc rows carry the name in both.
      | entry_line(
          info_suffix;
          [ .id, "@window:" + .id, sname ]
        )
    else
      collect | entry_line(""; [ .id ])
    end
  ' >"$tmp" || die "failed to assemble $kind list (jq error)"
  mv "$tmp" "$LINES_CACHE"
  trap - EXIT INT TERM
fi

[[ -s "$LINES_CACHE" ]] || die "no $kind targets defined in $TARGETS"

# --emit (internal): the row stream fzf reloads after a Ctrl+D kill. It must
# match what pick::feed produces for the initial run — recency-ordered AND
# selector-decorated — or the reloaded rows would lose their 1-9 shortcut
# column and shift the hidden tail out from under pick-common's accept-time
# field parsing (which skips two display fields in selector-shortcut mode).
if ((emit)); then
  pick_input=(cat)
  pick_selector_wrap=1
  pick_usage_file="$usage_file"
  pick::feed "$LINES_CACHE"
  exit 0
fi

# Panes/tabs stay in their defined (file) order — no recency/resume flags, since
# launching a target isn't a text-insert flow. Workspaces opt into the library's
# file recency (--cache-usage): pick::record floats the most-recently-picked
# session to the top on the next launch, so the previous session is row 1 /
# pre-selected for a quick flip. The usage file is workspace-scoped so pane/tab
# picks never perturb the session order.

pick_start_args=(
  --height "${QUICK_LAUNCH_HEIGHT:-45%}"
  --margin "${QUICK_LAUNCH_MARGIN:-0,0,0,0}"
  --padding "${QUICK_LAUNCH_PADDING:-0,0,0,0}"
  --input-border "${QUICK_LAUNCH_INPUT_BORDER:-1}"
  --selector
  --selector-shortcuts
  --selector-nav
  --output field:1
  # Never auto-fire on a one-row list: every row here LAUNCHES something (a
  # session, a tab, an ssh workspace). Where the list collapses to one entry
  # — the work laptop renders a single workspace, the rest are gated on
  # personal project dirs — fzf's --select-1 connected to it instantly,
  # without ever drawing the picker.
  --no-auto-single
)
# Workspaces: opt into file recency, and add the Alt+Enter "open in a separate
# window" accept action. Enter emits field 1 (the id); Alt+Enter emits field 2
# (@window:<id>), which `quick-launch` routes to the new-window dispatch. Both
# hint lines mirror pick-common's defaults (selector adds 1-9/j-k because the
# picker enables --selector-shortcuts/--selector-nav; search adds clear/back)
# with the new-window action spliced in next to plain open (󰘵 = Alt/Option,
# 󰌑 = Enter). Alt+Enter works in either mode, so advertise it in both. Keep in
# sync with pick-common's *_hints_default if they change.
if [[ "$kind" == workspace ]]; then
  # Hints are assembled from structured key/label pairs via pick::hints, so the
  # separator/spacing matches every other dialog (no hand-rolled separators).
  # 󰘵 󰌑 = Alt+Enter (open in a separate window); 󰌑 = Enter, 󱊷 = Esc,
  # 󰘴 D = Ctrl+D (kill the session under the cursor, list stays open).
  #
  # Ctrl+D is an execute-silent + reload pair (pick-common's --key-reload), so
  # both halves re-enter THIS script from fzf's child shell: {3} is the hidden
  # tail (field 1 and 2 are the selector/search display columns), and the
  # reload re-derives every row from the now-shorter live session list.
  pick_start_args+=(
    --cache-usage="$usage_file"
    --key-output "alt-enter:field:2"
    --reload-cmd "${(qq)SCRIPT_PATH:a} workspace --emit"
    --key-reload "ctrl-d:${(qq)SCRIPT_PATH:a} workspace --kill {3}"
    --selector-hints "$(pick::hints 󰌑 open "󰘵 󰌑" "new window" "󰘴 D" kill 󱊷 cancel 1-9 open j/k move / search)"
    --search-hints "$(pick::hints 󰌑 open "󰘵 󰌑" "new window" "󰘴 D" kill 󱊷 cancel "󰘴 U" clear/back)"
  )
fi
((no_border)) && pick_start_args+=(--no-border)

pick::start "${pick_start_args[@]}" "$LINES_CACHE"
