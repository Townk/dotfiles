#!/usr/bin/env zsh
# mux-whichkey — the which-key PANEL (mux migration Phase 5): a port of
# zj-hud's src/whichkey, vertical and passive-looking, floating over the
# panes in a popup.
#
#   mux-whichkey open [client]          the DRIVER: own the popup while the
#                                       mode stack has a shown entry on top
#   mux-whichkey panel <table> <client> the panel itself (inside the popup)
#   mux-whichkey render <mode> [page] [rows]   paint once (tests/debug)
#   mux-whichkey toggle        hide/show the top entry (M-.)
#
# tmux popups swallow every keystroke (measured: key tables do not fire
# while one is open), so the panel IS the mode's dispatcher while it is
# open: it reads a key, looks it up in the very same keymap.yaml data that
# generates keymap.conf, and runs that binding's command. What it does NOT
# do is decide where that key leads — it performs one operation on the mode
# stack (lib/mux/stack.zsh) and exits, and the driver loop above reopens
# whatever the new top of the stack asks for. Keys that open one of our
# dialogs fire on a short server-side delay (a popup opened over a popup
# silently mutates the outer one). Hiding the panel with M-. hands the same
# bindings back to tmux's key tables, which go through the same stack.
#
# Chrome mirrors zj-hud exactly: rounded frame, mode breadcrumb as the
# top-border label, one binding per row (right-aligned chord glyphs, dim
# ➜, per-binding icon color, pink labels / blue for mode switches), a
# heavy rule, then the footer hints.

emulate -L zsh
setopt no_unset

TMUX_BIN="${MUX_TMUX_BIN:-tmux}"

# A trailing client tty (bindings pass '#{client_tty}') names the client that
# pressed the key — everything client-scoped downstream reads $MUX_CLIENT, so
# a second attached terminal cannot steal the panel. `open`/`panel` take the
# client as a positional already; this covers `toggle` and friends.
if [[ "${@[-1]:-}" == /dev/* && "${1:-}" != open && "${1:-}" != panel ]]; then
  export MUX_CLIENT="${@[-1]}"
  set -- "${@[1,-2]}"
fi
DATA="${WK_DATA:-$HOME/.config/mux/whichkey.data}"
WK_DATA="$DATA"
# THE shared mode resolver — the status bar uses the very same one, so the
# pill and the panel can never disagree about which mode is current.
source "${MUX_LIB_DIR:-$HOME/.local/lib}/mux/mode.zsh"
# Transitions belong to THE STACK, never to this renderer: the panel turns a
# keypress into ONE stack operation and exits; the stack decides the key
# table and the driver below decides whether a panel comes back.
source "${MUX_LIB_DIR:-$HOME/.local/lib}/mux/stack.zsh"
PAD=""
[[ -r "$DATA" ]] || exit 0

# Restore the status stack to "bar only". `set -gu` on an array INDEX
# DELETES the entry instead of restoring tmux's built-in default, so the
# real status-format[0] is read once from a pristine throwaway server and
# cached. Defensive: servers from the status-line era can still carry panel
# rows in status-format.
_default_bar() {
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}/mux/tmux-status-format0"
  if [[ ! -s "$cache" ]]; then
    mkdir -p "${cache:h}" 2>/dev/null
    "$TMUX_BIN" -L mux-wk-default -f /dev/null new-session -d -s p -x 40 -y 8 2>/dev/null
    "$TMUX_BIN" -L mux-wk-default show -gv 'status-format[0]' >| "$cache" 2>/dev/null
    "$TMUX_BIN" -L mux-wk-default kill-server 2>/dev/null
  fi
  [[ -s "$cache" ]] && cat "$cache"
}

typeset -A CFG
line="$(grep -m1 '^#cfg' "$DATA")" || exit 0
for kv in ${(ps:\t:)line}; do
  [[ "$kv" == '#cfg' ]] && continue
  CFG[${kv%%=*}]="${kv#*=}"
done
typeset -a MARGIN PADDING
MARGIN=(${(s:,:)CFG[margin]})      # top right bottom left
PADDING=(${(s:,:)CFG[padding]})
SEP="${CFG[sep]}"
RESET=$'\e[0m'
# -> REPLY, memoised: a frame paints ~20 rows and the icon colours repeat.
typeset -A FG_MEMO
_fg() {
  REPLY="${FG_MEMO[$1]:-}"
  [[ -n "$REPLY" ]] && return 0
  REPLY=$'\e[38;2;'"$(( 16#${1[2,3]} ));$(( 16#${1[4,5]} ));$(( 16#${1[6,7]} ))m"
  FG_MEMO[$1]="$REPLY"
}
_bg() { REPLY=$'\e[48;2;'"$(( 16#${1[2,3]} ));$(( 16#${1[4,5]} ));$(( 16#${1[6,7]} ))m" }
_bg ${CFG[bg]};      BG="$REPLY"
_fg ${CFG[border]};  C_BORDER="$REPLY"
_fg ${CFG[key]};     C_KEY="$REPLY"
_fg ${CFG[label]};   C_LABEL="$REPLY"
_fg ${CFG[switch]};  C_SWITCH="$REPLY"
_fg ${CFG[sticky]};  C_STICKY="$REPLY"
_fg ${CFG[footer]};  C_FOOTER="$REPLY"
_fg ${CFG[dim]};     C_DIM="$REPLY"
SOFT="${RESET}${BG}"

# Visibility is NOT kept here: it is a field of the stack entry (see
# lib/mux/stack.zsh). It used to be a per-mode global flag, which is why
# hiding the panel in Scroll left Command hidden the next time you armed the
# leader (Mode B find) — a hidden panel is a property of the entry you are
# standing on, and it dies with it.

# ---- key glyphs (zj-hud's rendering) --------------------------------------
G_SHIFT=$'\U000F0636' G_ALT=$'\U000F0635' G_CTRL=$'\U000F0634' G_SUPER=$'\U000F0633'
# zj-hud's bare_key_glyph table — special keys read as SYMBOLS, never words.
G_ENTER=$'\U000F0311' G_ESC=$'\U000F12B7' G_TAB=$'\U000F0312'
G_BTAB=$'\U000F0325'  G_BS=$'\U000F006E'  G_DEL=$'\U000F0E7E'
G_SPACE=$'\U000F1050'
# NB: the hot helpers below answer in REPLY instead of printing. A `$(…)`
# command substitution FORKS, and these run per key, per entry and per row —
# ~150 forks for one frame, which was the panel's whole latency budget.
_keyglyph() {          # tmux key name -> REPLY (display glyphs)
  local k="$1" mods="" base
  while true; do
    case "$k" in
      S-*) mods+="$G_SHIFT "; k="${k#S-}" ;;
      M-*) mods+="$G_ALT ";   k="${k#M-}" ;;
      C-*) mods+="$G_CTRL ";  k="${k#C-}" ;;
      D-*) mods+="$G_SUPER "; k="${k#D-}" ;;
      *) break ;;
    esac
  done
  case "$k" in
    Up) base="↑" ;;      Down) base="↓" ;;
    Left) base="←" ;;    Right) base="→" ;;
    Home) base="↖" ;;    End) base="↘" ;;
    PageUp|PgUp) base="⇞" ;;
    PageDown|PgDn) base="⇟" ;;
    Tab) base="$G_TAB" ;;
    BTab) mods=""; base="$G_BTAB" ;;   # shift+tab has its own combined glyph
    Enter) base="$G_ENTER" ;;
    Escape) base="$G_ESC" ;;
    BSpace) base="$G_BS" ;;
    DC|Delete) base="$G_DEL" ;;
    Space) base="$G_SPACE" ;;
    F<->) base="$k" ;;
    [a-z]) base="${(U)k}" ;;
    [A-Z]) base="$G_SHIFT ${k}" ;;      # an uppercase bind IS shift
    *) base="$k" ;;
  esac
  REPLY="${mods}${base}"
}
_keysdisplay() {       # pipe-separated tmux keys -> REPLY ("↑,K": comma is a KEY)
  local out="" k
  for k in ${(s:|:)1}; do
    [[ -n "$out" ]] && out+=","
    _keyglyph "$k"; out+="$REPLY"
  done
  REPLY="$out"
}

# ---- data -----------------------------------------------------------------
typeset -a E_KEYS E_DISP E_ICON E_ICOL E_DESC E_FLAGS E_CMD E_TO
_mode_meta() {         # STATE -> M_TITLE M_ICON M_COLOR M_PARENT (+ M_TABLE)
  if mux_mode::meta "$1" 2>/dev/null; then
    M_TITLE="$MM_TITLE" M_ICON="$MM_ICON" M_COLOR="$MM_COLOR"
    M_PARENT="$MM_PARENT" M_TABLE="${MM_TABLE:-$1}"
    return 0
  fi
  # fall back to the panel-table rows (a table with no state of its own)
  local l; l="$(awk -F'\t' -v m="$1" '$1=="#mode" && $2==m {print; exit}' "$DATA")"
  local -a f; f=("${(@ps:\t:)l}")
  M_TITLE="${f[3]}" M_ICON="${f[4]}" M_COLOR="${f[5]}" M_PARENT="${f[6]:-}" M_TABLE="$1"
}
_load() {
  # NB: fields are split with ${(@ps:\t:)} rather than `IFS=$'\t' read`:
  # tab is an IFS *whitespace* character, so read COLLAPSES consecutive
  # tabs — an entry with no flags lost that field and its command shifted
  # into it, which is why a plain action (M-w v) closed the panel without
  # doing anything (Mode B find).
  local state="$1" mode line
  local -a F
  _mode_meta "$state"
  mode="${M_TABLE:-$state}"
  E_KEYS=() E_DISP=() E_ICON=() E_ICOL=() E_DESC=() E_FLAGS=() E_CMD=() E_TO=()
  while IFS= read -r line; do
    [[ "$line" == E$'\t'* ]] || continue
    F=("${(@ps:\t:)line}")
    [[ "${F[2]}" == "$mode" ]] || continue
    E_KEYS+=("${F[3]}"); _keysdisplay "${F[3]}"; E_DISP+=("$REPLY")
    E_ICON+=("${F[4]}"); E_ICOL+=("${F[5]}"); E_DESC+=("${F[6]}")
    E_FLAGS+=(",${F[7]}"); E_CMD+=("${F[8]}"); E_TO+=("${F[9]:-}")
  done < "$DATA"
  (( ${#E_KEYS} )) || return 1
  _order "$mode"
  return 0
}

_has() { [[ "$1" == *",$2,"* ]] }

_order() {
  # NB: every local is declared ONCE here — re-running `local x=…` for a
  # name that already exists in the scope makes zsh PRINT it (typeset
  # behaviour), which would land in the panel's own output.
  local mode="$1" line ekeys u sk m k entry
  local -i i j gi pos placed found
  local -a F G_MEMBERS members ordered_units NK ND NI NC NE NF NM NT
  local -A unit_of unit_pos unit_anchor

  G_MEMBERS=()
  while IFS= read -r line; do
    [[ "$line" == '#group'$'\t'* ]] || continue
    F=("${(@ps:\t:)line}")
    [[ "${F[2]}" == "$mode" ]] || continue
    G_MEMBERS+=("${F[3]}")
  done < "$DATA"

  for (( i = 1; i <= ${#E_KEYS}; i++ )); do
    ekeys="${E_KEYS[i]}"; placed=0
    for (( gi = 1; gi <= ${#G_MEMBERS}; gi++ )); do
      pos=0
      for m in ${(s:|:)G_MEMBERS[gi]}; do
        (( pos++ )); found=0
        for k in ${(s:|:)ekeys}; do
          [[ "$k" == "$m" ]] && { found=1; break }
        done
        (( found )) || continue
        unit_of[$i]="g$gi"; unit_pos[$i]=$pos; placed=1
        break
      done
      (( placed )) && break
    done
    (( placed )) || { unit_of[$i]="e$i"; unit_pos[$i]=0 }
    u="${unit_of[$i]}"
    _entry_sortkey "$ekeys" "${E_FLAGS[i]}"; sk="$REPLY"
    if [[ -z "${unit_anchor[$u]:-}" ]]; then
      unit_anchor[$u]="$sk"; ordered_units+=("$u")
    elif (( unit_pos[$i] == 1 )); then
      unit_anchor[$u]="$sk"      # a group anchors on its FIRST member
    fi
  done

  # LC_ALL=C: a UTF-8 locale collates punctuation together with digits and
  # letters, which sorted '[' ahead of '1' and put the bracket group above
  # the tab numbers.
  ordered_units=(${(f)"$(for u in $ordered_units; do print -r -- "${unit_anchor[$u]}	$u"; done | LC_ALL=C sort | cut -f2)"})

  for u in $ordered_units; do
    members=()
    for (( i = 1; i <= ${#E_KEYS}; i++ )); do
      [[ "${unit_of[$i]}" == "$u" ]] && members+=("${unit_pos[$i]}:$i")
    done
    for entry in ${(n)members}; do
      j="${entry#*:}"
      NK+=("${E_KEYS[j]}"); ND+=("${E_DISP[j]}"); NI+=("${E_ICON[j]}")
      NC+=("${E_ICOL[j]}"); NE+=("${E_DESC[j]}"); NF+=("${E_FLAGS[j]}"); NM+=("${E_CMD[j]}")
      NT+=("${E_TO[j]}")
    done
  done
  E_KEYS=("$NK[@]"); E_DISP=("$ND[@]"); E_ICON=("$NI[@]")
  E_ICOL=("$NC[@]"); E_DESC=("$NE[@]"); E_FLAGS=("$NF[@]"); E_CMD=("$NM[@]")
  E_TO=("$NT[@]")
}

# ---- panel sort (zj-hud labels.rs) ----------------------------------------
# Units sort by: bindings that ENTER another mode first, then unmodified
# chords alphabetically, then modified ones by (modifier count, modifier
# rank shift<super<alt<ctrl, key). An uppercase letter normalizes to
# shift+lowercase, so `Y` sorts with the modified chords, not the bare ones.
# Named keys (arrows, nav block, tab/space/enter/backspace/delete/esc) come
# before character keys, in that curated reading order.
typeset -a CURATED
CURATED=(up down left right home end pageup pagedown tab space enter backspace delete esc)
_sortkey() {           # tmux key name -> REPLY (a sortable string)
  local k="$1" mods="" rank bare cls kr
  local -a mr
  while true; do
    case "$k" in
      S-*) mr+=(0); k="${k#S-}" ;;
      M-*) mr+=(2); k="${k#M-}" ;;
      C-*) mr+=(3); k="${k#C-}" ;;
      *) break ;;
    esac
  done
  case "$k" in
    [A-Z]) mr+=(0); k="${(L)k}" ;;         # uppercase implies shift
  esac
  bare="${(L)k}"
  case "$bare" in
    btab) bare=tab ;;
    escape) bare=esc ;;
    bspace) bare=backspace ;;
  esac
  kr=${CURATED[(i)$bare]}
  if (( kr <= ${#CURATED} )); then
    cls=0; kr=$(( kr ))
  elif [[ ${#bare} == 1 ]]; then
    cls=1; kr=0
  else
    cls=0; kr=500
  fi
  mr=(${(on)mr})
  # printf -v, not $(printf …): the substitution would fork per key
  printf -v REPLY '%d:%02d:%s:%d:%03d:%s' \
    $(( ${#mr} > 0 )) ${#mr} "${(j::)mr}" $cls $kr "$bare"
}
_entry_sortkey() {     # -> REPLY: smallest key of a (possibly merged) entry,
  local keys="$1" flags="$2" best="" k sk   # plus the mode-switch bias
  for k in ${(s:|:)keys}; do
    _sortkey "$k"; sk="$REPLY"
    [[ -z "$best" || "$sk" < "$best" ]] && best="$sk"
  done
  local bias=1
  _has "$flags" switch && bias=0
  REPLY="${bias}|${best}"
}

# ---- geometry -------------------------------------------------------------
_measure() {           # -> W_KEYS W_ICON W_LABEL BODY_W ROWS_ALL
  local i
  W_KEYS=0 W_ICON=0 W_LABEL=0
  for (( i = 1; i <= ${#E_DISP}; i++ )); do
    (( ${#E_DISP[i]} > W_KEYS )) && W_KEYS=${#E_DISP[i]}
    (( ${#E_ICON[i]} > W_ICON )) && W_ICON=${#E_ICON[i]}
    (( ${#E_DESC[i]} > W_LABEL )) && W_LABEL=${#E_DESC[i]}
  done
  BODY_W=$(( W_KEYS + 1 + ${#SEP} + 1 + (W_ICON ? W_ICON + 1 : 0) + W_LABEL ))
  ROWS_ALL=${#E_DISP}
}

_footer_text() {       # -> FOOT FOOT_W (colored) for page/pages
  local page="$1" pages="$2" back="$3"
  local -a segs; local w=0
  segs+=("${C_KEY}${G_ESC}${SOFT}${C_FOOTER} close${SOFT}"); (( w += ${#G_ESC} + 6 ))
  if (( back )); then
    segs+=("${C_KEY}${G_BS}${SOFT}${C_FOOTER} back${SOFT}"); (( w += ${#G_BS} + 5 + 2 ))
  fi
  local tg; _keyglyph "${CFG[toggle]}"; tg="$REPLY"
  segs+=("${C_KEY}${tg}${SOFT}${C_FOOTER} hide${SOFT}"); (( w += ${#tg} + 5 + 2 ))
  if (( pages > 1 )); then
    local pg pgp
    _keyglyph "${CFG[prev]}"; pgp="$REPLY"
    _keyglyph "${CFG[next]}"; pg="${pgp}/${REPLY}"
    segs+=("${C_KEY}${pg}${SOFT}${C_FOOTER} scroll${SOFT}"); (( w += ${#pg} + 7 + 2 ))
  fi
  FOOT="${(pj:  :)segs}"; FOOT_W=$w
}

# ---- paint ----------------------------------------------------------------
_paint() {
  local mode="$1" page="$2"
  _mode_meta "$mode"
  _measure
  local -i per_page=$(( ROWS_MAX ))
  local -i pages=$(( (ROWS_ALL + per_page - 1) / per_page ))
  (( pages < 1 )) && pages=1
  (( page >= pages )) && page=$(( pages - 1 ))
  PAGE=$page PAGES=$pages

  # breadcrumb: every mode glyph up the parent chain, dim » between
  local bread="" m="$mode"
  local -i bw=0
  local -a chain; chain=()
  while [[ -n "$m" ]]; do
    _mode_meta "$m"
    _fg $M_COLOR
    chain=("${REPLY}${M_ICON}" "$chain[@]")
    (( bw += ${#M_ICON} ))
    m="$M_PARENT"
  done
  (( ${#chain} > 1 )) && (( bw += (${#chain} - 1) * 3 ))
  # NB: join by hand — a `j:...:` flag argument is literal, so a parameter
  # inside it would render as the text "${C_DIM}".
  local ci
  for (( ci = 1; ci <= ${#chain}; ci++ )); do
    (( ci > 1 )) && bread+="${C_DIM} » ${SOFT}"
    bread+="${chain[ci]}"
  done
  _mode_meta "$mode"

  local back=0; [[ -n "$M_PARENT" ]] && back=1
  _footer_text $page $pages $back
  local -i content_w=$BODY_W
  (( FOOT_W > content_w )) && content_w=$FOOT_W
  local -i inner=$(( content_w + PADDING[2] + PADDING[4] ))
  local -i box_w=$(( inner + 2 ))
  local -i start=$(( page * per_page + 1 ))
  local -i last=$(( start + per_page - 1 ))
  (( last > ROWS_ALL )) && last=$ROWS_ALL
  local -i body_n=$(( last - start + 1 ))
  local -i box_h=$(( body_n + 4 + PADDING[1] + PADDING[3] ))

  local out="" i r=1
  local blank="${(l:$box_w:: :)PAD}"
  for (( i = 1; i <= box_h; i++ )); do
    out+=$'\e['"${i};1H${BG}${blank}"
  done
  # top border with breadcrumb
  local -i dashes=$(( box_w - 3 - bw - 1 ))
  (( dashes < 0 )) && dashes=0
  out+=$'\e[1;1H'"${BG}${C_BORDER}╭ ${SOFT}${bread}${SOFT}${C_BORDER} ${(l:$dashes::─:)PAD}╮${SOFT}"
  # body
  local pl="${(l:${PADDING[4]}:: :)PAD}" pr="${(l:${PADDING[2]}:: :)PAD}"
  r=$(( 2 + PADDING[1] ))
  for (( i = start; i <= last; i++ )); do
    local disp="${E_DISP[i]}" icon="${E_ICON[i]}" desc="${E_DESC[i]}"
    local kp=$(( W_KEYS - ${#disp} )) lcol="$C_LABEL"
    # the label colour IS the disposition: pink ends the mode, blue enters
    # another, green stays in this one (zj-hud parity + the sticky rows)
    _has "${E_FLAGS[i]}" sticky && lcol="$C_STICKY"
    _has "${E_FLAGS[i]}" switch && lcol="$C_SWITCH"
    local cell="${(l:$kp:: :)PAD}${C_KEY}${disp}${SOFT}${C_DIM} ${SEP} ${SOFT}"
    if (( W_ICON > 0 )); then
      if [[ -n "$icon" ]]; then
        _fg ${E_ICOL[i]}
        cell+="${REPLY}${icon}${SOFT}${(l:$(( W_ICON - ${#icon} )):: :)PAD} "
      else
        cell+="${(l:$(( W_ICON + 1 )):: :)PAD}"
      fi
    fi
    cell+="${lcol}${desc}${SOFT}"
    local -i used=$(( W_KEYS + 1 + ${#SEP} + 1 + (W_ICON ? W_ICON + 1 : 0) + ${#desc} ))
    out+=$'\e['"${r};1H${BG}${C_BORDER}│${SOFT}${pl}${cell}${(l:$(( content_w - used )):: :)PAD}${pr}${C_BORDER}│${SOFT}"
    (( r++ ))
  done
  # heavy rule + footer, then the bottom border
  out+=$'\e['"${r};1H${BG}${C_BORDER}│${SOFT}${pl}${C_FOOTER}${(l:$content_w::━:)PAD}${SOFT}${pr}${C_BORDER}│${SOFT}"
  (( r++ ))
  local counter="" cw=0
  if (( PAGES > 1 )); then
    counter="${C_FOOTER}$(( PAGE + 1 ))/${PAGES}${SOFT}"
    cw=$(( ${#PAGES} + ${#PAGES} + 1 ))
  fi
  local -i fgap=$(( content_w - FOOT_W - cw ))
  (( fgap < 0 )) && fgap=0
  out+=$'\e['"${r};1H${BG}${C_BORDER}│${SOFT}${pl}${FOOT}${(l:$fgap:: :)PAD}${counter}${pr}${C_BORDER}│${SOFT}"
  (( r++ ))
  out+=$'\e['"${r};1H${BG}${C_BORDER}╰${(l:$(( box_w - 2 ))::─:)PAD}╯${RESET}"
  BOX_W=$box_w BOX_H=$box_h
  # REPLY, not stdout: `$(_paint …)` forked a whole frame AND lost PAGE /
  # PAGES / BOX_* with the subshell — the panel's paging branch was reading
  # an unset PAGES and could never fire.
  REPLY="$out"
}

# ---- command execution ----------------------------------------------------
# The panel runs its commands with `source-file`, which tmux evaluates with NO
# current pane — we are inside a popup, and a popup is not a pane. Any format
# meaning "where I came from" therefore expands EMPTY, and a bind like
# `new-window -c "#{pane_current_path}"` silently fell back to the session's
# start directory (measured: pressing the chord with the panel up landed in
# the session dir, firing the same bind from the key table landed in the
# pane's cwd). `display -p` from a popup DOES resolve to the client's active
# pane — the same trick _forward already uses for the pane id — so resolve it
# here and substitute. Deliberately ONE format, not a blanket expansion: the
# other commands carry #-sequences (`#W`, `%%`) that tmux must see intact.
_expand_origin() {
  local cmd="$1" path
  [[ "$cmd" == *'#{pane_current_path}'* ]] || { print -r -- "$cmd"; return }
  path="$("$TMUX_BIN" display -p '#{pane_current_path}' 2>/dev/null)"
  [[ -n "$path" ]] || { print -r -- "$cmd"; return }
  print -r -- "${cmd//\#\{pane_current_path\}/$path}"
}

_run() {               # run a tmux command line (source-file handles quoting)
  local cmd f
  cmd="$(_expand_origin "$1")"
  [[ -n "$cmd" ]] || return 0
  f="$(mktemp "${TMPDIR:-/tmp}/wkcmd.XXXXXX")"
  print -r -- "$cmd" > "$f"
  "$TMUX_BIN" source-file "$f" 2>/dev/null
  [[ -n "${WK_TRACE:-}" ]] && print -r -- "run cmd=<$cmd>" >> /tmp/wktrace.log
  rm -f "$f"
}
# A `to` state that is a real stack entry: one with a panel of its own or a
# key table of its own. States with neither (rename) are a dialog's label,
# not a mode you can stand in — landing on one would leave the stack stale.
_stackable() {
  [[ -n "$1" ]] || return 1
  mux_mode::meta "$1" 2>/dev/null || return 1
  [[ -n "$MM_TABLE" || -n "$MM_KEYTABLE" ]]
}

_run_deferred() {      # after the popup closes (popup-in-popup mutates ours)
  local cmd f
  # Resolved HERE, while the popup is still up and the client's active pane is
  # still the one you came from — by the time the deferred command runs the
  # answer may be a pane the command itself created.
  cmd="$(_expand_origin "$1")"
  [[ -n "$cmd" ]] || return 0
  f="$(mktemp "${TMPDIR:-/tmp}/wkcmd.XXXXXX")"
  print -r -- "$cmd" > "$f"
  "$TMUX_BIN" run-shell -b -d 0.3 "tmux source-file '$f'; rm -f '$f'" 2>/dev/null
}
# Hand the key to the PANE. An entry with no command of its own is one the
# pane owns: the copy-mode motions are bound once, conditionally, in
# copy-mode-vi (j is scroll-down in Scroll and cursor-down in Copy — one tmux
# table serving two states), and duplicating that into the panel would be the
# second definition this whole design exists to avoid. Measured: a key sent
# to the pane reaches its copy-mode binding while the popup is still up.
_forward() {
  local key="$1" pane
  pane="$("$TMUX_BIN" display -p '#{pane_id}' 2>/dev/null)"
  [[ -n "$pane" && -n "$key" ]] || return 0
  "$TMUX_BIN" send-keys -t "$pane" "$key" 2>/dev/null
}
_forward_deferred() {  # …once this popup is gone (the pane's own dialog needs
  local key="$1" pane #  the screen: i/a prompt for the text object char)
  pane="$("$TMUX_BIN" display -p '#{pane_id}' 2>/dev/null)"
  [[ -n "$pane" && -n "$key" ]] || return 0
  "$TMUX_BIN" run-shell -b -d 0.3 "tmux send-keys -t '$pane' '$key'" 2>/dev/null
}

# ---- the dispatch decision -------------------------------------------------
# Two orthogonal answers for one keypress, and the only place that knows both:
#   D_EXEC  run | defer | forward | ignore   who performs the entry
#   D_STACK push:<state> | sticky | clear    what becomes of the mode stack
# `dispatch` below prints them, so every row of the keymap is testable without
# a tty — pressing j in the Scroll panel used to run nothing AND end the mode.
_decide() {
  local table="$1" key="$2" i k
  D_EXEC=ignore D_STACK="" D_HIT=0 D_CMD=""
  for (( i = 1; i <= ${#E_KEYS}; i++ )); do
    for k in ${(s:|:)E_KEYS[i]}; do
      [[ "$k" == "$key" ]] || continue
      D_HIT=$i; break
    done
    (( D_HIT )) && break
  done
  (( D_HIT )) || return 1          # not ours: the panel is a closed surface
  local flags="${E_FLAGS[D_HIT]}"
  D_CMD="${E_CMD[D_HIT]}"
  _has "$flags" numeric && D_CMD="${D_CMD//'#N'/$key}"
  # `dialog` means the screen belongs to something else next, and a popup
  # opened over a popup mutates the outer one — so the panel steps aside
  # first and the work fires on a short server-side delay.
  if [[ -z "$D_CMD" ]]; then
    _has "$flags" dialog && D_EXEC=defer-forward || D_EXEC=forward
  elif _has "$flags" dialog; then D_EXEC=defer
  else D_EXEC=run
  fi
  if _stackable "${E_TO[D_HIT]}"; then D_STACK="push:${E_TO[D_HIT]}"
  elif _has "$flags" sticky; then D_STACK=sticky
  else D_STACK=clear
  fi
  return 0
}

# ---- key input ------------------------------------------------------------
_readkey() {           # -> KEY (a tmux key name)
  local k rest
  read -rsk1 k || return 1
  case "$k" in
    $'\e')
      if read -rsk1 -t 0.02 rest; then
        case "$rest" in
          '[')
            local seq="" c
            while read -rsk1 -t 0.05 c; do
              seq+="$c"
              [[ "$c" == [A-Za-z~] ]] && break
            done
            case "$seq" in
              A) KEY=Up ;; B) KEY=Down ;; C) KEY=Right ;; D) KEY=Left ;;
              Z) KEY=BTab ;;
              '1;2A') KEY=S-Up ;; '1;2B') KEY=S-Down ;;
              '1;2C') KEY=S-Right ;; '1;2D') KEY=S-Left ;;
              *) KEY="" ;;
            esac ;;
          O) read -rsk1 -t 0.05 c
             case "$c" in A) KEY=Up ;; B) KEY=Down ;; C) KEY=Right ;; D) KEY=Left ;; *) KEY="" ;; esac ;;
          *) KEY="M-${rest}" ;;
        esac
      else
        KEY=Escape
      fi ;;
    $'\t') KEY=Tab ;;
    $'\r'|$'\n') KEY=Enter ;;
    $'\x7f'|$'\b') KEY=BSpace ;;
    [[:cntrl:]])
      local n=$(( #k ))
      if (( n >= 1 && n <= 26 )); then
        KEY="C-$(printf "\\$(printf '%03o' $(( n + 96 )))")"
      else KEY=""
      fi ;;
    *) KEY="$k" ;;
  esac
  return 0
}

# ---- the panel loop -------------------------------------------------------
_panel() {
  local mode="${1:-prefix}" page=0
  CLIENT="${2:-}"
  # A popup is already up (this one) and the driver owns it — the stack must
  # not try to open another from in here.
  export MUX_STACK_INPANEL=1
  # This popup was asked for before the mode ended, and the mode may have
  # ended while it was opening: a key pressed before the panel is up goes to
  # the KEY TABLE (a popup swallows keys, so the table only ever wins this
  # race), and a `dialog` bind there clears the stack without tearing the
  # popup down — that teardown is what used to kill the dialog's own popup.
  # So nobody else will close a stale panel: it reads the stack it was drawn
  # for and, finding the mode gone, exits. The exit IS the teardown.
  mux_stack::top || return 0
  local rows cols
  local -a ct; [[ -n "$CLIENT" ]] && ct=(-c "$CLIENT")
  rows="$("$TMUX_BIN" display -p "${ct[@]}" '#{client_height}' 2>/dev/null)"; [[ "$rows" == <-> ]] || rows=40
  ROWS_MAX=${CFG[max_rows]}
  local avail=$(( rows - MARGIN[1] - MARGIN[3] - 4 ))
  (( ROWS_MAX > avail )) && ROWS_MAX=$avail
  (( ROWS_MAX < 3 )) && ROWS_MAX=3

  print -rn -- $'\e[?25l'
  while true; do
    _load "$mode" || return 0
    _paint "$mode" $page
    print -rn -- "$REPLY"
    if ! _readkey; then
      [[ -n "${WK_TRACE:-}" ]] && print -r -- "panel: readkey FAILED" >> /tmp/wktrace.log
      return 0
    fi
    [[ -n "${WK_TRACE:-}" ]] && print -r -- "panel: key=<$KEY> mode=$mode" >> /tmp/wktrace.log
    [[ -n "$KEY" ]] || continue
    case "$KEY" in
      Escape) mux_stack::clear; return 0 ;;
      "${CFG[back]}") mux_stack::pop; return 0 ;;
      "${CFG[toggle]}") mux_stack::set_visible 0; return 0 ;;
      # Paging only claims C-u/C-d when there IS more than one page — the
      # copy tables bind them to half-page scroll, and a panel that fits on
      # one page has no business swallowing them (the footer only offers
      # the paging hint under the same condition).
      # NB: the arm ENDS (`;;`) when there is nothing to page, so the key
      # falls through to the dispatch below. `break` here would leave the
      # panel loop, not the case.
      "${CFG[next]}") if (( PAGES > 1 )); then
                        (( page + 1 < PAGES )) && (( page++ )); continue
                      fi ;;
      "${CFG[prev]}") if (( PAGES > 1 )); then
                        (( page > 0 )) && (( page-- )); continue
                      fi ;;
    esac
    _decide "$mode" "$KEY" || continue      # unbound keys are swallowed
    # A dialog owns the screen next, and a popup opened over a popup mutates
    # the outer one — so its command fires on a short server-side delay, by
    # which time the stack operation below has taken this panel down.
    case "$D_EXEC" in
      run)           _run "$D_CMD" ;;
      defer)         _run_deferred "$D_CMD" ;;
      forward)       _forward "$KEY" ;;
      defer-forward) _forward_deferred "$KEY" ;;
    esac
    # A sticky entry (a motion, a focus move, a flag toggle) leaves the stack
    # exactly as it was: the panel stays up and repaints, which is what it
    # does with the panel hidden too — the tmux table is unchanged there.
    if [[ "$D_STACK" == sticky ]]; then
      # …unless something else needs the screen (the text objects prompt for
      # their key): step aside, keep the mode, M-. brings the panel back.
      [[ "$D_EXEC" == defer* ]] && { mux_stack::set_visible 0; return 0 }
      continue
    fi
    # Otherwise ONE stack operation, then out: entering a mode pushes it,
    # anything else ends the stack. The driver reopens whatever the new top
    # asks for — a popup cannot resize itself, so each mode gets a sized one.
    if [[ "$D_STACK" == push:* ]]; then
      mux_stack::push "${D_STACK#push:}"
    else
      mux_stack::clear
    fi
    return 0
  done
}

case "${1:-}" in
  # The panel inherits the driver's client: its own stack operations (and the
  # commands it dispatches) must act on the client the popup is drawn on, not
  # on whichever one attached first.
  panel) [[ "${3:-}" == /dev/* ]] && export MUX_CLIENT="$3"
         _panel "${2:-prefix}" "${3:-}" ;;
  render)   # paint once and exit — tests + eyeballing without a popup
    _load "${2:-prefix}" || exit 0
    ROWS_MAX="${4:-${CFG[max_rows]}}"
    _paint "${2:-prefix}" "${3:-0}"
    print -rn -- "$REPLY"
    print
    ;;
  pages)    # PAGE/PAGES as the CALLER sees them after a paint (tests): the
            # panel's C-d/C-u read exactly these, and a `$(_paint …)` fork
            # would hide them again
    _load "${2:-prefix}" || exit 0
    ROWS_MAX="${3:-${CFG[max_rows]}}"
    _paint "${2:-prefix}" 0 >/dev/null
    print -r -- "$PAGE/$PAGES"
    ;;
  dispatch) # what the panel WOULD do with this key, without a tty (tests)
    _load "${2:-prefix}" || exit 0
    if _decide "${2:-prefix}" "${3:-}"; then
      print -r -- "$D_EXEC $D_STACK"
    else
      print -r -- ignore
    fi
    ;;
  open)
    # THE PANEL DRIVER. It owns the popup for the whole time the stack has a
    # shown entry on top: open one, wait for the panel to exit, read the
    # stack again, open the next. The panel itself never opens a popup — a
    # popup cannot resize itself and one opened over another silently mutates
    # the outer one — so every mode switch comes back through here.
    CLIENT="${2:-}"
    # A backgrounded run-shell does NOT format-expand #{client_tty} (and is
    # itself client-less), so resolve the attached client here — the panel
    # is per-client and this config has one client per server.
    [[ -n "$CLIENT" && "$CLIENT" == /dev/* ]] || \
      CLIENT="$("$TMUX_BIN" list-clients -F '#{client_tty}' 2>/dev/null | head -1)"
    typeset -a ct; ct=(); [[ -n "$CLIENT" ]] && ct=(-c "$CLIENT")
    # One driver at a time, or two popups fight over the same client. The
    # claim is this process's PID (see mux_stack::driver_live). NB: no
    # TRAPEXIT to release it — zsh runs TRAPEXIT in every $(…) SUBSHELL too,
    # so the driver would un-claim itself on its first command substitution.
    mux_stack::driver_live && exit 0
    "$TMUX_BIN" set -g @mux_wk_driver $$ 2>/dev/null
    rows="$("$TMUX_BIN" display -p "${ct[@]}" '#{client_height}' 2>/dev/null)"; [[ "$rows" == <-> ]] || rows=40
    cols="$("$TMUX_BIN" display -p "${ct[@]}" '#{client_width}' 2>/dev/null)"; [[ "$cols" == <-> ]] || cols=100
    while mux_stack::top; do
      # the stack says what to draw AND whether to draw at all
      [[ "$MS_VIS" == 1 ]] || break
      mux_mode::meta "$MS_STATE" 2>/dev/null || break
      mode="$MM_TABLE"
      [[ -n "$mode" ]] || break            # a mode with no panel (locked)
      _load "$mode" || break
      _mode_meta "$mode"
      _measure
      ROWS_MAX=${CFG[max_rows]}
      avail=$(( rows - MARGIN[1] - MARGIN[3] - 4 ))
      (( ROWS_MAX > avail )) && ROWS_MAX=$avail
      (( ROWS_MAX < 3 )) && ROWS_MAX=3
      _footer_text 0 1 1
      w=$BODY_W; (( FOOT_W > w )) && w=$FOOT_W
      w=$(( w + PADDING[2] + PADDING[4] + 2 ))
      n=$ROWS_ALL; (( n > ROWS_MAX )) && n=$ROWS_MAX
      h=$(( n + 4 + PADDING[1] + PADDING[3] ))
      x=$(( cols - w - MARGIN[2] )); (( x < 0 )) && x=0
      y=$(( rows - MARGIN[3] )); (( y > rows - 1 )) && y=$(( rows - 1 ))
      [[ -n "${WK_TRACE:-}" ]] && print -r -- "driver: opening $mode (${w}x${h})" >> /tmp/wktrace.log
      # A popup that will not open (no client, a client already showing one)
      # must end the loop — the stack would never move and this would spin.
      "$TMUX_BIN" display-popup "${ct[@]}" -B -E -w "$w" -h "$h" -x "$x" -y "$y" \
        "${0:A} panel $mode '$CLIENT'" || break
      [[ -n "${WK_TRACE:-}" ]] && print -r -- "driver: popup returned, stack=$("$TMUX_BIN" show -gv @mux_stack 2>/dev/null)" >> /tmp/wktrace.log
    done
    "$TMUX_BIN" set -g @mux_wk_driver 0 2>/dev/null
    ;;
  toggle)
    # M-. flips the TOP entry — never a mode name, never a global (hiding the
    # panel in Scroll used to leave Command hidden afterwards).
    if mux_stack::top; then
      if [[ "$MS_VIS" == 1 ]]; then mux_stack::set_visible 0
      else mux_stack::set_visible 1
      fi
    else
      # self-heal: copy-mode can be entered from outside the stack (a hook,
      # an app) — adopt whatever mode tmux is actually in, shown.
      st="$("$TMUX_BIN" display -p '#{client_key_table}|#{?pane_in_mode,1,0}|#{?#{@visual},1,0}|#{?#{@searching},1,0}|#{?search_present,1,0}|#{?client_prefix,1,0}' 2>/dev/null)"
      mux_mode::resolve "${(@s:|:)st}" || exit 0
      mux_stack::push "$MM_STATE"
      mux_stack::set_visible 1
    fi ;;
  restore)
    bar="$(_default_bar)"
    "$TMUX_BIN" set -g status on 2>/dev/null
    [[ -n "$bar" ]] && "$TMUX_BIN" set -g "status-format[0]" "$bar" 2>/dev/null
    for i in 1 2 3 4; do "$TMUX_BIN" set -gu "status-format[$i]" 2>/dev/null; done
    ;;
esac
exit 0
