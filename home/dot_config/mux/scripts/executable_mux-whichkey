#!/usr/bin/env zsh
# mux-whichkey — the which-key PANEL (mux migration Phase 5): a port of
# zj-hud's src/whichkey, vertical and passive-looking, floating over the
# panes in a popup.
#
#   mux-whichkey open <mode> <client>   size + place the popup, run the panel
#   mux-whichkey panel <mode> <client>  the panel itself (inside the popup)
#   mux-whichkey render <mode> [page] [rows]   paint once (tests/debug)
#   mux-whichkey toggle        hide/show (M-.)
#
# tmux popups swallow every keystroke (measured: key tables do not fire
# while one is open), so the panel IS the mode's dispatcher while it is
# open: it reads a key, looks it up in the very same keymap.yaml data that
# generates keymap.conf, and runs that binding's command. Mode switches
# happen inside the loop — no teardown, no flicker. Keys that open one of
# our dialogs close the panel first (a popup opened over a popup silently
# mutates the outer one) and fire on a short server-side delay. Hiding it
# with M-. hands the same bindings back to tmux's key tables.
#
# Chrome mirrors zj-hud exactly: rounded frame, mode breadcrumb as the
# top-border label, one binding per row (right-aligned chord glyphs, dim
# ➜, per-binding icon color, pink labels / blue for mode switches), a
# heavy rule, then the footer hints.

emulate -L zsh
setopt no_unset

TMUX_BIN="${MUX_TMUX_BIN:-tmux}"
DATA="${WK_DATA:-$HOME/.config/mux/whichkey.data}"
WK_DATA="$DATA"
# THE shared mode resolver — the status bar uses the very same one, so the
# pill and the panel can never disagree about which mode is current.
source "${MUX_LIB_DIR:-$HOME/.local/lib}/mux/mode.zsh"
PAD=""
[[ -r "$DATA" ]] || exit 0

# Restore the status stack to "bar only". `set -gu` on an array INDEX
# DELETES the entry instead of restoring tmux's built-in default, so the
# real status-format[0] is read once from a pristine throwaway server and
# cached. Defensive: servers from the status-line era can still carry panel
# rows in status-format.
_default_bar() {
  local cache="${XDG_CACHE_HOME:-$HOME/.cache}/mux/tmux-status-format0"
  if [[ ! -s "$cache" ]]; then
    mkdir -p "${cache:h}" 2>/dev/null
    "$TMUX_BIN" -L mux-wk-default -f /dev/null new-session -d -s p -x 40 -y 8 2>/dev/null
    "$TMUX_BIN" -L mux-wk-default show -gv 'status-format[0]' >| "$cache" 2>/dev/null
    "$TMUX_BIN" -L mux-wk-default kill-server 2>/dev/null
  fi
  [[ -s "$cache" ]] && cat "$cache"
}

typeset -A CFG
line="$(grep -m1 '^#cfg' "$DATA")" || exit 0
for kv in ${(ps:\t:)line}; do
  [[ "$kv" == '#cfg' ]] && continue
  CFG[${kv%%=*}]="${kv#*=}"
done
typeset -a MARGIN PADDING
MARGIN=(${(s:,:)CFG[margin]})      # top right bottom left
PADDING=(${(s:,:)CFG[padding]})
SEP="${CFG[sep]}"
RESET=$'\e[0m'
_fg() { print -rn -- $'\e[38;2;'"$(( 16#${1[2,3]} ));$(( 16#${1[4,5]} ));$(( 16#${1[6,7]} ))m" }
_bg() { print -rn -- $'\e[48;2;'"$(( 16#${1[2,3]} ));$(( 16#${1[4,5]} ));$(( 16#${1[6,7]} ))m" }
BG="$(_bg ${CFG[bg]})"
C_BORDER="$(_fg ${CFG[border]})" C_KEY="$(_fg ${CFG[key]})"
C_LABEL="$(_fg ${CFG[label]})" C_SWITCH="$(_fg ${CFG[switch]})"
C_FOOTER="$(_fg ${CFG[footer]})" C_DIM="$(_fg ${CFG[dim]})"
SOFT="${RESET}${BG}"

# ---- visibility: a PER-MODE, EPHEMERAL flag --------------------------------
# Every mode carries its own which-key visibility (default shown, except the
# start_hidden states like Scroll). The flag lives only while that mode is on
# the stack: popping it — or ending the stack — restores the default. It is
# deliberately NOT global; hiding the panel in Scroll used to leave Command
# hidden the next time you armed the leader (Mode B find).
_vis_default() {
  local st="$1" sh
  for sh in ${(s:,:)CFG[start_hidden]}; do
    [[ -n "$sh" && "$sh" == "$st" ]] && { print -r -- 0; return 0 }
  done
  print -r -- 1
}
_vis() {
  local st="$1" v
  v="$("$TMUX_BIN" show -gv "@wk_vis_$st" 2>/dev/null)"
  [[ "$v" == 0 || "$v" == 1 ]] && { print -r -- "$v"; return 0 }
  _vis_default "$st"
}
_vis_set()   { "$TMUX_BIN" set -g "@wk_vis_$1" "$2" 2>/dev/null }
_vis_clear() { "$TMUX_BIN" set -gu "@wk_vis_$1" 2>/dev/null }
_vis_reset() {
  local o
  for o in ${(f)"$("$TMUX_BIN" show -g 2>/dev/null | grep -o '^@wk_vis_[a-z]*')"}; do
    "$TMUX_BIN" set -gu "$o" 2>/dev/null
  done
}

# ---- key glyphs (zj-hud's rendering) --------------------------------------
G_SHIFT=$'\U000F0636' G_ALT=$'\U000F0635' G_CTRL=$'\U000F0634' G_SUPER=$'\U000F0633'
# zj-hud's bare_key_glyph table — special keys read as SYMBOLS, never words.
G_ENTER=$'\U000F0311' G_ESC=$'\U000F12B7' G_TAB=$'\U000F0312'
G_BTAB=$'\U000F0325'  G_BS=$'\U000F006E'  G_DEL=$'\U000F0E7E'
G_SPACE=$'\U000F1050'
_keyglyph() {          # tmux key name -> display glyphs
  local k="$1" mods="" base
  while true; do
    case "$k" in
      S-*) mods+="$G_SHIFT "; k="${k#S-}" ;;
      M-*) mods+="$G_ALT ";   k="${k#M-}" ;;
      C-*) mods+="$G_CTRL ";  k="${k#C-}" ;;
      D-*) mods+="$G_SUPER "; k="${k#D-}" ;;
      *) break ;;
    esac
  done
  case "$k" in
    Up) base="↑" ;;      Down) base="↓" ;;
    Left) base="←" ;;    Right) base="→" ;;
    Home) base="↖" ;;    End) base="↘" ;;
    PageUp|PgUp) base="⇞" ;;
    PageDown|PgDn) base="⇟" ;;
    Tab) base="$G_TAB" ;;
    BTab) mods=""; base="$G_BTAB" ;;   # shift+tab has its own combined glyph
    Enter) base="$G_ENTER" ;;
    Escape) base="$G_ESC" ;;
    BSpace) base="$G_BS" ;;
    DC|Delete) base="$G_DEL" ;;
    Space) base="$G_SPACE" ;;
    F<->) base="$k" ;;
    [a-z]) base="${(U)k}" ;;
    [A-Z]) base="$G_SHIFT ${k}" ;;      # an uppercase bind IS shift
    *) base="$k" ;;
  esac
  print -rn -- "${mods}${base}"
}
_keysdisplay() {       # pipe-separated tmux keys -> "↑,K" (comma is a KEY)
  local out="" k
  for k in ${(s:|:)1}; do
    [[ -n "$out" ]] && out+=","
    out+="$(_keyglyph "$k")"
  done
  print -rn -- "$out"
}

# ---- data -----------------------------------------------------------------
typeset -a E_KEYS E_DISP E_ICON E_ICOL E_DESC E_FLAGS E_CMD E_TO
_mode_meta() {         # STATE -> M_TITLE M_ICON M_COLOR M_PARENT (+ M_TABLE)
  if mux_mode::meta "$1" 2>/dev/null; then
    M_TITLE="$MM_TITLE" M_ICON="$MM_ICON" M_COLOR="$MM_COLOR"
    M_PARENT="$MM_PARENT" M_TABLE="${MM_TABLE:-$1}"
    return 0
  fi
  # fall back to the panel-table rows (a table with no state of its own)
  local l; l="$(awk -F'\t' -v m="$1" '$1=="#mode" && $2==m {print; exit}' "$DATA")"
  local -a f; f=("${(@ps:\t:)l}")
  M_TITLE="${f[3]}" M_ICON="${f[4]}" M_COLOR="${f[5]}" M_PARENT="${f[6]:-}" M_TABLE="$1"
}
_load() {
  # NB: fields are split with ${(@ps:\t:)} rather than `IFS=$'\t' read`:
  # tab is an IFS *whitespace* character, so read COLLAPSES consecutive
  # tabs — an entry with no flags lost that field and its command shifted
  # into it, which is why a plain action (M-w v) closed the panel without
  # doing anything (Mode B find).
  local state="$1" mode line
  local -a F
  _mode_meta "$state"
  mode="${M_TABLE:-$state}"
  E_KEYS=() E_DISP=() E_ICON=() E_ICOL=() E_DESC=() E_FLAGS=() E_CMD=() E_TO=()
  while IFS= read -r line; do
    [[ "$line" == E$'\t'* ]] || continue
    F=("${(@ps:\t:)line}")
    [[ "${F[2]}" == "$mode" ]] || continue
    E_KEYS+=("${F[3]}"); E_DISP+=("$(_keysdisplay "${F[3]}")")
    E_ICON+=("${F[4]}"); E_ICOL+=("${F[5]}"); E_DESC+=("${F[6]}")
    E_FLAGS+=(",${F[7]}"); E_CMD+=("${F[8]}"); E_TO+=("${F[9]:-}")
  done < "$DATA"
  (( ${#E_KEYS} )) || return 1
  _order "$mode"
  return 0
}

_has() { [[ "$1" == *",$2,"* ]] }

_order() {
  # NB: every local is declared ONCE here — re-running `local x=…` for a
  # name that already exists in the scope makes zsh PRINT it (typeset
  # behaviour), which would land in the panel's own output.
  local mode="$1" line ekeys u sk m k entry
  local -i i j gi pos placed found
  local -a F G_MEMBERS members ordered_units NK ND NI NC NE NF NM NT
  local -A unit_of unit_pos unit_anchor

  G_MEMBERS=()
  while IFS= read -r line; do
    [[ "$line" == '#group'$'\t'* ]] || continue
    F=("${(@ps:\t:)line}")
    [[ "${F[2]}" == "$mode" ]] || continue
    G_MEMBERS+=("${F[3]}")
  done < "$DATA"

  for (( i = 1; i <= ${#E_KEYS}; i++ )); do
    ekeys="${E_KEYS[i]}"; placed=0
    for (( gi = 1; gi <= ${#G_MEMBERS}; gi++ )); do
      pos=0
      for m in ${(s:|:)G_MEMBERS[gi]}; do
        (( pos++ )); found=0
        for k in ${(s:|:)ekeys}; do
          [[ "$k" == "$m" ]] && { found=1; break }
        done
        (( found )) || continue
        unit_of[$i]="g$gi"; unit_pos[$i]=$pos; placed=1
        break
      done
      (( placed )) && break
    done
    (( placed )) || { unit_of[$i]="e$i"; unit_pos[$i]=0 }
    u="${unit_of[$i]}"
    sk="$(_entry_sortkey "$ekeys" "${E_FLAGS[i]}")"
    if [[ -z "${unit_anchor[$u]:-}" ]]; then
      unit_anchor[$u]="$sk"; ordered_units+=("$u")
    elif (( unit_pos[$i] == 1 )); then
      unit_anchor[$u]="$sk"      # a group anchors on its FIRST member
    fi
  done

  # LC_ALL=C: a UTF-8 locale collates punctuation together with digits and
  # letters, which sorted '[' ahead of '1' and put the bracket group above
  # the tab numbers.
  ordered_units=(${(f)"$(for u in $ordered_units; do print -r -- "${unit_anchor[$u]}	$u"; done | LC_ALL=C sort | cut -f2)"})

  for u in $ordered_units; do
    members=()
    for (( i = 1; i <= ${#E_KEYS}; i++ )); do
      [[ "${unit_of[$i]}" == "$u" ]] && members+=("${unit_pos[$i]}:$i")
    done
    for entry in ${(n)members}; do
      j="${entry#*:}"
      NK+=("${E_KEYS[j]}"); ND+=("${E_DISP[j]}"); NI+=("${E_ICON[j]}")
      NC+=("${E_ICOL[j]}"); NE+=("${E_DESC[j]}"); NF+=("${E_FLAGS[j]}"); NM+=("${E_CMD[j]}")
      NT+=("${E_TO[j]}")
    done
  done
  E_KEYS=("$NK[@]"); E_DISP=("$ND[@]"); E_ICON=("$NI[@]")
  E_ICOL=("$NC[@]"); E_DESC=("$NE[@]"); E_FLAGS=("$NF[@]"); E_CMD=("$NM[@]")
  E_TO=("$NT[@]")
}

# ---- panel sort (zj-hud labels.rs) ----------------------------------------
# Units sort by: bindings that ENTER another mode first, then unmodified
# chords alphabetically, then modified ones by (modifier count, modifier
# rank shift<super<alt<ctrl, key). An uppercase letter normalizes to
# shift+lowercase, so `Y` sorts with the modified chords, not the bare ones.
# Named keys (arrows, nav block, tab/space/enter/backspace/delete/esc) come
# before character keys, in that curated reading order.
typeset -a CURATED
CURATED=(up down left right home end pageup pagedown tab space enter backspace delete esc)
_sortkey() {           # tmux key name -> a sortable string
  local k="$1" mods="" rank bare cls kr
  local -a mr
  while true; do
    case "$k" in
      S-*) mr+=(0); k="${k#S-}" ;;
      M-*) mr+=(2); k="${k#M-}" ;;
      C-*) mr+=(3); k="${k#C-}" ;;
      *) break ;;
    esac
  done
  case "$k" in
    [A-Z]) mr+=(0); k="${(L)k}" ;;         # uppercase implies shift
  esac
  bare="${(L)k}"
  case "$bare" in
    btab) bare=tab ;;
    escape) bare=esc ;;
    bspace) bare=backspace ;;
  esac
  kr=${CURATED[(i)$bare]}
  if (( kr <= ${#CURATED} )); then
    cls=0; kr=$(( kr ))
  elif [[ ${#bare} == 1 ]]; then
    cls=1; kr=0
  else
    cls=0; kr=500
  fi
  mr=(${(on)mr})
  printf '%d:%02d:%s:%d:%03d:%s' $(( ${#mr} > 0 )) ${#mr} "${(j::)mr}" $cls $kr "$bare"
}
_entry_sortkey() {     # smallest key of a (possibly merged) entry, + mode bias
  local keys="$1" flags="$2" best="" k sk
  for k in ${(s:|:)keys}; do
    sk="$(_sortkey "$k")"
    [[ -z "$best" || "$sk" < "$best" ]] && best="$sk"
  done
  local bias=1
  _has "$flags" switch && bias=0
  print -rn -- "${bias}|${best}"
}

# ---- geometry -------------------------------------------------------------
_measure() {           # -> W_KEYS W_ICON W_LABEL BODY_W ROWS_ALL
  local i
  W_KEYS=0 W_ICON=0 W_LABEL=0
  for (( i = 1; i <= ${#E_DISP}; i++ )); do
    (( ${#E_DISP[i]} > W_KEYS )) && W_KEYS=${#E_DISP[i]}
    (( ${#E_ICON[i]} > W_ICON )) && W_ICON=${#E_ICON[i]}
    (( ${#E_DESC[i]} > W_LABEL )) && W_LABEL=${#E_DESC[i]}
  done
  BODY_W=$(( W_KEYS + 1 + ${#SEP} + 1 + (W_ICON ? W_ICON + 1 : 0) + W_LABEL ))
  ROWS_ALL=${#E_DISP}
}

_footer_text() {       # -> FOOT FOOT_W (colored) for page/pages
  local page="$1" pages="$2" back="$3"
  local -a segs; local w=0
  segs+=("${C_KEY}${G_ESC}${SOFT}${C_FOOTER} close${SOFT}"); (( w += ${#G_ESC} + 6 ))
  if (( back )); then
    segs+=("${C_KEY}${G_BS}${SOFT}${C_FOOTER} back${SOFT}"); (( w += ${#G_BS} + 5 + 2 ))
  fi
  local tg; tg="$(_keyglyph "${CFG[toggle]}")"
  segs+=("${C_KEY}${tg}${SOFT}${C_FOOTER} hide${SOFT}"); (( w += ${#tg} + 5 + 2 ))
  if (( pages > 1 )); then
    local pg="$(_keyglyph "${CFG[prev]}")/$(_keyglyph "${CFG[next]}")"
    segs+=("${C_KEY}${pg}${SOFT}${C_FOOTER} scroll${SOFT}"); (( w += ${#pg} + 7 + 2 ))
  fi
  FOOT="${(pj:  :)segs}"; FOOT_W=$w
}

# ---- paint ----------------------------------------------------------------
_paint() {
  local mode="$1" page="$2"
  _mode_meta "$mode"
  _measure
  local -i per_page=$(( ROWS_MAX ))
  local -i pages=$(( (ROWS_ALL + per_page - 1) / per_page ))
  (( pages < 1 )) && pages=1
  (( page >= pages )) && page=$(( pages - 1 ))
  PAGE=$page PAGES=$pages

  # breadcrumb: every mode glyph up the parent chain, dim » between
  local bread="" m="$mode"
  local -i bw=0
  local -a chain; chain=()
  while [[ -n "$m" ]]; do
    _mode_meta "$m"
    chain=("$(_fg $M_COLOR)${M_ICON}" "$chain[@]")
    (( bw += ${#M_ICON} ))
    m="$M_PARENT"
  done
  (( ${#chain} > 1 )) && (( bw += (${#chain} - 1) * 3 ))
  # NB: join by hand — a `j:...:` flag argument is literal, so a parameter
  # inside it would render as the text "${C_DIM}".
  local ci
  for (( ci = 1; ci <= ${#chain}; ci++ )); do
    (( ci > 1 )) && bread+="${C_DIM} » ${SOFT}"
    bread+="${chain[ci]}"
  done
  _mode_meta "$mode"

  local back=0; [[ -n "$M_PARENT" ]] && back=1
  _footer_text $page $pages $back
  local -i content_w=$BODY_W
  (( FOOT_W > content_w )) && content_w=$FOOT_W
  local -i inner=$(( content_w + PADDING[2] + PADDING[4] ))
  local -i box_w=$(( inner + 2 ))
  local -i start=$(( page * per_page + 1 ))
  local -i last=$(( start + per_page - 1 ))
  (( last > ROWS_ALL )) && last=$ROWS_ALL
  local -i body_n=$(( last - start + 1 ))
  local -i box_h=$(( body_n + 4 + PADDING[1] + PADDING[3] ))

  local out="" i r=1
  local blank="${(l:$box_w:: :)PAD}"
  for (( i = 1; i <= box_h; i++ )); do
    out+=$'\e['"${i};1H${BG}${blank}"
  done
  # top border with breadcrumb
  local -i dashes=$(( box_w - 3 - bw - 1 ))
  (( dashes < 0 )) && dashes=0
  out+=$'\e[1;1H'"${BG}${C_BORDER}╭ ${SOFT}${bread}${SOFT}${C_BORDER} ${(l:$dashes::─:)PAD}╮${SOFT}"
  # body
  local pl="${(l:${PADDING[4]}:: :)PAD}" pr="${(l:${PADDING[2]}:: :)PAD}"
  r=$(( 2 + PADDING[1] ))
  for (( i = start; i <= last; i++ )); do
    local disp="${E_DISP[i]}" icon="${E_ICON[i]}" desc="${E_DESC[i]}"
    local kp=$(( W_KEYS - ${#disp} )) lcol="$C_LABEL"
    _has "${E_FLAGS[i]}" switch && lcol="$C_SWITCH"
    local cell="${(l:$kp:: :)PAD}${C_KEY}${disp}${SOFT}${C_DIM} ${SEP} ${SOFT}"
    if (( W_ICON > 0 )); then
      if [[ -n "$icon" ]]; then
        cell+="$(_fg ${E_ICOL[i]})${icon}${SOFT}${(l:$(( W_ICON - ${#icon} )):: :)PAD} "
      else
        cell+="${(l:$(( W_ICON + 1 )):: :)PAD}"
      fi
    fi
    cell+="${lcol}${desc}${SOFT}"
    local -i used=$(( W_KEYS + 1 + ${#SEP} + 1 + (W_ICON ? W_ICON + 1 : 0) + ${#desc} ))
    out+=$'\e['"${r};1H${BG}${C_BORDER}│${SOFT}${pl}${cell}${(l:$(( content_w - used )):: :)PAD}${pr}${C_BORDER}│${SOFT}"
    (( r++ ))
  done
  # heavy rule + footer, then the bottom border
  out+=$'\e['"${r};1H${BG}${C_BORDER}│${SOFT}${pl}${C_FOOTER}${(l:$content_w::━:)PAD}${SOFT}${pr}${C_BORDER}│${SOFT}"
  (( r++ ))
  local counter="" cw=0
  if (( PAGES > 1 )); then
    counter="${C_FOOTER}$(( PAGE + 1 ))/${PAGES}${SOFT}"
    cw=$(( ${#PAGES} + ${#PAGES} + 1 ))
  fi
  local -i fgap=$(( content_w - FOOT_W - cw ))
  (( fgap < 0 )) && fgap=0
  out+=$'\e['"${r};1H${BG}${C_BORDER}│${SOFT}${pl}${FOOT}${(l:$fgap:: :)PAD}${counter}${pr}${C_BORDER}│${SOFT}"
  (( r++ ))
  out+=$'\e['"${r};1H${BG}${C_BORDER}╰${(l:$(( box_w - 2 ))::─:)PAD}╯${RESET}"
  BOX_W=$box_w BOX_H=$box_h
  print -rn -- "$out"
}

# ---- command execution ----------------------------------------------------
_run() {               # run a tmux command line (source-file handles quoting)
  local cmd="$1" f
  [[ -n "$cmd" ]] || return 0
  f="$(mktemp "${TMPDIR:-/tmp}/wkcmd.XXXXXX")"
  print -r -- "$cmd" > "$f"
  "$TMUX_BIN" source-file "$f" 2>/dev/null
  [[ -n "${WK_TRACE:-}" ]] && print -r -- "run cmd=<$cmd>" >> /tmp/wktrace.log
  rm -f "$f"
}
_reopen() {            # ask the driver for a correctly sized popup
  # A popup cannot resize itself (geometry flags are ignored once a popup
  # exists), and a job scheduled from inside the popup DIES with it — so the
  # next mode goes to the driver loop in `open`, which owns the sequence.
  [[ -n "${WK_TRACE:-}" ]] && print -r -- "panel: requesting $1 -> $NEXT_FILE" >> /tmp/wktrace.log
  print -r -- "$1" >| "$NEXT_FILE"
}
_arm_state() {         # put the client in the key table a state implies
  case "$1" in
    command) "$TMUX_BIN" set key-table root 2>/dev/null
             "$TMUX_BIN" switch-client -T prefix 2>/dev/null ;;
    tab|pane|session|resize|move|locked|nested)
             "$TMUX_BIN" set key-table "$1" 2>/dev/null ;;
    *) ;;              # scroll/copy/search live inside copy-mode
  esac
}

_leave_mode() { _vis_reset; "$TMUX_BIN" set key-table root 2>/dev/null }

_run_deferred() {      # after the popup closes (popup-in-popup mutates ours)
  local cmd="$1" f
  [[ -n "$cmd" ]] || return 0
  f="$(mktemp "${TMPDIR:-/tmp}/wkcmd.XXXXXX")"
  print -r -- "$cmd" > "$f"
  "$TMUX_BIN" run-shell -b -d 0.3 "tmux source-file '$f'; rm -f '$f'" 2>/dev/null
}

# ---- key input ------------------------------------------------------------
_readkey() {           # -> KEY (a tmux key name)
  local k rest
  read -rsk1 k || return 1
  case "$k" in
    $'\e')
      if read -rsk1 -t 0.02 rest; then
        case "$rest" in
          '[')
            local seq="" c
            while read -rsk1 -t 0.05 c; do
              seq+="$c"
              [[ "$c" == [A-Za-z~] ]] && break
            done
            case "$seq" in
              A) KEY=Up ;; B) KEY=Down ;; C) KEY=Right ;; D) KEY=Left ;;
              Z) KEY=BTab ;;
              '1;2A') KEY=S-Up ;; '1;2B') KEY=S-Down ;;
              '1;2C') KEY=S-Right ;; '1;2D') KEY=S-Left ;;
              *) KEY="" ;;
            esac ;;
          O) read -rsk1 -t 0.05 c
             case "$c" in A) KEY=Up ;; B) KEY=Down ;; C) KEY=Right ;; D) KEY=Left ;; *) KEY="" ;; esac ;;
          *) KEY="M-${rest}" ;;
        esac
      else
        KEY=Escape
      fi ;;
    $'\t') KEY=Tab ;;
    $'\r'|$'\n') KEY=Enter ;;
    $'\x7f'|$'\b') KEY=BSpace ;;
    [[:cntrl:]])
      local n=$(( #k ))
      if (( n >= 1 && n <= 26 )); then
        KEY="C-$(printf "\\$(printf '%03o' $(( n + 96 )))")"
      else KEY=""
      fi ;;
    *) KEY="$k" ;;
  esac
  return 0
}

# ---- the panel loop -------------------------------------------------------
_panel() {
  local mode="${1:-prefix}" page=0
  CLIENT="${2:-}"
  NEXT_FILE="${3:-${TMPDIR:-/tmp}/mux-whichkey-next}"
  : >| "$NEXT_FILE"
  local rows cols
  local -a ct; [[ -n "$CLIENT" ]] && ct=(-c "$CLIENT")
  rows="$("$TMUX_BIN" display -p "${ct[@]}" '#{client_height}' 2>/dev/null)"; [[ "$rows" == <-> ]] || rows=40
  ROWS_MAX=${CFG[max_rows]}
  local avail=$(( rows - MARGIN[1] - MARGIN[3] - 4 ))
  (( ROWS_MAX > avail )) && ROWS_MAX=$avail
  (( ROWS_MAX < 3 )) && ROWS_MAX=3

  print -rn -- $'\e[?25l'
  while true; do
    _load "$mode" || return 0
    print -rn -- "$(_paint "$mode" $page)"
    if ! _readkey; then
      [[ -n "${WK_TRACE:-}" ]] && print -r -- "panel: readkey FAILED" >> /tmp/wktrace.log
      return 0
    fi
    [[ -n "${WK_TRACE:-}" ]] && print -r -- "panel: key=<$KEY> mode=$mode" >> /tmp/wktrace.log
    [[ -n "$KEY" ]] || continue
    case "$KEY" in
      Escape) _vis_reset; "$TMUX_BIN" set key-table root 2>/dev/null; return 0 ;;
      "${CFG[back]}")
        _mode_meta "$mode"
        if [[ -n "$M_PARENT" ]]; then
          _vis_clear "$mode"           # this mode just popped off the stack
          mode="$M_PARENT"
          _arm_state "$mode"
          _reopen "$mode"
          return 0
        else
          _vis_reset
          "$TMUX_BIN" set key-table root 2>/dev/null; return 0
        fi
        continue ;;
      "${CFG[toggle]}")
        _vis_set "$mode" 0; return 0 ;;
      "${CFG[next]}") (( page + 1 < PAGES )) && (( page++ )); continue ;;
      "${CFG[prev]}") (( page > 0 )) && (( page-- )); continue ;;
    esac
    # binding lookup
    local i hit=0
    for (( i = 1; i <= ${#E_KEYS}; i++ )); do
      local k
      for k in ${(s:|:)E_KEYS[i]}; do
        [[ "$k" == "$KEY" ]] || continue
        hit=$i; break
      done
      (( hit )) && break
    done
    (( hit )) || continue
    local flags="${E_FLAGS[hit]}" cmd="${E_CMD[hit]}"
    _has "$flags" numeric && cmd="${cmd//'#N'/$KEY}"
    if _has "$flags" switch && ! _has "$flags" exit; then
      # push the next mode without tearing the popup down
      _run "$cmd"
      local next="${E_TO[hit]}"
      # states without a panel of their own (locked, rename) just exit
      [[ -n "$next" ]] && mux_mode::meta "$next" 2>/dev/null && [[ -n "$MM_TABLE" ]] || return 0
      next="$MM_TABLE"
      # A popup cannot resize itself (the geometry flags are ignored when a
      # popup already exists), so each mode gets its own correctly sized one.
      _reopen "$next"
      return 0
    fi
    if _has "$flags" dialog; then
      _run_deferred "$cmd"
      _leave_mode
      return 0
    fi
    _run "$cmd"
    _has "$flags" stay && continue
    # An action ends the mode, like zellij. tmux's own one-shot prefix table
    # resets itself, but the panel consumed the key, so the client is still
    # armed unless we clear it here (Mode B find). Entries flagged `exit`
    # own their target state (locked, copy-mode) — leave those alone.
    _has "$flags" exit || _leave_mode
    return 0
  done
}

case "${1:-}" in
  restore)
    bar="$(_default_bar)"
    "$TMUX_BIN" set -g status on 2>/dev/null
    [[ -n "$bar" ]] && "$TMUX_BIN" set -g "status-format[0]" "$bar" 2>/dev/null
    for i in 1 2 3 4; do "$TMUX_BIN" set -gu "status-format[$i]" 2>/dev/null; done
    ;;
  panel) _panel "${2:-prefix}" "${3:-}" "${4:-}" ;;
  render)   # paint once and exit — tests + eyeballing without a popup
    _load "${2:-prefix}" || exit 0
    ROWS_MAX="${4:-${CFG[max_rows]}}"
    _paint "${2:-prefix}" "${3:-0}"
    print
    ;;
  open)
    mode="${2:-prefix}"
    CLIENT="${3:-}"
    # A backgrounded run-shell does NOT format-expand #{client_tty} (and is
    # itself client-less), so resolve the attached client here — the panel
    # is per-client and this config has one client per server.
    [[ -n "$CLIENT" && "$CLIENT" == /dev/* ]] || \
      CLIENT="$("$TMUX_BIN" list-clients -F '#{client_tty}' 2>/dev/null | head -1)"
    typeset -a ct; ct=(); [[ -n "$CLIENT" ]] && ct=(-c "$CLIENT")
    [[ "$(_vis "$mode")" == 1 ]] || exit 0
    # size the popup to the panel's own geometry, anchored bottom-right
    _load "$mode" || exit 0
    _mode_meta "$mode"
    _measure
    rows="$("$TMUX_BIN" display -p "${ct[@]}" '#{client_height}' 2>/dev/null)"; [[ "$rows" == <-> ]] || rows=40
    cols="$("$TMUX_BIN" display -p "${ct[@]}" '#{client_width}' 2>/dev/null)"; [[ "$cols" == <-> ]] || cols=100
    ROWS_MAX=${CFG[max_rows]}
    avail=$(( rows - MARGIN[1] - MARGIN[3] - 4 ))
    (( ROWS_MAX > avail )) && ROWS_MAX=$avail
    (( ROWS_MAX < 3 )) && ROWS_MAX=3
    _footer_text 0 1 1
    w=$BODY_W; (( FOOT_W > w )) && w=$FOOT_W
    w=$(( w + PADDING[2] + PADDING[4] + 2 ))
    n=$ROWS_ALL; (( n > ROWS_MAX )) && n=$ROWS_MAX
    h=$(( n + 4 + PADDING[1] + PADDING[3] ))
    x=$(( cols - w - MARGIN[2] )); (( x < 0 )) && x=0
    y=$(( rows - MARGIN[3] )); (( y > rows - 1 )) && y=$(( rows - 1 ))
    NEXT_FILE="${TMPDIR:-/tmp}/mux-whichkey-next.${CLIENT:t}"
    while true; do
      # per-mode visibility is checked EVERY iteration: a mode switched into
      # from inside the panel can be one the user has hidden.
      [[ "$(_vis "$mode")" == 1 ]] || break
      _load "$mode" || break
      _mode_meta "$mode"
      _measure
      ROWS_MAX=${CFG[max_rows]}
      avail=$(( rows - MARGIN[1] - MARGIN[3] - 4 ))
      (( ROWS_MAX > avail )) && ROWS_MAX=$avail
      (( ROWS_MAX < 3 )) && ROWS_MAX=3
      _footer_text 0 1 1
      w=$BODY_W; (( FOOT_W > w )) && w=$FOOT_W
      w=$(( w + PADDING[2] + PADDING[4] + 2 ))
      n=$ROWS_ALL; (( n > ROWS_MAX )) && n=$ROWS_MAX
      h=$(( n + 4 + PADDING[1] + PADDING[3] ))
      x=$(( cols - w - MARGIN[2] )); (( x < 0 )) && x=0
      y=$(( rows - MARGIN[3] )); (( y > rows - 1 )) && y=$(( rows - 1 ))
      : >| "$NEXT_FILE"
      [[ -n "${WK_TRACE:-}" ]] && print -r -- "driver: opening $mode (${w}x${h}) next_file=$NEXT_FILE" >> /tmp/wktrace.log
      "$TMUX_BIN" display-popup "${ct[@]}" -B -E -w "$w" -h "$h" -x "$x" -y "$y" \
        "${0:A} panel $mode '$CLIENT' '$NEXT_FILE'"
      # The panel writes the mode it wants next (empty = it is done).
      next="$(cat "$NEXT_FILE" 2>/dev/null)"
      [[ -n "${WK_TRACE:-}" ]] && print -r -- "driver: popup returned, next='$next'" >> /tmp/wktrace.log
      rm -f "$NEXT_FILE"
      [[ -n "$next" ]] || break
      mode="$next"
    done
    ;;
  toggle)
    st="$("$TMUX_BIN" display -p '#{client_key_table}|#{?pane_in_mode,1,0}|#{?#{@visual},1,0}|#{?#{@searching},1,0}|#{?search_present,1,0}|#{?client_prefix,1,0}' 2>/dev/null)"
    mux_mode::resolve "${(@s:|:)st}" || exit 0
    [[ -n "$MM_TABLE" ]] || exit 0
    if [[ "$(_vis "$MM_TABLE")" == 1 ]]; then
      _vis_set "$MM_TABLE" 0
    else
      _vis_set "$MM_TABLE" 1
      "${0:A}" open "$MM_TABLE" "$("$TMUX_BIN" display -p '#{client_tty}')" &
    fi ;;
  vis-clear) [[ -n "${2:-}" ]] && _vis_clear "$2" ;;
  vis-reset) _vis_reset ;;
  restore)
    bar="$(_default_bar)"
    "$TMUX_BIN" set -g status on 2>/dev/null
    [[ -n "$bar" ]] && "$TMUX_BIN" set -g "status-format[0]" "$bar" 2>/dev/null
    for i in 1 2 3 4; do "$TMUX_BIN" set -gu "status-format[$i]" 2>/dev/null; done
    ;;
  panel) _panel "${2:-prefix}" "${3:-}" "${4:-}" ;;
  render)   # paint once and exit — tests + eyeballing without a popup
    _load "${2:-prefix}" || exit 0
    ROWS_MAX="${4:-${CFG[max_rows]}}"
    _paint "${2:-prefix}" "${3:-0}"
    print
    ;;
  open)
    mode="${2:-prefix}"
    CLIENT="${3:-}"
    # A backgrounded run-shell does NOT format-expand #{client_tty} (and is
    # itself client-less), so resolve the attached client here — the panel
    # is per-client and this config has one client per server.
    [[ -n "$CLIENT" && "$CLIENT" == /dev/* ]] || \
      CLIENT="$("$TMUX_BIN" list-clients -F '#{client_tty}' 2>/dev/null | head -1)"
    typeset -a ct; ct=(); [[ -n "$CLIENT" ]] && ct=(-c "$CLIENT")
    [[ "$(_vis "$mode")" == 1 ]] || exit 0
    # size the popup to the panel's own geometry, anchored bottom-right
    _load "$mode" || exit 0
    _mode_meta "$mode"
    _measure
    rows="$("$TMUX_BIN" display -p "${ct[@]}" '#{client_height}' 2>/dev/null)"; [[ "$rows" == <-> ]] || rows=40
    cols="$("$TMUX_BIN" display -p "${ct[@]}" '#{client_width}' 2>/dev/null)"; [[ "$cols" == <-> ]] || cols=100
    ROWS_MAX=${CFG[max_rows]}
    avail=$(( rows - MARGIN[1] - MARGIN[3] - 4 ))
    (( ROWS_MAX > avail )) && ROWS_MAX=$avail
    (( ROWS_MAX < 3 )) && ROWS_MAX=3
    _footer_text 0 1 1
    w=$BODY_W; (( FOOT_W > w )) && w=$FOOT_W
    w=$(( w + PADDING[2] + PADDING[4] + 2 ))
    n=$ROWS_ALL; (( n > ROWS_MAX )) && n=$ROWS_MAX
    h=$(( n + 4 + PADDING[1] + PADDING[3] ))
    x=$(( cols - w - MARGIN[2] )); (( x < 0 )) && x=0
    y=$(( rows - MARGIN[3] )); (( y > rows - 1 )) && y=$(( rows - 1 ))
    NEXT_FILE="${TMPDIR:-/tmp}/mux-whichkey-next.${CLIENT:t}"
    while true; do
      # per-mode visibility is checked EVERY iteration: a mode switched into
      # from inside the panel can be one the user has hidden.
      [[ "$(_vis "$mode")" == 1 ]] || break
      _load "$mode" || break
      _mode_meta "$mode"
      _measure
      ROWS_MAX=${CFG[max_rows]}
      avail=$(( rows - MARGIN[1] - MARGIN[3] - 4 ))
      (( ROWS_MAX > avail )) && ROWS_MAX=$avail
      (( ROWS_MAX < 3 )) && ROWS_MAX=3
      _footer_text 0 1 1
      w=$BODY_W; (( FOOT_W > w )) && w=$FOOT_W
      w=$(( w + PADDING[2] + PADDING[4] + 2 ))
      n=$ROWS_ALL; (( n > ROWS_MAX )) && n=$ROWS_MAX
      h=$(( n + 4 + PADDING[1] + PADDING[3] ))
      x=$(( cols - w - MARGIN[2] )); (( x < 0 )) && x=0
      y=$(( rows - MARGIN[3] )); (( y > rows - 1 )) && y=$(( rows - 1 ))
      : >| "$NEXT_FILE"
      [[ -n "${WK_TRACE:-}" ]] && print -r -- "driver: opening $mode (${w}x${h}) next_file=$NEXT_FILE" >> /tmp/wktrace.log
      "$TMUX_BIN" display-popup "${ct[@]}" -B -E -w "$w" -h "$h" -x "$x" -y "$y" \
        "${0:A} panel $mode '$CLIENT' '$NEXT_FILE'"
      # The panel writes the mode it wants next (empty = it is done).
      next="$(cat "$NEXT_FILE" 2>/dev/null)"
      [[ -n "${WK_TRACE:-}" ]] && print -r -- "driver: popup returned, next='$next'" >> /tmp/wktrace.log
      rm -f "$NEXT_FILE"
      [[ -n "$next" ]] || break
      mode="$next"
    done
    ;;
  toggle)
    st="$("$TMUX_BIN" display -p '#{client_key_table}|#{?pane_in_mode,1,0}|#{?#{@visual},1,0}|#{?#{@searching},1,0}|#{?search_present,1,0}|#{?client_prefix,1,0}' 2>/dev/null)"
    mux_mode::resolve "${(@s:|:)st}" || exit 0
    [[ -n "$MM_TABLE" ]] || exit 0
    # On screen? Only then does the toggle hide. Otherwise it SHOWS — which
    # is what it must do in a start_hidden state like Scroll (pressing it
    # there used to just re-hide an already-hidden panel).
    onscreen=1
    [[ "$("$TMUX_BIN" show -gv @wk_hidden 2>/dev/null)" == 1 ]] && onscreen=0
    if (( onscreen )); then
      for sh in ${(s:,:)CFG[start_hidden]}; do
        [[ -n "$sh" && "$sh" == "$MM_STATE" && "$("$TMUX_BIN" show -gv @wk_force 2>/dev/null)" != 1 ]] && onscreen=0
      done
    fi
    if (( onscreen )); then
      "$TMUX_BIN" set -g @wk_hidden 1 2>/dev/null
      "$TMUX_BIN" set -g @wk_force 0 2>/dev/null
    else
      "$TMUX_BIN" set -g @wk_hidden 0 2>/dev/null
      "$TMUX_BIN" set -g @wk_force 1 2>/dev/null
      "${0:A}" open "$MM_STATE" "$("$TMUX_BIN" display -p '#{client_tty}')" &
    fi ;;
esac
exit 0
