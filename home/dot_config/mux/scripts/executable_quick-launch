#!/usr/bin/env zsh
# quick-launch — define quick-launch actions as "panes", "tabs", or
# "workspaces" for Zellij. A CLI port of the quicklaunch.wezterm plugin.
#
#   quick-launch menu  pane|tab|workspace      # fuzzy-pick, then open
#   quick-launch open   pane|tab|workspace ID  # open a target directly
#   quick-launch layout pane|tab|workspace ID  # print the generated KDL (debug)
#   quick-launch list  [pane|tab|workspace]    # list defined targets
#
# Targets are read from a directory ($QUICK_LAUNCH_DIR, default
# ~/.config/mux/quick-launch): the managed default.yaml plus optional
# host-local fragments under launch.d/. A single file can be forced via
# $QUICK_LAUNCH_TARGETS. YAML/JSON/TOML are accepted.
#
# The fuzzy picker is plain `fzf`; inside Zellij it is meant to run in a
# floating modal pane (see the quick-launch-zellij adapter), but it works
# standalone too. Geometry is taken from QUICK_LAUNCH_HEIGHT / _MARGIN /
# _PADDING; `menu` also accepts a --no-border flag (borderless render for an
# embedder that draws its own frame) and forwards it to the picker on the
# command line, matching the pick-glyph / pick-gitmoji convention. The legacy
# QUICK_LAUNCH_NO_BORDER env var is still read by quick-launch-pick itself.

set -euo pipefail

# Resolve our own real directory (following symlinks just in case) so we can
# source lib/ and find the sibling quick-launch-pick regardless of how we were
# invoked. We live in ~/.config/mux/scripts/ alongside the picker, with the
# shell libraries under lib/.
_src="${0:A}"
SCRIPT_DIR="${_src:h}"
LIB_DIR="$SCRIPT_DIR/lib"

# shellcheck source=/dev/null
. "$LIB_DIR/config.zsh"
# shellcheck source=/dev/null
. "$LIB_DIR/command.zsh"
# shellcheck source=/dev/null
. "$LIB_DIR/dispatch.zsh"
# shellcheck source=/dev/null
. "$LIB_DIR/dispatch-tmux.zsh"

ql_die() {
  echo "quick-launch: $*" >&2
  exit 1
}

# Persist the already-merged $QL_JSON to a cache file and echo its path. Only
# rewrites when the content actually changed, so the file mtime (and thus the
# picker's line cache, which keys off it) stays stable across launches. This is
# how the picker consumes the directory/launch.d merge without re-implementing
# it: we hand it a single pre-merged .json file.
ql_write_merged_cache() {
  local cache sources_file
  cache="$(ql_cache_path)"
  sources_file="$(ql_cache_sources_path)"
  mkdir -p "${cache%/*}"
  if [[ ! -f "$cache" ]] || [[ "$(cat "$cache" 2>/dev/null)" != "$QL_JSON" ]]; then
    printf '%s\n' "$QL_JSON" >|"$cache"
  fi
  # The source SET the cache was built from — ql_load compares against it, so
  # a fragment that appears (or disappears) invalidates the cache even when
  # its mtime says nothing changed.
  local -a files=()
  local f
  while IFS= read -r f; do [[ -n "$f" ]] && files+=("$f"); done < <(ql_source_files)
  printf '%s\n' "${(F)files}" >|"$sources_file"
  printf '%s\n' "$cache"
}

# Show the fuzzy picker for a kind and dispatch the chosen target. The
# picker itself is quick-launch-pick (zsh), built on the shared
# pick-common.zsh facility so it matches pick-glyph / pick-gitmoji; it
# prints the selected id (or exits 130 on cancel). Geometry is inherited from
# the environment (set by the quick-launch-zellij adapter); no-border arrives
# as the --no-border CLI flag (2nd arg) and is forwarded to the picker on its
# command line, matching pick-glyph / pick-gitmoji (Wave 2, group C5,
# Decision 1).
ql_menu() {
  local kind="$1"
  local no_border="${2:-0}"
  case "$kind" in
    pane | tab | workspace) ;;
    *) ql_die "unknown kind '$kind' (want pane|tab|workspace)" ;;
  esac
  local -a pick_flags=()
  (( no_border )) && pick_flags=(--no-border)

  # Hand the picker a single merged JSON view (default.yaml + launch.d/*) so it
  # reads exactly what we dispatch from, without re-implementing the merge.
  local chosen targets
  targets="$(ql_write_merged_cache)"

  # Diagnostics on demand (same convention as tm-tab): `touch
  # ~/.cache/quick-launch/debug` and every menu run appends one line to
  # debug.log beside it. The line answers the questions a misbehaving picker
  # raises — did it draw at all (ms), how many rows did it have (a single row
  # makes fzf's --select-1 accept without drawing), what did it return, and
  # was there a tty. Off by default, one `[[ -e ]]` when it is.
  # QUICK_LAUNCH_CACHE is a spec seam: the user zshenv re-exports the XDG
  # vars, so an XDG_CACHE_HOME override dies at zsh startup (the gotcha
  # tm-tab documents for TM_TAB_*).
  local _dbg_dir="${QUICK_LAUNCH_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/quick-launch}"
  local _dbg=0 _t0=0
  if [[ -e "$_dbg_dir/debug" ]]; then
    # EPOCHREALTIME lives in zsh/datetime, which nothing here loads otherwise.
    zmodload -F zsh/datetime +p:EPOCHREALTIME 2>/dev/null
    _dbg=1 _t0=$EPOCHREALTIME
  fi

  local _rc=0
  chosen="$(QUICK_LAUNCH_TARGETS="$targets" "$SCRIPT_DIR/quick-launch-pick" "$kind" "${pick_flags[@]}")" || _rc=$?
  if (( _dbg )); then
    printf '%s kind=%s rc=%d ms=%.0f rows=%s tty=%s chosen=%s\n' \
      "$(date +%T)" "$kind" "$_rc" "$(( (EPOCHREALTIME - _t0) * 1000 ))" \
      "$(wc -l < "$_dbg_dir/lines-$kind.txt" 2>/dev/null | tr -d ' ' || echo '?')" \
      "$([[ -t 0 ]] && echo yes || echo no)" "${chosen:-<none>}" \
      >> "$_dbg_dir/debug.log" 2>/dev/null
  fi
  (( _rc )) && return 0
  [[ -n "$chosen" ]] || return 0
  # Alt+Enter in the workspace picker emits "@window:<id>" (field 2) to request
  # opening the workspace in a separate OS window instead of switching the
  # current client; plain Enter emits the bare id and switches as usual.
  if [[ "$chosen" == @window:* ]]; then
    ql_dispatch_window "${chosen#@window:}"
    return
  fi
  ql_dispatch "$kind" "$chosen"
}

ql_print_layout() {
  local kind="$1" id="$2" el
  el="$(ql_get_element "$kind" "$id")" || true
  [[ -n "$el" ]] || ql_die "no $kind target with id '$id'"
  case "$kind" in
    tab) ql_build_tab_layout "$el" ;;
    workspace) ql_build_workspace_layout "$el" ;;
    pane)
      ql_action_command "$(jq -c '.action // {}' <<<"$el")"
      echo
      ;;
    *) ql_die "unknown kind '$kind'" ;;
  esac
}

ql_list() {
  local kind="${1:-}"
  local kinds=("$kind")
  [[ -z "$kind" ]] && kinds=(workspace tab pane)
  local k key
  for k in "${kinds[@]}"; do
    case "$k" in
      pane) key="panes" ;;
      tab) key="tabs" ;;
      workspace) key="workspaces" ;;
      *) ql_die "unknown kind '$k'" ;;
    esac
    jq -r --arg k "$key" --arg label "$k" '
      .[$k][]? | "\($label)\t\(.id)\t\(.action.label // .name // .id)"
    ' <<<"$QL_JSON"
  done | column -t -s$'\t' 2>/dev/null || true
}

usage() {
  sed -n '2,20p' "$_src" | sed 's/^# \{0,1\}//'
}

main() {
  # --no-border is a borderless-render hint for the picker (menu only). The
  # quick-launch-zellij adapter execs `quick-launch --no-border menu <kind>`,
  # so it arrives ahead of the subcommand; accept it anywhere on the line and
  # strip it out before dispatch (harmless for the other, picker-less
  # subcommands, which never draw a border).
  local no_border=0
  local -a args=()
  local a
  for a in "$@"; do
    if [[ "$a" == --no-border ]]; then no_border=1; else args+=("$a"); fi
  done
  set -- "${args[@]}"

  if [[ $# -eq 0 ]]; then
    usage
    exit 2
  fi
  local cmd="$1"
  shift || true
  case "$cmd" in
    menu)
      [[ $# -ge 1 ]] || ql_die "usage: quick-launch menu pane|tab|workspace"
      ql_load
      ql_menu "$1" "$no_border"
      ;;
    open)
      [[ $# -ge 2 ]] || ql_die "usage: quick-launch open pane|tab|workspace ID"
      ql_load
      ql_dispatch "$1" "$2"
      ;;
    layout)
      [[ $# -ge 2 ]] || ql_die "usage: quick-launch layout pane|tab|workspace ID"
      ql_load
      ql_print_layout "$1" "$2"
      ;;
    list)
      ql_load
      ql_list "${1:-}"
      ;;
    -h | --help | help)
      usage
      ;;
    *)
      ql_die "unknown command '$cmd' (want menu|open|layout|list)"
      ;;
  esac
}

main "$@"
