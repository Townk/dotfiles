#!/usr/bin/env zsh
# mux-modal — backend-neutral entry point for the floating-modal scaffolding
# (mux migration Phase 2, spec §2/§3: `mux::modal`'s script-plane face).
#
# Dispatches on the runtime mux:
#   zellij → exec zellij-modal (args passthrough — identical interface)
#   tmux   → wrap the modal in `display-popup -E` running tmux-modal inside.
#
# Usage (superset of zellij-modal):
#   mux-modal [--width W] [--height H] [--title TEXT] [--borderless]
#             [--inject | --capture FILE] [--no-chrome] [--no-discover]
#             -- CMD [ARGS...]
#
#   --width/--height  Popup geometry (percent or cells). On zellij these are
#                     IGNORED — the zellij pane geometry belongs to the
#                     spawner (`zellij action new-pane`/keybind Run block),
#                     matching how zellij-modal is always launched today.
#   --borderless      tmux only: `display-popup -B` — the target draws its
#                     OWN frame (its own titled box, e.g. troupe's dashboard
#                     or an ask/--no-chrome widget), so the popup itself
#                     must draw none, mirroring mux.zsh's own
#                     _mux_tx_float --borderless precedent (stacking both
#                     is a double-border, caught live in Mode B for that
#                     widget float). Silently dropped on zellij — its
#                     floating panes have no equivalent border toggle
#                     through this scaffolding.
#   --no-discover     zellij-only flag, passed through; a no-op on tmux
#                     (origin is $TMUX_PANE, no discovery to skip — D7).
#
# Env overrides: MUX_TMUX_BIN (tests).

set -euo pipefail

width="70%"
height="60%"
borderless=0
typeset -a fwd=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --width) width="${2-}"; shift 2 ;;
    --width=*) width="${1#*=}"; shift ;;
    --height) height="${2-}"; shift 2 ;;
    --height=*) height="${1#*=}"; shift ;;
    --borderless) borderless=1; shift ;;
    --) fwd+=("$@"); break ;;
    *) fwd+=("$1"); shift ;;
  esac
done

if [[ -n "${ZELLIJ:-}" ]]; then
  # --borderless has no zellij-modal equivalent (consumed above, never
  # forwarded) and --no-discover is already zellij-modal vocabulary —
  # strip nothing else.
  exec "$HOME/.config/zellij/scripts/zellij-modal" "${fwd[@]}"
fi

[[ -n "${TMUX:-}" ]] || {
  echo "mux-modal: no multiplexer session detected" >&2
  exit 1
}

TMUX_BIN="${MUX_TMUX_BIN:-tmux}"
# tmux side: --no-discover is meaningless (origin comes in as $TMUX_PANE /
# --origin); drop it before handing to tmux-modal.
typeset -a targs=()
for a in "${fwd[@]}"; do
  [[ "$a" == "--no-discover" ]] && continue
  targs+=("$a")
done

typeset -a popup_flags=(-E -w "$width" -h "$height")
((borderless)) && popup_flags+=(-B)

# COLORTERM: display-popup children inherit the server env, which may lack
# it — carry truecolor through explicitly (same gotcha as the zellij float
# path; gum/lipgloss fall back to 256-color without it).
exec "$TMUX_BIN" display-popup "${popup_flags[@]}" \
  -e "COLORTERM=${COLORTERM:-truecolor}" -e "TMUX_PANE=${TMUX_PANE:-}" \
  "$HOME/.config/mux/scripts/tmux-modal" --origin "${TMUX_PANE:-}" "${targs[@]}"
