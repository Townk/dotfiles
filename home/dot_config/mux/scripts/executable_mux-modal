#!/usr/bin/env zsh
# mux-modal — backend-neutral entry point for the floating-modal scaffolding
# (mux migration Phase 2, spec §2/§3: `mux::modal`'s script-plane face).
#
# Dispatches on the runtime mux:
#   tmux   → wrap the modal in `display-popup -E` running tmux-modal inside.
#   rex    → a floating layer running rex-modal; returns when it closes.
#
# Usage:
#   mux-modal [--width W] [--height H] [--title TEXT] [--borderless]
#             [--inject | --capture FILE] [--no-chrome] [--no-discover]
#             -- CMD [ARGS...]
#
#   --width/--height  Popup geometry (percent or cells).
#   --borderless      tmux only: `display-popup -B` — the target draws its
#                     OWN frame (its own titled box, e.g. troupe's dashboard
#                     or an ask/--no-chrome widget), so the popup itself
#                     must draw none, mirroring mux.zsh's own
#                     _mux_tx_float --borderless precedent (stacking both
#                     is a double-border, caught live in Mode B for that
#                     widget float).
#   --no-discover     accepted and ignored — a leftover of the removed
#                     zellij modal that callers still pass (the origin is
#                     $TMUX_PANE / $REX_BLOCK, no discovery to skip — D7).
#
# Env overrides: MUX_TMUX_BIN (tests).

set -euo pipefail

width="70%"
height="60%"
borderless=0
typeset -a fwd=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --width) width="${2-}"; shift 2 ;;
    --width=*) width="${1#*=}"; shift ;;
    --height) height="${2-}"; shift 2 ;;
    --height=*) height="${1#*=}"; shift ;;
    --borderless) borderless=1; shift ;;
    --) fwd+=("$@"); break ;;
    *) fwd+=("$1"); shift ;;
  esac
done

# The cheap half of the shim (function definitions, a few ms): it owns the
# "which multiplexer is this" test and everything the Rex arm calls.
source "${MUX_LIB:-$HOME/.local/lib}/mux-bootstrap.zsh"

if mux::in_rex; then
  # Rex: a floating layer running rex-modal, over the calling block and in
  # its directory. `display-popup -E` blocks until the popup closes and so
  # must this: a layer is created and returns at once, so wait for its block
  # to go away. --borderless is the layer's only form and --no-discover is
  # dropped; rex-modal takes the rest as it is.
  typeset -a rargs=()
  title="" capture=""
  i=1
  while (( i <= ${#fwd} )); do
    a="${fwd[i]}"
    case "$a" in
      --) rargs+=("${(@)fwd[i,-1]}"); break ;;
      --no-discover) ;;
      --title) title="${fwd[i+1]-}"; rargs+=("$a") ;;
      --title=*) title="${a#*=}"; rargs+=("$a") ;;
      --capture) capture="${fwd[i+1]-}"; rargs+=("$a") ;;
      --capture=*) capture="${a#*=}"; rargs+=("$a") ;;
      *) rargs+=("$a") ;;
    esac
    (( i += 1 ))
  done

  block=""
  trap '_mux_rx_close_block "$block"' INT TERM
  # The shim's one launcher of a rex-modal layer: our block, our directory,
  # and the row count of a height given in cells.
  block="$(_mux_rx_modal_layer "$width" "$height" "$title" -- "${rargs[@]}")" || block=""
  [[ -n "$block" ]] || {
    echo "mux-modal: could not open a floating layer" >&2
    exit 1
  }

  # Until the layer is gone, or the server has gone quiet for a run of
  # polls ($MUX_MODAL_REX_MISSES, default 25, about 5 s): the shim's bounded
  # wait.
  _mux_rx_wait_block_gone "$block" "${MUX_MODAL_REX_MISSES:-25}" || :

  # A layer closed by hand never answers. A caller still reading the capture
  # FIFO would wait forever, so give it its end of file: a non-blocking open
  # succeeds only while someone is reading, and the answer, when there was
  # one, has been read by now.
  if [[ -n "$capture" && -p "$capture" ]]; then
    zmodload zsh/system 2>/dev/null || true
    if sysopen -w -o nonblock -u fd "$capture" 2>/dev/null; then exec {fd}>&-; fi
  fi
  exit 0
fi

[[ -n "${TMUX:-}" ]] || {
  echo "mux-modal: no multiplexer session detected" >&2
  exit 1
}

TMUX_BIN="${MUX_TMUX_BIN:-tmux}"
# tmux side: --no-discover is meaningless (origin comes in as $TMUX_PANE /
# --origin); drop it before handing to tmux-modal.
typeset -a targs=()
for a in "${fwd[@]}"; do
  [[ "$a" == "--no-discover" ]] && continue
  targs+=("$a")
done

typeset -a popup_flags=(-E -w "$width" -h "$height")
((borderless)) && popup_flags+=(-B)

# COLORTERM: display-popup children inherit the server env, which may lack
# it — carry truecolor through explicitly (same gotcha as the zellij float
# path; gum/lipgloss fall back to 256-color without it).
exec "$TMUX_BIN" display-popup "${popup_flags[@]}" \
  -e "COLORTERM=${COLORTERM:-truecolor}" -e "TMUX_PANE=${TMUX_PANE:-}" \
  "$HOME/.config/mux/scripts/tmux-modal" --origin "${TMUX_PANE:-}" "${targs[@]}"
