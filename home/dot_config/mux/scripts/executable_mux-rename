#!/usr/bin/env zsh
# mux-rename <window|pane|session> — the rename dialog for the tmux backend.
#
#   mux-rename --launch <kind>   anchor + reopen inside display-popup (the
#                                run-shell -b path; a foreground popup
#                                deadlocks — ledger row)
#   mux-rename <kind>            the dialog body (inside the popup)
#
# zj-hud's `role "rename"` (src/rename/mod.rs) and its search role draw the
# SAME compact dialog with a different accent, glyph and payload, so this
# owns none of that: lib/mux/dialog.zsh draws the frame and the field, and
# what is left here is the rename itself — read the current name, apply the
# answer, carry the mode pill.
#
# The Zellij backend keeps the plugin's own dialog; this is tmux-only.

set -euo pipefail

TMUX_BIN="${MUX_TMUX_BIN:-tmux}"
source "${MUX_LIB:-$HOME/.local/lib}/mux/dialog.zsh"

if [[ "${1:-}" == --launch ]]; then
  mux_dialog::launch "${0:A}" "${2:-window}"
  exit 0
fi

kind="${1:-window}"
case "$kind" in
  window | pane | session) ;;
  *)
    echo "mux-rename: expected 'window' or 'pane'" >&2
    exit 2
    ;;
esac

[[ -n "${TMUX:-}" ]] || {
  echo "mux-rename: tmux only (zellij uses the zj-hud rename role)" >&2
  exit 1
}

# The pane we came from: a popup owns no pane of its own, so `display -p`
# answers for the client's active pane — the one whose window we rename.
origin="$("$TMUX_BIN" display -p '#{pane_id}' 2>/dev/null)" || origin=""
[[ -n "$origin" ]] || exit 0
typeset -a taddr=(-t "$origin")

# Rename is a MODE as far as the ribbon is concerned: @renaming carries the
# KIND, and tmux-status-right turns that into the mode pill plus the keys
# this kind actually has. It is deliberately NOT a mode-stack entry — the
# stack's driver owns exactly one popup, and a stackable rename had it
# closing this dialog the moment it opened. Cleared on every exit path, so
# leaving by ESC, Enter or C-c all end the mode the same way.
#
# tmux redraws the status line by itself when the KEY TABLE moves, which is
# how every other mode's pill arrives; an option changing earns no redraw at
# all, so this one asks — otherwise the pill waits for the next
# status-interval tick (10s) and the dialog is on screen without the mode
# showing. The exit path already refreshes for the same reason.
"$TMUX_BIN" set -g @renaming "$kind" 2>/dev/null || true
"$TMUX_BIN" refresh-client -S 2>/dev/null || true
cleanup() {
  "$TMUX_BIN" set -gu @renaming 2>/dev/null || true
  "$TMUX_BIN" refresh-client -S 2>/dev/null || true
}
trap cleanup EXIT
# C-c reaches a popup dialog as SIGINT, not a byte — an uncaught INT would
# skip the EXIT trap and leave the pill lit (ledger row).
TRAPINT() { exit 0 }

case "$kind" in
  window)  current="$("$TMUX_BIN" display -p "${taddr[@]}" '#{window_name}' 2>/dev/null)" || current="" ;;
  pane)    current="$("$TMUX_BIN" display -p "${taddr[@]}" '#{pane_title}' 2>/dev/null)" || current="" ;;
  session) current="$("$TMUX_BIN" display -p "${taddr[@]}" '#{session_name}' 2>/dev/null)" || current="" ;;
esac

# dialog.warning is the plugin's RENAME_RGB; md_rename is its MODE_RENAME.
mux_dialog::init '.extended.dialog.warning' || exit 0
I_RENAME=$'\U000F0455'

buf="$current"

# The field is the NAME and nothing else — the Alt+r affordance is advertised
# by the ribbon's hint pill (tmux-status-right reads @renaming), where the
# other modes put their bindings too. A glyph inside the input would compete
# with the text it sits next to.
draw_field() { mux_dialog::field "$buf" }

apply() {
  [[ -n "$buf" ]] || return 0
  case "$kind" in
    # A renamed window stops following the app's OSC title — that is what a
    # rename means, and tmux enforces it by turning automatic-rename off.
    window) "$TMUX_BIN" rename-window "${taddr[@]}" -- "$buf" 2>/dev/null || true ;;
    pane)   "$TMUX_BIN" select-pane "${taddr[@]}" -T "$buf" 2>/dev/null || true ;;
    # Through the shim: renaming a session has to refresh every attached
    # client, or the ribbon keeps showing the old name until something else
    # redraws it. Sourced HERE so the dialog still opens at popup speed.
    session)
      source "${MUX_LIB:-$HOME/.local/lib}/mux.zsh"
      mux::rename_session "$buf" 2>/dev/null || true
      ;;
  esac
}

# Alt+r — a name you do not have to invent. mux-random-session-name returns an
# unused adjective-noun pair (the same vocabulary zellij named sessions with),
# so the field can be re-rolled until one reads well. Sessions only: a window
# or a pane is named after what is IN it, and a random word would be a lie.
random_name() {
  local bin="${MUX_RANDOM_NAME_BIN:-$HOME/.local/bin/mux-random-session-name}"
  [[ -x "$bin" ]] || return 1
  local name
  name="$("$bin" 2>/dev/null)" || return 1
  [[ -n "$name" ]] || return 1
  print -r -- "$name"
}

print -rn -- $'\e[?25l'
mux_dialog::frame "$I_RENAME"
draw_field

# zsh's `read -k` reads from the TERMINAL (/dev/tty), which inside a popup is
# the keyboard — stdin is NOT: a `cat` in a display-popup receives nothing
# (measured). Reading fd 0 unconditionally therefore made the dialog deaf to
# every key including ESC. So: the terminal when we have one, fd 0 only when
# stdin is a pipe, which is how a spec drives this.
if [[ -t 0 ]]; then
  read_key() { read -rsk1 "$1" }
  read_follow() { read -rsk1 -t 0.02 "$1" }
else
  read_key() { read -rsk1 -u 0 "$1" }
  read_follow() { read -rsk1 -u 0 -t 0.02 "$1" }
fi

while read_key key; do
  case "$key" in
    $'\r' | $'\n') apply; break ;;
    $'\x03') break ;;                 # C-c abandons, as ESC does
    $'\e')
      # ESC alone cancels (house rule: ESC cancels, never Ctrl+C); ESC+char is
      # an Alt chord. The short timeout is what tells them apart — the same
      # discrimination the search dialog makes for its M-c/M-b/M-p toggles.
      follow=""
      read_follow follow || follow=""
      case "$follow" in
        r)
          [[ "$kind" == session ]] || continue
          if rolled="$(random_name)"; then
            buf="$rolled"
            draw_field
          fi
          ;;
        "") break ;;
        *) continue ;;
      esac
      ;;
    $'\x7f' | $'\b') buf="${buf[1,-2]}"; draw_field ;;
    $'\x15') buf=""; draw_field ;;   # C-u clears, as elsewhere
    *)
      # Printable only: a stray control byte would corrupt the field.
      [[ "$key" == [[:print:]] ]] || continue
      buf+="$key"
      draw_field
      ;;
  esac
done
print -rn -- $'\e[?25h'
exit 0
