#!/usr/bin/env zsh
#
# mux-preview-image — show an image in a floating pane/popup (whichever the
# caller's backend floats), then wait for
# a single keypress before exiting (the pane is launched with --close-on-exit,
# so quitting closes it).
#
# Reuses the `preview` script's image handler, which sizes its output from
# FZF_PREVIEW_{COLUMNS,LINES}; we set those to the live pane geometry.

emulate -L zsh
set -u

# NB: don't name this `path` — in zsh that's the array tied to $PATH.
img="${1:-}"
[[ -n "$img" && -e "$img" ]] || exit 0

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# NO -s, NO computed geometry, NO text in the pane. This mirrors the one
# invocation proven to render here — a bare `chafa <img>` in a fresh window
# (Mode B 2026-07-26). With an explicit -s box the same image came back
# blank above ~15 rows, and the sixel canvas does not explain it: bare emits
# 480x480 and renders, -s 130x21 emits a SMALLER 420x420 and does not. Until
# that is understood, the viewer does not second-guess chafa: chafa knows
# the terminal it is drawing to, and --align only centres, leaving the
# canvas identical to bare (measured).
#
# The hint lives in the WINDOW NAME instead of the pane, so nothing but the
# image is ever written here — tmux drops images when their region is
# written again, and the window name costs no pane cells at all.

if [[ -n "${TMUX:-}" ]]; then
  tmux rename-window "${img:t} · any key to close" 2>/dev/null || :
fi

print -n -- $'\e[2J\e[H'

rc=0
if [[ -n "${MUX_PREVIEW_IMAGE_ARGS:-}" ]]; then
  chafa ${=MUX_PREVIEW_IMAGE_ARGS} "$img" || rc=$?
else
  chafa --align center,center "$img" || rc=$?
fi

# NOTHING below this line may write to the pane.
read -k1 -s || :
exit $rc
