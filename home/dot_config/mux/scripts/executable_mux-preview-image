#!/usr/bin/env zsh
#
# mux-preview-image — show an image in a floating pane/popup (whichever the
# caller's backend floats), then wait for
# a single keypress before exiting (the pane is launched with --close-on-exit,
# so quitting closes it).
#
# Reuses the `preview` script's image handler, which sizes its output from
# FZF_PREVIEW_{COLUMNS,LINES}; we set those to the live pane geometry.

emulate -L zsh
set -u

# NB: don't name this `path` — in zsh that's the array tied to $PATH.
img="${1:-}"
[[ -n "$img" && -e "$img" ]] || exit 0

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# Geometry: the picture gets 75% of the pane's height, centred in what is
# left after the hint row. The slack is the point — chafa emits exactly the
# rows you ask for, and a render that FILLS the pane scrolls it by the time
# the hint lands. tmux holds images in the grid, so a single scrolled row
# drags the whole picture out of it and the pane goes blank (Mode B
# 2026-07-26). Leaving a quarter of the height free means no write in this
# script can ever push the pane, whatever the image's aspect.
#
# Vertical centring is ours (blank rows above); horizontal is chafa's
# (--align center,top). NOT center,center: chafa aligns vertically against
# the DETECTED TERMINAL rather than the -s box, so it pads past the budget —
# 10 requested rows came back as 17.
_cols="$(tput cols 2>/dev/null || echo 80)"
_rows="$(tput lines 2>/dev/null || echo 24)"
# _avail: the rows this script may touch — everything but the hint row and
# one row of slack, so a renderer that emits its own trailing newline (some
# do) still cannot push the pane.
_avail=$(( _rows - 2 ))
_img_h=$(( _avail * 75 / 100 ))
(( _img_h < 3 )) && _img_h=$_avail
(( _img_h < 1 )) && _img_h=1
_pad=$(( (_avail - _img_h) / 2 ))

# ORDER IS LOAD-BEARING: nothing may be written after the image. tmux keeps
# images in the pane's grid and drops them when the region is written again,
# so the hint that used to be placed after the render took the picture with
# it — a bare `chafa <img>` in the same window renders fine, which is what
# isolated this (Mode B 2026-07-26). So: clear, paint the hint on the last
# row, park the cursor at the image's first row, and let the render be the
# LAST thing this script emits before it blocks on the key.
print -n -- $'\e[2J\e[H'
print -n -- "\e[${_rows};1H"
print -n -- $'\e[2mpress any key to close\e[0m'
print -n -- "\e[$(( _pad + 1 ));1H"

# chafa DIRECTLY, not through `preview` (Mode B 2026-07-26). preview pins
# the tier for the mux — `-f sixel --passthrough none` so tmux ingests the
# DCS natively instead of handing WezTerm an overlay — and under that tier
# the pane came up blank while a bare `chafa <img>` in the same window
# rendered fine. Bare chafa auto-detects (its default --passthrough auto),
# which is the invocation proven to work here. $MUX_PREVIEW_IMAGE_ARGS
# overrides the argument list for experiments.
rc=0
if [[ -n "${MUX_PREVIEW_IMAGE_ARGS:-}" ]]; then
  chafa ${=MUX_PREVIEW_IMAGE_ARGS} --align center,top \
    -s "${_cols}x${_img_h}" "$img" || rc=$?
else
  chafa --align center,top -s "${_cols}x${_img_h}" "$img" || rc=$?
fi

# NOTHING below this line may write to the pane.
read -k1 -s || :
exit $rc
