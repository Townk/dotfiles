#!/usr/bin/env zsh
#
# mux-preview-image — show an image in a floating pane/popup (whichever the
# caller's backend floats), then wait for
# a single keypress before exiting (the pane is launched with --close-on-exit,
# so quitting closes it).
#
# Reuses the `preview` script's image handler, which sizes its output from
# FZF_PREVIEW_{COLUMNS,LINES}; we set those to the live pane geometry.

emulate -L zsh
set -u

# NB: don't name this `path` — in zsh that's the array tied to $PATH.
img="${1:-}"
[[ -n "$img" && -e "$img" ]] || exit 0

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# Render at the pane's real size, image only (no metadata), CENTRED — this
# pane exists to show one picture. One row is held back for the hint line
# below: rendering into the full height and then printing scrolls the top row
# off. tput reads the pane's own winsize, which is correct in a real pane
# (a tmux popup reports 80x24 no matter its geometry — another reason images
# live in a pane now).
_cols="$(tput cols 2>/dev/null || echo 80)"
_lines="$(tput lines 2>/dev/null || echo 40)"
(( _lines > 2 )) && _lines=$(( _lines - 1 ))
export FZF_PREVIEW_COLUMNS="$_cols"
export FZF_PREVIEW_LINES="$_lines"
export PREVIEW_IMAGE_ALIGN="center,center"
export PREVIEW_IMAGE_ONLY=1

rc=0
preview "$img" || rc=$?

print -n -- $'\n\e[2mpress any key to close\e[0m'
# The dismissal read's status is NOT the script's result — the render
# already happened above. On tmux the popup runs under `display-popup -E`,
# whose exit status IS the command's, and a non-zero one paints
# "'…' returned N" over the session. Exit on the render's verdict instead.
read -k1 -s || :
exit $rc
