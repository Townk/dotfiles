#!/usr/bin/env zsh
#
# mux-preview-image — show an image in a floating pane/popup (whichever the
# caller's backend floats), then wait for
# a single keypress before exiting (the pane is launched with --close-on-exit,
# so quitting closes it).
#
# Reuses the `preview` script's image handler, which sizes its output from
# FZF_PREVIEW_{COLUMNS,LINES}; we set those to the live pane geometry.

emulate -L zsh
set -u

# NB: don't name this `path` — in zsh that's the array tied to $PATH.
img="${1:-}"
[[ -n "$img" && -e "$img" ]] || exit 0

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# NO -s, NO computed geometry, NO text in the pane. This mirrors the one
# invocation proven to render here — a bare `chafa <img>` in a fresh window
# (Mode B 2026-07-26). With an explicit -s box the same image came back
# blank above ~15 rows, and the sixel canvas does not explain it: bare emits
# 480x480 and renders, -s 130x21 emits a SMALLER 420x420 and does not. Until
# that is understood, the viewer does not second-guess chafa: chafa knows
# the terminal it is drawing to, and --align only centres, leaving the
# canvas identical to bare (measured).
#
# The hint lives in the WINDOW NAME instead of the pane, so nothing but the
# image is ever written here — tmux drops images when their region is
# written again, and the window name costs no pane cells at all.

if [[ -n "${TMUX:-}" ]]; then
  tmux rename-window "${img:t} · any key to close" 2>/dev/null || :
fi

# Wait for the pane geometry to STOP MOVING before drawing. A window is
# created, then resized as the client settles, and a sixel that lands during
# that window is invalidated with it — which is why the same command renders
# on one run and not the next (Mode B 2026-07-26: a bare chafa that had
# rendered came back blank, unchanged, on a later run). Poll until two reads
# agree, with a short ceiling so a genuinely resizing pane cannot hang this.
_settle() {
  local a b i
  a="$(stty size 2>/dev/null)"
  for i in {1..10}; do
    sleep 0.05
    b="$(stty size 2>/dev/null)"
    [[ "$a" == "$b" ]] && return 0
    a="$b"
  done
}
_settle

print -n -- $'\e[2J\e[H'

# Render to a FILE first, then check its size. tmux ingests a sixel image as
# one DCS string and DISCARDS the whole thing past its input-buffer limit, so
# an image that is merely big renders as a blank pane with no error anywhere.
# Measured in this terminal (Mode B 2026-07-26, captured with pipe-pane): a
# 774KB stream renders, a 2.45MB one does not. Nothing about the IMAGE
# predicts it — 255-colour photos and 13-colour line art land on both sides —
# because chafa renders at the terminal's true cell resolution, so the
# stream size is what varies, not any property of the file.
#
# Shrink by asking for fewer CELLS (chafa scales the pixels with them) until
# the stream fits, then paint it in one write.
# A sixel image is ONE DCS string and tmux discards any string sequence
# larger than its `input-buffer-size` (a SERVER option, default 1 MiB —
# measured: 1,032,961 bytes rendered, 1,174,685 did not). Our tmux.conf
# raises it, so ASK the server rather than hard-coding: the shrink below is
# then a safety net for a machine whose config has not been applied, not a
# quality ceiling. 5% margin covers the clear/cursor bytes around it.
_max="${MUX_PREVIEW_IMAGE_MAX_BYTES:-}"
if [[ -z "$_max" ]]; then
  _max=1000000
  if [[ -n "${TMUX:-}" ]]; then
    _lim="$(tmux show -sv input-buffer-size 2>/dev/null)"
    [[ "$_lim" == <-> ]] && (( _lim > 1000 )) && _max=$(( _lim * 95 / 100 ))
  fi
fi
_out=$(mktemp "${TMPDIR:-/tmp}/muximg.XXXXXX") || exit 1
trap 'rm -f -- "$_out"' EXIT INT TERM HUP

# Breathing room: at least 6 columns each side and 2 rows top and bottom
# ($MUX_PREVIEW_IMAGE_PAD_X / _PAD_Y). The image is bounded by -s and centred
# by chafa, so the padding is the remainder — never less than these, more
# when the aspect ratio leaves slack.
#
# --view-size is one row SHORTER than the pane on purpose: chafa centres
# within the view, and a render that reaches the last row ends with a
# newline that scrolls the pane — which drags a sixel out of tmux's grid.
_padx="${MUX_PREVIEW_IMAGE_PAD_X:-6}"
_pady="${MUX_PREVIEW_IMAGE_PAD_Y:-2}"
_cols="$(tput cols 2>/dev/null || echo 80)"
_rows="$(tput lines 2>/dev/null || echo 24)"
_box_w=$(( _cols - 2 * _padx )); (( _box_w < 8 )) && _box_w=$(( _cols > 8 ? _cols : 8 ))
_box_h=$(( _rows - 2 * _pady )); (( _box_h < 4 )) && _box_h=$(( _rows > 4 ? _rows : 4 ))
_view_h=$(( _rows > 1 ? _rows - 1 : _rows ))

_render() {  # _render [scale-percent]
  local pct="${1:-100}"
  local w=$(( _box_w * pct / 100 )) h=$(( _box_h * pct / 100 ))
  (( w < 8 )) && w=8
  (( h < 4 )) && h=4
  if [[ -n "${MUX_PREVIEW_IMAGE_ARGS:-}" ]]; then
    chafa ${=MUX_PREVIEW_IMAGE_ARGS} --view-size "${_cols}x${_view_h}" \
      --align center,center -s "${w}x${h}" "$img" >"$_out" 2>/dev/null
  else
    chafa --view-size "${_cols}x${_view_h}" --align center,center \
      -s "${w}x${h}" "$img" >"$_out" 2>/dev/null
  fi
}
# zstat needs its module loaded; wc is one fork and always there.
_size() { wc -c < "$_out" 2>/dev/null | tr -d " " || print 0 }

rc=0
_render || rc=$?
if (( $(_size) > _max )); then
  for _pct in 70 50 35 25; do
    _render "$_pct" || rc=$?
    (( $(_size) <= _max )) && break
  done
fi

cat -- "$_out"

# NOTHING below this line may write to the pane.
read -k1 -s || :
exit $rc
