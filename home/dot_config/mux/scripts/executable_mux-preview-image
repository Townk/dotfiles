#!/usr/bin/env zsh
#
# mux-preview-image — show an image in a floating pane/popup (whichever the
# caller's backend floats), then wait for
# a single keypress before exiting (the pane is launched with --close-on-exit,
# so quitting closes it).
#
# Reuses the `preview` script's image handler, which sizes its output from
# FZF_PREVIEW_{COLUMNS,LINES}; we set those to the live pane geometry.

emulate -L zsh
set -u

# NB: don't name this `path` — in zsh that's the array tied to $PATH.
img="${1:-}"
[[ -n "$img" && -e "$img" ]] || exit 0

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# NO -s, NO computed geometry, NO text in the pane. This mirrors the one
# invocation proven to render here — a bare `chafa <img>` in a fresh window
# (Mode B 2026-07-26). With an explicit -s box the same image came back
# blank above ~15 rows, and the sixel canvas does not explain it: bare emits
# 480x480 and renders, -s 130x21 emits a SMALLER 420x420 and does not. Until
# that is understood, the viewer does not second-guess chafa: chafa knows
# the terminal it is drawing to, and --align only centres, leaving the
# canvas identical to bare (measured).
#
# The hint lives in the WINDOW NAME instead of the pane, so nothing but the
# image is ever written here — tmux drops images when their region is
# written again, and the window name costs no pane cells at all.

if [[ -n "${TMUX:-}" ]]; then
  tmux rename-window "${img:t} · any key to close" 2>/dev/null || :
fi

# Wait for the pane geometry to STOP MOVING before drawing. A window is
# created, then resized as the client settles, and a sixel that lands during
# that window is invalidated with it — which is why the same command renders
# on one run and not the next (Mode B 2026-07-26: a bare chafa that had
# rendered came back blank, unchanged, on a later run). Poll until two reads
# agree, with a short ceiling so a genuinely resizing pane cannot hang this.
_settle() {
  local a b i
  a="$(stty size 2>/dev/null)"
  for i in {1..10}; do
    sleep 0.05
    b="$(stty size 2>/dev/null)"
    [[ "$a" == "$b" ]] && return 0
    a="$b"
  done
}
_settle

print -n -- $'\e[2J\e[H'

# One row down before handing over. chafa centres vertically inside a view
# ONE ROW SHORTER than the pane (it keeps the last row clear), so its own
# maths always lands the picture a row high: a 29-row image in a 33-row pane
# came out 1 above and 3 below. The offset is structural — every height gives
# top = bottom - 1 — so a single newline squares it up (Mode B 2026-07-26).
print ""

# Render to a FILE first, then check its size. tmux ingests a sixel image as
# one DCS string and DISCARDS the whole thing past its input-buffer limit, so
# an image that is merely big renders as a blank pane with no error anywhere.
# Measured in this terminal (Mode B 2026-07-26, captured with pipe-pane): a
# 774KB stream renders, a 2.45MB one does not. Nothing about the IMAGE
# predicts it — 255-colour photos and 13-colour line art land on both sides —
# because chafa renders at the terminal's true cell resolution, so the
# stream size is what varies, not any property of the file.
#
# Shrink by asking for fewer CELLS (chafa scales the pixels with them) until
# the stream fits, then paint it in one write.
# A sixel image is ONE DCS string and tmux discards any string sequence
# larger than its `input-buffer-size` (a SERVER option, default 1 MiB —
# measured: 1,032,961 bytes rendered, 1,174,685 did not). Our tmux.conf
# raises it, so ASK the server rather than hard-coding: the shrink below is
# then a safety net for a machine whose config has not been applied, not a
# quality ceiling. 5% margin covers the clear/cursor bytes around it.
_max="${MUX_PREVIEW_IMAGE_MAX_BYTES:-}"
if [[ -z "$_max" ]]; then
  _max=1000000
  if [[ -n "${TMUX:-}" ]]; then
    _lim="$(tmux show -sv input-buffer-size 2>/dev/null)"
    [[ "$_lim" == <-> ]] && (( _lim > 1000 )) && _max=$(( _lim * 95 / 100 ))
  fi
fi
_out=$(mktemp "${TMPDIR:-/tmp}/muximg.XXXXXX") || exit 1
trap 'rm -f -- "$_out"' EXIT INT TERM HUP

# Breathing room: BOUND the image, then let chafa centre it in the real
# terminal. The padding is the remainder, symmetric by construction.
#
# Neither of the obvious alternatives works. chafa's --margin-* reserve the
# RIGHT and BOTTOM only. And printing our own left padding before handing
# over is cancelled the moment chafa centres vertically: it does that with
# NEWLINES, and every newline resets the column to 1 — which is why a
# width-constrained image (nothing to centre horizontally) came out flush
# left while square ones looked fine (Mode B 2026-07-26).
#
# --view-size is deliberately absent too: it made chafa centre inside a box
# that was not the pane, so the picture sat off-centre AND smaller.
_padx="${MUX_PREVIEW_IMAGE_PAD_X:-6}"
_pady="${MUX_PREVIEW_IMAGE_PAD_Y:-2}"
# Ask TMUX for the pane size, not the tty. In a window created by mux-open —
# spawned from WezTerm's environment rather than by a client — the pane's
# winsize is still 80x24 when the command starts, so `tput` bounded every
# image to a 68x20 box in a 130x33 window: ~40% small, on every render
# (Mode B 2026-07-26, caught by the debug log). tmux knows the real size
# immediately; tput is the fallback outside a mux.
_cols="" _rows=""
if [[ -n "${TMUX:-}" ]]; then
  _geo="$(tmux display -p -t "${TMUX_PANE:-}" '#{pane_width} #{pane_height}' 2>/dev/null)"
  [[ "$_geo" == <->" "<-> ]] && { _cols="${_geo%% *}"; _rows="${_geo##* }" }
fi
[[ -n "$_cols" ]] || _cols="$(tput cols 2>/dev/null || echo 80)"
[[ -n "$_rows" ]] || _rows="$(tput lines 2>/dev/null || echo 24)"
# The frame owns 4 rows top (border, blank, header, blank) and 4 bottom
# (blank, footer, blank, border), plus a column of border either side on top
# of the padding.
_chrome_v=8
_box_w=$(( _cols - 2 * _padx )); (( _box_w < 8 )) && _box_w=8
_box_h=$(( _rows - _chrome_v )); (( _box_h < 4 )) && _box_h=4

_render() {  # _render [percent-of-box] — the percent is only the shrink path
  local pct="${1:-100}"
  local w=$(( _box_w * pct / 100 )) h=$(( _box_h * pct / 100 ))
  (( w < 8 )) && w=8
  (( h < 4 )) && h=4
  if [[ -n "${MUX_PREVIEW_IMAGE_ARGS:-}" ]]; then
    chafa ${=MUX_PREVIEW_IMAGE_ARGS} --align center,center -s "${w}x${h}" \
      "$img" >"$_out" 2>/dev/null
  else
    chafa --align center,center -s "${w}x${h}" "$img" >"$_out" 2>/dev/null
  fi
}

_size() { wc -c < "$_out" 2>/dev/null | tr -d " " || print 0 }

# Diagnostics on demand, the tm-tab convention: `touch
# $XDG_STATE_HOME/mux-preview-image.debug` and every render appends what it
# decided — geometry, stream size, the cap, and whether it shrank.
_dbg="${XDG_STATE_HOME:-$HOME/.local/state}/mux-preview-image"
_log() { [[ -e "$_dbg.debug" ]] && print -r -- "$(date +%T) $*" >> "$_dbg.log" 2>/dev/null || : }

rc=0
_render || rc=$?
_log "img=${img:t} pane=${_cols}x${_rows} box=${_box_w}x${_box_h} bytes=$(_size) max=$_max"
if (( $(_size) > _max )); then
  _log "  SHRINKING: $(_size) > $_max"
  # Only when the stream would overrun tmux's input-buffer-size (rare now
  # that tmux.conf raises it): bound the cells until it fits.
  for _pct in 70 50 35 25; do
    _render "$_pct" || rc=$?
    _log "  retry ${_pct}% -> $(_size) bytes"
    (( $(_size) <= _max )) && break
  done
fi

cat -- "$_out"

# Chrome LAST, positioned absolutely. It has to come after the image because
# chafa centres horizontally with leading SPACES, which paint over whatever
# is under them — including the left border. Absolute addressing (no
# newlines) means nothing scrolls, which is what drags a sixel out of tmux's
# grid. The frame never writes into the image's own cells.
source "$HOME/.local/lib/theme-common.zsh" 2>/dev/null || :
_fg() { theme::sgr_fg "$1" 2>/dev/null || : }
_c_name="$(_fg "${C_HEX_MAUVE:-}")"
_c_size="$(_fg "${C_HEX_GREEN:-}")"
_c_dims="$(_fg "${C_HEX_YELLOW:-}")"
_c_hint="$(_fg "${C_HEX_OVERLAY0:-}")"
_rst="${C_RES:-$'\e[0m'}"

# file size, humanised
_bytes=$(stat -f%z "$img" 2>/dev/null || stat -c%s "$img" 2>/dev/null || wc -c <"$img" 2>/dev/null | tr -d ' ')
if [[ "$_bytes" == <-> ]] && (( _bytes >= 1048576 )); then
  _hsize="$(( _bytes / 104858 ))"; _hsize="${_hsize%?}.${_hsize: -1}MB"
elif [[ "$_bytes" == <-> ]]; then
  _hsize="$(( (_bytes + 1023) / 1024 ))KB"
else
  _hsize=""
fi
# pixel dimensions, when a tool can tell us
_dims="$(sips -g pixelWidth -g pixelHeight "$img" 2>/dev/null |
  awk '/pixelWidth/{w=$2} /pixelHeight/{h=$2} END{ if (w && h) print w"x"h }')"
[[ -n "$_dims" ]] || _dims="$(magick identify -format '%wx%h' "$img" 2>/dev/null)" || _dims=""

{
  # header on the second row: name left, size + dimensions right
  local _right="" _rlen=0
  [[ -n "$_hsize" ]] && { _right="${_c_size}${_hsize}${_rst}"; _rlen=${#_hsize} }
  [[ -n "$_dims" ]] && { _right="$_right ${_c_dims}(${_dims})${_rst}"; _rlen=$(( _rlen + ${#_dims} + 3 )) }
  printf '\e[2;%dH%s󰋩 %s%s' "$_padx" "$_c_name" "${img:t}" "$_rst"
  (( _rlen )) && printf '\e[2;%dH%s' "$(( _cols - _padx - _rlen + 1 ))" "$_right"

  # hint, centred, two rows off the bottom
  local _hint="Press any key to dismiss"
  printf '\e[%d;%dH%s%s%s' "$(( _rows - 2 ))" "$(( (_cols - ${#_hint}) / 2 + 1 ))" "$_c_hint" "$_hint" "$_rst"

  # keep the cursor hidden — chafa turns it back on at the end of its stream
  printf '\e[?25l'
}

# NOTHING below this line may write to the pane.
read -k1 -s || :
printf '\e[?25h'   # the pane is going away, but leave the cursor as we found it
exit $rc
