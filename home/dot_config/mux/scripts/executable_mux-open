#!/usr/bin/env zsh
# mux-open — open a clicked file:// link inside the right mux session.
#
# Invoked by WezTerm's `open-uri` handler (see ~/.config/wezterm/wezterm.lua)
# as:  mux-open <client_pid> <uri> [cols] [rows]
#
# <client_pid> is the foreground process of the clicked WezTerm pane (the
# mux client — zellij or tmux). The backend is read from that PROCESS and
# pinned via $MUX_BACKEND, because this script runs in WezTerm's GUI
# environment where $ZELLIJ/$TMUX say nothing. Then:
#   - directory  -> new tab running Yazi at that dir
#   - image      -> floating popup running our preview wrapper
#   - text/code  -> new tab running nvim (CWD = git root, else the file's dir)
#   - anything else (binary, etc.) -> ignored
# Tabs/popups close on exit, so they vanish when the program quits.
#
# Runs from WezTerm's GUI environment, so it sets a sane PATH up front (lsof,
# ps, file, git, zellij, tmux, nvim, yazi may otherwise be missing).
set -uo pipefail
# User-managed tools must precede the fixed GUI-safe fallback paths. On the dev
# shell fzf and tmux come from mise; hiding fzf aborted while sourcing mux.zsh,
# and selecting the older system tmux made its newer server exit the request.
export PATH="${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims:$HOME/.local/bin${PATH:+:$PATH}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

pid="${1:-}"
uri="${2:-}"
# Full display size (the clicked WezTerm pane), used to size the image
# float in absolute cells. 0 when unknown -> percentage fallback below.
term_cols="${3:-0}"
term_rows="${4:-0}"
# The pid is only ever used to derive the backend and the session. A caller
# that already knows both — tmux's own ⌥+click binding, which runs inside the
# server — passes them in the environment and a placeholder pid. It cannot
# supply a useful one: backend_for_pid expects the mux CLIENT process (what
# WezTerm hands us), and a pane's shell answers "none" (measured), because its
# parent is the server rather than a client.
[ -n "${MUX_BACKEND:-}" ] && [ -n "${MUX_SESSION:-}" ] && pid="${pid:-0}"
[ -n "$pid" ] && [ -n "$uri" ] || {
  echo "usage: mux-open <pid> <uri> [cols] [rows]" >&2
  echo "       (or MUX_BACKEND=… MUX_SESSION=… mux-open 0 <uri> …)" >&2
  exit 2
}

# Anything that is not a local file is somebody else's job — hand it to the
# system opener (browser, mail client). WezTerm reaches this script only for
# file:// because its Lua handler filters first; tmux's binding does not
# filter, and once Ghostty's own link handling is off (mouse-shift-capture =
# always) this is the ONLY thing that will open an http(s) link there.
# Scheme test is a regex, not a `*://*` glob: `mailto:a@b` is a perfectly good
# URI with no double slash, and a glob that demands one silently drops it.
# A GUI app cold-started while OPTION is held reads that as a request for safe
# mode — Firefox pops "Open in Troubleshoot Mode?" instead of the page. ⌥ IS
# the click modifier, so every ⌥+click on a URL lands in that trap unless the
# key has come up by the time the app starts. (Only the browser path can hit
# this; the file branches below open tabs inside tmux and launch nothing.)
#
# Bounded poll, ~9ms per query: a still-held key costs a few hundred ms of
# nothing, and an absent or wedged Hammerspoon costs at most ~1.4s and then
# opens anyway. Never a hard failure — a slow link beats no link.
_wait_alt_release() {
  command -v hs >/dev/null 2>&1 || { sleep 0.4; return 0 }
  local i
  for i in {1..40}; do
    [[ "$(hs -c 'hs.eventtap.checkKeyboardModifiers().alt' 2>/dev/null)" == true ]] || return 0
    sleep 0.025
  done
  return 0
}

case "$uri" in
  file://*) ;;
  *)
    if [[ "$uri" =~ '^[a-zA-Z][a-zA-Z0-9+.-]*:' ]]; then
      _wait_alt_release
      exec open -- "$uri"
    fi
    exit 0
    ;;
esac

# file://[localhost]/path -> /path, then percent-decode. NB: a file:// URL is
# an RFC 3986 path, not a form-urlencoded query string — a literal `+` is a
# plus, NOT a space (the +→space rule broke note+draft.md). Percent-decode only.
urldecode() {
  local s="$1"
  # `[%]`, NOT a bare `%`: as a substitution PATTERN a bare percent matches an
  # empty position at the end of the string, so the replacement is appended —
  # here that pinned a stray `\x` (an incomplete escape, i.e. a NUL byte) onto
  # every decoded path. Harmless for the tab paths, which travel as argv, but
  # the image popup travels as a tmux COMMAND STRING: tmux truncates it at the
  # NUL, leaving an unterminated quote, and sh exits 2 ("returned 2", Mode B
  # 2026-07-26). Reproduced in the system /bin/zsh too — not a build quirk.
  printf '%b' "${s//[%]/\\x}"
}
# NB: the variable is `target`, NOT `path`. Under zsh `path` is the array tied
# to `$PATH`, so `path=…` would clobber the PATH exported above and break the
# bare `file`/`git`/`basename`/`yazi`/`nvim` lookups below.
target="$(urldecode "${uri#file://}")"
target="${target#localhost}"
[ -e "$target" ] || exit 0

# --- Resolve the client's backend and session ------------------------------
# The shim reads the backend from the client PROCESS (mux::backend_for_pid)
# and every mux::* call below dispatches on the pinned value; the session
# lookup is each backend's own (zellij: the client's unix socket; tmux: ask
# the server). Tracks live session switches and needs no --session in argv.
source "${MUX_LIB:-$HOME/.local/lib}/mux.zsh"

if [ -n "${MUX_BACKEND:-}" ] && [ -n "${MUX_SESSION:-}" ]; then
  # Caller already knows (tmux's ⌥+click binding) — trust it, skip the probes.
  session="$MUX_SESSION"
else
  MUX_BACKEND="$(mux::backend_for_pid "$pid")"
  [ "$MUX_BACKEND" = none ] && exit 0
  session="$(mux::resolve_session "$pid")" || exit 0
fi
export MUX_BACKEND
[ -n "$session" ] || exit 0

name="$(basename -- "$target")"

# --- Directory: Yazi in a new tab -----------------------------------------
if [ -d "$target" ]; then
  # No exec: mux::new_tab is a shell function, not a command.
  mux::new_tab --session "$session" --cwd "$target" --name "$name" \
    -- yazi "$target"
  exit $?
fi

# --- File: viewer or editor ------------------------------------------------
# Anything the raster pipeline can turn into a picture — images, PDFs, office
# and iWork documents, fonts, video frames, cover art — opens in the quick
# view. Asking the pipeline (raster::rasterisable, which answers WITHOUT
# converting) beats keeping a second list of extensions here that would drift
# from the one in the library.
_rlib="$HOME/.local/lib/raster-common.zsh"
[ -r "$_rlib" ] && . "$_rlib"

if command -v raster::rasterisable >/dev/null 2>&1 || (( ${+functions[raster::rasterisable]} )); then
  if raster::rasterisable "$target"; then
    # term-quick-view owns the quick look: the "Quick View" singleton tab on
    # tmux, a float on zellij, the chrome, and the render. It is a command in
    # its own right (fzf's Ctrl+O and yazi's Ctrl+Space use it too).
    # MUX_SESSION, alongside MUX_BACKEND above: we run in WezTerm's GUI
    # environment, so term-quick-view has no $ZELLIJ/$TMUX of its own to
    # target. Zellij REFUSES an untargeted `action new-tab` ("Please specify
    # the session name"), which is why CMD+click never opened the quick view
    # there while the nvim branch below — which passes --session explicitly —
    # always worked. tmux hid the same gap: an untargeted command picks the
    # most-recently-used session, so it worked by luck and would have opened
    # the view in the WRONG session with two of them about.
    MUX_SESSION="$session" term-quick-view "$target"
    exit $?
  fi
fi

# Everything else: text and code go to the editor, real binaries are ignored.
enc=$(file -b --mime-encoding -L "$target" 2>/dev/null)
[ "$enc" = "binary" ] && exit 0
dir="$(dirname -- "$target")"
root="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" || root=""
[ -n "$root" ] || root="$dir"
mux::new_tab --session "$session" --cwd "$root" --name "$name" \
  -- nvim "$target"
exit $?
