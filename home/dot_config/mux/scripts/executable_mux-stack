#!/usr/bin/env zsh
# mux-stack — the mode stack as a command, for tmux key bindings.
# Every binding that changes modes goes through this, so the hidden-panel
# path and the panel path run the SAME logic (spec: one transition API).
#
#   mux-stack push <state> | pop | clear | show | vis 0|1 | sync
emulate -L zsh
setopt no_unset
source "${MUX_LIB_DIR:-$HOME/.local/lib}/mux/stack.zsh"
case "${1:-show}" in
  push)  mux_stack::push "${2:-}" ;;
  pop)   mux_stack::pop ;;
  clear) mux_stack::clear ;;
  vis)   mux_stack::set_visible "${2:-1}" ;;
  sync)  mux_stack::sync ;;
  show)  mux_stack::top && print -r -- "$MS_STATE:$MS_VIS" || print -r -- "(empty)" ;;
esac
exit 0
