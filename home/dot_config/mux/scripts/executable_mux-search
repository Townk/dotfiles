#!/usr/bin/env zsh
# mux-search — the zj-hud visual-search dialog, tmux edition (mux migration
# Phase 4; a D12 Stage-1 slice — faithful port of zj-hud/src/search
# render_field). tmux's command-prompt REPLACES the status line, which would
# hide the Search pill and the mode stack while typing; like zellij, the
# input is a floating dialog instead, anchored bottom-right one row above
# the bar (geometry from the layout's `search {}` block: width 40, margin
# right/bottom 1).
#
#   mux-search --launch   compute anchor from the client size and reopen
#                         itself inside display-popup (run-shell -b path —
#                         a foreground popup would deadlock; ledger row)
#   mux-search            the dialog body (inside the popup)
#
# Chrome: tab-chrome background, left accent bar in the search color, the
# input in an eighth-block box over the dialog mantle, block cursor, and
# the case/word/wrap indicator glyphs at the input's right end. In-dialog
# chords (zellij parity): Alt+c toggles case-sensitive, Alt+b whole-word,
# Alt+p wrap. tmux's search is ERE regex, so the term is regex-escaped;
# whole-word wraps it in [[:<:]]/[[:>:]] and case-INsensitive expands
# alphabetics to character classes (tmux regex search is case-sensitive
# and has no flags). Wrap rides tmux's own per-pane `wrap-search` option —
# with it off, search-again/search-reverse stop at the last match instead
# of coming round the buffer (the chord used to flip only the glyph).
#
# Colors come from the theme JSON projection. As-built: the accent uses
# roles.mode.search (the plugin hardcodes its own blue).
# Test seams: MUX_TMUX_BIN, WIDGETS_THEME_JSON.

emulate -L zsh
setopt no_unset

TMUX_BIN="${MUX_TMUX_BIN:-tmux}"
THEME_JSON="${WIDGETS_THEME_JSON:-$HOME/.config/theme/chezmoi-system.json}"
MUX_STACK="${0:A:h}/mux-stack"

W=40 H=3

# The dialog is one entry on the MODE STACK (Search), pushed by whoever
# opened it — (SearchInput) and (SearchMode) are the same level, which is why
# `/` on a live search reopens rather than pushes. Leaving is a stack
# operation like any other; the stack owns what leaving Search means (tmux
# has no search-cancel, so it exits and re-enters copy-mode and restores the
# viewport). This dialog used to keep a THIRD opinion, @search_parent.
#
# Deferred by a beat, always: we are inside a popup until this process exits,
# and a popup opened over a popup silently mutates the outer one — the panel
# the pop uncovers must not land on top of us.
stack_op() {
  "$TMUX_BIN" run-shell -b -d 0.2 "'$MUX_STACK' $1" 2>/dev/null
}

# Restore the anchored cursor position (@search_apos/ay/ax on the origin
# pane): scroll delta first, then row from top-line, then column.
restore_anchor() {
  local o="$1" pos y x cur
  pos="$("$TMUX_BIN" display -p -t "$o" '#{@search_apos}' 2>/dev/null)"; [[ "$pos" == <-> ]] || pos=0
  y="$("$TMUX_BIN" display -p -t "$o" '#{@search_ay}' 2>/dev/null)";   [[ "$y" == <-> ]] || y=0
  x="$("$TMUX_BIN" display -p -t "$o" '#{@search_ax}' 2>/dev/null)";   [[ "$x" == <-> ]] || x=0
  cur="$("$TMUX_BIN" display -p -t "$o" '#{scroll_position}' 2>/dev/null)"; [[ "$cur" == <-> ]] || cur=0
  if (( cur > pos )); then
    "$TMUX_BIN" send-keys -t "$o" -X -N $(( cur - pos )) scroll-down 2>/dev/null
  elif (( pos > cur )); then
    "$TMUX_BIN" send-keys -t "$o" -X -N $(( pos - cur )) scroll-up 2>/dev/null
  fi
  "$TMUX_BIN" send-keys -t "$o" -X top-line 2>/dev/null
  (( y > 0 )) && "$TMUX_BIN" send-keys -t "$o" -X -N "$y" cursor-down 2>/dev/null
  "$TMUX_BIN" send-keys -t "$o" -X start-of-line 2>/dev/null
  (( x > 0 )) && "$TMUX_BIN" send-keys -t "$o" -X -N "$x" cursor-right 2>/dev/null
  return 0
}

# ---- the SEARCH's own position ---------------------------------------------
# tmux ties "the current match" to the CURSOR: search-again looks from
# wherever the cursor happens to be, so scrolling with j/k silently changes
# which match comes next. The search keeps its own position instead
# (@search_mpos/my/mx) — n/N restore it, search from there, and save where
# they landed. Moving the cursor to READ the buffer no longer moves your
# place in the search; n still goes to the match after the highlighted one.
# n is a key people press repeatedly, so both of these read everything they
# need in ONE round-trip and write in one batched command list.
save_pos() {   # remember where the search is standing (values, or read them)
  local o="$1" r="${2:-}"
  [[ -n "$r" ]] || r="$(pos_key "$o")"
  "$TMUX_BIN" set -p -t "$o" @search_mpos "${r%%:*}" ';' \
              set -p -t "$o" @search_my "${${r#*:}%%:*}" ';' \
              set -p -t "$o" @search_mx "${r##*:}" 2>/dev/null
  return 0
}
restore_pos() {  # …and put the cursor back on it (same walk as restore_anchor)
  local o="$1" r pos y x cur
  r="$("$TMUX_BIN" display -p -t "$o" '#{@search_mpos}|#{@search_my}|#{@search_mx}|#{scroll_position}' 2>/dev/null)"
  pos="${r%%|*}"; r="${r#*|}"
  y="${r%%|*}";   r="${r#*|}"
  x="${r%%|*}";   cur="${r##*|}"
  [[ "$pos" == <-> ]] || return 1
  [[ "$y" == <-> ]] || y=0
  [[ "$x" == <-> ]] || x=0
  [[ "$cur" == <-> ]] || cur=0
  local -a walk
  (( cur > pos )) && walk+=(send-keys -t "$o" -X -N $(( cur - pos )) scroll-down ';')
  (( pos > cur )) && walk+=(send-keys -t "$o" -X -N $(( pos - cur )) scroll-up ';')
  walk+=(send-keys -t "$o" -X top-line ';')
  (( y > 0 )) && walk+=(send-keys -t "$o" -X -N "$y" cursor-down ';')
  walk+=(send-keys -t "$o" -X start-of-line)
  (( x > 0 )) && walk+=(';' send-keys -t "$o" -X -N "$x" cursor-right)
  "$TMUX_BIN" "${walk[@]}" 2>/dev/null
  return 0
}
pos_key() { "$TMUX_BIN" display -p -t "$1" '#{scroll_position}:#{copy_cursor_y}:#{copy_cursor_x}' 2>/dev/null }

# Match 1 is the BOTTOM-most match, so the index of where the search is
# standing = how many matches sit at or below it. tmux has no format for
# this (its whole search vocabulary is count/present/partial/timed_out), so
# it is counted once per re-search over the region below the cursor —
# ~15ms, flat, and nothing moves on screen. Later n/N just add or subtract.
count_index() {  # pane pattern -> REPLY_IDX (1-based, clamped to the count)
  local o="$1" pat="$2" y h scr total n   # NB: not REPLY — build_pattern owns that
  REPLY_IDX=1
  y="$("$TMUX_BIN" display -p -t "$o" '#{copy_cursor_y}' 2>/dev/null)"; [[ "$y" == <-> ]] || return 0
  h="$("$TMUX_BIN" display -p -t "$o" '#{pane_height}' 2>/dev/null)"; [[ "$h" == <-> ]] || return 0
  scr="$("$TMUX_BIN" display -p -t "$o" '#{scroll_position}' 2>/dev/null)"; [[ "$scr" == <-> ]] || scr=0
  total="$("$TMUX_BIN" display -p -t "$o" '#{search_count}' 2>/dev/null)"; [[ "$total" == <-> ]] || total=0
  # -J joins wrapped lines, so a match spanning a wrap counts once, like tmux
  n="$("$TMUX_BIN" capture-pane -p -J -t "$o" -S "$y" -E $(( h - 1 + scr )) 2>/dev/null \
       | grep -cE -- "$pat" 2>/dev/null)" || n=1
  [[ "$n" == <-> ]] && (( n > 0 )) || n=1
  (( total > 0 && n > total )) && n=$total
  REPLY_IDX=$n
  return 0
}
set_index() { "$TMUX_BIN" set -p -t "$1" @search_idx "$2" 2>/dev/null; return 0 }

# tmux paints the match UNDER THE CURSOR as the current one. That is true
# exactly when the cursor is standing on the search's match — after a commit
# or an n/N — and false the moment scrolling drags the cursor across the
# buffer, which is why the scroll keys MUTE the colour (keymap-base). This
# takes the mute off again, so the match you just landed on is the one
# wearing it.
# NB: call this BEFORE the search command. tmux resolves the match styles
# when the SEARCH runs, so unmuting afterwards leaves the new match painted
# with the muted style until something searches again.
show_current_match() {
  "$TMUX_BIN" set -p -t "$1" -u copy-mode-current-match-style 2>/dev/null
  return 0
}

# The wrap INDICATOR and tmux's own per-pane wrap-search are one setting:
# n/N (search-again / search-reverse) read the tmux option, so flipping the
# glyph alone left them wrapping (Mode B).
set_wrap() {  # pane on|off-as-1|0
  "$TMUX_BIN" set -p -t "$1" @search_wrap "$2" 2>/dev/null
  [[ "$2" == 1 ]] && "$TMUX_BIN" set -p -t "$1" wrap-search on 2>/dev/null \
                  || "$TMUX_BIN" set -p -t "$1" wrap-search off 2>/dev/null
  return 0
}

# Build the search regex from a term + flags. tmux search is SMART-CASE
# (all-lowercase patterns match insensitively; any uppercase goes sensitive)
# — so insensitive mode expands alphabetics into character classes, and
# sensitive mode on an all-lowercase term injects a matching-neutral
# uppercase atom ([A]{0}) to trip smart-case (probe-verified; ledger row).
build_pattern() {  # term case_on word_on -> REPLY
  local term="$1" c="$2" w="$3" pat="" ch has_upper=0
  for ch in ${(s::)term}; do
    case "$ch" in
      [\\.\[\]\(\)\*\+\?\{\}\|\^\$]) pat+="\\\\$ch" ;;
      [A-Z]) has_upper=1; pat+="$ch" ;;
      [a-z])
        if [[ "$c" == 1 ]]; then pat+="$ch"
        else pat+="[${ch}${(U)ch}]"
        fi ;;
      *) pat+="$ch" ;;
    esac
  done
  [[ "$w" == 1 ]] && pat="[[:<:]]${pat}[[:>:]]"
  [[ "$c" == 1 && "$has_upper" == 0 ]] && pat+="[A]{0}"
  REPLY="$pat"
}

# (SearchMode) toggle relay: flip a flag, rebuild the pattern from the
# stored term, re-search — bound to M-c/M-b/M-p in copy-mode-vi.
#
# The gate is the MODE STACK. It used to be tmux's `search_present`, which a
# search with NO matches clears — so making a lowercase term case-sensitive
# killed every match AND the chord that would undo it, stranding the user in
# a Search they could not un-filter (Mode B).
if [[ "${1:-}" == --toggle ]]; then
  origin="${3:-}"; [[ -n "$origin" ]] || exit 0
  flag="$2"
  source "${MUX_LIB_DIR:-$HOME/.local/lib}/mux/stack.zsh"
  mux_stack::top 2>/dev/null || exit 0
  [[ "$MS_STATE" == search ]] || exit 0
  cur="$("$TMUX_BIN" display -p -t "$origin" "#{@search_${flag}}" 2>/dev/null)"
  if [[ "$flag" == wrap ]]; then [[ "$cur" == 0 ]] && new=1 || new=0
  else [[ "$cur" == 1 ]] && new=0 || new=1
  fi
  if [[ "$flag" == wrap ]]; then
    set_wrap "$origin" "$new"
  else
    "$TMUX_BIN" set -p -t "$origin" "@search_${flag}" "$new" 2>/dev/null
  fi
  term="$("$TMUX_BIN" display -p -t "$origin" '#{@search_term}' 2>/dev/null)"
  if [[ -n "$term" && "$flag" != wrap ]]; then
    case_on="$("$TMUX_BIN" display -p -t "$origin" '#{@search_case}' 2>/dev/null)"
    word_on="$("$TMUX_BIN" display -p -t "$origin" '#{@search_word}' 2>/dev/null)"
    build_pattern "$term" "$case_on" "$word_on"
    # Back to the original anchor before re-filtering — deterministic, no
    # highlight hop (user-specified semantics).
    show_current_match "$origin"
    restore_anchor "$origin"
    "$TMUX_BIN" send-keys -t "$origin" -X search-backward "$REPLY" 2>/dev/null
    save_pos "$origin"
    count_index "$origin" "$REPLY"; set_index "$origin" "$REPLY_IDX"
  fi
  "$TMUX_BIN" refresh-client -S 2>/dev/null
  exit 0
fi

# n / N. In Search they step the search's own position; anywhere else in
# copy-mode they keep their other job, jumping between shell prompts (tmux
# has ONE copy-mode where zellij has two modes — ledger row).
if [[ "${1:-}" == --next || "${1:-}" == --prev ]]; then
  dir="$1"; origin="${2:-}"; [[ -n "$origin" ]] || exit 0
  source "${MUX_LIB_DIR:-$HOME/.local/lib}/mux/stack.zsh"
  term=""
  mux_stack::top 2>/dev/null && [[ "$MS_STATE" == search ]] && \
    term="$("$TMUX_BIN" display -p -t "$origin" '#{@search_term}' 2>/dev/null)"
  if [[ -z "$term" ]]; then
    # Anchor to the viewport edge first, so the prompts already ON SCREEN are
    # skipped. next-prompt/previous-prompt move the CURSOR and do not scroll
    # while the target mark is still visible, so without this the view sits
    # still for the first few presses and the jump looks broken. Same treatment
    # as the b/f and MEH-b/MEH-f paths — every route to a prompt jump behaves
    # identically.
    if [[ "$dir" == --next ]]; then
      "$TMUX_BIN" send-keys -t "$origin" -X bottom-line 2>/dev/null
      "$TMUX_BIN" send-keys -t "$origin" -X next-prompt 2>/dev/null
    else
      "$TMUX_BIN" send-keys -t "$origin" -X top-line 2>/dev/null
      "$TMUX_BIN" send-keys -t "$origin" -X previous-prompt 2>/dev/null
    fi
    exit 0
  fi
  show_current_match "$origin"      # …before the search, so it paints
  restore_pos "$origin" || save_pos "$origin"
  before="$(pos_key "$origin")"
  [[ "$dir" == --next ]] && "$TMUX_BIN" send-keys -t "$origin" -X search-again 2>/dev/null \
                         || "$TMUX_BIN" send-keys -t "$origin" -X search-reverse 2>/dev/null
  # one trip for where we landed, the old index and the count
  r="$("$TMUX_BIN" display -p -t "$origin" \
       '#{scroll_position}:#{copy_cursor_y}:#{copy_cursor_x}|#{@search_idx}|#{search_count}' 2>/dev/null)"
  after="${r%%|*}"; r="${r#*|}"
  idx="${r%%|*}"; total="${r##*|}"
  [[ "$idx" == <-> ]] || idx=1
  [[ "$total" == <-> ]] || total=0
  if [[ "$before" != "$after" ]] && (( total > 0 )); then
    # n climbs toward older matches, N comes back down; both wrap exactly as
    # tmux's own wrap-search just did
    [[ "$dir" == --next ]] && idx=$(( idx % total + 1 )) || idx=$(( (idx - 2 + total) % total + 1 ))
  fi
  save_pos "$origin" "$after"
  set_index "$origin" "$idx"
  "$TMUX_BIN" refresh-client -S 2>/dev/null
  exit 0
fi

if [[ "${1:-}" == --launch ]]; then
  cw="$("$TMUX_BIN" display -p '#{client_width}')" || exit 0
  ch="$("$TMUX_BIN" display -p '#{client_height}')" || exit 0
  exec "$TMUX_BIN" display-popup -E -B -w "$W" -h "$H" \
    -x $(( cw - W - 1 )) -y $(( ch - 2 )) "${0:A}"
fi

# ---- theme colors ----------------------------------------------------------
c=("${(@f)$(jq -r '
  .extended.tab.bg, .roles.ui.bg, .roles.ui.dialog_bg,
  .extended.dialog.search_accent, .roles.action.attention,
  .roles.ui.border_inactive, .palette.white
' "$THEME_JSON" 2>/dev/null)}") || c=()
(( ${#c} == 7 )) || exit 0
hexfg() { print -rn -- $'\e[38;2;'"$(( 16#${1[2,3]} ));$(( 16#${1[4,5]} ));$(( 16#${1[6,7]} ))m" }
hexbg() { print -rn -- $'\e[48;2;'"$(( 16#${1[2,3]} ));$(( 16#${1[4,5]} ));$(( 16#${1[6,7]} ))m" }
BG="$(hexbg ${c[1]})"        # dialog canvas = tab chrome bg
THEME_BG="$(hexbg ${c[2]})"  # behind the accent bar
INPUT_BG="$(hexbg ${c[3]})"  # input field = dialog mantle
ACCENT_FG="$(hexfg ${c[4]})" ACCENT_BG="$(hexbg ${c[4]})"
WHITE_FG="$(hexfg ${c[7]})"
ON_FG="$(hexfg ${c[5]})" OFF_FG="$(hexfg ${c[6]})"
BOX_FG="$(hexfg ${c[3]})"    # box glyphs = input bg color over canvas
RESET=$'\e[0m'

# ---- geometry (0-indexed cols, mirrors the plugin constants) ---------------
GLYPH_COL=2 INPUT_COL=5 RIGHT_INSET=5 TOGGLE_W=6
input_end=$(( W - RIGHT_INSET ))
area_w=$(( input_end - INPUT_COL + 1 ))
field_w=$(( area_w - TOGGLE_W - 1 ))

I_SEARCH=$'\Uf002' I_CASE=$'\Ueab1' I_WORD=$'\Ueb7e' I_WRAP=$'\U000F0547'

origin="$("$TMUX_BIN" display -p '#{pane_id}' 2>/dev/null)" || origin=""
[[ -n "$origin" ]] || exit 0

"$TMUX_BIN" set -p -t "$origin" @searching 1 2>/dev/null
# Reopen from (SearchMode) keeps the term + flags; a fresh dialog resets.
sp="$("$TMUX_BIN" display -p -t "$origin" '#{?search_present,1,0}' 2>/dev/null)" || sp=0
if [[ "$sp" == 1 ]]; then
  buf="$("$TMUX_BIN" display -p -t "$origin" '#{@search_term}' 2>/dev/null)" || buf=""
  case_on="$("$TMUX_BIN" display -p -t "$origin" '#{@search_case}' 2>/dev/null)"; [[ "$case_on" == 1 ]] || case_on=0
  word_on="$("$TMUX_BIN" display -p -t "$origin" '#{@search_word}' 2>/dev/null)"; [[ "$word_on" == 1 ]] || word_on=0
  wrap_on="$("$TMUX_BIN" display -p -t "$origin" '#{@search_wrap}' 2>/dev/null)"; [[ "$wrap_on" == 0 ]] || wrap_on=1
  set_wrap "$origin" "$wrap_on"          # tmux's option follows the indicator
else
  buf="" case_on=0 word_on=0 wrap_on=1
  "$TMUX_BIN" set -p -t "$origin" @search_case 0 2>/dev/null
  "$TMUX_BIN" set -p -t "$origin" @search_word 0 2>/dev/null
  set_wrap "$origin" 1                   # a fresh search wraps again
  "$TMUX_BIN" set -p -t "$origin" -u @search_term 2>/dev/null
fi
# Anchor the incremental re-searches on the CURSOR COORDINATES at dialog
# open (a set-mark anchor paints the marked line and clobbers its cell
# styles — Mode B find). Every re-search and every flag toggle restores
# this exact position first, so a growing pattern or a re-filter never
# drifts the highlight. Shared with the --toggle relay via pane options.
a_pos="$("$TMUX_BIN" display -p -t "$origin" '#{scroll_position}' 2>/dev/null)" || a_pos=0
a_y="$("$TMUX_BIN" display -p -t "$origin" '#{copy_cursor_y}' 2>/dev/null)" || a_y=0
a_x="$("$TMUX_BIN" display -p -t "$origin" '#{copy_cursor_x}' 2>/dev/null)" || a_x=0
[[ "$a_pos" == <-> ]] || a_pos=0
[[ "$a_y" == <-> ]] || a_y=0
[[ "$a_x" == <-> ]] || a_x=0
"$TMUX_BIN" set -p -t "$origin" @search_apos "$a_pos" 2>/dev/null
"$TMUX_BIN" set -p -t "$origin" @search_ay "$a_y" 2>/dev/null
"$TMUX_BIN" set -p -t "$origin" @search_ax "$a_x" 2>/dev/null
"${0:A:h}/mux-scroll-cursor" "$origin" 2>/dev/null
"$TMUX_BIN" refresh-client -S 2>/dev/null
cleanup() {
  "$TMUX_BIN" set -p -t "$origin" -u @searching 2>/dev/null
  "${0:A:h}/mux-scroll-cursor" "$origin" 2>/dev/null
  "$TMUX_BIN" refresh-client -S 2>/dev/null
}
trap cleanup EXIT
# C-c reaches the dialog as SIGINT, not a byte — same semantics as the
# \x03 branch: abort the whole stack; the EXIT trap still runs.
TRAPINT() {
  stack_op clear
  exit 0
}

pop_out() { stack_op pop }

# ---- search application ----------------------------------------------------
# The *-incremental copy-mode commands are NO-OPS outside the command-prompt
# machinery (send-keys -X sets nothing; ledger row) — each keystroke runs a
# plain search-backward from the anchor mark instead: highlights every match
# natively (current one in copy-mode-current-match-style) and jumps to the
# nearest one above, which is where scrollback matches live.

apply_search() {
  "$TMUX_BIN" set -p -t "$origin" @search_term "$buf" 2>/dev/null
  if [[ -z "$buf" ]]; then clear_search; return 0; fi
  build_pattern "$buf" "$case_on" "$word_on"
  show_current_match "$origin"
  restore_anchor "$origin"
  "$TMUX_BIN" send-keys -t "$origin" -X search-backward "$REPLY" 2>/dev/null
  # the search stands where it just landed, and X follows it
  save_pos "$origin"
  count_index "$origin" "$REPLY"; set_index "$origin" "$REPLY_IDX"
}

# tmux cannot clear an active search (no search-cancel) — exit and re-enter
# copy-mode, restore the viewport, and re-plant the anchor mark.
clear_search() {
  "$TMUX_BIN" send-keys -t "$origin" -X cancel 2>/dev/null
  "$TMUX_BIN" copy-mode -t "$origin" 2>/dev/null
  restore_anchor "$origin"
}

# ---- rendering (absolute CSI, mirrors render_field) ------------------------
at() { print -rn -- $'\e['"$1;$2H" }  # 1-indexed row;col
rep() { local out="" i; for (( i = 0; i < $2; i++ )); do out+="$1"; done; print -rn -- "$out" }

draw_static() {
  local row blank interior
  blank="$(rep ' ' $W)"
  for row in 1 2 3; do
    at $row 1; print -rn -- "${BG}${blank}"
    at $row 1; print -rn -- "${THEME_BG}${ACCENT_FG}┃${RESET}"
  done
  interior=$(( input_end - INPUT_COL + 2 ))
  at 1 $(( INPUT_COL )); print -rn -- "${BG}${BOX_FG}𜺠$(rep '▂' $interior)𜺣${RESET}"
  at 3 $(( INPUT_COL )); print -rn -- "${BG}${BOX_FG}𜺫$(rep '🮂' $interior)𜺨${RESET}"
  at 2 $(( INPUT_COL )); print -rn -- "${BG}${BOX_FG}▐${RESET}"
  at 2 $(( input_end + 3 )); print -rn -- "${BG}${BOX_FG}▌${RESET}"
  at 2 $(( GLYPH_COL + 1 )); print -rn -- "${BG}${WHITE_FG}${I_SEARCH}${RESET}"
}

draw_input() {
  local shown cfg wfg pfg start
  # tail-scroll the buffer into the field, cursor always at its end
  shown="$buf"
  if (( ${#shown} > field_w - 1 )); then
    start=$(( ${#shown} - field_w + 2 ))
    shown="${shown[$start,-1]}"
  fi
  at 2 $(( INPUT_COL + 1 ))
  print -rn -- "${INPUT_BG}$(rep ' ' $(( area_w + 1 )))"  # clear area
  at 2 $(( INPUT_COL + 1 ))
  print -rn -- "${INPUT_BG}${shown}${ACCENT_BG}${BOX_FG} ${RESET}"
  (( case_on )) && cfg="$ON_FG" || cfg="$OFF_FG"
  (( word_on )) && wfg="$ON_FG" || wfg="$OFF_FG"
  (( wrap_on )) && pfg="$ON_FG" || pfg="$OFF_FG"
  at 2 $(( input_end - TOGGLE_W + 2 ))
  print -rn -- "${INPUT_BG}${cfg}${I_CASE}${RESET}${INPUT_BG} ${wfg}${I_WORD}${RESET}${INPUT_BG}  ${pfg}${I_WRAP}${RESET}"
}

print -rn -- $'\e[?25l'
draw_static
draw_input

while read -rsk1 key; do
  case "$key" in
    $'\r'|$'\n')
      # (SearchInput) Enter -> (SearchMode): the same Search entry, nothing to
      # do to the stack. An empty term has nothing to confirm — pop instead.
      if [[ -z "$buf" ]]; then pop_out
      else show_current_match "$origin"
      fi
      break ;;
    $'\x03')
      # C-c aborts the whole stack -> normal.
      stack_op clear
      break ;;
    $'\e')
      # ESC alone pops Search; ESC+char = the in-dialog Alt chords.
      follow=""
      read -rsk1 -t 0.02 follow || follow=""
      case "$follow" in
        c) (( case_on = ! case_on )); "$TMUX_BIN" set -p -t "$origin" @search_case "$case_on" 2>/dev/null; "$TMUX_BIN" refresh-client -S 2>/dev/null; apply_search; draw_input ;;
        b) (( word_on = ! word_on )); "$TMUX_BIN" set -p -t "$origin" @search_word "$word_on" 2>/dev/null; "$TMUX_BIN" refresh-client -S 2>/dev/null; apply_search; draw_input ;;
        p) (( wrap_on = ! wrap_on )); set_wrap "$origin" "$wrap_on"; "$TMUX_BIN" refresh-client -S 2>/dev/null; draw_input ;;
        "") pop_out; break ;;
        *) while read -rsk1 -t 0.01 _; do :; done ;;
      esac ;;
    $'\x7f'|$'\b')
      if [[ -z "$buf" ]]; then pop_out; break; fi
      buf="${buf[1,-2]}"
      apply_search; draw_input ;;
    $'\x15')
      buf=""
      apply_search; draw_input ;;
    *)
      buf+="$key"
      apply_search; draw_input ;;
  esac
done
exit 0
