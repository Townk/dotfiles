#!/usr/bin/env zsh
# quick-launch-window — open or focus a separate OS terminal window for a
# quick-launch workspace's Zellij session.
#
#   quick-launch-window <session> -- <cmd> [args...]
#       Open: if a WezTerm window is already attached to <session>, focus it;
#       else spawn a new window running <cmd…>.
#   quick-launch-window --new [--tint <name>] <session> -- <cmd> [args...]
#       Always spawn a new window, skipping WezTerm's session-focus lookup.
#       --tint explicitly selects a generated palette color for commands whose
#       remote destination is hidden behind a wrapper.
#   quick-launch-window --focus <session>
#       Focus only: focus the window attached to <session> (exit 0), else exit
#       3 so the caller can fall back (e.g. switch the session in place).
#
# Which window hosts a session is resolved LIVE from the unix sockets the
# Zellij client holds (lib/zellij-session.zsh — the same file-socket trick
# mux-open uses): for each WezTerm pane we find the zellij client on its tty
# and ask which session that client is attached to, yielding the WezTerm
# window id.
#
# Raising the window is done WezTerm-natively, with no osascript: we hand the
# target window id to the GUI through the same channel the fullscreen bind uses
# — `wezterm cli rename-workspace "__QL_FOCUS__=<id>"`. wezterm.lua's
# update-status handler matches that prefix and calls `window:focus()` on the
# matching GUI window. The id rides in the workspace name itself (no sidecar
# file). `wezterm cli activate-pane` is a no-op across windows, hence the GUI.
#
# Ghostty has no window-query CLI, so --focus is a no-op there and open always
# spawns. Host only (not SSH).

set -eu -o pipefail

source "${MUX_LIB:-$HOME/.local/lib}/mux.zsh"

QLW_SCRIPT_DIR="${0:A:h}"
WEZTERM=${commands[wezterm]:-/opt/homebrew/bin/wezterm}
GHOSTTY=${commands[ghostty]:-/Applications/Ghostty.app/Contents/MacOS/ghostty}
OSASCRIPT=${commands[osascript]:-/usr/bin/osascript}
export WEZTERM_BIN="$WEZTERM"
FOCUS_WORKSPACE_PREFIX="__QL_FOCUS__="

# Echo the WezTerm window id hosting <session>, or nothing (see lib helper).
# Capture the (expensive) enumeration once, then match over a here-string — a
# `… | awk '…exit'` pipe would SIGPIPE the producer mid-write, and with
# pipefail+errexit that would abort the whole script before we ever focus.
# mux::client_sessions, not the zellij-only resolver: on tmux the mapping is
# client tty ↔ WezTerm pane tty (Phase 1 deferred item — without this a
# re-launch spawned a SECOND mirrored window instead of focusing the first).
wezterm_window_id_for_session() {
  local out s wid rest
  out=$(mux::client_sessions) || true
  while IFS=$'\t' read -r s wid rest; do
    [[ "$s" == "$1" ]] && {
      print -r -- "$wid"
      return 0
    }
  done <<<"$out"
  return 0
}

# Focus the WezTerm window with id <wid> via the GUI (no osascript): rename our
# workspace to "__QL_FOCUS__=<wid>". wezterm.lua's update-status handler matches
# the prefix, focuses the matching window, and renames back — mirroring
# terminal-toggle-fullscreen's workspace-rename trigger.
wezterm_focus_window() {
  "$WEZTERM" cli rename-workspace "${FOCUS_WORKSPACE_PREFIX}$1" >/dev/null 2>&1 || true
}

# Resolve the direct command's Ghostty background from the same onboard map +
# generated tint palette WezTerm uses. Leaves REPLY empty for a local command.
ghostty_terminal_tint() {
  local lib="$QLW_SCRIPT_DIR/lib/terminal-location.zsh" name hex
  REPLY=""
  [[ -r "$lib" ]] || return 0
  source "$lib" || return 0
  if [[ -n "$TINT_NAME" ]]; then
    name="$TINT_NAME"
  else
    name="$(tl_classify_command "${(j: :)cmd}")" || return 0
  fi
  hex="$(tl_hex_for_colorname "$name")" || return 0
  [[ "$hex" =~ '^#[[:xdigit:]]{6}$' ]] || return 0
  REPLY="$hex"
}

# Linux still launches the command directly, so wrap it with the dynamic
# background OSCs there. macOS uses a normal configured shell plus the
# environment startup hook below to avoid Ghostty's custom-command exit path.
ghostty_apply_terminal_tint() {
  local hex runner
  ghostty_terminal_tint
  hex="$REPLY"
  [[ -n "$hex" ]] || return 0
  runner='tint=$1
shift
reset_tint() { printf "\033]111\033\\"; }
trap reset_tint EXIT
printf "\033]11;%s\033\\" "$tint"
"$@"'
  cmd=("${commands[zsh]:-/bin/zsh}" -f -c "$runner" ql-tint "$hex" "${cmd[@]}")
}

# Create one surface in the already-running macOS app. `open -n ... -e` starts a
# fresh Ghostty instance, whose automatic initial surface appears alongside the
# requested command surface; -e also triggers Ghostty's mandatory execute
# confirmation. The AppleScript API is Ghostty's supported IPC path and creates
# exactly the configured window.
#
# Run the configured shell rather than setting a custom command: Ghostty can
# classify its AppleScript command wrapper as an abnormal sub-250ms exit and
# leave the "[exited]" screen up regardless of wait-after-command. Pass the
# command through the surface environment; .zshrc consumes it before rendering
# a prompt, so neither the tint printf nor the SSH command flashes on screen.
ghostty_new_macos_window() {
  local command_text="${(j: :)${(@q)cmd}}" hex
  ghostty_terminal_tint
  hex="$REPLY"

  "$OSASCRIPT" - "$command_text" "$hex" <<'APPLESCRIPT'
on run argv
    tell application "Ghostty"
        set cfg to new surface configuration
        set launchCommand to "MUX_INITIAL_COMMAND=" & item 1 of argv
        set launchTint to "MUX_INITIAL_TINT=" & item 2 of argv
        set environment variables of cfg to {launchCommand, launchTint}
        set wait after command of cfg to false
        set win to new window with configuration cfg
        activate window win
    end tell
end run
APPLESCRIPT
}

# Argument parsing → MODE (open|focus), KEY (session), and (open) the cmd array.
FORCE_NEW=0
TINT_NAME=""
if [[ "${1:-}" == "--focus" ]]; then
  MODE=focus
  KEY="${2:-}"
  [[ -n "$KEY" ]] || {
    print -ru2 -- "usage: $0 --focus <session>"
    exit 2
  }
else
  MODE=open
  while [[ "${1:-}" == --* ]]; do
    case "$1" in
      --new) FORCE_NEW=1; shift ;;
      --tint)
        [[ -n "${2:-}" ]] || {
          print -ru2 -- "$0: --tint requires a palette color name"
          exit 2
        }
        TINT_NAME="$2"
        shift 2
        ;;
      *) break ;;
    esac
  done
  if [[ $# -lt 3 || "$2" != "--" ]]; then
    print -ru2 -- "usage: $0 [--new] [--tint <name>] <session> -- <cmd> [args...]"
    exit 2
  fi
  KEY=$1
  shift 2
  cmd=("$@")
  ((${#cmd})) || {
    print -ru2 -- "$0: no command after --"
    exit 2
  }
fi

# Environment detection. An SSH session can't drive the host GUI.
# Under tmux the PROCESS env is the server's birth env — a server born from
# an ssh login carries SSH_CONNECTION forever, and TERM_PROGRAM is "tmux" —
# so read the SESSION env instead: update-environment refreshes both
# SSH_CONNECTION (tmux default list) and TERM_PROGRAM (added Phase 0) from
# each attaching client, making it the attach-time truth (Mode B find,
# 2026-07-24; same pattern as edit-terminal-config).
#
# This hardened SSH_CONNECTION probe is the canonical implementation extracted
# to mux::session_is_remote (mux-bootstrap.zsh). It is kept inline here — rather
# than a call — because this runs under `set -eu` and the TERM_PROGRAM lookup
# below needs the same pane-pinned target ($_qlw_t) anyway, so folding both
# through the helper would duplicate the resolution. Keep the two in sync.
_qlw_ssh="${SSH_CONNECTION:-}${SSH_CLIENT:-}"
_qlw_term="${TERM_PROGRAM:-}"
if [[ -n "${TMUX:-}" ]]; then
  # Pin the lookup to the ORIGIN pane's session. Untargeted commands (and
  # '#{session_name}' itself) resolve "most recently used", which right
  # after a workspace build is the freshly created session (env stamped from
  # the popup: TERM_PROGRAM=tmux) — the guard then tripped on first launch
  # and passed on retry (Mode B find, twice). MUX_MODAL_TARGET_PANE is the
  # origin pane tmux-modal captured at popup START, before any build; a pane
  # id is a valid target-session (tmux resolves its containing session).
  _qlw_t=()
  if [[ -n "${MUX_MODAL_TARGET_PANE:-}" ]]; then
    _qlw_t=(-t "$MUX_MODAL_TARGET_PANE")
  else
    _qlw_sess="$(tmux display -p '#{session_name}' 2>/dev/null)" || _qlw_sess=""
    [[ -n "$_qlw_sess" ]] && _qlw_t=(-t "$_qlw_sess")
  fi
  _qlw_v="$(tmux show-environment "${_qlw_t[@]}" SSH_CONNECTION 2>/dev/null)" || _qlw_v=""
  if [[ "$_qlw_v" == SSH_CONNECTION=* ]]; then _qlw_ssh="${_qlw_v#*=}"; else _qlw_ssh=""; fi
  _qlw_v="$(tmux show-environment "${_qlw_t[@]}" TERM_PROGRAM 2>/dev/null)" || _qlw_v=""
  if [[ "$_qlw_v" == TERM_PROGRAM=* ]]; then _qlw_term="${_qlw_v#*=}"; else _qlw_term=""; fi
fi
if [[ -n "$_qlw_ssh" ]]; then
  ENV_TYPE="UNSUPPORTED"
elif [[ "${_qlw_term:l}" == "ghostty" || ( -z "${TMUX:-}" && -n "${GHOSTTY_RESOURCES_DIR:-}" ) ]]; then
  ENV_TYPE="GHOSTTY"
elif [[ "${_qlw_term:l}" == "wezterm" || ( -z "${TMUX:-}" && -n "${WEZTERM_UNIX_SOCKET:-}" ) ]]; then
  ENV_TYPE="WEZTERM"
else
  ENV_TYPE="UNSUPPORTED"
fi

case "$ENV_TYPE" in
  WEZTERM)
    if ((!FORCE_NEW)); then
      wid=$(wezterm_window_id_for_session "$KEY")
      if [[ -n "$wid" ]]; then
        wezterm_focus_window "$wid"
        exit 0
      fi
    fi
    [[ "$MODE" == focus ]] && exit 3
    env -u WEZTERM_UNIX_SOCKET -u WEZTERM_PANE \
      "$WEZTERM" cli --no-auto-start spawn --new-window -- "${cmd[@]}" >/dev/null
    ;;

  GHOSTTY)
    # No window-query CLI: can't focus, so --focus is a no-op and open always
    # spawns a fresh window running the command.
    [[ "$MODE" == focus ]] && exit 3
    if [[ "$(uname -s)" == Darwin ]]; then
      ghostty_new_macos_window
      exit $?
    fi
    ghostty_apply_terminal_tint
    exec "$GHOSTTY" +new-window -e "${cmd[@]}"
    ;;

  UNSUPPORTED | *)
    [[ "$MODE" == focus ]] && exit 3
    print -ru2 -- "quick-launch-window: unsupported environment (need Ghostty or WezTerm on the host, not SSH)."
    exit 1
    ;;
esac
