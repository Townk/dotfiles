#!/usr/bin/env zsh
# mux-quit-confirm — backend-neutral session-kill confirm dialog (mux
# migration Phase 2; spec 2.3's "quit-confirm dialog per-backend kill path").
#
# Runs INSIDE the modal (tmux-modal action mode via display-popup). Themed
# input::confirm widget; defaults to Cancel so Enter/ESC are safe. Only the
# affirmative answer kills:
#   tmux   → `tmux kill-session` (current session)

set -euo pipefail

source "$HOME/.local/lib/input-common.zsh"

if [[ -n "${TMUX:-}" ]]; then
  TMUX_BIN="${MUX_TMUX_BIN:-tmux}"
  session="$("$TMUX_BIN" display -p '#{session_name}' 2>/dev/null)"
  kill_cmd() { "$TMUX_BIN" kill-session; }
else
  echo "mux-quit-confirm: no multiplexer session detected" >&2
  exit 1
fi

# --danger: red destructive palette AND forces default=Cancel, so Enter/ESC
# are safe — the contract zellij-quit-confirm had (parity checked Mode B).
ans=$(input::confirm --title "Quit Session" --danger \
  --affirmative "Quit" --negative "Cancel" \
  "Kill this session?"$'\n\n'"Session: ${session:-?}") || exit 0
[[ "$ans" == yes ]] || exit 0
kill_cmd
