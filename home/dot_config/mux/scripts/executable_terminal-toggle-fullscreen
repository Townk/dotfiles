#!/usr/bin/env zsh

set -eu -o pipefail

fail() {
  print "terminal-toggle-fullscreen: $*" >&2
  exit 1
}

detect_terminal() {
  local term_program="${TERM_PROGRAM:-}"
  local term_program_lower="${term_program:l}"

  # An explicit answer wins. The bridge runs this on the ORIGIN from a socket
  # service whose environment has no TERM_PROGRAM at all — but the remote end
  # knows perfectly well which terminal it is talking to (the tmux client's
  # TERM says so), and sends it along with the request.
  if [[ -n "${MUX_TERMINAL:-}" ]]; then
    print "${MUX_TERMINAL:l}"
    return
  fi

  if [[ -n "${SSH_CONNECTION:-}" || -n "${SSH_CLIENT:-}" ]]; then
    print "ssh"
  elif [[ "$term_program_lower" == "ghostty" || -n "${GHOSTTY_RESOURCES_DIR:-}" ]]; then
    print "ghostty"
  elif [[ "$term_program_lower" == "wezterm" || -n "${WEZTERM_UNIX_SOCKET:-}" || -n "${WEZTERM_PANE:-}" ]]; then
    print "wezterm"
  else
    print "unknown"
  fi
}

toggle_wezterm_fullscreen() {
  local wezterm_bin="${commands[wezterm]:-wezterm}"
  "$wezterm_bin" cli rename-workspace "__TOGGLE_FULLSCREEN__"
}

toggle_ghostty_macos_fullscreen() {
  osascript >/dev/null <<'APPLESCRIPT'
tell application "Ghostty"
    if (count of windows) = 0 then error "Ghostty has no windows"
    set active_terminal to focused terminal of selected tab of front window
    perform action "toggle_fullscreen" on active_terminal
end tell
APPLESCRIPT
}

toggle_ghostty_linux_fullscreen() {
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && (($+commands[hyprctl])); then
    hyprctl dispatch fullscreen 0 >/dev/null
    return
  fi

  if [[ -n "${SWAYSOCK:-}" ]] && (($+commands[swaymsg])); then
    swaymsg fullscreen toggle >/dev/null
    return
  fi

  if [[ -n "${DISPLAY:-}" ]] && (($+commands[wmctrl])); then
    wmctrl -r :ACTIVE: -b toggle,fullscreen
    return
  fi

  fail "Ghostty fullscreen toggle on Linux requires hyprctl, swaymsg, or wmctrl"
}

# Which terminal is on the far end: TERM is the one thing SSH does carry, and
# tmux hands it through untouched (xterm-ghostty / wezterm). The origin needs
# telling because its bridge service has no terminal environment of its own.
peer_terminal() {
  local t="${MUX_PEER_TERM:-$TERM}"
  case "${t:l}" in
    *ghostty*) print ghostty ;;
    *wezterm*) print wezterm ;;
    *) print "" ;;
  esac
}

toggle_over_bridge() {
  local lib="${MUX_LIB_DIR:-$HOME/.local/lib}/clipboard-bridge-client.zsh"
  [[ -r "$lib" ]] || fail "no clipboard bridge client; cannot reach the local terminal"
  source "$lib"

  local port="${CLIPBOARD_BRIDGE_PORT:-2490}"
  clipbridge::probe 127.0.0.1 "$port" ||
    fail "the bridge to your terminal is down (port $port); fullscreen needs that forward"

  local term
  term="$(peer_terminal)"
  [[ -n "$term" ]] || fail "cannot tell which terminal is on the other end (TERM=$TERM)"

  local req
  req=$(mktemp "${TMPDIR:-/tmp}/mux-fs-toggle.XXXXXX") || fail "mktemp failed"
  print -rn -- "fullscreen-toggle $term" > "$req"
  # Longer than the clipboard default: this makes the origin DO something.
  # A window animation takes a moment, and the FIRST toggle blocks on macOS's
  # Automation consent dialog until a human clicks it — timing out there
  # reports "refused" for a toggle that actually happened (measured).
  if ! CLIPBRIDGE_TIMEOUT_S="${MUX_BRIDGE_TIMEOUT_S:-20}" \
       clipbridge::send 127.0.0.1 "$port" W "$req"; then
    rm -f "$req"
    fail "the terminal on the other end refused the fullscreen toggle"
  fi
  rm -f "$req"

  # It just inverted, and we know it without paying for another round trip —
  # so the ribbon's fullscreen segments follow immediately instead of waiting
  # for the resize hook to ask again.
  "${MUX_FULLSCREEN_PROBE:-$HOME/.config/mux/scripts/mux-fullscreen-probe}" --flip 2>/dev/null || true
}

case "$(detect_terminal)" in
  wezterm)
    toggle_wezterm_fullscreen
    ;;
  ghostty)
    case "$(uname -s)" in
      Darwin)
        toggle_ghostty_macos_fullscreen
        ;;
      Linux)
        toggle_ghostty_linux_fullscreen
        ;;
      *)
        fail "Ghostty fullscreen toggle is unsupported on $(uname -s)"
        ;;
    esac
    ;;
  ssh)
    # The window is on the machine we came FROM, and we already have a wire to
    # it: the clipboard bridge's reverse forward. Fullscreen rides the same
    # channel (opcode W) rather than being refused for being remote — the only
    # thing SSH really costs us is the ability to ask the local window server.
    toggle_over_bridge
    ;;
  *)
    fail "unsupported terminal: TERM_PROGRAM=${TERM_PROGRAM:-unset}"
    ;;
esac
