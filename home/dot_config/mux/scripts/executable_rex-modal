#!/usr/bin/env zsh
# rex-modal — Rex backend of the shared floating-modal scaffolding. The
# interface mirrors tmux-modal exactly; it runs INSIDE a Rex
# floating layer (session.new_layer, opened by _mux_rx_layer) whose command
# it is, so the layer closes when this script exits.
#
# Usage:
#   rex-modal [--origin BLOCK_ID] --title TEXT [--inject | --capture FILE]
#             [--no-chrome] -- CMD [ARGS...]
#
#   --origin BLOCK_ID The block the result is typed into. Unlike a tmux popup,
#                     a layer is a pane of its own with its own $REX_BLOCK, so
#                     the opener must pass the block it was opened over; there
#                     is nothing to self-resolve.
#   --title TEXT      Header block (blank, "▓▓▓ <title>", rule); with
#                     --no-chrome the title is handed to the target via
#                     MUX_MODAL_TITLE (+ ZJ_MODAL_TITLE, pick-common's reader).
#   --inject          Picker mode: capture CMD's stdout, strip the single
#                     trailing newline, type it into the origin (`rex send`).
#   --capture FILE    Capture mode: write the result to FILE (a FIFO the
#                     spawner blocks on) via an EXIT trap, so the reader
#                     unblocks on every exit path including ESC/cancel.
#   -- CMD ...        Target command; stdout is the payload, /dev/tty stays
#                     with the target's interactive UI.
#
# Env overrides: MUX_REX_BIN (tests), MUX_LIB.

set -euo pipefail

title=""
inject=0
capture=""
no_chrome=0
origin=""
cmd=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --origin) origin="${2-}"; shift 2 ;;
    --origin=*) origin="${1#*=}"; shift ;;
    --title) title="${2-}"; shift 2 ;;
    --title=*) title="${1#*=}"; shift ;;
    --inject) inject=1; shift ;;
    --no-chrome) no_chrome=1; shift ;;
    --capture) capture="${2-}"; shift 2 ;;
    --capture=*) capture="${1#*=}"; shift ;;
    --) shift; cmd=("$@"); break ;;
    *)
      echo "rex-modal: unknown option: $1" >&2
      exit 2
      ;;
  esac
done

[[ ${#cmd[@]} -gt 0 ]] || {
  echo "rex-modal: no target command (expected '-- CMD ...')" >&2
  exit 2
}

# A layer's command starts from the SERVER's environment, which has neither
# the login shell's PATH nor (since server 0.1.0-preview.25) $REX_SESSION.
# The targets need fzf, jq and friends; the bootstrap restores $REX_SESSION
# from $REX_BLOCK and gives us the rex binary.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
# A server started from inside tmux or zellij hands their variables down; the
# target must not take this layer for a pane of theirs.
unset TMUX TMUX_PANE ZELLIJ ZELLIJ_SESSION_NAME ZELLIJ_PANE_ID
source "${MUX_LIB:-$HOME/.local/lib}/mux-bootstrap.zsh"
rex_bin="$(_mux_rx_bin 2>/dev/null)" || rex_bin=""

# tty_rows — the pane's height in rows, or nothing.
tty_rows() {
  local sz
  sz="$(stty size </dev/tty 2>/dev/null)" || return 1
  [[ "${sz%% *}" == <-> ]] || return 1
  print -r -- "${sz%% *}"
}

# snap_to_rows — trim the layer to a whole number of rows.
#
# A layer's height is a fraction of the window, so its last row is usually a
# partial one: a blank band under whatever the target draws, up to a row tall
# (a picker's bottom border then sits above an "extra line"). Rex exposes no
# pixel sizes to compute the exact fraction from, so it is found by trying:
# keep the row count the layer settled on, and bisect its height down to the
# smallest one that still holds that many rows. A resize reaches the pty in
# 20-100 ms (measured), so each probe waits for the size to settle.
#
# The search costs about a second, so its answer is remembered per
# geometry (rows x columns at the height asked for) in
# $XDG_CACHE_HOME/mux/rex-snap; a later float of the same shape applies it in
# one step and only checks it still holds every row. Runs before the target
# draws anything. $MUX_REX_MODAL_SNAP=0 skips it; $MUX_REX_MODAL_SNAP_LOG
# names a file to trace it into.
snap_to_rows() {
  [[ "${MUX_REX_MODAL_SNAP:-1}" != 0 && -n "$rex_bin" && -n "${REX_BLOCK:-}" ]] || return 0
  local log="${MUX_REX_MODAL_SNAP_LOG:-/dev/null}"

  # A new layer's pty starts at a default size and is resized when the app
  # lays it out. Wait for two equal reads before trusting the size.
  local size="" prev="" i
  for i in {1..20}; do
    size="$(stty size </dev/tty 2>/dev/null)" || return 0
    [[ -n "$prev" && "$size" == "$prev" ]] && break
    prev="$size"
    sleep 0.03
  done
  local rows="${size%% *}" cols="${size##* }"
  [[ "$rows" == <-> && "$cols" == <-> ]] && (( rows > 2 )) || return 0

  local layer
  layer="$("$rex_bin" --autostart=false api call -s "$REX_BLOCK" session.view 2>/dev/null | jq -r --arg b "$REX_BLOCK" '
    .windows[]?.layers[]? | select(.kind != "tiled") | select([.blocks[]?.block_id] | index($b))
    | "\(.layer_id) \(.bounds[0]) \(.bounds[1]) \(.bounds[2]) \(.bounds[3])"' 2>/dev/null)" || return 0
  local -a l=(${=layer})
  (( ${#l} == 5 )) || return 0
  local id="${l[1]}"
  local -F x="${l[2]}" y="${l[3]}" w="${l[4]}" h="${l[5]}"
  print -r -- "start rows=$rows cols=$cols bounds=$x,$y,$w,$h" >>"$log"

  # set_h <height> — resize around the same centre, then report the rows.
  set_h() {
    "$rex_bin" --autostart=false api call -s "$REX_BLOCK" session.resize_layer \
      "$(printf '{"layer_id":"%s","bounds":[%.5f,%.5f,%.5f,%.5f]}' "$id" "$x" $(( y + (h - $1) / 2 )) "$w" "$1")" \
      >/dev/null 2>&1 || return 1
    # The new size reaches the pty in 20-100 ms, not at a fixed delay: wait
    # for two equal reads rather than trusting the first.
    local a="" b="" n
    sleep 0.08
    for n in 1 2 3 4 5; do
      b="$(tty_rows)" || return 1
      [[ "$b" == "$a" ]] && break
      a="$b"
      sleep 0.04
    done
    print -r -- "$b"
  }

  # The row count to end on: the one the caller sized the float for in cells
  # ($MUX_REX_MODAL_ROWS — a widget that measured itself, the job dashboard),
  # else the one the layer came with. A cell height is turned into a fraction
  # of a window whose own size is an estimate, so the layer can arrive a row
  # short or a row over; a box drawn for exactly N rows then loses its top
  # border, or sits above a blank line.
  local -i want=$rows
  [[ "${MUX_REX_MODAL_ROWS:-}" == <-> ]] && (( MUX_REX_MODAL_ROWS > 2 )) && want=$MUX_REX_MODAL_ROWS

  local cache="${XDG_CACHE_HOME:-$HOME/.cache}/mux/rex-snap"
  local key="$(printf '%d:%dx%d@%.4f' "$want" "$rows" "$cols" "$h")"
  local now="$rows" known=""
  known="$(awk -v k="$key" '$1 == k { v = $2 } END { print v }' "$cache" 2>/dev/null)"
  if [[ "$known" == <->.<-> ]] && (( known > 0 && known < 1 )); then
    now="$(set_h $known)" || return 0
    print -r -- "cached h=$known rows=$now" >>"$log"
    [[ "$now" == "$want" ]] && return 0
    # The window changed under the same geometry: forget it and search.
    now="$(set_h $h)" || return 0
  fi

  local -F hi=$h lo=$h step=$(( h / rows )) mid
  # Too short for what the caller drew for: grow until it holds every row.
  for i in 1 2 3 4; do
    (( now >= want )) && break
    hi=$(( hi + step * (want - now) ))
    (( hi < 0.98 )) || { hi=0.98; }
    now="$(set_h $hi)" || return 0
    print -r -- "grow h=$hi rows=$now" >>"$log"
  done
  (( now >= want )) || return 0
  rows=$want
  lo=$hi

  # hi holds `rows` rows. Walk lo down a row's worth at a time until it
  # holds fewer, then bisect between the two.
  for i in {1..$(( 3 + (now > want ? now - want : 0) ))}; do
    lo=$(( lo - step ))
    (( lo > 0 )) || return 0
    now="$(set_h $lo)" || return 0
    print -r -- "walk h=$lo rows=$now" >>"$log"
    (( now < rows )) && break
    hi=$lo
  done
  if (( now >= rows )); then
    set_h $hi >/dev/null
    return 0
  fi
  for i in 1 2; do
    mid=$(( (lo + hi) / 2 ))
    now="$(set_h $mid)" || break
    print -r -- "bisect h=$mid rows=$now" >>"$log"
    if (( now >= rows )); then hi=$mid; else lo=$mid; fi
  done
  # Settle on the smallest height known to hold every row, and remember it.
  now="$(set_h $hi)"
  print -r -- "final h=$hi rows=$now" >>"$log"
  if [[ "$now" == "$want" ]]; then
    mkdir -p "${cache:h}" 2>/dev/null
    { grep -v "^$key " "$cache" 2>/dev/null | tail -n 40; printf '%s %.5f\n' "$key" "$hi"; } >"$cache.$$" 2>/dev/null \
      && mv -f "$cache.$$" "$cache" 2>/dev/null
  fi
  return 0
}
# Best effort: under `set -e` nothing in here may end the modal.
snap_to_rows || true

if (( no_chrome )); then
  # "fzf owns the box": hand the title to the target; draw nothing.
  if [[ -n "$title" ]]; then
    export MUX_MODAL_TITLE="$title"
    export ZJ_MODAL_TITLE="$title"   # pick-common's current reader
  fi
else
  # Shared dialog theme — same single source the other two modals use.
  source "${MUX_LIB:-$HOME/.local/lib}/theme-common.zsh"
  dialog_bg="$(theme::sgr_bg "$C_ROLE_UI_DIALOG_BG")"
  printf '%s\e[2J\e[H' "$dialog_bg"
  if [[ -n "$title" ]]; then
    rule="$(theme::rule)"
    printf '%s\e[K\n' "$dialog_bg"
    printf '%s  %s▓▓▓ %s%s\e[K\n' "$dialog_bg" "$THEME_H1" "$title" "$dialog_bg"
    printf '%s  %s%s%s\e[K\n' "$dialog_bg" "$THEME_SEPARATOR" "$rule" "$dialog_bg"
  fi
  printf '\e[39;22m'
fi

if [[ -n "$capture" ]]; then
  # Capture mode: EXIT trap writes the result on every exit path so the
  # FIFO reader always unblocks (mirror of the other modals' contract).
  result=""
  tmp=$(mktemp "${TMPDIR:-/tmp}/rexmodal.XXXXXX")
  # Only ever into a FIFO: once the caller has given up (interrupted, timed
  # out) it removes its FIFO, and a plain redirect would then leave the
  # answer behind as a stray regular file.
  trap '[[ -p "$capture" ]] && printf "%s" "$result" > "$capture"; rm -f -- "$tmp"' EXIT
  "${cmd[@]}" >"$tmp" || true
  result=$(cat "$tmp")
  result="${result%$'\n'}"
  exit 0
fi

if ((!inject)); then
  # Action mode: the target owns the outcome. Export the origin so
  # per-backend kill/rename paths can address it.
  [[ -z "$origin" ]] || export MUX_MODAL_TARGET_PANE="$origin"
  exec "${cmd[@]}"
fi

# Picker mode: run the target with the background-sink env exported so
# insert-without-dismiss binds write into the origin mid-session
# (pick::background_sink's Rex branch), then type the final selection.
tmp=$(mktemp "${TMPDIR:-/tmp}/rexmodal.XXXXXX")
trap 'rm -f "$tmp"' EXIT
if [[ -n "$origin" && -n "$rex_bin" ]]; then
  PICK_INJECT_PANE="$origin" PICK_INJECT_REX="$rex_bin" \
    "${cmd[@]}" >"$tmp" || true
else
  "${cmd[@]}" >"$tmp" || true
fi

# Strip the single trailing newline so we don't auto-submit at a shell
# prompt. Embedded newlines (multi-select concatenation) are preserved.
# No U+FE0F strip here, unlike tmux-modal: that works around tmux's cell
# widths disagreeing with zsh's, and Rex's grid is libghostty's.
result=$(cat "$tmp")
result="${result%$'\n'}"

[[ -n "$result" && -n "$origin" && -n "$rex_bin" ]] || exit 0

# A block id is accepted wherever Rex takes a session, so the origin names
# both the session and the block.
"$rex_bin" --autostart=false send -s "$origin" -b "$origin" -- "$result"
