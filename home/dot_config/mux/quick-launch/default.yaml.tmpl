{{- $hasQmk := and (stat (joinPath .chezmoi.homeDir "Projects/platforms/keyboards/qmk")) (stat (joinPath .chezmoi.homeDir "Projects/platforms/keyboards/qmk-config")) -}}
{{- $hasWeztermPlugins := and (stat (joinPath .chezmoi.homeDir "Projects/apps/wezterm/quicklaunch.wezterm")) (stat (joinPath .chezmoi.homeDir "Projects/apps/wezterm/statusbar.wezterm")) -}}
{{- $hasZellijPlugins := and (stat (joinPath .chezmoi.homeDir "Projects/apps/zellij/zj-context-keys/")) (stat (joinPath .chezmoi.homeDir "Projects/apps/zellij/zj-prompt-jumper/")) (stat (joinPath .chezmoi.homeDir "Projects/apps/zellij/zj-hud")) -}}
# default.yaml — managed quick-launch targets, backend-agnostic.
#
# These live under ~/.config/mux/, not ~/.config/zellij/, because the picker
# and the dispatcher serve zellij and tmux from the same file: a "workspace" is
# a session and a "tab" is a tab or a window, whichever mux the calling pane is
# in. Only entries that edit a backend's OWN config (config.kdl, the zellij
# plugins) are zellij-specific, and they say so in their labels.
#
# Consumed by ~/.config/mux/scripts/quick-launch via the Alt+w P/T/W leader
# binds. Every target is focus-or-create. Schema + merge rules:
#   ~/.config/mux/quick-launch/quick-launch-schema.md
#
# This file is a chezmoi template: machine-specific workspaces are gated on the
# existence (at `chezmoi apply` time) of their project directories, so an entry
# only renders on a machine that actually has the project checked out. Drop
# unmanaged, host-local targets into ~/.config/mux/quick-launch/launch.d/;
# they are merged over these defaults (matching `id`s in launch.d win).

tools:
  editor: nvim
  mise: mise

workspaces:
  - id: default
    name: Main
{{ if $hasQmk }}
  - id: qmk
    name: QMK Firmware
    icon: " "
    tabs:
      - id: qmk-firmware
        name: Firmware
        action:
          type: Shell
          label: " Open terminal on the QMK Firmware repository directory"
          cwd: ~/Projects/platforms/keyboards/qmk
      - id: qmk-userspace
        name: Svalboard Keymap
        action:
          type: Shell
          label: " Open terminal on my custom QMK userspace Keymap directory"
          cwd: ~/Projects/platforms/keyboards/qmk-config
    panes:
      - id: qmk-compile
        name: QMK Build
        icon: "􏂭 "
        direction: down
        size: 40%
        optional: true
        action:
          type: Run
          label: Build Svalboard Lightly Firmware
          cwd: ~/Projects/platforms/keyboards/qmk-config
          python_venv: auto
          args:
            - printf '┏━━━━━━━━━━━━━━━━━┓\n┃ Left side build ┃\n┻━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n'
            - qmk compile -kb svalboard/trackball/pmw3389/left -km townk
            - printf '\n┏━━━━━━━━━━━━━━━━━━┓\n┃ Right side build ┃\n┻━━━━━━━━━━━━━━━━━━┻━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n'
            - qmk compile -kb svalboard/trackball/pmw3389/right -km townk
            - printf '\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nPress any key to close the pane'
            - sleep 5

      - id: qmk-flash-right
        name: QMK Flash Right
        icon: "󱊟 "
        direction: down
        size: 40%
        optional: true
        action:
          type: Run
          label: Flash the Svalboard Lightly right half firmware
          cwd: ~/Projects/platforms/keyboards/qmk-config
          python_venv: auto
          args:
            - qmk flash -kb svalboard/trackball/pmw3389/right -km townk
{{ end }}
{{ if $hasWeztermPlugins }}
  - id: wezterm-plugins
    name: Wezterm Plugins
    icon: "􏬄 "
    tabs:
      - id: wezterm-config
        name: Wezterm Config
        icon: "􏬄 "
        action:
          type: Edit
          label: Edit Wezterm configuration
          cwd: ~/.config/wezterm
          args: ["wezterm.lua"]
      - id: statusbar-plugin
        name: Status Bar Plugin
        icon: " "
        action:
          type: Edit
          label: Edit Status Bar Plugin
          cwd: ~/Projects/apps/wezterm/statusbar.wezterm
          args: ["plugin/init.lua"]
      - id: quicklaunch-plugin
        name: Quick Launch Plugin
        icon: "󱓟 "
        action:
          type: Edit
          label: Edit Quick Launch Plugin
          cwd: ~/Projects/apps/wezterm/quicklaunch.wezterm
          args: ["plugin/init.lua"]
{{ end }}
{{ if $hasZellijPlugins }}
  - id: zellij-plugins
    name: Zellij Plugins
    icon: "􏬆 "
    tabs:
      - id: zellij-config
        name: Zellij Config
        icon: "􏬆 "
        action:
          type: Edit
          label: Edit Zellij configuration
          cwd: ~/.config/zellij
          args: ["config.kdl"]
      - id: zj-context-keys-plugin
        name: Context Keys Plugin
        icon: "󰌏 "
        action:
          type: Edit
          label: Edit Context Keys Plugin
          cwd: ~/Projects/apps/zellij/zj-context-keys
          args: ["src/main.rs"]
      - id: zj-prompt-jumper-plugin
        name: Prompt Jumper Plugin
        icon: "󱕘 "
        action:
          type: Edit
          label: Edit Prompt Jumper Plugin
          cwd: ~/Projects/apps/zellij/zj-prompt-jumper
          args: ["src/main.rs"]
      - id: zj-hud-plugin
        name: Shell Hud Plugin
        icon: " "
        action:
          type: Edit
          label: Edit Shell Hud Plugin
          cwd: ~/Projects/apps/zellij/zj-hud
          args: ["src/main.rs"]
{{ end }}

tabs:
  - id: launcher-items
    name: Launcher Items
    icon: "󱓟 "
    action:
      type: Edit
      label: Edit Quick Launch items
      cwd: ~/.config/mux/quick-launch
      args: ["default.yaml"]

  - id: launcher-local-items
    name: Launcher Local Items
    icon: "󱓟 "
    action:
      type: Edit
      label: Edit Quick Launch local items
      cwd: ~/.config/mux/quick-launch/launch.d
      args: ["home.yaml"]

  - id: brew-pkgs
    name: Homebrew Packages
    icon: "􏃼 "
    action:
      type: Edit
      label: Edit Brewbundle file
      cwd: ~/.config/packages
      args: ["Brewfile"]

  - id: zellij-config
    name: Zellij Config
    icon: "􏬆 "
    action:
      type: Edit
      label: Edit Zellij configuration
      cwd: ~/.config/zellij
      args: ["config.kdl"]

  - id: wezterm-config
    name: Wezterm Config
    icon: "􏬄 "
    action:
      type: Edit
      label: Edit Wezterm configuration
      cwd: ~/.config/wezterm
      args: ["wezterm.lua"]

  - id: zsh-config
    name: Zsh Config
    icon: "􏬅 "
    action:
      type: Edit
      label: Edit Zsh configuration
      cwd: ~
      args: [".zshrc"]

  - id: neovim-config
    name: NeoVim Config
    icon: " "
    action:
      type: Edit
      label: Edit NeoVim configuration
      cwd: ~/.config/nvim
      args: ["init.lua"]

  - id: hammerspoon-config
    name: Hammerspoon Config
    icon: " "
    action:
      type: Edit
      label: Edit Hammerspoon configuration
      cwd: ~/.config/hammerspoon
      args: ["init.lua"]

  - id: system-resources
    name: System Resources
    icon: " "
    action:
      type: Run
      label: Open System Resources
      args:
        - btm --battery

  - id: network-activity
    name: Network activity
    icon: "󰈀 "
    action:
      type: Run
      label: Open Network activity
      args:
        - sudo bandwhich --total-utilization

panes:
  - id: git-log
    name: Git Log
    icon: " "
    direction: right
    size: 65%
    moveFocus: true
    optional: true
    action:
      type: Run
      label: Git Log on current directory
      args:
        - "{ git rev-parse --show-toplevel >/dev/null 2>&1 && LESS='-RSX' git log --graph --pretty='format:%C(auto)%h %<(50,trunc)%s %C(magenta)(%cr)%Creset by %C(bold blue)%an <@%al> %C(auto)%d %C(8)%(trailers:valueonly,key=cr,separator=%x2C)' --all; } || { echo 'Not a Git repo!'; echo 'Press any key to close the panel...'; read -s -n 1 -r key; }"

  - id: lazy-git
    name: LazyGit
    icon: "󰊢 "
    direction: floating
    size: 85% x 80%
    moveFocus: true
    optional: true
    action:
      type: Run
      label: Open LazyGit on current directory
      args:
        - "{ git rev-parse --show-toplevel >/dev/null 2>&1 && lazygit; }  || { echo 'Not a Git repo!'; echo 'Press any key to close the panel...'; read -s -n 1 -r key; }"
