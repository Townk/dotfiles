# tmux.conf — tmux backend base configuration (mux migration, Phase 0).
# GENERATED by chezmoi from home/dot_config/tmux/tmux.conf.tmpl — edit the source.
#
# Zellij remains the default mux. This file makes a bare tmux themed,
# image-capable, and clipboard-correct (spec: docs/superpowers/specs/
# 2026-07-21-tmux-migration-design.md, Phase 0). The keymap/key-tables land in
# Phase 1; the status bar in Phase 4.

# ---------------------------------------------------------------------------
# Prefix — M-w mirrors the Zellij leader (D3): the ~40 WezTerm Cmd+…→Alt+w …
# forwards and the Ghostty mirrors serve both backends verbatim.
unbind C-b
# Leader: M-w arms the prefix TABLE for one key via a root bind, instead of
# `set -g prefix M-w`. Identical semantics (press-release, sticky until the
# next key), but the armed state is a key-table change — which tmux
# reliably redraws the status for, so the bar's Command pill appears the
# moment the leader is pressed (#{client_prefix} flips did NOT redraw the
# status; Mode B find, 2026-07-24). All `bind X` chords land in the prefix
# table as usual.
set -g prefix None
# (the M-w root bind itself lives in keymap-base.conf, with the rest of the
# key machinery)

# ---------------------------------------------------------------------------
# Terminal & protocol plumbing
set -g default-terminal "tmux-256color"

# OSC passthrough — the reason tmux is in this config at all (spec §1):
# escape sequences tmux doesn't understand are forwarded to the host
# terminal (when the inner app wraps them in the tmux DCS envelope)
# instead of being swallowed.
set -g allow-passthrough on

# OSC 52: tmux re-emits an inner app's OSC 52 to the *attached client's*
# terminal — the same origin-relative semantics as Zellij's unset
# copy_command (D9): local session → local clipboard; over SSH the write
# rides up to the typing-side terminal. Clipboard READS stay blocked by
# the outer terminal, so the reverse-tunnel nvim paste path is untouched.
set -g set-clipboard on

# Capabilities of the OUTER terminals we attach from. WezTerm presents
# TERM=xterm-256color; Ghostty presents TERM=xterm-ghostty. Sixel is
# claimed ONLY for WezTerm — Ghostty has no sixel support (kitty graphics
# only), and a '*' claim would make tmux emit sixel garbage there (D1/R6:
# sixel is the WezTerm floor).
set -as terminal-features '*:clipboard:hyperlinks:RGB'
set -as terminal-features 'xterm-256color:sixel'

# kitty CSI-u keys: pi/claude speak the kitty keyboard protocol; forward
# extended key encodings to apps that request them (`always`, not `on`,
# so CSI-u-capable clients receive CSI-u even for keys that also have a
# legacy encoding — e.g. Shift+Enter → \e[13;2u). Validated live in the
# Phase 0.5 Mode B pass.
set -s extended-keys always
set -as terminal-features '*:extkeys'

# ---------------------------------------------------------------------------
# Behavior parity with the Zellij setup
set -g history-limit 1000000       # scroll_buffer_size 1000000
# A sixel image arrives as ONE DCS string, and tmux DISCARDS any string
# sequence larger than input-buffer-size — the pane goes blank with no error
# and nothing in the log. The 1 MiB default is small for an image at this
# terminal's resolution: measured by catting pre-rendered streams, 1,032,961
# bytes rendered and 1,174,685 did not, while a full-pane photo runs 2-3 MB.
# 16 MiB is a ceiling for pathological input, not an allocation — tmux grows
# the buffer as needed and frees it with the sequence.
set -s input-buffer-size 16777216
set -s escape-time 0               # ESC is ESC, never a chord timeout (ESC cancels; Ctrl+C aborts)
set -g focus-events on             # nvim autoread & friends
set -g mouse on
setw -g mode-keys vi               # copy-mode motion parity with the zellij scroll keys
# vim-like word boundaries for w/b/e and the iw text object (tmux default is
# space-only, which makes every word motion a WORD motion; iW flips this to
# whitespace-only transiently via mux-copy-object).
setw -g word-separators " !\"#$%&'()*+,-./:;<=>?@[]^\\\`{|}~"
set -g base-index 1                # zellij tabs are 1-based; keymap number jumps assume it
setw -g pane-base-index 1
set -g renumber-windows on         # closing a window renumbers the rest, like zellij tabs

# Window name = what the app CALLS itself, when it says anything (zj-hud
# compose_body priority 2: `pane_osc_title(...) ?? process name`). Agents
# publish their session and their progress through OSC 0/2, which tmux
# records in #{pane_title} — it just never named windows after it, so a
# claude/cursor session read as "node" and never moved.
#
# Put in automatic-rename-format rather than in the pill: tmux re-evaluates
# this as the title changes and renames the window (measured: a new title
# lands in #{window_name} in ~1s and fires window-renamed, which redraws the
# status). Reading #{pane_title} in the pill instead would only repaint on
# status-interval — up to 10s late for a progress counter.
#
# Three guards, all of them load-bearing (zj-hud's pane_osc_title):
#   * empty                     — nothing to show
#   * == the hostname           — tmux SEEDS pane_title with it, so every
#                                 idle shell would wear the machine name
#   * == the process name       — no new information; keep the process name
#                                 so the icon lookup and the shell branch
#                                 below keep working
# `#{host}` and `#{host_short}` are both checked: which one a pane's seed
# matches depends on the terminal that opened it.
%hidden win_osc_title="#{?#{&&:#{!=:#{pane_title},},#{&&:#{!=:#{pane_title},#{host}},#{&&:#{!=:#{pane_title},#{host_short}},#{!=:#{pane_title},#{pane_current_command}}}}},#{pane_title},#{pane_current_command}}"
# The copy-mode / dead-pane markers are tmux's own default format, kept.
setw -g automatic-rename-format "#{?pane_in_mode,[tmux],$win_osc_title}#{?pane_dead,[dead],}"

# Refresh these into a session's environment on attach: tmux overrides the
# PANE env (TERM_PROGRAM=tmux), so the session env is the only truthful
# record of the outer terminal — image-protocol-support.zsh and yazi both
# read it via `tmux show-environment`. NB: update-environment is an ARRAY
# option — one variable per -ga append; a quoted "TERM TERM_PROGRAM" would
# create a single bogus entry matching nothing.
#
# `set -gu` FIRST, because -ga appends on every source-file: after a day of
# config reloads the array held 53 copies of TERM and TERM_PROGRAM. Unsetting
# the whole option (not an index) restores tmux's built-in list, so the
# appends below land exactly once however often this file is sourced.
set -gu update-environment
set -ga update-environment TERM
set -ga update-environment TERM_PROGRAM
# SSH_CLIENT and SSH_TTY join SSH_CONNECTION (already in tmux's default list)
# so that ALL THREE follow the current attach. They are the vars powerlevel10k
# reads to decide "this shell is remote", and it takes any one of them: with
# only SSH_CONNECTION refreshed, a server that was ever attached over ssh kept
# handing stale SSH_CLIENT/SSH_TTY to every new pane, so the prompt showed
# `@user` forever — including on a local or VNC attach, which are not remote.
set -ga update-environment SSH_CLIENT
set -ga update-environment SSH_TTY

# Cross-mux hygiene: if this server was started from a shell that descends
# from a Zellij session (e.g. after a manual ZELLIJ=… autostart bypass), the
# stale ZELLIJ* vars would be baked into every pane — and anything detecting
# its mux by env (image-protocol-support.zsh, yazi's driver selection, zj::*)
# would think it's inside Zellij. `-r` removes them from the environment of
# every new pane process. A REAL Zellij nested inside a tmux pane re-exports
# them itself, so nesting still works.
set-environment -gr ZELLIJ
set-environment -gr ZELLIJ_PANE_ID
set-environment -gr ZELLIJ_SESSION_NAME

# ---------------------------------------------------------------------------
# Theme — every color comes from theme.yaml through the generated
# chezmoi-system theme: canonical …-base.conf (generate-theme.sh) ⊕ loose
# per-machine override → effective chezmoi-system.conf, written and
# live-reloaded by theme-apply (D15). -q: silent on a fresh machine until
# the first theme-apply run (shell init runs it before any mux starts).
source-file -q "{{ .chezmoi.homeDir }}/.config/tmux/themes/chezmoi-system.conf"

# ---------------------------------------------------------------------------
# Keymap — key tables mirroring the Zellij modes (D2/D3). Hand-authored in
# Phase 1; the Phase 5 YAML generator replaces the FILE, not this line.
source-file "{{ .chezmoi.homeDir }}/.config/tmux/keymap-base.conf"
# …then the mode tables GENERATED from .chezmoidata/keymap.yaml — the same
# data the which-key panel dispatches from (Phase 5.2).
source-file "{{ .chezmoi.homeDir }}/.config/tmux/keymap.conf"

# ---------------------------------------------------------------------------
# Status line assembly (Phase 4, D6) — MUST parse after the theme: it
# composes status formats from the theme's %hidden color fragments.
source-file "{{ .chezmoi.homeDir }}/.config/tmux/status.conf"

