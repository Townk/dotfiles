# keymap-base.conf — the tmux key machinery that is NOT panel-visible
# (mux migration Phase 5.2). GENERATED by chezmoi from
# home/dot_config/tmux/keymap-base.conf.tmpl — edit the source.
#
# The MODE-TABLE bindings (everything the which-key panel lists) are
# generated from home/.chezmoidata/keymap.yaml into keymap.conf, so the
# panel's own dispatcher and tmux's tables can never drift. What lives
# here: the root table (vim/fzf nav, M-/), the mode-stack plumbing
# (Escape/Backspace pops, panel controls), locked/nested, and the whole
# copy-mode surface.
#
# HAND-AUTHORED in migration Phase 1; the Phase 5 keymap-YAML generator
# replaces this FILE (tmux.conf's source-file line stays). Keep binds
# one-per-line and keep the comments — they are the gotcha ledger that
# migrates into the YAML `comment` fields (Phase 8 emits them back).
#
# Mode model (D2): persistent key tables via `set key-table <mode>`
# (session-scoped — nearest tmux equivalent of Zellij's per-client mode;
# parity ledger tracks the divergence). Unbound keys fall through to the
# pane, matching Zellij mode semantics. Escape returns to root from every
# table (ESC cancels — never conflate with Ctrl+C). In a non-root table the
# M-w prefix is unavailable — matches Zellij (leader from Normal only); R4.

# ---------------------------------------------------------------------------
# Prefix chords (leader M-w, D3 — letters match the Zellij "tmux" mode block)
# ---------------------------------------------------------------------------
# zellij leader f (TogglePaneFrames): pane-title frames on/off (Phase 4 —
# format/colors in the theme; off by default in status.conf).
# Scroll vs Copy: one tmux copy-mode, two stack states via the @visual pane
# option. Scroll (M-w l, Cmd+Up): j/k/arrows scroll the VIEWPORT and the
# cursor is inert (tmux cannot hide it — ledger row). Copy/visual (v from
# Scroll, or M-w V directly): normal vi cursor motions; v begins selection.
# Entries always stamp the state, so a stale flag self-heals.
# Quit: themed confirm dialog in a popup (Phase 2; parity with
# mux-quit-confirm — Phase 6 pointed the zellij keybind at the SAME
# script). Geometry mirrors the zellij fixed-cell dialog.
# copy-pwd: the script is already PID-parameterized (the zellij side passes
# the plugin's {pid}); tmux hands it the pane's root process directly.
# Alarms (D6 basics — flag styling + Hammerspoon notify land in Phase 4).
# Leader-again passes the chord through to the app (zellij: leader exits mode;
# here the pane gets the raw M-w, which is the closest useful equivalent).
# send-keys, not send-prefix: the leader is a table switch now (prefix None).
bind M-w send-keys M-w
# ESC cancels the armed leader without leaking into the app (zellij: Esc
# exits tmux mode; ESC cancels — never conflate with Ctrl+C).
bind Escape run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-stack clear"
# Mode stack (zellij which-key trail parity): Backspace pops one level. The
# stack is REAL now — @mux_stack, one entry per mode you walked through —
# so every table below uses these same two commands and the pop lands where
# you actually came from, panel up or panel down (before this, the pops were
# inferred from a static parent map and each table re-implemented them).
bind BSpace run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-stack pop"

# ---------------------------------------------------------------------------
# Retired bindings — tmux key tables are CUMULATIVE: `source-file` adds and
# overrides, but a bind that disappears from the config lives on in a running
# server until it is unbound (Mode B find: the Phase-5 display-menu binds kept
# shadowing the panel's M-. long after menus.conf was deleted). The paging
# keys are gone for good (the panel pages itself); M-. is OVERWRITTEN in every
# table below rather than unbound, which retires the stale menu and makes the
# toggle reachable from any mode when the panel is hidden.
# ---------------------------------------------------------------------------
unbind -T prefix C-d
unbind -T prefix C-u
bind -T copy-mode-vi M-. run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-whichkey toggle"
bind -T prefix M-. run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-whichkey toggle"
{{/* ORDER IS LOAD-BEARING: bind first, unbind second. A custom key table
     only exists once something is bound into it, and `unbind -T tab` on a
     server that has not sourced keymap.conf yet is an ERROR — ten of them,
     one per line. That is not cosmetic: a config error puts the client in a
     message overlay, and the first keypresses after startup are consumed
     dismissing those messages instead of reaching the key tables (measured
     on a fresh server, 2026-07-26). Binding M-. first creates the table, so
     the unbinds are quiet and a fresh server takes its first key. */ -}}
{{ range $t := list "tab" "pane" "session" "resize" "move" -}}
bind -T {{ $t }} M-. run-shell -b "{{ $.chezmoi.homeDir }}/.config/mux/scripts/mux-whichkey toggle"
unbind -T {{ $t }} C-d
unbind -T {{ $t }} C-u
{{ end }}
# ---------------------------------------------------------------------------
# Leader (D3): M-w arms the prefix TABLE for one key — a table change, which
# tmux reliably redraws the status for — and opens the which-key panel (a
# popup that dispatches the mode's keys itself; it no-ops when hidden).
# ---------------------------------------------------------------------------
bind -n M-w switch-client -T prefix \; run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-stack push command"

# ---------------------------------------------------------------------------
# Root table — vim/fzf-aware navigation (D4 fast lane / D13)
# ---------------------------------------------------------------------------
# Fast lane: a live process-table check of the pane's tty (the canonical
# vim-tmux-navigator probe, extended with fzf). NOT @pane-is-vim /
# pane_current_command, both of which fail here: smart-splits.nvim is
# lazy-loaded on its keys, so it can't stamp @pane-is-vim before tmux
# forwards a key (chicken-and-egg), and widget-spawned fzf (zsh C-t /
# completion) stays in zsh's process group so pane_current_command reports
# "zsh". The ps probe catches both; once a key reaches nvim, smart-splits
# loads and stamps @pane-is-vim for the C-S resize binds below (the zellij
# twin of all this is the context-keys `when fzf` clause + vim-navigator).
%hidden is_passthru="ps -o state= -o comm= -t '#{pane_tty}' | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?(g?(view|l?n?vim?x?)(diff)?|fzf)$'"
bind -n C-h if "$is_passthru" 'send-keys C-h' 'select-pane -L'
bind -n C-j if "$is_passthru" 'send-keys C-j' 'select-pane -D'
bind -n C-k if "$is_passthru" 'send-keys C-k' 'select-pane -U'
bind -n C-l if "$is_passthru" 'send-keys C-l' 'select-pane -R'
bind -n C-Left  if "$is_passthru" 'send-keys C-Left'  'select-pane -L'
bind -n C-Down  if "$is_passthru" 'send-keys C-Down'  'select-pane -D'
bind -n C-Up    if "$is_passthru" 'send-keys C-Up'    'select-pane -U'
bind -n C-Right if "$is_passthru" 'send-keys C-Right' 'select-pane -R'
# Resize: Ctrl+Shift + hjkl/arrows, increases toward the pressed direction
# (mirrors the vim-navigator resize_mod "ctrl+shift" alias config).
bind -n C-S-h if -F '#{@pane-is-vim}' 'send-keys C-S-h' 'resize-pane -L 2'
bind -n C-S-j if -F '#{@pane-is-vim}' 'send-keys C-S-j' 'resize-pane -D 2'
bind -n C-S-k if -F '#{@pane-is-vim}' 'send-keys C-S-k' 'resize-pane -U 2'
bind -n C-S-l if -F '#{@pane-is-vim}' 'send-keys C-S-l' 'resize-pane -R 2'
# WezTerm folds shift into the letter for ctrl+shift chords: the key arrives
# named C-H, not C-S-h (Mode B probe, 2026-07-24). Bind the uppercase twins;
# both names forward the canonical C-S-* form to vim.
bind -n C-H if -F '#{@pane-is-vim}' 'send-keys C-S-h' 'resize-pane -L 2'
bind -n C-J if -F '#{@pane-is-vim}' 'send-keys C-S-j' 'resize-pane -D 2'
bind -n C-K if -F '#{@pane-is-vim}' 'send-keys C-S-k' 'resize-pane -U 2'
bind -n C-L if -F '#{@pane-is-vim}' 'send-keys C-S-l' 'resize-pane -R 2'
bind -n C-S-Left  if -F '#{@pane-is-vim}' 'send-keys C-S-Left'  'resize-pane -L 2'
bind -n C-S-Down  if -F '#{@pane-is-vim}' 'send-keys C-S-Down'  'resize-pane -D 2'
bind -n C-S-Up    if -F '#{@pane-is-vim}' 'send-keys C-S-Up'    'resize-pane -U 2'
bind -n C-S-Right if -F '#{@pane-is-vim}' 'send-keys C-S-Right' 'resize-pane -R 2'
# M-/ — search straight from normal (zellij Alt+/): enter scroll-state
# copy-mode with the incremental search prompt. Search is the ONLY entry on
# the stack, so popping it (ESC/Backspace) lands back in normal — no
# @search_parent needed, the stack below it says so.
bind -n M-/ set -p @searching 1 \; set -p @visual 0 \; copy-mode \; run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-stack push search" \; run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-search --launch"

# Agent lane (Phase 6.4, D21): `agent`/`cursor-agent` want Down/Up where vim
# wants the raw C-j/C-k and everything else wants focus movement — three
# outcomes, so the probes CHAIN. Deliberately not one run-shell classifier:
# that would put zsh startup (~30ms) on a held navigation key, where the ps
# probe costs ~5ms. Same shape as the zellij `when agent,cursor-agent: key
# down` clause on the context-keys bind.
%hidden is_agent="ps -o state= -o comm= -t '#{pane_tty}' | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?(cursor-)?agent$'"
bind -n C-j if "$is_agent" 'send-keys Down' { if "$is_passthru" 'send-keys C-j' 'select-pane -D' }
bind -n C-k if "$is_agent" 'send-keys Up'   { if "$is_passthru" 'send-keys C-k' 'select-pane -U' }

# Alt+Enter (Phase 6.1) — toggle the HOST terminal's native fullscreen via the
# workspace-rename side channel. fzf owns the key when it has the pane: the
# quick-launch workspace picker binds it to "open in a separate window"
# (zellij's `when fzf: $source` clause).
%hidden is_fzf="ps -o state= -o comm= -t '#{pane_tty}' | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?fzf$'"
bind -n M-Enter if "$is_fzf" 'send-keys M-Enter' 'run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/terminal-toggle-fullscreen"'

# ---------------------------------------------------------------------------
# Mouse word/line select — without tmux's 300ms pause
# ---------------------------------------------------------------------------
# tmux's stock DoubleClick1Pane/TripleClick1Pane sit on `run-shell -d 0.3`
# between selecting and copying, purely so the highlight is visible for a
# moment. That pause IS the sluggishness a double-click has under tmux
# (measured: 326ms with it, 18ms without — the copy itself needs no delay,
# select-word has already set the selection).
#
# It also causes the mode flash. While the pause runs the pane sits in
# copy-mode, and the bar resolves copy-mode with @visual unset as SCROLL — so
# double-clicking a word announced a mode you never asked for, for a third of
# a second. At 18ms there is nothing left to see.
#
# Everything else is stock: `select-pane -t =` keeps click-to-focus, and the
# `pane_in_mode`/`mouse_any_flag` arm still forwards the event to an app that
# is capturing the mouse (fzf, vim) or to a pane already in copy-mode.
bind -n DoubleClick1Pane select-pane -t = \; if -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" { send -M } { copy-mode -H ; send -X select-word ; send -X copy-pipe-and-cancel }
bind -n TripleClick1Pane select-pane -t = \; if -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" { send -M } { copy-mode -H ; send -X select-line ; send -X copy-pipe-and-cancel }

# ---------------------------------------------------------------------------
# MEH direct bindings — Ctrl+Alt+Shift (spec 2026-07-27-meh-direct-bindings)
# ---------------------------------------------------------------------------
# Single-keystroke access to actions that otherwise cost a leader chord. These
# are ROOT binds, which is why they live here and not in keymap.yaml (that file
# owns the mode tables and the panel; the root table has always been ours).
#
# THREE SPELLINGS PER CHORD, because the terminals disagree about where Shift
# goes and tmux believes them (all measured through a real client):
#   WezTerm  Ctrl+Alt+Shift+P -> CSI 27;7;80~  (shifted CODEPOINT, no shift bit)
#            -> tmux calls it C-M-P
#   Ghostty  Ctrl+Alt+Shift+P -> CSI 27;8;80~  (shift bit AND shifted codepoint)
#            -> tmux calls it C-M-S-P
#   kitty    CSI 112;8u       (shift bit, UNshifted codepoint)
#            -> tmux calls it C-M-S-p
# The first two are what our terminals actually send; C-M-S-p costs one line
# and covers any client that speaks the kitty protocol instead.
#
# NEVER give one of these an `if` whose else-branch is `send-keys C-M-P`:
# C-M-P, C-M-p and C-M-S-P ALL encode to \e^P on the way to a pane (the legacy
# control byte has no Shift bit), and \e^P is ai-playbook-pick in zsh. A
# guarded MEH bind is "act, or do nothing" — it can never pass through.
#
# The commands are the keymap.yaml originals MINUS the mode plumbing: fired
# from the root table there is no key-table to reset and no @mux_stack entry to
# pop, so `set key-table root` and the `mux-stack clear` are both omitted.
# Carrying them over would corrupt the stack.
#
# Unguarded on purpose. The pickers draw a popup OVER whatever owns the pane
# and type nothing into it; copy-pwd reads `#{pane_pid}` — the pane's ROOT
# process — so it reports the shell's cwd from inside nvim, fzf or a pager
# without ever consulting the foreground app.

# MEH-p — Project picker (a workspace is a session on either backend).
{{- range list "C-M-P" "C-M-S-P" "C-M-S-p" }}
bind -n {{ . }} run-shell -b '$HOME/.config/mux/scripts/tmux-popup 70 60 -E -B -e COLORTERM=truecolor "$HOME/.config/mux/scripts/tmux-modal --title \"Quick Launch — Workspace\" --no-chrome -- $HOME/.config/mux/scripts/quick-launch menu workspace"'
{{- end }}

# MEH-t — Tab picker.
{{- range list "C-M-T" "C-M-S-T" "C-M-S-t" }}
bind -n {{ . }} run-shell -b '$HOME/.config/mux/scripts/tmux-popup 70 60 -E -B -e COLORTERM=truecolor "$HOME/.config/mux/scripts/tmux-modal --title \"Quick Launch — Tab\" --no-chrome -- $HOME/.config/mux/scripts/quick-launch menu tab"'
{{- end }}

# MEH-s — Split picker. `s` is "split", from before floating panes existed.
{{- range list "C-M-S" "C-M-S-S" "C-M-S-s" }}
bind -n {{ . }} run-shell -b '$HOME/.config/mux/scripts/tmux-popup 70 70 -E -B -e COLORTERM=truecolor "$HOME/.config/mux/scripts/tmux-modal --title \"Quick Launch — Pane\" --no-chrome -- $HOME/.config/mux/scripts/quick-launch menu pane"'
{{- end }}

# MEH-v — Clipboard picker. --inject: the pick is typed into the pane.
{{- range list "C-M-V" "C-M-S-V" "C-M-S-v" }}
bind -n {{ . }} run-shell -b '$HOME/.config/mux/scripts/tmux-popup 70 75 -E -B -e COLORTERM=truecolor "$HOME/.config/mux/scripts/tmux-modal --title \"Clipboard history\" --inject --no-chrome -- $HOME/.local/libexec/pick-clipboard"'
{{- end }}

# MEH-n — New tab. `n` for new, so p/t/s stay the picker family; the terminals
# already separate ⌘t (new) from ⌘⇧T (pick), and this keeps that split.
{{- range list "C-M-N" "C-M-S-N" "C-M-S-n" }}
bind -n {{ . }} new-window
{{- end }}

# MEH-<digit> — jump to tab 1..10 (⌘1..⌘9, ⌘0). Shift does NOT fold a digit to
# a digit: it folds it to the SHIFTED PUNCTUATION of the layout, so tmux names
# these `C-M-!` … `C-M-)` rather than `C-M-1`. That mapping is US-layout, which
# would be a liability if we depended on the physical chord — we do not. The
# TERMINAL synthesises these bytes for ⌘N, so they are deterministic whatever
# the keyboard does. Pressing MEH+1 by hand happens to work too, on a layout
# where Shift+1 is `!`.
#
# Third spelling per digit is the kitty form, which shifts neither the bit nor
# the codepoint and so stays a digit (`C-M-S-1`).
{{- range $t := list
      (dict "d" "1" "p" "!" "w" "1")
      (dict "d" "2" "p" "@" "w" "2")
      (dict "d" "3" "p" "#" "w" "3")
      (dict "d" "4" "p" "$" "w" "4")
      (dict "d" "5" "p" "%" "w" "5")
      (dict "d" "6" "p" "^" "w" "6")
      (dict "d" "7" "p" "&" "w" "7")
      (dict "d" "8" "p" "*" "w" "8")
      (dict "d" "9" "p" "(" "w" "9")
      (dict "d" "0" "p" ")" "w" "10") }}
{{- range list (printf "C-M-%s" $t.p) (printf "C-M-S-%s" $t.p) (printf "C-M-S-%s" $t.d) }}
bind -n {{ . }} select-window -t :={{ $t.w }}
{{- end }}
{{- end }}

# MEH-c / MEH-d — Copy CWD, relative and absolute. Two letters because MEH has
# no shifted variant left to spend: it already IS Ctrl+Alt+Shift.
{{- range list "C-M-C" "C-M-S-C" "C-M-S-c" }}
bind -n {{ . }} run-shell 'zsh ~/.config/mux/scripts/copy-pwd --relative #{pane_pid}'
{{- end }}
{{- range list "C-M-D" "C-M-S-D" "C-M-S-d" }}
bind -n {{ . }} run-shell 'zsh ~/.config/mux/scripts/copy-pwd --absolute #{pane_pid}'
{{- end }}

# --- MEH scroll + prompt jumps (batch 3) -----------------------------------
# These are the only MEH binds that are STATEFUL: they enter copy-mode, so they
# must also set @visual (0 = Scroll, not Copy) and push the mode stack, or the
# panel and the pane disagree and a stale entry eats later keys.
#
# `#{pane_in_mode}` splits entry from repeat. A root bind DOES still fire while
# the pane is in copy-mode (measured), so one bind serves both: already in the
# mode, just act; otherwise enter, act, and push ONCE. Without that test three
# presses would stack three `scroll` entries.
#
# GUARDED, unlike every other MEH bind: scrolling tmux's buffer under nvim or
# fzf is wrong — they own their own. `$is_scrollable` is `$is_passthru`
# negated (same ps probe on the pane's tty, NOT pane_current_command, which
# reports "zsh" for a widget-spawned fzf). The false branch is ABSENT, not a
# `send-keys` fall-through: C-M-K would reach the pane as `\e^K`, and a MEH
# bind can never pass its own chord through.
#
# The `copy-mode-current-match-style` set mirrors the native j/k binds below,
# so scrolling by MEH highlights search matches exactly like scrolling by k.
# The prompt jumps skip it, exactly as the native `p` bind does.
{{- $home := .chezmoi.homeDir }}
%hidden is_scrollable="! ps -o state= -o comm= -t '#{pane_tty}' | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?(g?(view|l?n?vim?x?)(diff)?|fzf)$'"

# MEH-k / MEH-↑ — scroll one line up. Arrows need only ONE spelling: they carry
# modifiers in a numeric field, so Shift has no codepoint to fold into.
{{- range list "C-M-K" "C-M-S-K" "C-M-S-k" "C-M-S-Up" }}
bind -n {{ . }} if "$is_scrollable" { if -F '#{pane_in_mode}' { set -p copy-mode-current-match-style "#{E:copy-mode-match-style}" ; send -X scroll-up } { set -p @visual 0 ; copy-mode ; set -p copy-mode-current-match-style "#{E:copy-mode-match-style}" ; send -X scroll-up ; run-shell -b "{{ $home }}/.config/mux/scripts/mux-stack push scroll" } }
{{- end }}

# MEH-j / MEH-↓ — scroll one line down.
{{- range list "C-M-J" "C-M-S-J" "C-M-S-j" "C-M-S-Down" }}
bind -n {{ . }} if "$is_scrollable" { if -F '#{pane_in_mode}' { set -p copy-mode-current-match-style "#{E:copy-mode-match-style}" ; send -X scroll-down } { set -p @visual 0 ; copy-mode ; set -p copy-mode-current-match-style "#{E:copy-mode-match-style}" ; send -X scroll-down ; run-shell -b "{{ $home }}/.config/mux/scripts/mux-stack push scroll" } }
{{- end }}

# MEH-b / MEH-f — previous / next shell prompt (back and forward; `p`/`n` were
# already spent on the project picker and new tab). OSC 133 marks, from the zsh
# precmd emitter in functions.d/prompt-marks.sh.
#
# Each jump moves the CURSOR to the edge of the viewport first (`top-line` /
# `bottom-line`) so the prompts already ON SCREEN are skipped. Without that,
# `previous-prompt` walks prompt-by-prompt through the visible screen and
# `scroll_position` never changes — measured: three presses moved the cursor
# PROMPT-20 → 19 → 18 with the view completely still. Anchoring to the edge
# first makes every press move the view to the next prompt you cannot see.
{{- range list "C-M-B" "C-M-S-B" "C-M-S-b" }}
bind -n {{ . }} if "$is_scrollable" { if -F '#{pane_in_mode}' { send -X top-line ; send -X previous-prompt } { set -p @visual 0 ; copy-mode ; send -X top-line ; send -X previous-prompt ; run-shell -b "{{ $home }}/.config/mux/scripts/mux-stack push scroll" } }
{{- end }}
{{- range list "C-M-F" "C-M-S-F" "C-M-S-f" }}
bind -n {{ . }} if "$is_scrollable" { if -F '#{pane_in_mode}' { send -X bottom-line ; send -X next-prompt } { set -p @visual 0 ; copy-mode ; send -X bottom-line ; send -X next-prompt ; run-shell -b "{{ $home }}/.config/mux/scripts/mux-stack push scroll" } }
{{- end }}

# ---------------------------------------------------------------------------
# tm-scrub context routes (Phase 6.3, D4/D20)
# ---------------------------------------------------------------------------
# Bare capitals are far too hot to intercept globally, so every one of these
# is gated on the @ctx PANE OPTION that system-backup-tm stamps, and falls
# through to the pane otherwise. The stamp vocabulary is what makes zellij's
# per-app clauses expressible here (zellij matches process-tree comms, tmux
# cannot):
#
#   @ctx = tm          the timeline pane  → J/K + Shift+arrows step, A applies
#   @ctx = tm-diff     hunk/diffnav lens  → same, plus S (see below)
#   @ctx = tm-explore  the yazi lens      → everything passes through: yazi
#                                           binds these keys itself
#
# The route addresses the session by PATH (@tm_session), not by pid: a tmux
# pane's #{pane_pid} is its root shell, never the worker that wrote
# lens.pid/timeline.pid, so a pid-matched route would silently never fire.
# `#{m:tm*,#{@ctx}}` catches both routing classes in one format match.
{{- $tm := printf "%s/.local/libexec/system-backup-tm" .chezmoi.homeDir }}
{{- $route := printf "run-shell -b \"%s route --session '#{@tm_session}' --pane '#{pane_id}'" $tm }}
%hidden in_tm="#{&&:#{m:tm*,#{@ctx}},#{!=:#{@ctx},tm-explore}}"
# NB: `{ }` command blocks, not quoted strings — the command carries a
# single-quoted '#{@tm_session}', which would end an outer single quote (a
# tmux parse error that silently aborts the rest of the file).
bind -n J      if -F "$in_tm" { {{ $route }} --send J shift+down" } { send-keys J }
bind -n K      if -F "$in_tm" { {{ $route }} --send K shift+up" } { send-keys K }
bind -n S-Down if -F "$in_tm" { {{ $route }} --send S-Down shift+down" } { send-keys S-Down }
bind -n S-Up   if -F "$in_tm" { {{ $route }} --send S-Up shift+up" } { send-keys S-Up }
bind -n A      if -F "$in_tm" { {{ $route }} --send A apply" } { send-keys A }
# H/L move focus between the lens and the timeline (zellij: `do move_focus`).
bind -n H if -F "$in_tm" 'select-pane -L' 'send-keys H'
bind -n L if -F "$in_tm" 'select-pane -R' 'send-keys L'
# S in a DIFF lens only: diffnav cannot couple its own `e` (file tree) and
# `s` (side-by-side) toggles, so write both. ORDER IS LOAD-BEARING — hide the
# tree first so the pane grows, THEN switch to side-by-side, or delta lays
# out narrow halves that never expand.
bind -n S if -F '#{==:#{@ctx},tm-diff}' 'send-keys e s' 'send-keys S'


# ---------------------------------------------------------------------------
# Which-key panel (Phase 5, D5) — the panel is a popup that dispatches the
# mode keys itself while open; these binds only open it (mode entry) and
# toggle it when hidden.
# ---------------------------------------------------------------------------
bind -n M-. run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-whichkey toggle"

# ---------------------------------------------------------------------------
# tab table (zellij "tab" mode)
# ---------------------------------------------------------------------------
bind -T tab Escape run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-stack clear"
bind -T tab BSpace run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-stack pop"
bind -T tab 0 select-window -t :=10 \; set key-table root
# Rename: themed input::line dialog in a popup (Phase 2.4).
# BreakPaneLeft/Right approximation: fold this window's pane into the
# neighbor window (zellij makes the tab become a pane there). Ledger row —
# semantics differ when the window has several panes.
# T — quick-launch tab picker lands here in Phase 3.

# ---------------------------------------------------------------------------
# pane table (zellij "pane" mode)
# ---------------------------------------------------------------------------
bind -T pane Escape run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-stack clear"
bind -T pane BSpace run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-stack pop"
# No stacked panes / pin / embed↔float toggle: no tmux equivalent needed
# (§6 dispositions — stacked unused, pin only meaningful for non-modal
# floats, popups are modal). P — quick-launch pane picker lands in Phase 3.

# ---------------------------------------------------------------------------
# resize table (zellij "resize" mode; repeatable binds)
# ---------------------------------------------------------------------------
bind -T resize Escape run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-stack clear"
bind -T resize BSpace run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-stack pop"
bind -T resize H resize-pane -R 2
bind -T resize J resize-pane -U 2
bind -T resize K resize-pane -D 2
bind -T resize L resize-pane -L 2
bind -T resize S-Left resize-pane -R 2
bind -T resize S-Down resize-pane -U 2
bind -T resize S-Up resize-pane -D 2
bind -T resize S-Right resize-pane -L 2
bind -T resize = resize-pane -U 2

# ---------------------------------------------------------------------------
# move table (zellij "move" mode)
# ---------------------------------------------------------------------------
# tmux has no directional pane swap; swap-pane -U/-D walk the pane order.
# Ledger row documents the divergence (h/l rotate the whole window).
bind -T move Escape run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-stack clear"
bind -T move BSpace run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-stack pop"
bind -T move BTab swap-pane -U

# ---------------------------------------------------------------------------
# session table (zellij "session" mode)
# ---------------------------------------------------------------------------
bind -T session Escape run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-stack clear"
bind -T session BSpace run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-stack pop"
# S — quick-launch workspace picker lands here in Phase 3. The zellij-only
# chrome rows (about/configuration/plugin-manager/share) have no tmux
# equivalent (§6 dispositions) — ledger.

# ---------------------------------------------------------------------------
# locked table (zellij "locked" mode — maximum passthrough)
# ---------------------------------------------------------------------------
# Every keypress including Escape flows to the app; the single exit is
# M-Escape, a combo uncommon enough that no shell or TUI claims it.
bind -T locked M-Escape run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-stack clear"

# ---------------------------------------------------------------------------
# nested table — D14: filled by the Phase 3 nested_mux builder (outer
# session gets `prefix None` + this table with only C-M-Space → picker).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# copy-mode additions (zellij scroll/search parity; D11/D12 stage 1)
# ---------------------------------------------------------------------------
# V — EditScrollback: dump history into nvim in a new window (zellij `V`).
# Pseudo text objects (viw-style): with a selection pending (v first), i/a
# capture one key via the prompt and mux-copy-object macros it from
# jump/select primitives; with NO selection they mimic vim's insert/append
# — clear the whole mode stack back to normal. True text objects are an
# engine gap (fixed send -X vocabulary; ledger row) — V (scrollback in
# nvim) is the full-fidelity fallback.
bind -T copy-mode-vi i if -F '#{selection_present}' {
  command-prompt -1 -k -p '(i)' {
    run-shell "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-copy-object i '%%' '#{pane_id}'"
  }
} {
  send -X cancel
}
bind -T copy-mode-vi a if -F '#{selection_present}' {
  command-prompt -1 -k -p '(a)' {
    run-shell "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-copy-object a '%%' '#{pane_id}'"
  }
} {
  send -X cancel
}
# Scroll-mode stack (zellij parity). ESC: with a selection it only clears
# the selection; otherwise it clears the WHOLE stack (straight to normal).
# Backspace ALWAYS pops exactly one level, and it is the SAME pop every
# other table uses — mux-stack owns what leaving a copy state means (drop
# @visual, clear a search by exiting and re-entering copy-mode since tmux
# 3.7 has no search-cancel, cancel copy-mode when the last copy state
# leaves). That teardown used to be inlined here, in mux-search and in the
# panel, keyed off @copy_parent/@search_parent, and the three disagreed.
# y mirrors Enter exactly (copy-pipe + leave).
# Scroll-state motion: viewport scroll, not cursor (see @visual above).
# SCROLLING MUTES THE CURRENT-MATCH COLOUR. tmux paints the match under the
# CURSOR as the current one, and scrolling drags the cursor across the buffer
# (it is pinned to a screen row), so it lights up whatever match it passes —
# a match that is emphatically not where the search is standing. Muting is a
# style option pointing at another style option, so it costs no shell on a
# key you might hold, and keeps every colour in the theme. n/N and a fresh
# commit unmute, because there the cursor really is on the current match.
# The mute goes FIRST in each binding: the movement is what repaints, so a
# mute queued behind it arrives too late — with two matches on adjacent
# lines the cursor had already lit the second one (Mode B).
bind -T copy-mode-vi j if -F '#{@visual}' {send -X cursor-down} {set -p copy-mode-current-match-style "#{E:copy-mode-match-style}" ; send -X scroll-down}
bind -T copy-mode-vi Down if -F '#{@visual}' {send -X cursor-down} {set -p copy-mode-current-match-style "#{E:copy-mode-match-style}" ; send -X scroll-down}
bind -T copy-mode-vi k if -F '#{@visual}' {send -X cursor-up} {set -p copy-mode-current-match-style "#{E:copy-mode-match-style}" ; send -X scroll-up}
bind -T copy-mode-vi Up if -F '#{@visual}' {send -X cursor-up} {set -p copy-mode-current-match-style "#{E:copy-mode-match-style}" ; send -X scroll-up}
# …and the same for every other key that moves the viewport (these were
# tmux's own defaults; they keep their action and gain the mute).
bind -T copy-mode-vi C-u set -p copy-mode-current-match-style "#{E:copy-mode-match-style}" \; send -X halfpage-up
bind -T copy-mode-vi C-d set -p copy-mode-current-match-style "#{E:copy-mode-match-style}" \; send -X halfpage-down
bind -T copy-mode-vi C-b set -p copy-mode-current-match-style "#{E:copy-mode-match-style}" \; send -X page-up
bind -T copy-mode-vi C-f set -p copy-mode-current-match-style "#{E:copy-mode-match-style}" \; send -X page-down
bind -T copy-mode-vi PageUp set -p copy-mode-current-match-style "#{E:copy-mode-match-style}" \; send -X page-up
bind -T copy-mode-vi PageDown set -p copy-mode-current-match-style "#{E:copy-mode-match-style}" \; send -X page-down
bind -T copy-mode-vi g set -p copy-mode-current-match-style "#{E:copy-mode-match-style}" \; send -X history-top
bind -T copy-mode-vi G set -p copy-mode-current-match-style "#{E:copy-mode-match-style}" \; send -X history-bottom
# v: Scroll → push Copy/visual at the current position; in Copy it begins
# the selection as usual.
bind -T copy-mode-vi v if -F '#{@visual}' {send -X begin-selection} {run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-stack push copy"}
bind -T copy-mode-vi Escape if -F '#{selection_present}' {
  send -X clear-selection
} {
  run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-stack clear"
}
bind -T copy-mode-vi y send -X copy-pipe-and-cancel
bind -T copy-mode-vi Enter send -X copy-pipe-and-cancel
bind -T copy-mode-vi BSpace run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-stack pop"
bind -T copy-mode-vi V run-shell 'f=$(mktemp /tmp/tmux-scrollback.XXXXXX); tmux capture-pane -p -S - >"$f"; tmux new-window -n scrollback "nvim +\$ $f"' \; send -X cancel
# n/p — prompt jumps via OSC 133 marks (zj-prompt-jumper parity; the marks
# come from the zsh precmd emitter, functions.d/prompt-marks.sh). tmux has
# ONE copy-mode where zellij splits scroll vs search, and `n` is also
# search-next there: mux-search dispatches on the mode STACK, keeping both
# muscle memories (Search → next match; otherwise → next prompt).
#
# In Search they step the SEARCH's own position, not the cursor: tmux's
# search-again looks from wherever the cursor is, so scrolling with j/k
# silently changed which match came next. Now you can read anywhere in the
# buffer and n still goes to the match after the highlighted one.
bind -T copy-mode-vi n run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-search --next '#{pane_id}'"
bind -T copy-mode-vi N run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-search --prev '#{pane_id}'"
bind -T copy-mode-vi p if -F '#{@visual}' { send -X previous-prompt } { send -X top-line ; send -X previous-prompt }
# b/f — prompt jumps in SCROLL state, completing the pair with C-b/C-f (page).
# Both keep their vi meanings in Copy/visual state, the same @visual split j/k
# use: `b` is previous-word and `f` is the find-char prompt, and neither makes
# sense while the cursor is inert.
#
# Anchored like every other prompt jump: `previous-prompt` moves the CURSOR and
# does not scroll while the mark is still on screen, so without `top-line` first
# it walks the visible prompts and the view never moves.
bind -T copy-mode-vi b if -F '#{@visual}' { send -X previous-word } { send -X top-line ; send -X previous-prompt }
bind -T copy-mode-vi f if -F '#{@visual}' { command-prompt -1 -p "(jump forward)" { send -X jump-forward -- "%%" } } { send -X bottom-line ; send -X next-prompt }
# / — forward incremental search (D12 stage 1; the floating search dialog
# with option toggles is the D12 stage 2 hud follow-up).
# '/' opens (SearchInput) by pushing Search; from (SearchMode) it reopens
# prefilled on the SAME entry (the two are one stack level — pushing again
# would make Backspace need two presses, which is exactly what it used to do).
bind -T copy-mode-vi / if -F '#{search_present}' {
  run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-search --launch"
} {
  run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-stack push search" ; run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-search --launch"
}
# (SearchMode) flag toggles — mirror the in-dialog M-c/M-b/M-p. NOT gated on
# #{search_present}: a case-sensitive re-filter can drop every match, which
# clears that flag, and the chord that undoes it has to outlive its own
# effect. mux-search gates on the mode STACK instead.
bind -T copy-mode-vi M-c run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-search --toggle case '#{pane_id}'"
bind -T copy-mode-vi M-b run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-search --toggle word '#{pane_id}'"
bind -T copy-mode-vi M-p run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-search --toggle wrap '#{pane_id}'"

# (Status v0 — the Phase 1 bare [key_table] indicator — was RETIRED by
# Phase 4: the themed mode pill lives in status-right via the theme's
# %hidden fragments + status.conf.)

# ---------------------------------------------------------------------------
# Pickers (Phase 2) — glyph / gitmoji / clipboard popups via tmux-modal.
# The zellij twins are the zellijModalRun keybinds (config.kdl); geometry and
# chrome contract match (fzf owns the box, -B borderless popup). The libexec
# pickers are called directly — the pick-*-zellij thins carry zellij-only
# glue; resume variants (prefix U/G) reopen with --resume like the leader
# chords.
bind -n C-S-u run-shell -b '{{ .chezmoi.homeDir }}/.config/mux/scripts/tmux-popup 70 60 -E -B -e COLORTERM=truecolor -e PICK_GLYPH_PADDING=0,2,0,2 "{{ .chezmoi.homeDir }}/.config/mux/scripts/tmux-modal --title \"Glyph Picker\" --inject --no-chrome -- {{ .chezmoi.homeDir }}/.local/libexec/pick-glyph"'
bind -n C-S-g run-shell -b '{{ .chezmoi.homeDir }}/.config/mux/scripts/tmux-popup 70 60 -E -B -e COLORTERM=truecolor -e PICK_GITMOJI_PADDING=0,2,0,2 "{{ .chezmoi.homeDir }}/.config/mux/scripts/tmux-modal --title \"Gitmoji Picker\" --inject --no-chrome -- {{ .chezmoi.homeDir }}/.local/libexec/pick-gitmoji"'
# Uppercase twins: WezTerm folds shift into the letter for ctrl+shift chords
# (arrives as C-U / C-G — same finding as the resize binds above).
bind -n C-U run-shell -b '{{ .chezmoi.homeDir }}/.config/mux/scripts/tmux-popup 70 60 -E -B -e COLORTERM=truecolor -e PICK_GLYPH_PADDING=0,2,0,2 "{{ .chezmoi.homeDir }}/.config/mux/scripts/tmux-modal --title \"Glyph Picker\" --inject --no-chrome -- {{ .chezmoi.homeDir }}/.local/libexec/pick-glyph"'
bind -n C-G run-shell -b '{{ .chezmoi.homeDir }}/.config/mux/scripts/tmux-popup 70 60 -E -B -e COLORTERM=truecolor -e PICK_GITMOJI_PADDING=0,2,0,2 "{{ .chezmoi.homeDir }}/.config/mux/scripts/tmux-modal --title \"Gitmoji Picker\" --inject --no-chrome -- {{ .chezmoi.homeDir }}/.local/libexec/pick-gitmoji"'

# ---------------------------------------------------------------------------
# Quick-launch (Phase 3) — pickers in popups, dispatch via the ql_tx_* twins.
# Chords mirror the zellij mode chords: tab-T, pane-P, session-S. The picker
# emits an id (or @window:<id> on Alt+Enter) and quick-launch dispatches.
# nested table (D14): the sole escape hatch from a nested-mux outer session.
bind -T nested C-M-Space run-shell -b '{{ .chezmoi.homeDir }}/.config/mux/scripts/tmux-popup 70 60 -E -B -e COLORTERM=truecolor "{{ .chezmoi.homeDir }}/.config/mux/scripts/tmux-modal --title \"Quick Launch — Workspace\" --no-chrome -- {{ .chezmoi.homeDir }}/.config/mux/scripts/quick-launch menu workspace"'
