# status.conf — native status-line ASSEMBLY (mux migration Phase 4, D6).
# GENERATED by chezmoi from home/dot_config/tmux/status.conf.tmpl — edit the source.
#
# Layout only — every color lives in the theme (chezmoi-system.conf), which
# parses FIRST (tmux.conf source order) and publishes the color-bearing
# fragments as %hidden variables: $mode_pill, $alarm_flags, $session_pill.
# The zj-hud bar is the reference: window list left (the tabs role), mode
# pill + widgets + session pill right.

set -g status on
set -g status-position bottom
set -g status-justify left
set -g status-interval 10

# No left segment: the window list IS the left edge. (The Phase 1
# [key_table] v0 indicator is superseded by the mode pill on the right.)
set -g status-left ""
set -g status-left-length 0

# zj-hud tab pills (theme fragments): contiguous ▌-edged pills, no extra
# separator — each pill carries its own leading space and edge glyph.
setw -g window-status-separator ""
setw -g window-status-format "$win_pill"
setw -g window-status-current-format "$win_pill_current"

# Right: the zj-hud gradient ribbon (mode pill · hints · session · widgets ·
# clock), rendered whole by tmux-status-right. The key table / copy-mode /
# session ride in as ARGUMENTS so a change re-expands the #() command string
# and tmux re-runs it immediately — instant mode pill, interval-refreshed
# widgets.
set -g status-right-length 160
set -g status-right "#({{ .chezmoi.homeDir }}/.local/libexec/tmux-status-right '#{client_key_table}' '#{?pane_in_mode,1,0}' '#S' '#{?client_prefix,1,0}' '#{?search_present,1,0}' '#{@renaming}' '#{?#{@visual},1,0}' '#{?#{@searching},1,0}' '#{@search_case}#{@search_word}#{@search_wrap}' '#{client_width}')"

# Which-key panel (Phase 5, D5): a popup owned by mux-whichkey — it floats
# over the panes and dispatches the mode's keys itself while open (tmux
# popups swallow key-table input). Nothing to wire into the status stack.
set -g @wk_hidden 0
set -g @wk_force 0
# Defensive: a server from the status-line era can still carry panel rows in
# status-format; put the stack back to "bar only".
run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-whichkey restore"

# Pane frames off by default (zellij pane_frames=false aesthetic); prefix f
# toggles them (keymap.conf); format/colors in the theme.
setw -g pane-border-status off

# Scroll state hides the terminal cursor (zellij parity); Copy shows it.
# The hook covers every copy-mode entry/exit; the keymap's @visual
# transitions (v / Backspace) call the helper directly.
set-hook -g pane-mode-changed 'run-shell -b "{{ .chezmoi.homeDir }}/.config/mux/scripts/mux-scroll-cursor \"#{pane_id}\""'

# Alarm alerts → host OSD (the same Hammerspoon notify the zellij
# zj_hud_alarm path shows). The notifier gates itself on the session env's
# ssh truth — a remote client can't see the host OSD; the bar flag still
# shows there.
set-hook -g alert-activity 'run-shell -b "{{ .chezmoi.homeDir }}/.local/libexec/tmux-alert-notify activity \"#{window_name}\""'
set-hook -g alert-silence 'run-shell -b "{{ .chezmoi.homeDir }}/.local/libexec/tmux-alert-notify silence \"#{window_name}\""'
set-hook -g alert-bell 'run-shell -b "{{ .chezmoi.homeDir }}/.local/libexec/tmux-alert-notify bell \"#{window_name}\""'
