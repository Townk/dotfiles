{{- $km := .keymap -}}
# keymap.conf — GENERATED mode-table bindings (mux migration Phase 5.2).
# Source of truth: home/.chezmoidata/keymap.yaml — the SAME data the
# which-key panel dispatches from, so the panel and the key tables can
# never disagree. The non-panel machinery (root nav, mode-stack pops,
# locked/nested, copy-mode) lives in keymap-base.conf, sourced first.
#
# `#N` in a numeric entry's cmd templates the index (the 1..9 tab jumps).
# Every command rides in a BRACE BLOCK: a bare `;` in a config file is a
# command separator, so `bind N new-window ; set key-table root` would bind
# the first and RUN the second at load (Mode B find).
{{ range $name, $t := $km.tables }}{{ if ne $name "copy" }}
# --- {{ $t.title }}{{ if hasKey $t "parent" }} (from {{ $t.parent }}){{ end }} ---
{{ range $e := $t.entries }}{{ if not (hasKey $e "panel_only") }}{{ $flag := "" }}{{ if ne $name "prefix" }}{{ $flag = printf "-T %s " $name }}{{ end }}{{ if hasKey $e "numeric" }}{{ range $k := $e.keys }}bind {{ $flag }}{{ $k }} { {{ replace "#N" $k $e.cmd }} }
{{ end }}{{ else }}{{ range $k := $e.keys }}bind {{ $flag }}{{ $k }} { {{ $e.cmd }}{{ if hasKey $e "to" }} ; run-shell -b "{{ $.chezmoi.homeDir }}/.config/mux/scripts/mux-whichkey open {{ $e.to }}"{{ end }} }
{{ end }}{{ end }}{{ end }}{{ end }}{{ end }}{{ end }}
