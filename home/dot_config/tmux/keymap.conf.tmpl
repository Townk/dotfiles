# keymap.conf — tmux key tables mirroring the Zellij modes (spec D2/D3).
# GENERATED by chezmoi from home/dot_config/tmux/keymap.conf.tmpl — edit the source.
#
# HAND-AUTHORED in migration Phase 1; the Phase 5 keymap-YAML generator
# replaces this FILE (tmux.conf's source-file line stays). Keep binds
# one-per-line and keep the comments — they are the gotcha ledger that
# migrates into the YAML `comment` fields (Phase 8 emits them back).
#
# Mode model (D2): persistent key tables via `set key-table <mode>`
# (session-scoped — nearest tmux equivalent of Zellij's per-client mode;
# parity ledger tracks the divergence). Unbound keys fall through to the
# pane, matching Zellij mode semantics. Escape returns to root from every
# table (ESC cancels — never conflate with Ctrl+C). In a non-root table the
# M-w prefix is unavailable — matches Zellij (leader from Normal only); R4.

# ---------------------------------------------------------------------------
# Prefix chords (leader M-w, D3 — letters match the Zellij "tmux" mode block)
# ---------------------------------------------------------------------------
bind v split-window -h                    # zellij leader v (split right)
bind s split-window -v                    # zellij leader s (split down)
bind z resize-pane -Z                     # toggle zoom
bind L set key-table locked               # locked mode (exit: M-Escape only)
bind l copy-mode                          # scroll mode = copy-mode
bind o set key-table session
bind p set key-table pane
bind t set key-table tab
# Quit: themed confirm dialog in a popup (Phase 2; parity with
# zellij-quit-confirm). Geometry mirrors the zellij fixed-cell dialog.
bind q display-popup -E -B -w 52 -h 13 -e "COLORTERM=truecolor" "{{ .chezmoi.homeDir }}/.config/mux/scripts/tmux-modal --origin '#{pane_id}' -- {{ .chezmoi.homeDir }}/.config/mux/scripts/mux-quit-confirm"
# copy-pwd: the script is already PID-parameterized (the zellij side passes
# the plugin's {pid}); tmux hands it the pane's root process directly.
bind Y run-shell 'zsh ~/.config/zellij/scripts/copy-pwd --relative #{pane_pid}'
bind M-y run-shell 'zsh ~/.config/zellij/scripts/copy-pwd --absolute #{pane_pid}'
bind , run-shell 'zsh ~/.config/zellij/scripts/edit-terminal-config'
# Alarms (D6 basics — flag styling + Hammerspoon notify land in Phase 4).
bind i setw monitor-silence 30 \; display "alarm: idle 30s"
bind u setw monitor-activity on \; display "alarm: activity"
bind k setw monitor-silence 0 \; setw monitor-activity off \; display "alarms cleared"
# Leader-again passes the chord through to the app (zellij: leader exits mode;
# here the pane gets the raw M-w, which is the closest useful equivalent).
bind M-w send-prefix

# ---------------------------------------------------------------------------
# Root table — vim/fzf-aware navigation (D4 fast lane / D13)
# ---------------------------------------------------------------------------
# Fast lane: a live process-table check of the pane's tty (the canonical
# vim-tmux-navigator probe, extended with fzf). NOT @pane-is-vim /
# pane_current_command, both of which fail here: smart-splits.nvim is
# lazy-loaded on its keys, so it can't stamp @pane-is-vim before tmux
# forwards a key (chicken-and-egg), and widget-spawned fzf (zsh C-t /
# completion) stays in zsh's process group so pane_current_command reports
# "zsh". The ps probe catches both; once a key reaches nvim, smart-splits
# loads and stamps @pane-is-vim for the C-S resize binds below (the zellij
# twin of all this is the context-keys `when fzf` clause + vim-navigator).
%hidden is_passthru="ps -o state= -o comm= -t '#{pane_tty}' | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?(g?(view|l?n?vim?x?)(diff)?|fzf)$'"
bind -n C-h if "$is_passthru" 'send-keys C-h' 'select-pane -L'
bind -n C-j if "$is_passthru" 'send-keys C-j' 'select-pane -D'
bind -n C-k if "$is_passthru" 'send-keys C-k' 'select-pane -U'
bind -n C-l if "$is_passthru" 'send-keys C-l' 'select-pane -R'
bind -n C-Left  if "$is_passthru" 'send-keys C-Left'  'select-pane -L'
bind -n C-Down  if "$is_passthru" 'send-keys C-Down'  'select-pane -D'
bind -n C-Up    if "$is_passthru" 'send-keys C-Up'    'select-pane -U'
bind -n C-Right if "$is_passthru" 'send-keys C-Right' 'select-pane -R'
# Resize: Ctrl+Shift + hjkl/arrows, increases toward the pressed direction
# (mirrors the vim-navigator resize_mod "ctrl+shift" alias config).
bind -n C-S-h if -F '#{@pane-is-vim}' 'send-keys C-S-h' 'resize-pane -L 2'
bind -n C-S-j if -F '#{@pane-is-vim}' 'send-keys C-S-j' 'resize-pane -D 2'
bind -n C-S-k if -F '#{@pane-is-vim}' 'send-keys C-S-k' 'resize-pane -U 2'
bind -n C-S-l if -F '#{@pane-is-vim}' 'send-keys C-S-l' 'resize-pane -R 2'
# WezTerm folds shift into the letter for ctrl+shift chords: the key arrives
# named C-H, not C-S-h (Mode B probe, 2026-07-24). Bind the uppercase twins;
# both names forward the canonical C-S-* form to vim.
bind -n C-H if -F '#{@pane-is-vim}' 'send-keys C-S-h' 'resize-pane -L 2'
bind -n C-J if -F '#{@pane-is-vim}' 'send-keys C-S-j' 'resize-pane -D 2'
bind -n C-K if -F '#{@pane-is-vim}' 'send-keys C-S-k' 'resize-pane -U 2'
bind -n C-L if -F '#{@pane-is-vim}' 'send-keys C-S-l' 'resize-pane -R 2'
bind -n C-S-Left  if -F '#{@pane-is-vim}' 'send-keys C-S-Left'  'resize-pane -L 2'
bind -n C-S-Down  if -F '#{@pane-is-vim}' 'send-keys C-S-Down'  'resize-pane -D 2'
bind -n C-S-Up    if -F '#{@pane-is-vim}' 'send-keys C-S-Up'    'resize-pane -U 2'
bind -n C-S-Right if -F '#{@pane-is-vim}' 'send-keys C-S-Right' 'resize-pane -R 2'
# NB: the tm-scrub context routes (J/K/H/L, Shift+arrows, Shift+A/S over
# yazi/hunk/diffnav panes) are deliberately NOT bound yet — bare capitals are
# too hot to intercept before their consumer exists under tmux (Phase 6.4
# wires them against the @ctx pane option the tm wrapper already stamps).

# ---------------------------------------------------------------------------
# tab table (zellij "tab" mode)
# ---------------------------------------------------------------------------
bind -T tab Escape set key-table root
bind -T tab h previous-window
bind -T tab Left previous-window
bind -T tab l next-window
bind -T tab Right next-window
bind -T tab Tab last-window
bind -T tab 1 select-window -t :=1 \; set key-table root
bind -T tab 2 select-window -t :=2 \; set key-table root
bind -T tab 3 select-window -t :=3 \; set key-table root
bind -T tab 4 select-window -t :=4 \; set key-table root
bind -T tab 5 select-window -t :=5 \; set key-table root
bind -T tab 6 select-window -t :=6 \; set key-table root
bind -T tab 7 select-window -t :=7 \; set key-table root
bind -T tab 8 select-window -t :=8 \; set key-table root
bind -T tab 9 select-window -t :=9 \; set key-table root
bind -T tab 0 select-window -t :=10 \; set key-table root
# Rename: themed input::line dialog in a popup (Phase 2.4).
bind -T tab n set key-table root \; display-popup -E -B -w 66 -h 14 -e "COLORTERM=truecolor" "{{ .chezmoi.homeDir }}/.config/mux/scripts/tmux-modal --origin '#{pane_id}' -- {{ .chezmoi.homeDir }}/.config/mux/scripts/mux-rename window"
bind -T tab N new-window \; set key-table root
bind -T tab P break-pane \; set key-table root
bind -T tab x kill-window \; set key-table root
# BreakPaneLeft/Right approximation: fold this window's pane into the
# neighbor window (zellij makes the tab become a pane there). Ledger row —
# semantics differ when the window has several panes.
bind -T tab [ join-pane -h -t :-1 \; set key-table root
bind -T tab ] join-pane -h -t :+1 \; set key-table root
bind -T tab s setw synchronize-panes \; set key-table root
# T — quick-launch tab picker lands here in Phase 3.

# ---------------------------------------------------------------------------
# pane table (zellij "pane" mode)
# ---------------------------------------------------------------------------
bind -T pane Escape set key-table root
bind -T pane m set key-table move
bind -T pane r set key-table resize
bind -T pane h select-pane -L
bind -T pane j select-pane -D
bind -T pane k select-pane -U
bind -T pane l select-pane -R
bind -T pane Left select-pane -L
bind -T pane Down select-pane -D
bind -T pane Up select-pane -U
bind -T pane Right select-pane -R
bind -T pane Tab select-pane -t :.+
bind -T pane n set key-table root \; display-popup -E -B -w 66 -h 14 -e "COLORTERM=truecolor" "{{ .chezmoi.homeDir }}/.config/mux/scripts/tmux-modal --origin '#{pane_id}' -- {{ .chezmoi.homeDir }}/.config/mux/scripts/mux-rename pane"
bind -T pane N split-window \; set key-table root
bind -T pane H split-window -hb \; set key-table root
bind -T pane J split-window -v \; set key-table root
bind -T pane K split-window -vb \; set key-table root
bind -T pane L split-window -h \; set key-table root
bind -T pane S-Left split-window -hb \; set key-table root
bind -T pane S-Down split-window -v \; set key-table root
bind -T pane S-Up split-window -vb \; set key-table root
bind -T pane S-Right split-window -h \; set key-table root
bind -T pane z resize-pane -Z \; set key-table root
bind -T pane x kill-pane \; set key-table root
# No stacked panes / pin / embed↔float toggle: no tmux equivalent needed
# (§6 dispositions — stacked unused, pin only meaningful for non-modal
# floats, popups are modal). P — quick-launch pane picker lands in Phase 3.

# ---------------------------------------------------------------------------
# resize table (zellij "resize" mode; repeatable binds)
# ---------------------------------------------------------------------------
bind -T resize Escape set key-table root
bind -T resize h resize-pane -L 2
bind -T resize j resize-pane -D 2
bind -T resize k resize-pane -U 2
bind -T resize l resize-pane -R 2
bind -T resize Left resize-pane -L 2
bind -T resize Down resize-pane -D 2
bind -T resize Up resize-pane -U 2
bind -T resize Right resize-pane -R 2
bind -T resize H resize-pane -R 2
bind -T resize J resize-pane -U 2
bind -T resize K resize-pane -D 2
bind -T resize L resize-pane -L 2
bind -T resize S-Left resize-pane -R 2
bind -T resize S-Down resize-pane -U 2
bind -T resize S-Up resize-pane -D 2
bind -T resize S-Right resize-pane -L 2
bind -T resize - resize-pane -D 2
bind -T resize + resize-pane -U 2
bind -T resize = resize-pane -U 2

# ---------------------------------------------------------------------------
# move table (zellij "move" mode)
# ---------------------------------------------------------------------------
# tmux has no directional pane swap; swap-pane -U/-D walk the pane order.
# Ledger row documents the divergence (h/l rotate the whole window).
bind -T move Escape set key-table root
bind -T move j swap-pane -D
bind -T move k swap-pane -U
bind -T move Down swap-pane -D
bind -T move Up swap-pane -U
bind -T move h rotate-window -U
bind -T move l rotate-window -D
bind -T move Left rotate-window -U
bind -T move Right rotate-window -D
bind -T move Tab swap-pane -D
bind -T move BTab swap-pane -U

# ---------------------------------------------------------------------------
# session table (zellij "session" mode)
# ---------------------------------------------------------------------------
bind -T session Escape set key-table root
bind -T session d detach-client
bind -T session w choose-tree -Zs \; set key-table root
# S — quick-launch workspace picker lands here in Phase 3. The zellij-only
# chrome rows (about/configuration/plugin-manager/share) have no tmux
# equivalent (§6 dispositions) — ledger.

# ---------------------------------------------------------------------------
# locked table (zellij "locked" mode — maximum passthrough)
# ---------------------------------------------------------------------------
# Every keypress including Escape flows to the app; the single exit is
# M-Escape, a combo uncommon enough that no shell or TUI claims it.
bind -T locked M-Escape set key-table root

# ---------------------------------------------------------------------------
# nested table — D14: filled by the Phase 3 nested_mux builder (outer
# session gets `prefix None` + this table with only C-M-Space → picker).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# copy-mode additions (zellij scroll/search parity; D11/D12 stage 1)
# ---------------------------------------------------------------------------
# V — EditScrollback: dump history into nvim in a new window (zellij `V`).
bind -T copy-mode-vi V run-shell 'f=$(mktemp /tmp/tmux-scrollback.XXXXXX); tmux capture-pane -p -S - >"$f"; tmux new-window -n scrollback "nvim +\$ $f"' \; send -X cancel
# n/p — prompt jumps via OSC 133 marks (zj-prompt-jumper parity; the marks
# come from the zsh precmd emitter, functions.d/prompt-marks.sh). tmux has
# ONE copy-mode where zellij splits scroll vs search, and `n` is also
# search-next there: search-aware dispatch keeps both muscle memories
# (search active → next match; else → next prompt). Ledger row.
bind -T copy-mode-vi n if -F '#{search_present}' { send -X search-again } { send -X next-prompt }
bind -T copy-mode-vi N if -F '#{search_present}' { send -X search-reverse } { send -X previous-prompt }
bind -T copy-mode-vi p send -X previous-prompt
# / — forward incremental search (D12 stage 1; the floating search dialog
# with option toggles is the D12 stage 2 hud follow-up).
bind -T copy-mode-vi / command-prompt -i -p '/' 'send -X search-forward-incremental "%%%"'

# ---------------------------------------------------------------------------
# Status v0 — bare key-table mode indicator (the themed bar is Phase 4, D6)
# ---------------------------------------------------------------------------
set -g status-left '#{?#{==:#{client_key_table},root},,[#{client_key_table}] }'
set -g status-right ''

# ---------------------------------------------------------------------------
# Pickers (Phase 2) — glyph / gitmoji / clipboard popups via tmux-modal.
# The zellij twins are the zellijModalRun keybinds (config.kdl); geometry and
# chrome contract match (fzf owns the box, -B borderless popup). The libexec
# pickers are called directly — the pick-*-zellij thins carry zellij-only
# glue; resume variants (prefix U/G) reopen with --resume like the leader
# chords.
bind -n C-S-u display-popup -E -B -w 70% -h 60% -e "COLORTERM=truecolor" "{{ .chezmoi.homeDir }}/.config/mux/scripts/tmux-modal --origin '#{pane_id}' --title 'Glyph Picker' --inject --no-chrome -- {{ .chezmoi.homeDir }}/.local/libexec/pick-glyph"
bind -n C-S-g display-popup -E -B -w 70% -h 60% -e "COLORTERM=truecolor" "{{ .chezmoi.homeDir }}/.config/mux/scripts/tmux-modal --origin '#{pane_id}' --title 'Gitmoji Picker' --inject --no-chrome -- {{ .chezmoi.homeDir }}/.local/libexec/pick-gitmoji"
# Uppercase twins: WezTerm folds shift into the letter for ctrl+shift chords
# (arrives as C-U / C-G — same finding as the resize binds above).
bind -n C-U display-popup -E -B -w 70% -h 60% -e "COLORTERM=truecolor" "{{ .chezmoi.homeDir }}/.config/mux/scripts/tmux-modal --origin '#{pane_id}' --title 'Glyph Picker' --inject --no-chrome -- {{ .chezmoi.homeDir }}/.local/libexec/pick-glyph"
bind -n C-G display-popup -E -B -w 70% -h 60% -e "COLORTERM=truecolor" "{{ .chezmoi.homeDir }}/.config/mux/scripts/tmux-modal --origin '#{pane_id}' --title 'Gitmoji Picker' --inject --no-chrome -- {{ .chezmoi.homeDir }}/.local/libexec/pick-gitmoji"
bind U display-popup -E -B -w 70% -h 60% -e "COLORTERM=truecolor" "{{ .chezmoi.homeDir }}/.config/mux/scripts/tmux-modal --origin '#{pane_id}' --title 'Glyph Picker (resumed)' --inject --no-chrome -- {{ .chezmoi.homeDir }}/.local/libexec/pick-glyph --resume"
bind G display-popup -E -B -w 70% -h 60% -e "COLORTERM=truecolor" "{{ .chezmoi.homeDir }}/.config/mux/scripts/tmux-modal --origin '#{pane_id}' --title 'Gitmoji Picker (resumed)' --inject --no-chrome -- {{ .chezmoi.homeDir }}/.local/libexec/pick-gitmoji --resume"
bind c display-popup -E -B -w 70% -h 75% -e "COLORTERM=truecolor" "{{ .chezmoi.homeDir }}/.config/mux/scripts/tmux-modal --origin '#{pane_id}' --title 'Clipboard history' --inject --no-chrome -- {{ .chezmoi.homeDir }}/.local/libexec/pick-clipboard"

# ---------------------------------------------------------------------------
# Quick-launch (Phase 3) — pickers in popups, dispatch via the ql_tx_* twins.
# Chords mirror the zellij mode chords: tab-T, pane-P, session-S. The picker
# emits an id (or @window:<id> on Alt+Enter) and quick-launch dispatches.
bind -T tab T set key-table root \; display-popup -E -B -w 70% -h 60% -e "COLORTERM=truecolor" "{{ .chezmoi.homeDir }}/.config/mux/scripts/tmux-modal --origin '#{pane_id}' --title 'Quick Launch — Tab' --no-chrome -- {{ .chezmoi.homeDir }}/.config/zellij/scripts/quick-launch menu tab"
bind -T pane P set key-table root \; display-popup -E -B -w 70% -h 70% -e "COLORTERM=truecolor" "{{ .chezmoi.homeDir }}/.config/mux/scripts/tmux-modal --origin '#{pane_id}' --title 'Quick Launch — Pane' --no-chrome -- {{ .chezmoi.homeDir }}/.config/zellij/scripts/quick-launch menu pane"
bind -T session S set key-table root \; display-popup -E -B -w 70% -h 60% -e "COLORTERM=truecolor" "{{ .chezmoi.homeDir }}/.config/mux/scripts/tmux-modal --origin '#{pane_id}' --title 'Quick Launch — Workspace' --no-chrome -- {{ .chezmoi.homeDir }}/.config/zellij/scripts/quick-launch menu workspace"
# nested table (D14): the sole escape hatch from a nested-mux outer session.
bind -T nested C-M-Space display-popup -E -B -w 70% -h 60% -e "COLORTERM=truecolor" "{{ .chezmoi.homeDir }}/.config/mux/scripts/tmux-modal --title 'Quick Launch — Workspace' --no-chrome -- {{ .chezmoi.homeDir }}/.config/zellij/scripts/quick-launch menu workspace"
