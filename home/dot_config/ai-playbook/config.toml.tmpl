{{- /*
  ai-playbook config — chezmoi-managed template.
  Target: ~/.config/ai-playbook/config.toml

  Selects the model harness per machine profile and points the mux integration
  at our backend-agnostic shim. Only the keys set here override ai-playbook's
  baked-in defaults; everything else (models, thinking, kb, driver) falls
  through to the per-harness defaults. Edit THIS template, not the rendered
  file, then `chezmoi apply`.

  Harness per profile — an explicit map so a new profile picks
  deliberately (default claude). work + dev-shell drive cursor;
  personal + server use claude (cursor never deploys there).
*/ -}}
{{- $harness := "claude" -}}
{{- if or (eq .profile "work") (eq .profile "dev-shell") }}{{ $harness = "cursor" }}{{ end -}}
{{- $mp := printf "%s/.config/mux/scripts/mux-playbook" .chezmoi.homeDir -}}
[mux]
# ai-playbook's mux is opt-in by config and ships ONE preset — zellij, hardcoded
# as `zellij action …` with no runtime detection (its ADR-0007). Under tmux every
# action silently did nothing, so Ctrl+Alt+A opened a blank pane. `backend` is
# only a tier-1 on/off selector, and any name other than "zellij" simply requires
# all five templates to be overridden — which is what we do here: every action
# goes through our shim wrapper, which resolves zellij-vs-tmux PER CALL from the
# pane it is invoked in. One config, both backends, no knob to flip.
#
# These are argv templates, not shell — no ~ expansion, hence the absolute path.
backend = "mux"
open-floating-pane = "{{ $mp }} float --width {width} --height {height} {cwdarg} {namearg} -- {cmd}"
open-input-float = "{{ $mp }} input --width {width} --height {height} {cwdarg} -- {cmd}"
open-docked-pane = "{{ $mp }} docked {cwdarg} {namearg} -- {cmd}"
dump-screen = "{{ $mp }} dump {panearg}"
# --pane-id keeps the play action off the focused pane (a closing float) and on
# the pane the request came from. ai-playbook strips the flag AND its value when
# it cannot resolve an origin pane, so this never degrades into a dangling flag.
type-into-pane = "{{ $mp }} type --pane-id {pane} {text}"

[agent]
# Profile-selected: {{ .profile }} -> {{ $harness }}.
harness = "{{ $harness }}"
{{- if eq $harness "cursor" }}
# cursor's model catalog is subscription-scoped (`cursor-agent --list-models`).
# Escalation on a capable, fast-served Opus; triage on a cheap flash model
# (triage fires on every assist, so keep it cheap).
model = "claude-opus-4-8-thinking-high-fast"
triage_model = "gemini-3.5-flash"
{{- end }}

# vim:ft=toml
