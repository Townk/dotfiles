# llama-swap - single OpenAI-compatible endpoint (:8000) that hot-swaps
# between per-model mlx_lm/mlx_vlm backends. Each model is its own server
# process so the fast text path can use mlx_lm while multimodal/MTP models use
# mlx_vlm; only one is resident at a time (llama-swap evicts the previous model
# on switch and unloads on idle via ttl). Managed by chezmoi - edit the source under
# ~/.local/share/chezmoi, then `chezmoi apply`.
#
# Macro notes:
#   ${PORT} / ${MODEL_ID}  - llama-swap macros (chezmoi leaves these alone).
#   The home dir in the paths below is rendered absolute at apply time, since
#   the launchd-spawned backend gets no shell ~ expansion.
# useModelName forwards the on-disk path the backend preloaded with, so the
# request's `model` id matches the cache and never triggers a reload.

healthCheckTimeout: 900
startPort: 8001
logLevel: info
logToStdout: both

# Keep the active model resident long enough for agent sessions and follow-up
# tool calls. Cold swaps dominate perceived TPS on local models.
globalTTL: 7200

models:
  # Qwen 3.6 35B-A3B MoE - primary local coding model. Direct benchmarks showed
  # mlx_lm.server without a drafter clears the 25 TPS floor for normal turns.
  "Qwen3.6-35B-A3B-6bit":
    cmd: |
      mlx_lm.server
      --model {{ .chezmoi.homeDir }}/.local/share/mlx/models/Qwen3.6-35B-A3B-6bit
      --max-tokens 2048
      --prompt-cache-size 4
      --prompt-cache-bytes 2147483648
      --host 127.0.0.1 --port ${PORT}
    useModelName: "{{ .chezmoi.homeDir }}/.local/share/mlx/models/Qwen3.6-35B-A3B-6bit"

  # Gemma 4 12B IT - assistant-drafter MTP (mirrors the verified command).
  "gemma-4-12B-it-8bit":
    cmd: |
      mlx_vlm.server
      --model {{ .chezmoi.homeDir }}/.local/share/mlx/models/gemma-4-12B-it-8bit
      --draft-model {{ .chezmoi.homeDir }}/.local/share/mlx/models/gemma-4-12B-it-assistant-8bit
      --draft-kind mtp
      --draft-block-size 4
      --max-tokens 2048
      --top-logprobs-k 0
      --host 127.0.0.1 --port ${PORT}
    useModelName: "{{ .chezmoi.homeDir }}/.local/share/mlx/models/gemma-4-12B-it-8bit"
