# llama-swap - single OpenAI-compatible endpoint (:8000) that hot-swaps
# between per-model mlx_lm/mlx_vlm backends. Each model is its own
# mlx_vlm.server process so it keeps its own MTP draft config; only one is
# resident at a time (llama-swap evicts the previous model on switch and
# unloads on idle via ttl). Managed by chezmoi - edit the source under
# ~/.local/share/chezmoi, then `chezmoi apply`.
#
# Macro notes:
#   ${PORT} / ${MODEL_ID}  - llama-swap macros (chezmoi leaves these alone).
#   The home dir in the paths below is rendered absolute at apply time, since
#   the launchd-spawned backend gets no shell ~ expansion.
# useModelName forwards the on-disk path the backend preloaded with, so the
# request's `model` id matches the cache and never triggers a reload.

healthCheckTimeout: 600
startPort: 8001
logLevel: info
logToStdout: both

# Unload an idle model after 30 min to release unified memory.
globalTTL: 1800

models:
  # Qwen 3.6 27B - target + pre-split MTP drafter from mlx-community.
  # The drafter card documents block size 2 and mlx-vlm as the runtime.
  "Qwen3.6-27B-4bit":
    cmd: |
      mlx_vlm.server
      --model {{ .chezmoi.homeDir }}/.local/share/mlx/models/Qwen3.6-27B-4bit
      --draft-model {{ .chezmoi.homeDir }}/.local/share/mlx/models/Qwen3.6-27B-MTP-4bit
      --draft-kind mtp
      --draft-block-size 2
      --host 127.0.0.1 --port ${PORT}
    useModelName: "{{ .chezmoi.homeDir }}/.local/share/mlx/models/Qwen3.6-27B-4bit"

  # Gemma 4 12B IT - assistant-drafter MTP (mirrors the verified command).
  "gemma-4-12B-it-8bit":
    cmd: |
      mlx_vlm.server
      --model {{ .chezmoi.homeDir }}/.local/share/mlx/models/gemma-4-12B-it-8bit
      --draft-model {{ .chezmoi.homeDir }}/.local/share/mlx/models/gemma-4-12B-it-assistant-8bit
      --draft-kind mtp
      --draft-block-size 2
      --host 127.0.0.1 --port ${PORT}
    useModelName: "{{ .chezmoi.homeDir }}/.local/share/mlx/models/gemma-4-12B-it-8bit"
