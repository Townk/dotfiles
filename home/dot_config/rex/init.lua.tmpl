{{- /*
  Rex config, generated. Two halves:

    1. a hand-written header: the helper actions (run-then-leave-the-mode,
       Quick Launch on the native picker, the few entries that run one of our
       scripts);
    2. the key bindings, generated from home/.chezmoidata/keymap.yaml — the
       same file the tmux key tables and the which-key panel come from. Each
       leader-table entry carries a `rex:` answer next to its tmux `cmd:`,
       and `keymap.direct` lists the Cmd chords.

  Three named templates do the generating. "rexkey" turns a tmux key name
  into Rex's spelling and FAILS the render on a name it does not know — a key
  passed through unchanged would bind nothing and say nothing. "rexargs"
  prints an args map as a Lua table. "rexbind" prints one binding.
*/ -}}
{{- define "rexkey" -}}
{{- $k := . -}}
{{- $m := "" -}}
{{- range (list 1 2 3) -}}
{{-   if regexMatch "^S-." $k }}{{ $m = print $m "shift+" }}{{ $k = substr 2 (len $k) $k }}{{ end -}}
{{-   if regexMatch "^M-." $k }}{{ $m = print $m "alt+" }}{{ $k = substr 2 (len $k) $k }}{{ end -}}
{{-   if regexMatch "^C-." $k }}{{ $m = print $m "ctrl+" }}{{ $k = substr 2 (len $k) $k }}{{ end -}}
{{- end -}}
{{- $names := dict "Up" "up" "Down" "down" "Left" "left" "Right" "right" "Tab" "tab" "Enter" "enter" "BSpace" "backspace" "Escape" "escape" "Space" "space" "Home" "home" "End" "end" "PageUp" "pageup" "PageDown" "pagedown" -}}
{{- if hasKey $names $k }}{{ $m }}{{ get $names $k }}
{{- else if regexMatch "^[A-Z]$" $k }}{{ $m }}shift+{{ lower $k }}
{{- else if eq $k "+" }}{{ $m }}shift+=
{{- else if eq (len $k) 1 }}{{ $m }}{{ $k }}
{{- else }}{{ fail (printf "keymap.yaml: no Rex spelling for key %q" .) }}
{{- end -}}
{{- end -}}

{{- /* luastr: a Lua string literal, the text as it is. `quote` will not do for a
       label: it writes a private-use codepoint (every Nerd Font icon) as
       \U000f0455, which Lua 5.1 does not read as a character. */ -}}
{{- define "luastr" -}}
"{{ . | replace "\\" "\\\\" | replace "\"" "\\\"" }}"
{{- end -}}

{{- define "rexargs" -}}
{ {{- $first := true -}}
{{- range $k, $v := . -}}
{{- if not $first }},{{ end }} {{ $k }} = {{ if kindIs "string" $v }}{{ $v | quote }}{{ else }}{{ $v }}{{ end }}
{{- $first = false -}}
{{- end }} }
{{- end -}}

{{- /* rexbind: dict "mode" <mode or ""> "key" <tmux key name, or a Rex spelling
       when mode is ""> "rex" <the entry's rex value>
       and, for a leader-table entry only: "name" <action name> "desc" <the
       entry's desc> "leave" <bool> "sticky" <bool>

       A leader-table entry is never bound to its action directly. Rex has no
       label on a binding — the key-hint overlay shows the bound action's
       title — so each entry gets an action of its own, titled with its desc
       (km_leave / km_stay in the header), and the key is bound to that.

       leave = the binding must end the mode. True for a client action and
       for a Quick Launch picker (ql_*): the mode, and with it the overlay,
       has to be gone BEFORE the picker opens, and an action cannot leave a
       mode while it is still running — what it queues runs after it returns.
       Our other actions leave the mode themselves, and a sticky entry keeps
       it: both go through km_stay. sticky also makes the wrapper repeat while
       the key is held, as the motions it wraps do when bound directly.

       A direct chord carries no name and is bound to its action as is. */ -}}
{{- define "rexbind" -}}
{{- $act := "" -}}
{{- $args := dict -}}
{{- if kindIs "string" .rex -}}
{{-   $act = .rex -}}
{{- else -}}
{{-   $act = .rex.action -}}
{{-   $args = (.rex.args | default dict) -}}
{{- end -}}
{{- if and (hasKey . "name") .leave (or (contains "." $act) (hasPrefix "ql_" $act)) -}}
rex.bind("{{ if .mode }}{{ .mode }}/{{ template "rexkey" .key }}{{ else }}{{ .key }}{{ end }}", km_leave({{ .name | quote }}, {{ template "luastr" .desc }}, {{ $act | quote }}{{ if $args }}, {{ template "rexargs" $args }}{{ end }}))
{{- else if hasKey . "name" -}}
rex.bind("{{ if .mode }}{{ .mode }}/{{ template "rexkey" .key }}{{ else }}{{ .key }}{{ end }}", km_stay({{ .name | quote }}, {{ template "luastr" .desc }}, {{ .sticky }}, {{ $act | quote }}{{ if $args }}, {{ template "rexargs" $args }}{{ end }}))
{{- else if $args -}}
rex.bind("{{ if .mode }}{{ .mode }}/{{ template "rexkey" .key }}{{ else }}{{ .key }}{{ end }}", {{ $act | quote }}, {{ template "rexargs" $args }})
{{- else -}}
rex.bind("{{ if .mode }}{{ .mode }}/{{ template "rexkey" .key }}{{ else }}{{ .key }}{{ end }}", {{ $act | quote }})
{{- end -}}
{{- end -}}
-- ~/.config/rex/init.lua — GENERATED by chezmoi. Do not edit: change
-- home/dot_config/rex/init.lua.tmpl (the actions) or
-- home/.chezmoidata/keymap.yaml (the keys), then `chezmoi apply`.
--
-- Rex is the terminal and the multiplexer in one, so this file replaces what
-- took three under tmux: the terminal's key forwarding, tmux's key tables,
-- and the popup plumbing in between.

local HOME = {{ .chezmoi.homeDir | quote }}
local SCRIPTS = HOME .. "/.config/mux/scripts"

-- What a script started from here needs to find its tools and to know where
-- "here" is. rex.exec runs commands in the SERVER's environment, which has
-- neither the login shell's PATH nor any idea which pane is focused — so
-- both are passed explicitly. TMUX/ZELLIJ are blanked for the case of a
-- server that was itself started from inside one: the scripts would read an
-- inherited value as "I am in a tmux pane".
local function pane_env(ctx)
  return {
    PATH = HOME .. "/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
    REX_SESSION = ctx.session_id or "",
    REX_BLOCK = ctx.block_id or "",
    -- These scripts are run from the picker: a focus change they make now
    -- loses to the palette closing, so they hand it back instead.
    QL_DEFER_FOCUS = "1",
    TMUX = "",
    ZELLIJ = "",
  }
end

-- Run one of our scripts for the focused pane. Returns the exec result, or
-- nil after logging why it could not run or failed.
local function run_script(ctx, argv)
  local r, err = rex.exec(argv, { env = pane_env(ctx), timeout = 30 })
  if r == nil then
    rex.log("error", table.concat(argv, " ") .. ": " .. tostring(err))
    return nil
  end
  if not r.ok then
    rex.log("warn", table.concat(argv, " ") .. " exited " .. tostring(r.code) .. ": " .. (r.stderr or ""))
    return nil
  end
  return r
end

---------------------------------------------------------------------------
-- Modes
---------------------------------------------------------------------------

-- Every leader-table entry is bound to an action of its own instead of to
-- the action it runs: Rex has no label on a binding, and the key-hint
-- overlay shows the bound action's title. Bound directly, a key read as
-- Rex's own wording ("Focus Pane", "Enter Mode"); behind one shared wrapper,
-- every key read as that wrapper. This way each reads as its keymap.yaml
-- desc. Both helpers return the action's name, so they sit where rex.bind
-- wants one; an entry with several keys asks for the same name each time and
-- the action is defined once.
-- Rex draws its own UI text (this overlay, tab titles) with the Symbols Nerd
-- Font it bundles — upstream's, not ours — for every icon that copy has, and
-- only falls back to the installed fonts for a codepoint it lacks. Our build
-- therefore carries each Private Use icon at a second, MIRROR codepoint that
-- no upstream font has (custom-builds/nerd-fonts/fontbuild/mirror.py), and a
-- label is rewritten to use those, so it is drawn from our font. The offsets
-- are MIRROR_RANGES in fontbuild/ranges.py and must match it:
--   U+E000..U+F8FF    + 0xFA000  (three UTF-8 bytes, lead 0xEE/0xEF)
--   U+F0000..U+F1FFF  + 0x1A000  (four UTF-8 bytes, 0xF3 0xB0/0xB1 ..)
-- Lua 5.1 has no UTF-8 library, hence the byte arithmetic.
local function utf8_4(cp)
  return string.char(
    240 + math.floor(cp / 262144),
    128 + math.floor(cp / 4096) % 64,
    128 + math.floor(cp / 64) % 64,
    128 + cp % 64)
end
local function ui_glyphs(s)
  s = s:gsub("[\238\239][\128-\191][\128-\191]", function(c)
    local b1, b2, b3 = c:byte(1, 3)
    local cp = (b1 - 224) * 4096 + (b2 - 128) * 64 + (b3 - 128)
    if cp >= 0xE000 and cp <= 0xF8FF then return utf8_4(cp + 0xFA000) end
  end)
  s = s:gsub("\243[\176\177][\128-\191][\128-\191]", function(c)
    local b1, b2, b3, b4 = c:byte(1, 4)
    local cp = (b1 - 240) * 262144 + (b2 - 128) * 4096 + (b3 - 128) * 64 + (b4 - 128)
    return utf8_4(cp + 0x1A000)
  end)
  return s
end

local km_defined = {}
local function km_define(name, title, leave, repeats, action, args)
  if not km_defined[name] then
    km_defined[name] = true
    rex.action{
      name     = name,
      title    = ui_glyphs(title),
      category = "Keymap",
      repeats  = repeats,
      run      = function(ctx, _)
        if leave then rex.client.queue("client.mode.exit_all") end
        rex.client.queue(action, args or {})
      end,
    }
  end
  return name
end

-- An entry that is not sticky: leave every mode, then do the thing — tmux's
-- `set key-table root ; <cmd>`. In that order, so that an action which waits
-- on the user (a Quick Launch picker) does not sit under the mode's key-hint
-- overlay: queued actions run one after the other, and only once this one
-- has returned.
local function km_leave(name, title, action, args)
  return km_define(name, title, true, false, action, args)
end

-- An entry that leaves the mode stack alone: a sticky one (a motion, which
-- repeats while the key is held), one that enters another mode, or one of
-- our own actions, which leaves the mode itself.
local function km_stay(name, title, repeats, action, args)
  return km_define(name, title, false, repeats, action, args)
end

---------------------------------------------------------------------------
-- Quick Launch
---------------------------------------------------------------------------
-- The targets, their merge rules and the dispatch all stay in
-- ~/.config/mux/scripts/quick-launch. This is only the picker: rows come
-- from `quick-launch rows <kind>` (tab-separated: id, title, subtitle, icon,
-- detail — already in display order), the choice goes back through
-- `quick-launch pick <kind> <id>`. The script answers with
-- `@select:<session-id> [<window-id>]` when the app has to be moved —
-- to another session, or to another tab of this one. Both are client
-- actions the script has no way to perform: it can make a window the
-- session's active one on the server, and the app's tab selection stays
-- where it was. A newly split pane answers `@focus:<direction>` for the
-- same reason.

local function split_tabs(line)
  local fields = {}
  for field in (line .. "\t"):gmatch("(.-)\t") do
    fields[#fields + 1] = field
  end
  return fields
end

local function quick_launch(kind, title)
  return function(ctx, args)
    -- Leave the leader mode whichever way this ends (queued actions run
    -- after `run` returns).
    rex.client.queue("client.mode.exit_all")

    local rows = run_script(ctx, { SCRIPTS .. "/quick-launch", "rows", kind })
    if rows == nil then return end

    local items = {}
    for line in rows.stdout:gmatch("[^\n]+") do
      local f = split_tabs(line)
      if f[1] and f[1] ~= "" then
        items[#items + 1] = {
          id       = f[1],
          title    = (f[2] and f[2] ~= "") and f[2] or f[1],
          subtitle = (f[3] and f[3] ~= "") and f[3] or nil,
          icon     = (f[4] and f[4] ~= "") and f[4] or nil,
          detail   = (f[5] and f[5] ~= "") and f[5] or nil,
        }
      end
    end

    local id, why = rex.ui.pick{
      title       = title,
      placeholder = "Filter",
      items       = items,
    }
    if id == nil then
      if why ~= "cancelled" then rex.log("warn", "quick launch " .. kind .. ": " .. tostring(why)) end
      return
    end

    local opened = run_script(ctx, { SCRIPTS .. "/quick-launch", "pick", kind, id })
    if opened == nil then return end
    local session = opened.stdout:match("@select:(%S+)")
    local window = opened.stdout:match("@select:%S+ (window:%S+)")
    if session then
      rex.client.queue("session.select", { session_id = session, window_id = window })
    end
    -- A new pane is split off the focused one without taking focus, and
    -- the script names the side it is on: the app's focus does not follow
    -- a focus change made on the server while the palette is closing, and
    -- no client action focuses a pane by id.
    local side = opened.stdout:match("@focus:(%a+)")
    if side then
      rex.client.queue("pane.focus", { direction = side })
    end
    -- A floating pane, or a pane that was already open, has no side to
    -- name. The app does follow a focus change made on the server — only
    -- not while the palette is closing — so that one is made a moment
    -- later, by a command that outlives this action.
    local block = opened.stdout:match("@focus%-block:(%S+)")
    if block then
      local h, err = rex.exec.start(
        { SCRIPTS .. "/quick-launch", "focus-later", block },
        { env = pane_env(ctx), detach = true })
      if h == nil then rex.log("warn", "quick launch focus-later: " .. tostring(err)) end
    end
  end
end

rex.action{ name = "ql_workspace", title = "Quick Launch: Session…", category = "Quick Launch",
            run = quick_launch("workspace", "Quick Launch — Session") }
rex.action{ name = "ql_tab", title = "Quick Launch: Tab…", category = "Quick Launch",
            run = quick_launch("tab", "Quick Launch — Tab") }
rex.action{ name = "ql_pane", title = "Quick Launch: Pane…", category = "Quick Launch",
            run = quick_launch("pane", "Quick Launch — Pane") }

---------------------------------------------------------------------------
-- Script-backed entries
---------------------------------------------------------------------------

rex.action{
  name  = "copy_pwd",
  title = "Copy Working Directory",
  args  = { mode = "string?" },
  run   = function(ctx, args)
    rex.client.queue("client.mode.exit_all")
    local flag = (args.mode == "absolute") and "--absolute" or "--relative"
    run_script(ctx, { SCRIPTS .. "/copy-pwd", flag })
  end,
}

rex.action{
  name  = "edit_terminal_config",
  title = "Edit Rex Config",
  run   = function(ctx, args)
    rex.client.queue("client.mode.exit_all")
    run_script(ctx, { "/bin/zsh", SCRIPTS .. "/edit-terminal-config" })
  end,
}

---------------------------------------------------------------------------
-- Close keys — ask before closing a running job's tab
---------------------------------------------------------------------------
-- Each background job has a tab in the session labelled Jobs, and closing
-- that tab cancels the job (~/.local/lib/job/rex.zsh). Rex has no close
-- confirmation, so every close key comes here. Outside the Jobs session —
-- read from the id the job opener records — the close is queued at once,
-- with no process started. Inside it, `job owns-block` says whether the
-- focused pane follows a running job; only then is the owner asked, and
-- dismissing the question keeps the tab.
local JOB_STATE_ROOT = {{ printf "%s/.local/state/jobs" .chezmoi.homeDir | quote }}
local JOB_CLI = HOME .. "/.local/libexec/job"

local function jobs_session()
  local f = io.open(JOB_STATE_ROOT .. "/.rex_session", "r")
  if not f then return nil end
  local line = f:read("*l")
  f:close()
  return line and line:match("%S+")
end

rex.action{
  name  = "close_guarded",
  title = "Close, Asking First for a Running Job",
  args  = { what = "string", leave = "boolean?" },
  run   = function(ctx, args)
    local close = (args.what == "tab") and "client.tab.close" or "pane.close"
    -- leave: bound from a mode, through km_stay, which does not leave it.
    -- Only then: outside a mode client.mode.exit_all is "not available",
    -- and a close queued behind a failed action must not depend on it.
    -- What is queued runs after this returns, so a question asked from a
    -- mode shows with the mode's key hints still up.
    if args.leave then rex.client.queue("client.mode.exit_all") end
    local jobs = jobs_session()
    if not (jobs and ctx.block_id and ctx.session_id == jobs) then
      rex.client.queue(close)
      return
    end
    local r, err = rex.exec({ JOB_CLI, "owns-block", ctx.block_id },
                            { env = pane_env(ctx), timeout = 5 })
    if r == nil then rex.log("warn", "close_guarded: job owns-block: " .. tostring(err)) end
    if not (r and r.ok) then
      rex.client.queue(close)
      return
    end
    local job = r.stdout:match("[^\n]+") or ctx.block_id
    local id, why = rex.ui.pick{
      title = "Close the running job " .. job .. "?",
      items = {
        { id = "close", title = "Cancel the job and close" },
        { id = "keep",  title = "Keep it running" },
      },
    }
    if id == "close" then
      rex.client.queue(close)
    elseif id == nil and why ~= "cancelled" then
      rex.log("warn", "close_guarded: " .. tostring(why))
    end
  end,
}

-- The watch-tasks key: show the Jobs session. `leave` as in close_guarded.
rex.action{
  name  = "jobs_show",
  title = "Show the Jobs Session",
  args  = { leave = "boolean?" },
  run   = function(_, args)
    if args.leave then rex.client.queue("client.mode.exit_all") end
    local jobs = jobs_session()
    if not jobs then
      rex.log("info", "no jobs session")
      return
    end
    rex.client.queue("session.select", { session_id = jobs })
  end,
}

---------------------------------------------------------------------------
-- Sessions
---------------------------------------------------------------------------
-- Rex shows the current session's label in the tab bar once there is more
-- than one session, and the names it generates itself are hyphenated
-- (wandering-glade). The new-session key makes the session with a name of
-- ours instead — "Wandering Glade", from the same generator the tmux side
-- uses — and moves the app to it. Sessions made with Rex's own buttons or
-- palette keep Rex's names. `leave` as in close_guarded.
rex.action{
  name  = "session_new_named",
  title = "New Session with a Readable Name",
  args  = { leave = "boolean?" },
  run   = function(ctx, args)
    if args.leave then rex.client.queue("client.mode.exit_all") end

    local named = run_script(ctx, { HOME .. "/.local/bin/mux-random-session-name", "--title" })
    local name = named and named.stdout:match("^%s*(.-)%s*$") or ""
    if name == "" then
      -- No name to give: Rex's own action still makes a session.
      rex.client.queue("session.new")
      return
    end

    local created, err = rex.call("session.create", {
      label = name,
      initial_windows = {
        { layout = { block = { flavor = "com.superlogical.terminal.shell" } } },
      },
    })
    if created == nil or not created.session_id then
      rex.log("warn", "new session " .. name .. ": " .. tostring(err))
      return
    end
    rex.client.queue("session.select", { session_id = created.session_id })
  end,
}

---------------------------------------------------------------------------
-- Context keys — vim/fzf-aware navigation and resize
---------------------------------------------------------------------------
-- Ctrl+h/j/k/l and Ctrl+arrows are ONE motion across Rex panes and nvim
-- splits: when nvim (or fzf, which wants Ctrl+j/k for its list) is running
-- in the pane the key goes to it, otherwise Rex moves the pane focus. nvim's
-- half is smart-splits, whose edge handler calls `rex focus <direction>`
-- when there is no split further that way (nvim/lua/plugins/nav.lua).
-- Hand-written, not generated: like their tmux twins in keymap-base.conf,
-- these are conditionals, not table entries.
--
-- "What is running in the pane" is asked of `ps`, not of Rex. Rex reports
-- the foreground process GROUP's leader, and a program started by a zsh
-- widget — fzf on Ctrl+T, on completion — runs inside the shell's own
-- group, so Rex says `zsh` (spiked 2026-11-26). tmux has the identical
-- blind spot in pane_current_command and the identical cure: list the
-- pane's tty. Same rule as its regex, including the state filter — a
-- suspended (T) vim must not swallow the key.

local TERMINAL = "com.superlogical.terminal"
local pane_ttys = {} -- block id → tty; a block keeps its tty for life

local function pane_tty(block)
  if pane_ttys[block] then return pane_ttys[block] end
  local p = rex.block.call(TERMINAL, "process", { block_id = block })
  local pid = p and p.child and p.child.pid
  if not pid then return nil end
  local r = rex.exec({ "/bin/ps", "-o", "tty=", "-p", tostring(pid) })
  local tty = r and r.ok and r.stdout:match("%S+") or nil
  if tty == "??" then tty = nil end
  pane_ttys[block] = tty
  return tty
end

-- The vim family, as keymap-base.conf's probe spells it:
--   g?(view|l?n?vim?x?)(diff)?
local function is_vim(name)
  name = name:gsub("^g", ""):gsub("diff$", "")
  return name == "view" or name:match("^l?n?vim?x?$") ~= nil
end

local function is_vim_or_fzf(name)
  return name == "fzf" or is_vim(name)
end

-- True when a live process on the focused pane's tty satisfies `wanted`.
local function pane_runs(ctx, wanted)
  local block = ctx.block_id
  if not block then return false end
  local tty = pane_tty(block)
  if not tty then return false end
  local r = rex.exec({ "/bin/ps", "-o", "state=", "-o", "comm=", "-t", tty })
  if not (r and r.ok) then return false end
  for line in r.stdout:gmatch("[^\n]+") do
    local state, comm = line:match("^(%S+)%s+(.-)%s*$")
    if state and not state:match("^[TXZ]") then
      local name = (comm:match("([^/]+)$") or comm):gsub("^%-", "")
      if wanted(name) then return true end
    end
  end
  return false
end

-- Navigation is a FUNCTION bind: returning false hands the key to the
-- terminal untouched, which is what nvim and fzf should see. The focus move
-- is made on the server (a key function may not queue client actions); the
-- app follows it.
for key, direction in pairs({
  ["ctrl+h"] = "left", ["ctrl+j"] = "down", ["ctrl+k"] = "up", ["ctrl+l"] = "right",
  ["ctrl+left"] = "left", ["ctrl+down"] = "down", ["ctrl+up"] = "up", ["ctrl+right"] = "right",
}) do
  rex.bind(key, function(ctx, ev)
    if pane_runs(ctx, is_vim_or_fzf) then return false end
    rex.session.focus_direction{ direction = direction }
    return true
  end)
end

-- Resize moves a BORDER, on the server, by cells. The layout of a tiled
-- layer is a binary tree — a node is { rect, block_id } or { rect, split =
-- { direction, ratio, before, after } }, rect = { x, y, w, h } as fractions
-- of the window — and `session.resize_pane` sets one split's ratio.
--
-- Which border: tmux's rule. The key moves a border in the pressed
-- direction — the nearest one on that side of the pane, or, for a pane at
-- that edge, the nearest one on the other side. No split on that axis:
-- nothing happens.
--
-- It is server-side so nvim can reach it too (`rex do pane_resize_by`, see
-- nvim's plugins/nav.lua): one behaviour for a shell pane and an nvim pane.
local RESIZE_STEP = 2 -- cells; nvim's smart-splits is set to the same

-- Splits from the root down to the block, as { node, split, side } steps.
local function split_path(node, block, acc)
  if node.block_id then return node.block_id == block and acc or nil end
  for _, side in ipairs({ "before", "after" }) do
    local step = {}
    for i, v in ipairs(acc) do step[i] = v end -- Rex's Lua has no table.unpack
    step[#step + 1] = { node = node, split = node.split, side = side }
    local found = split_path(node.split[side], block, step)
    if found then return found end
  end
  return nil
end

local function any_leaf(node)
  while node.split do node = node.split.before end
  return node.block_id
end

local function leaf_rect(node, block)
  if node.block_id then return node.block_id == block and node.rect or nil end
  return leaf_rect(node.split.before, block) or leaf_rect(node.split.after, block)
end

local function resize_by(session, block, direction, cells)
  if not (session and block) then return false end
  local horizontal = direction == "left" or direction == "right"
  local axis = horizontal and "horizontal" or "vertical"
  local sign = (direction == "right" or direction == "down") and 1 or -1
  local dim = horizontal and 3 or 4 -- rect index: width or height

  local view = rex.session.view({ session_id = session })
  for _, w in ipairs(view and view.windows or {}) do
    for _, layer in ipairs(w.layers or {}) do
      local path = layer.kind == "tiled" and layer.layout and split_path(layer.layout, block, {}) or nil
      if path then
        local want, hit = sign == 1 and "before" or "after", nil
        for i = #path, 1, -1 do
          if path[i].split.direction == axis and path[i].side == want then hit = path[i] break end
        end
        if not hit then
          for i = #path, 1, -1 do
            if path[i].split.direction == axis then hit = path[i] break end
          end
        end
        if not hit then return false end

        -- Cells → ratio. The window's cells on this axis follow from the
        -- pane's own size and the fraction of the window it covers; borders
        -- are ignored, so a step can be off by a cell.
        local size = rex.block.call(TERMINAL, "size", { block_id = block })
        local own = size and (horizontal and size.columns or size.rows)
        local frac = leaf_rect(layer.layout, block)[dim]
        if not own or own <= 0 or frac <= 0 then return false end
        local extent = hit.node.rect[dim] * (own / frac)
        local ratio = hit.split.ratio + sign * cells / extent
        ratio = math.max(0.05, math.min(0.95, ratio))
        rex.session.resize_pane({
          session_id      = session,
          direction       = axis,
          before_block_id = any_leaf(hit.split.before),
          after_block_id  = any_leaf(hit.split.after),
          ratio           = ratio,
        })
        return true
      end
    end
  end
  return false
end

rex.action{
  name  = "pane_resize_by",
  title = "Resize Pane by Cells",
  args  = { direction = "string", cells = "number" },
  run   = function(ctx, args)
    return resize_by(ctx.session_id, ctx.block_id, args.direction, args.cells)
  end,
}

-- The key side is an ACTION, not a function bind, because its pass-through
-- branch re-sends the key to the pane — a client action, which only an
-- action may queue. Vim only — fzf has no use for these.
rex.action{
  name    = "ctx_resize",
  title   = "Resize Pane, or Pass the Key to Vim",
  args    = { direction = "string", key = "string" },
  repeats = true,
  run     = function(ctx, args)
    if pane_runs(ctx, is_vim) then
      rex.client.queue("pane.send_key", { key = args.key })
    else
      resize_by(ctx.session_id, ctx.block_id, args.direction, RESIZE_STEP)
    end
  end,
}

for key, direction in pairs({
  ["ctrl+shift+h"] = "left", ["ctrl+shift+j"] = "down", ["ctrl+shift+k"] = "up", ["ctrl+shift+l"] = "right",
  ["ctrl+shift+left"] = "left", ["ctrl+shift+down"] = "down", ["ctrl+shift+up"] = "up", ["ctrl+shift+right"] = "right",
}) do
  rex.bind(key, "ctx_resize", { direction = direction, key = key })
end

---------------------------------------------------------------------------
-- Leader tables — generated from keymap.yaml (.keymap.tables)
---------------------------------------------------------------------------
-- Order. The overlay lists a mode's keys in the order they are bound, so the
-- order below is the order on screen: first the entries that open something
-- (keymap.yaml `switch: true` — another mode, copy mode, a rename prompt),
-- then the rest as keymap.yaml lists them, then the exit keys, Escape last.
-- An entry's action is named after its index in keymap.yaml, not after where
-- it lands here.
--
-- Icons. Each label is prefixed with the entry's keymap.yaml icon, which
-- the overlay draws (smaller than the text, and as part of the label).
--
-- The exit keys go through actions of ours too, though Rex's own titles would
-- do: the overlay groups its rows by the action's category, and with two
-- groups a short mode (session) is laid out in two columns, the right one
-- clipping its key symbols (Rex app 0.1.0-preview.35). One category, one
-- column.
--
-- The scroll / copy / search tables are deliberately absent: Rex's own copy
-- mode and find replace them, and only the keys that ENTER them are bound.

rex.bind("alt+w", "client.mode.enter", { name = "prefix" })
{{ range $mode := list "prefix" "tab" "pane" "resize" "move" "session" }}
{{- $t := index $.keymap.tables $mode }}
-- {{ $mode }}: {{ $t.title }}
rex.mode({{ $mode | quote }}, { exclusive = true })
{{- range $first := list true false }}
{{-   if and (not $first) (eq $mode "prefix") }}
rex.bind("prefix/alt+w", km_leave("km_prefix_send_leader", "Send Alt+W to the pane", "pane.send_key", { key = "alt+w" }))
{{-   end }}
{{-   range $i, $e := $t.entries }}
{{-     if not (hasKey $e "rex") }}{{ fail (printf "keymap.yaml: %s entry %q has no rex: answer" $mode $e.desc) }}{{ end }}
{{-     if eq $first (and (hasKey $e "switch") $e.switch) }}
{{-       $title := $e.desc }}
{{-       if hasKey $e "icon" }}{{ $title = printf "%s  %s" $e.icon $e.desc }}{{ end }}
{{-       if (kindIs "bool" $e.rex) }}
{{-         if $e.rex }}
{{-           range $k := $e.keys }}
rex.bind("{{ $mode }}/{{ template "rexkey" $k }}", km_stay({{ printf "km_%s_%d" $mode $i | quote }}, {{ template "luastr" $title }}, false, "client.mode.enter", { name = {{ $e.to | quote }} }))
{{-           end }}
{{-         end }}
{{-       else }}
{{-         range $k := $e.keys }}
{{ template "rexbind" (dict "mode" $mode "key" $k "rex" $e.rex "sticky" (and (hasKey $e "sticky") $e.sticky) "leave" (not (and (hasKey $e "sticky") $e.sticky)) "name" (printf "km_%s_%d" $mode $i) "desc" $title) }}
{{-         end }}
{{-       end }}
{{-     end }}
{{-   end }}
{{- end }}
{{- if hasKey $t "parent" }}
rex.bind("{{ $mode }}/backspace", km_stay("km_exit", "Back", false, "client.mode.exit"))
{{- end }}
rex.bind("{{ $mode }}/escape", km_stay("km_exit_all", "Exit", false, "client.mode.exit_all"))
{{ end }}
