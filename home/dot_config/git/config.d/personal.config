; Personal identity — included by ~/.config/git/config (see config.tmpl):
; loosely on personal boxes, and per-repo on work boxes for any clone whose
; remote is a Townk repo. Reached via includeIf "hasconfig:remote.*.url:",
; so this file must never define a remote URL of its own.
[user]
  name = Thiago Alves
  email = thiago@rapinialves.com
  signingKey = A9C4A3D8CA995D91

[github]
  user = Townk

; Personal repos sign with the personal key even on work boxes where
; work.config turns signing off (this include wins by coming after it).
[commit]
  gpgsign = true

# vim:ft=gitconfig
