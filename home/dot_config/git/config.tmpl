{{- $p := index .theme.palettes .theme.active -}}
{{- $traits := includeTemplate "profile-traits.tmpl" . | fromJson -}}
{{- $workBox := eq .profile "work" "dev-shell" }}
; Identity lives in ~/.config/git/config.d/, never in this (public) file.
{{- if $workBox }}
; Work boxes (work laptop, dev-shell): the work identity comes from
; config.d/work.config, a local operator-written file chezmoi never manages
; (.cursor/rules/no-company-info.mdc). If it is missing, useConfigOnly turns
; the first commit into a loud "tell me who you are" error instead of a
; silent fallback to a guessed identity.
[user]
  useConfigOnly = true

[include]
  path = ~/.config/git/config.d/work.config
{{- else }}
; Personal boxes: the personal identity applies everywhere by default.
[include]
  path = ~/.config/git/config.d/personal.config
{{- end }}

; Personal repos stay personal on ANY box, keyed off the configured remote
; URL — matched literally, before insteadOf rewriting, hence the gh:/ form.
; These sit after the work include so they win inside personal clones.
[includeIf "hasconfig:remote.*.url:git@github.com:Townk/**"]
  path = ~/.config/git/config.d/personal.config
[includeIf "hasconfig:remote.*.url:https://github.com/Townk/**"]
  path = ~/.config/git/config.d/personal.config
[includeIf "hasconfig:remote.*.url:gh:/**"]
  path = ~/.config/git/config.d/personal.config

[core]
  whitespace = trailing-space,space-before-tab
  autocrlf = "input"
  commentchar = ";"
{{- if not $traits.headless }}
  pager = hunk pager
{{- end }}

[interactive]
  diffFilter = delta --color-only

# delta no longer pages git itself (core.pager = hunk pager) — this section
# now themes the tm scrub sessions' diff lens, which renders through delta
# via diffnav. No side-by-side: the lens shares its tab with the timeline
# and forces unified (backup-tm lens_cmd also strips it defensively).
[delta]
  features = unobtrusive-line-numbers decorations
  syntax-theme = chezmoi-system
  # NB: no wrap settings — delta only wraps in side-by-side mode; in the
  # unified lens it emits full-length lines and diffnav's viewport clips
  # them at pane width (long-line visibility is a diffnav limitation).
  zero-style = syntax
  plus-style = "syntax #{{ $p.diff.plus_bg }}"
  plus-emph-style = "#{{ $p.diff.plus_emph_fg }} #{{ $p.diff.plus_emph_bg }}"
  minus-style = "syntax #{{ $p.diff.minus_bg }}"
  minus-emph-style = "#{{ $p.diff.minus_emph_fg }} #{{ $p.diff.minus_emph_bg }}"

[delta "unobtrusive-line-numbers"]
  line-numbers = true
  line-numbers-minus-style = "#{{ $p.diff.minus_num_fg }} #{{ $p.diff.minus_num_bg }}"
  line-numbers-zero-style = normal
  line-numbers-plus-style = "#{{ $p.diff.plus_num_fg }} #{{ $p.diff.plus_num_bg }}"
  line-numbers-left-format = "{nm:>4} "
  line-numbers-right-format = "{np:>4} "
  line-numbers-left-style = "#{{ $p.diff.minus_num_bg }} #{{ $p.diff.minus_num_bg }}"
  line-numbers-right-style = "#{{ $p.diff.plus_num_bg }} #{{ $p.diff.plus_num_bg }}"

[delta "decorations"]
  commit-decoration-style = bold yellow box ul
  file-style = bold yellow
  file-decoration-style = bold yellow ol ul
  hunk-header-decoration-style = yellow box

[init]
  defaultBranch = master

[commit]
  status = 1
  template = ~/.config/git/templates/commit-message.md
  gpgsign = true
  verbose = true

[push]
  autoSetupRemote = true

[fetch]
  prune = true
  prunetags = true

[apply]
  whitespace = nowarn

[diff]
  tool = nvimdiff
  algorithm = histogram
  colorMoved = default
  colorMovedWS = allow-indentation-change

[diff "lisp"]
  xfuncname = "^(((;;;+ )|\\(|([ \t]+\\(((cl-|el-patch-)?def(un|var|macro|method|custom)|gb/))).*)$"

[diff "org"]
  xfuncname = "^(\\*+ +.*)$"

[diff "markdown"]
  xfuncname = "^#{1,6} +.+$"

[diff "toml"]
  xfuncname = "^\\[\\[?[^]]+\\]\\]?"

[diff "gitconfig"]
  xfuncname = "^\\[.*\\]"

[difftool]
  prompt = false

[merge]
  ff = only
  tool = nvimdiff
  conflictStyle = zdiff3

; [mergetool "nvimdiff"]
;   layout = "LOCAL,BASE,REMOTE / MERGED"

[pull]
  rebase = true

[rebase]
  autoSquash = true
  updateRefs = true

[branch]
  sort = -committerdate

[rerere]
  enabled = true
  autoupdate = true

[status]
  submodule = 1

[tag]
  forceSignAnnotated = true
  sort = version:refname

[column]
  ui = auto

[color]
  ui = true
  branch = auto
  status = auto
  review = auto

[color "diff"]
  meta = 11
  frag = magenta bold
  commit = yellow bold
  old = red bold
  new = green bold
  whitespace = red reverse

[color "diff-highlight"]
  oldNormal = red bold
  oldHighlight = red bold 52
  newNormal = green bold
  newHighlight = green bold 22

[help]
  autocorrect = 1
{{- if eq .chezmoi.os "darwin" }}

; osxkeychain is macOS-only; on other OSes it's not a real git subcommand and
; breaks every HTTPS credential lookup, so confine it to darwin.
[credential]
  helper = osxkeychain
{{- end }}

[lfs]
  skipSmudge = true

[url "https://github.com/"]
  insteadOf = gh:

[url "git@github.com:"]
  insteadOf = ssh+gh:
{{- if ne .chezmoi.os "darwin" }}
  ; No HTTPS credential helper on non-macOS (osxkeychain is gated to darwin),
  ; so push to github.com over SSH while fetch stays on HTTPS.
  pushInsteadOf = https://github.com/
{{- end }}

[url "git@github.com:Townk/"]
  insteadOf = gh:/

[url "https://gist.github.com/"]
  insteadOf = gist:

[alias]
  changes = log --pretty=oneline --abbrev-commit --graph --decorate @{u}..HEAD
  ## Show the current branch
  current-branch = !git symbolic-ref -q HEAD | sed -e 's|^refs/heads/||'
  ## List all files that are ignoring changes (this is not the same as
  ## .gitignore; this is when you ignore changes on a trakced file.)
  ignored = !git ls-files -v | grep '^[[:lower:]]'
  ## Show all git aliases
  sa = config --get-regexp 'alias.*'
  ## Show all the changes that are staged
  staged = diff --cached
  ## Show all the changes that are NOT staged
  unstaged = diff
  ## Diff with smaller context — useful for sectioned files (gitconfig, toml, etc.)
  ## so each section becomes its own hunk instead of coalescing
  ds = diff -U1

  # Logs
  dag = log --graph --format='format:%C(yellow)%h%C(reset) %C(blue)"%an" <%ae>%C(reset) %C(magenta)%cr%C(reset)%C(auto)%d%C(reset)%n%s' --date-order
  l = log --graph --pretty=format':%C(bold)%C(yellow)%h%C(bold)%C(blue)%d%C(reset) %s %C(bold)%C(white) %an, %C(bold)%C(red)%ar%C(reset)'
  lol = log --pretty=oneline --abbrev-commit --graph --decorate

  # Commands
  co = checkout
  dt = difftool
  ## Stop tracking changes on a tracked file (all files marked with
  ## --assume-unchanged)
  new-ignore = !gi() { curl -L -s https://www.gitignore.io/api/$@ ";"}";" gi
  ## Remove everything that is not checked-in and belongs to the repository
  nuke = clean -xfd
  ## Rollback any changes in the repository
  rb = reset --hard HEAD
  ## nuke + rb
  fresh = !git nuke && git rb
  ## Checkout and track a remote branch
  ## Usage: git track origin/feature-123-login-form
  track = checkout -t
  ## Mark files to not have changes tracked. This is to allow users to mark
  ## personal and custom changes to not be commited, even if the file is
  ## actually being tracked.
  unignore = "update-index --no-assume-unchanged"
  ## Remove files from stage
  unstage = "reset HEAD"
  unadd = "reset HEAD"

  # Data analysis
  rank = "fame --enum -e --format tabulate"
  emails = !git log --format=%aE | sort -u
  email-domains = !git log --format=%aE | awk -F'@' '{print $2}' | sort -u

  dv = "!f() { nvim -f -c \"DiffviewOpen $*\" -c 'autocmd TabClosed * qa'; }; f"

  hdiff = "-c core.pager=\"hunk pager\" diff"
  hshow = "-c core.pager=\"hunk pager\" show"

