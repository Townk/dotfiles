# endpoints.toml — where `share` may send things, and how.
#
# This is an EXAMPLE. The real manifest lives at ~/.config/share/endpoints.toml
# and is LOCAL-ONLY: it is chezmoiignored and never committed, because an
# endpoint hostname can name a work resource (and this repo is public). Same
# loose-layer pattern as ~/.config/packages/images.toml and ~/.ssh/config.
#
# Bootstrap:
#   cp ~/.config/share/endpoints.toml.example ~/.config/share/endpoints.toml
#   $EDITOR ~/.config/share/endpoints.toml
#   share endpoints                     # confirm what this profile may use
#
# You do not need this file to share a file. A built-in `public` endpoint
# (getcroc.com) exists in code and is the personal default. It is safe as a
# default because croc's store is zero-knowledge: it holds ciphertext and the
# master key never leaves the URL fragment.
#
# Fields, all optional except one of `store` / `relay` / `remote` / `target`:
#   backend      "croc" (default), "rclone" or "ssh"
#   web          true if recipients get a browser page; drives which blurb
#                template is used. Capability, NOT profile — a self-hosted
#                croc-web serves its own page, so a recipient needs no CLI.
#   profiles     allowlist. Resolving to an endpoint absent from this list on
#                the current profile is a hard failure (--force overrides).
#                Fails CLOSED: a missing `profiles` key and a declared-but-
#                empty one are both denials, never "open".
#   default_for  profiles for which this is the default endpoint.
#   message      per-endpoint blurb override. Substitutions: %name %url
#                %token %code %expires %downloads %crocurl %relay
#   live         true if this endpoint can carry a LIVE (peer-to-peer)
#                transfer. Usually inferred and not worth setting: `relay` or
#                `local_only` already imply it. Declare it only for an endpoint
#                whose rendezvous is croc's OWN default public relay — the
#                built-in `public` is the one such case.
#
#                Sending is LIVE by default, so this field is a safety fence,
#                not a feature switch. An endpoint that is only a STORE (a
#                croc-web instance serves its site, not a TCP relay) would
#                otherwise fall back to croc's default public relay with no
#                flag and no prompt — on a work profile, exactly the egress
#                the `profiles` allowlist exists to prevent. Endpoints that
#                cannot carry live say so, and a default live send downgrades
#                to stored with a warning. An explicit --live refuses instead.
#
# croc backend:
#   store        HTTPS origin of a croc-web store
#   relay        host:port for live (code-phrase) transfers. It is published
#                in the pasteable line handed to the recipient — the phrase
#                alone only suffices on croc's built-in relay and on a
#                multicast LAN — so an internal address in this field ends up
#                in whatever chat message carries the share.
#
#                (A relay on THIS machine, `"@self:<port>"`, was retired on
#                2026-09-29: the work network cannot route to a laptop, so it
#                could never serve colleagues. See the phase-2 spec.)
#
#                *** A RELAY THAT SETS `pass` CAN ONLY SERVE YOUR OWN MACHINES. ***
#                croc's relay password is needed by BOTH peers. `share get`
#                supplies it automatically when the pasted address matches a
#                relay in THIS manifest — i.e. your own — but a third party has
#                no such file and cannot know it. Found the hard way in live
#                testing: the sender connected happily while the recipient got
#                "bad response: bad password".
#
#                So: a relay meant for colleagues must leave `pass` UNSET and
#                rely on croc's default. Nothing is weakened by that — the file
#                is end-to-end encrypted under the 80-bit code phrase, and the
#                relay only ever sees ciphertext. The password protects your
#                BANDWIDTH from strangers, not your file, and a relay reachable
#                only from a tailnet or LAN has little bandwidth to steal.
#
# rclone backend:
#   remote       an rclone "remote:path" (configure it with `rclone config`)
#   link_scope   "organization" (tenant-only) or "anonymous"
#   link_type    "view" (default), "edit", or "embed"
#
# ssh backend (EXPERIMENT — copies files onto one of YOUR OWN boxes):
#   target       "user@host", or a Host alias from ~/.ssh/config. Key/agent
#                auth only: ssh runs with BatchMode, so it never prompts.
#   dir          where copies land on the remote: "~/…", relative (to the
#                remote $HOME) or absolute. Each send gets its own stamped
#                directory inside it; `share revoke` removes exactly the files
#                that send copied, and the stamped directory once it is empty.
#                Never `default_for` and never chosen implicitly — always
#                `share send --to <name>`. No live mode, no web link, no --qr,
#                no --expiration/--downloads: the pasteable line is the remote
#                path(s), for pasting into a shell on that box. Never set
#                `store` or `remote` on an ssh endpoint — that is a
#                configuration error, refused before anything sends.

# --- home store: a container on your own server, behind a reverse proxy -----
# Reachable on the LAN and the tailnet only, so it is NOT default_for anything:
# use `share --to drop` when the recipient is a tailnet peer, or when the file
# is larger than the public store will take.
# [drop]
# description = "Home store"
# store = "https://drop.home.example.com"
# web = true
# profiles = ["personal"]

# --- work: OneDrive, the sanctioned medium ----------------------------------
# Custodial rather than end-to-end, which is correct for company files reaching
# coworkers through the company's own system.
# [onedrive]
# description = "Work OneDrive, organization-scoped links"
# backend = "rclone"
# remote = "onedrive:Shared/drop"
# link_scope = "organization"
# link_type = "view"
# web = true
# profiles = ["work"]
# default_for = ["work"]

# --- a relay of your own, on your server -------------------------------------
# The single most useful endpoint to have, and the reason is worth stating.
#
# Without one, a live transfer between two of YOUR OWN machines rendezvouses
# through croc's public relay — and croc picks WHICH public relay by hashing the
# code phrase, with both the pool and the mapping differing between croc
# versions. Two of your hosts on different versions therefore derive different
# relays from the same phrase, land in rooms on different servers, and wait for
# each other forever with no error on either side. Naming a relay explicitly on
# both ends makes that impossible.
#
# A relay is raw TCP (9009-9013), not HTTP, so it needs no reverse proxy and no
# certificate — which also means nothing about it is published to Certificate
# Transparency logs.
#
# Leave `pass` UNSET unless the relay is only ever for your own machines: the
# password is needed by BOTH peers, and a recipient has no copy of this file.
#
# [homerelay]
# description = "Home relay — LAN/tailnet only, no egress"
# relay       = "relay.home.example.com:9009"
# web         = false            # recipients need the croc CLI
# profiles    = ["personal", "work"]

# --- your own dev box, over ssh (experiment) --------------------------------
# [devbox]
# description = "Dev box over ssh — explicit --to only"
# backend  = "ssh"
# target   = "me@devbox.example.com"
# dir      = "~/incoming"
# profiles = ["work"]

# --- a bare relay: live transfers only, recipients need the croc CLI ---------
# [lab]
# description = "Bare relay"
# relay = "lab.example.com:9009"
# pass = "@secret:SHARE_LAB_RELAY_PASS"
# web = false
# profiles = ["personal"]
