# Universal clipboard bridge listener (Phase 7 spec §4). systemd IS the
# listener: Accept=yes spawns one clipboard-bridge@ instance per connection
# with the socket as stdin/stdout -- the exact socat EXEC: semantics the
# macOS launchd service uses. Loopback-only is load-bearing: the store holds
# clipboard history and must never be reachable off-box.
# Survives image recycles via $HOME: this file + the enable symlink live
# under ~/.config/systemd/user, so the user manager rebinds 2489 at first
# login with no chezmoi run.
[Unit]
Description=Universal clipboard bridge (framed TCP, loopback only)

[Socket]
ListenStream=127.0.0.1:2489
Accept=yes

[Install]
WantedBy=sockets.target
