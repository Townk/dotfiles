#!/usr/bin/env zsh
# pick-gitmoji-zellij — feature adapter for the Gitmoji picker modal.
#
# The floating-pane scaffolding (catppuccin title block, originating-
# pane discovery, stdout capture + inject-into-tile) lives in
# zellij-modal, which spawns this script as its `--inject` target via
# the "Ctrl Shift g" keybind in ~/.config/zellij/config.kdl. All this
# adapter does is configure the floating-pane fzf geometry and exec the
# general-purpose ~/.local/libexec/pick-gitmoji (which reads the gitmoji rows
# of the symbols database under
# $XDG_DATA_HOME/fonts/nerd-font/symbols.db); its stdout (the chosen
# emoji / :code:) is what zellij-modal captures and injects into the pane
# you came from.
#
# Twin of pick-glyph-zellij — identical shape, only the picker binary
# and PICK_GITMOJI_* env prefix differ.
#
# Env-var overrides:
#   PICK_GITMOJI_BIN     Absolute path to pick-gitmoji
#                        (default: $HOME/.local/libexec/pick-gitmoji)
#   PICK_GITMOJI_HEIGHT  fzf height inside the pane. Default -4: zellij-
#                        modal prints a 3-row title block, so fzf fills
#                        the pane height minus that block (plus the
#                        bottom frame row).
#   PICK_GITMOJI_MARGIN  fzf --margin (T,R,B,L). Default 0 on every side
#                        (see pick-glyph-zellij for the rationale).
#   PICK_GITMOJI_PADDING fzf --padding (T,R,B,L). Default 0,2,0,2.
#
# Any positional args are forwarded to pick-gitmoji, so a future binding
# could call this with `--mode name` etc.

set -euo pipefail

# Shared picker-adapter shell: bin resolution + -x guard + the -4/margin/padding
# geometry + no-border + exec. --flag-no-border: pick-gitmoji parses --no-border
# on the command line. See lib/pick-adapter.zsh.
_pa_lib="${0:A:h}/lib/pick-adapter.zsh"
[[ -r "$_pa_lib" ]] || _pa_lib="$HOME/.config/zellij/scripts/lib/pick-adapter.zsh"
source "$_pa_lib"
unset _pa_lib

zj_adapter::exec PICK_GITMOJI "$HOME/.local/libexec/pick-gitmoji" --flag-no-border -- "$@"
