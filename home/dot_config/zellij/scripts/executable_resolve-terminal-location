#!/usr/bin/env zsh
# resolve-terminal-location <client_pid>
#
# Pick the background tint for the WezTerm window hosting the given Zellij
# client (or bare-shell) PID. Prints one line: "local" (no tint) or a palette
# color name (defined in wezterm.lua), chosen from the ssh target's per-machine
# color / profile default in system-onboard's map. See lib/terminal-location.zsh.
emulate -L zsh
set -eu -o pipefail

source "${0:A:h}/lib/terminal-location.zsh"
resolve_terminal_location "${1:?usage: resolve-terminal-location <client_pid>}"
