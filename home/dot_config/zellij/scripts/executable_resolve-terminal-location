#!/usr/bin/env zsh
# resolve-terminal-location <client_pid>
#
# Classify the effective terminal location for the WezTerm window hosting the
# given Zellij client (or bare-shell) PID. Prints one line: local, home, dev,
# or remote. WezTerm's update-status handler calls this to pick a discrete
# background tint.
#
# Optional mapping: ~/.config/wezterm/terminal-location.yaml
# For instant updates when a shell is already inside SSH, also call
# terminal-location-emit from precmd (see that script's header).
emulate -L zsh
set -eu -o pipefail

source "${0:A:h}/lib/terminal-location.zsh"
resolve_terminal_location "${1:?usage: resolve-terminal-location <client_pid>}"
