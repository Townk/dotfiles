#!/usr/bin/env zsh
# zellij-quit-confirm — feature adapter for the Quit modal: a themed
#                       `input::confirm --danger` prompt that kills the
#                       attached session on affirmative.
#
# The floating-pane scaffolding (frame, catppuccin "▓▓▓ Quit Session"
# title block) lives in zellij-modal, which spawns this script as a
# NON-inject ("action") target via the LEADER+q chord (`Alt w` then `q`)
# in ~/.config/zellij/config.kdl. zellij-modal prints the title block,
# then `exec`s this script as the pane's PID 1; we render the confirm
# body below it and act on the answer.
#
# Flow:
#   1. We print one blank row to separate the dialog from zellij-modal's
#      rule, then call `input::confirm --danger` from the shared input
#      stdlib. --danger uses the red destructive palette and defaults to
#      Cancel so a stray Enter or Esc never quits.
#   2. On affirmative we exec `zellij kill-session
#      "$ZELLIJ_SESSION_NAME"`, tearing the session down for every
#      attached client. (We deliberately don't use `zellij action quit`:
#      depending on version/setup that only quits the current client and
#      leaves the session running.) The floating pane dies with the
#      session — no `close_on_exit` involvement on this path. Anything
#      else exits cleanly and `close_on_exit true` disposes of the pane.
#
# The session name lives on its own prompt line (question, blank,
# "Session: <name>") so a long ZELLIJ_SESSION_NAME degrades gracefully —
# at worst it wraps into a 4th prompt row rather than corrupting the
# layout. The pane geometry (50×14) is fixed in cells in config.kdl so
# the dialog renders identically across terminal sizes.
#
# Env-var overrides:
#   ZELLIJ_BIN  Absolute path to the zellij binary
#               (default: first zellij found on PATH / known install paths)
#   GUM_BIN     Absolute path to gum; passed through to input::confirm
#               (default: first gum found on PATH / known install paths)

set -euo pipefail

resolve_bin() {
  local name="$1" p
  shift
  p="${commands[$name]:-}"
  [[ -n "$p" && -x "$p" ]] && {
    print -r -- "$p"
    return 0
  }
  for p in "$@"; do
    [[ -x "$p" ]] && {
      print -r -- "$p"
      return 0
    }
  done
  return 1
}

ZELLIJ_BIN="${ZELLIJ_BIN:-$(resolve_bin zellij /opt/homebrew/bin/zellij /usr/local/bin/zellij /snap/bin/zellij "$HOME/.local/bin/zellij" || true)}"

[[ -x "$ZELLIJ_BIN" ]] || {
  echo "zellij-quit-confirm: missing or non-executable: $ZELLIJ_BIN" >&2
  exit 1
}

# Shared input stdlib — themed confirm + palette. Sourced by absolute path
# (this runs as a floating pane's PID 1, outside any login shell).
source "$HOME/.local/lib/input-common.zsh"

# overlay0 "Session:" label, text value — from the shared theme tokens.
prompt="Quit current Zellij session?

${THEME_COMMENT}Session:${THEME_TEXT_NORMAL} ${ZELLIJ_SESSION_NAME:-?}"

# Fully inherits the shared confirm chrome (palette, padding, themed hint that
# sizes itself to this 3-line prompt). --danger gives the red destructive
# selection and defaults to Cancel so a stray Enter/Esc never quits.
#
# The variable is `answer`, NOT `status`: under zsh `$status` is a read-only
# special parameter (a synonym for `$?`), so `status=0` aborts the script with
# "read-only variable: status".
answer=0
input::confirm "$prompt" --title "Quit Session" --danger --affirmative "Quit" --negative "Cancel" >/dev/null || answer=$?

case "$answer" in
  0) exec "$ZELLIJ_BIN" kill-session "${ZELLIJ_SESSION_NAME:?ZELLIJ_SESSION_NAME unset}" ;;
  *) exit 0 ;;
esac
