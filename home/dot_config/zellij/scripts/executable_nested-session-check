#!/usr/bin/env zsh
# nested-session-check <client_pid>
#
# Exit 0 if the Zellij client process <client_pid> is attached to a
# nested_zellij session, else exit non-zero. WezTerm's Lua (Cmd+Shift+P) calls
# this with the focused pane's foreground-process pid (the Zellij client) to
# decide whether to send Ctrl+Alt+Space — summoning the local workspace picker
# from inside a nested, locked-passthrough session — instead of the normal
# `Alt+w o S` sequence (which would otherwise pass straight through to the
# remote's own Zellij).
#
# The session is resolved LIVE from the client's socket (lib/zellij-session.sh),
# so it tracks switch-session in place. Membership is checked against the
# registry quick-launch writes whenever it launches a nested workspace.
emulate -L zsh
set -u

source "${0:A:h}/lib/zellij-session.sh"

name="$(resolve_session "${1:?usage: nested-session-check <client_pid>}" 2>/dev/null)" || exit 1
reg="${XDG_CACHE_HOME:-$HOME/.cache}/quick-launch/nested-sessions"
grep -Fxq "$name" "$reg" 2>/dev/null
