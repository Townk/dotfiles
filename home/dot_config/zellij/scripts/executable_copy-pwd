#!/usr/bin/env bash
# copy-pwd — copy the focused zellij pane's working directory to the macOS
#            clipboard, then show a Hammerspoon OSD (and play a short sound).
#
# Lives under ~/.config/zellij/scripts/ — it's a zellij-internal helper,
# not a shell command. It is invoked *headlessly* by the zj-context-keys
# ("context-keys") plugin via its `run` action, wired to the `Alt+w Y`
# (and `Alt+w Ctrl+y`) leader chords in ~/.config/zellij/config.kdl.
# Because the plugin runs the command through Zellij's host `run_command`
# API, NO pane is spawned — so there's none of the visual flash a
# `Run {}` keybind block produces.
#
# Why a PID argument instead of querying zellij:
#   Commands launched by `run_command` do NOT reliably inherit the
#   ZELLIJ / ZELLIJ_SESSION_NAME environment, so `zellij action
#   list-panes` from here could fail or target the wrong session. The
#   plugin instead passes the focused pane's ROOT PROCESS PID (its
#   `{pid}` placeholder). We resolve that PID's current working directory
#   straight from the kernel via `lsof`, which needs no zellij context.
#   For a normal shell pane the root process IS the shell, so its cwd is
#   exactly the pane's $PWD (and tracks every `cd`).
#
# Usage:  copy-pwd [--relative|--absolute] <pid>
#
#   --relative  (default) Copy a $HOME-relative path: when the cwd is under
#               $HOME it's collapsed to `~/…` (or bare `~` at $HOME itself).
#               Outside $HOME it's identical to --absolute.
#   --absolute  Copy the full, literal absolute path.
#
# Env overrides:
#   COPY_PWD_ICON    OSD icon spec (SVG name, glyph:<name>, or swatch:#RRGGBB).
#                    Default: glyph:cod-folder.
#   COPY_PWD_SOUND   Notification sound name (as shown in System Settings →
#                    Sound, e.g. Frog/Glass/Tink, or `default`). Default: Frog.
#                    Set empty to show the notification silently.

set -euo pipefail

LSOF="/usr/sbin/lsof"
PBCOPY="/usr/bin/pbcopy"
HS="${HS:-/opt/homebrew/bin/hs}"

COPY_PWD_ICON="${COPY_PWD_ICON:-glyph:cod-folder}"
COPY_PWD_SOUND="${COPY_PWD_SOUND-Frog}"

# Parse an optional path-mode flag in any position; the lone positional is
# the PID. Default mode is $HOME-relative.
mode="relative"
pid=""
for arg in "$@"; do
  case "$arg" in
    -r|--relative) mode="relative" ;;
    -a|--absolute) mode="absolute" ;;
    *) pid="$arg" ;;
  esac
done

[[ -n "$pid" && "$pid" =~ ^[0-9]+$ ]] || {
  echo "copy-pwd: expected a numeric PID argument, got '${pid}'" >&2
  exit 1
}

# Pull the process's cwd from lsof's field output. `-Fn` emits one field
# per line; the cwd's path is the `n`-prefixed line of the `cwd` fd row.
cwd=$(
  "$LSOF" -a -p "$pid" -d cwd -Fn 2>/dev/null \
    | awk '/^n/ { print substr($0, 2); exit }'
)

[[ -n "$cwd" ]] || {
  echo "copy-pwd: could not resolve cwd for pid $pid" >&2
  exit 1
}

# Resolve the path in the requested form. In --relative mode, collapse a
# $HOME prefix to `~` (exact $HOME → bare `~`); otherwise keep it absolute.
path="$cwd"
if [[ "$mode" == "relative" ]]; then
  if [[ "$cwd" == "$HOME" ]]; then
    path="~"
  elif [[ "$cwd" == "$HOME"/* ]]; then
    path="~${cwd#"$HOME"}"
  fi
fi

# Clipboard gets the chosen path with no trailing newline (so it doesn't
# auto-execute if pasted at a shell prompt).
printf '%s' "$path" | "$PBCOPY"

# Keep the OSD focused on the action; the clipboard already carries the path.
if [[ "$mode" == "absolute" ]]; then
  display="Absolute path copied to clipboard"
else
  display="Path copied to clipboard"
fi

# Quote a shell string as a Lua double-quoted string literal.
lua_string() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\033'/\\27}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '"%s"' "$value"
}

# Hammerspoon owns the custom OSD. `hs -c` runs inside the already-running
# Hammerspoon process, so client environment variables are not visible there;
# pass arguments as Lua string literals instead.
# Backgrounded so OSD hiccups never delay or fail the clipboard copy.
if [[ ! -x "$HS" ]]; then
  HS="$(command -v hs 2>/dev/null || true)"
fi

if [[ -n "$HS" && -x "$HS" ]]; then
  (
    "$HS" -c "notify($(lua_string "$COPY_PWD_ICON"), $(lua_string "$display"), $(lua_string "$COPY_PWD_SOUND"))"
  ) >/dev/null 2>&1 &
fi

exit 0
