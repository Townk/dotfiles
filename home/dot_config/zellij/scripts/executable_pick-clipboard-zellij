#!/usr/bin/env zsh
# pick-clipboard-zellij — feature adapter for the Clipboard picker modal.
#
# Twin of pick-glyph-zellij. The floating-pane scaffolding (originating-pane
# discovery, stdout capture + inject-into-tile) lives in zellij-modal, which
# spawns this script as its --inject target via the "Alt w c" leader chord in
# ~/.config/zellij/config.kdl. All this adapter does is configure the
# floating-pane fzf geometry and exec ~/.local/libexec/pick-clipboard; its
# stdout (the chosen clip's text) is what zellij-modal captures and injects
# into the pane you came from.
#
# pick-clipboard reads the PICK_CLIPBOARD_* geometry env (the universal-clipboard
# spec §7 wires geometry through env here), so we export the geometry flags
# rather than pass them on the command line. In the borderless --no-chrome modal pty-frame owns the chrome
# and fills the sub-pty at height=100%, so an explicit height env is not
# needed there; PICK_CLIPBOARD_HEIGHT is exported for the no-pty-frame fallback
# path + parity with pick-glyph-zellij.
#
# Env-var overrides:
#   PICK_CLIPBOARD_BIN      Absolute path to pick-clipboard
#                           (default: $HOME/.local/libexec/pick-clipboard)
#   PICK_CLIPBOARD_HEIGHT   fzf height inside the pane (default -4; see above)
#   PICK_CLIPBOARD_MARGIN   fzf --margin (T,R,B,L). Default 0 on every side.
#   PICK_CLIPBOARD_PADDING  fzf --padding (T,R,B,L). Default 0,2,0,2.
#
# Any positional args are forwarded to pick-clipboard (reserved for a future
# --resume entrypoint, matching the Alt w U / Alt w G resume chords).

set -euo pipefail

# Shared picker-adapter shell: bin resolution + -x guard + the -4/margin/padding
# geometry + no-border + exec. See lib/pick-adapter.zsh.
#
# --flag-no-border: pick-clipboard now parses a --no-border CLI flag (Wave 2,
# group C5, Decision 1), so the adapter passes it on the command line like
# pick-glyph / pick-gitmoji rather than exporting PICK_CLIPBOARD_NO_BORDER. (The
# picker still honors that env var as harmless back-compat, but nothing sets it.)
#
# The floating pane already draws its own frame; a second fzf border would just
# shave columns off the usable width. Padding 0,2,0,2 (T,R,B,L): vertical 0
# (pty-frame already enforces 1 vertical), horizontal 2 — fzf renders left/right
# padding one cell wider than specified for the input-border gutter, so 2 -> an
# effective 3 cells from the box, as requested.
_pa_lib="${0:A:h}/lib/pick-adapter.zsh"
[[ -r "$_pa_lib" ]] || _pa_lib="$HOME/.config/zellij/scripts/lib/pick-adapter.zsh"
source "$_pa_lib"
unset _pa_lib

zj_adapter::exec PICK_CLIPBOARD "$HOME/.local/libexec/pick-clipboard" --flag-no-border -- "$@"
