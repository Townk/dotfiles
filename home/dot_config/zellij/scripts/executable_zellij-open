#!/usr/bin/env bash
# zellij-open — open a clicked file:// link inside the right Zellij session.
#
# Invoked by WezTerm's `open-uri` handler (see ~/.config/wezterm/wezterm.lua)
# as:  zellij-open <client_pid> <uri>
#
# <client_pid> is the foreground process of the clicked WezTerm pane (the Zellij
# client). We resolve which session that client is currently attached to, then:
#   - directory  -> new tab running Yazi at that dir
#   - image      -> floating pane running our preview wrapper
#   - text/code  -> new tab running nvim (CWD = git root, else the file's dir)
#   - anything else (binary, etc.) -> ignored
# Tabs/panes use --close-on-exit, so they vanish when the program quits.
#
# Runs from WezTerm's GUI environment, so it sets a sane PATH up front (lsof,
# ps, file, git, zellij, nvim, yazi may otherwise be missing).
set -uo pipefail
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

pid="${1:-}"
uri="${2:-}"
# Full Zellij display size (the clicked WezTerm pane), used to size the image
# float in absolute cells. 0 when unknown -> percentage fallback below.
term_cols="${3:-0}"
term_rows="${4:-0}"
[ -n "$pid" ] && [ -n "$uri" ] || { echo "usage: zellij-open <pid> <uri> [cols] [rows]" >&2; exit 2; }

# Only handle local file links; everything else is left to WezTerm/the browser.
case "$uri" in file://*) ;; *) exit 0 ;; esac

# file://[localhost]/path -> /path, then percent-decode (+ is a space in URLs).
urldecode() { local s="${1//+/ }"; printf '%b' "${s//%/\\x}"; }
path="$(urldecode "${uri#file://}")"
path="${path#localhost}"
[ -e "$path" ] || exit 0

# --- Resolve the session the client PID is currently attached to ----------
# A Zellij client holds a unix-socket connection to its session's server, whose
# listening socket is bound to .../<contract>/<session_name>; lsof prints that
# path in the NAME column. Find the client's one external socket peer (skip its
# self-pairs) and read the owning server's bound path. Tracks live session
# switches and needs no --session in argv (so cute auto-names keep working).
resolve_session() {
	local client_pid="$1" pids lsof_out cl locals peers external e spath
	pids=$(ps -axww -o pid=,command= | awk '/\/zellij( |$)/ {print $1}' | paste -sd, -)
	[ -n "$pids" ] || return 1
	lsof_out=$(lsof -nP -U -a -p "$pids" 2>/dev/null | grep "unix" || true)
	cl=$(printf '%s\n' "$lsof_out" | awk -v p="$client_pid" '$2==p')
	[ -n "$cl" ] || return 1
	locals=$(printf '%s\n' "$cl" | awk '{print $6}' | grep '^0x' | sort -u)
	peers=$(printf '%s\n' "$cl" | grep -oE '\->0x[0-9a-f]+' | sed 's/->//' | sort -u)
	external=$(comm -23 <(printf '%s\n' "$peers") <(printf '%s\n' "$locals"))
	for e in $external; do
		spath=$(printf '%s\n' "$lsof_out" \
			| awk -v p="$client_pid" -v a="$e" '$2!=p && $6==a && $NF ~ /\// {print $NF; exit}')
		[ -n "$spath" ] && { printf '%s\n' "${spath##*/}"; return 0; }
	done
	return 1
}

session="$(resolve_session "$pid")" || exit 0
[ -n "$session" ] || exit 0

name="$(basename -- "$path")"

# --- Directory: Yazi in a new tab -----------------------------------------
if [ -d "$path" ]; then
	exec zellij --session "$session" action new-tab \
		--cwd "$path" --name "$name" --close-on-exit -- yazi "$path"
fi

# --- File: classify by MIME -----------------------------------------------
mime=$(file -b --mime-type -L "$path" 2>/dev/null)
case "$mime" in
image/*)
	# Big floating preview pane with a (rounded) frame but no title text and no
	# pin decoration (--name "" + --borderless false overriding the global
	# `pane_frames false`, --pinned false). Sized in absolute cells: 28 columns
	# narrower and 5 rows shorter than the full display (falls back to 90% when
	# the size isn't known). The wrapper renders the image at the pane size and
	# waits for a keypress; --close-on-exit then tears it down.
	if [ "$term_cols" -gt 28 ] 2>/dev/null && [ "$term_rows" -gt 5 ] 2>/dev/null; then
		size=(--width "$((term_cols - 28))" --height "$((term_rows - 5))")
	else
		size=(--width 90% --height 90%)
	fi
	exec zellij --session "$session" action new-pane \
		--floating --close-on-exit \
		--name "" --borderless false --pinned false \
		"${size[@]}" \
		-- "$HOME/.config/zellij/scripts/zellij-preview-image" "$path"
	;;
*)
	# Treat anything non-binary as editable text/code; ignore real binaries.
	enc=$(file -b --mime-encoding -L "$path" 2>/dev/null)
	[ "$enc" = "binary" ] && exit 0
	dir="$(dirname -- "$path")"
	root="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" || root=""
	[ -n "$root" ] || root="$dir"
	exec zellij --session "$session" action new-tab \
		--cwd "$root" --name "$name" --close-on-exit -- nvim "$path"
	;;
esac
