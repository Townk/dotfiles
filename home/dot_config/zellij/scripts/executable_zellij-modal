#!/usr/bin/env zsh
# zellij-modal — shared scaffolding for our floating "modal dialog" panes.
#
# Lives under ~/.config/zellij/scripts/ — zellij-internal helper, not a
# shell command. It is the single entry point every floating-pane modal
# is spawned through (see the `zellijModalRun` template in
# ~/.config/zellij/config.kdl, which renders the matching `Run` block).
#
# The idea: each dialog used to re-implement the same scaffolding —
# resolve/validate the zellij binary, assert we're inside a session,
# print a Catppuccin Mocha title block sized to the live pane width, and
# (for the pickers) discover the originating tiled pane, capture the
# tool's stdout, and inject the result back. That boilerplate now lives
# here exactly once. A modal is reduced to its *target script*: the
# feature-specific bit (which picker to run, the widget command to show),
# passed to this scaffolding after `--`.
#
# Usage:
#   zellij-modal --title TEXT [--inject | --capture FILE] -- CMD [ARGS...]
#
#   --title TEXT  Title shown in the catppuccin header block. The block
#                 is three interior rows (blank, "▓▓▓ <title>", rule).
#                 Omit/empty to skip the header entirely.
#   --inject      Picker mode. Capture CMD's stdout, strip the single
#                 trailing newline, and `write-chars` it into the tiled
#                 pane that was focused before the modal opened (with a
#                 focus-previous-pane fallback). Without it ("action"
#                 mode) CMD runs in the foreground and owns its own
#                 outcome — e.g. mux-quit-confirm calls kill-session.
#   --capture FILE  Capture mode. Like --inject, capture CMD's stdout and
#                 strip the single trailing newline, but instead of
#                 injecting it into a tile, write it to FILE — a FIFO the
#                 spawning process blocks on (see mux::pick in
#                 ~/.local/lib/zellij.zsh). The result is written via an
#                 EXIT trap so the reader unblocks even on cancel/ESC.
#                 No tile discovery: the originating pane is a blocked
#                 process, not a shell prompt awaiting text.
#   -- CMD ...    The target command. Everything after `--` is run
#                 verbatim. In picker/capture mode CMD's stdout is the
#                 payload; fzf/the widget keep /dev/tty for their interactive UI.
#
# Title-block contract for picker targets: this script prints three
# interior rows above the target, so a picker filling the pane should
# size its fzf `--height` to `-4` (pane height minus the block plus the
# bottom frame row). The picker adapters set that via their PICK_*_HEIGHT
# env defaults.
#
# Env-var overrides:
#   ZELLIJ_BIN  Absolute path to the zellij binary
#               (default: first zellij found on PATH / known install paths)

set -euo pipefail

# The dependency-free mux layer: mux::bin is the single install-dir resolver the
# modal scripts share (it honours $ZELLIJ_BIN, then command -v, then the known
# install locations — homebrew, /usr/local, the mise shim, ~/.local/bin).
source "${MUX_LIB:-$HOME/.local/lib}/mux-bootstrap.zsh"

ZELLIJ_BIN="${ZELLIJ_BIN:-$(mux::bin zellij || true)}"

title=""
inject=0
capture=""
no_chrome=0
no_discover=0
cmd=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --title)
      title="${2-}"
      shift 2
      ;;
    --title=*)
      title="${1#*=}"
      shift
      ;;
    --inject)
      inject=1
      shift
      ;;
    --no-chrome)
      # Borderless "fzf owns the box" modals: the target (fzf) renders the whole
      # modal — its own border is the outer box, the title goes on its border
      # label — so this script skips the frame-era title block and just hands the
      # title to the target via ZJ_MODAL_TITLE.
      no_chrome=1
      shift
      ;;
    --no-discover)
      # Skip originating-pane discovery (the list-tabs + list-panes round-trips,
      # ~50ms). Safe for action targets that don't refocus a specific pane: the
      # workspace/tab quick-launch pickers switch sessions / open tabs and never
      # read ZELLIJ_MODAL_TARGET_PANE (only the pane picker does).
      no_discover=1
      shift
      ;;
    --capture)
      capture="${2-}"
      shift 2
      ;;
    --capture=*)
      capture="${1#*=}"
      shift
      ;;
    --)
      shift
      cmd=("$@")
      break
      ;;
    *)
      echo "zellij-modal: unknown option: $1" >&2
      exit 2
      ;;
  esac
done

[[ ${#cmd[@]} -gt 0 ]] || {
  echo "zellij-modal: no target command (expected '-- CMD ...')" >&2
  exit 2
}
[[ -x "$ZELLIJ_BIN" ]] || {
  echo "zellij-modal: missing or non-executable: $ZELLIJ_BIN" >&2
  exit 1
}
[[ -n "${ZELLIJ:-}" ]] || {
  echo "zellij-modal: not running inside a zellij session" >&2
  exit 1
}

focus_self() {
  [[ -n "${ZELLIJ_PANE_ID:-}" ]] || return 0
  "$ZELLIJ_BIN" action focus-pane-id "terminal_${ZELLIJ_PANE_ID}" 2>/dev/null || true
}

# Re-assert focus on our own floating pane after it finishes opening.
# When the modal is spawned over a pane running a fullscreen TUI (e.g. an
# editor, or an agent TUI like Claude Code), zellij can leave keyboard focus on
# that underlying tiled pane — a known quirk where the float is visible but
# keystrokes still go to the pane below (zellij-org/zellij#2116, #4656). The
# eager focus_self above runs before our UI starts, so a late focus event steals
# it back. A SINGLE deferred re-focus (we used to sleep 0.2 once) is enough for a
# quiet editor but not for an aggressive TUI that re-grabs focus during its own
# render pass well after 200ms — so re-assert several times across ~1s. Each
# focus-pane-id to our own pane is idempotent (no flicker if we already hold it),
# and hits on a closed pane are harmless. Backgrounded so it survives the `exec`.
focus_self_deferred() {
  [[ -n "${ZELLIJ_PANE_ID:-}" ]] || return 0
  (
    for _ in 1 2 3 4 5 6; do
      sleep 0.15
      "$ZELLIJ_BIN" action focus-pane-id "terminal_${ZELLIJ_PANE_ID}" 2>/dev/null || true
    done
  ) &
}

# Capture the originating tiled pane BEFORE we run the target. We can't
# infer it from env vars (zellij doesn't export "previously focused"),
# so we query `list-panes -a` and pick the most plausible candidate.
# Columns are double-space separated. The candidate must be a live tiled
# terminal pane other than ourselves; among those we prefer one still
# flagged FOCUSED=true (zellij tracks tiled focus independently of
# floating focus, so the originating tile stays "focused" in the tiled
# axis), falling back to the first matching row. We also filter by the
# active TAB_ID so we never write into a pane on a different tab. Only
# needed in --inject mode.
discover_target_pane() {
  local active_tab_id self_pane
  active_tab_id=$(
    "$ZELLIJ_BIN" action list-tabs -s 2>/dev/null |
      awk -F'  ' '
          NR == 1 { next }
          $4 == "true" { print $1; exit }
        '
  )
  self_pane="terminal_${ZELLIJ_PANE_ID:-x}"
  "$ZELLIJ_BIN" action list-panes -a 2>/dev/null |
    awk -F'  ' -v self="$self_pane" -v active_tab="$active_tab_id" '
        NR == 1            { next }
        (active_tab != "" && $1 != active_tab) { next }
        $5  != "terminal"  { next }
        $10 != "false"     { next }   # FLOATING — skip floating panes
        $11 != "false"     { next }   # EXITED   — skip dead panes
        $4  == self        { next }   # us
        $9 == "true" && focused == "" { focused = $4 }
        first == ""                   { first   = $4 }
        END { print (focused != "" ? focused : first) }
      '
}

# Shared dialog theme — single source of the catppuccin palette (THEME_*) and
# the rule helper. Sourced by absolute path so it works outside any login shell.
source "$HOME/.local/lib/theme-common.zsh"

# Title block — blank row, "▓▓▓ <title>", full-width rule — flush to the
# left frame with a 2-cell inset, no trailing separator. The rule width
# is read from the live pane via /dev/tty's TIOCGWINSZ (stty): zellij
# doesn't reliably export $COLUMNS into the spawned pane and `tput cols`
# can fall back to terminfo's 80, leaving the rule short of the frame.
if (( no_chrome )); then
  # "fzf owns the box": hand the title to the target (pick-common turns it into
  # the fzf border label) and draw NO chrome here — fzf renders the whole modal.
  [[ -n "$title" ]] && export ZJ_MODAL_TITLE="$title"
else
  # Framed modals (e.g. the confirm dialogs): paint the interior with the dialog
  # background (mantle) so the title block and the gaps around the target are
  # uniform — not just the glyphs. `\e[2J` floods every cell with the active bg;
  # we keep the bg set so areas the target doesn't repaint stay mantle. (The
  # zellij FRAME border itself can't be tinted per-pane; that's why pickers use
  # the borderless --no-chrome path above.)
  dialog_bg="$(theme::sgr_bg "$C_ROLE_UI_DIALOG_BG")"
  printf '%s\e[2J\e[H' "$dialog_bg"
  if [[ -n "$title" ]]; then
    rule="$(theme::rule)"
    printf '%s\e[K\n' "$dialog_bg"
    printf '%s  %s▓▓▓ %s%s\e[K\n' "$dialog_bg" "$THEME_H1" "$title" "$dialog_bg"
    printf '%s  %s%s%s\e[K\n' "$dialog_bg" "$THEME_SEPARATOR" "$rule" "$dialog_bg"
  fi
  printf '\e[39;22m'
fi

if [[ -n "$capture" ]]; then
  # Capture mode: run the target, capture its stdout, and hand the result back
  # to the spawning process by writing it to $capture (a FIFO the caller blocks
  # on). No tile discovery — the originating pane is a blocked process, not a
  # shell prompt. The EXIT trap writes the result on every exit path (clean
  # finish, ESC/cancel, or a non-zero target), so the reader always unblocks;
  # opening the FIFO for write rendezvouses with the caller's read.
  focus_self
  focus_self_deferred
  result=""
  tmp=$(mktemp "${TMPDIR:-/tmp}/zellijmodal.XXXXXX")
  trap 'printf "%s" "$result" > "$capture"; rm -f -- "$tmp"' EXIT
  "${cmd[@]}" >"$tmp" || true
  result=$(cat "$tmp")
  result="${result%$'\n'}"
  exit 0
fi

if ((!inject)); then
  # Action mode: hand the pane to the target and let it own the outcome
  # (exit status, kill-session, etc). Also pass the originating tiled pane so
  # action targets that split panes can move focus back before calling zellij.
  if (( no_discover )); then
    target_pane=""
  else
    target_pane="$(discover_target_pane)" || target_pane=""
  fi
  [[ -z "$target_pane" ]] || export ZELLIJ_MODAL_TARGET_PANE="$target_pane"
  # `exec` so the target becomes PID 1 of the pane and `close_on_exit` disposes
  # of it when it returns.
  focus_self
  focus_self_deferred
  exec "${cmd[@]}"
fi

# Picker mode: discover where to inject before running the target.
target_pane="$(discover_target_pane)" || target_pane=""
focus_self
focus_self_deferred

# Run the target, redirecting stdout into a tempfile so its interactive
# UI still owns /dev/tty. A non-zero exit (ESC = 130, no match = 1) is a
# user cancel here, not a failure.
#
# When we have a concrete target pane, export it (plus our zellij bin)
# so a picker can offer "insert without dismissing": its fzf binds
# write directly into this pane mid-session via `zellij write-chars`,
# independent of the stdout we capture below for the final Enter. The
# picker only enables those binds when both vars are present, so this
# stays a no-op for non-picker targets.
tmp=$(mktemp "${TMPDIR:-/tmp}/zellijmodal.XXXXXX")
trap 'rm -f "$tmp"' EXIT
if [[ -n "$target_pane" ]]; then
  PICK_INJECT_PANE="$target_pane" PICK_INJECT_ZELLIJ="$ZELLIJ_BIN" \
    "${cmd[@]}" >"$tmp" || true
else
  "${cmd[@]}" >"$tmp" || true
fi

# Strip the single trailing newline so we don't auto-submit at a shell
# prompt. Embedded newlines (multi-select concatenation) are preserved.
result=$(cat "$tmp")
result="${result%$'\n'}"

[[ -n "$result" ]] || exit 0

if [[ -n "$target_pane" ]]; then
  "$ZELLIJ_BIN" action write-chars --pane-id "$target_pane" -- "$result"
else
  # Last-ditch fallback if list-panes couldn't identify a target (e.g.
  # the modal was opened with zero tiled terminal panes in the tab).
  "$ZELLIJ_BIN" action focus-previous-pane
  "$ZELLIJ_BIN" action write-chars -- "$result"
fi
