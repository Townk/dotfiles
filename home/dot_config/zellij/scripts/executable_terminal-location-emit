#!/usr/bin/env zsh
# terminal-location-emit
#
# Emit a WezTerm OSC 1337 user var so pane:get_user_vars().terminal_location
# tracks the effective host even when Zellij cannot see an ssh(1) foreground
# process (interactive shells, nested remote Zellij, etc.). The sequence rides
# back over SSH to the laptop's WezTerm when run on a remote host.
#
# Add to precmd (after WezTerm/Zellij env is available), e.g. in a private
# zsh fragment:
#   source ~/.config/zellij/scripts/terminal-location-emit
#   precmd_functions+=(terminal-location-emit)
#
# Optional mapping file (same as resolve-terminal-location):
#   ~/.config/wezterm/terminal-location.yaml
emulate -L zsh
set -u

[[ -n "${__TERMINAL_LOCATION_EMIT_ZSH:-}" ]] && return 0
typeset -g __TERMINAL_LOCATION_EMIT_ZSH=1

[[ -n "${__TERMINAL_LOCATION_ZSH:-}" ]] || source "${0:A:h}/lib/terminal-location.zsh"

terminal-location-emit() {
  [[ -n "${WEZTERM_PANE:-}${WEZTERM_UNIX_SOCKET:-}" ]] || return 0
  [[ -o interactive ]] || return 0
  command -v base64 >/dev/null 2>&1 || return 0

  local config loc host encoded
  config="$(tl_config_file)" || config=""

  if [[ -z "${SSH_CONNECTION:-}${SSH_CLIENT:-}" ]]; then
    loc=local
  else
    host="$(hostname -s 2>/dev/null)" || host=""
    if [[ -n "$host" && -n "$config" ]]; then
      loc="$(tl_command_to_location "$host" "$config")" || loc=remote
    else
      loc=remote
    fi
  fi

  encoded="$(print -n "$loc" | base64)"
  printf '\033]1337;SetUserVar=terminal_location=%s\007' "$encoded"
}

if [[ "${0:t}" == "terminal-location-emit" ]]; then
  terminal-location-emit
fi
