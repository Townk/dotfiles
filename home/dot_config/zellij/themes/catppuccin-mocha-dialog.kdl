// catppuccin-mocha-dialog — Catppuccin Mocha for Zellij with the ACTIVE pane
// frame recolored to which-key blue (#89b4fa) instead of the stock green.
//
// Why a whole theme: zellij has no partial theme override and no per-pane frame
// color, so to change the floating-modal border color we must ship a full theme
// and point `theme` at it (config.kdl). Only `frame_selected`/`frame_highlight`
// differ from the upstream catppuccin-mocha; everything else mirrors it.
//
// Frames: active = blue #89b4fa (137 180 250); inactive frames are auto-dimmed
// by zellij. With `pane_frames false`, the only frame shown is the active modal.
themes {
    catppuccin-mocha-dialog {
        text_unselected {
            base 205 214 244
            background 30 30 46
            emphasis_0 243 139 168
            emphasis_1 137 180 250
            emphasis_2 166 227 161
            emphasis_3 203 166 247
        }
        text_selected {
            base 205 214 244
            background 69 71 90
            emphasis_0 243 139 168
            emphasis_1 137 180 250
            emphasis_2 166 227 161
            emphasis_3 203 166 247
        }
        ribbon_selected {
            base 30 30 46
            background 166 227 161
            emphasis_0 243 139 168
            emphasis_1 30 30 46
            emphasis_2 203 166 247
            emphasis_3 137 180 250
        }
        ribbon_unselected {
            base 30 30 46
            background 166 173 200
            emphasis_0 243 139 168
            emphasis_1 30 30 46
            emphasis_2 205 214 244
            emphasis_3 245 194 231
        }
        table_title {
            base 166 227 161
            background 0
            emphasis_0 243 139 168
            emphasis_1 137 180 250
            emphasis_2 166 227 161
            emphasis_3 203 166 247
        }
        table_cell_selected {
            base 205 214 244
            background 69 71 90
            emphasis_0 243 139 168
            emphasis_1 137 180 250
            emphasis_2 166 227 161
            emphasis_3 203 166 247
        }
        table_cell_unselected {
            base 205 214 244
            background 30 30 46
            emphasis_0 243 139 168
            emphasis_1 137 180 250
            emphasis_2 166 227 161
            emphasis_3 203 166 247
        }
        list_selected {
            base 205 214 244
            background 69 71 90
            emphasis_0 243 139 168
            emphasis_1 137 180 250
            emphasis_2 166 227 161
            emphasis_3 203 166 247
        }
        list_unselected {
            base 205 214 244
            background 30 30 46
            emphasis_0 243 139 168
            emphasis_1 137 180 250
            emphasis_2 166 227 161
            emphasis_3 203 166 247
        }
        frame_selected {
            base 137 180 250
            background 0
            emphasis_0 137 180 250
            emphasis_1 243 139 168
            emphasis_2 0
            emphasis_3 0
        }
        frame_highlight {
            base 250 179 135
            background 0
            emphasis_0 250 179 135
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        exit_code_success {
            base 166 227 161
            background 0
            emphasis_0 137 180 250
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        exit_code_error {
            base 243 139 168
            background 0
            emphasis_0 250 179 135
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 203 166 247
            player_2 137 180 250
            player_3 0
            player_4 250 179 135
            player_5 116 199 236
            player_6 0
            player_7 243 139 168
            player_8 0
            player_9 0
            player_10 0
        }
    }
}
