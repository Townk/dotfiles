{{/*
  zellijModalRun — render the floating-pane `Run` block for one of our
  standardized "modal dialogs". Every modal is spawned through the
  shared scaffolding script ~/.config/zellij/scripts/zellij-modal, which
  prints the catppuccin title block and (in picker mode) captures the
  target's stdout and injects it into the originating tiled pane. This
  template keeps the pane geometry/flags identical across modals so they
  all look and behave the same; callers only vary the title, target
  script, inject mode, and size.

  Params (passed as a dict):
    home    .chezmoi.homeDir
    title   Header text shown in the modal's title block.
    inject  true  → picker mode  (capture stdout, inject into the tile)
            false → action mode  (target owns its outcome, e.g. quit)
    script  Basename of the target under ~/.config/zellij/scripts/.
    width   Floating-pane width  (e.g. "70%" or a cell count like "50").
    height  Floating-pane height (e.g. "60%" or a cell count like "14").
    args    OPTIONAL extra args passed to the target script, already
            KDL-quoted and space-separated (e.g. `"--resume"`). Used by
            the "resume picker" binds. Omit for none.
    borderless
            OPTIONAL. Default false → zellij draws a rounded frame
            (framed dialogs, e.g. the confirm prompts). Pass true for
            fzf pickers so zellij draws no frame and pty-frame owns the
            chrome.
    no_chrome
            OPTIONAL. Pass true (with borderless true) for fzf pickers:
            zellij-modal skips its own title block and hands the title
            to pty-frame, which renders the whole modal.
    no_discover
            OPTIONAL. Pass true for action-mode targets that don't refocus
            a specific pane (the workspace/tab pickers): skips the
            list-tabs + list-panes round-trips zellij-modal would otherwise
            run to find the originating pane. Leave unset for the pane
            picker, which needs ZELLIJ_MODAL_TARGET_PANE.

  `name ""` suppresses the frame title text; `pinned true` keeps it on
  top of other floats; `close_on_exit true` disposes of the pane when
  the target returns. `borderless`/`no_chrome` (above) decide whether
  zellij frames the modal or pty-frame owns the chrome.
*/ -}}
{{- define "zellijModalRun" -}}
            Run "env" "COLORTERM=truecolor" "{{ joinPath .home ".config/zellij/scripts/zellij-modal" }}" "--title" "{{ .title }}"{{ if .inject }} "--inject"{{ end }}{{ if and (hasKey . "no_chrome") .no_chrome }} "--no-chrome"{{ end }}{{ if and (hasKey . "no_discover") .no_discover }} "--no-discover"{{ end }} "--" "{{ joinPath .home ".config/zellij/scripts" .script }}"{{ if and (hasKey . "args") .args }} {{ .args }}{{ end }} {
                name ""
                close_on_exit true
                floating true
                pinned true
                borderless {{ if hasKey . "borderless" }}{{ .borderless }}{{ else }}false{{ end }}
                width "{{ .width }}"
                height "{{ .height }}"
            }
{{- end -}}
keybinds clear-defaults=true {
    normal {
        // Wezterm-style leader. The "tmux" mode block below is repurposed
        // to host all the leader chords. Scroll mode is excluded so that
        // holding Cmd+Up/Down doesn't repeatedly flap the mode (and the
        // statusbar) between scroll and tmux on every key-repeat. Trade-off:
        // other Cmd+<key> chords don't reach zellij while you're in scroll
        // mode — press Esc/Enter to leave scroll first.
        bind "Alt w" { SwitchToMode "tmux"; }

        // Alt+Enter toggles the host terminal's native fullscreen. Routed
        // through the headless context-keys (zj-context-keys) plugin's `run`
        // action — same flash-free host run_command path as the copy-pwd /
        // open-terminal-config binds below — rather than a bare MessagePlugin
        // broadcast (which addressed no plugin and ran nothing). The script
        // detects Ghostty/WezTerm from the inherited env; no {pid} needed.
        //
        // `when fzf: $source` forwards the raw key to the pane whenever fzf is
        // in the focused pane's process tree (same passthrough as Ctrl+j/k), so
        // a picker can bind Alt+Enter itself instead of it being swallowed by
        // the fullscreen toggle — e.g. the quick-launch workspace picker's
        // "open in a separate window" accept key.
        //
        // `name` MUST be the key spec ("alt+enter") because `$source` forwards
        // the key read from `name` (→ \x1b\r); a descriptive name would make
        // `$source` a silent no-op. The `run` default ignores `name`.
        bind "Alt Enter" {
            MessagePlugin "context-keys" {
                name "alt+enter"
                payload "default: run {{ joinPath .chezmoi.homeDir ".config/zellij/scripts/terminal-toggle-fullscreen" }}; when fzf: $source"
            }
        }

        // Pane focus: Ctrl + hjkl / arrows. Exception to the "no Ctrl in
        // zellij" rule, kept for muscle-memory consistency with vim/
        // smart-splits.nvim. See user-modifier-binding-model memory.
        // Plugin: vim-navigator (alias defined in `plugins {}` below).
        // The alias supplies `move_mod "ctrl"`; we only set what differs
        // per binding: the message name, payload (direction), and whether
        // this binding was triggered by an arrow key or by hjkl.
        bind "Ctrl h" {
            MessagePlugin "vim-navigator" {
                name "move_focus"
                payload "left"
                use_arrow_keys "false"
            }
        }
        bind "Ctrl left" {
            MessagePlugin "vim-navigator" {
                name "move_focus"
                payload "left"
                use_arrow_keys "true"
            }
        }

        bind "Ctrl l" {
            MessagePlugin "context-keys" {
                name "ctrl+l"
                payload "default: pipe vim-navigator name=move_focus payload=right use_arrow_keys=false; when pi: $source"
            }
        }
        bind "Ctrl right" {
            MessagePlugin "vim-navigator" {
                name "move_focus"
                payload "right"
                use_arrow_keys "true"
            }
        }

        // Ctrl+j / Ctrl+k: routed through zj-context-keys. By default the
        // keystroke is re-piped into vim-zellij-navigator (matching Ctrl+h/l
        // above) so focus moves vim-aware. When fzf is anywhere in the
        // focused pane's process tree, the raw byte (^J / ^K) is forwarded
        // instead so fzf's item navigation keeps working.
        // See Projects/apps/zellij/zj-context-keys.
        bind "Ctrl j" {
            MessagePlugin "context-keys" {
                name "ctrl+j"
                payload "default: pipe vim-navigator name=move_focus payload=down use_arrow_keys=false; when fzf: $source; when agent,cursor-agent: key down"
            }
        }
        bind "Ctrl down" {
            MessagePlugin "vim-navigator" {
                name "move_focus"
                payload "down"
                use_arrow_keys "true"
            }
        }

        bind "Ctrl k" {
            MessagePlugin "context-keys" {
                name "ctrl+k"
                payload "default: pipe vim-navigator name=move_focus payload=up use_arrow_keys=false; when fzf: $source; when agent,cursor-agent: key up"
            }
        }
        bind "Ctrl up" {
            MessagePlugin "vim-navigator" {
                name "move_focus"
                payload "up"
                use_arrow_keys "true"
            }
        }

        // Resize: Ctrl+Shift + hjkl / arrows. Increases in the direction
        // pressed. Uses the same vim-navigator alias as the focus bindings;
        // `resize_mod "ctrl+shift"` is supplied by the alias.
        bind "Ctrl Shift h" {
            MessagePlugin "vim-navigator" {
                name "resize"
                payload "left"
                use_arrow_keys "false"
            }
        }
        bind "Ctrl Shift left" {
            MessagePlugin "vim-navigator" {
                name "resize"
                payload "left"
                use_arrow_keys "true"
            }
        }

        bind "Ctrl Shift l" {
            MessagePlugin "vim-navigator" {
                name "resize"
                payload "right"
                use_arrow_keys "false"
            }
        }
        bind "Ctrl Shift right" {
            MessagePlugin "vim-navigator" {
                name "resize"
                payload "right"
                use_arrow_keys "true"
            }
        }

        bind "Ctrl Shift j" {
            MessagePlugin "vim-navigator" {
                name "resize"
                payload "down"
                use_arrow_keys "false"
            }
        }
        bind "Ctrl Shift down" {
            MessagePlugin "vim-navigator" {
                name "resize"
                payload "down"
                use_arrow_keys "true"
            }
        }

        bind "Ctrl Shift k" {
            MessagePlugin "vim-navigator" {
                name "resize"
                payload "up"
                use_arrow_keys "false"
            }
        }
        bind "Ctrl Shift up" {
            MessagePlugin "vim-navigator" {
                name "resize"
                payload "up"
                use_arrow_keys "true"
            }
        }

        // Shift+Enter: forward as Shift+Enter (CR) by default. cursor-agent
        // (and `agent`) want Alt+Enter (ESC+CR) to insert a newline instead
        // of submitting. Pi and Claude Code speak the kitty keyboard protocol,
        // so they get the CSI-u encoding (\e[13;2u) which they map to a
        // newline — a plain CR would submit the prompt.
        bind "Shift Enter" {
            MessagePlugin "context-keys" {
                name "shift+enter"
                payload "default: $source; when agent,cursor-agent: key alt+enter; when pi,claude,ai-playbook: kitty:$source"
            }
        }

        // (ai-playbook is triggered by Ctrl+Alt+A, handled entirely in zsh — it
        // arrives as the legacy sequence ESC Ctrl-A (\e^A) which passes straight
        // through Zellij to the pane, so no Zellij bind is needed here. See the
        // bindkey in dot_config/zsh/keybindings.sh.)

        // Ctrl+Shift+u — Unicode / Nerd Font / Emoji glyph picker.
        // Spawns ~/.config/zellij/scripts/pick-glyph-zellij in a
        // floating, pinned pane. The wrapper runs the general-purpose
        // `pick-glyph` from ~/.local/libexec/, captures the chosen glyph,
        // and `write-chars --pane-id <originating-tile>`s it back into
        // the pane the user came from. `close_on_exit true` disposes
        // of the floating pane when the wrapper returns. `pinned true`
        // keeps the picker on top if you toggle other floating panes
        // while it's open. `borderless true` + `no_chrome` make this a
        // "fzf owns the box" modal: no zellij frame (zellij can't tint a
        // floating frame's background per-pane) and no script title block —
        // fzf renders the whole modal full-screen, its own rounded border as
        // the (mantle) outer box with "▓▓▓ <title>" on the border label. The
        // dialog background follows roles.ui.dialog_bg from theme.yaml.
        bind "Ctrl Shift u" {
            SwitchToMode "normal"
            {{ template "zellijModalRun"
               (dict "home" .chezmoi.homeDir
                     "title" "Glyph Picker"
                     "inject" true
                     "borderless" true
                     "no_chrome" true
                     "script" "pick-glyph-zellij"
                     "width" "70%"
                     "height" "60%") }}
        }

        // Ctrl+Shift+g — Gitmoji picker. Spawns
        // ~/.config/zellij/scripts/pick-gitmoji-zellij in a
        // floating, pinned pane with the same shape, chrome, and
        // title-block contract as the Ctrl+Shift+u glyph picker.
        // The wrapper runs the general-purpose `pick-gitmoji` from
        // ~/.local/libexec/ (which fetches & caches the gitmoji.dev
        // catalog at $XDG_CACHE_HOME/pick-gitmoji/), captures the
        // chosen emoji or :code:, and `write-chars --pane-id
        // <originating-tile>` injects it back into the pane the
        // user came from. Same `borderless true` + `no_chrome`
        // contract as the glyph picker: pty-frame owns the chrome,
        // so zellij draws no frame.
        bind "Ctrl Shift g" {
            SwitchToMode "normal"
            {{ template "zellijModalRun"
               (dict "home" .chezmoi.homeDir
                     "title" "Gitmoji Picker"
                     "inject" true
                     "borderless" true
                     "no_chrome" true
                     "script" "pick-gitmoji-zellij"
                     "width" "70%"
                     "height" "60%") }}
        }

        // Cmd+F (Ghostty emits `ESC /` = Alt+/) → open the floating "visual
        // search" dialog. The dialog is the `status-bar` plugin in its per-tab
        // `role "search"` instance (spawned by the layout, parked until needed);
        // switching to `EnterSearch` is all that's needed — the active tab's
        // instance reacts to the ModeUpdate, reveals itself, flips to `Search`,
        // and intercepts keystrokes.
        bind "Alt /" { SwitchToMode "EnterSearch"; }
    }
    // Repurposed as the wezterm-style LEADER mode. Entered via `Alt w`.
    // Each chord switches back to normal mode after executing, mirroring
    // wezterm's `config.leader` immediate-action behavior.
    tmux {
        // Splits (wezterm: SplitHorizontal → right, SplitVertical → down)
        bind "v" { NewPane "right"; SwitchToMode "normal"; }
        bind "s" { NewPane "down";  SwitchToMode "normal"; }

        // Toggle zoom (wezterm LEADER+z)
        bind "z" { ToggleFocusFullscreen; SwitchToMode "normal"; }

        // Modes reachable via leader (wezterm LEADER+r/l/t/W)
        bind "L" { SwitchToMode "locked"; }
        bind "l" { SwitchToMode "scroll"; }
        bind "o" { SwitchToMode "session"; }
        bind "p" { SwitchToMode "pane"; }
        bind "t" { SwitchToMode "tab"; }

        // Toggle pane frames manually (workaround for the frame
        // flicker bug — see project memory).
        bind "f" { TogglePaneFrames; }

        // Alt+w u / Alt+w g — RESUME the glyph / gitmoji picker: reopen
        // it with the previous query AND cursor position restored (see
        // pick-glyph / pick-gitmoji `--resume`). The plain Ctrl+Shift+u/g
        // binds always open fresh; these leader chords are the explicit
        // "get back where I was" entrypoints — handy for grabbing several
        // neighbouring symbols across separate edits. Same floating-pane
        // shape and title block as the fresh pickers; the only difference
        // is `--resume` appended to the target via the template's `args`.
        bind "U" {
            SwitchToMode "normal"
            {{ template "zellijModalRun"
               (dict "home" .chezmoi.homeDir
                     "title" "Glyph Picker (resumed)"
                     "inject" true
                     "borderless" true
                     "no_chrome" true
                     "script" "pick-glyph-zellij"
                     "args" "\"--resume\""
                     "width" "70%"
                     "height" "60%") }}
        }
        bind "G" {
            SwitchToMode "normal"
            {{ template "zellijModalRun"
               (dict "home" .chezmoi.homeDir
                     "title" "Gitmoji Picker (resumed)"
                     "inject" true
                     "borderless" true
                     "no_chrome" true
                     "script" "pick-gitmoji-zellij"
                     "args" "\"--resume\""
                     "width" "70%"
                     "height" "60%") }}
        }

        // Alt+w c — Clipboard history picker. Spawns
        // ~/.config/zellij/scripts/pick-clipboard-zellij in a floating, pinned
        // pane. The wrapper runs ~/.local/libexec/pick-clipboard (which reads
        // the universal SQLite store), captures the chosen clip's text, and
        // `write-chars --pane-id <originating-tile>`s it back into the pane
        // the user came from. Same `borderless true` + `no_chrome true`
        // contract as the glyph/gitmoji pickers: pty-frame owns the chrome, so
        // zellij draws no frame. `c` for "clipboard"; the spec's `Alt w v`
        // collided with the existing tmux-mode `v` (split-right), so this
        // keeps split-right on `v` and uses the free `c` chord instead.
        bind "c" {
            SwitchToMode "normal"
            {{ template "zellijModalRun"
               (dict "home" .chezmoi.homeDir
                     "title" "Clipboard history"
                     "inject" true
                     "borderless" true
                     "no_chrome" true
                     "script" "pick-clipboard-zellij"
                     "width" "70%"
                     "height" "60%") }}
        }

        // Quit zellij — Catppuccin Mocha-themed `gum confirm` dialog
        // (see scripts/zellij-quit-confirm) drawn inside a compact,
        // pinned floating pane with a (rounded) frame but no title
        // text (`name ""`). The script defaults to Cancel, so
        // Enter/Esc are safe; only the affirmative button (or `y`)
        // calls `zellij kill-session "$ZELLIJ_SESSION_NAME"` (NOT
        // `action quit`, which only quits the current client in
        // some setups). `close_on_exit true` disposes of the pane
        // on the cancel path; on the quit path the pane dies along
        // with the session.
        //
        // Pane geometry is fixed in cells rather than percentages so
        // the dialog renders identically across terminal sizes. See
        // scripts/zellij-quit-confirm for the line-by-line layout
        // breakdown.
        //   width   50  — 2 frame cols + 2 left-padding cells (set
        //                 in gum via --padding) + 46 cells of usable
        //                 content area. Rule is intentionally 44
        //                 cells (2 short of the content area) for a
        //                 tucked-in look.
        //   height  14  — 2 frame rows + 12 content rows: top pad,
        //                 title, rule, separator blank, three-line
        //                 gum prompt (question, blank, "Session:
        //                 <name>"), gum blank, buttons, gum blank,
        //                 gum help, bottom pad. The session name on
        //                 its own line means long ZELLIJ_SESSION_NAME
        //                 values degrade by wrapping into the bottom
        //                 pad instead of corrupting the dialog.
        bind "q" {
            SwitchToMode "normal"
            {{ template "zellijModalRun"
               (dict "home" .chezmoi.homeDir
                     "title" ""
                     "borderless" true
                     "inject" false
                     "script" "zellij-quit-confirm"
                     "width" "50"
                     "height" "14") }}
        }

        // Yank — copy the active pane's cwd to the system clipboard, with a
        // Hammerspoon OSD + sound. Two variants:
        //   Shift+y      → $HOME-relative path (e.g. ~/Projects/foo).
        //                  From Ghostty's Cmd+Shift+C, which forwards `Alt+w Y`.
        //   Alt+y        → absolute path (e.g. /Users/me/Projects/foo).
        //                  From Ghostty's Cmd+Shift+Alt+C, which forwards
        //                  `Alt+w` then Alt+y (ESC y = \x1by).
        //
        // Dispatched into the headless context-keys (zj-context-keys) plugin
        // rather than a `Run {}` block: a Run pane — even floating +
        // close_on_exit — renders for a frame and produces a visible flash.
        // The plugin's `run` action executes the command through Zellij's
        // host run_command API with no pane at all, so there's zero flash.
        //
        // The `{pid}` placeholder is substituted by the plugin with the
        // focused terminal pane's root process PID; scripts/copy-pwd resolves
        // that PID's cwd via lsof (no ZELLIJ_* env needed) and handles the
        // path-mode flag + pbcopy + Hammerspoon OSD/sound.
        bind "Y" {
            MessagePlugin "context-keys" {
                name "copy-pwd"
                payload "default: run {{ joinPath .chezmoi.homeDir ".config/zellij/scripts/copy-pwd" }} --relative {pid}"
            }
            SwitchToMode "normal"
        }
        bind "Alt y" {
            MessagePlugin "context-keys" {
                name "copy-pwd-abs"
                payload "default: run {{ joinPath .chezmoi.homeDir ".config/zellij/scripts/copy-pwd" }} --absolute {pid}"
            }
            SwitchToMode "normal"
        }

        // Background-tab alarms on the active tab's focused pane, handled by the
        // bar (status-bar default role). Broadcast (no destination): the bar
        // carries the full config block, so it can't be addressed by a partial
        // config the way the `role`-scoped search/whichkey instances are — a
        // targeted message would spawn a fresh bar instead. Every plugin gets
        // the pipe; the active bar acts on `name`, the rest ignore it.
        bind "i" { MessagePlugin { name "zj_hud_alarm"; payload "idle"; }; SwitchToMode "normal"; }
        bind "u" { MessagePlugin { name "zj_hud_alarm"; payload "activity"; }; SwitchToMode "normal"; }
        bind "k" { MessagePlugin { name "zj_hud_alarm"; payload "clear"; }; SwitchToMode "normal"; }

        // Open Ghostty's config in nvim in a new tab. Triggered from
        // Ghostty's Cmd+, (which forwards the leader chord `Alt+w ,`).
        //
        // Implemented as a floating Run pane that shells out to the zellij
        // CLI rather than NewTab+layout, because a custom layout file
        // *replaces* the session's `default_tab_template` (zjstatus bar
        // disappears). The CLI's `action new-tab -- <command>` uses the
        // running session's template and inherits the status bar.
        //
        // Focus-or-create: if a tab named "Ghostty Config" already exists,
        // jump to it instead of spawning another nvim (avoids swap-file
        // conflicts and tab clutter on repeated Cmd+,).
        bind "," {
            SwitchToMode "normal"
            MessagePlugin "context-keys" {
                name "open-terminal-config"
                payload "default: run {{ joinPath .chezmoi.homeDir ".config/zellij/scripts/edit-terminal-config" }}"
            }
        }

        // Pressing the leader again exits the mode.
        bind "Alt w" { SwitchToMode "normal"; }
    }
    locked {
        // Locked mode is the maximum-passthrough mode — every keypress,
        // including bare `esc` and `Alt+w`, flows to the underlying app.
        // The single exit is `Alt+Esc`, a combo uncommon enough that no
        // shell or TUI claims it.
        bind "Alt esc" { SwitchToMode "normal"; }
    }
    session {
        bind "a" {
            LaunchOrFocusPlugin "zellij:about" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "normal"
        }
        bind "c" {
            LaunchOrFocusPlugin "configuration" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "normal"
        }
        bind "d" { Detach; }
        bind "l" {
            LaunchOrFocusPlugin "zellij:layout-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "normal"
        }
        bind "p" {
            LaunchOrFocusPlugin "plugin-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "normal"
        }
        bind "s" {
            LaunchOrFocusPlugin "zellij:share" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "normal"
        }
        bind "S" {
            SwitchToMode "normal"
            {{ template "zellijModalRun"
               (dict "home" .chezmoi.homeDir
                     "title" "Quick Launch — Workspace"
                     "inject" false
                     "borderless" true
                     "no_chrome" true
                     "no_discover" true
                     "script" "quick-launch-zellij"
                     "args" "\"workspace\""
                     "width" "70%"
                     "height" "60%") }}
        }
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "normal"
        }
    }
    tab {
        // Move focus around
        bind "left" { GoToPreviousTab; }
        bind "right" { GoToNextTab; }
        bind "h" { GoToPreviousTab; }
        bind "l" { GoToNextTab; }

        bind "tab" { ToggleTab; } // last used tab

        // Jump to tabs
        bind "1" { SwitchToMode "normal"; GoToTab 1; }
        bind "2" { SwitchToMode "normal"; GoToTab 2; }
        bind "3" { SwitchToMode "normal"; GoToTab 3; }
        bind "4" { SwitchToMode "normal"; GoToTab 4; }
        bind "5" { SwitchToMode "normal"; GoToTab 5; }
        bind "6" { SwitchToMode "normal"; GoToTab 6; }
        bind "7" { SwitchToMode "normal"; GoToTab 7; }
        bind "8" { SwitchToMode "normal"; GoToTab 8; }
        bind "9" { SwitchToMode "normal"; GoToTab 9; }
        bind "0" { SwitchToMode "normal"; GoToTab 10; }

        // Tab manipulation (rename)
        bind "n" { SwitchToMode "renametab"; TabNameInput 0; }

        // Tab manipulation (create)
        bind "P" { SwitchToMode "normal"; BreakPane; }  // make a pane become a tab
        bind "N" { SwitchToMode "normal"; NewTab; }     // new tab
        bind "T" {
            SwitchToMode "normal"
            {{ template "zellijModalRun"
               (dict "home" .chezmoi.homeDir
                     "title" "Quick Launch — Tab"
                     "inject" false
                     "borderless" true
                     "no_chrome" true
                     "no_discover" true
                     "script" "quick-launch-zellij"
                     "args" "\"tab\""
                     "width" "70%"
                     "height" "60%") }}
        }

        // Tab manipulation (closing)
        bind "x" { SwitchToMode "normal"; CloseTab; }
        bind "[" { SwitchToMode "normal"; BreakPaneLeft; }  // make tab become a pane on the left tab
        bind "]" { SwitchToMode "normal"; BreakPaneRight; } // make a tab become a pane on the right tab

        // Tab manipulation (mode)
        bind "s" { ToggleActiveSyncTab; SwitchToMode "normal"; } // all panes of the tab get the same input
    }
    pane {
        bind "m" { SwitchToMode "move"; }
        bind "r" { SwitchToMode "resize"; }

        // Pane manipulation (rename)
        bind "n" { SwitchToMode "renamepane"; PaneNameInput 0; }

        // Move focus around
        bind "left" { MoveFocus "left"; }
        bind "down" { MoveFocus "down"; }
        bind "up" { MoveFocus "up"; }
        bind "right" { MoveFocus "right"; }
        bind "h" { MoveFocus "left"; }
        bind "j" { MoveFocus "down"; }
        bind "k" { MoveFocus "up"; }
        bind "l" { MoveFocus "right"; }

        bind "tab" { SwitchFocus; } // Cycle through panes

        // Pane creation (mode-ending bindings)
        bind "N" { NewPane; SwitchToMode "normal"; }
        bind "Shift left" { NewPane "left"; SwitchToMode "normal"; }
        bind "Shift down" { NewPane "down"; SwitchToMode "normal"; }
        bind "Shift up" { NewPane "up"; SwitchToMode "normal"; }
        bind "Shift right" { NewPane "right"; SwitchToMode "normal"; }
        bind "H" { NewPane "left"; SwitchToMode "normal"; }
        bind "J" { NewPane "down"; SwitchToMode "normal"; }
        bind "K" { NewPane "up"; SwitchToMode "normal"; }
        bind "L" { NewPane "right"; SwitchToMode "normal"; }
        bind "S" { NewPane "stacked"; SwitchToMode "normal"; }
        bind "P" {
            SwitchToMode "normal"
            {{ template "zellijModalRun"
               (dict "home" .chezmoi.homeDir
                     "title" "Quick Launch — Pane"
                     "inject" false
                     "borderless" true
                     "no_chrome" true
                     "script" "quick-launch-zellij"
                     "args" "\"pane\""
                     "width" "70%"
                     "height" "70%") }}
        }

        // Pane manipulation (mode-ending binding)
        bind "p" { TogglePanePinned; SwitchToMode "normal"; }
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "normal"; }
        bind "t" { ToggleFloatingPanes; SwitchToMode "normal"; }
        bind "f" { TogglePaneFrames; SwitchToMode "normal"; }
        bind "x" { CloseFocus; SwitchToMode "normal"; }

        // Pane manipulation (non-mode-ending binding)
        bind "Alt t" { ToggleFloatingPanes; }
    }
    move {
        bind "left" { MovePane "left"; }
        bind "down" { MovePane "down"; }
        bind "up" { MovePane "up"; }
        bind "right" { MovePane "right"; }
        bind "h" { MovePane "left"; }
        bind "j" { MovePane "down"; }
        bind "k" { MovePane "up"; }
        bind "l" { MovePane "right"; }

        bind "tab" { MovePane; }
        bind "Shift tab" { MovePaneBackwards; }
    }
    resize {
        bind "left" { Resize "Increase left"; }
        bind "down" { Resize "Increase down"; }
        bind "up" { Resize "Increase up"; }
        bind "right" { Resize "Increase right"; }
        bind "h" { Resize "Increase left"; }
        bind "j" { Resize "Increase down"; }
        bind "k" { Resize "Increase up"; }
        bind "l" { Resize "Increase right"; }

        bind "H" { Resize "Decrease left"; }
        bind "J" { Resize "Decrease down"; }
        bind "K" { Resize "Decrease up"; }
        bind "L" { Resize "Decrease right"; }
        bind "Shift left" { Resize "Decrease left"; }
        bind "Shift down" { Resize "Decrease down"; }
        bind "Shift up" { Resize "Decrease up"; }
        bind "Shift right" { Resize "Decrease right"; }

        bind "-" { Resize "Decrease"; }
        bind "+" { Resize "Increase"; }
        bind "=" { Resize "Increase"; }
    }
    scroll {
        bind "V" { EditScrollback; SwitchToMode "normal"; }
        // Open the floating "visual search" dialog. The dialog is the
        // `status-bar` plugin in its per-tab `role "search"` instance (spawned
        // by the layout, parked until needed); the active tab's instance reveals
        // itself when the client enters `EnterSearch` and flips to `Search`.
        bind "/" { SwitchToMode "EnterSearch"; }

        // Jump prompt-by-prompt. Ghostty's native Cmd+Up/Cmd+Down maps to
        // `jump_to_prompt` but those markers don't survive zellij's VTE,
        // so we ship a small plugin (zj-prompt-jumper) that scans scrollback
        // for the p10k prompt prefix and re-aligns the viewport. Mirrors
        // the `n`/`p` convention already used in `search` mode for next/
        // previous result. The plugin places the target prompt at the top
        // of the viewport.
        bind "n" {
            MessagePlugin "prompt-jumper" {
                name "next"
            }
        }
        bind "p" {
            MessagePlugin "prompt-jumper" {
                name "prev"
            }
        }
    }
    search {
        bind "n" { Search "down"; }
        bind "N" { Search "up"; }
        // Search-option toggles. Routed through the zj-hud `role "search"`
        // instance rather than a bare `SearchToggleOption` so the bar's
        // Search-mode hint glyphs stay in sync: a plugin can't observe native
        // `SearchToggleOption`, so the search role is the single source of truth
        // — it runs the toggle against the focused pane *and* publishes the
        // option state the bar renders. `role "search"` is the search instance's
        // *exact* config (pipes match by url+configuration), so the message lands
        // there instead of spawning a fresh pane; the active tab's instance acts.
        bind "Alt c" { MessagePlugin "status-bar" { name "zj_hud_search_toggle"; payload "case"; role "search"; }; }
        bind "Alt b" { MessagePlugin "status-bar" { name "zj_hud_search_toggle"; payload "word"; role "search"; }; }
        bind "Alt p" { MessagePlugin "status-bar" { name "zj_hud_search_toggle"; payload "wrap"; role "search"; }; }
        // `backspace` here steps back along the which-key trail (the shared
        // `wk_go_back` binding below now includes `search`). Because the floating
        // dialog's `EnterSearch` excursion is frozen out of the mode-trail, the
        // top of the trail in `Search` is the mode we searched *from* (e.g.
        // `scroll`), so back returns there rather than reopening the editor.
        // (`esc` → normal and `enter` → normal come from the `shared_except`
        // blocks below; native `n`/`N` above navigate matches.)
    }
    shared_except "normal" "locked" "entersearch" "renametab" "renamepane" {
        bind "esc" { SwitchToMode "normal"; }
    }
    shared_among "scroll" "search" {
        bind "PageDown" { PageScrollDown; }
        bind "f" { PageScrollDown; }
        bind "PageUp" { PageScrollUp; }
        bind "b" { PageScrollUp; }
        bind "down" { ScrollDown; }
        bind "j" { ScrollDown; }
        bind "up" { ScrollUp; }
        bind "k" { ScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "home" { ScrollToTop; }
        bind "g" { ScrollToTop; }
        bind "end" { ScrollToBottom; }
        bind "G" { ScrollToBottom; }
        // Cmd+Up/Down chord (`Alt+w l k` / `Alt+w l j`) stays re-entrant when
        // already in scroll mode — the `l` in the chord no longer triggers
        // PageScrollDown. Use `PgUp`/`PgDown` or `b`/`f` for page nav.
    }
    entersearch {
        // Both Ctrl+c and Esc bail straight to normal rather than scroll,
        // because the common entry point now is `Alt+/` (Ghostty's Cmd+F)
        // which skips scroll mode entirely.
        bind "esc"    { SwitchToMode "normal"; }
        bind "enter"  { SwitchToMode "search"; }
    }
    renametab {
        // esc cancels the rename and returns straight to normal mode,
        // matching the project-wide "esc always exits to normal" rule.
        bind "esc" { UndoRenameTab; SwitchToMode "tab"; }
    }
    renamepane {
        // esc cancels the rename and returns straight to normal mode,
        // matching the project-wide "esc always exits to normal" rule.
        bind "esc" { UndoRenamePane; SwitchToMode "pane"; }
    }
    // which-key panel controls. The hint panel is the zj-hud plugin in
    // its `role "whichkey"` instance (it shares the `status-bar` alias but is
    // launched per-tab by the layout with `role "whichkey"` config). A pipe is
    // matched to a running plugin by URL **and configuration**, so we MUST
    // repeat `role "whichkey"` here — otherwise the bare alias doesn't match any
    // running instance and Zellij launches a brand-new bar in a split pane.
    // With the matching config the pipe reaches every per-tab which-key instance
    // (only the active one acts). Bound only in the navigation modes where the
    // panel is shown (resting Normal/Locked are excluded; text-input modes like
    // rename*/entersearch are skipped so Ctrl-keys don't shadow typing).
    //
    // The chords mirror the footer hint glyphs set in the layout's
    // `which_key { … }` block (next_page_key/prev_page_key/toggle_key/back_key):
    //   Alt+.  → show/hide the panel               (wk_toggle_pane)
    //   Ctrl+d / Ctrl+u → next / previous page when entries overflow (vim-style)
    //   Backspace → step back one mode along the trail (wk_go_back)
    shared_among "pane" "tab" "resize" "move" "scroll" "search" "tmux" "session" {
        bind "Alt ." { MessagePlugin "status-bar" { name "wk_toggle_pane"; role "whichkey"; }; }
        bind "Ctrl d" { MessagePlugin "status-bar" { name "wk_next_page"; role "whichkey"; }; }
        bind "Ctrl u" { MessagePlugin "status-bar" { name "wk_prev_page"; role "whichkey"; }; }
    }
    // `go_back` on Backspace. `search` is included: while the floating search
    // dialog is up the client is parked in `Normal` (not `Search`) and the
    // mode-trail is frozen, so this binding is inert during query typing and
    // can't shadow the dialog's own Backspace. It only acts once you're in
    // `Search` (navigating matches), where it steps back to the originating mode.
    shared_among "pane" "tab" "resize" "move" "scroll" "search" "tmux" "session" {
        bind "backspace" { MessagePlugin "status-bar" { name "wk_go_back"; role "whichkey"; }; }
    }
}

// Plugin aliases - can be used to change the implementation of Zellij
// changing these requires a restart to take effect
plugins {
    about location="zellij:about"
    compact-bar location="zellij:compact-bar"
    configuration location="zellij:configuration"
    filepicker location="zellij:strider" {
        cwd "/"
    }
    plugin-manager location="zellij:plugin-manager"
    session-manager location="zellij:session-manager"
    strider location="zellij:strider"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }

{{/*
  Custom plugin sources — driven by the shared manifest in
  .chezmoidata/zellij-plugins.yaml (`.zellijPlugins`). Each entry:
    - alias:    the alias used here and in keybinds (`MessagePlugin "<alias>"`).
    - wasm:     basename under the managed plugin dir.
    - repoName: the dev checkout / wasm basename under ~/Projects/apps/zellij.
    - dev:      whether a local dev checkout is expected.
    - url:      the release asset (used only by ensure-plugins to fetch it).

  Resolution policy lives in .chezmoitemplates/zellij-plugin-path.tmpl and is
  shared by ensure-plugins and the permission pre-grant. Every location is
  `file:` — we never let Zellij's http downloader fetch a plugin, because it
  caches transient gateway/CDN errors (404/504 HTML) as the wasm and never
  retries, silently breaking the plugin.

  Whitespace: the no-dash comment form preserves the preceding blank line;
  the directives below trim aggressively and each printed line carries its
  own 4-space indent + newline, matching the surrounding KDL.
*/}}
{{- $lines := list -}}
{{- range .zellijPlugins -}}
{{- $loc := includeTemplate "zellij-plugin-path.tmpl" (dict "root" $ "plugin" . "filePrefix" true) | trim -}}
{{- if eq .alias "vim-navigator" -}}
{{- $lines = append $lines (printf "    %s location=\"%s\" {\n        move_mod \"ctrl\"\n        resize_mod \"ctrl+shift\"\n    }" .alias $loc) -}}
{{- else -}}
{{- $lines = append $lines (printf "    %s location=\"%s\"" .alias $loc) -}}
{{- end -}}
{{- end -}}
{{ join "\n" $lines }}

    // NB: neither the which-key panel nor the search dialog gets its own alias.
    // All three roles (bar / search / which-key) are the *same* zj-hud
    // wasm, distinguished only by their `role` config, so they share one URL
    // and one per-URL permission grant. Each role just references the
    // `status-bar` alias with the matching `role`:
    //   - which-key: the layout spawns it per-tab as a floating pane
    //                (`plugin location="status-bar" { role "whichkey" }`).
    //   - search:    the layout *also* spawns it per-tab the same way
    //                (`plugin location="status-bar" { role "search" }`); a
    //                floating pane belongs to one tab, so one instance per tab.
    // The bar publishes its mode palette + which_key/search config blocks
    // through the shared state, so neither panel needs duplicate config here.

    // vim-navigator (hiasr/vim-zellij-navigator) is rendered by the manifest
    // loop above with its `move_mod "ctrl"` / `resize_mod "ctrl+shift"` block —
    // those mods are constant across binds, so per-bind nodes only set `name`,
    // `payload`, and `use_arrow_keys`.

}

// Plugins to load in the background when a new session starts
// eg. "file:/path/to/my-plugin.wasm"
// eg. "https://example.com/my-plugin.wasm"
load_plugins {
    zellij:link
    context-keys
    prompt-jumper
    vim-navigator
    // NB: the visual search dialog (`role "search"`) is NOT preloaded here.
    // Like the which-key panel, it is spawned per-tab by the layout's
    // `floating_panes` (a floating pane belongs to one tab, so a single shared
    // instance could only ever show on one tab). Each instance parks itself
    // until its trigger reveals the active tab's one.
}
web_client {
    font "monospace"
}
 
 
// Choose the theme that is specified in the themes section.
// Default: default
// 
// `system` is written at shell startup by theme-apply: the canonical
// chezmoi-system theme overlaid with the loose per-machine
// ~/.config/theme/override.toml. zj-hud's bar follows this theme, so a `base`
// override tints the bar to match the terminal background.
theme "chezmoi-system"
 
// Theme to use when the host terminal reports a dark color palette.
// Requires `theme_light` to also be set; otherwise `theme` is used.
// 
// theme_dark "dracula"
 
// Theme to use when the host terminal reports a light color palette.
// Requires `theme_dark` to also be set; otherwise `theme` is used.
// 
// theme_light "solarized-light"
 
// The name of the default layout to load on startup
// Default: "default"
// 
// default_layout "compact"
 
// The folder in which Zellij will look for layouts
// (Requires restart)
// 
// layout_dir "/tmp"
 
// The folder in which Zellij will look for themes
// (Requires restart)
// 
// theme_dir "/tmp"
 
// Disable frames globally. zjstatus's `hide_frame_for_single_pane` is
// also off in layouts/default.kdl. Any combination where either side
// tries to dynamically toggle frames flickers indefinitely on this setup,
// so we just keep them off.
pane_frames false

// Frame corner style. zellij has no per-pane rounded-corners control —
// it's this global UI setting only. Since `pane_frames false` above keeps
// every tiled pane frameless, the only panes that draw a zellij frame are
// the framed dialogs that keep the default `borderless false` (e.g. the
// gum confirm prompts) and zellij-open's image preview — so this rounds
// just those. fzf pickers pass `borderless true` and let pty-frame draw
// their own rounded chrome.
ui {
    pane_frames {
        rounded_corners true
    }
}
 
// Configure the scroll back buffer size
// This is the number of lines zellij stores for each pane in the scroll back
// buffer. Excess number of lines are discarded in a FIFO fashion.
// (Requires restart)
// Valid values: positive integers
// Default value: 10000
// 
scroll_buffer_size 1000000
 
// Provide a command to execute when copying text. The text will be piped to
// the stdin of the program to perform the copy. This can be used with
// terminal emulators which do not support the OSC 52 ANSI control sequence
// that will be used by default if this option is not set.
// Examples:
//
// copy_command "xclip -selection clipboard" // x11
// copy_command "wl-copy"                    // wayland
// copy_command "pbcopy"                     // osx
//
// Intentionally left UNSET on every platform. Zellij intercepts an
// application's OSC 52 copy and never passes it to the outer terminal; with no
// copy_command it instead re-emits OSC 52 to the focused client's terminal
// (WezTerm), which has no payload-size cap and writes the clipboard. That makes
// copy *origin-relative*:
//   - sitting locally  → WezTerm writes this machine's clipboard;
//   - reached over ssh → the sequence rides the ssh stream up to the laptop's
//                        WezTerm and writes the *laptop's* clipboard.
// So a Mac reached over ssh behaves exactly like the Linux dev-shell (yanks and
// terminal selections land on the machine you're typing at), instead of the
// `copy_command "pbcopy"` we used to set on macOS, which captured copies to the
// *remote* Mac's own clipboard and broke that symmetry.
//
// Trade-off: a multi-MB local selection is shipped as inline base64 rather than
// piped to pbcopy — marginally slower, never truncated (Zellij dropped its 1 KB
// OSC cap in 0.11.0; WezTerm sets the clipboard unbounded). Local nvim is
// unaffected: it drives pbcopy/pbpaste as subprocesses, bypassing Zellij.
//
// Paste back in is a WezTerm paste (Cmd+V / middle-click), not OSC 52 — Zellij
// refuses OSC 52 clipboard *reads*. Register paste in remote nvim instead reads
// the reverse SSH tunnel (see options.lua + ~/.ssh/config.d/clipboard.config).
 
// Re-emit OSC 8 hyperlinks to the outer terminal so file:// / URL links stay
// clickable through Zellij (default is false, which strips them). WezTerm then
// resolves the link under the cursor and fires its `open-uri` handler on click.
osc8_hyperlinks true
 
// Enable automatic copying (and clearing) of selection when releasing mouse
// Default: true
// 
// copy_on_select true
 
// Path to the default editor to use to edit pane scrollbuffer
// Default: $EDITOR or $VISUAL
// scrollback_editor "/opt/homebrew/bin/nvim"
 
// When `session_name` is provided, attaches to that session
// if it is already running or creates it otherwise.
// Default: false
// 
attach_to_session true
 
// Whether sessions should be serialized to the cache folder (including their tabs/panes, cwds and running commands) so that they can later be resurrected
// Options:
//   - true (default)
//   - false
// 
// Disabled because cached layouts override edits to layouts/default.kdl —
// every new session should start from the current layout file.
session_serialization false

// Whether to show tips on startup
// Default: true
// 
show_startup_tips false
 
// Whether to show release notes on first version run
// Default: true
// 
show_release_notes false
 
// Whether to enable mouse hover effects and pane grouping functionality
// default is true
// advanced_mouse_actions false
 
// Whether to enable mouse hover visual effects (frame highlight and help text)
// default is true
//
// Disabled here because the auto-rendered "scroll / resize" hints
// zellij overlays on hover were noisy in the LEADER+q quit-confirm
// floating pane (see the `bind "q"` block in the tmux mode above).
// The hint suppression is global — there's no per-pane override —
// but with leader chords memorized the hover affordance was never
// actually useful in tiled panes either. Frame-highlight on hover
// is collateral damage of the same flag.
mouse_hover_effects false
 
// Whether to show visual bell indicators (pane/tab frame flash and [!] suffix)
// default is true
// visual_bell true
 
// Whether to focus panes on mouse hover
// default is false
// focus_follows_mouse false
 
// Whether clicking a pane to focus it also sends the click into the pane
// default is false
// mouse_click_through false
 
// A command to run (will be wrapped with sh -c and provided the RESURRECT_COMMAND env variable) 
// after Zellij attempts to discover a command inside a pane when resurrecting sessions, the STDOUT
// of this command will be used instead of the discovered RESURRECT_COMMAND
// can be useful for removing wrappers around commands
// Note: be sure to escape backslashes and similar characters properly
// post_command_discovery_hook "echo $RESURRECT_COMMAND | sed <your_regex_here>"
