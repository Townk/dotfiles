#!/bin/bash
# Ensure the managed Zellij plugin wasms exist before Zellij starts.
#
# Called from .zshrc right before the shell execs Zellij. We fetch the wasms
# ourselves — sequential, redirect-following, retried, magic-validated — into
# ~/.local/share/zellij/plugins/ and let config.kdl load them via `file:`.
# Zellij's own http downloader is deliberately bypassed: it caches whatever a
# transient failure returns (a GitHub 404 body, a corporate-gateway 504 HTML
# page) as the plugin and never retries, which silently breaks the plugin
# (e.g. an empty status bar that never recovers).
#
# Resolution mirrors config.kdl via .chezmoitemplates/zellij-plugin-path.tmpl:
# a `dev` plugin with a built release wasm loads from that local build and is
# skipped here; everything else is fetched to the managed dir. Fast on the hot
# path — a present, valid wasm is left untouched.
#
# After (or regardless of) the fetch, re-grant plugin permissions via the
# sibling grant-plugin-permissions script. That re-grant runs on EVERY shell
# launch — not just `chezmoi apply` — so a runtime denial in a prior session
# (which overwrites the plugin's whole permission-cache entry with an empty
# list) is repaired before zellij starts. See that script's header for the
# full rationale; zellij has no "accept all" config option, so the cache
# pre-grant is the only lever.
set -uo pipefail

plugins_dir="$HOME/.local/share/zellij/plugins"
mkdir -p "$plugins_dir"

# True when the file starts with the wasm magic `\0asm` (00 61 73 6d).
is_wasm() {
  [ -f "$1" ] || return 1
  [ "$(head -c4 "$1" 2>/dev/null | od -An -tx1 | tr -d ' \n')" = "0061736d" ]
}

# Fetch url -> dest atomically, only accepting a real wasm. Leaves any existing
# good file in place on failure (better a stale-but-working plugin than none).
fetch() {
  local url=$1 dest=$2 tmp
  tmp="$dest.part"
  # --retry-all-errors so flaky 504s from a corporate gateway are retried too
  # (plain --retry skips some 5xx). Missing-but-clean beats poisoned: on a
  # total failure we leave no file, and the next shell launch retries.
  if curl -fsSL --connect-timeout 10 --max-time 120 \
       --retry 5 --retry-delay 2 --retry-all-errors \
       -o "$tmp" "$url" && is_wasm "$tmp"; then
    mv -f "$tmp" "$dest"
    return 0
  fi
  rm -f "$tmp"
  echo "ensure-plugins: failed to fetch $(basename "$dest") from $url" >&2
  return 1
}

{{ range .zellijPlugins -}}
{{- $path := includeTemplate "zellij-plugin-path.tmpl" (dict "root" $ "plugin" .) | trim -}}
{{- $managed := joinPath $.chezmoi.homeDir ".local/share/zellij/plugins" .wasm -}}
{{ if ne $path $managed -}}
# {{ .wasm }} — config loads the local dev build at {{ $path }}, skip.
{{ else -}}
is_wasm "$plugins_dir/{{ .wasm }}" || fetch "{{ .url }}" "$plugins_dir/{{ .wasm }}"
{{ end -}}
{{ end -}}

# Re-grant before zellij loads. Best-effort: a failure to re-grant must not
# abort the shell launch (the apply-time grant may still be intact). The grant
# is path-keyed and independent of the wasm fetch above, so order doesn't
# matter, but running it last lets the fetch warm the managed dir first.
grant="$HOME/.config/zellij/grant-plugin-permissions"
[ -x "$grant" ] && "$grant" || true
