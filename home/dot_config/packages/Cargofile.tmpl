{{- $traits := includeTemplate "profile-traits.tmpl" . | fromJson -}}
# Cargofile — Rust binaries installed via `cargo install`.
# Synced by `system-package cargo sync`. Strict cleanup: removing a
# line uninstalls the crate on next sync.
#
# Lines may include `cargo install` flags after the crate name;
# `--features=<feat>`, `--locked`, `--git=<url>`, etc. land verbatim.
# Crates installed with extra args are reinstalled with `--force` when the
# line below changes, so edited flags actually re-apply.

{{ if $traits.devTooling -}}
kdl-lsp           # KDL Document Language LSP server (for: nvim)
usvg              # SVG simplifier; normalizes custom icons in the nerd-font build
{{- end }}
tidy-viewer       # CSV pretty-printer (command: tidy-viewer / tv)
{{- if eq .chezmoi.os "linux" }}
tree-sitter-cli --locked  # nvim-treesitter (main) builds EVERY parser through the
                          # tree-sitter CLI, so syntax highlighting needs it on every
                          # profile: infrastructure, not dev tooling. Built locally
                          # because Mason's Linux binary needs a newer glibc.
{{- if $traits.devTooling }}
tokei --locked            # Source code metrics (brew on macOS). No prebuilt binaries
                          # exist, and the mise toolbox installs before rustup has a
                          # default toolchain; the explicit flag routes this straight
                          # to `cargo install` (no binstall probe) once Rust is ready.
onefetch --locked         # Repo stats (brew on macOS). Upstream publishes ONE linux
                          # asset, onefetch-linux.tar.gz, and it needs GLIBC_2.39 —
                          # unrunnable on Ubuntu 22.04, with no musl build to fall back
                          # to the way the rest of the mise toolbox now does. The flag
                          # is load-bearing for the same reason as tokei's: bare lines
                          # go through binstall, which would fetch that very binary.
{{- end }}
{{- end }}

# vim:ft=conf.gotmpl
