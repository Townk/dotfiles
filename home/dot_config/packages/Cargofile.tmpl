# Cargofile — Rust binaries installed via `cargo install`.
# Synced by `system-package cargo sync`. Strict cleanup: removing a
# line uninstalls the crate on next sync.
#
# Lines may include `cargo install` flags after the crate name;
# `--features=<feat>`, `--locked`, `--git=<url>`, etc. land verbatim.
# Crates installed with extra args are reinstalled with `--force` every
# sync so flag changes actually re-apply.

kdl-lsp           # KDL Document Language LSP server (for: nvim)
{{- if and (eq .chezmoi.os "linux") (eq .profile "dev-shell") }}
tree-sitter-cli --locked  # Build locally; Mason's Linux binary needs newer glibc.
{{- end }}

