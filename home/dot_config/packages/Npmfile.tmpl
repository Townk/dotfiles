# Npmfile — globally-installed npm packages.
# Synced by `system-package npm sync`. Strict cleanup: removing a
# line uninstalls the package on next sync.
#
# Non-registry installs (git / tarball):
#   <canonical-name> -- <install-spec>
# The canonical name is matched against `npm ls -g`; the spec is passed
# to `npm install -g`. Prefer GitHub tarball URLs over github: URLs.

# Apps
@anthropic-ai/claude-code
{{ if eq .profile "personal" -}}
@tobilu/qmd
{{- end }}
@earendil-works/pi-coding-agent
hunkdiff

# MCP servers (Cursor ~/.cursor/mcp.json)
{{- if ne .profile "dev-shell" }}
wezterm-mcp
ghostty-mcp -- https://github.com/GitJuhb/ghostty-mcp/tarball/main
{{- end }}
zellij-mcp-server -- https://github.com/GitJuhb/zellij-mcp-server/tarball/main

# LSP packages
typescript
typescript-language-server
basedpyright

