# Npmfile — globally-installed npm packages.
# Synced by `system-package npm sync`. Strict cleanup: removing a
# line uninstalls the package on next sync.
#
# Non-registry installs (git / tarball):
#   <canonical-name> -- <install-spec>
# The canonical name is matched against `npm ls -g`; the spec is passed
# to `npm install -g`. Prefer GitHub tarball URLs over github: URLs.

