{{- /* mlx-vlm feeds the mlx-gemma/pi-local stack, a human-machine feature —
       headless hosts skip it (fail-closed trait gate, not a literal-profile
       check). */ -}}
# Uvfile — Python tools managed via `uv tool install`.
# Synced by `system-package uv sync`. Strict cleanup: removing a
# line uninstalls the tool on next sync.
#
# Default form (PyPI):
#   <tool> [uv-tool-install-flags...]
#   e.g.  rich-cli --with catppuccin[pygments]
#
# Alternate form (non-PyPI install spec — git / local / editable):
#   <canonical-name> -- <package-spec> [flags...]
#   e.g.  omlx -- git+https://github.com/jundot/omlx --python 3.11
# The `--` token separates the canonical name (used to diff against
# `uv tool list`) from the install spec sent to `uv tool install`.

{{ if eq .profile "personal" -}}
qmk-skim
{{- end }}
{{ if and (eq .chezmoi.os "darwin") (not $traits.headless) -}}
# mlx-vlm — Apple's MLX multimodal inference server: the sanctioned, fastest
# path on Apple Silicon. The [mlx-gemma] launchd user agent (see services.toml)
# runs mlx_vlm.server directly on :8799. Python 3.13 has full mlx wheel
# coverage; uv fetches it if missing.
mlx-vlm --python 3.13
huggingface-hub
{{- end }}
rich-cli --with catppuccin[pygments]
# ansible-core — drives the fleet repo's playbooks (~/Projects/platforms/fleet).
# Core (not the `ansible` bundle): ansible-playbook is a core entry point and
# the fleet playbooks use only ansible.builtin.
ansible-core

