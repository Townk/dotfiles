# Uvfile — Python tools managed via `uv tool install`.
# Synced by `system-package uv sync`. Strict cleanup: removing a
# line uninstalls the tool on next sync.
#
# Default form (PyPI):
#   <tool> [uv-tool-install-flags...]
#   e.g.  rich-cli --with catppuccin[pygments]
#
# Alternate form (non-PyPI install spec — git / local / editable):
#   <canonical-name> -- <package-spec> [flags...]
#   e.g.  omlx -- git+https://github.com/jundot/omlx --python 3.11
# The `--` token separates the canonical name (used to diff against
# `uv tool list`) from the install spec sent to `uv tool install`.

{{ if eq .profile "personal" -}}
qmk-skim
{{- end }}
{{ if ne .profile "dev-shell" -}}
# mlx-lm + mlx-vlm — Apple's MLX inference CLIs/servers: the sanctioned,
# fastest path on Apple Silicon. Each model is served by its own
# mlx_lm.server / mlx_vlm.server process (so each keeps its own MTP draft
# config); llama-swap (brew) is the proxy that launches/hot-swaps them on
# one port. Python 3.13 has full mlx wheel coverage; uv fetches it if missing.
mlx-lm --python 3.13
mlx-vlm --python 3.13
huggingface-hub
{{- end }}
rich-cli --with catppuccin[pygments]

# Headroom — local context compression / CCR / memory proxy for agent traffic.
# Managed as an explicit package spec so `uv tool list` tracks `headroom-ai`
# while installing the proxy, MCP, memory, and Apple GPU embedder extras.
headroom-ai -- headroom-ai[proxy,mcp,memory,pytorch-mps] --python 3.13

