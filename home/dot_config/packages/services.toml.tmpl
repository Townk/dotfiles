# Servicefile — declarative manifest for launchd-managed user agents.
# Synced by `system-service sync`. Strict cleanup: removing a section
# boots-out the service and deletes its plist on the next sync.
#
# Schema (per `[<name>]` section, all keys optional except `cmd`):
#   cmd            = ["bin", "args..."]      → ProgramArguments
#   keep_alive     = true|false              → KeepAlive
#   run_at_load    = true|false              → RunAtLoad
#   working_dir    = "~/path"                → WorkingDirectory
#   log_path       = "~/path/out.log"        → StandardOutPath
#   error_log_path = "~/path/err.log"        → StandardErrorPath
#   description    = "human-friendly text"   (info / list only — not in plist)
#
#   [<name>.env]                             → EnvironmentVariables
#   KEY = "value"
#
# Paths support a leading `~` (expanded by the worker at plist-gen time, NOT
# by chezmoi). cmd[0] is resolved via `command -v` so the rendered plist
# carries an absolute path — launchd cannot resolve unqualified names.
#
# Brew-installed services live under `brew services` and stay declared in
# the formula; they are NOT listed here. `system-service list` aggregates
# both sources.

{{ if eq .profile "personal" -}}
# Add personal-only services
{{- end }}

{{ if eq .chezmoi.os "darwin" -}}
# clipboard-bridge — serve the Mac clipboard to remote nvim over an SSH
# reverse tunnel. Closes the one clipboard gap left by Zellij refusing OSC 52
# reads: a remote `"+p` can't pull the Mac clipboard otherwise.
#
# socat listens on loopback TCP 2489 and, on every accepted connection, EXECs
# a fresh clipboard-bridge-dispatch — the Phase 5 per-connection handler that
# speaks a length-prefixed binary framing protocol (get/get-regtype/set/
# restore/copy/fetch-file; see docs/clipboard-universal-project.md §11). It is
# backward compatible: an old bare-`nc -U` client that connects and sends
# nothing hits the dispatcher's short first-byte timeout and falls through to
# `exec pbpaste`, exactly the pre-Phase-5 behavior, so the *live* clipboard is
# still served (a `pbpaste | nc -l` loop would snapshot at listen time and
# serve stale text). `fork` handles concurrent/repeated pastes; the remote
# reaches it through a user-only unix socket forwarded by SSH (see
# ~/.ssh/config.d/clipboard.config). macOS only: pbpaste is the source of
# truth off-host there's nothing to serve.
[clipboard-bridge]
description    = "Serve the Mac clipboard to remote nvim over an SSH reverse tunnel"
cmd            = ["socat", "TCP-LISTEN:2489,bind=127.0.0.1,fork,reuseaddr", "EXEC:{{ .chezmoi.homeDir }}/.local/libexec/clipboard-bridge-dispatch"]
keep_alive     = true
run_at_load    = true
log_path       = "~/.cache/clipboard-bridge/listener.log"
error_log_path = "~/.cache/clipboard-bridge/listener.log"

[clipboard-bridge.env]
# Unlike the old bare-pbpaste target (an absolute path needing nothing), the
# dispatcher shells out to sqlite3 and hs (rich restore/copy) — neither is on
# launchd's minimal PATH. Mirror the images-automount PATH so /opt/homebrew/bin
# (hs) and /usr/bin (sqlite3, pbpaste, pbcopy) resolve.
PATH = "~/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/sbin:/usr/sbin"

# clipboard-mirror — receive a laptop's clipboard-history mirror over the SSH
# LocalForward -L (see ~/.ssh/config.d/clipboard.config). socat listens on
# loopback TCP 2491 and EXECs clipboard-mirror-dispatch per connection, which
# upserts a text+metadata `laptop-ref` row (no blobs) into this host's store.
# Loopback TCP (not a unix socket) for the same reason the reverse channel is:
# a forwarded socket file goes stale on an unclean disconnect and macOS ssh
# won't clear it; a port frees itself. macOS only (capture is Hammerspoon).
[clipboard-mirror]
description    = "Receive a laptop's clipboard history mirror over an SSH -L forward"
cmd            = ["socat", "TCP-LISTEN:2491,bind=127.0.0.1,fork,reuseaddr", "EXEC:{{ .chezmoi.homeDir }}/.local/libexec/clipboard-mirror-dispatch"]
keep_alive     = true
run_at_load    = true
log_path       = "~/.cache/clipboard-bridge/mirror.log"
error_log_path = "~/.cache/clipboard-bridge/mirror.log"

[clipboard-mirror.env]
PATH = "~/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/sbin:/usr/sbin"

# images-automount — mount declared sparse images at login. Generic, one-shot
# (keep_alive=false): runs `system-images mount --all`, which mounts every
# image with automount=true in the loose ~/.config/packages/images.toml. With
# no images.toml it's a clean no-op, so this entry is harmless on any Mac.
# Replaces the old hand-rolled com.user.mountlocalrepos agent.
[images-automount]
description = "Mount declared sparse images at login"
cmd         = ["system-images", "mount", "--all"]
run_at_load = true
keep_alive  = false
log_path    = "~/.cache/system-images/automount.log"
error_log_path = "~/.cache/system-images/automount.log"

[images-automount.env]
# launchd agents don't inherit an interactive PATH; system-images shells out to
# yq/jq/hdiutil/diskutil. Mirror the dirs the omlx agent bakes in.
PATH = "~/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/sbin:/usr/sbin"
{{ end }}

{{ if ne .profile "dev-shell" -}}
# mlx-gemma — DIRECT mlx_vlm.server for pi-local's single-model setup.
# pi-local was repointed off the old headroom→gateway→llama-swap chain to talk
# straight to mlx_vlm.server on :8799 (one model, so the hot-swap and
# local-agent-auto routing layers had no job). This entry is the lifecycle
# owner that llama-swap used to be for that path. The old [llama-swap] /
# [local-llm-gateway] / [headroom] sections were removed once nothing was left
# consuming :8787/:8100/:8000 — mlx-gemma on :8799 is now the only
# local-inference service declared here.
#
# ON-DEMAND by design: keep_alive=false + run_at_load=false, so the ~8.4GB
# model (≈15–17GB resident with a full 128K-context KV) is NOT pinned at every
# login. Start it only when coding:  `system-service start mlx-gemma`
# (stop: `system-service stop mlx-gemma`). To make it always-on instead, set
# BOTH keys below to true; note launchd has no native idle-unload, so
# always-on means permanently resident.
#
# cmd[0] is `command -v`-resolved to ~/.local/bin/mlx_vlm.server (uv shim).
# The --model/--draft-model paths MUST be absolute: the worker passes cmd args
# verbatim (no ~ expansion).
[mlx-gemma]
description    = "Local LLM inference: direct mlx_vlm.server (Gemma 4 OptiQ-4bit + MTP drafter) on :8799"
cmd            = [
  "mlx_vlm.server",
  "--model", "{{ .chezmoi.homeDir }}/.local/share/mlx/models/gemma-4-12B-it-qat-OptiQ-4bit",
  "--draft-model", "{{ .chezmoi.homeDir }}/.local/share/mlx/models/gemma-4-12B-it-qat-q4_0-assistant",
  "--draft-kind", "mtp",
  "--draft-block-size", "4",
  "--max-tokens", "2048",
  "--top-logprobs-k", "0",
  "--host", "127.0.0.1",
  "--port", "8799",
]
keep_alive     = false
run_at_load    = false
working_dir    = "~/.local/share/mlx"
log_path       = "~/.local/state/mlx-gemma/mlx-gemma.log"
error_log_path = "~/.local/state/mlx-gemma/mlx-gemma.log"

[mlx-gemma.env]
# launchd doesn't inherit interactive PATH; ~/.local/bin holds the uv-installed
# mlx_vlm.server shim, which resolves its own venv.
PATH = "~/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
# Automatic Prefix Caching (mlx_vlm/apc.py, built via apc.from_env). Gated by
# APC_ENABLED, which defaults to "0" — without this the static system-prompt
# prefix is re-prefilled on every request. APC is exact (byte-identical KV) and
# composes with the MTP drafter above. APC_DISK_PATH adds the shard-based SSD
# tier that restores KV blocks after a process restart; APC_HASH=sha256 makes
# the block hash process-stable (the default "fast" hash is per-process
# randomized, so disk blocks would never match across restarts). APC creates
# the dir itself; the parent ~/.local/state/mlx-gemma/ is the log dir above.
APC_ENABLED = "1"
APC_HASH = "sha256"
APC_DISK_PATH = "{{ .chezmoi.homeDir }}/.local/state/mlx-gemma/apc"
{{ end }}

# vim:ft=toml.gotmpl
