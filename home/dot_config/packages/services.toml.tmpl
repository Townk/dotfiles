# Servicefile — declarative manifest for launchd-managed user agents.
# Synced by `system-service sync`. Strict cleanup: removing a section
# boots-out the service and deletes its plist on the next sync.
#
# Schema (per `[<name>]` section, all keys optional except `cmd`):
#   cmd            = ["bin", "args..."]      → ProgramArguments
#   keep_alive     = true|false              → KeepAlive
#   run_at_load    = true|false              → RunAtLoad
#   working_dir    = "~/path"                → WorkingDirectory
#   log_path       = "~/path/out.log"        → StandardOutPath
#   error_log_path = "~/path/err.log"        → StandardErrorPath
#   description    = "human-friendly text"   (info / list only — not in plist)
#   start_interval = 1800                    → StartInterval (seconds)
#   start_calendar_interval = {Hour=3, Minute=17} → StartCalendarInterval
#     (also accepts an array of dicts, e.g. [{Minute=0}, {Minute=30}])
#   watch_paths    = ["/Volumes", "~/x"]     → WatchPaths (fire on change)
#   process_type   = "Background"            → ProcessType (macOS QoS class)
#   low_priority_io = true|false             → LowPriorityIO
#   nice           = 10                      → Nice
#
#   [<name>.env]                             → EnvironmentVariables
#   KEY = "value"
#
# Paths support a leading `~` (expanded by the worker at plist-gen time, NOT
# by chezmoi). cmd[0] is resolved via `command -v` so the rendered plist
# carries an absolute path — launchd cannot resolve unqualified names.
#
# Brew-installed services live under `brew services` and stay declared in
# the formula; they are NOT listed here. `system-service list` aggregates
# both sources.

{{ if eq .profile "personal" -}}
# Add personal-only services
{{- end }}

{{ if eq .chezmoi.os "darwin" -}}
# clipboard-bridge — serve the Mac clipboard to remote nvim over an SSH
# reverse tunnel. Closes the one clipboard gap left by Zellij refusing OSC 52
# reads: a remote `"+p` can't pull the Mac clipboard otherwise.
#
# socat listens on loopback TCP 2489 and, on every accepted connection, EXECs
# a fresh clipboard-bridge-dispatch — the Phase 5 per-connection handler that
# speaks a length-prefixed binary framing protocol (get/get-regtype/get-host/
# set/persist/copy/fetch-file; see docs/clipboard-universal-project.md §11). It is
# backward compatible: an old bare-`nc -U` client that connects and sends
# nothing hits the dispatcher's short first-byte timeout and falls through to
# `exec pbpaste`, exactly the pre-Phase-5 behavior, so the *live* clipboard is
# still served (a `pbpaste | nc -l` loop would snapshot at listen time and
# serve stale text). `fork` handles concurrent/repeated pastes; the remote
# reaches it through a user-only unix socket forwarded by SSH (see
# ~/.ssh/config.d/clipboard.config). macOS only: pbpaste is the source of
# truth off-host there's nothing to serve.
[clipboard-bridge]
description    = "Serve the Mac clipboard to remote nvim over an SSH reverse tunnel"
cmd            = ["socat", "TCP-LISTEN:2489,bind=127.0.0.1,fork,reuseaddr", "EXEC:{{ .chezmoi.homeDir }}/.local/libexec/clipboard-bridge-dispatch"]
keep_alive     = true
run_at_load    = true
log_path       = "~/.cache/clipboard-bridge/listener.log"
error_log_path = "~/.cache/clipboard-bridge/listener.log"

[clipboard-bridge.env]
# Unlike the old bare-pbpaste target (an absolute path needing nothing), the
# dispatcher shells out to sqlite3 and hs (rich restore/copy) — neither is on
# launchd's minimal PATH. Mirror the images-automount PATH so /opt/homebrew/bin
# (hs) and /usr/bin (sqlite3, pbpaste, pbcopy) resolve.
PATH = "~/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/sbin:/usr/sbin"

# clipboard-mount-sweep — belt-and-braces reaper for clipboard peer mounts
# (clipboard-mount spec §3.3): every 60s, force-unmount any rclone SFTP mount
# under ~/.local/state/clipboard/mnt that stopped answering (peer asleep,
# network change, rclone death) and remove its mountpoint dir, so a stale
# pasted file-url fails instantly instead of beachballing Finder. Healthy
# mounts are left alone even with no ssh session open — teardown is
# health-driven, not session-driven; the next connect (or the dispatcher's
# self-heal) remounts. The dispatcher's check-failure path also kicks a sweep
# on demand; this agent covers the quiet hours between clips.
[clipboard-mount-sweep]
description     = "Reap unhealthy clipboard peer mounts (rclone/MacFUSE)"
cmd             = ["{{ .chezmoi.homeDir }}/.local/libexec/clipboard-mount", "sweep"]
run_at_load     = true
start_interval  = 60
process_type    = "Background"
log_path        = "~/.cache/clipboard-mount/sweep.log"
error_log_path  = "~/.cache/clipboard-mount/sweep.log"

[clipboard-mount-sweep.env]
# Single leading tilde only — the renderer's detilde expands only a
# string-leading `~`, so a second `~/...` segment would reach launchd
# literally. ~/.local/libexec is where clipboard-mount lives; the rest of the
# PATH exists for mount/umount/diskutil/pgrep in /sbin, /usr/sbin, /usr/bin —
# sweep never execs rclone itself (that's cm::rclone_pids_for's job, driven by
# pgrep/ps), and rclone now lives under mise (aqua shims) anyway.
PATH = "~/.local/libexec:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/sbin:/usr/sbin"

# (The former [clipboard-mirror] service was removed with the self-contained
# clips revision, spec §11: clips are no longer mirrored as text-only pointers;
# a clip materializes in full wherever it is used, over the existing bridge.)

# images-automount — mount declared sparse images at login. Generic, one-shot
# (keep_alive=false): runs `system-images mount --all`, which mounts every
# image with automount=true in the loose ~/.config/packages/images.toml. With
# no images.toml it's a clean no-op, so this entry is harmless on any Mac.
# Replaces the old hand-rolled com.user.mountlocalrepos agent.
[images-automount]
description = "Mount declared sparse images at login"
cmd         = ["system-images", "mount", "--all"]
run_at_load = true
keep_alive  = false
log_path    = "~/.cache/system-images/automount.log"
error_log_path = "~/.cache/system-images/automount.log"

[images-automount.env]
# launchd agents don't inherit an interactive PATH; system-images shells out to
# yq/jq/hdiutil/diskutil. Mirror the dirs the omlx agent bakes in.
PATH = "~/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/sbin:/usr/sbin"

# gpg-agent — pre-warm THIS machine's gpg-agent at login. It is the LOCAL target
# of the SSH gpg-agent RemoteForward to dev shells: the forward's far end is our
# ~/.config/gnupg/S.gpg-agent.extra, so the forward is only as live as this
# agent. macOS has no systemd to keep it alive, so it dies on reboot/logout
# while its stale socket inode survives on the persistent FS; an inbound forward
# then connect()s a dead socket and the remote gpg reports "can't connect to the
# agent: End of file". Launching at login means even the first connect finds a
# live target. ssh-prepare-connection also launches it per-connect (the
# authoritative fix at exactly the moment the forward binds); this is a cheap
# pre-warm layer. One-shot: `gpgconf --launch` starts a dead agent (re-binding a
# stale extra socket) and is a no-op when it is already healthy.
[gpg-agent]
description    = "Pre-warm the local gpg-agent (SSH gpg-forward target)"
cmd            = ["gpgconf", "--launch", "gpg-agent"]
run_at_load    = true
keep_alive     = false
log_path       = "~/.cache/gpg-agent/launch.log"
error_log_path = "~/.cache/gpg-agent/launch.log"

[gpg-agent.env]
# launchd's minimal env carries no GNUPGHOME, so gpgconf would default to
# ~/.gnupg and launch/manage the WRONG homedir. Pin it to the real one.
GNUPGHOME = "{{ .chezmoi.homeDir }}/.config/gnupg"
PATH = "~/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/sbin:/usr/sbin"

# backup-* — the Terminal Time Machine schedule (system-backup silo, spec §6).
# Three agents: a half-hourly capture tick (which chains a reconcile pass), a
# mount-watching + hourly-safety reconcile, and the daily prune repack. All
# run at Background QoS with low-priority IO so they never compete with
# foreground work. On a machine without ~/.config/backup/config.toml the
# workers exit 0 immediately, so declaring these is harmless pre-onboarding.
# watch_paths names the mount ROOTS (not per-target paths — those live in the
# local-only config.toml): any mount/unmount event fires a cheap, coalesced,
# idempotent reconcile that skips absent targets.
# Capture uses StartCalendarInterval (not StartInterval): launchd misses
# StartInterval firings that land during sleep, but coalesces missed calendar
# slots and runs them on wake — so a lid-closed laptop catches up when opened.
# run_at_load covers boot/login. The worker also no-ops when the last capture
# is still inside the 30-min cadence (BKP_CAPTURE_CADENCE), so wake + :00/:30
# near-misses stay cheap.
# Linux: systemd user timers are the spec §10 seam — TODO, darwin-only for v1.
[backup-capture]
description     = "Terminal Time Machine: half-hourly capture tick (+ reconcile; wakes catch up)"
cmd             = ["system-backup-capture", "--reconcile"]
run_at_load     = true
start_calendar_interval = [
  { Minute = 0 },
  { Minute = 30 },
]
process_type    = "Background"
low_priority_io = true
nice            = 10
log_path        = "~/.local/state/terminal-backup/capture.log"
error_log_path  = "~/.local/state/terminal-backup/capture.log"

[backup-capture.env]
# Workers shell out to yq/jq/restic (homebrew), git (system), chezmoi.
PATH = "~/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/sbin:/usr/sbin"

[backup-reconcile]
description     = "Terminal Time Machine: reconcile targets on mount + hourly safety pass"
cmd             = ["system-backup-reconcile"]
# Only /Volumes (removable master/mirror media). NOT ~/Library/CloudStorage — a
# cloud-sync root churns constantly and storms this agent with reconciles; the
# always-present cloud target is covered by the hourly pass + post-capture reconcile.
watch_paths     = ["/Volumes"]
start_interval  = 3600
process_type    = "Background"
low_priority_io = true
nice            = 10
log_path        = "~/.local/state/terminal-backup/reconcile.log"
error_log_path  = "~/.local/state/terminal-backup/reconcile.log"

[backup-reconcile.env]
PATH = "~/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/sbin:/usr/sbin"

[backup-prune]
description     = "Terminal Time Machine: daily repack (restic prune)"
cmd             = ["system-backup-reconcile", "--prune"]
start_calendar_interval = {Hour = 3, Minute = 17}
process_type    = "Background"
low_priority_io = true
log_path        = "~/.local/state/terminal-backup/prune.log"
error_log_path  = "~/.local/state/terminal-backup/prune.log"

[backup-prune.env]
PATH = "~/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/sbin:/usr/sbin"
{{ end }}

{{ if ne .profile "dev-shell" -}}
# mlx-gemma — DIRECT mlx_vlm.server for pi-local's single-model setup.
# pi-local was repointed off the old headroom→gateway→llama-swap chain to talk
# straight to mlx_vlm.server on :8799 (one model, so the hot-swap and
# local-agent-auto routing layers had no job). This entry is the lifecycle
# owner that llama-swap used to be for that path. The old [llama-swap] /
# [local-llm-gateway] / [headroom] sections were removed once nothing was left
# consuming :8787/:8100/:8000 — mlx-gemma on :8799 is now the only
# local-inference service declared here.
#
# ON-DEMAND by design: keep_alive=false + run_at_load=false, so the ~8.4GB
# model (≈15–17GB resident with a full 128K-context KV) is NOT pinned at every
# login. Start it only when coding:  `system-service start mlx-gemma`
# (stop: `system-service stop mlx-gemma`). To make it always-on instead, set
# BOTH keys below to true; note launchd has no native idle-unload, so
# always-on means permanently resident.
#
# cmd[0] is `command -v`-resolved to ~/.local/bin/mlx_vlm.server (uv shim).
# The --model/--draft-model paths MUST be absolute: the worker passes cmd args
# verbatim (no ~ expansion).
[mlx-gemma]
description    = "Local LLM inference: direct mlx_vlm.server (Gemma 4 OptiQ-4bit + MTP drafter) on :8799"
cmd            = [
  "mlx_vlm.server",
  "--model", "{{ .chezmoi.homeDir }}/.local/share/mlx/models/gemma-4-12B-it-qat-OptiQ-4bit",
  "--draft-model", "{{ .chezmoi.homeDir }}/.local/share/mlx/models/gemma-4-12B-it-qat-q4_0-assistant",
  "--draft-kind", "mtp",
  "--draft-block-size", "4",
  "--max-tokens", "2048",
  "--top-logprobs-k", "0",
  "--host", "127.0.0.1",
  "--port", "8799",
]
keep_alive     = false
run_at_load    = false
working_dir    = "~/.local/share/mlx"
log_path       = "~/.local/state/mlx-gemma/mlx-gemma.log"
error_log_path = "~/.local/state/mlx-gemma/mlx-gemma.log"

[mlx-gemma.env]
# launchd doesn't inherit interactive PATH; ~/.local/bin holds the uv-installed
# mlx_vlm.server shim, which resolves its own venv.
PATH = "~/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
# Automatic Prefix Caching (mlx_vlm/apc.py, built via apc.from_env). Gated by
# APC_ENABLED, which defaults to "0" — without this the static system-prompt
# prefix is re-prefilled on every request. APC is exact (byte-identical KV) and
# composes with the MTP drafter above. APC_DISK_PATH adds the shard-based SSD
# tier that restores KV blocks after a process restart; APC_HASH=sha256 makes
# the block hash process-stable (the default "fast" hash is per-process
# randomized, so disk blocks would never match across restarts). APC creates
# the dir itself; the parent ~/.local/state/mlx-gemma/ is the log dir above.
APC_ENABLED = "1"
APC_HASH = "sha256"
APC_DISK_PATH = "{{ .chezmoi.homeDir }}/.local/state/mlx-gemma/apc"
{{ end }}

