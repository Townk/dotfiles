# Servicefile — declarative manifest for launchd-managed user agents.
# Synced by `system-service sync`. Strict cleanup: removing a section
# boots-out the service and deletes its plist on the next sync.
#
# Schema (per `[<name>]` section, all keys optional except `cmd`):
#   cmd            = ["bin", "args..."]      → ProgramArguments
#   keep_alive     = true|false              → KeepAlive
#   run_at_load    = true|false              → RunAtLoad
#   working_dir    = "~/path"                → WorkingDirectory
#   log_path       = "~/path/out.log"        → StandardOutPath
#   error_log_path = "~/path/err.log"        → StandardErrorPath
#   description    = "human-friendly text"   (info / list only — not in plist)
#
#   [<name>.env]                             → EnvironmentVariables
#   KEY = "value"
#
# Paths support a leading `~` (expanded by the worker at plist-gen time, NOT
# by chezmoi). cmd[0] is resolved via `command -v` so the rendered plist
# carries an absolute path — launchd cannot resolve unqualified names.
#
# Brew-installed services live under `brew services` and stay declared in
# the formula; they are NOT listed here. `system-service list` aggregates
# both sources.

{{ if eq .profile "personal" -}}
# Add personal-only services
{{- end }}

{{ if eq .chezmoi.os "darwin" -}}
# clipboard-bridge — serve the Mac clipboard to remote nvim over an SSH
# reverse tunnel. Closes the one clipboard gap left by Zellij refusing OSC 52
# reads: a remote `"+p` can't pull the Mac clipboard otherwise.
#
# socat listens on loopback TCP 2489 and, on every accepted connection, EXECs
# a fresh `pbpaste` — so the *live* clipboard is served (a `pbpaste | nc -l`
# loop snapshots at listen time and serves stale text). `fork` handles
# concurrent/repeated pastes; the remote reaches it through a user-only unix
# socket forwarded by SSH (see ~/.ssh/config.d/clipboard.config) and reads it
# with `nc -U`. macOS only: pbpaste is the source of truth off-host there's
# nothing to serve.
[clipboard-bridge]
description    = "Serve the Mac clipboard to remote nvim over an SSH reverse tunnel"
cmd            = ["socat", "TCP-LISTEN:2489,bind=127.0.0.1,fork,reuseaddr", "EXEC:/usr/bin/pbpaste"]
keep_alive     = true
run_at_load    = true
log_path       = "~/.cache/clipboard-bridge/listener.log"
error_log_path = "~/.cache/clipboard-bridge/listener.log"

# images-automount — mount declared sparse images at login. Generic, one-shot
# (keep_alive=false): runs `system-images mount --all`, which mounts every
# image with automount=true in the loose ~/.config/packages/images.toml. With
# no images.toml it's a clean no-op, so this entry is harmless on any Mac.
# Replaces the old hand-rolled com.user.mountlocalrepos agent.
[images-automount]
description = "Mount declared sparse images at login"
cmd         = ["system-images", "mount", "--all"]
run_at_load = true
keep_alive  = false
log_path    = "~/.cache/system-images/automount.log"
error_log_path = "~/.cache/system-images/automount.log"

[images-automount.env]
# launchd agents don't inherit an interactive PATH; system-images shells out to
# yq/jq/hdiutil/diskutil. Mirror the dirs the omlx agent bakes in.
PATH = "~/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/sbin:/usr/sbin"
{{ end }}

# llama-swap — single OpenAI-compatible endpoint on :8000 that hot-swaps
# between per-model mlx_lm.server / mlx_vlm.server backends. Each model runs
# as its own process so it keeps its own MTP draft config (Qwen native MTP /
# Gemma assistant-drafter MTP); only one is resident at a time. Replaces the
# old single-process omlx server. llama-swap is brew-managed; the backends
# (mlx-lm, mlx-vlm) are uv-managed. The --config arg is rendered to an
# absolute path because the worker passes cmd args verbatim (no ~ expansion).
[llama-swap]
description    = "Local LLM inference: llama-swap → mlx_lm/mlx_vlm (MTP, on-demand swap)"
cmd            = ["llama-swap", "--config", "{{ .chezmoi.homeDir }}/.config/llama-swap/config.yaml", "--listen", "127.0.0.1:8000"]
keep_alive     = true
run_at_load    = true
working_dir    = "~/.local/share/mlx"
log_path       = "~/.local/state/llama-swap/llama-swap.log"
error_log_path = "~/.local/state/llama-swap/llama-swap.log"

[llama-swap.env]
# launchd doesn't inherit interactive shell PATH; bake in the dirs the
# backends shell out into. ~/.local/bin is where uv installs the
# mlx_lm.server / mlx_vlm.server shims that llama-swap launches.
PATH = "~/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"

