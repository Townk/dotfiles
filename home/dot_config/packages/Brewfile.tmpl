brew 'doggo'                        # DNS lookup tool
brew 'duf'                          # Better `du`
brew 'eva'                          # Terminal calculator
brew 'eza'                          # List directory contents (`ls` but better)
brew 'fd'                           # Find entries in the file system (`find` but better)
brew 'fend'                         # Terminal unit conversion
brew 'fzf'                          # Fuzzy Finder for CLI
# `gh` lives in Brewfile.bootstrap (needed by .setup.sh)
brew 'glow'                         # fast terminal markdown viewer
brew 'gpg-tui'                      # Manage GPG keys on terminal
brew 'gping'                        # ping, but with graph
brew 'grex'                         # RegEx generator from targets
brew 'gron'                         # JSON to lists
brew 'gum'                          # Shell script UI library
brew 'hyperfine'                    # Terminal benchmark
brew 'imagemagick'                  # Image conversion utility
brew 'jless'                        # JSON visualizer
brew 'lazygit'                      # Git TUA
brew 'lazysql'                      # DB TUA
brew 'macchina'                     # Environment summary when open a shell
brew 'mole'                         # Clean up tool
brew 'mosh'                         # Intermittent connectivity remote connection (`ssh` but better[-ish])
brew 'neovim'                       # Editor
# omlx (Local AI models, Apple Silicon) is provisioned via Uvfile.
# python@3.11 used to be declared here as omlx's pinned runtime under
# brew; now uv-managed since the venv is owned by `uv tool install`.
brew 'pinentry'                     # Terminal pinentry (curses/tty) — used over SSH by pinentry-auto
brew 'pinentry-mac'                 # GUI passphrase entry; pinentry-touchid's fallback
