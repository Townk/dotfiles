# Media ripping (spec: chezmoi 2026-08-19-rip-push-design.md; server half
# is the fleet's cantina). GUI apps do the human-judgment steps; the
# handbrake FORMULA provides HandBrakeCLI for the automated encode.
#
# WARNING: `makemkv` and `xld` are both Homebrew-deprecated (fail the
# macOS Gatekeeper check) and slated to be DISABLED 2026-09-01 — after
# that, `brew bundle` against this file will hard-fail on these two lines
# with no further explanation. When that happens: download MakeMKV
# directly from https://www.makemkv.com/ and XLD from its official site
# (https://tmkk.undo.jp/xld/index_e.html), then remove/comment the two
# cask lines below so `brew bundle` stops trying them.
# As of this writing, `makemkv`'s cask install is also separately blocked
# by a makemkv.com outage (Cloudflare 525 on the download URL) — unrelated
# to the Gatekeeper deprecation above; retry once the site recovers.
# cask 'makemkv'                    # DVD rip — COMMENTED OUT 2026-08-19: the
                                    # makemkv.com download URL 525s (their
                                    # origin outage), which fails the whole
                                    # `brew bundle` run. Re-enable (or direct-
                                    # download, see WARNING above) once
                                    # https://www.makemkv.com recovers.
cask 'handbrake-app'                # Encoder GUI (manual fallback path)
brew 'handbrake'                    # HandBrakeCLI — the pipeline's encoder
brew 'libdvdcss'                    # CSS decryption — lets HandBrake read
                                    # most DVDs directly (no MakeMKV needed
                                    # except for ARccOS/RipGuard discs and
                                    # Blu-ray). HandBrake.app loads it from
                                    # ~/lib/libdvdcss.2.dylib (symlink to
                                    # the brew lib; set up 2026-08-19)
cask 'xld'                          # CD -> FLAC with MusicBrainz tagging
brew 'flac'                         # metaflac — the enrichment stage's tag/art embedder
cask 'musicbrainz-picard'           # Tag editor for after-the-fact fixes over
                                    # the cantina SMB share (fingerprint lookup
                                    # for loose files — the one thing XLD can't
                                    # do; see fleet runbooks/rip-media.md)

# Audiobooks — NOT disc ripping (server half is cantina's `audiobooks`
# service; fleet spec docs/superpowers/specs/2026-08-21-audiobookshelf-design.md).
# Libation downloads and decrypts the Audible library to M4B with chapters
# intact, laid out Author/Title/ for Audiobookshelf's scanner. Unlike the
# makemkv/xld casks above, this one is healthy — no Gatekeeper deprecation.
# It also ships LibationCli (headless), the seam an automated push would use.
cask 'libation'                     # Audible -> M4B, chapters preserved

# Ebooks — bindery (~/Projects/apps/calibre/bindery) makes the KEPUB it pushes
# to cantina's `books` (CWA) so the Kobo gets the normalized book on its first
# sync instead of CWA's stale conversion. Go binary, bottled, no runtime deps
# (no Python, no Go at runtime), which is why it lives here and not in mise.
brew 'kepubify'                     # EPUB -> KEPUB for Kobo eReaders
{{- end }}

cask '1password'                    # Password manager
