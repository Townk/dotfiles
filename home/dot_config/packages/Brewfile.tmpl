# https://github.com/Homebrew/homebrew-bundle

tap "1password/tap"
tap "jorgelbg/tap"
tap "olets/tap"
tap "rafaelgarrido/caveats"

{{ if eq .profile "work" -}}
tap "atlassian/homebrew-acli"
{{- end }}

# specify a directory to install
cask_args appdir: '/Applications'

# # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # #
# MacOS AppStore Applications
# ---------------------------
# These entries are entries for apps that I download from the Mac AppStore.
#
# `mas` installs require the user to be signed into the App Store on the
# target machine. Work Macs typically aren't signed into a personal
# Apple ID, so the whole block is gated on the personal profile. Move
# specific lines OUT of the if/end block if you need them on work too.
{{ if eq .profile "personal" -}}

# XCode
mas "Xcode", id: 497799835

# Apple Office Suite
mas "Keynote: Design Presentations", id: 361285480
mas "Pages: Create Documents", id: 361309726
mas "Numbers: Make Spreadsheets", id: 361304891

# This is, by far, the best dictionary app I ever used.
mas "LookUp Dictionary: Learn Daily", id: 872564448

# SVG Viewer
mas "Gapplin", id: 768053424

# One of the best multi-purpose ci
mas "PCalc", id: 403504866

# This app is one of those tools that I though that, as a programmer, I
# would rarely would have use for, but by far, is the most used app in my
# collection. Yep, who would know I needed a color grabber?
mas "ColorSlurp", id: 1287239339

# This is an app to scan and present your hard drive in a way to show you
# what is occupying space on it. It also allows you to remove unwanted
# items. I don't even remember when I met this app, and I certainly have
# other methods and apps to do the same thing, but DaisyDisk has one of the
# coolest UIs I know.
mas "DaisyDisk", id: 411643860

# Helper app to integrate Shortcuts into Obsidian
mas "Actions For Obsidian", id: 1659667937

# I need to install the Safari extension for 1Password from the AppStore,
# so... let's do it here!
mas "1Password for Safari", id: 1569813296

# For the love of god Apple, make Ctrl+Tab on Safari to switch to the last
# "VISITED" tab.
mas "TabBack for Safari", id: 1660506599
{{- end }}

# # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # #
# MacOS Cask Applications
