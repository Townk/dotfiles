# MacOS AppStore Applications
# ---------------------------
# These entries are entries for apps that I download from the Mac AppStore.
#
# `mas` installs require the target machine to be signed into an App Store
# Apple ID that owns the app. The first block is for apps I want on every
# Mac I sit at, work included; the second is personal-only. Move a line
# between the two blocks to change where it lands.
#
# Deleting a line here does NOT uninstall the app: `system-package brew sync`
# never removes App Store apps (see brew_cleanup_packages for why). Undeclaring
# is a no-op — uninstall by hand.
{{ if or (eq .profile "personal") (eq .profile "work") -}}

# This is, by far, the best dictionary app I ever used.
mas "LookUp Dictionary: Learn Daily", id: 872564448

# SVG Viewer
mas "Gapplin", id: 768053424

# One of the best multi-purpose ci
mas "PCalc", id: 403504866

# This app is one of those tools that I though that, as a programmer, I
# would rarely would have use for, but by far, is the most used app in my
# collection. Yep, who would know I needed a color grabber?
mas "ColorSlurp", id: 1287239339

# Dims every window but the focused one.
mas "HazeOver", id: 430798174
{{- end }}

{{ if eq .profile "personal" -}}

# XCode
