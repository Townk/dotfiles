brew 'rmlint'                       # Search files to remove
brew 't-rec'                        # Terminal recorder
brew 'tealdeer'                     # A conciser and more pragmatic `man` (command: tldr)
brew 'terminal-notifier'            # Send notifications from the terminal
brew 'tokei'                        # Source code metrics
