{{ if eq .profile "personal" -}}
cask 'android-studio'               # Android IDE
cask 'pycharm'                      # Python IDE
cask 'clion'                        # C++ IDE
{{- end }}

cask 'visual-studio-code'           # Everything Editor/IDE
