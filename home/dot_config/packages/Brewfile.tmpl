# # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # # #
# Homebrew packages
# -----------------
# This section are for standart Homebrew "packages" (a.k.a. Formulas).

{{ if eq .profile "personal" -}}
# MacOS Essentials
# ----------------
brew 'mas'                          # MacOS Apple Store CLI
{{- end }}

# GNU tools (a.k.a. basic terminal surviving kit)
# -----------------------------------------------
brew 'aspell'                       # Spell checking
brew 'binutils'                     # GNU binary file utilities (usually use with compiled code)
brew 'coreutils'                    # Standard POSIX utilities
brew 'findutils'                    # GNU find utilities (find, locate, and xargs)
brew 'fmt'                          # Format text in the terminal
brew 'gawk'                         # GNU AWK programming language
brew 'gnu-getopt'                   # Process args in shell scripts
brew 'gnu-sed'                      # Line-oriented text processing utility
brew 'gnu-tar'                      # Archiving tool
brew 'gnupg'                        # Opensource encryption/decryption tool
brew 'grep'                         # Print lines that match patterns
brew 'gzip'                         # Compression tool
brew 'less'                         # Paginate the output of commands (`more` but better)
brew 'make'                         # Help you to make stuff
brew 'wget2'                        # Download utility (like `curl`)

# Other Unix tools (terminal surviving kit continued)
# ---------------------------------------------------
brew 'curl'                         # Tool to transfer data from or to a server
brew 'figlet'                       # Print large texts on the terminal
brew 'file'                         # Identify file types
brew 'gptfdisk'                     # Disk partition tool (fdisk on mac)
brew 'hunspell'                     # Spell checking
brew 'ispell'                       # Spell checking
brew 'lolcat'                       # Apply the rainbow to any terminal output
brew 'openssl'                      # Remote connections using the SSH protocol
brew 'rsync'                        # Keep to directories (remote or local) synchronized
brew 'typst'                        # Modern LaTeX
brew 'zsh'                          # My preferred shell
brew 'zsh-completions'              # Command line completion collection for ZSH
brew 'zsh-abbr'                     # Commnad abbreviations for ZSH

# Development
# -----------
# `mise` lives in Brewfile.bootstrap (needed by run_once before system-update)
brew 'lua-language-server'          # Lua development
brew 'git'

# Dependency utilities (tools required by other tools)
# ----------------------------------------------------
brew '1broseidon/tap/cymbal'        # Code AST navigation for agents (for: pi.dev)
brew 'autoconf'                     # Regenerate ./configure from a git clone (for: zsh custom-build)
brew 'cairo'                        # Open source rendering engine (for: SKIM)
brew 'chafa'                        # Terminal image viewer (for: yazi)
brew 'editorconfig'                 # Support for EditoConfig (for: nvim, JetBrains IDEs)
brew 'exiftool'                     # Media file information (for: yazi)
brew 'expect'                       # Tool to manipulate and automate terminal applications (for: preview)
brew 'ffmpeg'                       # Audio and video manipulation utility (for: yazi)
brew 'ffmpegthumbnailer'            # Generate thumbnails for videos (for: yazi)
brew 'git-cliff'                    # Changelog generator (for: git)
brew 'git-delta'                    # A viewer for git and diff output (`diff` but better) (for: git)
brew 'git-extras'                   # Tons of extra commands for Git (for: git)
brew 'git-lfs'                      # Helper to allow one to commit large files on Git (for: git)
brew 'git-sizer'                    # Show metrics of your repository (for: git)
brew 'graphviz'                     # Support for DOT language (draw graphs) (for: plantuml)
brew 'hexyl'                        # Binary files viewer (for: yazi)
# luajit stays under brew (not mise) because mise-plugins/mise-luaJIT fails
# to build on macOS 26.x — its bundled luarocks 3.13.0 ships a rockspec
# the lua parser rejects. NeoVim links against this. Allowlisted in
# system-package-brew so the mise-leakage tripwire stays silent.
brew 'luajit'                       # Lua JIT runtime (for: nvim)
brew 'm1ddc'                        # Utility used by HammerSpoon to detect external display brightnes (for: hammerspoon)
brew 'media-info'                   # Media files information (for: yazi)
brew 'onefetch'                     # Git repo terminal statistics like GitHub (for: git)
brew 'ouch'                         # Univeral compressor wrapper (for: yazi)
brew 'pandoc'                       # Convert files from one format to another (for: emacs, nvim)
brew 'pcre2'                        # PCRE2 regex library for the zsh/pcre module (for: zsh custom-build)
brew 'pngpaste'                     # Support to drop image files into Emacs buffers (for: nvim)
brew 'poppler'                      # PDF previewer (for: yazi)
brew 'resvg'                        # SVG renderer (for: yazi)
brew 'rtk'                          # Shell proxy for AI (for: pi.dev)
brew 'socat'                        # Socket relay; EXECs pbpaste per connection (for: clipboard-bridge)
brew 'tag'                          # MacOS tag on Yazi (for: yazi)
brew 'tectonic'                     # LaTeX in Rust (for: nvim)
brew 'tree-sitter'                  # Tree Sitter CLI (for: emacs, nvim)
brew 'tree-sitter-cli'              # Tree Sitter CLI (for: emacs, nvim)

# Miscellaneous CLI tools
# -----------------------
brew 'age'                          # Modern file encryption (for: system-onboard/system-secrets)
brew 'sops'                         # Encrypts secrets to age recipients (for: system-onboard/system-secrets)
brew '7zip'                         # Compressor of 7z files
brew 'ast-grep'                     # Grep that knows source code AST
brew 'atuin'                        # Improved shell history
brew 'bandwhich'                    # Network traffic analyser (must run as sudo on macOS)
brew 'bat'                          # A better cat
brew 'bats-core'                    # Bash Automated Testing System (for: system-package tests)
brew 'bottom'                       # Graphical process/system (`top` monitor but better: `/bin/btm`)
