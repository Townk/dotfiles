cask 'ghostty'                      # Terminal emulator

{{ if eq .profile "personal" -}}
# Podcast
cask 'audio-hijack'                 # Recording
cask 'farrago'                      # Sound FX
cask 'fission'                      # Editing
cask 'loopback'                     # Virtual mixer
