{{- /*

  Non-unicode9 zsh — build hook (Macs only: profiles work + personal).

  Builds a zsh WITHOUT --enable-unicode9 so the line editor uses macOS's
  (current) wcwidth() for emoji widths instead of zsh's frozen Unicode 9.0
  tables. Without it, post-2016 emoji (🧮 U+1F9EE, 🫀 U+1FAC0, 🫠 U+1FAE0, …)
  render as the ZLE placeholder escape `<0001fac0>` at the prompt. See
  custom-builds/zsh/build-zsh.sh for the full rationale and build recipe.

  run_onchange_after_*: chezmoi re-runs this whenever the rendered output
  changes. We bake the SHA256 of build-zsh.sh into the script below, so editing
  the builder re-fires it. The builder is otherwise idempotent — a no-op fast
  path when the installed binary already matches the clone's commit — so
  routine applies don't rebuild, and upstream updates are pulled on demand
  (ZSH_UPDATE=1 bash build-zsh.sh).

  The builder also makes this zsh the login shell (z4h keeps a healthy 5.x
  starting shell and re-execs that same binary rather than searching PATH).
  Registering it (/etc/shells + chsh) prompts for a password, so it only runs
  with a tty — i.e. an interactive `chezmoi apply` during bootstrap; otherwise
  it prints the one-liner. See custom-builds/zsh/README.md.

  Scope: macOS with the work or personal profile (the unicode9 problem is
  macOS-specific and the recipe is macOS-tuned). Exits cleanly elsewhere.
*/ -}}
{{- $target := and (eq .chezmoi.os "darwin") (or (eq .profile "work") (eq .profile "personal")) -}}
{{- $buildSHA := "" -}}
{{- if $target -}}
  {{- $buildSHA = output "shasum" "-a" "256" (joinPath .chezmoi.workingTree "custom-builds/zsh/build-zsh.sh") | trim -}}
{{- end -}}
#!/bin/bash
# Non-unicode9 zsh — build hook.
#
# Re-runs whenever the builder changes:
#   build-zsh.sh sha256 : {{ if $buildSHA }}{{ $buildSHA }}{{ else }}(out of scope){{ end }}
#
# To pull upstream + rebuild:
#   ZSH_UPDATE=1 bash ~/.local/share/chezmoi/custom-builds/zsh/build-zsh.sh
# To force a clean rebuild:
#   rm -rf ~/.local/opt/zsh && chezmoi apply

set -eu

{{- if not $target }}
# Only built on macOS work/personal profiles; nothing to do here.
exit 0
{{- end }}

BUILD="{{ .chezmoi.workingTree }}/custom-builds/zsh/build-zsh.sh"

if [ ! -f "$BUILD" ]; then
  echo "[zsh-build] builder missing at $BUILD — skipping." >&2
  exit 0
fi

exec bash "$BUILD"

# vim:ft=sh
