# --- shared Pi settings merge (.chezmoitemplates/pi-settings-merge.tmpl) ---
# The caller (a modify_settings.json.tmpl) must already have set $desired to the
# rendered target settings JSON and confirmed jq is on PATH.
#
# Policy:
#   FORCE  - the keys in $forced are always taken from $desired (declaratively
#            owned: structural config we choose deliberately).
#   SEED   - any key in $desired that is absent on disk is written once.
#   KEEP   - everything else (Pi-owned runtime toggles: model, theme, thinking,
#            lastChangelogVersion, ...) keeps whatever Pi last wrote.
#
# If the merged result is semantically identical to the on-disk file we emit the
# ORIGINAL BYTES verbatim, so chezmoi reports no diff regardless of how jq vs
# Pi's serializer format the JSON. We only re-serialize when a forced key has
# actually drifted (or on first creation).
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
cat > "$tmp"
[ -s "$tmp" ] || printf '{}' > "$tmp"
merged="$(jq \
  --argjson desired "$desired" \
  --argjson forced '["extensions","skills","packages","npmCommand","observational-memory"]' '
  . as $cur
  | reduce ($desired | keys_unsorted[]) as $k ($cur;
      if   ($forced | index($k))  then .[$k] = $desired[$k]
      elif ($cur | has($k) | not) then .[$k] = $desired[$k]
      else . end)
' "$tmp")"
if jq -e --argjson m "$merged" '. == $m' "$tmp" >/dev/null 2>&1; then
  cat "$tmp"
else
  printf '%s\n' "$merged"
fi
