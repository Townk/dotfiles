# Personal SSH configuration.
#
# Pulled in by ~/.ssh/config via `Include ~/.ssh/config.d/*`. It lives here
# (not in ~/.ssh/config) so the work-tooling-managed ~/.ssh/config can stay
# local-only and work tooling never collides with chezmoi. See
# ~/.ssh/config.example for the rationale.
#
# IgnoreUnknown must precede the macOS-only UseKeychain below so non-macOS
# hosts (e.g. the Linux dev-shell) don't error on the unknown keyword.

GSSAPIAuthentication yes
IgnoreUnknown UseKeychain,AddKeysToAgent

Host *
  User thiago
  IdentityFile ~/.ssh/id_ed25519
  # Offer ONLY that key. The agent (1Password) serves every key in a vault;
  # without this ssh tries each of them first, an unrelated one gets refused
  # ("agent refused operation") on every connection, and a pending approval
  # dialog can stall a non-interactive run. Signing still goes through the agent.
  IdentitiesOnly yes
  UserKnownHostsFile ~/.ssh/known_hosts
  ForwardAgent yes
  Compression yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
  HashKnownHosts yes
  ControlMaster auto
  ControlPersist 1800
  AddKeysToAgent yes
  UseKeychain yes
