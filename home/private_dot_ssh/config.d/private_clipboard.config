# Clipboard bridge — reverse-forward the Mac clipboard listener into remote
# hosts so nvim there can paste it into a register (`"+p`). Pulled in by
# ~/.ssh/config via `Include ~/.ssh/config.d/*`, like personal.config.
#
# The remote endpoint is a *unix socket* (created by sshd, owned by the login
# user, 0600) rather than a TCP port, so nothing else on a shared remote host
# can read the clipboard. It forwards to the Mac's loopback listener on TCP 2489
# (the clipboard-bridge launchd service: socat EXEC'ing pbpaste per connection).
# nvim reads it with `nc -U "$HOME/.local/state/runtime/chezmoi-system/clipboard-bridge.sock"`
# — the socket path is $HOME-relative on purpose so the same nvim code works on
# both hosts. It lives under `.local/state/runtime/` rather than directly in
# $HOME so it doesn't clutter the home directory with a loose dotfile; chezmoi
# creates that directory (see home/dot_local/state/runtime/private_chezmoi-system).
#
# `%r` expands to the *effective* remote login user (man ssh_config: RemoteForward
# accepts %-tokens in the socket path), so we don't hardcode the account — handy
# when a remote Host block overrides User. Only the home *prefix* differs by OS,
# so it's per host. nvim reads "$HOME/.local/state/runtime/chezmoi-system/clipboard-bridge.sock",
# which matches either path.
#
# StreamLocalBindUnlink clears a stale socket left by an unclean master exit;
# without it the forward fails with "remote port forwarding failed" on the
# next connect. RemoteForward is additive, so these blocks layer cleanly on
# top of any other Host definition for the same alias.
#
# Host-specific blocks for non-public/work remotes are intentionally NOT kept
# here. They live in a loose, unmanaged ~/.ssh/config.d/ file that chezmoi
# never tracks, per the local-only SSH policy documented in config.example.

Host thiago-mac-mini.local
  RemoteForward /Users/%r/.local/state/runtime/chezmoi-system/clipboard-bridge.sock 127.0.0.1:2489
  # Forward mirror (Phase 5, spec §11): bind a LOCAL socket on this laptop that
  # forwards to the remote's clipboard-mirror listener. The Hammerspoon capture
  # watcher writes each local clip's text+metadata to the local socket; it lands
  # on the remote as a `laptop-ref` history row (no blobs). The remote target is
  # the socket the remote's [clipboard-mirror] launchd service already listens
  # on (LocalForward connects to it, unlike RemoteForward which creates its
  # endpoint). %r = the effective remote login user; assumes the same account on
  # both ends, as the RemoteForward above already does.
  #
  # `LocalForward <local-socket> <remote-socket>`, NOT `StreamLocalForward`:
  # macOS's OpenSSH (LibreSSL build) rejects the StreamLocalForward keyword
  # outright ("Bad configuration option") though it accepts LocalForward's
  # unix-socket form, which has identical semantics. Confirmed on OpenSSH_10.2p1.
  LocalForward /Users/%r/.local/state/runtime/chezmoi-system/clipboard-mirror-out.sock /Users/%r/.local/state/runtime/chezmoi-system/clipboard-mirror.sock
  StreamLocalBindUnlink yes
