GSSAPIAuthentication yes
IgnoreUnknown UseKeychain,AddKeysToAgent
Match all

Host *
  User thiago
  IdentityFile ~/.ssh/id_ecdsa
  UserKnownHostsFile ~/.ssh/known_hosts
  ForwardAgent yes
  Compression yes
  ServerAliveInterval 60
  ServerAliveCountMax 3
  HashKnownHosts yes
  ControlMaster auto
  ControlPersist 1800
  UseKeychain yes

Include ~/.ssh/config.d/*
