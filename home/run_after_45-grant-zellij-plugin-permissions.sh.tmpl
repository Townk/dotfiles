{{/*
  Build the permission-cache keys for the exact set of plugins we manage,
  using the SAME resolution policy as config.kdl.tmpl: a Townk plugin
  resolves to its local build when the repo is checked out under
  ~/Projects/apps/zellij/<name>, otherwise to its pinned GitHub release.
  vim-zellij-navigator is third-party — no local checkout concept — so it is
  always the pinned release. Zellij keys the cache by the *resolved* path:
  the bare absolute path for `file:` plugins (it strips the prefix) and the
  full URL otherwise, so we emit exactly that.

  KEEP THE TOWNK VERSIONS AND THE VIM-NAVIGATOR URL IN SYNC WITH
  config.kdl.tmpl. A key that doesn't match what config.kdl resolves to
  re-introduces the interactive prompt we're trying to avoid.
*/ -}}
{{- $townk := list
    (dict "name" "zj-context-keys"  "version" "v0.1.1")
    (dict "name" "zj-prompt-jumper" "version" "v0.1.1")
    (dict "name" "zj-hud"           "version" "v0.1.0")
-}}
{{- $locs := list -}}
{{- range $townk -}}
{{- $localRepo := joinPath $.chezmoi.homeDir "Projects/apps/zellij" .name -}}
{{- if stat $localRepo -}}
{{- $locs = append $locs (joinPath $localRepo "target/wasm32-wasip1/release" (printf "%s.wasm" .name)) -}}
{{- else -}}
{{- $locs = append $locs (printf "https://github.com/Townk/%s/releases/download/%s/%s.wasm" .name .version .name) -}}
{{- end -}}
{{- end -}}
{{- $locs = append $locs "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" -}}
#!/bin/bash
# Pre-grant Zellij plugin permissions.
#
# The plugins we load headlessly via `load_plugins` (zj-context-keys,
# zj-prompt-jumper, vim-navigator) and the zj-hud bar / which-key / search
# instances the layout spawns can never be granted permissions
# interactively: Zellij's permission dialog only works for a plugin that
# owns a visible pane (upstream #4982), and over SSH / in nested sessions
# even that is unreliable. Without a grant the plugin silently fails — e.g.
# Ctrl+hjkl pane navigation dies on remote sessions. The supported
# workaround is to pre-populate the permission cache, which the loader
# checks before prompting.
#
# Runs on every machine, on every `chezmoi apply` (deliberately NOT
# run_onchange): a plugin's resolved location flips between `file:` (local
# checkout) and the GitHub release URL purely on whether its repo is checked
# out — a change that touches no template, so an onchange hash would go stale
# and leave the cache keyed on the wrong path. Re-asserting every apply keeps
# the grants matched to whatever the plugins resolve to right now.
#
# The plugin set is a curated allowlist (the three plugins under
# ~/Projects/apps/zellij plus the vim-navigator we depend on). The keys are
# resolved at template time to mirror config.kdl exactly. Add a plugin here
# when you add one to config.kdl's load set; nothing else is granted, so a
# stale cache entry for a removed plugin is dropped on the next apply.
set -uo pipefail

# Zellij keys its permission cache under an OS-specific cache dir (the
# `directories` crate: Library/Caches/<bundle> on macOS, ~/.cache/<app>
# elsewhere). macOS ignores XDG_CACHE_HOME, so don't honour it there.
case "$(uname -s)" in
  Darwin) cache_dir="$HOME/Library/Caches/org.Zellij-Contributors.Zellij" ;;
  *)      cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zellij" ;;
esac
perms="$cache_dir/permissions.kdl"
mkdir -p "$cache_dir"

# Self-heal poisoned plugin downloads. Zellij fetches an http(s) plugin into
# its cache keyed by a hash of the URL (cache_dir/<hash>, via a <hash>.part
# temp), and NEVER validates or retries it: if GitHub answers a transient
# error during that one fetch (a 404 "Not Found" body, or the "Unicorn!"
# 5xx HTML page), the error body is cached as the wasm and every later load
# fails with "bad magic number" — e.g. the zj-hud bar renders empty forever.
# A valid wasm is sticky (reused, never re-fetched), so all we must do is
# evict the bad entries; the next session re-downloads them clean.
#
# Delete leftover .part temps and any hash-named blob that doesn't start with
# the wasm magic `\0asm` (00 61 73 6d). Only the URL-hash download blobs have
# all-digit names, so permissions.kdl, session_info, and the rest are safe.
shopt -s nullglob
for f in "$cache_dir"/*; do
  [ -f "$f" ] || continue
  base=${f##*/}
  case "$base" in
    *.part) rm -f "$f"; continue ;;
  esac
  if [[ "$base" =~ ^[0-9]+$ ]]; then
    [ "$(head -c4 "$f" | od -An -tx1 | tr -d ' \n')" = "0061736d" ] || rm -f "$f"
  fi
done

# Grant the full permission set (all 17 PermissionType variants) so a future
# plugin version that requests an extra permission doesn't reintroduce the
# un-acceptable prompt. Overwrites the cache: only the allowlist above is
# trusted, and a removed plugin's stale grant should not linger.
cat > "$perms" <<'KDL'
{{ range $locs -}}
"{{ . }}" {
    ReadApplicationState
    ChangeApplicationState
    OpenFiles
    RunCommands
    OpenTerminalsOrPlugins
    WriteToStdin
    WebAccess
    ReadCliPipes
    MessageAndLaunchOtherPlugins
    Reconfigure
    FullHdAccess
    StartWebServer
    InterceptInput
    ReadPaneContents
    RunActionsAsUser
    WriteToClipboard
    ReadSessionEnvironmentVariables
}
{{ end -}}
KDL

echo "zellij: pre-granted permissions for {{ len $locs }} plugin(s) -> $perms"
