{{- /*

  Symbols Nerd Font — change detection hook.

  Strategy:
    - run_onchange_after_*: chezmoi hashes this template's rendered
      output and re-runs the script whenever the hash changes.
    - We bake three fingerprints into the rendered script as comments:
        1. The installed version of the Homebrew cask `font-fontawesome`.
           When `brew upgrade` bumps that cask, the next `chezmoi apply`
           sees a different hash and re-fires the build prompt.
        2. The SHA256 of build-updated-font.sh itself. Editing the
           builder also triggers a rebuild on next apply.
        3. A digest of the custom-icons/ directory (every *.svg plus
           metadata.json). Adding, removing, or editing a custom icon —
           or just retagging it in metadata.json — re-fires the prompt
           too, so the baked-in font + glyphs.json stay in sync.

  This script's only job is DETECTION: when a trigger fires it writes a
  marker file and exits 0.  The companion run_after_symbols-nerd-font-
  prompt.sh.tmpl (which runs on EVERY chezmoi apply) reads the marker
  and shows the interactive build prompt when a TTY is available.

  Separating detection from prompting means:
    * A non-interactive apply (CI, editor hook, cron) writes the marker
      and commits the hash — it doesn't loop.
    * The very next interactive `chezmoi apply` sees the marker, shows
      the prompt, and clears the marker on accept or decline.
    * No `chezmoi apply` ever exits non-zero due to this hook.

  On Linux (no brew), we render an empty version string and the
  whole script short-circuits to `exit 0` early anyway.
*/ -}}
{{- $faVersion := "" -}}
{{- $customIcons := "" -}}
{{- $builderSHA := "" -}}
{{- if eq .chezmoi.os "darwin" -}}
  {{- $faVersion = output "sh" "-c" "brew list --versions --cask font-fontawesome 2>/dev/null || true" | trim -}}
  {{- $customIcons = output "sh" "-c" (printf "find %q -type f \\( -name '*.svg' -o -name '*.json' \\) 2>/dev/null | LC_ALL=C sort | while read -r f; do shasum -a 256 \"$f\"; done | shasum -a 256 | cut -c1-16" (joinPath .chezmoi.workingTree "custom-builds/nerd-fonts/custom-icons")) | trim -}}
  {{- $builderSHA = output "shasum" "-a" "256" (joinPath .chezmoi.workingTree "custom-builds/nerd-fonts/build-updated-font.sh") | trim -}}
{{- end -}}
#!/bin/bash
# Symbols Nerd Font (custom build) — change-detection hook.
#
# Re-runs automatically when any of the fingerprints below changes:
#   font-fontawesome cask : {{ if $faVersion }}{{ $faVersion }}{{ else }}(not installed / not macOS){{ end }}
#   builder script SHA256 : {{ if $builderSHA }}{{ $builderSHA }}{{ else }}(not macOS){{ end }}
#   custom-icons digest   : {{ if $customIcons }}{{ $customIcons }}{{ else }}(none / not macOS){{ end }}
#
# When a change is detected this script writes a marker file so that the
# companion run_after_symbols-nerd-font-prompt.sh can show the build
# prompt on the next interactive `chezmoi apply`, regardless of whether
# this detection script was run interactively or not.
#
# To force a rebuild without changing anything else:
#   touch ~/.local/state/chezmoi/nerd-font-build-pending
#   chezmoi apply   # (interactively)
# or invoke the builder directly:
#   ~/.local/share/chezmoi/custom-builds/nerd-fonts/build-updated-font.sh --install

set -eu

{{- if ne .chezmoi.os "darwin" }}
# Builder relies on Homebrew + the `font-fontawesome` cask. macOS-only
# for now. Exit cleanly so chezmoi apply succeeds on Linux/WSL.
exit 0
{{- end }}

SCRIPT="{{ .chezmoi.workingTree }}/custom-builds/nerd-fonts/build-updated-font.sh"
MARKER="${HOME}/.local/state/chezmoi/nerd-font-build-pending"

if [ ! -x "$SCRIPT" ]; then
  echo "[symbols-nerd-font] builder missing at $SCRIPT — skipping." >&2
  exit 0
fi

# Write the marker. The companion prompt script reads this on every apply
# and shows the interactive prompt when a TTY is available.
mkdir -p "$(dirname "$MARKER")"
printf '%s\n' "{{ if $faVersion }}{{ $faVersion }}{{ else }}(unknown){{ end }}" > "$MARKER"
echo "[symbols-nerd-font] change detected; build pending (marker written)."

# vim:ft=sh
