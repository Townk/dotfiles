#!/bin/sh
# chezmoi modify_ script — ~/.pi/agent-local/settings.json (local 32K home).
# Pi rewrites settings.json at runtime (model/theme/thinking toggles, changelog
# bumps, pi config). We declaratively OWN only the structural keys; Pi owns the
# rest. Merge policy lives in .chezmoitemplates/pi-settings-merge.tmpl.
set -eu
_path_prefix=
for _path_dir in \
  "$HOME/.local/bin" \
  "$HOME/.local/share/mise/shims" \
  /opt/homebrew/bin \
  /usr/local/bin \
  /usr/bin \
  /bin
do
  [ -d "$_path_dir" ] || continue
  _path_prefix="${_path_prefix:+$_path_prefix:}$_path_dir"
done
PATH="${_path_prefix}${PATH:+:$PATH}"
export PATH
unset _path_dir _path_prefix
command -v jq >/dev/null 2>&1 || { cat; exit 0; }
desired=$(cat <<'__PI_DESIRED__'
{
  "defaultThinkingLevel": "low",
  "theme": "catppuccin-mocha",
  "editorPaddingX": 1,
  "collapseChangelog": true,
  "npmCommand": [
    "mise",
    "exec",
    "node@latest",
    "--",
    "npm"
  ],
  "extensions": [
    "~/.pi/agent/extensions/pi-cockpit/src/index.ts",
    "~/.pi/agent/extensions/pi-plannotator-bridge/src/index.ts"
  ],
  "skills": [
    "~/.pi/agent/skills",
    "~/Projects/AI/Skills"
  ],
  "lastChangelogVersion": "0.79.5",
  "packages": [
    "npm:pi-web-access",
    "npm:pi-cymbal",
    "npm:pi-lsp",
{{- if ne .profile "dev-shell" }}
    "npm:glimpseui",
{{- end }}
    "npm:@tintinweb/pi-subagents",
    "npm:@mario-gc/pi-context7",
    "npm:@plannotator/pi-extension",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-memctx",
    "npm:pi-observational-memory",
{{- if eq .profile "work" }}
    "npm:@offbynan/pi-cursor-provider",
{{- end }}
    "npm:pi-rtk-optimizer",
    "npm:pi-tool-display"
  ],
  "defaultProvider": "mlx",
  "defaultModel": "gemma-4-12B-it-qat-OptiQ-4bit",
  "hideThinkingBlock": false,
  "quietStartup": true,
  "terminal": {
    "showTerminalProgress": true
  },
  "observational-memory": {
    "passive": true,
    "compactAfterTokens": 50000
  }
}
__PI_DESIRED__
)
{{ includeTemplate "pi-settings-merge.tmpl" . }}
