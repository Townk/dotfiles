#!/usr/bin/env zsh
# tmux-status-widgets — the status bar's right-side widget string (mux
# migration Phase 4, D6). Ports the zj-hud layout's `status {}` widgets:
# power (AC), battery, wifi, host (ssh), clock. ONE #() invocation per
# status-interval emits everything, so the visibility logic and the forks
# live in one place.
#
#   tmux-status-widgets <session-name>
#
# The session name arrives format-expanded from status.conf; the ssh truth
# comes from THAT session's env (update-environment refreshes it per
# attaching client — the server's own env is frozen at birth; ledger row).
#
# Visibility (the layout's rules): local → power|battery + wifi + clock;
# ssh → host only, PLUS the local set while the outer terminal is
# fullscreen (`!ssh|fullscreen` — mirror file written by wezterm.lua).
#
# No colors here: the zj-hud widgets are uncolored too (they inherit the
# bar fg), which keeps the theme substitution contract untouched.
#
# Test seams: MUX_TMUX_BIN, PMSET_BIN, NETWORKSETUP_BIN,
# WIDGETS_FULLSCREEN_STATE, WIDGETS_HOSTNAME_ALIAS.

emulate -L zsh
setopt no_unset

TMUX_BIN="${MUX_TMUX_BIN:-tmux}"
PMSET="${PMSET_BIN:-/usr/bin/pmset}"
NETWORKSETUP="${NETWORKSETUP_BIN:-/usr/sbin/networksetup}"
FS_STATE="${WIDGETS_FULLSCREEN_STATE:-$HOME/.local/state/wezterm/fullscreen_state}"
HOST_ALIAS="${WIDGETS_HOSTNAME_ALIAS:-$HOME/.hostname-alias}"

sess="${1:-}"

is_ssh=0
if [[ -n "$sess" ]]; then
  v="$("$TMUX_BIN" show-environment -t "$sess" SSH_CONNECTION 2>/dev/null)" || v=""
  [[ "$v" == SSH_CONNECTION=* ]] && is_ssh=1
fi

is_fullscreen=0
[[ "$(cat "$FS_STATE" 2>/dev/null)" == true ]] && is_fullscreen=1

typeset -a out

if (( ! is_ssh || is_fullscreen )); then
  # power / battery — mutually exclusive on pmset's AC vs Battery line
  # (same trick as the layout: the "other" widget outputs nothing).
  batt="$("$PMSET" -g batt 2>/dev/null)" || batt=""
  pct="$(grep -Eo '[0-9]+%' <<<"$batt" | head -1)" ; pct="${pct%\%}"
  if [[ "$batt" == *"AC Power"* && -n "$pct" ]]; then
    if (( pct == 100 )); then out+=("󰂄")
    elif (( pct <= 5 )); then out+=("󰢟 ${pct}%")
    elif (( pct <= 39 )); then out+=("󱊤 ${pct}%")
    elif (( pct <= 89 )); then out+=("󱊥 ${pct}%")
    else out+=("󱊦 ${pct}%")
    fi
  elif [[ "$batt" == *"Battery Power"* && -n "$pct" ]]; then
    if (( pct <= 5 )); then out+=($'\U000F008E'" ${pct}%")
    elif (( pct <= 39 )); then out+=($'\U000F12A1'" ${pct}%")
    elif (( pct <= 89 )); then out+=($'\U000F12A2'" ${pct}%")
    else out+=($'\U000F12A3'" ${pct}%")
    fi
  fi

  # wifi power state (en0): on 󰖩 / off 󰤮.
  wifi="$("$NETWORKSETUP" -getairportpower en0 2>/dev/null)" || wifi=""
  if [[ "${(L)wifi}" == *": on"* ]]; then out+=($'\U000F05A9')
  else out+=($'\U000F092E')
  fi
fi

if (( is_ssh )); then
  h="$(cat "$HOST_ALIAS" 2>/dev/null)" || h=""
  [[ -n "$h" ]] || h="$(hostname -s 2>/dev/null)" || h=""
  [[ -n "$h" ]] && out+=("󰒍 $h")
fi

if (( ! is_ssh || is_fullscreen )); then
  # clock — zj-hud format `%a %b %-e %-l:%M%P`; BSD date lacks the `%-`
  # no-pad modifier, so strip the pads by hand and lowercase am/pm.
  d="$(date '+%a %b')"; e="$(date '+%e')"; t="$(date '+%l:%M')"
  ap="${(L)$(date '+%p')}"
  out+=($'\U000F00F0'" $d ${e## } ${t## }$ap")
fi

(( ${#out} )) && print -rn -- " ${(j:  :)out} "
exit 0
