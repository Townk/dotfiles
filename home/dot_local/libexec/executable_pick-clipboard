#!/usr/bin/env zsh
# pick-clipboard — fzf picker over the universal clipboard history store.
#
# Backs the universal-clipboard project (spec §7). Streams rows straight from
# the SQLite store at ${XDG_DATA_HOME:-~/.local/share}/pick-clipboard/history.db
# into pick::start — no assembled-lines cache, no jq — ordered
#   pinned DESC, last_ts DESC.
#
# Wire format (the \x1f/\x1e contract from pick-common.zsh):
#   <visible preview>\x1f<id>\x1eMD:<id>
# Field 1 (pick::start field:1) is the plain id, used by Enter/--field-id
# recency. Field 2 is a synthetic "MD:<id>" marker (--key-output can only
# select an existing field, not synthesize a literal), read by Alt-Enter to
# request the markdown-alternate rendering below. Clip content can be
# multi-line, which fzf's line-based entry model can't carry inline, so the
# text is re-fetched from the store by id on every accept / background action
# instead of being embedded in the line.
#
# Keys:
#   Enter        paste the selected clip's text into the originating pane
#                (zellij-modal captures pick-clipboard's stdout, so we print the
#                re-fetched text after pick::start returns the id).
#   Ctrl-O       keep open (--key-background): re-fetch + insert WITHOUT
#                dismissing. The GUI picker uses Ctrl-Enter for this, but fzf
#                0.73.1's --bind parser has no "ctrl-enter" key name at all
#                (confirmed: `fzf --bind ctrl-enter:accept` -> "unsupported
#                key: ctrl-enter", exit 2) -- most terminals send identical
#                bytes for Enter and Ctrl-Enter and fzf never implemented the
#                Kitty-protocol disambiguation for it, unlike the other
#                ctrl/alt combos it does support. Ctrl-O is the substitute.
#   Alt-Enter    accept-and-dismiss with the markdown alternate (--key-output
#                field:2): a [label](file://...) link for file/directory
#                clips, [url](url) for url clips, an inline
#                ![](data:image/...;base64,...) for image clips, and plain
#                text_plain (same as Enter) for every other kind -- there's
#                no rich-vs-raw distinction in a terminal.
#   Ctrl-Y       accept-and-dismiss + copy to *my* clipboard, carrying the
#                register type so a block clip stays block-pasteable
#                (clip::copy_by_id). Self-contained (§11): the clip already
#                lives here, so copy is local; when bridge-up it also ships to
#                the machine you're sitting at (image -> C, text -> T(regtype));
#                iPad -> OSC 52. Emits nothing to the pane (unlike Enter).
#                files/file/directory rows restore a REAL file object onto
#                this Mac's pasteboard instead (files-yazi design §9,
#                clip::copy_files_by_id): a local row does a full-fidelity
#                id:<n> restore, a remote manifest row rsyncs the files down
#                to ~/.cache/pick-clipboard/files/<id>/<idx>/ first and
#                localizes the clip (an already-localized row short-circuits
#                to its on-disk copies); any failure there falls back to the
#                plain-text copy above.
#   Ctrl-D/Alt-D delete the row (SQL DELETE by id), stay open.
#   Ctrl-P       toggle pin, stay open.
#
# No origin filter (spec §11): the picker always shows this machine's whole
# store. `source_host` drives only the per-row local/remote badge, never
# visibility; bridge-up decides only where a Ctrl-Y copy additionally lands.
#
# Accept markers: pick::start emits one of three tail fields on accept, and the
# wrapper below dispatches on the prefix — field:1 plain id (Enter -> inject
# text), field:2 "MD:id" (Alt-Enter -> markdown), field:3 "CP:id" (Ctrl-Y ->
# copy, print nothing). A dedicated accept field is how copy-and-dismiss runs a
# side effect without injecting: the wrapper does the copy instead of printing.

set -eu -o pipefail

PICK_NAME=pick-clipboard
PICK_LIB_DIR="${PICK_LIB_DIR:-$HOME/.local/lib}"
source "${PICK_COMMON_LIB:-$PICK_LIB_DIR/pick-common.zsh}" ||
  { print -ru2 -- "pick-clipboard: cannot source pick-common.zsh from $PICK_LIB_DIR"; exit 1; }
source "${PICK_BRIDGE_CLIENT_LIB:-$PICK_LIB_DIR/clipboard-bridge-client.zsh}" ||
  { print -ru2 -- "pick-clipboard: cannot source clipboard-bridge-client.zsh from $PICK_LIB_DIR"; exit 1; }

DB_FILE="${PICK_CLIPBOARD_DB:-${XDG_DATA_HOME:-$HOME/.local/share}/pick-clipboard/history.db}"
require_cmd sqlite3
require_cmd pbcopy 2>/dev/null || true   # copy target; optional in odd envs

# `-escape off` (sqlite >= 3.46) keeps the raw ANSI + US field bytes intact.
typeset -ga PICK_SQLITE_RAW; PICK_SQLITE_RAW=()
if sqlite3 -escape off ':memory:' 'SELECT 1;' >/dev/null 2>&1; then
  PICK_SQLITE_RAW=(-escape off)
fi

[[ -f "$DB_FILE" ]] || die "clipboard store not found: $DB_FILE
It is created by the Hammerspoon clipboard-history watcher (chezmoi apply)."

# --- bridge-up detection (spec §8) -----------------------------------------
# Bridge-up = we're in an SSH session AND the reverse-forwarded remote clipboard
# is actually reachable on the loopback TCP port. A real connect probe (not a
# "does a socket file exist?" check) — a down/stale tunnel refuses, so we
# degrade cleanly instead of the old "file present but connection refused" trap.
# Under the self-contained model (§11) bridge-up no longer changes WHICH rows
# the picker shows (it's always this machine's whole store); it only decides
# where a Ctrl-Y copy additionally lands (ship to the machine you're sitting at).
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=2490   # reverse-forwarded remote clipboard (SSH bridge-up)
LOCAL_PORT=2489   # this machine's own clipboard-bridge (sitting locally)
bridge_up=0
if [[ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]] &&
   clipbridge::probe "$BRIDGE_HOST" "$BRIDGE_PORT"; then
  bridge_up=1
fi

# --- provenance (spec §11) --------------------------------------------------
# A clip's `source_host` is the hostname where it was originally copied, and is
# the ONLY thing conveying origin: a row is "remote" iff its source_host differs
# from THIS machine's hostname. NULL source_host (legacy rows) reads as local.
# Drives the per-row badge/footer only — never row visibility.
MY_HOST=$(scutil --get LocalHostName 2>/dev/null)
[[ -n "$MY_HOST" ]] || MY_HOST=$(hostname -s 2>/dev/null)
remote_when="source_host IS NOT NULL AND source_host <> '$MY_HOST'"

# --- live peer clipboard entry (spec §22) -----------------------------------
# When bridge-up (SSH'd in here with the reverse tunnel live), surface the
# CURRENT clipboard of the machine you're sitting at as one synthetic top row,
# fetched live at open time. Viewing != owning (§11): nothing is written to the
# store until the row is accepted (Enter/Ctrl-Y), which materializes it via the
# same P op nvim `p` uses. Bounded + best-effort: on any failure the row is just
# omitted, never blocking the picker. The probe (bridge_up) already succeeded,
# so the G/H reads are fast loopback round-trips.
#
# LIVE_TEXT_FILE non-empty => a live entry is available; its bytes are the exact
# peer clipboard text (reused verbatim at accept time — no second G). live_row_file
# holds the pre-rendered picker line, emitted at the top by emit_rows/emit_script.
LIVE_TEXT_FILE=""
LIVE_HOST=""
live_row_file=""
if (( bridge_up )); then
  _lt=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-live.XXXXXX")
  if clipbridge::get "$BRIDGE_HOST" "$BRIDGE_PORT" > "$_lt" 2>/dev/null && [[ -s "$_lt" ]] &&
     grep -q '[^[:space:]]' "$_lt"; then          # empty/whitespace guard (§22.2)
    LIVE_HOST=$(clipbridge::get_host "$BRIDGE_HOST" "$BRIDGE_PORT" 2>/dev/null)
    [[ -n "$LIVE_HOST" ]] || LIVE_HOST="peer"
    # Dedup (§22.5, revised for §23): suppress the live entry when its text is
    # already in the store — compared trailing-newline-insensitively and
    # regardless of source_host. Two reasons the old (peerhost, type_hash) key
    # misses: (1) op_get (G) strips the trailing newline a stored copy keeps, so
    # sha256(live) != the stored type_hash; (2) a remote copy (§23) now stores the
    # clip LOCALLY (source_host = this host, not the peer). rtrim(char(10)) on both
    # sides drops the newline difference; no source_host filter covers any origin;
    # readfile keeps the compare byte-safe for arbitrary text.
    if [[ -z "$(sqlite3 "$DB_FILE" "SELECT 1 FROM clips WHERE rtrim(text_plain, char(10)) = rtrim(CAST(readfile('$_lt') AS TEXT), char(10)) LIMIT 1;" 2>/dev/null)" ]]; then
      LIVE_TEXT_FILE="$_lt"
    fi
  fi
  [[ -n "$LIVE_TEXT_FILE" ]] || rm -f "$_lt"
fi

# --- helpers (run in THIS process via the --key-background FIFO broker) ------
clip::text_by_id() {  # id -> text_plain (raw, multi-line)
  sqlite3 "${PICK_SQLITE_RAW[@]}" "$DB_FILE" "SELECT text_plain FROM clips WHERE id=$1;"
}

clip::delete_by_id() {
  sqlite3 "$DB_FILE" "DELETE FROM clip_types WHERE clip_id=$1; DELETE FROM clips WHERE id=$1;"
}

clip::toggle_pin_by_id() {
  sqlite3 "$DB_FILE" "UPDATE clips SET pinned = 1 - pinned WHERE id=$1;"
}

# Ship an image clip's blob to the remote via the reverse channel (C op). Tries
# each image UTI in turn (same set/order as clip::markdown_image); the first with
# a stored blob is packaged as <BE16 uti_len><uti><blob> and sent. Returns 0 on
# an 'O' response. Byte-safe: the payload (BE16 len + binary blob) is built in a
# temp file under nomultibyte, never a $(...) capture.
clip::ship_image_by_id() {
  emulate -L zsh
  setopt nomultibyte
  local id=$1 uti blobf payloadf
  local -a utis=(public.png public.jpeg public.tiff com.compuserve.gif)
  for uti in "${utis[@]}"; do
    blobf=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-ship.XXXXXX") || return 1
    sqlite3 "$DB_FILE" "SELECT writefile('$blobf', blob) FROM clip_types WHERE clip_id=$id AND uti='$uti';" >/dev/null 2>&1
    if [[ -s "$blobf" ]]; then
      payloadf=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-ship-p.XXXXXX") || { rm -f "$blobf"; return 1; }
      local -i ulen=$#uti
      {
        printf "\\$(printf %03o $(( (ulen >> 8) & 255 )))\\$(printf %03o $(( ulen & 255 )))"
        printf '%s' "$uti"
        cat "$blobf"
      } > "$payloadf"
      rm -f "$blobf"
      if clipbridge::send "$BRIDGE_HOST" "$BRIDGE_PORT" C "$payloadf"; then rm -f "$payloadf"; return 0; fi
      rm -f "$payloadf"
      return 1
    fi
    rm -f "$blobf"
  done
  return 1
}

# Set the target clipboard to a clip via the framing T op (regtype + exact
# text), so the register type is RECORDED alongside — a later nvim paste can
# then block-paste it. <port> picks the dispatcher: BRIDGE_PORT (the remote over
# the reverse tunnel) or LOCAL_PORT (this machine's own bridge). text_plain is
# written via writefile so no sqlite trailing newline sneaks in (an extra line
# would corrupt a block clip). Returns 0 on an 'O' response.
clip::set_via_bridge() {
  local port=$1 id=$2 rt txtf
  rt=$(sqlite3 "$DB_FILE" "SELECT IFNULL(regtype,'v') FROM clips WHERE id=$id;" 2>/dev/null) || rt=v
  [[ "$rt" == (v|l|b) ]] || rt=v
  local pf; pf=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-set.XXXXXX") || return 1
  txtf="$pf.txt"
  print -rn -- "$rt" > "$pf"
  sqlite3 "$DB_FILE" "SELECT writefile('$txtf', text_plain) FROM clips WHERE id=$id;" >/dev/null 2>&1
  [[ -f "$txtf" ]] && cat "$txtf" >> "$pf"
  rm -f "$txtf"
  if clipbridge::send "$BRIDGE_HOST" "$port" T "$pf"; then rm -f "$pf"; return 0; fi
  rm -f "$pf"; return 1
}

# clip::send_file_urls <path>... -- send a form-A U frame (NUL-joined absolute
# paths) to this Mac's own bridge; op_set_file_urls's form A is what generates
# the NSFilenamesPboardType/public.file-url Finder needs. Shared by the
# localized-row guard and the post-pull send in clip::copy_files_by_id.
# Returns 0 on an 'O' response.
clip::send_file_urls() {
  local upf; upf=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-fileurls.XXXXXX") || return 1
  local first=1 lp
  {
    for lp in "$@"; do
      if (( first )); then print -rn -- "$lp"; first=0
      else print -rn -- $'\0'"$lp"; fi
    done
  } > "$upf"
  if clipbridge::send "$BRIDGE_HOST" "$LOCAL_PORT" U "$upf"; then rm -f "$upf"; return 0; fi
  rm -f "$upf"
  return 1
}

# Restore a files/file/directory row's real file object onto THIS Mac's
# pasteboard (Ctrl-Y, files-yazi design §9/§12; M2 scope -- the picker runs on
# the Mac, so a files restore ALWAYS targets $LOCAL_PORT, this machine's own
# bridge, regardless of bridge_up/SSH: Finder only reads a real file-url on
# the machine it's running on). Returns 1 on any failure so the caller
# (clip::copy_by_id) falls back to the existing text behavior; a reason goes
# to stderr. Four cases, in dispatch order:
#
#   1. source_host is this host (or NULL/legacy) -- a genuine local capture
#      with real NSFilenamesPboardType/public.file-url blobs: U with the
#      id:<n> form, a full-fidelity restore_by_id.
#   2. remote origin, but every recorded path (x-file-manifest, else
#      x-resolved-path) lives under the picker's own cache root
#      ~/.cache/pick-clipboard/files/ AND exists on disk: U with those paths
#      directly (form A). This is the row shape the picker itself creates
#      when it localizes a pull (below) -- single-path rows carry only a
#      synthetic x-resolved-path (id:<n> would restore the blob under that
#      literal UTI: nothing pasteable), multi-path rows carry an
#      x-file-manifest of LOCAL paths (the rsync branch would try to pull
#      them from the origin, which never had them). The check handles both
#      shapes without caring which UTI the paths came from. The cache-root
#      restriction is load-bearing: localization records paths exclusively
#      under the cache root, so a remote manifest naming a path that happens
#      to exist on this Mac too (the Mac-to-Mac mirror case --
#      /Users/<me>/doc.txt on both machines) still takes the pull branch
#      instead of silently pasting a possibly-stale local twin.
#   3. remote origin, not a case-2 row: the spec §12 pull -- rsync each
#      x-file-manifest path down into its own per-position subdir
#      ~/.cache/pick-clipboard/files/<id>/<idx>/ (the <idx> namespace keeps
#      two manifest entries that share a basename from colliding on one
#      flat cache path, which would silently drop a file), skipping any
#      position already cached from an earlier pull of this SAME row. Then
#      record the localized clip as a new local row (mirrors op_persist:
#      source_host stays the ORIGIN host, so the new row still badges remote
#      even though its bytes are now local; best-effort -- a bookkeeping
#      failure does not block the paste; SKIPPED entirely when nothing was
#      actually pulled, i.e. every position was already cached -- these rows
#      have no type_hash, so a re-pick would otherwise pile up an identical
#      row every time) and U the localized paths (form A).
#   4. remote origin, only an x-resolved-path whose file is gone (a stale
#      localized row after a cache sweep): fail honestly -- the origin never
#      had the cache path, so there is nothing to re-pull from.
#
# rsync is pinned to /opt/homebrew/bin/rsync exactly like pbpaste's tier 2
# (stock /usr/bin/rsync is openrsync, which lacks --info=progress2).
# PICK_CLIPBOARD_RSYNC is a TEST-ONLY override: an absolute-path invocation
# can't be shadowed via PATH, so the shellspec suite injects its fake rsync
# through this env var instead. Never set it in production.
clip::copy_files_by_id() {
  local id=$1
  local host; host=$(sqlite3 "$DB_FILE" "SELECT IFNULL(source_host,'') FROM clips WHERE id=$id;" 2>/dev/null) || host=""

  # Recorded paths: x-file-manifest first (multi-path), else x-resolved-path
  # (single-path). srcuti remembers which one so case 3 vs 4 can differ.
  local blobtmp; blobtmp=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-cpfiles-blob.XXXXXX") || {
    print -ru2 -- "pick-clipboard: mktemp failed"; return 1
  }
  local srcuti=""
  sqlite3 "$DB_FILE" "SELECT writefile('$blobtmp', blob) FROM clip_types WHERE clip_id=$id AND uti='x-file-manifest';" >/dev/null 2>&1
  if [[ -s "$blobtmp" ]]; then
    srcuti="x-file-manifest"
  else
    sqlite3 "$DB_FILE" "SELECT writefile('$blobtmp', blob) FROM clip_types WHERE clip_id=$id AND uti='x-resolved-path';" >/dev/null 2>&1
    [[ -s "$blobtmp" ]] && srcuti="x-resolved-path"
  fi
  local -a rpaths
  if [[ -n "$srcuti" ]]; then
    local blob; blob="$(<"$blobtmp")"
    rpaths=("${(@ps:\0:)blob}")
  fi
  rm -f "$blobtmp"

  # Case 1: genuine local capture -> full-fidelity id: restore.
  if [[ -z "$host" || "$host" == "$MY_HOST" ]]; then
    local pf; pf=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-fileid.XXXXXX") || return 1
    print -rn -- "id:$id" > "$pf"
    if clipbridge::send "$BRIDGE_HOST" "$LOCAL_PORT" U "$pf"; then
      rm -f "$pf"
      return 0
    fi
    rm -f "$pf"
    print -ru2 -- "pick-clipboard: local files restore (id:$id) failed"
    return 1
  fi

  # Remote-origin row from here on.
  (( ${#rpaths[@]} > 0 )) || { print -ru2 -- "pick-clipboard: no file paths recorded for row $id"; return 1 }

  # Case 2: every recorded path is one of the picker's OWN cache paths and
  # exists (a row this picker localized earlier, either shape) -> form A
  # with those paths, no re-pull. The cache-root prefix requirement is what
  # keeps a coincidentally-existing non-cache path (Mac-to-Mac mirror rows)
  # from short-circuiting to a possibly-stale local twin.
  local cacheroot="$HOME/.cache/pick-clipboard/files/"
  local -i all_cached=1
  local rp
  for rp in "${rpaths[@]}"; do
    [[ "$rp" == "$cacheroot"* && -e "$rp" ]] || { all_cached=0; break }
  done
  if (( all_cached )); then
    clip::send_file_urls "${rpaths[@]}" && return 0
    print -ru2 -- "pick-clipboard: localized files restore failed for row $id"
    return 1
  fi

  # Case 4: an x-resolved-path-only remote row that case 2 didn't claim --
  # either a stale localized row (cache path swept from disk: the origin
  # never held it, nothing to re-pull) or a mirrored row recording a
  # non-cache origin path (only x-file-manifest rows are pullable in M2).
  if [[ "$srcuti" != "x-file-manifest" ]]; then
    print -ru2 -- "pick-clipboard: no pullable manifest for row $id (recorded path: ${rpaths[1]})"
    return 1
  fi

  # Case 3: genuine remote manifest -> rsync pull-down (spec §12).
  local rsync_bin="${PICK_CLIPBOARD_RSYNC:-/opt/homebrew/bin/rsync}"
  if [[ ! -x "$rsync_bin" ]]; then
    print -ru2 -- "pick-clipboard: brew rsync not found: $rsync_bin"
    return 1
  fi
  local kind; kind=$(sqlite3 "$DB_FILE" "SELECT IFNULL(type_kind,'files') FROM clips WHERE id=$id;" 2>/dev/null) || kind="files"

  local cachedir="$HOME/.cache/pick-clipboard/files/$id"
  local -a local_paths
  local -i idx=0 pulled=0
  local sub lp
  for rp in "${rpaths[@]}"; do
    (( idx += 1 ))
    sub="$cachedir/$idx"
    lp="$sub/${rp:t}"
    if [[ ! -e "$lp" ]]; then
      mkdir -p "$sub" || { print -ru2 -- "pick-clipboard: cannot create $sub"; return 1 }
      if ! "$rsync_bin" -a --info=progress2 -e ssh "${host}:${rp}" "$sub/" >/dev/null 2>&1; then
        print -ru2 -- "pick-clipboard: rsync failed pulling $host:$rp"
        return 1
      fi
      (( pulled += 1 ))
    fi
    local_paths+=("$lp")
  done

  # Best-effort bookkeeping: a new local row, source_host = the ORIGIN host
  # (spec §12), single-path rows via x-resolved-path (matching a genuine
  # file/directory capture), multi-path via x-file-manifest (matching a
  # genuine files capture) -- the same distinction op_list_files reads back.
  # Re-picking this new row later lands in case 2 above. Skipped when
  # nothing was pulled (every position already cached by an earlier pick of
  # this same row): the localized row for this pull already exists, and
  # these rows carry no type_hash, so re-inserting would pile up an
  # identical row on every re-pick with nothing to dedup it.
  if (( pulled > 0 )); then
    local ts; ts=$(date +%s)
    local ek="${kind//\'/\'\'}" eh="${host//\'/\'\'}"
    local new_id
    new_id=$(sqlite3 "$DB_FILE" "INSERT INTO clips (type_kind, first_ts, last_ts, source_host) VALUES ('$ek', $ts, $ts, '$eh'); SELECT last_insert_rowid();") 2>/dev/null || new_id=""
    if [[ -n "$new_id" ]]; then
      local blobf; blobf=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-localize-blob.XXXXXX")
      local uti="x-resolved-path" first=1
      if (( ${#local_paths[@]} > 1 )); then
        uti="x-file-manifest"
        { for lp in "${local_paths[@]}"; do
            if (( first )); then print -rn -- "$lp"; first=0
            else print -rn -- $'\0'"$lp"; fi
          done
        } > "$blobf"
      else
        print -rn -- "${local_paths[1]}" > "$blobf"
      fi
      sqlite3 "$DB_FILE" "INSERT INTO clip_types (clip_id, uti, blob) VALUES ($new_id, '$uti', readfile('$blobf'));" >/dev/null 2>&1
      rm -f "$blobf"
    fi
  fi

  clip::send_file_urls "${local_paths[@]}" && return 0
  print -ru2 -- "pick-clipboard: localized files restore failed for row $id"
  return 1
}

# Copy a clip's content to *my* clipboard, carrying the register type so a block
# clip stays block-pasteable. Self-contained model (§11): the clip already lives
# in this store, so there is no cross-machine restore — copy is always a local
# set, plus (when bridge-up) a ship to the machine you're sitting at:
#   files/file/directory -> clip::copy_files_by_id (id: form locally, rsync
#     pull-down + localize for a remote manifest row, spec §9/§12); on ANY
#     failure there, falls through to the behavior below unchanged.
#   bridge-up (SSH) image  -> C ship the blob to the peer (OSC 52 can't carry it)
#   bridge-up (SSH) text   -> T(regtype+text) to the peer you're sitting at
#   sitting locally (no SSH)-> T(regtype+text) to this machine's own bridge
#   SSH bridge-down (iPad) / fail -> pbcopy shim (OSC 52 text; iPad can't block)
clip::copy_by_id() {
  local id=$1
  local kind; kind=$(sqlite3 "$DB_FILE" "SELECT type_kind FROM clips WHERE id=$id;" 2>/dev/null) || kind=""
  if [[ "$kind" == (files|file|directory) ]]; then
    clip::copy_files_by_id "$id" && return 0
  fi
  if (( bridge_up )); then
    [[ "$kind" == image ]] && clip::ship_image_by_id "$id" && return 0
    clip::set_via_bridge "$BRIDGE_PORT" "$id" && return 0
  elif [[ -z "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]]; then
    clip::set_via_bridge "$LOCAL_PORT" "$id" && return 0
  fi
  if command -v pbcopy >/dev/null 2>&1; then
    clip::text_by_id "$id" | pbcopy
  fi
}

# --- live entry accept handlers (spec §22.4) --------------------------------
# The three below act on the already-fetched peer text in LIVE_TEXT_FILE — no
# second G. deliver = print it (zellij-modal injects our stdout into the pane);
# copy = set the clipboard I'm sitting at (T with the peer's regtype); materialize
# = persist a self-contained local row via the P op on THIS machine's own bridge,
# so the next open shows it as an ordinary stored row (badged remote) and the live
# entry dedups against it. materialize runs after any accept; it's best-effort —
# a failed persist still delivered the text.
clip::deliver_live() {
  [[ -n "$LIVE_TEXT_FILE" && -f "$LIVE_TEXT_FILE" ]] && cat "$LIVE_TEXT_FILE"
}

clip::copy_live() {
  [[ -n "$LIVE_TEXT_FILE" && -s "$LIVE_TEXT_FILE" ]] || return 0
  local rt; rt=$(clipbridge::request "$BRIDGE_HOST" "$BRIDGE_PORT" R 2>/dev/null)
  [[ "$rt" == (v|l|b) ]] || rt=v
  local pf; pf=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-live-cp.XXXXXX") || return 0
  { print -rn -- "$rt"; cat "$LIVE_TEXT_FILE"; } > "$pf"
  # bridge_up is a precondition of a live entry existing, so the copy target is
  # the machine I'm sitting at, over the reverse tunnel (T = set + record regtype).
  clipbridge::send "$BRIDGE_HOST" "$BRIDGE_PORT" T "$pf"
  rm -f "$pf"
}

clip::materialize_live() {
  [[ -n "$LIVE_TEXT_FILE" && -s "$LIVE_TEXT_FILE" ]] || return 0
  local rt; rt=$(clipbridge::request "$BRIDGE_HOST" "$BRIDGE_PORT" R 2>/dev/null)
  [[ "$rt" == (v|l|b) ]] || rt=v
  local us=$'\x1f' rs=$'\x1e'
  local pf; pf=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-live-p.XXXXXX") || return 0
  # P payload: source_host US kind US app US regtype RS text  (app empty)
  { print -rn -- "${LIVE_HOST}${us}text${us}${us}${rt}${rs}"; cat "$LIVE_TEXT_FILE"; } > "$pf"
  clipbridge::send "$BRIDGE_HOST" "$LOCAL_PORT" P "$pf"
  rm -f "$pf"
}

# Inject a clip's text into the originating zellij pane (embed mode), else
# fall back to copy. Mirrors pick::background_sink's inject path.
clip::inject_by_id() {
  local id=$1 text
  text="$(clip::text_by_id "$id")"
  if [[ -n "${PICK_INJECT_PANE:-}" && -n "${PICK_INJECT_ZELLIJ:-}" ]]; then
    ${(z)PICK_INJECT_ZELLIJ} action write-chars --pane-id "$PICK_INJECT_PANE" -- "$text"
  elif command -v pbcopy >/dev/null 2>&1; then
    printf '%s' "$text" | pbcopy
  fi
}

# --- markdown alternate (Alt-Enter, --key-output field:2) -------------------
# No rich-vs-raw distinction here (there's nothing to strip in a terminal --
# it's all plain text already); file/directory/url/image clips get linkified,
# everything else falls back to the same text_plain as a normal Enter.

clip::markdown_url() {
  local id=$1 url
  url="$(clip::text_by_id "$id")"
  printf '[%s](%s)' "$url" "$url"
}

# POSIX path -> a valid file:// URI, percent-encoding each path segment
# individually via jq's @uri (not the whole string at once, which would also
# escape the "/" separators) -- mirrors path_to_file_url in
# clipboard-history.lua.
#
# NOTE: the parameter is named "fpath", not "path" -- zsh's lowercase $path
# is a special array tied to $PATH; a plain-string `local path=...` shadows
# it and silently breaks command lookup (sqlite3 et al.) for the rest of
# this function's scope. Confirmed empirically. Same reasoning in
# clip::markdown_path_link below.
clip::path_to_file_url() {
  local fpath=$1 seg encoded=""
  for seg in "${(s:/:)fpath}"; do
    [[ -z "$seg" ]] && continue
    encoded+="/$(jq -rn --arg s "$seg" '$s|@uri')"
  done
  print -r -- "file://$encoded"
}

# file/directory clips: link text is the basename, target is the already-
# resolved path Lua's capture code stored under the synthetic
# "x-resolved-path" UTI (clipboard-history.lua resolves macOS's opaque
# file-reference URLs there; nothing to re-resolve here).
clip::markdown_path_link() {
  local id=$1 fpath
  fpath="$(sqlite3 "${PICK_SQLITE_RAW[@]}" "$DB_FILE" "SELECT blob FROM clip_types WHERE clip_id=$id AND uti='x-resolved-path';")"
  if [[ -n "$fpath" ]]; then
    printf '[%s](%s)' "${fpath##*/}" "$(clip::path_to_file_url "$fpath")"
  else
    clip::text_by_id "$id"
  fi
}

# image clips: try each image UTI in turn (same set/order as
# IMAGE_UTIS/IMAGE_MIME in clipboard-picker.lua); the first one with a stored
# blob wins. writefile() needs the sqlite3 fileio extension (built into this
# system's sqlite3 by default); `base64 -i ... | tr -d '\n'` is portable
# single-line output regardless of whether the local base64 wraps by default.
clip::markdown_image() {
  local id=$1 pair uti mime tmpfile b64
  local -a utis=(public.png:image/png public.jpeg:image/jpeg public.tiff:image/tiff com.compuserve.gif:image/gif)
  for pair in "${utis[@]}"; do
    uti="${pair%%:*}"; mime="${pair#*:}"
    tmpfile="$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-img.XXXXXX")"
    sqlite3 "$DB_FILE" "SELECT writefile('$tmpfile', blob) FROM clip_types WHERE clip_id=$id AND uti='$uti';" >/dev/null
    if [[ -s "$tmpfile" ]]; then
      b64="$(base64 -i "$tmpfile" | tr -d '\n')"
      rm -f -- "$tmpfile"
      printf '![](data:%s;base64,%s)' "$mime" "$b64"
      return 0
    fi
    rm -f -- "$tmpfile"
  done
  clip::text_by_id "$id"
}

clip::markdown_by_id() {  # id -> markdown string for file/directory/url/image; else plain text (same as Enter)
  local id=$1 kind
  kind="$(sqlite3 "$DB_FILE" "SELECT type_kind FROM clips WHERE id=$id;")"
  case "$kind" in
    url)              clip::markdown_url "$id" ;;
    file|directory)   clip::markdown_path_link "$id" ;;
    image)            clip::markdown_image "$id" ;;
    *)                clip::text_by_id "$id" ;;
  esac
}

# --on-key-background hook: $1 = id (field:1), $2 = the key. Dispatch on $2.
clip::bg_hook() {
  local id=$1 key=${2:-}
  # The LIVE sentinel is not a row — ignore every background key on it (§22.4).
  [[ -n "$id" && "$id" != LIVE ]] || return 0
  case "$key" in
    ctrl-o)           clip::inject_by_id "$id" ;;
    ctrl-d|alt-d)     clip::delete_by_id "$id" ;;
    ctrl-p)           clip::toggle_pin_by_id "$id" ;;
    *)                ;;  # ignore unmapped background keys
  esac
}

# --on-items-picked: re-bump last_ts so the just-picked clip floats to the top.
clip::bump_recency() {
  (($#)) || return 0
  local now id; now=$(date +%s)
  for id; do
    [[ "$id" == <-> ]] || continue   # numeric ids only — skips the LIVE sentinel
    sqlite3 "$DB_FILE" "UPDATE clips SET last_ts=$now WHERE id=$id;" 2>/dev/null || true
  done
}

# --- dynamic geometry (from the live TTY) -----------------------------------
# The item line + preview footer are sized to the actual pane so the pin sits
# at the right edge (not truncated off) and the footer fits the preview pane.
# pty-frame draws a 1-cell box + fzf pads ~3 each side, so the usable list
# area is ~COLS-8; the item line reserves icon(2)+sep(2)+sep(2)+pin(2)=8, so
# content width CW = COLS-16. The preview pane is 45% of the fzf window; the
# footer label/value widths sum to fit it. preview_h drives the blank padding
# that bottom-aligns the footer.
COLS=${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}
ROWS=${LINES:-$(tput lines 2>/dev/null || echo 24)}
# Item-line content width. The list pane is ~55% of the fzf window (the
# preview takes 45%); the fzf window is the pty-frame sub-pty = COLS-2 (box);
# minus ~6 (fzf padding 0,2,0,2 + input-border gutter each side); minus 5
# (icon + sep + pin column). So CW = (COLS-2)*55/100 - 11. The list width
# isn't exposed to the input stream (items emit before fzf lays out), so this
# is computed from tput cols — the preview footer instead uses fzf's exact
# FZF_PREVIEW_COLUMNS (see the preview script).
CW=${PICK_CLIPBOARD_CONTENT_WIDTH:-$(( (COLS - 2) * 55 / 100 - 12 ))}
(( CW < 10 )) && CW=10

# Pre-render the synthetic LIVE row (§22.3) once, into a temp file the emit path
# cats above the stored rows. Rendered via sqlite3 so the glyph/ANSI/printf are
# byte-identical to the DB rows; the peer text comes from LIVE_TEXT_FILE via
# readfile (no DB row exists for it). Kind glyph is nf-md-access-point (char 983043,
# U+F0003) in the mauve origin color (c_origin) — radiating waves that read as
# live/not-from-here at a glance.
# Preview = first line only, same CW truncation + ellipsis as stored rows. Tail
# id is the sentinel LIVE (not numeric): field1=LIVE, field2=MD:LIVE, field3=CP:LIVE.
if [[ -n "$LIVE_TEXT_FILE" ]]; then
  live_row_file=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-liverow.XXXXXX")
  sqlite3 "${PICK_SQLITE_RAW[@]}" "$DB_FILE" "WITH palette AS (
        SELECT CHAR(27)||'[0m'                AS reset,
               CHAR(27)||'[38;2;202;211;245m' AS text_color,
               CHAR(27)||'[38;2;203;166;247m' AS c_origin
      ),
      live AS ( SELECT CAST(readfile('$LIVE_TEXT_FILE') AS TEXT) AS body ),
      l AS ( SELECT CASE WHEN instr(body, char(10)) > 0
                         THEN substr(body, 1, instr(body, char(10)) - 1)
                         ELSE body END AS oneline FROM live )
      SELECT c_origin || char(983043) || reset || '  '
        || text_color
        || printf('%-${CW}s', substr(oneline,1,$((CW-1))) || CASE WHEN length(oneline) > $((CW-1)) THEN '…' ELSE '' END)
        || reset || '   '
        || CHAR(31) || 'LIVE' || CHAR(30) || 'MD:LIVE' || CHAR(30) || 'CP:LIVE'
      FROM l, palette;" > "$live_row_file"
fi

# --- preview (full text + bottom-aligned formatted footer) ------------------
# fzf's {2} = "id\x1eMD:id" (fzf's own --delimiter only splits on \x1f, so the
# \x1e-joined markdown marker rides along inside field 2 unsplit -- the
# script strips it back off; see the wire-format comment at the top of this
# file). The preview script emits the clip's full text, blank padding to push
# the footer to the bottom of the preview pane, then a 5-line footer (labels
# left, values right-aligned, Copied: last). Dim throughout. A standalone
# script (fzf's preview runs a fresh shell) with the DB path + widths +
# age/words expressions inlined.
age_expr="CASE WHEN CAST(strftime('%s','now') AS INT)-CAST(last_ts AS INT) < 60 THEN printf('%ds', CAST(strftime('%s','now') AS INT)-CAST(last_ts AS INT)) WHEN CAST(strftime('%s','now') AS INT)-CAST(last_ts AS INT) < 3600 THEN printf('%dm', (CAST(strftime('%s','now') AS INT)-CAST(last_ts AS INT))/60) WHEN CAST(strftime('%s','now') AS INT)-CAST(last_ts AS INT) < 86400 THEN printf('%dh', (CAST(strftime('%s','now') AS INT)-CAST(last_ts AS INT))/3600) ELSE printf('%dd', (CAST(strftime('%s','now') AS INT)-CAST(last_ts AS INT))/86400) END"
# word count: space-separated tokens in the newline-flattened text (0 if empty/NULL)
words_expr="CASE WHEN text_plain IS NULL OR text_plain='' THEN 0 ELSE length(trim(replace(text_plain,char(10),' '))) - length(replace(trim(replace(text_plain,char(10),' ')),' ','')) + 1 END"
preview_script=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-preview.XXXXXX")
PREVIEW_CMD="bash $preview_script {2}"

# --- the row stream ---------------------------------------------------------
# Item line = 3 columns, all rows aligned:
#   col 1: type icon (colored by type)
#   col 2: content preview, padded to a fixed width (CW) so col 3 aligns;
#          YELLOW when pinned (so pinned rows stand out)
#   col 3: pin thumbtack (yellow) when pinned, else blank
# Tail = id\x1eMD:id (CHAR 31 = \x1f, CHAR 30 = \x1e -- see the wire-format
# comment at the top of this file). Type icons: fa-font (text), fa-paintbrush
# (rtf/html), fa-image, fa-folder (files), nf-md-file_outline (file),
# nf-md-folder_outline (directory), nf-md-link_variant (url),
# nf-md-file_document_multiple_outline (mixed), fa-thumbtack (pin) -- same
# glyphs/colors as the GUI picker (clipboard-picker.css/.html), Nerd Font v3
# codepoints via SQL char(N).
#
# EMIT_SQL is shared by emit_rows (the initial stream) AND the --reload-cmd
# script (fzf reloads the list with it after a delete/pin).
EMIT_SQL="WITH palette AS (
      SELECT CHAR(27)||'[0m'                AS reset,
             CHAR(27)||'[38;2;202;211;245m' AS text_color,
             CHAR(27)||'[38;2;225;170;80m'  AS pin_color,
             CHAR(27)||'[38;2;137;180;250m' AS c_text,
             CHAR(27)||'[38;2;225;170;80m'  AS c_rich,
             CHAR(27)||'[38;2;166;209;137m' AS c_image,
             CHAR(27)||'[38;2;148;156;183m' AS c_files,
             CHAR(27)||'[38;2;235;160;172m' AS c_mixed,
             CHAR(27)||'[38;2;180;190;254m' AS c_file,
             CHAR(27)||'[38;2;250;179;135m' AS c_directory,
             CHAR(27)||'[38;2;116;199;236m' AS c_url,
             CHAR(27)||'[38;2;203;166;247m' AS c_origin
    )
    SELECT
      -- Color the kind glyph mauve (c_origin) when the clip was copied on a
      -- DIFFERENT host (source_host <> ours), else by kind — a zero-width
      -- at-a-glance remote cue that keeps the kind glyph intact. (Two CASEs:
      -- color, then glyph.)
      (CASE WHEN ${remote_when}     THEN c_origin
            WHEN type_kind='text'       THEN c_text
            WHEN type_kind IN ('rtf','html') THEN c_rich
            WHEN type_kind='image'      THEN c_image
            WHEN type_kind='files'      THEN c_files
            WHEN type_kind='file'       THEN c_file
            WHEN type_kind='directory'  THEN c_directory
            WHEN type_kind='url'        THEN c_url
            ELSE c_mixed END)
      || (CASE type_kind
           WHEN 'text'      THEN char(1110065)
           WHEN 'rtf'       THEN char(1110524)
           WHEN 'html'      THEN char(1110524)
           WHEN 'image'     THEN char(1110078)
           WHEN 'files'     THEN char(1110139)
           WHEN 'file'      THEN char(983588)
           WHEN 'directory' THEN char(983638)
           WHEN 'url'       THEN char(983865)
           ELSE                  char(988440) END)
      || reset
      || '  '
      || CASE WHEN pinned=1 THEN pin_color ELSE text_color END
      || printf('%-${CW}s', substr(IFNULL(text_preview,'['||type_kind||']'),1,$((CW-1))) || CASE WHEN length(IFNULL(text_preview,'['||type_kind||']')) > $((CW-1)) THEN '…' ELSE '' END)
      || reset
      || CASE WHEN pinned=1 THEN ' ' || pin_color || char(1110157) || reset ELSE '  ' END || ' '
      || CHAR(31) || id || CHAR(30) || 'MD:' || id || CHAR(30) || 'CP:' || id
    FROM clips, palette
    ORDER BY pinned DESC, last_ts DESC
    LIMIT ${PICK_CLIPBOARD_LIMIT:-500};"

emit_rows() {
  [[ -n "$live_row_file" && -f "$live_row_file" ]] && cat "$live_row_file"
  sqlite3 "${PICK_SQLITE_RAW[@]}" "$DB_FILE" "$EMIT_SQL"
}

# --- temp scripts for --key-reload (delete / pin + list refresh) -------------
# fzf's reload runs a FRESH shell, so the action + the re-stream are standalone
# scripts (the zsh functions / vars aren't visible there). The DB path + SQL
# are inlined at write time; \$1 stays literal so the script takes the id from
# fzf's {2}. Cleaned up on exit. Each is a literal mktemp path — this script's
# own temp file.
emit_script=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-emit.XXXXXX")
del_script=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-del.XXXXXX")
pin_script=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-pin.XXXXXX")
trap 'rm -f -- "$emit_script" "$del_script" "$pin_script" "$preview_script" "$live_row_file" "$LIVE_TEXT_FILE"' EXIT INT TERM
cat > "$emit_script" <<EOF
#!/bin/sh
# fzf sets FZF_COLUMNS to the fzf window width for --bind commands (including
# start:reload + the delete/pin reloads), so compute the content width from
# the EXACT pane size: list pane = 55% of FZF_COLUMNS (preview takes 45%),
# minus ~6 (padding + gutter) + 5 (icon + sep + pin) -> CW = fc*55/100 - 11.
fc=\${PTY_FRAME_COLUMNS:-\${FZF_COLUMNS:-80}}
cw=\$((fc * 55 / 100 - 12)); [ \$cw -lt 10 ] && cw=10
echo "[\$(date +%s)] PTY_FRAME_COLUMNS=\${PTY_FRAME_COLUMNS:-?} fc=\$fc cw=\$cw" >> /tmp/pick-clipboard-dims.log
# Synthetic LIVE row (§22): pre-rendered once at open into \$live_row_file; catted
# above the stored rows here so it survives fzf reloads (delete/pin) without a
# re-fetch — the entry reflects the peer clipboard as of picker open (§22.6).
[ -n '$live_row_file' ] && [ -f '$live_row_file' ] && cat '$live_row_file'
sqlite3 -escape off '$DB_FILE' "WITH palette AS (
      SELECT CHAR(27)||'[0m'                AS reset,
             CHAR(27)||'[38;2;202;211;245m' AS text_color,
             CHAR(27)||'[38;2;225;170;80m'  AS pin_color,
             CHAR(27)||'[38;2;137;180;250m' AS c_text,
             CHAR(27)||'[38;2;225;170;80m'  AS c_rich,
             CHAR(27)||'[38;2;166;209;137m' AS c_image,
             CHAR(27)||'[38;2;148;156;183m' AS c_files,
             CHAR(27)||'[38;2;235;160;172m' AS c_mixed,
             CHAR(27)||'[38;2;180;190;254m' AS c_file,
             CHAR(27)||'[38;2;250;179;135m' AS c_directory,
             CHAR(27)||'[38;2;116;199;236m' AS c_url,
             CHAR(27)||'[38;2;203;166;247m' AS c_origin
    )
    SELECT
      (CASE WHEN ${remote_when}     THEN c_origin
            WHEN type_kind='text'       THEN c_text
            WHEN type_kind IN ('rtf','html') THEN c_rich
            WHEN type_kind='image'      THEN c_image
            WHEN type_kind='files'      THEN c_files
            WHEN type_kind='file'       THEN c_file
            WHEN type_kind='directory'  THEN c_directory
            WHEN type_kind='url'        THEN c_url
            ELSE c_mixed END)
      || (CASE type_kind
           WHEN 'text'      THEN char(1110065)
           WHEN 'rtf'       THEN char(1110524)
           WHEN 'html'      THEN char(1110524)
           WHEN 'image'     THEN char(1110078)
           WHEN 'files'     THEN char(1110139)
           WHEN 'file'      THEN char(983588)
           WHEN 'directory' THEN char(983638)
           WHEN 'url'       THEN char(983865)
           ELSE                  char(988440) END)
      || reset
      || '  '
      || CASE WHEN pinned=1 THEN pin_color ELSE text_color END
      || printf('%-\${cw}s', substr(IFNULL(text_preview,'['||type_kind||']'),1,\$((cw-1))) || CASE WHEN length(IFNULL(text_preview,'['||type_kind||']')) > \$((cw-1)) THEN '…' ELSE '' END)
      || reset
      || CASE WHEN pinned=1 THEN ' ' || pin_color || char(1110157) || reset ELSE '  ' END || ' '
      || CHAR(31) || id || CHAR(30) || 'MD:' || id || CHAR(30) || 'CP:' || id
    FROM clips, palette
    ORDER BY pinned DESC, last_ts DESC
    LIMIT ${PICK_CLIPBOARD_LIMIT:-500};"
EOF
cat > "$del_script" <<EOF
#!/bin/sh
# {2} is now "id\x1eMD:id" (fzf's own --delimiter only splits on \x1f, so the
# \x1e-joined markdown marker rides along inside field 2 unsplit) -- strip
# everything from the first RS (\036) byte onward to recover the plain id.
id=\${1%%\$(printf '\036')*}
sqlite3 '$DB_FILE' "DELETE FROM clip_types WHERE clip_id=\$id; DELETE FROM clips WHERE id=\$id;"
EOF
cat > "$pin_script" <<EOF
#!/bin/sh
id=\${1%%\$(printf '\036')*}
sqlite3 '$DB_FILE' "UPDATE clips SET pinned=1-pinned WHERE id=\$id;"
EOF
cat > "$preview_script" <<EOF
#!/bin/sh
# fzf sets FZF_PREVIEW_COLUMNS / FZF_PREVIEW_LINES to the preview pane's exact
# dimensions when running this — use them to fit the footer + bottom-align it.
id=\${1%%\$(printf '\036')*}
pc=\${FZF_PREVIEW_COLUMNS:-40}
ph=\${FZF_PREVIEW_LINES:-20}
lw=14
vw=\$((pc - lw)); [ \$vw -lt 4 ] && vw=4
# LIVE sentinel (§22.3): there is no DB row, so render the full text + footer
# from the fetched peer clipboard (LIVE_TEXT_FILE via readfile). Same layout as
# a stored row; Source/Origin badge the peer host, Copied reads 'live'.
if [ "\$id" = LIVE ]; then
  sqlite3 -escape off '$DB_FILE' "WITH d AS (SELECT CAST(readfile('$LIVE_TEXT_FILE') AS TEXT) AS body) SELECT body || char(10) || replace(printf('%*s', MAX(0, \$ph - (CASE WHEN body IS NULL OR body='' THEN 1 ELSE length(body)-length(replace(body,char(10),''))+1 END) - 6), ' '), ' ', char(10)) || char(27)||'[38;2;127;132;156m' || printf('%-\${lw}s%!\${vw}s' || char(10), 'Source:', substr('—',1,\$vw)) || printf('%-\${lw}s%!\${vw}s' || char(10), 'Content Type:', substr('text',1,\$vw)) || printf('%-\${lw}s%!\${vw}s' || char(10), 'Origin:', substr('remote ('||(CASE WHEN length('$LIVE_HOST')>9 THEN substr('$LIVE_HOST',1,4)||'…'||substr('$LIVE_HOST',-3) ELSE '$LIVE_HOST' END)||')',1,\$vw)) || printf('%-\${lw}s%!\${vw}s' || char(10), 'Characters:', substr(length(body),1,\$vw)) || printf('%-\${lw}s%!\${vw}s' || char(10), 'Words:', substr(CASE WHEN body IS NULL OR body='' THEN 0 ELSE length(trim(replace(body,char(10),' '))) - length(replace(trim(replace(body,char(10),' ')),' ','')) + 1 END,1,\$vw)) || printf('%-\${lw}s%!\${vw}s', 'Copied:', substr('live',1,\$vw)) || char(27)||'[0m' FROM d;"
  exit 0
fi
sqlite3 -escape off '$DB_FILE' "WITH c AS (SELECT COALESCE(text_plain,'['||type_kind||']') AS body, CASE WHEN text_plain IS NULL OR text_plain='' THEN 1 ELSE length(text_plain)-length(replace(text_plain,char(10),''))+1 END AS nlines, COALESCE(IFNULL(source_app,'?'),'?') AS app, COALESCE(type_kind,'text') AS kind, COALESCE(len,0) AS len, (${words_expr}) AS words, (${age_expr})||' ago' AS age, CASE WHEN ${remote_when} THEN 'remote ('||(CASE WHEN length(source_host)>9 THEN substr(source_host,1,4)||'…'||substr(source_host,-3) ELSE source_host END)||')' ELSE 'local' END AS origin_label FROM clips WHERE id=\$id) SELECT body || char(10) || replace(printf('%*s', MAX(0, \$ph - nlines - 6), ' '), ' ', char(10)) || char(27)||'[38;2;127;132;156m' || printf('%-\${lw}s%!\${vw}s' || char(10), 'Source:', substr(app,1,\$vw)) || printf('%-\${lw}s%!\${vw}s' || char(10), 'Content Type:', substr(kind,1,\$vw)) || printf('%-\${lw}s%!\${vw}s' || char(10), 'Origin:', substr(origin_label,1,\$vw)) || printf('%-\${lw}s%!\${vw}s' || char(10), 'Characters:', substr(len,1,\$vw)) || printf('%-\${lw}s%!\${vw}s' || char(10), 'Words:', substr(words,1,\$vw)) || printf('%-\${lw}s%!\${vw}s', 'Copied:', substr(age,1,\$vw)) || char(27)||'[0m' FROM c;"
EOF

# --- run --------------------------------------------------------------------
# PICK_CLIPBOARD_NO_RUN (test-only escape hatch): skip the interactive fzf
# session entirely. A test harness sources this file with it set so it can
# exercise the functions above (e.g. clip::copy_by_id) directly against a
# seeded DB + faked nc/rsync on PATH, without an fzf process ever starting.
if [[ -n "${PICK_CLIPBOARD_NO_RUN:-}" ]]; then
  return 0 2>/dev/null || exit 0
fi

hints="$(pick::hints "󰌑" paste "󰘵 󰌑" markdown "󰘴 O" "keep open" "󰘴 Y" copy "󰘴 D" del "󰘴 P" pin)"

pick_args=(
  --header "Clipboard history"
  --hints "$hints"
  --output field:1                 # Enter -> id (we re-fetch text below)
  --field-id 1                     # id is tail field 1 (for recency + resume)
  --key-output alt-enter:field:2       # accept-and-dismiss with the "MD:id" marker
  --key-output ctrl-y:field:3          # accept-and-dismiss with the "CP:id" marker (copy)
  --key-background ctrl-o:field:1      # insert without dismissing (broker hook)
  --on-key-background clip::bg_hook
  --on-items-picked clip::bump_recency
  --cache-state
  --preview "$PREVIEW_CMD"
  --preview-window "${PICK_CLIPBOARD_PREVIEW_WINDOW:-right:45%,noinfo}"
  --info hidden                    # hide the 1/X item counter (top-right)
  # delete / pin run a SQL action AND reload the list in place (fzf
  # execute-silent + reload). {2} is the 2nd \x1f field, "id\x1eMD:id" --
  # del_script/pin_script strip the \x1e-joined suffix back off. Race-free:
  # the SQL runs synchronously in execute-silent before reload re-streams.
  --reload-cmd "bash $emit_script"
  --start-reload                   # load the list via start:reload so the emit
                                   # script runs with FZF_COLUMNS (exact width)
  --key-reload ctrl-d:"bash $del_script {2}"
  --key-reload alt-d:"bash $del_script {2}"
  --key-reload ctrl-p:"bash $pin_script {2}"
)
[[ -n "${PICK_CLIPBOARD_PADDING:-}" ]] && pick_args+=(--padding "${PICK_CLIPBOARD_PADDING}")
[[ -n "${PICK_CLIPBOARD_HEIGHT:-}" ]]   && pick_args+=(--height "${PICK_CLIPBOARD_HEIGHT}")
[[ -n "${PICK_CLIPBOARD_RESUME:-}" ]] && pick_args+=(--resume)
[[ -n "${PICK_CLIPBOARD_NO_BORDER:-}" ]] && pick_args+=(--no-border)

# pick::start prints one accept marker on stdout: the plain id (Enter), "MD:id"
# (Alt-Enter, markdown), or "CP:id" (Ctrl-Y, copy). We re-fetch by id and print
# the appropriate rendering, which zellij-modal's stdout capture injects into
# the originating pane -- EXCEPT Ctrl-Y, which copies to the clipboard (with the
# register type, so a block clip stays block-pasteable) and prints nothing, so
# nothing is injected. pick::start's --copy-only path is not used here.
selected="$(emit_rows | pick::start "${pick_args[@]}")" || exit 130
case "$selected" in
  # LIVE sentinel (§22.4): deliver the already-fetched peer text, then
  # materialize a self-contained local row. Ctrl-Y (CP:) copies + emits nothing;
  # Enter / Alt-Enter inject the text (no rich-vs-raw distinction in a terminal).
  CP:LIVE) clip::copy_live;    clip::materialize_live ;;
  MD:LIVE) clip::deliver_live; clip::materialize_live ;;
  LIVE)    clip::deliver_live; clip::materialize_live ;;
  CP:*)    clip::copy_by_id "${selected#CP:}" ;;
  MD:*)    clip::markdown_by_id "${selected#MD:}" ;;
  "")      ;;
  *)       clip::text_by_id "$selected" ;;
esac
