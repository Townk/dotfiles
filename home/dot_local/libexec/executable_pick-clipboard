#!/usr/bin/env zsh
# pick-clipboard — fzf picker over the universal clipboard history store.
#
# Backs the universal-clipboard project (spec §7). Streams rows straight from
# the SQLite store at ${XDG_DATA_HOME:-~/.local/share}/pick-clipboard/history.db
# into pick::start — no assembled-lines cache, no jq — ordered
#   pinned DESC, last_ts DESC.
#
# Wire format (the \x1f/\x1e contract from pick-common.zsh):
#   <visible preview>\x1f<id>\x1eMD:<id>
# Field 1 (pick::start field:1) is the plain id, used by Enter/--field-id
# recency. Field 2 is a synthetic "MD:<id>" marker (--key-output can only
# select an existing field, not synthesize a literal), read by Alt-Enter to
# request the markdown-alternate rendering below. Clip content can be
# multi-line, which fzf's line-based entry model can't carry inline, so the
# text is re-fetched from the store by id on every accept / background action
# instead of being embedded in the line.
#
# Keys:
#   Enter        paste the selected clip's text into the originating pane
#                (zellij-modal captures pick-clipboard's stdout, so we print the
#                re-fetched text after pick::start returns the id).
#   Ctrl-O       "sticky" (--key-background): re-fetch + insert WITHOUT
#                dismissing. The GUI picker uses Ctrl-Enter for this, but fzf
#                0.73.1's --bind parser has no "ctrl-enter" key name at all
#                (confirmed: `fzf --bind ctrl-enter:accept` -> "unsupported
#                key: ctrl-enter", exit 2) -- most terminals send identical
#                bytes for Enter and Ctrl-Enter and fzf never implemented the
#                Kitty-protocol disambiguation for it, unlike the other
#                ctrl/alt combos it does support. Ctrl-O is the substitute.
#   Alt-Enter    accept-and-dismiss with the markdown alternate (--key-output
#                field:2): a [label](file://...) link for file/directory
#                clips, [url](url) for url clips, an inline
#                ![](data:image/...;base64,...) for image clips, and plain
#                text_plain (same as Enter) for every other kind -- there's
#                no rich-vs-raw distinction in a terminal.
#   Ctrl-Y       accept-and-dismiss + copy to *my* clipboard, carrying the
#                register type so a block clip stays block-pasteable
#                (clip::copy_by_id). Self-contained (§11): the clip already
#                lives here, so copy is local; when bridge-up it also ships to
#                the machine you're sitting at (image -> clip.set.rich,
#                text -> clip.set with the regtype);
#                iPad -> OSC 52. Emits nothing to the pane (unlike Enter).
#                files/file/directory rows restore a REAL file object onto
#                this Mac's pasteboard instead (files-yazi design §9,
#                clip::copy_files_by_id): a local row does a full-fidelity
#                by-rowid restore, a remote manifest row rsyncs the files down
#                to ~/.cache/pick-clipboard/files/<id>/<idx>/ first and
#                localizes the clip (an already-localized row short-circuits
#                to its on-disk copies); any failure there falls back to the
#                plain-text copy above.
#   Ctrl-D/Alt-D delete the row (SQL DELETE by id), stay open.
#   Ctrl-P       toggle pin, stay open.
#
# No origin filter (spec §11): the picker always shows this machine's whole
# store. `source_host` drives only the per-row local/remote badge, never
# visibility; bridge-up decides only where a Ctrl-Y copy additionally lands.
#
# Accept markers: pick::start emits one of three tail fields on accept, and the
# wrapper below dispatches on the prefix — field:1 plain id (Enter -> inject
# text), field:2 "MD:id" (Alt-Enter -> markdown), field:3 "CP:id" (Ctrl-Y ->
# copy, print nothing). A dedicated accept field is how copy-and-dismiss runs a
# side effect without injecting: the wrapper does the copy instead of printing.

set -eu -o pipefail
zmodload zsh/datetime   # $EPOCHREALTIME for bump-on-use timestamps (matches the dispatcher's op_persist convention)

PICK_NAME=pick-clipboard
PICK_LIB_DIR="${PICK_LIB_DIR:-$HOME/.local/lib}"
source "${PICK_COMMON_LIB:-$PICK_LIB_DIR/pick-common.zsh}" ||
  { print -ru2 -- "pick-clipboard: cannot source pick-common.zsh from $PICK_LIB_DIR"; exit 1; }
source "${PICK_BRIDGE_CLIENT_LIB:-$PICK_LIB_DIR/clipboard-bridge-client.zsh}" ||
  { print -ru2 -- "pick-clipboard: cannot source clipboard-bridge-client.zsh from $PICK_LIB_DIR"; exit 1; }

DB_FILE="${PICK_CLIPBOARD_DB:-${XDG_DATA_HOME:-$HOME/.local/share}/pick-clipboard/history.db}"
CORE_LIB="${PICK_CLIPBOARD_CORE_LIB:-$PICK_LIB_DIR/clipboard-store-core.zsh}"
require_cmd sqlite3
require_cmd pbcopy 2>/dev/null || true   # copy target; optional in odd envs

# Probe the sqlite CLI's -escape support (shared pick::sqlite_raw; the
# generated child scripts below still hardcode `-escape off` — see the
# reload/preview heredocs — so pre-3.46 hosts remain unsupported there).
pick::sqlite_raw

[[ -f "$DB_FILE" ]] || die "clipboard store not found: $DB_FILE
It is created by the Hammerspoon clipboard-history watcher (chezmoi apply)."

# --- bridge-up detection (spec §8) -----------------------------------------
# Bridge-up = we're in an SSH session AND the reverse-forwarded remote clipboard
# is actually reachable on the loopback TCP port. A real connect probe (not a
# "does a socket file exist?" check) — a down/stale tunnel refuses, so we
# degrade cleanly instead of the old "file present but connection refused" trap.
# Under the self-contained model (§11) bridge-up no longer changes WHICH rows
# the picker shows (it's always this machine's whole store); it only decides
# where a Ctrl-Y copy additionally lands (ship to the machine you're sitting at).
BRIDGE_HOST=127.0.0.1
# The probe must name the same endpoint the --peer wrappers dial: the client
# library resolves CLIPBOARD_BRIDGE_PORT (default 2490, the reverse-forwarded
# peer), so mirror that resolution instead of hardcoding the default. This
# machine's own bridge is reached over the trusted Unix socket now — the old
# LOCAL_PORT (2489) plumbing is gone with the opcode wire.
BRIDGE_PORT="${CLIPBOARD_BRIDGE_PORT:-2490}"
bridge_up=0
# Canonical remote-detection triple (== mux::is_remote, mux-bootstrap.zsh);
# inlined here (this file's own lib stack does not pull in that layer). Same
# test recurs below; keep them in sync (all three vars, incl. SSH_TTY).
if [[ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]] &&
   clipbridge::probe "$BRIDGE_HOST" "$BRIDGE_PORT"; then
  bridge_up=1
fi

# --- provenance (spec §11) --------------------------------------------------
# A clip's `source_host` is the hostname where it was originally copied, and is
# the ONLY thing conveying origin: a row is "remote" iff its source_host differs
# from THIS machine's hostname. NULL source_host (legacy rows) reads as local.
# Drives the per-row badge/footer only — never row visibility.
#
# MY_HOST (Phase 7): resolved via clip::self_host (clipboard-store-core.zsh) --
# self-name file first (the wire identity a peer push carries, and what rows
# get STAMPED with -- ephemeral cloud/dev-shell hostnames make `hostname -s`
# an unstable badge key), then scutil, then hostname -s. Same precedence the
# store itself uses (H op / clip::op_get_host), so badges and stamps agree.
#
# Sourced inside a `$(...)` SUBSHELL, deliberately NOT at top level: the core
# sets `setopt nomultibyte` and `export LC_CTYPE=en_US.UTF-8` as file-scope
# side effects (byte-exact wire framing for ITS OWN read_n/be32_to_int/etc,
# none of which this picker uses -- only clip::self_host is wanted here).
# `setopt nomultibyte` forces ${#var}/${var:off} to count BYTES regardless of
# locale -- it would override, not just coexist with, this script's OWN
# `local LC_ALL= LC_CTYPE=en_US.UTF-8` blocks in clip::shorten_path /
# clip::render_file_content / clip::filter_file_rows below, which depend on
# the shell's DEFAULT (multibyte-on) character counting to size the TUI's
# columns -- a bare top-level `source` would leak nomultibyte for the rest of
# this script and silently misalign every accented/wide-glyph path. `$(...)`
# forks a subshell in zsh, so the core's setopt/export/zmodload SHELL-STATE
# side effects all die with it -- only clip::self_host's printed value
# crosses back out via stdout. (One side effect does NOT die with the
# subshell: sourcing the core file-scope-runs `mkdir -p "$STATE_DIR"`,
# a filesystem write that persists past it -- harmless/idempotent, so it
# doesn't change the scoping rationale above, which is about shell
# OPTIONS/exports/modules leaking into the rest of this script.) `|| true`
# + the hostname -s fallback below: under this script's
# `set -eu`, a failed command substitution assigned to a plain scalar would
# otherwise abort the whole picker if clipboard-store-core.zsh were ever
# missing (e.g. a partial install) instead of degrading gracefully.
MY_HOST=$(source "${CLIPBOARD_LIB_DIR:-${0:A:h}/../lib}/clipboard-store-core.zsh" 2>/dev/null && clip::self_host) || true
[[ -n "$MY_HOST" ]] || MY_HOST=$(hostname -s 2>/dev/null)
remote_when="source_host IS NOT NULL AND source_host <> '$MY_HOST'"

# --- live peer clipboard entry (spec §22) -----------------------------------
# When bridge-up (SSH'd in here with the reverse tunnel live), surface the
# CURRENT clipboard of the machine you're sitting at as one synthetic top row,
# fetched live at open time. Viewing != owning (§11): nothing is written to the
# store until the row is accepted (Enter/Ctrl-Y), which materializes it via the
# same store.persist.text nvim `p` uses. Bounded + best-effort: on any failure
# the row is just omitted, never blocking the picker. The probe (bridge_up)
# already succeeded, so the clip.get reads are fast loopback round-trips.
#
# LIVE_TEXT_FILE non-empty => a live entry is available; its bytes are the exact
# peer clipboard text (reused verbatim at accept time — no second fetch). live_row_file
# holds the pre-rendered picker line, emitted at the top by emit_rows/emit_script.
LIVE_TEXT_FILE=""
LIVE_HOST=""
live_row_file=""
if (( bridge_up )); then
  _lt=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-live.XXXXXX")
  if clipbridge::clip_get_raw text > "$_lt" 2>/dev/null && [[ -s "$_lt" ]] &&
     grep -q '[^[:space:]]' "$_lt"; then          # empty/whitespace guard (§22.2)
    LIVE_HOST=$(clipbridge::clip_get_raw host 2>/dev/null)
    [[ -n "$LIVE_HOST" ]] || LIVE_HOST="peer"
    # Dedup (§22.5, revised for §23): suppress the live entry when its text is
    # already in the store — compared trailing-newline-insensitively and
    # regardless of source_host. Two reasons the old (peerhost, type_hash) key
    # misses: (1) a trailing newline is not identity — the old G op even
    # stripped it outright, so a stored copy and its live twin can differ by
    # exactly that byte; (2) a remote copy (§23) now stores the clip LOCALLY
    # (source_host = this host, not the peer). rtrim(char(10)) on both sides
    # drops the newline difference; no source_host filter covers any origin;
    # readfile keeps the compare byte-safe for arbitrary text.
    if [[ -z "$(sqlite3 "$DB_FILE" "SELECT 1 FROM clips WHERE rtrim(text_plain, char(10)) = rtrim(CAST(readfile('$_lt') AS TEXT), char(10)) LIMIT 1;" 2>/dev/null)" ]]; then
      LIVE_TEXT_FILE="$_lt"
    fi
  fi
  [[ -n "$LIVE_TEXT_FILE" ]] || rm -f "$_lt"
fi

# X9: the live row must sort chronologically by when the PEER's clipboard was
# actually copied, not always float to the top. One more fast loopback round-
# trip (clip.get's timestamp field) for the copy-time -- best-effort: on any
# failure (bridge dropped between the text/host reads above and now, a
# non-numeric reply, ...) fall back to
# "now", which sorts the row at/near the top exactly like the old always-
# pinned-to-top behavior, so a lookup failure never loses the row or
# misplaces it below fresh local rows. live_ts_threshold feeds the ABOVE/
# BELOW split in EMIT_SQL below; -1 (older than any real last_ts) when there
# is no live row at all, so that split degrades to "everything in ABOVE,
# nothing in BELOW" -- the plain original ordering.
LIVE_TS=""
live_ts_threshold=-1
if [[ -n "$LIVE_TEXT_FILE" ]]; then
  LIVE_TS="$(clipbridge::clip_get_raw timestamp 2>/dev/null)"
  [[ "$LIVE_TS" =~ ^[0-9]+(\.[0-9]+)?$ ]] || LIVE_TS=$EPOCHREALTIME
  live_ts_threshold=$LIVE_TS
fi

# X9 shared row budget: the live row split (ABOVE + live + BELOW) must emit no
# MORE rows than PICK_CLIPBOARD_LIMIT in total -- pre-X9 it was a single query
# with one global LIMIT, and naively giving BOTH halves the full limit would
# roughly DOUBLE the cap (the watcher retains up to 1000 rows). The live row
# occupies one slot in that budget, so reserve it up front: ABOVE is capped at
# (limit - live), then BELOW gets whatever ABOVE's ACTUAL returned row count
# and the live row leave. LIVE_COUNT is 0 when there's no live row, so the
# whole thing degrades to a single LIMIT-capped ABOVE query (BELOW's WHERE
# matches nothing at threshold -1) -- the exact pre-X9 ordering + cap.
PICK_LIMIT=${PICK_CLIPBOARD_LIMIT:-500}
LIVE_COUNT=0
[[ -n "$LIVE_TEXT_FILE" ]] && LIVE_COUNT=1
ABOVE_LIMIT=$(( PICK_LIMIT - LIVE_COUNT ))
(( ABOVE_LIMIT < 0 )) && ABOVE_LIMIT=0

# --- helpers (run in THIS process via the --key-background FIFO broker) ------
clip::text_by_id() {  # id -> text_plain (raw, multi-line)
  sqlite3 "${PICK_SQLITE_RAW[@]}" "$DB_FILE" "SELECT text_plain FROM clips WHERE id=$1;"
}

clip::delete_by_id() {
  sqlite3 "$DB_FILE" "DELETE FROM clip_types WHERE clip_id=$1; DELETE FROM clips WHERE id=$1;"
}

clip::toggle_pin_by_id() {
  sqlite3 "$DB_FILE" "UPDATE clips SET pinned = 1 - pinned WHERE id=$1;"
}

# Bump-on-use (spec R5c): re-bump the ORIGINAL row's last_ts after a
# successful files restore, so the entry the user just acted on floats back
# to the top of both pickers -- the same "recency = last used" contract
# --on-items-picked already gives text rows (clip::bump_recency), which a
# files restore never runs through since it exits via the CP:/copy path, not
# an accepted item. $EPOCHREALTIME (needs zsh/datetime, loaded above) matches
# the dispatcher's op_persist timestamp convention; best-effort, never fails
# the restore it's piggybacking on.
clip::bump_last_ts_now() {
  sqlite3 "$DB_FILE" "UPDATE clips SET last_ts=$EPOCHREALTIME WHERE id=$1;" 2>/dev/null || true
}

# Build the text_preview for a localized bookkeeping row (spec R5b): the
# newline-joined LOCALIZED paths, approximating the ~100-char budget +
# "first paths that fit, else first path truncated, then '… +K more'" shape
# clipboard-history.lua's files_preview() uses for a genuine multi-file
# capture -- close enough that a localized row no longer shows as an
# anonymous blank entry in either picker, without porting that function
# byte-for-byte.
clip::localized_preview() {
  local -a paths=("$@")
  (( ${#paths[@]} )) || { print -r -- "[files]"; return }
  local joined="${(F)paths}"
  if (( ${#joined} <= 100 )); then
    print -r -- "$joined"
    return
  fi
  local -a out
  local -i len=0 shown=0 total=${#paths[@]}
  local p
  for p in "${paths[@]}"; do
    local -i candidate=$(( len + ${#p} + (shown > 0 ? 1 : 0) ))
    (( candidate > 100 )) && break
    out+=("$p"); len=$candidate; (( shown += 1 ))
  done
  if (( shown == 0 )); then
    print -r -- "${paths[1][1,99]}…"$'\n'"… +$(( total - 1 )) more"
    return
  fi
  local -i remaining=$(( total - shown ))
  if (( remaining > 0 )); then
    print -r -- "${(F)out}"$'\n'"… +$remaining more"
  else
    print -r -- "${(F)out}"
  fi
}

# Ship an image clip's blob to the remote via the reverse channel
# (clip.set.rich). Tries each image UTI in turn (same set/order as
# clip::markdown_image); the first with a stored blob is sent — the uti rides
# as a field, the blob bytes ride stdin, so no framing survives here. Returns
# 0 on a success reply. Byte-safe: the blob is staged in a temp file (sqlite's
# writefile), never a $(...) capture.
clip::ship_image_by_id() {
  emulate -L zsh
  setopt nomultibyte
  local id=$1 uti blobf
  local -a utis=(public.png public.jpeg public.tiff com.compuserve.gif)
  for uti in "${utis[@]}"; do
    blobf=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-ship.XXXXXX") || return 1
    sqlite3 "$DB_FILE" "SELECT writefile('$blobf', blob) FROM clip_types WHERE clip_id=$id AND uti='$uti';" >/dev/null 2>&1
    if [[ -s "$blobf" ]]; then
      if clipbridge::ship_rich "$uti" < "$blobf"; then rm -f "$blobf"; return 0; fi
      rm -f "$blobf"
      return 1
    fi
    rm -f "$blobf"
  done
  return 1
}

# Set a clipboard to a clip via clip.set (regtype + exact text), so the
# register type is RECORDED alongside — a later nvim paste can then block-paste
# it. <target> picks the endpoint: `peer` (the machine you're sitting at, over
# the reverse tunnel — clipbridge::set_text) or `local` (this machine's own
# bridge, over the trusted socket — the old LOCAL_PORT TCP hop is gone).
# text_plain is written via writefile so no sqlite trailing newline sneaks in
# (an extra line would corrupt a block clip), and the bytes ride stdin so any
# byte survives. Returns 0 on a success reply.
clip::set_via_bridge() {
  local target=$1 id=$2 rt txtf
  rt=$(sqlite3 "$DB_FILE" "SELECT IFNULL(regtype,'v') FROM clips WHERE id=$id;" 2>/dev/null) || rt=v
  [[ "$rt" == (v|l|b) ]] || rt=v
  txtf=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-set.XXXXXX") || return 1
  sqlite3 "$DB_FILE" "SELECT writefile('$txtf', text_plain) FROM clips WHERE id=$id;" >/dev/null 2>&1
  if [[ "$target" == peer ]]; then
    if clipbridge::set_text "$rt" < "$txtf"; then rm -f "$txtf"; return 0; fi
  else
    if clipbridge::set_text_local "$rt" < "$txtf"; then rm -f "$txtf"; return 0; fi
  fi
  rm -f "$txtf"; return 1
}

# clip::send_file_urls <path>... -- clip.set.files{paths} (NUL-joined absolute
# paths on stdin) to this Mac's own bridge over the trusted socket; the paths
# form is what generates the NSFilenamesPboardType/public.file-url Finder
# needs. Shared by the localized-row guard and the post-pull send in
# clip::copy_files_by_id. Returns 0 on a success reply.
clip::send_file_urls() {
  local first=1 lp
  {
    for lp in "$@"; do
      if (( first )); then print -rn -- "$lp"; first=0
      else print -rn -- $'\0'"$lp"; fi
    done
  } | clipbridge::set_files_paths
}

# Restore a files/file/directory row's real file object onto THIS Mac's
# pasteboard (Ctrl-Y, files-yazi design §9/§12; M2 scope -- the picker runs on
# the Mac, so a files restore ALWAYS targets this machine's own bridge over
# the trusted socket, regardless of bridge_up/SSH: Finder only reads a real
# file-url on the machine it's running on). Returns 1 on any failure so the
# caller (clip::copy_by_id) falls back to the existing text behavior; a reason
# goes to stderr. Four cases, in dispatch order:
#
#   1. source_host is this host (or NULL/legacy) -- a genuine local capture
#      with real NSFilenamesPboardType/public.file-url blobs:
#      clip.set.files{clip_id}, a full-fidelity by-rowid restore. EXCEPTION
#      (X2-redo): a self-origin row whose ONLY recorded blob is
#      x-file-manifest (an M-persisted row -- pbcopy over SSH writing
#      directly to this machine's own store, since the watcher can't capture
#      a locked/headless origin's pasteboard) has no NSFilenamesPboardType/
#      public.file-url to restore by rowid -- it takes the paths form with
#      the manifest's own paths instead, same wire shape as case 2 below
#      minus the cache-root check (already guaranteed local by
#      source_host==self).
#   2. remote origin, but every recorded path (x-file-manifest, else
#      x-resolved-path) lives under the picker's own cache root
#      ~/.cache/pick-clipboard/files/ AND exists on disk:
#      clip.set.files{paths} with those paths directly. This is the row
#      shape the picker itself creates when it localizes a pull (below) --
#      single-path rows carry only a synthetic x-resolved-path (a by-rowid
#      restore would write the blob under that literal UTI: nothing
#      pasteable), multi-path rows carry an
#      x-file-manifest of LOCAL paths (the rsync branch would try to pull
#      them from the origin, which never had them). The check handles both
#      shapes without caring which UTI the paths came from. The cache-root
#      restriction is load-bearing: localization records paths exclusively
#      under the cache root, so a remote manifest naming a path that happens
#      to exist on this Mac too (the Mac-to-Mac mirror case --
#      /Users/<me>/doc.txt on both machines) still takes the pull branch
#      instead of silently pasting a possibly-stale local twin.
#   3. remote origin, not a case-2 row: the spec §12 pull -- rsync each
#      x-file-manifest path down into its own per-position subdir
#      ~/.cache/pick-clipboard/files/<id>/<idx>/ (the <idx> namespace keeps
#      two manifest entries that share a basename from colliding on one
#      flat cache path, which would silently drop a file), skipping any
#      position already cached from an earlier pull of this SAME row. Then
#      record the localized clip as a new local row (mirrors op_persist:
#      source_host stays the ORIGIN host, so the new row still badges remote
#      even though its bytes are now local; best-effort -- a bookkeeping
#      failure does not block the paste; SKIPPED entirely when nothing was
#      actually pulled, i.e. every position was already cached -- these rows
#      have no type_hash, so a re-pick would otherwise pile up an identical
#      row every time) and clip.set.files{paths} the localized paths.
#   4. remote origin, only an x-resolved-path whose file is gone (a stale
#      localized row after a cache sweep): fail honestly -- the origin never
#      had the cache path, so there is nothing to re-pull from.
#
# rsync is pinned to /opt/homebrew/bin/rsync exactly like pbpaste's tier 2
# (stock /usr/bin/rsync is openrsync, which lacks --info=progress2).
# PICK_CLIPBOARD_RSYNC is a TEST-ONLY override: an absolute-path invocation
# can't be shadowed via PATH, so the shellspec suite injects its fake rsync
# through this env var instead. Never set it in production.
#
# W2: every failure exit below goes through clip::restore_fail instead of a
# bare `print -ru2`, so the SAME one-line reason that always went to stderr
# (wire format unchanged -- tests still match on it) is ALSO stashed in
# CLIP_RESTORE_FAILURE. The interactive tail of this script (after the
# accept-dispatch case, once fzf has already exited) reads that global to
# decide whether to hold the picker's floating pane open long enough to show
# it -- the printed-then-vanished-with-the-pane bug validated live twice.
# Headless (--restore-id) also runs through here and sets the global, but
# never looks at it: that branch exits immediately, before this file's
# interactive tail is reached at all.
CLIP_RESTORE_FAILURE=""
clip::restore_fail() {
  local msg="pick-clipboard: $1"
  print -ru2 -- "$msg"
  CLIP_RESTORE_FAILURE="$msg"
}

# Set when clip::copy_by_id's plain-text fallback SUCCEEDED after a captured
# files-restore failure. By the time the hold screen shows, the clip's path
# text is usually already on the clipboard (the fallback ran between the
# failure and the hold), so an error-only screen misreads as "nothing was
# copied at all" -- the hold appends a note line when this is set. Gated on a
# failure actually being captured: an ordinary text-row copy (no files
# branch, no failure) never sets it, so the note can never appear without
# its error.
CLIP_RESTORE_FALLBACK_OK=""
clip::note_fallback_ok() {
  [[ -n "$CLIP_RESTORE_FAILURE" ]] && CLIP_RESTORE_FALLBACK_OK=1
  return 0
}

# --- copy-confirmation toast (copy-feedback design §6) -----------------------
# Every Ctrl-Y copy ends in a toast -- silence is indistinguishable from
# failure once the other paths have feedback. Two variants, one sound:
# remote rows say WHERE the clip came from (icon carries the WHAT), local
# rows acknowledge the re-copy + bump. Pure mapping (no I/O) so the
# shellspec suite can table-test variant selection directly; the GUI
# picker's in-process restores implement this same table in Lua
# (clipboard-picker.lua copy_toast) -- keep the two in sync.
clip::toast_spec() {
  local kind=$1 host=$2 us=$'\x1f'
  if [[ -z "$host" || "$host" == "$MY_HOST" ]]; then
    print -rn -- "glyph:fa-clipboard-list${us}Clipboard moved to top"
    return 0
  fi
  local icon
  case "$kind" in
    image)     icon="glyph:nf-md-image" ;;
    file)      icon="glyph:nf-md-file" ;;
    directory) icon="glyph:nf-md-folder" ;;
    files)     icon="glyph:nf-md-file_multiple" ;;
    *)         icon="glyph:nf-md-text_box" ;;
  esac
  print -rn -- "${icon}${us}Copied from ${host}"
}

# Fire the standard notify OSD for a completed Ctrl-Y copy. Best-effort by
# design: no notify front-end on this box (Linux dev-shell, Hammerspoon
# down) -> silent no-op, the copy itself already succeeded.
# PICK_CLIPBOARD_NOTIFY is the test override, same convention as
# PICK_CLIPBOARD_RSYNC.
clip::copy_toast() {
  local kind=$1 host=$2
  local notify_bin="${PICK_CLIPBOARD_NOTIFY:-$HOME/.local/bin/notify}"
  [[ -x "$notify_bin" ]] || return 0
  local spec; spec=$(clip::toast_spec "$kind" "$host")
  local icon="${spec%%$'\x1f'*}" msg="${spec#*$'\x1f'}"
  "$notify_bin" --icon "$icon" --sound Frog "$msg" >/dev/null 2>&1 || true
  return 0
}

# id -> toast, reading kind + origin host from the store. The ORIGINAL row's
# source_host is the origin even when case 3 just wrote a localized
# bookkeeping twin (the twin keeps source_host = origin too, files-yazi
# design §12), so querying by the picked id always names the right machine.
clip::copy_toast_for_id() {
  local id=$1 kind host
  kind=$(sqlite3 "$DB_FILE" "SELECT IFNULL(type_kind,'text') FROM clips WHERE id=$id;" 2>/dev/null) || kind=text
  host=$(sqlite3 "$DB_FILE" "SELECT IFNULL(source_host,'') FROM clips WHERE id=$id;" 2>/dev/null) || host=""
  clip::copy_toast "$kind" "$host"
}

# Success epilogue for clip::copy_by_id's non-files branches: the existing
# fallback bookkeeping, plus the §6 toast -- but ONLY on a clean copy. When
# a files restore already failed and this is the path-text fallback, the W2
# hold screen owns the messaging; a cheery "Copied from X" over it would
# misreport what happened.
clip::copy_ok() {
  local id=$1
  clip::note_fallback_ok
  [[ -z "$CLIP_RESTORE_FAILURE" ]] && clip::copy_toast_for_id "$id"
  return 0
}

# --- materialization progress (copy-feedback design §4.2) --------------------
# Pure aggregate over an N-path manifest: completed whole paths + the
# running rsync's own whole-invocation percent (--info=progress2 reports
# recursive-total percent, so per-path progress is already whole-transfer).
clip::progress_pct() {
  local -i completed=$1 total=$2 cur=$3
  (( total > 0 )) || { print -rn -- 0; return 0 }
  print -rn -- $(( (completed * 100 + cur) / total ))
}

# Pure label composition (§4.2a): the human line the capsule renders.
# Single path names the file; multi names the count. The GUI/TUI never
# compose this themselves -- one brain.
clip::progress_label() {
  local -i total=$1
  local host=$2 first=$3
  if (( total > 1 )); then
    print -rn -- "Copying ${total} files from ${host}…"
  else
    print -rn -- "Copying ${first:t} from ${host}…"
  fi
}

# Pure throttle decision: prints "1" to emit, nothing to skip. All inputs
# as args (EPOCHREALTIME-style float seconds; integer percents) so the spec
# suite can table-test every rule without sleeping:
#   - 500ms grace from transfer start (tiny/cached pulls never flash a HUD)
#   - then: >=1 point delta AND >=300ms since the last emit
#   - keep-alive: >=1.5s of silence emits regardless of delta, so a slow
#     link can't look like a dead widget
clip::progress_decide() {
  local now=$1 start=$2 last_emit=$3
  local -i last_pct=$4 pct=$5
  (( now - start >= 0.5 )) || return 0
  if (( now - last_emit >= 1.5 )); then
    print -rn -- 1
    return 0
  fi
  if (( pct - last_pct >= 1 && now - last_emit >= 0.3 )); then
    print -rn -- 1
  fi
  return 0
}

# Headless-sink state + IPC. clip::progress_begin resets it per
# materialization; clip::progress_stream is the pipeline sink rsync's
# stdout feeds (runs in the CURRENT shell -- zsh executes the last pipeline
# segment in-process -- so the CLIP_PROGRESS_* globals genuinely carry
# across manifest paths). Every hs call is best-effort: an OSD hiccup must
# never fail a pull. PICK_CLIPBOARD_HS is the test override.
clip::progress_begin() {
  CLIP_PROGRESS_START=$EPOCHREALTIME
  CLIP_PROGRESS_LAST_EMIT=$CLIP_PROGRESS_START
  CLIP_PROGRESS_LAST_PCT=-100
  CLIP_PROGRESS_SHOWN=""
  CLIP_PROGRESS_EMIT_PID=""
  CLIP_PROGRESS_HS="${PICK_CLIPBOARD_HS:-hs}"
  command -v "$CLIP_PROGRESS_HS" >/dev/null 2>&1 || CLIP_PROGRESS_HS=""
  CLIP_PROGRESS_STALLED=0
  CLIP_PROGRESS_STALL_SECS="${PICK_CLIPBOARD_STALL_SECS:-2}"
  # zselect gives the stream sink a read timeout (stall detection, §4.3);
  # without the module (minimal zsh build) reads stay blocking -- the
  # pre-stall-indicator behavior, degraded but functional.
  CLIP_PROGRESS_ZSELECT=0
  zmodload zsh/zselect 2>/dev/null && CLIP_PROGRESS_ZSELECT=1
}

clip::progress_emit() {  # <pct> <label> [stalled]
  [[ -n "${CLIP_PROGRESS_HS:-}" ]] || return 0
  local stall_arg=""
  if [[ "${3:-}" == preparing ]]; then
    stall_arg=', "preparing"'
  elif [[ -n "${3:-}" ]]; then
    stall_arg=", true"
  fi
  # Lua-string escaping (§4.2a): backslash first, then double quote; CR/LF
  # in a filename would break the -c one-liner -> spaces.
  local label=$2
  label="${label//$'\r'/ }"
  label="${label//$'\n'/ }"
  label="${label//\\/\\\\}"
  label="${label//\"/\\\"}"
  # §4.2b: NEVER wait on presentation IPC -- a hung hs -c (captured live:
  # one stalled-repaint emit stuck for many seconds inside the hs.task
  # child context) must cost one tick, not the transfer. Supervised
  # fire-and-forget: at most one emitter in flight; a still-running
  # predecessor carries an obsolete frame, so kill it before spawning the
  # replacement -- which also makes out-of-order repaints impossible.
  if [[ -n "${CLIP_PROGRESS_EMIT_PID:-}" ]] && kill -0 "$CLIP_PROGRESS_EMIT_PID" 2>/dev/null; then
    kill -TERM "$CLIP_PROGRESS_EMIT_PID" 2>/dev/null || true
  fi
  # ( exec ... ) & : $! is the hs process itself, so the kill above always
  # hits the real client, never a wrapper shell.
  # Sanctioned deviation (empirically found, not in the design doc): a
  # detached spawn must not inherit ANY open descriptor from its caller.
  # In particular, stdin is rsync's progress pipe here: the real hs CLI
  # reads from stdin and was stealing most progress records from the sink
  # (a fake hs that ignored stdin rendered a smooth 0→99 trace). Redirect it
  # from /dev/null; stdout/stderr are discarded below. Under the
  # shellspec harness this shell's own multi-process pipe fds (3, 5, 9...)
  # survive exec unless closed -- confirmed via lsof: a stalled `hs` grand-
  # child (e.g. this file's own test fake) held one of those pipes open,
  # which blocked shellspec's OWN executor in read() waiting for an EOF
  # that could never arrive while the fake slept. Closing 3-9 covers every
  # fd actually observed leaking. Single digits only: this build's zsh
  # mis-parses a two-digit `exec N>&-` target as a bare command ("command
  # not found: 10"), fatal even under `|| true` -- verified with a
  # standalone `zsh -f -c 'exec 10>&-'` repro.
  # -q disables hs.ipc's console mirroring. Hammerspoon 1.1.1 has an upstream
  # recursion bug in that mirror: an unrelated print while a CLI request is
  # active can cascade hundreds of "already recursing" warnings, and laying
  # them out in the HS Console blocks its main thread/event taps (captured live
  # as pulsed keyboard and click stalls, worst during frequent live repaints).
  ( for _fd in {3..9}; do eval "exec $_fd>&-" 2>/dev/null || true; done
    exec "$CLIP_PROGRESS_HS" -q -c "require(\"osd\").progress(\"glyph:nf-md-download\", $1, \"${label}\"${stall_arg})" ) </dev/null >/dev/null 2>&1 &
  CLIP_PROGRESS_EMIT_PID=$!
  CLIP_PROGRESS_SHOWN=1
  return 0
}

clip::progress_stream() {  # <completed-paths> <total-paths> <label>
  local -i completed=$1 total=$2
  local label=$3 chunk now
  local -i agg rc stall_cs
  # No hs to drive: drain stdin so rsync never blocks on a full pipe.
  [[ -n "${CLIP_PROGRESS_HS:-}" ]] || { cat >/dev/null; return 0 }
  # progress2 redraws its meter with bare CRs -- and it redraws
  # CONTINUOUSLY while bytes flow, so meter silence IS the stall signal
  # (§4.3). zselect-timed reads turn each quiet window into a stalled
  # repaint: capsule stays visible (hiding must mean done/dead, never
  # waiting) and the Lua watchdog stays fed, leaving it to fire only for a
  # genuinely dead driver. EOF makes the fd readable, so a closed pipe
  # always exits through the read failure below, never a stall loop.
  stall_cs=$(( CLIP_PROGRESS_STALL_SECS * 100 ))
  while true; do
    if (( CLIP_PROGRESS_ZSELECT )) && ! zselect -t $stall_cs -r 0; then
      # Quiet window: repaint the last known percent as stalled (-100
      # start value clamps to 0 -- a stall before any data still shows a
      # capsule, at 0%). Refreshing LAST_EMIT here means only the STALLED
      # flag below can let the resume chunk through the throttle.
      if (( CLIP_PROGRESS_LAST_PCT < 0 )); then
        # Connection/setup before rsync's first progress record is not a
        # transfer stall. Keep it bright and label it honestly; Lua renders
        # the preparing state with the hourglass but without stall dimming.
        clip::progress_emit 0 "Preparing to copy ${label#Copying }" preparing
      else
        clip::progress_emit "$CLIP_PROGRESS_LAST_PCT" "$label" stalled
      fi
      CLIP_PROGRESS_STALLED=1
      CLIP_PROGRESS_LAST_EMIT=$EPOCHREALTIME
      continue
    fi
    # `read ...; rc=$?` (two bare statements) would trip this script's own
    # `set -e`: the read failing on EOF is a plain statement, not part of an
    # if/while condition or an && / || list ending in something else, so
    # errexit fires on it BEFORE `rc=$?` ever runs -- verified empirically
    # (a minimal `set -e; false; echo done` never reaches the echo either).
    # `read ... || rc=$?` puts read on the non-final side of an || list,
    # which IS exempt, and still captures its status the moment it fails.
    rc=0
    IFS= read -r -d $'\r' chunk || rc=$?
    (( rc )) && [[ -z "$chunk" ]] && break
    if [[ "$chunk" =~ '([0-9]+)%' ]]; then
      agg=$(clip::progress_pct "$completed" "$total" "$match[1]")
      (( agg < CLIP_PROGRESS_LAST_PCT )) && agg=$CLIP_PROGRESS_LAST_PCT
      now=$EPOCHREALTIME
      if (( CLIP_PROGRESS_STALLED )); then
        # Resume after a stall: bypass the throttle so the capsule snaps
        # back to the live look on the very first data chunk (§4.3).
        clip::progress_emit "$agg" "$label"
        CLIP_PROGRESS_STALLED=0
        CLIP_PROGRESS_LAST_EMIT=$now
        CLIP_PROGRESS_LAST_PCT=$agg
      elif [[ -n "$(clip::progress_decide "$now" "$CLIP_PROGRESS_START" "$CLIP_PROGRESS_LAST_EMIT" "$CLIP_PROGRESS_LAST_PCT" "$agg")" ]]; then
        clip::progress_emit "$agg" "$label"
        CLIP_PROGRESS_LAST_EMIT=$now
        CLIP_PROGRESS_LAST_PCT=$agg
      fi
    fi
    (( rc )) && break
  done
  return 0
}

# Teardown (§4.2): every exit path of a headless pull hides the HUD before
# any toast or failure surfaces. §4.2b: kill the outstanding emitter FIRST
# (a straggler landing after the hide would repaint a dead capsule until
# the watchdog), then spawn the hide fire-and-forget -- if the hide itself
# hangs, the 15s watchdog is the backstop.
clip::progress_end() {
  if [[ -n "${CLIP_PROGRESS_EMIT_PID:-}" ]] && kill -0 "$CLIP_PROGRESS_EMIT_PID" 2>/dev/null; then
    # Sanctioned deviation (empirically found, not in the design doc): a
    # straggler killed in the SAME instant it was forked can lose the
    # exec-vs-kill race outright -- SIGTERM lands before the child ever
    # reaches its `-c` payload write, not just before its sleep. 30ms is a
    # fixed grace (never waits ON the hs process -- it fires whether or
    # not hs is alive, so it can never itself hang) that gives the OS one
    # scheduling quantum to actually run the just-spawned emitter before
    # it gets torn down. Gated on a live predecessor: the common cache-hit
    # / no-progress-ever-shown teardown path must not pay this tax.
    sleep 0.03
    kill -TERM "$CLIP_PROGRESS_EMIT_PID" 2>/dev/null || true
  fi
  CLIP_PROGRESS_EMIT_PID=""
  [[ -n "${CLIP_PROGRESS_SHOWN:-}" && -n "${CLIP_PROGRESS_HS:-}" ]] || return 0
  # fd-closing loop: see clip::progress_emit -- same detached-spawn hygiene.
  ( for _fd in {3..9}; do eval "exec $_fd>&-" 2>/dev/null || true; done
    exec "$CLIP_PROGRESS_HS" -q -c 'require("osd").progressHide()' ) </dev/null >/dev/null 2>&1 &
  CLIP_PROGRESS_SHOWN=""
  return 0
}

# Staged file materializations are disposable, but not immortal. Sweep only
# the exact numeric <clip-id>/<position> directories owned by this picker;
# the strict shape check is the deletion boundary. Both completed and partial
# copies use the same user-selected 24-hour retention. PICK_CLIPBOARD_CACHE_TTL
# is a seconds override for deterministic tests.
clip::cache_remove_sub() {  # <cache-root> <subdir>
  local root=$1 sub=$2
  [[ -n "$root" && "$root" != / ]] || return 1
  [[ "${sub:h:h}" == "$root" && "${sub:h:t}" == <-> && "${sub:t}" == <-> ]] || return 1
  rm -rf -- "$sub"
}

clip::cache_remove_meta_sub() {  # <cache-root> <root/id/.partial-data/index>
  local root=$1 sub=$2
  [[ -n "$root" && "$root" != / ]] || return 1
  [[ "${sub:h:h:h}" == "$root" && "${sub:h:h:t}" == <-> &&
     "${sub:h:t}" == .partial-data && "${sub:t}" == <-> ]] || return 1
  rm -rf -- "$sub"
}

clip::cache_sweep() {
  local root="${PICK_CLIPBOARD_CACHE_ROOT:-$HOME/.cache/pick-clipboard/files}"
  local ttl_raw="${PICK_CLIPBOARD_CACHE_TTL:-86400}"
  [[ "$ttl_raw" == <-> ]] || ttl_raw=86400
  local -i ttl=$ttl_raw
  [[ -d "$root" && "$root" != / ]] || return 0
  (( ttl > 0 )) || return 0
  zmodload zsh/stat 2>/dev/null || return 0

  local sub iddir mt esub
  for sub in "$root"/<->/<->(N/); do
    mt=$(zstat +mtime "$sub" 2>/dev/null) || continue
    (( EPOCHSECONDS - mt >= ttl )) || continue

    # Localized bookkeeping rows point at staged paths. Remove those rows
    # with the expired bytes so the picker never offers an un-restorable
    # cache entry; the original remote-manifest row remains available.
    esub="${sub//\'/\'\'}"
    sqlite3 "$DB_FILE" "
      DELETE FROM clips WHERE id IN (
        SELECT clip_id FROM clip_types
        WHERE instr(blob, CAST('$esub/' AS BLOB)) > 0
      );
      DELETE FROM clip_types
      WHERE instr(blob, CAST('$esub/' AS BLOB)) > 0;
    " >/dev/null 2>&1 || true
    iddir=${sub:h}
    rm -f -- "$iddir/.authorized/${sub:t}" 2>/dev/null || true
    rm -f -- "$iddir/.partial/${sub:t}" 2>/dev/null || true
    clip::cache_remove_meta_sub "$root" "$iddir/.partial-data/${sub:t}" || true
    rmdir -- "$iddir/.authorized" 2>/dev/null || true
    rmdir -- "$iddir/.partial" "$iddir/.partial-data" 2>/dev/null || true
    clip::cache_remove_sub "$root" "$sub" || true
  done
  for iddir in "$root"/<->(N/); do
    rmdir -- "$iddir" 2>/dev/null || true
  done
}

# Cancellation (§4.4): the INT/TERM trap handler for the case-3 pull loop.
# INT is the TUI's Ctrl+C; TERM is the GUI capsule's ✕. A cancel is NOT a
# failure -- no restore_fail, no W2 hold, no persistent notification: clean
# up presentation, retain the resumable partial for 24 hours, confirm quietly
# (no sound), and exit 130 -- the cancel contract clipboard-picker.lua keys off.
# if-form throughout, never `[[ ... ]] && cmd`: this runs under the
# script's set -e, where a false left-hand test as a statement's final
# status would errexit the handler before `exit 130` ever runs.
clip::pull_cancelled() {
  if [[ -n "${CLIP_PULL_SUB:-}" ]]; then
    [[ -n "${CLIP_PULL_MARKER:-}" ]] && {
      mkdir -p "${CLIP_PULL_MARKER:h}" 2>/dev/null || true
      touch "$CLIP_PULL_MARKER" 2>/dev/null || true
    }
    touch "$CLIP_PULL_SUB" 2>/dev/null || true
  fi
  clip::progress_end
  local notify_bin="${PICK_CLIPBOARD_NOTIFY:-$HOME/.local/bin/notify}"
  if [[ -x "$notify_bin" ]]; then
    "$notify_bin" --icon "glyph:nf-md-close" "Transfer cancelled" >/dev/null 2>&1 || true
  fi
  exit 130
}

clip::copy_files_by_id() {
  local id=$1
  clip::cache_sweep
  local host; host=$(sqlite3 "$DB_FILE" "SELECT IFNULL(source_host,'') FROM clips WHERE id=$id;" 2>/dev/null) || host=""

  # Recorded paths: x-file-manifest first (multi-path), else x-resolved-path
  # (single-path). srcuti remembers which one so case 3 vs 4 can differ.
  local blobtmp; blobtmp=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-cpfiles-blob.XXXXXX") || {
    clip::restore_fail "mktemp failed"; return 1
  }
  local srcuti=""
  sqlite3 "$DB_FILE" "SELECT writefile('$blobtmp', blob) FROM clip_types WHERE clip_id=$id AND uti='x-file-manifest';" >/dev/null 2>&1
  if [[ -s "$blobtmp" ]]; then
    srcuti="x-file-manifest"
  else
    sqlite3 "$DB_FILE" "SELECT writefile('$blobtmp', blob) FROM clip_types WHERE clip_id=$id AND uti='x-resolved-path';" >/dev/null 2>&1
    [[ -s "$blobtmp" ]] && srcuti="x-resolved-path"
  fi
  local -a rpaths
  if [[ -n "$srcuti" ]]; then
    local blob; blob="$(<"$blobtmp")"
    rpaths=("${(@ps:\0:)blob}")
  fi
  rm -f "$blobtmp"

  # Case 1: genuine local capture -> full-fidelity by-rowid restore. EXCEPT when
  # the only recorded blob is an x-file-manifest (X2-redo: an M-persisted
  # row -- pbcopy over SSH writing directly into THIS machine's own store,
  # bypassing the Hammerspoon watcher entirely, since the origin is
  # typically locked/headless over SSH and the watcher's loginwindow guard
  # then skips all capture). A genuine Hammerspoon capture never writes an
  # x-file-manifest blob at all (only N's cross-machine push and this
  # picker's own case-3 localization below do, neither of which is
  # source_host==self) -- so srcuti=='x-file-manifest' here reliably means
  # "no real NSFilenamesPboardType/public.file-url blob exists to restore
  # from". A by-rowid restore's blind writeAllData over just that private UTI
  # would silently paste nothing in Finder; route through the paths form with
  # the manifest's own paths instead. source_host is provenance, not trust: a
  # public peer can claim this hostname, so the trusted-local persist must
  # also have created file_authorities for this row before it may reach
  # clip.set.files.
  if [[ -z "$host" || "$host" == "$MY_HOST" ]]; then
    if [[ "$srcuti" == "x-file-manifest" ]]; then
      local authorized
      authorized=$(sqlite3 "$DB_FILE" "SELECT EXISTS(
        SELECT 1 FROM file_authorities WHERE clip_id=$id);" 2>/dev/null) ||
        authorized=0
      if [[ "$authorized" != 1 ]]; then
        clip::restore_fail "local manifest is not authorized; copy the files again"
        return 1
      fi
      if (( ${#rpaths[@]} > 0 )) && clip::send_file_urls "${rpaths[@]}"; then
        clip::bump_last_ts_now "$id"   # spec R5c: bump-on-use
        return 0
      fi
      clip::restore_fail "local manifest restore failed for row $id"
      return 1
    fi

    # clip.set.files{clip_id}: the bare decimal rowid rides as a named field
    # (the old `id:` prefix disambiguated a positional payload and is dead).
    if clipbridge::set_files_id "$id"; then
      clip::bump_last_ts_now "$id"   # spec R5c: bump-on-use
      return 0
    fi
    clip::restore_fail "local files restore (id $id) failed"
    return 1
  fi

  # Remote-origin row from here on.
  (( ${#rpaths[@]} > 0 )) || { clip::restore_fail "no file paths recorded for row $id"; return 1 }

  # Case 2: every recorded path is one of the picker's OWN cache paths,
  # exists, and has a matching authority row (a row this picker localized
  # earlier) -> form A with those paths, no re-pull. Prefix + authority keeps
  # a public pointer or coincidentally-existing path from short-circuiting to
  # a stale local twin.
  local cacheroot="${PICK_CLIPBOARD_CACHE_ROOT:-$HOME/.cache/pick-clipboard/files}"
  local -i all_cached=1
  local rp
  for rp in "${rpaths[@]}"; do
    [[ "$rp" == "$cacheroot/"* && -e "$rp" ]] || { all_cached=0; break }
  done
  local rowpathsf authorityf
  rowpathsf=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-rowpaths.XXXXXX")
  authorityf=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-authority.XXXXXX")
  local -i first_path=1 authority_matches=0
  { for rp in "${rpaths[@]}"; do
      if (( first_path )); then print -rn -- "$rp"; first_path=0
      else print -rn -- $'\0'"$rp"; fi
    done
  } > "$rowpathsf"
  if PICK_CLIPBOARD_DB="$DB_FILE" zsh -f -c '
       source "$1" || exit 1
       clip::load_file_authority "$2" || exit 1
       syswrite -- "$REPLY_PATHS"
     ' _ "$CORE_LIB" "$id" > "$authorityf" 2>/dev/null &&
     cmp -s "$rowpathsf" "$authorityf"; then
    authority_matches=1
  fi
  rm -f "$rowpathsf" "$authorityf"
  (( authority_matches )) || all_cached=0
  if (( all_cached )); then
    for rp in "${rpaths[@]}"; do touch "${rp:h}" 2>/dev/null || true; done
    if clip::send_file_urls "${rpaths[@]}"; then
      clip::bump_last_ts_now "$id"   # spec R5c: bump-on-use
      return 0
    fi
    clip::restore_fail "localized files restore failed for row $id"
    return 1
  fi

  # Case 4: an x-resolved-path-only remote row that case 2 didn't claim --
  # either a stale localized row (cache path swept from disk: the origin
  # never held it, nothing to re-pull) or a mirrored row recording a
  # non-cache origin path (only x-file-manifest rows are pullable in M2).
  if [[ "$srcuti" != "x-file-manifest" ]]; then
    clip::restore_fail "no pullable manifest for row $id (recorded path: ${rpaths[1]})"
    return 1
  fi

  # Case 3: genuine remote manifest -> rsync pull-down (spec §12).
  local rsync_bin="${PICK_CLIPBOARD_RSYNC:-/opt/homebrew/bin/rsync}"
  if [[ ! -x "$rsync_bin" ]]; then
    clip::restore_fail "brew rsync not found: $rsync_bin"
    return 1
  fi
  local kind; kind=$(sqlite3 "$DB_FILE" "SELECT IFNULL(type_kind,'files') FROM clips WHERE id=$id;" 2>/dev/null) || kind="files"

  local cachedir="$cacheroot/$id"
  local -a local_paths
  local -i idx=0 pulled=0
  local sub lp auth_marker partial_marker partial_dir

  # Progress sinks (copy-feedback design §4): a live tty renders rsync's own
  # meter in the pane (pbpaste tier-2 UX); headless (--restore-id from the
  # GUI) drives the top-right OSD HUD instead.
  local -i n_paths=${#rpaths[@]} have_tty=0
  clip::has_live_tty && have_tty=1
  (( have_tty )) || clip::progress_begin

  local pull_label; pull_label=$(clip::progress_label $n_paths "$host" "${rpaths[1]}")

  # Cancel trap (§4.4): localtraps scopes it to this function -- every
  # return path restores the caller's disposition automatically, so the
  # failure branches below need no explicit `trap -`. zsh defers the trap
  # until the foreground rsync exits (killed by the same Ctrl+C group
  # signal, or directly by the GUI's pkill), so the partial output is
  # settled by the time the handler removes it.
  setopt localoptions localtraps
  CLIP_PULL_SUB=""
  CLIP_PULL_MARKER=""
  trap 'clip::pull_cancelled' INT TERM

  for rp in "${rpaths[@]}"; do
    (( idx += 1 ))
    sub="$cachedir/$idx"
    lp="$sub/${rp:t}"
    auth_marker="$cachedir/.authorized/$idx"
    partial_marker="$cachedir/.partial/$idx"
    partial_dir="$cachedir/.partial-data/$idx"
    if [[ ! -e "$lp" || ! -e "$auth_marker" ]]; then
      [[ -d "$sub" ]] && clip::cache_remove_sub "$cacheroot" "$sub" || true
      mkdir -p "$sub" "$cachedir/.authorized" "$cachedir/.partial" "$partial_dir" ||
        { clip::progress_end; clip::restore_fail "cannot create $sub"; return 1 }
      CLIP_PULL_SUB="$sub"
      CLIP_PULL_MARKER="$partial_marker"
      rm -f "$auth_marker"
      : > "$partial_marker"
      # spec R3: this pull's ssh session has no use for the clipboard bridge's
      # RemoteForward -- without ClearAllForwardings, a session multiplexed
      # onto the interactive connection's ControlMaster re-requests the same
      # reverse forward (BRIDGE_PORT) the interactive session already holds,
      # and the remote sshd's refusal ("Warning: remote port forwarding
      # failed for listen port 2490") scribbles over the fzf UI on every
      # single pull. Clearing forwardings on this ad-hoc session kills the
      # redundant request AND the warning at the source. rsync/ssh's own
      # stderr is captured to a temp file rather than discarded to /dev/null:
      # a real failure (host down, permission denied, path gone) gets a
      # readable one-line reason instead of a silent exit, with the full
      # detail still on disk for follow-up.
      # NOTE: `local rsync_err=$(mktemp ...)` in ONE statement, not the more
      # usual `local rsync_err; rsync_err=$(mktemp ...)` two-liner used
      # elsewhere in this file -- inside a `for` loop (this one repeats per
      # manifest path) the two-liner form leaks the FIRST iteration's
      # command-substitution output onto the function's real stdout on a
      # later zsh re-declaration of the same local (confirmed empirically: a
      # minimal repro of `local x; x=$(mktemp ...)` inside a `for` prints
      # "x=<path>" to stdout once). The single-line form has no such leak.
      local rsync_err=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-rsync-err.XXXXXX")
      # ... which in turn means mktemp's exit status is swallowed (`local
      # x=$(cmd)` reports the `local` builtin's status, never cmd's), so a
      # failed mktemp can't be caught with `||`. Explicit check instead: on
      # an empty/unwritable capture path, degrade to /dev/null rather than
      # letting the `2>"$rsync_err"` redirection below error out and dump a
      # raw zsh diagnostic onto stderr -- exactly the noise class this
      # capture exists to suppress.
      [[ -n "$rsync_err" && -w "$rsync_err" ]] || rsync_err=/dev/null
      local -i rrc=0
      if (( have_tty )); then
        # In-pane feedback: header line + rsync's own live meter. progress2
        # writes the meter to STDOUT -- `1>&2` routes it to the pane's tty
        # (same move as pbpaste tier 2) while real errors still land in the
        # capture file for the one-line failure reason.
        print -ru2 -- "Pulling ${rp:t} from ${host} (${idx}/${n_paths})… — Ctrl+C cancels"
        "$rsync_bin" -a --info=progress2 --partial-dir="$partial_dir" -e 'ssh -o ClearAllForwardings=yes -o ConnectTimeout=10' "${host}:${rp}" "$sub/" 1>&2 2>"$rsync_err" || rrc=$?
      else
        # Headless: meter stdout feeds the throttled HUD sink; the sink is
        # the LAST pipeline segment so it runs in this shell and the
        # CLIP_PROGRESS_* state survives into the next manifest path.
        # idx-1 == paths already done (cached ones count: they're complete).
        "$rsync_bin" -a --info=progress2 --partial-dir="$partial_dir" -e 'ssh -o ClearAllForwardings=yes -o BatchMode=yes -o ConnectTimeout=10' "${host}:${rp}" "$sub/" 2>"$rsync_err" | clip::progress_stream $(( idx - 1 )) $n_paths "$pull_label"
        rrc=${pipestatus[1]}
      fi
      if (( rrc != 0 )); then
        clip::progress_end
        clip::cache_remove_sub "$cacheroot" "$sub" || true
        clip::cache_remove_meta_sub "$cacheroot" "$partial_dir" || true
        rm -f "$partial_marker" 2>/dev/null || true
        if [[ "$rsync_err" == /dev/null ]]; then
          clip::restore_fail "rsync failed pulling $host:$rp"
        else
          clip::restore_fail "rsync failed pulling $host:$rp (details: $rsync_err)"
        fi
        return 1
      fi
      if [[ "$rsync_err" != /dev/null ]]; then rm -f "$rsync_err"; fi
      rm -f -- "$partial_marker"
      clip::cache_remove_meta_sub "$cacheroot" "$partial_dir" || true
      rmdir -- "$cachedir/.partial" "$cachedir/.partial-data" 2>/dev/null || true
      touch "$sub"
      (( pulled += 1 ))
      CLIP_PULL_SUB=""
      CLIP_PULL_MARKER=""
    else
      touch "$sub" 2>/dev/null || true
    fi
    local_paths+=("$lp")
  done
  clip::progress_end

  for lp in "${local_paths[@]}"; do
    if [[ -L "$lp" || ( ! -f "$lp" && ! -d "$lp" ) ]]; then
      clip::restore_fail "unsupported localized file type: $lp"
      return 1
    fi
  done

  # Authoritative bookkeeping for the exact cache-path set. A durable local
  # marker prevents an interrupted pull from treating unverified existing
  # bytes as cached; the DB lookup prevents duplicate rows on re-pick.
  local blobf; blobf=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-localize-blob.XXXXXX")
  local uti="x-resolved-path" first=1
  if (( ${#local_paths[@]} > 1 )); then
    uti="x-file-manifest"
    { for lp in "${local_paths[@]}"; do
        if (( first )); then print -rn -- "$lp"; first=0
        else print -rn -- $'\0'"$lp"; fi
      done
    } > "$blobf"
  else
    print -rn -- "${local_paths[1]}" > "$blobf"
  fi
  local eblob="${blobf//\'/\'\'}"
  local ek="${kind//\'/\'\'}" eh="${host//\'/\'\'}"
  local localized_id
  localized_id=$(sqlite3 "$DB_FILE" "SELECT c.id FROM clips c
    JOIN clip_types t ON t.clip_id=c.id AND t.uti='$uti'
    WHERE c.source_host='$eh' AND c.type_kind='$ek'
      AND t.blob=readfile('$eblob')
      AND EXISTS (SELECT 1 FROM file_authorities fa WHERE fa.clip_id=c.id)
    ORDER BY c.id DESC LIMIT 1;" 2>/dev/null) || localized_id=""

  local -i localized_new=0 localized_authorized=0
  if [[ -z "$localized_id" ]] && (( pulled > 0 )); then
    local ts; ts=$(date +%s)
    local preview; preview="$(clip::localized_preview "${local_paths[@]}")"
    local epv="${preview//\'/\'\'}"
    localized_id=$(sqlite3 "$DB_FILE" "INSERT INTO clips
      (type_kind, first_ts, last_ts, source_host, text_preview)
      VALUES ('$ek', $ts, $ts, '$eh', '$epv');
      SELECT last_insert_rowid();") 2>/dev/null || localized_id=""
    local inserted_id=$localized_id
    if [[ -n "$localized_id" ]] &&
       sqlite3 "$DB_FILE" "INSERT INTO clip_types (clip_id, uti, blob)
         VALUES ($localized_id, '$uti', readfile('$eblob'));" >/dev/null 2>&1; then
      localized_new=1
    else
      [[ -n "$inserted_id" ]] &&
        sqlite3 "$DB_FILE" "DELETE FROM clips WHERE id=$inserted_id;" >/dev/null 2>&1
      localized_id=""
    fi
  fi

  if [[ -n "$localized_id" ]] &&
     PICK_CLIPBOARD_DB="$DB_FILE" zsh -f -c '
       source "$1" || exit 1
       clip::read_file "$3"
       clip::replace_file_authority "$2" "$REPLY"
     ' _ "$CORE_LIB" "$localized_id" "$blobf" >/dev/null 2>&1; then
    localized_authorized=1
    local -i auth_idx=0
    for lp in "${local_paths[@]}"; do
      (( auth_idx += 1 ))
      mkdir -p "$cachedir/.authorized" 2>/dev/null || true
      touch "$cachedir/.authorized/$auth_idx" 2>/dev/null || true
    done
  elif (( localized_new )); then
    sqlite3 "$DB_FILE" "DELETE FROM clip_types WHERE clip_id=$localized_id;
      DELETE FROM clips WHERE id=$localized_id;" >/dev/null 2>&1
  fi
  rm -f "$blobf"

  if (( ! localized_authorized )); then
    clip::restore_fail "localized file type cannot be authorized safely"
    return 1
  fi
  if clip::send_file_urls "${local_paths[@]}"; then
    clip::bump_last_ts_now "$id"   # spec R5c: bump-on-use
    return 0
  fi
  clip::restore_fail "localized files restore failed for row $id"
  return 1
}

# A real attempt to open /dev/tty for reading, not `[[ -e /dev/tty ]]` --
# that special file exists on disk regardless of whether THIS process has a
# controlling terminal (true even under this repo's own shellspec harness,
# which has none), so an existence check alone would say "yes, hold" and
# block a headless/CI run. Opening it is the honest test: with no
# controlling terminal the open fails immediately (ENXIO) instead of
# hanging, which is exactly the fast, safe "no tty" signal this needs.
# Defined here -- ABOVE the --restore-id dispatch just below -- rather than
# down in the restore-failure-hold section (W2) where it originally lived
# alongside should_hold_on_restore_failure/render_restore_failure: case 3's
# tty/headless progress-sink split (copy-feedback design §4) now calls this
# from inside clip::copy_files_by_id, which --restore-id invokes at the top
# level before this file's later definitions have been sourced -- defining
# it any later would leave a direct (non---restore-id) run resolving to
# "command not found" the first time a remote-manifest pull happens.
clip::has_live_tty() {
  { : < /dev/tty; } 2>/dev/null
}

# --restore-id <n> (headless CLI mode, spec R4): runs the SAME
# clip::copy_files_by_id logic Ctrl-Y's files branch uses above, with no fzf
# and no TTY -- stdout/stderr plain, exit 0 on success/1 on failure. This is
# what clipboard-picker.lua's Hammerspoon side shells out to (via hs.task)
# for a files/file/directory row it cannot restore in-process (a genuine
# remote manifest, or one already localized but still remote-badged, spec
# §12): the GUI has no rsync-pull-and-localize engine of its own, so it
# delegates to this CLI instead of re-implementing that dance a second time
# in Lua. Checked here -- right after clip::copy_files_by_id's own
# definition, before clip::copy_by_id and everything interactive-only below
# it (live peer entry already ran by this point, but geometry, the
# --key-reload temp scripts, and fzf's hints/args never do) -- so a headless
# caller pays for none of the fzf/pty-frame setup it will never use. $1 here
# is the SCRIPT's own first argument (this runs at the top level, not inside
# a function), never confused with a sourced test harness's own "$1" of a
# bare numeric id (PICK_CLIPBOARD_NO_RUN's test convention): the comparison
# is against the literal string "--restore-id", which a plain id never matches.
if [[ "${1:-}" == --restore-id ]]; then
  shift
  restore_id="${1:-}"
  if [[ -z "$restore_id" || "$restore_id" != <-> ]]; then
    print -ru2 -- "pick-clipboard: --restore-id requires a numeric clip id"
    exit 1
  fi
  clip::copy_files_by_id "$restore_id" && { clip::copy_toast_for_id "$restore_id"; exit 0 }
  exit 1
fi

# --no-border (front-end CLI flag, shared-lib Wave 2, group C5, Decision 1) -----
# The zellij floating pane draws its own frame, so the modal wants fzf rendered
# borderless. This is now accepted as a --no-border CLI flag -- matching
# pick-glyph / pick-gitmoji, so all four zellij picker adapters drive the
# borderless look through the flag form -- and forwarded into the pick::start
# args below. PICK_CLIPBOARD_NO_BORDER is still honored as harmless back-compat
# (the adapter no longer sets it). --restore-id is dispatched above and never
# reaches here; every other positional arg stays ignored (this entrypoint has
# always been lenient, reserving room for a future --resume), so a scan -- not a
# strict parser that would die on the unknown -- is what preserves that.
no_border=0
[[ -n "${PICK_CLIPBOARD_NO_BORDER:-}" ]] && no_border=1
for _nb_arg in "$@"; do
  if [[ "$_nb_arg" == --no-border ]]; then no_border=1; fi
done

# Copy a clip's content to *my* clipboard, carrying the register type so a block
# clip stays block-pasteable. Self-contained model (§11): the clip already lives
# in this store, so there is no cross-machine restore — copy is always a local
# set, plus (when bridge-up) a ship to the machine you're sitting at:
#   files/file/directory -> clip::copy_files_by_id (by-rowid form locally,
#     rsync pull-down + localize for a remote manifest row, spec §9/§12); on
#     ANY failure there, falls through to the behavior below unchanged.
#   bridge-up (SSH) image  -> clip.set.rich ships the blob to the peer
#     (OSC 52 can't carry it)
#   bridge-up (SSH) text   -> clip.set(regtype+text) to the peer you're
#     sitting at
#   sitting locally (no SSH)-> clip.set(regtype+text) to this machine's own
#     bridge over the trusted socket
#   SSH bridge-down (iPad) / fail -> pbcopy shim (OSC 52 text; iPad can't block)
clip::copy_by_id() {
  local id=$1
  local kind; kind=$(sqlite3 "$DB_FILE" "SELECT type_kind FROM clips WHERE id=$id;" 2>/dev/null) || kind=""
  if [[ "$kind" == (files|file|directory) ]]; then
    clip::copy_files_by_id "$id" && { clip::copy_toast_for_id "$id"; return 0 }
  fi
  # Every success below marks the fallback (clip::note_fallback_ok is a no-op
  # unless a files-restore failure was captured above, so a plain text/image
  # row's ordinary copy never sets the flag): the hold screen (W2) uses it to
  # note that the clip's path text DID land on the clipboard despite the
  # file-object restore failing. clip::copy_ok also fires the §6 toast, but
  # only when CLIP_RESTORE_FAILURE is unset -- W2's hold screen owns the
  # messaging for a failed-restore-then-successful-fallback copy.
  if (( bridge_up )); then
    [[ "$kind" == image ]] && clip::ship_image_by_id "$id" && { clip::copy_ok "$id"; return 0 }
    clip::set_via_bridge peer "$id" && { clip::copy_ok "$id"; return 0 }
  elif [[ -z "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]]; then
    clip::set_via_bridge local "$id" && { clip::copy_ok "$id"; return 0 }
  fi
  if command -v pbcopy >/dev/null 2>&1; then
    if clip::text_by_id "$id" | pbcopy; then
      clip::copy_ok "$id"
    fi
  fi
}

# --- restore-failure hold (Ctrl-Y files-restore path, W2) --------------------
# CLIP_RESTORE_FAILURE (set by clip::restore_fail, above) is checked once, at
# the very end of this script's interactive tail, after the accept-dispatch
# case has run and fzf has released the tty. Split into small pieces so the
# DECISION is unit-testable without any fzf/floating-pane machinery (see
# tests/pick-clipboard-files_spec.sh):
#
#   clip::has_live_tty              -- is a controlling terminal reachable at
#                                       all right now? (defined earlier, right
#                                       before the --restore-id dispatch --
#                                       case 3's progress-sink split needs it
#                                       sooner than this section runs)
#   clip::should_hold_on_restore_failure -- pure decision, no I/O
#   clip::render_restore_failure     -- the actual on-screen rendering
#
# The `read -k1 -s` hold itself still needs a real terminal to block on,
# which a test harness never has -- that last mile stays exercised only by
# live validation, not by the spec.

# Decide whether to hold the pane open: only when there IS a reason to show,
# we're on the interactive path (headless=1 -- --restore-id / hs.task --
# always wins even if a reason were somehow set; in production that path
# exits long before this function could ever be reached, but the parameter
# keeps the guard on the MODE rather than relying on tty-detection alone),
# and a live terminal is actually reachable to hold against.
clip::should_hold_on_restore_failure() {
  local reason=$1 headless=${2:-0}
  [[ -n "$reason" ]] || return 1
  (( headless )) && return 1
  clip::has_live_tty || return 1
  return 0
}

# Render the captured reason clearly and hold for one keypress. gum-styled
# via the shared theme::gum_style_env (Wave 2 consolidation) -- the danger
# accent for the box fg/border now lives in ONE place (theme-common.zsh),
# which pick-common.zsh sources transitively, so unlike pbpaste's standalone-
# POSIX-sh JSON-palette detour the helper is simply in scope. When gum is on
# PATH; otherwise a plain ANSI fallback using common.zsh's own gated
# C_DANGER/C_DIM/C_RES (gated on an interactive stdout, so this degrades to
# plain text under a captured/piped stdout).
clip::render_restore_failure() {
  local reason=$1 fallback_ok=${2:-}
  if command -v gum >/dev/null 2>&1; then
    theme::gum_style_env --role danger
    gum style --border rounded --padding "0 1" --bold -- "$reason" >/dev/tty 2>/dev/null
  else
    printf '%s%s%s\n' "$C_DANGER" "$reason" "$C_RES" >/dev/tty
  fi
  # The text fallback usually already put the clip's path text on the
  # clipboard by the time this screen shows -- say so, or "error, press key"
  # reads as "nothing was copied" (reviewer Minor on W2).
  if [[ -n "$fallback_ok" ]]; then
    printf '%snote: the path was still copied as plain text%s\n' "$C_DIM" "$C_RES" >/dev/tty
  fi
  printf '%spress any key to close%s\n' "$C_DIM" "$C_RES" >/dev/tty
}

# --- live entry accept handlers (spec §22.4) --------------------------------
# The three below act on the already-fetched peer text in LIVE_TEXT_FILE — no
# second fetch. deliver = print it (zellij-modal injects our stdout into the
# pane); copy = set the clipboard I'm sitting at (clip.set with the peer's
# regtype); materialize = persist a self-contained local row via
# store.persist.text on THIS machine's own bridge (the trusted socket), so the
# next open shows it as an ordinary stored row (badged remote) and the live
# entry dedups against it. materialize runs after any accept; it's best-effort —
# a failed persist still delivered the text.
clip::deliver_live() {
  [[ -n "$LIVE_TEXT_FILE" && -f "$LIVE_TEXT_FILE" ]] && cat "$LIVE_TEXT_FILE"
}

clip::copy_live() {
  [[ -n "$LIVE_TEXT_FILE" && -s "$LIVE_TEXT_FILE" ]] || return 0
  local rt; rt=$(clipbridge::clip_get_raw regtype 2>/dev/null)
  [[ "$rt" == (v|l|b) ]] || rt=v
  # bridge_up is a precondition of a live entry existing, so the copy target is
  # the machine I'm sitting at, over the reverse tunnel (clip.set = set +
  # record regtype; the text bytes ride stdin).
  clipbridge::set_text "$rt" < "$LIVE_TEXT_FILE" && clip::copy_toast text "$LIVE_HOST"
  return 0
}

clip::materialize_live() {
  [[ -n "$LIVE_TEXT_FILE" && -s "$LIVE_TEXT_FILE" ]] || return 0
  local rt; rt=$(clipbridge::clip_get_raw regtype 2>/dev/null)
  [[ "$rt" == (v|l|b) ]] || rt=v
  # store.persist.text{host, kind=text, app='', regtype} on THIS machine's own
  # bridge, over the trusted socket; the text bytes ride stdin.
  clipbridge::persist_text "$LIVE_HOST" text '' "$rt" < "$LIVE_TEXT_FILE"
  return 0
}

# Inject a clip's text into the originating zellij pane (embed mode), else
# fall back to copy. Mirrors pick::background_sink's inject path.
clip::inject_by_id() {
  local id=$1 text
  text="$(clip::text_by_id "$id")"
  if [[ -n "${PICK_INJECT_PANE:-}" && -n "${PICK_INJECT_ZELLIJ:-}" ]]; then
    ${(z)PICK_INJECT_ZELLIJ} action write-chars --pane-id "$PICK_INJECT_PANE" -- "$text"
  elif command -v pbcopy >/dev/null 2>&1; then
    printf '%s' "$text" | pbcopy
  fi
}

# --- markdown alternate (Alt-Enter, --key-output field:2) -------------------
# No rich-vs-raw distinction here (there's nothing to strip in a terminal --
# it's all plain text already); file/directory/url/image clips get linkified,
# everything else falls back to the same text_plain as a normal Enter.

clip::markdown_url() {
  local id=$1 url
  url="$(clip::text_by_id "$id")"
  printf '[%s](%s)' "$url" "$url"
}

# POSIX path -> a valid file:// URI, percent-encoding each path segment
# individually via jq's @uri (not the whole string at once, which would also
# escape the "/" separators) -- mirrors path_to_file_url in
# clipboard-history.lua.
#
# NOTE: the parameter is named "srcpath" -- NEITHER "path" NOR "fpath". Both
# of those are special arrays tied to an environment value, and `local` on
# either silently rebinds it for the rest of this function's scope: `local
# path=...` empties $PATH and breaks command lookup (sqlite3 et al.), and
# `local fpath=...` empties the autoload search path and makes ${#fpath} the
# array element count rather than the string length. Confirmed empirically.
# Same reasoning in clip::markdown_path_link below and in clip::shorten_path.
clip::path_to_file_url() {
  local srcpath=$1 seg encoded=""
  for seg in "${(s:/:)srcpath}"; do
    [[ -z "$seg" ]] && continue
    encoded+="/$(jq -rn --arg s "$seg" '$s|@uri')"
  done
  print -r -- "file://$encoded"
}

# file/directory clips: link text is the basename, target is the already-
# resolved path Lua's capture code stored under the synthetic
# "x-resolved-path" UTI (clipboard-history.lua resolves macOS's opaque
# file-reference URLs there; nothing to re-resolve here).
clip::markdown_path_link() {
  local id=$1 srcpath
  srcpath="$(sqlite3 "${PICK_SQLITE_RAW[@]}" "$DB_FILE" "SELECT blob FROM clip_types WHERE clip_id=$id AND uti='x-resolved-path';")"
  if [[ -n "$srcpath" ]]; then
    printf '[%s](%s)' "${srcpath##*/}" "$(clip::path_to_file_url "$srcpath")"
  else
    clip::text_by_id "$id"
  fi
}

# image clips: try each image UTI in turn (same set/order as
# IMAGE_UTIS/IMAGE_MIME in clipboard-picker.lua); the first one with a stored
# blob wins. writefile() needs the sqlite3 fileio extension (built into this
# system's sqlite3 by default); `base64 -i ... | tr -d '\n'` is portable
# single-line output regardless of whether the local base64 wraps by default.
clip::markdown_image() {
  local id=$1 pair uti mime tmpfile b64
  local -a utis=(public.png:image/png public.jpeg:image/jpeg public.tiff:image/tiff com.compuserve.gif:image/gif)
  for pair in "${utis[@]}"; do
    uti="${pair%%:*}"; mime="${pair#*:}"
    tmpfile="$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-img.XXXXXX")"
    sqlite3 "$DB_FILE" "SELECT writefile('$tmpfile', blob) FROM clip_types WHERE clip_id=$id AND uti='$uti';" >/dev/null
    if [[ -s "$tmpfile" ]]; then
      b64="$(base64 -i "$tmpfile" | tr -d '\n')"
      rm -f -- "$tmpfile"
      printf '![](data:%s;base64,%s)' "$mime" "$b64"
      return 0
    fi
    rm -f -- "$tmpfile"
  done
  clip::text_by_id "$id"
}

clip::markdown_by_id() {  # id -> markdown string for file/directory/url/image; else plain text (same as Enter)
  local id=$1 kind
  kind="$(sqlite3 "$DB_FILE" "SELECT type_kind FROM clips WHERE id=$id;")"
  case "$kind" in
    url)              clip::markdown_url "$id" ;;
    file|directory)   clip::markdown_path_link "$id" ;;
    image)            clip::markdown_image "$id" ;;
    *)                clip::text_by_id "$id" ;;
  esac
}

# --on-key-background hook: $1 = id (field:1), $2 = the key. Dispatch on $2.
clip::bg_hook() {
  local id=$1 key=${2:-}
  # The LIVE sentinel is not a row — ignore every background key on it (§22.4).
  [[ -n "$id" && "$id" != LIVE ]] || return 0
  case "$key" in
    ctrl-o)           clip::inject_by_id "$id" ;;
    ctrl-d|alt-d)     clip::delete_by_id "$id" ;;
    ctrl-p)           clip::toggle_pin_by_id "$id" ;;
    *)                ;;  # ignore unmapped background keys
  esac
}

# --on-items-picked: re-bump last_ts so the just-picked clip floats to the top.
clip::bump_recency() {
  (($#)) || return 0
  local now id; now=$(date +%s)
  for id; do
    [[ "$id" == <-> ]] || continue   # numeric ids only — skips the LIVE sentinel
    sqlite3 "$DB_FILE" "UPDATE clips SET last_ts=$now WHERE id=$id;" 2>/dev/null || true
  done
}

# --- dynamic geometry (from the live TTY) -----------------------------------
# The item line + preview footer are sized to the actual pane so the pin sits
# at the right edge (not truncated off) and the footer fits the preview pane.
# pty-frame draws a 1-cell box + fzf pads ~3 each side, so the usable list
# area is ~COLS-8; the item line reserves icon(2)+sep(2)+sep(2)+pin(2)=8, so
# content width CW = COLS-16. The preview pane is 45% of the fzf window; the
# footer label/value widths sum to fit it. preview_h drives the blank padding
# that bottom-aligns the footer.
COLS=${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}
ROWS=${LINES:-$(tput lines 2>/dev/null || echo 24)}
# Item-line content width. The list pane is ~55% of the fzf window (the
# preview takes 45%); the fzf window is the pty-frame sub-pty = COLS-2 (box);
# minus ~6 (fzf padding 0,2,0,2 + input-border gutter each side); minus 5
# (icon + sep + pin column). So CW = (COLS-2)*55/100 - 11. The list width
# isn't exposed to the input stream (items emit before fzf lays out), so this
# is computed from tput cols — the preview footer instead uses fzf's exact
# FZF_PREVIEW_COLUMNS (see the preview script).
CW=${PICK_CLIPBOARD_CONTENT_WIDTH:-$(( (COLS - 2) * 55 / 100 - 12 ))}
(( CW < 10 )) && CW=10

# --- the content column's snippet -------------------------------------------
# The stored text_preview lands in the content column raw, so whatever
# whitespace the writer captured is what the list shows: a clip that OPENS
# with a blank line stored an EMPTY preview (every writer used to keep only
# the text up to the first newline) and rendered as a blank row with nothing
# to identify it by, and an indented first line rendered pushed off its
# column. The writers now flatten instead (clip::preview_of), but rows
# captured before that keep their stored preview on file -- 8 blank and 59
# untrimmed of the 991 rows on this store when this was written -- so the
# snippet is repaired at render time too, the way the GUI picker does it in
# clipboard-picker.lua's query_items.
#
# clip::sql_flatten <sql-expr> -- prints a SQL expression that flattens that
# expression to one trimmed line: tabs/CR/LF become spaces, runs of spaces
# collapse, then TRIM drops what a leading blank line left behind. SQLite has
# no regex, so the collapse is nested replace() passes -- each one halves a
# run, so 6 covers the 64-space indent no real clip reaches. Only the head of
# the text is scanned: the column is ~150 columns at its widest, and a
# multi-megabyte clip must not be rewritten six times over to fill one row.
clip::sql_flatten() {
  local e="replace(replace(replace(substr($1,1,400), char(9),' '), char(13),' '), char(10),' ')"
  local -i i
  for (( i = 0; i < 6; i++ )); do e="replace($e,'  ',' ')"; done
  print -r -- "TRIM($e)"
}
# A preview with content is only trimmed (the store-wide invariant is that
# text_preview is a single line -- see clipboard-platform-linux-headless.zsh);
# a blank one has its snippet re-derived from text_plain, and a row with no
# plain text either falls back to the "[kind]" badge, same as the GUI.
SNIPPET_EXPR="COALESCE(NULLIF(TRIM(text_preview, ' '||char(9)||char(10)||char(13)),''),
                       NULLIF($(clip::sql_flatten text_plain),''),
                       '['||type_kind||']')"
# The files/file/directory branch keeps the raw newline-joined paths (X8
# tail-truncates them in the shell), but an empty preview there has to reach
# the badge fallback too: IFNULL only catches NULL, and the localized
# bookkeeping row (spec R5b, clip::copy_files_by_id) inserts '$epv' -- the
# empty string, not NULL, when the path join comes back empty.
FILE_RAW_EXPR="COALESCE(NULLIF(text_preview,''), '['||type_kind||']')"

# Pre-render the synthetic LIVE row (§22.3) once, into a temp file the emit path
# cats above the stored rows. Rendered via sqlite3 so the glyph/ANSI/printf are
# byte-identical to the DB rows; the peer text comes from LIVE_TEXT_FILE via
# readfile (no DB row exists for it). Kind glyph is nf-md-access-point (char 983043,
# U+F0003) in the mauve origin color (c_origin) — radiating waves that read as
# live/not-from-here at a glance.
# Preview = the same flattened one-line snippet a stored row gets (this used to
# be the first line alone, so a peer clipboard opening with a blank line
# rendered the row blank), same CW truncation + ellipsis as stored rows. Tail id
# is the sentinel LIVE (not numeric): field1=LIVE, field2=MD:LIVE, field3=CP:LIVE.
if [[ -n "$LIVE_TEXT_FILE" ]]; then
  live_row_file=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-liverow.XXXXXX")
  sqlite3 "${PICK_SQLITE_RAW[@]}" "$DB_FILE" "WITH palette AS (
        SELECT CHAR(27)||'[0m'                AS reset,
               CHAR(27)||'[38;2;202;211;245m' AS text_color,
               CHAR(27)||'[38;2;203;166;247m' AS c_origin
      ),
      live AS ( SELECT CAST(readfile('$LIVE_TEXT_FILE') AS TEXT) AS body ),
      l AS ( SELECT $(clip::sql_flatten body) AS oneline FROM live )
      SELECT c_origin || char(983043) || reset || '  '
        || text_color
        || printf('%-${CW}s', substr(oneline,1,$((CW-1))) || CASE WHEN length(oneline) > $((CW-1)) THEN '…' ELSE '' END)
        || reset || '   '
        || CHAR(31) || 'LIVE' || CHAR(30) || 'MD:LIVE' || CHAR(30) || 'CP:LIVE'
      FROM l, palette;" > "$live_row_file"
fi

# --- preview (full text + bottom-aligned formatted footer) ------------------
# fzf's {2} = "id\x1eMD:id" (fzf's own --delimiter only splits on \x1f, so the
# \x1e-joined markdown marker rides along inside field 2 unsplit -- the
# script strips it back off; see the wire-format comment at the top of this
# file). The preview script emits the clip's full text, blank padding to push
# the footer to the bottom of the preview pane, then a 5-line footer (labels
# left, values right-aligned, Copied: last). Dim throughout. A standalone
# script (fzf's preview runs a fresh shell) with the DB path + widths +
# age/words expressions inlined.
age_expr="CASE WHEN CAST(strftime('%s','now') AS INT)-CAST(last_ts AS INT) < 60 THEN printf('%ds', CAST(strftime('%s','now') AS INT)-CAST(last_ts AS INT)) WHEN CAST(strftime('%s','now') AS INT)-CAST(last_ts AS INT) < 3600 THEN printf('%dm', (CAST(strftime('%s','now') AS INT)-CAST(last_ts AS INT))/60) WHEN CAST(strftime('%s','now') AS INT)-CAST(last_ts AS INT) < 86400 THEN printf('%dh', (CAST(strftime('%s','now') AS INT)-CAST(last_ts AS INT))/3600) ELSE printf('%dd', (CAST(strftime('%s','now') AS INT)-CAST(last_ts AS INT))/86400) END"
# word count: space-separated tokens in the newline-flattened text (0 if empty/NULL)
words_expr="CASE WHEN text_plain IS NULL OR text_plain='' THEN 0 ELSE length(trim(replace(text_plain,char(10),' '))) - length(replace(trim(replace(text_plain,char(10),' ')),' ','')) + 1 END"
preview_script=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-preview.XXXXXX")
PREVIEW_CMD="bash $preview_script {2}"

# --- X8: file/dir/files row content -- keep the basename, not the head -----
# A files/file/directory row's content used to get the SAME right-truncate
# (substr(...,1,CW-1)||'…') as a text row, which chops the tail off a path --
# exactly the part (the basename) that matters. Doing tail-aware truncation
# ("keep the basename + as many trailing segments as fit, elide the head
# with a leading '…/'") in pure SQL is awkward, so EMIT_ROW_BODY instead
# marks these three kinds' content with \x02<kind>\x02<raw>\x03 (raw
# newlines swapped for \x01 so a multi-file row's manifest still round-trips
# as ONE line through the sqlite3->fzf pipe) and clip::filter_file_rows
# rewrites just that span, byte for byte leaving every other row (text/rtf/
# html/image/url) exactly as SQL rendered it -- requirement 3.
#
# Written in portable bash+zsh parameter-expansion only (no zsh-only :t/:h
# modifiers, no arrays) because the SAME source has to run unmodified in two
# places: eval'd into this script's own zsh session (emit_rows, and any test
# that sources the file under PICK_CLIPBOARD_NO_RUN), AND pasted verbatim
# into the emit_script reload script below, which fzf always runs via
# `bash $emit_script` regardless of its shebang -- a fresh shell that can't
# see this script's zsh functions (the same constraint EMIT_ROW_BODY's own
# SQL duplication works around).
CLIP_SHORTEN_FUNCS=$(cat <<'SHORTENEOF'
clip::shorten_path() {
  # $1 = path, $2 = width (characters) -> stdout the path, whole if it
  # already fits, else tail-truncated: basename + as many trailing "/seg"
  # groups as fit under width, prefixed with a leading '…/'. If even the
  # bare basename can't fit under that '…/' marker, falls back to a single
  # '…' + ITS OWN trailing chars (still the tail, never the head) -- the
  # single-segment-longer-than-width edge case. The result is ALWAYS <=
  # width columns (the '…/' or '…' elision marker is counted against the
  # budget in every branch, including the base case: X8 review found the
  # pre-fix base case returned '…/'+basename un-budget-checked, so a
  # basename of length width-1 overflowed by 1 and misaligned the content
  # column against text rows).
  #
  # LC_ALL=/LC_CTYPE utf-8: ${#var} and ${var:off} count BYTES under
  # LC_ALL=C but the picker's column layout is character/display-cell wide
  # (a text row's substr()/CW is char-based), so an accented path would
  # otherwise render short + misalign under a C locale. Force a UTF-8
  # ctype for this helper's length/substring math so it counts characters,
  # matching the SQL side. macOS-only tool, so en_US.UTF-8 is always
  # present (same locale the rest of the desktop session runs). `local`
  # (dynamically scoped in both zsh and bash) so it also covers the nested
  # clip::render_file_content/clip::shorten_path calls, and doesn't leak.
  #
  # NOTE: the parameter is named "srcpath", not "path" AND NOT "fpath" --
  # zsh's lowercase $path is a special array tied to $PATH (a plain
  # `local path=...` shadows it and silently breaks command lookup for the
  # rest of this function's scope), and $fpath is the SAME kind of tied
  # special array (the function autoload search path) -- `local fpath=...`
  # doesn't error, it just silently makes ${#fpath} return the ARRAY
  # element count (1) instead of the string length, which is exactly the
  # bug this function exists to avoid for the path it's given (confirmed
  # empirically). Every other local here is `local` for the same reason
  # one level down: undeclared assignments inside a zsh function walk UP
  # the call stack to the nearest existing scope of that name (or global)
  # -- this runs nested inside clip::filter_file_rows and
  # clip::render_file_content, so an undeclared `width` etc. here would
  # clobber theirs.
  local LC_ALL= LC_CTYPE=en_US.UTF-8
  local srcpath=$1 width=$2 base kept rest seg cand prevrest off tail_len
  [ "$width" -lt 1 ] && width=1
  if [ "${#srcpath}" -le "$width" ]; then
    printf '%s' "$srcpath"
    return 0
  fi
  base=${srcpath##*/}
  # Base case: the shortened form is '…/'+kept, so kept must fit in
  # width-2. If even the bare basename can't ('…/'+basename > width),
  # truncate the basename itself, keeping a single '…' marker (1 col) +
  # its trailing width-1 chars -- an over-long basename still reads as
  # elided, and the total is exactly <= width.
  if [ $(( ${#base} + 2 )) -gt "$width" ]; then
    tail_len=$(( width - 1 ))
    if [ "$tail_len" -lt 1 ]; then
      printf '…'
    else
      off=$(( ${#base} - tail_len ))
      printf '…%s' "${base:$off}"
    fi
    return 0
  fi
  kept=$base; rest=${srcpath%/*}
  while [ "$rest" != "$srcpath" ] && [ -n "$rest" ] && [ "$rest" != "/" ]; do
    seg=${rest##*/}
    cand="$seg/$kept"
    if [ $(( ${#cand} + 2 )) -gt "$width" ]; then
      break
    fi
    kept=$cand
    prevrest=$rest
    rest=${rest%/*}
    [ "$rest" = "$prevrest" ] && break
  done
  printf '…/%s' "$kept"
}
clip::render_file_content() {
  # $1 = type_kind (files|file|directory), $2 = raw text_preview (real
  # newlines restored), $3 = width -> stdout the row content, NOT yet
  # padded (the caller pads to width). A "files" manifest shows the first
  # path's tail + " (+N)" for the rest; file/directory show the one path's
  # tail. UTF-8 ctype (see clip::shorten_path) so ${#suffix} is char-count.
  local LC_ALL= LC_CTYPE=en_US.UTF-8
  local kind=$1 raw=$2 width=$3 first total extra suffix budget
  if [ "$kind" = files ]; then
    first=${raw%%$'\n'*}
    total=$(printf '%s\n' "$raw" | wc -l | tr -d ' ')
    extra=$(( total - 1 ))
    if [ "$extra" -gt 0 ]; then
      suffix=" (+${extra})"
      budget=$(( width - ${#suffix} ))
      [ "$budget" -lt 1 ] && budget=1
      printf '%s%s' "$(clip::shorten_path "$first" "$budget")" "$suffix"
    else
      clip::shorten_path "$first" "$width"
    fi
  else
    clip::shorten_path "$raw" "$width"
  fi
}
clip::filter_file_rows() {
  # $1 = width -> reads emitted rows on stdin, writes to stdout. Only rows
  # carrying the \x02<kind>\x02<raw>\x03 marker get rewritten; every other
  # row passes through byte for byte. UTF-8 ctype (see clip::shorten_path)
  # so the pad math (width - ${#content}) is char-count -- an accented file
  # path then pads to the same column width as a text row's CW.
  local LC_ALL= LC_CTYPE=en_US.UTF-8
  local width=$1 line pre rest kind raw_enc post raw content pad
  while IFS= read -r line; do
    case "$line" in
      *$'\x02'*$'\x02'*$'\x03'*)
        pre=${line%%$'\x02'*}
        rest=${line#*$'\x02'}
        kind=${rest%%$'\x02'*}
        rest=${rest#*$'\x02'}
        raw_enc=${rest%%$'\x03'*}
        post=${rest#*$'\x03'}
        raw=${raw_enc//$'\x01'/$'\n'}
        content=$(clip::render_file_content "$kind" "$raw" "$width")
        pad=$(( width - ${#content} ))
        [ "$pad" -lt 0 ] && pad=0
        printf '%s%s%*s%s\n' "$pre" "$content" "$pad" '' "$post"
        ;;
      *)
        printf '%s\n' "$line"
        ;;
    esac
  done
}
SHORTENEOF
)
eval "$CLIP_SHORTEN_FUNCS"

# --- the row stream ---------------------------------------------------------
# Item line = 3 columns, all rows aligned:
#   col 1: type icon (colored by type)
#   col 2: content preview, padded to a fixed width (CW) so col 3 aligns;
#          YELLOW when pinned (so pinned rows stand out)
#   col 3: pin thumbtack (yellow) when pinned, else blank
# Tail = id\x1eMD:id (CHAR 31 = \x1f, CHAR 30 = \x1e -- see the wire-format
# comment at the top of this file). Type icons: fa-font (text), fa-paintbrush
# (rtf/html), fa-image, fa-folder (files), nf-md-file_outline (file),
# nf-md-folder_outline (directory), nf-md-link_variant (url),
# nf-md-file_document_multiple_outline (mixed), fa-thumbtack (pin) -- same
# glyphs/colors as the GUI picker (clipboard-picker.css/.html), Nerd Font v3
# codepoints via SQL char(N).
#
# EMIT_ROW_BODY is shared by emit_rows (the initial stream) AND the
# --reload-cmd script (fzf reloads the list with it after a delete/pin).
#
# X9: the live-peer row (§22) is no longer unconditionally prepended above
# this query's whole result -- it must interleave by its own copy-time
# (live_ts_threshold, resolved above) among the UNPINNED rows. Simplest
# correct split (the live row is never pinned, so pinned rows are unaffected
# either way): run this body TWICE, once selecting the rows that belong
# ABOVE the live row (pinned, or unpinned-and-newer) and once for the rows
# that belong BELOW it (unpinned-and-not-newer), with the live row cat'd
# between the two in emit_rows/the reload script. When there is no live row,
# live_ts_threshold is -1 (older than any real last_ts), which degrades the
# ABOVE query back to "everything" and BELOW to "nothing" -- the original
# single-query ordering.
EMIT_ROW_BODY="WITH palette AS (
      SELECT CHAR(27)||'[0m'                AS reset,
             CHAR(27)||'[38;2;202;211;245m' AS text_color,
             CHAR(27)||'[38;2;225;170;80m'  AS pin_color,
             CHAR(27)||'[38;2;137;180;250m' AS c_text,
             CHAR(27)||'[38;2;225;170;80m'  AS c_rich,
             CHAR(27)||'[38;2;166;209;137m' AS c_image,
             CHAR(27)||'[38;2;148;156;183m' AS c_files,
             CHAR(27)||'[38;2;235;160;172m' AS c_mixed,
             CHAR(27)||'[38;2;180;190;254m' AS c_file,
             CHAR(27)||'[38;2;250;179;135m' AS c_directory,
             CHAR(27)||'[38;2;116;199;236m' AS c_url,
             CHAR(27)||'[38;2;203;166;247m' AS c_origin
    )
    SELECT
      -- Color the kind glyph mauve (c_origin) when the clip was copied on a
      -- DIFFERENT host (source_host <> ours), else by kind — a zero-width
      -- at-a-glance remote cue that keeps the kind glyph intact. (Two CASEs:
      -- color, then glyph.)
      (CASE WHEN ${remote_when}     THEN c_origin
            WHEN type_kind='text'       THEN c_text
            WHEN type_kind IN ('rtf','html') THEN c_rich
            WHEN type_kind='image'      THEN c_image
            WHEN type_kind='files'      THEN c_files
            WHEN type_kind='file'       THEN c_file
            WHEN type_kind='directory'  THEN c_directory
            WHEN type_kind='url'        THEN c_url
            ELSE c_mixed END)
      || (CASE type_kind
           WHEN 'text'      THEN char(1110065)
           WHEN 'rtf'       THEN char(1110524)
           WHEN 'html'      THEN char(1110524)
           WHEN 'image'     THEN char(1110078)
           WHEN 'files'     THEN char(1110139)
           WHEN 'file'      THEN char(983588)
           WHEN 'directory' THEN char(983638)
           WHEN 'url'       THEN char(983865)
           ELSE                  char(988440) END)
      || reset
      || '  '
      || CASE WHEN pinned=1 THEN pin_color ELSE text_color END
      || CASE WHEN type_kind IN ('files','file','directory')
              THEN char(2) || type_kind || char(2) || replace(${FILE_RAW_EXPR}, char(10), char(1)) || char(3)
              ELSE printf('%-${CW}s', substr(${SNIPPET_EXPR},1,$((CW-1))) || CASE WHEN length(${SNIPPET_EXPR}) > $((CW-1)) THEN '…' ELSE '' END)
         END
      || reset
      || CASE WHEN pinned=1 THEN ' ' || pin_color || char(1110157) || reset ELSE '  ' END || ' '
      || CHAR(31) || id || CHAR(30) || 'MD:' || id || CHAR(30) || 'CP:' || id
    FROM clips, palette"

# ABOVE carries the reserved-slot budget (ABOVE_LIMIT = limit - live).
# EMIT_COUNT_ABOVE counts what ABOVE ACTUALLY returned (row-exact regardless
# of any embedded newline in a preview -- COUNT over the same WHERE+LIMIT),
# so BELOW's dynamic limit (limit - A - live) leaves the total at or under
# the global cap. BELOW's limit is appended at emit time (EMIT_SQL_BELOW ends
# at the LIMIT keyword) since A isn't known until ABOVE has run.
EMIT_SQL_ABOVE="${EMIT_ROW_BODY}
    WHERE pinned=1 OR last_ts > ${live_ts_threshold}
    ORDER BY pinned DESC, last_ts DESC
    LIMIT ${ABOVE_LIMIT};"
EMIT_COUNT_ABOVE="SELECT COUNT(*) FROM (SELECT id FROM clips
    WHERE pinned=1 OR last_ts > ${live_ts_threshold}
    ORDER BY pinned DESC, last_ts DESC
    LIMIT ${ABOVE_LIMIT});"
EMIT_SQL_BELOW="${EMIT_ROW_BODY}
    WHERE pinned=0 AND last_ts <= ${live_ts_threshold}
    ORDER BY last_ts DESC
    LIMIT "

emit_rows() {
  # X8: pipe through clip::filter_file_rows so a files/file/directory row's
  # \x02-marked content (see EMIT_ROW_BODY) gets tail-truncated instead of
  # the generic right-truncate every other kind still gets untouched.
  {
    sqlite3 "${PICK_SQLITE_RAW[@]}" "$DB_FILE" "$EMIT_SQL_ABOVE"
    [[ -n "$live_row_file" && -f "$live_row_file" ]] && cat "$live_row_file"
    local -i a below_limit
    a=$(sqlite3 "$DB_FILE" "$EMIT_COUNT_ABOVE")
    below_limit=$(( PICK_LIMIT - a - LIVE_COUNT ))
    (( below_limit < 0 )) && below_limit=0
    sqlite3 "${PICK_SQLITE_RAW[@]}" "$DB_FILE" "${EMIT_SQL_BELOW}${below_limit};"
  } | clip::filter_file_rows "$CW"
}

# --- temp scripts for --key-reload (delete / pin + list refresh) -------------
# fzf's reload runs a FRESH shell, so the action + the re-stream are standalone
# scripts (the zsh functions / vars aren't visible there). The DB path + SQL
# are inlined at write time; \$1 stays literal so the script takes the id from
# fzf's {2}. Cleaned up on exit. Each is a literal mktemp path — this script's
# own temp file.
emit_script=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-emit.XXXXXX")
del_script=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-del.XXXXXX")
pin_script=$(mktemp "${TMPDIR:-/tmp}/pick-clipboard-pin.XXXXXX")
trap 'rm -f -- "$emit_script" "$del_script" "$pin_script" "$preview_script" "$live_row_file" "$LIVE_TEXT_FILE"' EXIT INT TERM
cat > "$emit_script" <<EOF
#!/bin/sh
# fzf sets FZF_COLUMNS to the fzf window width for --bind commands (including
# start:reload + the delete/pin reloads), so compute the content width from
# the EXACT pane size: list pane = 55% of FZF_COLUMNS (preview takes 45%),
# minus ~6 (padding + gutter) + 5 (icon + sep + pin) -> CW = fc*55/100 - 11.
fc=\${PTY_FRAME_COLUMNS:-\${FZF_COLUMNS:-80}}
cw=\$((fc * 55 / 100 - 12)); [ \$cw -lt 10 ] && cw=10
# X8: clip::shorten_path/render_file_content/filter_file_rows, pasted
# verbatim (this is a fresh shell -- see the temp-scripts comment above) so
# the \x02-marked files/file/directory rows below get the SAME tail-aware
# truncation as the initial emit_rows stream. See that helper's own comment
# (above EMIT_ROW_BODY in this file) for why it's written portable
# bash+zsh -- fzf always runs this reload script via a bare "bash" argv,
# ignoring its shebang.
${CLIP_SHORTEN_FUNCS}
{
# Synthetic LIVE row (§22): pre-rendered once at open into \$live_row_file;
# catted here so it survives fzf reloads (delete/pin) without a re-fetch —
# the entry reflects the peer clipboard as of picker open (§22.6). X9: no
# longer unconditionally first — interleaved by its own copy-time
# (live_ts_threshold, baked in below as a literal at generation time, same
# as \$remote_when/\$DB_FILE elsewhere in this heredoc) between an ABOVE
# query (pinned rows, plus unpinned rows newer than the live row) and a
# BELOW query (the rest) -- see the EMIT_ROW_BODY comment above for why this
# split is correct. live_ts_threshold is -1 (no live row) when the split
# degrades back to "everything in ABOVE" -- the original single-query order.
sqlite3 -escape off '$DB_FILE' "WITH palette AS (
      SELECT CHAR(27)||'[0m'                AS reset,
             CHAR(27)||'[38;2;202;211;245m' AS text_color,
             CHAR(27)||'[38;2;225;170;80m'  AS pin_color,
             CHAR(27)||'[38;2;137;180;250m' AS c_text,
             CHAR(27)||'[38;2;225;170;80m'  AS c_rich,
             CHAR(27)||'[38;2;166;209;137m' AS c_image,
             CHAR(27)||'[38;2;148;156;183m' AS c_files,
             CHAR(27)||'[38;2;235;160;172m' AS c_mixed,
             CHAR(27)||'[38;2;180;190;254m' AS c_file,
             CHAR(27)||'[38;2;250;179;135m' AS c_directory,
             CHAR(27)||'[38;2;116;199;236m' AS c_url,
             CHAR(27)||'[38;2;203;166;247m' AS c_origin
    )
    SELECT
      (CASE WHEN ${remote_when}     THEN c_origin
            WHEN type_kind='text'       THEN c_text
            WHEN type_kind IN ('rtf','html') THEN c_rich
            WHEN type_kind='image'      THEN c_image
            WHEN type_kind='files'      THEN c_files
            WHEN type_kind='file'       THEN c_file
            WHEN type_kind='directory'  THEN c_directory
            WHEN type_kind='url'        THEN c_url
            ELSE c_mixed END)
      || (CASE type_kind
           WHEN 'text'      THEN char(1110065)
           WHEN 'rtf'       THEN char(1110524)
           WHEN 'html'      THEN char(1110524)
           WHEN 'image'     THEN char(1110078)
           WHEN 'files'     THEN char(1110139)
           WHEN 'file'      THEN char(983588)
           WHEN 'directory' THEN char(983638)
           WHEN 'url'       THEN char(983865)
           ELSE                  char(988440) END)
      || reset
      || '  '
      || CASE WHEN pinned=1 THEN pin_color ELSE text_color END
      || CASE WHEN type_kind IN ('files','file','directory')
              THEN char(2) || type_kind || char(2) || replace(${FILE_RAW_EXPR}, char(10), char(1)) || char(3)
              ELSE printf('%-\${cw}s', substr(${SNIPPET_EXPR},1,\$((cw-1))) || CASE WHEN length(${SNIPPET_EXPR}) > \$((cw-1)) THEN '…' ELSE '' END)
         END
      || reset
      || CASE WHEN pinned=1 THEN ' ' || pin_color || char(1110157) || reset ELSE '  ' END || ' '
      || CHAR(31) || id || CHAR(30) || 'MD:' || id || CHAR(30) || 'CP:' || id
    FROM clips, palette
    WHERE pinned=1 OR last_ts > ${live_ts_threshold}
    ORDER BY pinned DESC, last_ts DESC
    LIMIT ${ABOVE_LIMIT};"
[ -n '$live_row_file' ] && [ -f '$live_row_file' ] && cat '$live_row_file'
# X9 shared budget (see the emit_rows note above): count what ABOVE actually
# returned (row-exact COUNT over the same WHERE+LIMIT) so BELOW's limit
# (global limit - A - live) keeps the total ABOVE+live+BELOW at/under the
# cap. Baked literals: \$DB_FILE, the threshold, ABOVE_LIMIT, PICK_LIMIT,
# LIVE_COUNT; \$a / \$below_limit are this reload script's own runtime vars.
a=\$(sqlite3 '$DB_FILE' "SELECT COUNT(*) FROM (SELECT id FROM clips WHERE pinned=1 OR last_ts > ${live_ts_threshold} ORDER BY pinned DESC, last_ts DESC LIMIT ${ABOVE_LIMIT});")
below_limit=\$(( ${PICK_LIMIT} - \$a - ${LIVE_COUNT} ))
[ \$below_limit -lt 0 ] && below_limit=0
sqlite3 -escape off '$DB_FILE' "WITH palette AS (
      SELECT CHAR(27)||'[0m'                AS reset,
             CHAR(27)||'[38;2;202;211;245m' AS text_color,
             CHAR(27)||'[38;2;225;170;80m'  AS pin_color,
             CHAR(27)||'[38;2;137;180;250m' AS c_text,
             CHAR(27)||'[38;2;225;170;80m'  AS c_rich,
             CHAR(27)||'[38;2;166;209;137m' AS c_image,
             CHAR(27)||'[38;2;148;156;183m' AS c_files,
             CHAR(27)||'[38;2;235;160;172m' AS c_mixed,
             CHAR(27)||'[38;2;180;190;254m' AS c_file,
             CHAR(27)||'[38;2;250;179;135m' AS c_directory,
             CHAR(27)||'[38;2;116;199;236m' AS c_url,
             CHAR(27)||'[38;2;203;166;247m' AS c_origin
    )
    SELECT
      (CASE WHEN ${remote_when}     THEN c_origin
            WHEN type_kind='text'       THEN c_text
            WHEN type_kind IN ('rtf','html') THEN c_rich
            WHEN type_kind='image'      THEN c_image
            WHEN type_kind='files'      THEN c_files
            WHEN type_kind='file'       THEN c_file
            WHEN type_kind='directory'  THEN c_directory
            WHEN type_kind='url'        THEN c_url
            ELSE c_mixed END)
      || (CASE type_kind
           WHEN 'text'      THEN char(1110065)
           WHEN 'rtf'       THEN char(1110524)
           WHEN 'html'      THEN char(1110524)
           WHEN 'image'     THEN char(1110078)
           WHEN 'files'     THEN char(1110139)
           WHEN 'file'      THEN char(983588)
           WHEN 'directory' THEN char(983638)
           WHEN 'url'       THEN char(983865)
           ELSE                  char(988440) END)
      || reset
      || '  '
      || CASE WHEN pinned=1 THEN pin_color ELSE text_color END
      || CASE WHEN type_kind IN ('files','file','directory')
              THEN char(2) || type_kind || char(2) || replace(${FILE_RAW_EXPR}, char(10), char(1)) || char(3)
              ELSE printf('%-\${cw}s', substr(${SNIPPET_EXPR},1,\$((cw-1))) || CASE WHEN length(${SNIPPET_EXPR}) > \$((cw-1)) THEN '…' ELSE '' END)
         END
      || reset
      || CASE WHEN pinned=1 THEN ' ' || pin_color || char(1110157) || reset ELSE '  ' END || ' '
      || CHAR(31) || id || CHAR(30) || 'MD:' || id || CHAR(30) || 'CP:' || id
    FROM clips, palette
    WHERE pinned=0 AND last_ts <= ${live_ts_threshold}
    ORDER BY last_ts DESC
    LIMIT \$below_limit;"
} | clip::filter_file_rows "\$cw"
EOF
cat > "$del_script" <<EOF
#!/bin/sh
# {2} is now "id\x1eMD:id" (fzf's own --delimiter only splits on \x1f, so the
# \x1e-joined markdown marker rides along inside field 2 unsplit) -- strip
# everything from the first RS (\036) byte onward to recover the plain id.
id=\${1%%\$(printf '\036')*}
sqlite3 '$DB_FILE' "DELETE FROM clip_types WHERE clip_id=\$id; DELETE FROM clips WHERE id=\$id;"
EOF
cat > "$pin_script" <<EOF
#!/bin/sh
id=\${1%%\$(printf '\036')*}
sqlite3 '$DB_FILE' "UPDATE clips SET pinned=1-pinned WHERE id=\$id;"
EOF
cat > "$preview_script" <<EOF
#!/bin/sh
# fzf sets FZF_PREVIEW_COLUMNS / FZF_PREVIEW_LINES to the preview pane's exact
# dimensions when running this — use them to fit the footer + bottom-align it.
id=\${1%%\$(printf '\036')*}
pc=\${FZF_PREVIEW_COLUMNS:-40}
ph=\${FZF_PREVIEW_LINES:-20}
lw=14
vw=\$((pc - lw)); [ \$vw -lt 4 ] && vw=4
# LIVE sentinel (§22.3): there is no DB row, so render the full text + footer
# from the fetched peer clipboard (LIVE_TEXT_FILE via readfile). Same layout as
# a stored row; Source/Origin badge the peer host, Copied reads 'live'.
if [ "\$id" = LIVE ]; then
  sqlite3 -escape off '$DB_FILE' "WITH d AS (SELECT CAST(readfile('$LIVE_TEXT_FILE') AS TEXT) AS body) SELECT body || char(10) || replace(printf('%*s', MAX(0, \$ph - (CASE WHEN body IS NULL OR body='' THEN 1 ELSE length(body)-length(replace(body,char(10),''))+1 END) - 6), ' '), ' ', char(10)) || char(27)||'[38;2;127;132;156m' || printf('%-\${lw}s%!\${vw}s' || char(10), 'Source:', substr('—',1,\$vw)) || printf('%-\${lw}s%!\${vw}s' || char(10), 'Content Type:', substr('text',1,\$vw)) || printf('%-\${lw}s%!\${vw}s' || char(10), 'Origin:', substr('remote ('||(CASE WHEN length('$LIVE_HOST')>9 THEN substr('$LIVE_HOST',1,4)||'…'||substr('$LIVE_HOST',-3) ELSE '$LIVE_HOST' END)||')',1,\$vw)) || printf('%-\${lw}s%!\${vw}s' || char(10), 'Characters:', substr(length(body),1,\$vw)) || printf('%-\${lw}s%!\${vw}s' || char(10), 'Words:', substr(CASE WHEN body IS NULL OR body='' THEN 0 ELSE length(trim(replace(body,char(10),' '))) - length(replace(trim(replace(body,char(10),' ')),' ','')) + 1 END,1,\$vw)) || printf('%-\${lw}s%!\${vw}s', 'Copied:', substr('live',1,\$vw)) || char(27)||'[0m' FROM d;"
  exit 0
fi
# X8: a files/file/directory row's body is a path (or a newline-joined
# manifest of paths) -- fzf's preview window doesn't wrap by default, so an
# over-long single path was visually clipped at the pane edge even though
# the full text was already in \`body\`. Wrap it ourselves (one path per
# line; \`fold\` further breaks any line that's still too long) instead of
# the generic single-line-of-\$vw rendering every other kind keeps. nlines
# is recomputed from the WRAPPED text (not the raw row) so the footer still
# bottom-aligns correctly.
kind=\$(sqlite3 '$DB_FILE' "SELECT COALESCE(type_kind,'text') FROM clips WHERE id=\$id;")
if [ "\$kind" = files ] || [ "\$kind" = file ] || [ "\$kind" = directory ]; then
  raw=\$(sqlite3 -escape off '$DB_FILE' "SELECT COALESCE(text_plain,text_preview,'['||type_kind||']') FROM clips WHERE id=\$id;")
  wrapfile=\$(mktemp "\${TMPDIR:-/tmp}/pick-clipboard-wrap.XXXXXX")
  printf '%s\n' "\$raw" | fold -w "\$pc" > "\$wrapfile"
  nlines=\$(wc -l < "\$wrapfile" | tr -d ' ')
  [ "\$nlines" -lt 1 ] && nlines=1
  sqlite3 -escape off '$DB_FILE' "WITH c AS (SELECT CAST(readfile('\$wrapfile') AS TEXT) AS body, \$nlines AS nlines, COALESCE(IFNULL(source_app,'?'),'?') AS app, COALESCE(type_kind,'text') AS kind, COALESCE(len,0) AS len, (${words_expr}) AS words, (${age_expr})||' ago' AS age, CASE WHEN ${remote_when} THEN 'remote ('||(CASE WHEN length(source_host)>9 THEN substr(source_host,1,4)||'…'||substr(source_host,-3) ELSE source_host END)||')' ELSE 'local' END AS origin_label FROM clips WHERE id=\$id) SELECT body || char(10) || replace(printf('%*s', MAX(0, \$ph - nlines - 6), ' '), ' ', char(10)) || char(27)||'[38;2;127;132;156m' || printf('%-\${lw}s%!\${vw}s' || char(10), 'Source:', substr(app,1,\$vw)) || printf('%-\${lw}s%!\${vw}s' || char(10), 'Content Type:', substr(kind,1,\$vw)) || printf('%-\${lw}s%!\${vw}s' || char(10), 'Origin:', substr(origin_label,1,\$vw)) || printf('%-\${lw}s%!\${vw}s' || char(10), 'Characters:', substr(len,1,\$vw)) || printf('%-\${lw}s%!\${vw}s' || char(10), 'Words:', substr(words,1,\$vw)) || printf('%-\${lw}s%!\${vw}s', 'Copied:', substr(age,1,\$vw)) || char(27)||'[0m' FROM c;"
  rm -f "\$wrapfile"
  exit 0
fi
sqlite3 -escape off '$DB_FILE' "WITH c AS (SELECT COALESCE(text_plain,text_preview,'['||type_kind||']') AS body, CASE WHEN COALESCE(text_plain,text_preview) IS NULL OR COALESCE(text_plain,text_preview)='' THEN 1 ELSE length(COALESCE(text_plain,text_preview))-length(replace(COALESCE(text_plain,text_preview),char(10),''))+1 END AS nlines, COALESCE(IFNULL(source_app,'?'),'?') AS app, COALESCE(type_kind,'text') AS kind, COALESCE(len,0) AS len, (${words_expr}) AS words, (${age_expr})||' ago' AS age, CASE WHEN ${remote_when} THEN 'remote ('||(CASE WHEN length(source_host)>9 THEN substr(source_host,1,4)||'…'||substr(source_host,-3) ELSE source_host END)||')' ELSE 'local' END AS origin_label FROM clips WHERE id=\$id) SELECT body || char(10) || replace(printf('%*s', MAX(0, \$ph - nlines - 6), ' '), ' ', char(10)) || char(27)||'[38;2;127;132;156m' || printf('%-\${lw}s%!\${vw}s' || char(10), 'Source:', substr(app,1,\$vw)) || printf('%-\${lw}s%!\${vw}s' || char(10), 'Content Type:', substr(kind,1,\$vw)) || printf('%-\${lw}s%!\${vw}s' || char(10), 'Origin:', substr(origin_label,1,\$vw)) || printf('%-\${lw}s%!\${vw}s' || char(10), 'Characters:', substr(len,1,\$vw)) || printf('%-\${lw}s%!\${vw}s' || char(10), 'Words:', substr(words,1,\$vw)) || printf('%-\${lw}s%!\${vw}s', 'Copied:', substr(age,1,\$vw)) || char(27)||'[0m' FROM c;"
EOF

# --- run --------------------------------------------------------------------
# PICK_CLIPBOARD_NO_RUN (test-only escape hatch): skip the interactive fzf
# session entirely. A test harness sources this file with it set so it can
# exercise the functions above (e.g. clip::copy_by_id) directly against a
# seeded DB + faked nc/rsync on PATH, without an fzf process ever starting.
if [[ -n "${PICK_CLIPBOARD_NO_RUN:-}" ]]; then
  return 0 2>/dev/null || exit 0
fi

# Expire staging before rendering rows, so localized entries whose bytes have
# aged out never appear as selectable-but-unrestorable picker results.
clip::cache_sweep

# The markdown accept's "label" is the 󰽛 markdown glyph (U+F0F5B), not a word —
# it rides the label slot so it takes the hint/description foreground.
hints="$(pick::hints "󰌑" paste "󰘵 󰌑" $'\U000F0F5B' "󰘴 O" sticky "󰘴 Y" copy "󰘴 D" remove "󰘴 P" pin)"

pick_args=(
  --header "Clipboard history"
  --hints "$hints"
  --output field:1                 # Enter -> id (we re-fetch text below)
  --field-id 1                     # id is tail field 1 (for recency + resume)
  --key-output alt-enter:field:2       # accept-and-dismiss with the "MD:id" marker
  --key-output ctrl-y:field:3          # accept-and-dismiss with the "CP:id" marker (copy)
  --key-background ctrl-o:field:1      # insert without dismissing (broker hook)
  --on-key-background clip::bg_hook
  --on-items-picked clip::bump_recency
  --cache-state
  --preview "$PREVIEW_CMD"
  --preview-window "${PICK_CLIPBOARD_PREVIEW_WINDOW:-right:45%,noinfo}"
  --info hidden                    # hide the 1/X item counter (top-right)
  # delete / pin run a SQL action AND reload the list in place (fzf
  # execute-silent + reload). {2} is the 2nd \x1f field, "id\x1eMD:id" --
  # del_script/pin_script strip the \x1e-joined suffix back off. Race-free:
  # the SQL runs synchronously in execute-silent before reload re-streams.
  --reload-cmd "bash $emit_script"
  --start-reload                   # load the list via start:reload so the emit
                                   # script runs with FZF_COLUMNS (exact width)
  --key-reload ctrl-d:"bash $del_script {2}"
  --key-reload alt-d:"bash $del_script {2}"
  --key-reload ctrl-p:"bash $pin_script {2}"
)
[[ -n "${PICK_CLIPBOARD_PADDING:-}" ]] && pick_args+=(--padding "${PICK_CLIPBOARD_PADDING}")
[[ -n "${PICK_CLIPBOARD_HEIGHT:-}" ]]   && pick_args+=(--height "${PICK_CLIPBOARD_HEIGHT}")
[[ -n "${PICK_CLIPBOARD_RESUME:-}" ]] && pick_args+=(--resume)
(( no_border )) && pick_args+=(--no-border)   # --no-border flag or the back-compat env, resolved above

# pick::start prints one accept marker on stdout: the plain id (Enter), "MD:id"
# (Alt-Enter, markdown), or "CP:id" (Ctrl-Y, copy). We re-fetch by id and print
# the appropriate rendering, which zellij-modal's stdout capture injects into
# the originating pane -- EXCEPT Ctrl-Y, which copies to the clipboard (with the
# register type, so a block clip stays block-pasteable) and prints nothing, so
# nothing is injected. pick::start's --copy-only path is not used here.
selected="$(emit_rows | pick::start "${pick_args[@]}")" || exit 130
case "$selected" in
  # LIVE sentinel (§22.4): deliver the already-fetched peer text, then
  # materialize a self-contained local row. Ctrl-Y (CP:) copies + emits nothing;
  # Enter / Alt-Enter inject the text (no rich-vs-raw distinction in a terminal).
  CP:LIVE) clip::copy_live;    clip::materialize_live ;;
  MD:LIVE) clip::deliver_live; clip::materialize_live ;;
  LIVE)    clip::deliver_live; clip::materialize_live ;;
  CP:*)    clip::copy_by_id "${selected#CP:}" ;;
  MD:*)    clip::markdown_by_id "${selected#MD:}" ;;
  "")      ;;
  *)       clip::text_by_id "$selected" ;;
esac

# W2: a Ctrl-Y files-restore failure (rsync pull of a since-vanished remote
# path, a stale localized row, …) used to be unreadable -- its one-line
# reason printed to stderr right as this script exited, and zellij-modal's
# floating pane (close_on_exit) was gone a heartbeat later (validated live
# twice). Hold it on screen instead of letting it vanish with the picker:
# only fires when clip::copy_by_id actually hit a files-restore failure
# above (CLIP_RESTORE_FAILURE non-empty), we're on the interactive path
# (never --restore-id/hs.task, which already exited long before this line),
# and a real terminal is attached to hold against. The success path is
# untouched -- CLIP_RESTORE_FAILURE stays empty, this is a no-op, instant
# dismiss exactly like before.
if clip::should_hold_on_restore_failure "$CLIP_RESTORE_FAILURE" 0; then
  clip::render_restore_failure "$CLIP_RESTORE_FAILURE" "$CLIP_RESTORE_FALLBACK_OK"
  read -k1 -s < /dev/tty || true
  exit 1
fi
