#!/usr/bin/env zsh
# ai-assist-shell — the agent's own shell for one request.
#
# A persistent shell, seeded with the origin pane's environment + cwd, driven
# over a command FIFO. Each job runs in a subshell via `eval` with its output
# captured to a per-job reply dir; cwd and exported vars are propagated back via
# a state file so cd/exports persist across jobs while `exit N` from user code
# is captured as the job's exit code rather than terminating this process. This
# is the engine behind `ai-assist-run`. NOT a sandbox — commands run for real.
set -uo pipefail

cmd_fifo="" env_file="" cwd="" rc="" run_dir="${AI_ASSIST_RUN_DIR:-}" shell_init=""
while (($#)); do
  case "$1" in
    --cmd-fifo)   cmd_fifo="${2:-}"; shift 2 ;;
    --env-file)   env_file="${2:-}"; shift 2 ;;
    --cwd)        cwd="${2:-}"; shift 2 ;;
    --rc)         rc="${2:-}"; shift 2 ;;
    --run-dir)    run_dir="${2:-}"; shift 2 ;;
    --shell-init) shell_init="${2:-}"; shift 2 ;;
    *)            shift ;;
  esac
done
[[ -n "$cmd_fifo" ]] || { print -ru2 -- "ai-assist-shell: --cmd-fifo required"; exit 2; }

# Interactive backend (Stage 1, opt-in via AI_ASSIST_SHELL_INTERACTIVE=1): host a
# real login-interactive zsh inside a zsh/zpty so the agent's shell mirrors the
# user's environment (functions, aliases, dir-managers). Satisfies every contract
# the eval-loop does; the eval-loop below stays the default until a later stage.
# Falls back to the eval-loop (with a warning) if zsh/zpty is unavailable.
if [[ "${AI_ASSIST_SHELL_INTERACTIVE:-}" == 1 ]]; then
  if zmodload zsh/zpty 2>/dev/null; then
    # ---- zpty controller -----------------------------------------------------
    zpty -d AAS 2>/dev/null  # in case a stale handle survives
    trap 'zpty -d AAS 2>/dev/null; exit 0' INT TERM
    trap 'zpty -d AAS 2>/dev/null' EXIT

    # -b: non-blocking pty — `zpty -r` returns immediately (never hangs).
    zpty -b AAS zsh -il

    w()     { zpty -w AAS "$1"$'\n'; }                                # send a line + ENTER
    flush() { local _o; while zpty -r AAS _o 2>/dev/null; do :; done; }  # non-blocking drain
    # Poll for a flag file while draining the pty so its buffer never fills (a
    # full buffer would block the hosted shell). Bounded; returns when present.
    waitf() {
      local _f="$1" _max="${2:-1000}" _i=0
      while [[ ! -e "$_f" ]] && (( _i < _max )); do flush; sleep 0.02; (( _i++ )); done
      flush
    }

    # Seed in order: quiet the prompt + disable echo, cd, source env-file, source
    # the shell-init dump. Each step drops a sync flag we poll so we know it ran.
    _aas_seed() {  # _aas_seed <line>
      local _sf; _sf="$(mktemp -u)"
      w "$1 ; : > ${(q)_sf}"
      waitf "$_sf"; rm -f "$_sf"
    }
    _aas_seed "stty -echo 2>/dev/null ; PROMPT='' RPROMPT=''"
    [[ -n "$cwd" ]] && _aas_seed "cd -- ${(q)cwd} 2>/dev/null"
    [[ -n "$env_file" && -r "$env_file" ]] && _aas_seed "source ${(q)env_file} 2>/dev/null"
    [[ -n "$shell_init" && -r "$shell_init" ]] && _aas_seed "source ${(q)shell_init} 2>/dev/null"

    _aas_US=$'\x1f' _aas_RS=$'\x1e'
    exec {_aas_fd}<>"$cmd_fifo"
    while IFS= read -r -d "$_aas_RS" _aas_job <&$_aas_fd; do
      _aas_reply="${_aas_job%%${_aas_US}*}"
      _aas_rest="${_aas_job#*${_aas_US}}"
      if [[ "$_aas_rest" == *"${_aas_US}"* ]]; then
        _aas_id="${_aas_rest%%${_aas_US}*}"
        _aas_cmd="${_aas_rest#*${_aas_US}}"
      else
        _aas_id=""
        _aas_cmd="$_aas_rest"
      fi
      [[ -n "$_aas_reply" && -d "$_aas_reply" ]] || continue

      # Build the job line for the hosted shell. The reply path is expanded HERE
      # (by the controller); $? / $_rc etc. stay literal for the hosted shell. The
      # anonymous function with local_options err_return pipe_fail gives set -e /
      # pipefail semantics WITHOUT a subshell — so cd/export from the user's block
      # persist in the one long-lived hosted shell (native value-passing; no state
      # file). nounset is deliberately NOT enabled (user code must not get false
      # unset failures).
      #
      # `exit` is shadowed by a function for the duration of the job: in the
      # persistent hosted shell a bare `exit N` from user code would otherwise KILL
      # the shell (zsh: exit outside a subshell terminates the shell). The shadow
      # records the requested code in _aas_uexit and forces the anon function to
      # stop by `return`ing a non-zero sentinel (210) — so BOTH `exit 0` and
      # `exit N` halt the block immediately (a plain `return ${1:-0}` would let
      # `exit 0` fall through, since err_return only catches non-zero). _aas_uexit
      # is reset to EMPTY before each job; after the anon function the job's code is
      # `${_aas_uexit:-$_rc}` — the user's exit code when exit was called (including
      # `exit 0`, which sets _aas_uexit=0, a non-empty value), else the anon
      # function's own rc (a block that never calls exit is unaffected). The
      # resolution is a plain assignment on its OWN line: a `;`-chained or a
      # standalone `[[ ]] &&` middle line wedges the interactive hosted shell over
      # the pty (it stalls awaiting more input). cd/export made before the exit
      # still persist (anon function, no fork). The shadow is removed right after so
      # it never affects the controller's own bookkeeping.
      #
      # Benign SIGPIPE (141) is mapped to success. LAST_* (and, when an id is
      # present, AAS_OUT_/ERR_/EXIT_<key>) are exported so later jobs can reference
      # them. The trailing `: > done` flag is what the controller polls.
      _aas_r="${(q)_aas_reply}"
      _aas_line='_aas_uexit= ; exit() { _aas_uexit=${1:-0} ; return 210 }
() { setopt local_options err_return pipe_fail ; eval '"${(q)_aas_cmd}"' } > '"$_aas_r"'/out 2> '"$_aas_r"'/err
_rc=$? ; unfunction exit 2>/dev/null
_rc=${_aas_uexit:-$_rc}
[[ $_rc -eq 141 ]] && _rc=0
print -rn -- $_rc > '"$_aas_r"'/exit
export LAST_EXCODE=$_rc LAST_STDOUT="$(< '"$_aas_r"'/out)" LAST_STDERR="$(< '"$_aas_r"'/err)"'
      if [[ -n "$_aas_id" ]]; then
        _aas_key="${_aas_id//[^A-Za-z0-9_]/_}"
        _aas_line+='
export AAS_OUT_'"$_aas_key"'="$(< '"$_aas_r"'/out)" AAS_ERR_'"$_aas_key"'="$(< '"$_aas_r"'/err)" AAS_EXIT_'"$_aas_key"'=$_rc'
      fi
      _aas_line+='
: > '"$_aas_r"'/done'
      w "$_aas_line"

      # There is no per-job pid here (the job is the hosted shell's foreground),
      # so a stop request arrives as a FLAG file: the broker touches
      # $run_dir/<id>.stop. Each poll iteration checks BOTH the timeout deadline
      # and the stop flag; whichever fires first sends ^C to interrupt the
      # foreground job. Timeout → 124, stop → 143 (SIGTERM-class: the pager treats
      # >128 as "stopped — no auto-follow-up"). The two are kept distinct.
      _aas_max="${AI_ASSIST_RUN_TIMEOUT:-120}"
      _aas_stopf=""
      [[ -n "$_aas_id" && -n "$run_dir" && -d "$run_dir" ]] && _aas_stopf="$run_dir/${_aas_id}.stop"
      _aas_el=0 _aas_timedout=0 _aas_stopped=0
      while [[ ! -e "$_aas_reply/done" ]]; do
        flush; sleep 0.1
        _aas_el=$(( _aas_el + 1 ))
        if [[ -n "$_aas_stopf" && -e "$_aas_stopf" ]]; then
          _aas_stopped=1
          zpty -w AAS $'\003'           # ^C — interrupt the foreground job
          break
        fi
        if (( _aas_el >= _aas_max * 10 )); then
          _aas_timedout=1
          zpty -w AAS $'\003'           # ^C — interrupt the foreground job
          break
        fi
      done
      if (( _aas_timedout || _aas_stopped )); then
        # ^C aborts the interrupted job at the interactive prompt, so the hosted
        # shell will NOT run the rest of the job line (no done flag drop). Give it
        # a brief grace window (in case the eval finished concurrently with the
        # ^C and the flag is about to appear), then synthesize the reply files and
        # record the contract code (124 timeout / 143 stop). Re-sync the hosted
        # shell to a clean prompt with our own sync flag so the next job starts
        # cleanly, then clear the stop flag (best-effort).
        _aas_g=0
        while [[ ! -e "$_aas_reply/done" ]] && (( _aas_g < 5 )); do flush; sleep 0.1; (( _aas_g++ )); done
        [[ -e "$_aas_reply/out" ]] || : > "$_aas_reply/out"
        [[ -e "$_aas_reply/err" ]] || : > "$_aas_reply/err"
        if (( _aas_stopped )); then
          print -rn -- 143 > "$_aas_reply/exit"
        else
          print -rn -- 124 > "$_aas_reply/exit"
        fi
        _aas_seed "true"   # drain any residual prompt output; resync the shell
        [[ -n "$_aas_stopf" ]] && rm -f "$_aas_stopf"
        : > "$_aas_reply/done"
      fi
    done
    exit 0
  else
    print -ru2 -- "ai-assist-shell: zsh/zpty unavailable; falling back to non-interactive eval-loop"
  fi
fi

# Kill a process and all its descendants (depth-first). Used to enforce the
# execution timeout and to honor an external stop. No process groups: this shell
# is spawned without a controlling tty, so `set -m` is unavailable.
_aas_kill_tree() {
  local _p="$1" _sig="${2:-TERM}" _c
  for _c in ${(f)"$(pgrep -P "$_p" 2>/dev/null)"}; do _aas_kill_tree "$_c" "$_sig"; done
  kill -"$_sig" "$_p" 2>/dev/null
}

# Seed: optional rc (functions/aliases), then the captured env (live exported
# state wins over rc), then cd. rc-sourcing is opt-in (the env-fidelity knob):
# many interactive rc files misbehave when sourced non-interactively.
[[ -n "$rc" && -r "$rc" ]] && { emulate zsh -c "source '$rc'"; } 2>/dev/null
[[ -n "$env_file" && -r "$env_file" ]] && source "$env_file" 2>/dev/null
# --shell-init: the captured live aliases/functions dump (Stage 3). Source it
# AFTER the env-file so both backends pick up the user's ad-hoc env. Functions
# resolve here; alias expansion in this non-interactive eval-loop is limited
# (the zpty backend is the authoritative path for aliases).
[[ -n "$shell_init" && -r "$shell_init" ]] && source "$shell_init" 2>/dev/null
[[ -n "$cwd" ]] && cd -- "$cwd" 2>/dev/null

# Directory-scoped env-manager re-sync hooks: snippets eval'd after each block so
# a config change (e.g. `mise use …`) refreshes PATH for the next block — the
# precmd-equivalent for this prompt-less shell. Override via AI_ASSIST_ENV_HOOKS
# (newline-separated snippets; set it to "" to disable). Default covers mise+direnv.
if [[ -n "${AI_ASSIST_ENV_HOOKS+set}" ]]; then
  _aas_env_hooks="$AI_ASSIST_ENV_HOOKS"
else
  _aas_env_hooks='command -v mise   >/dev/null 2>&1 && eval "$(mise hook-env -s zsh 2>/dev/null)" 2>/dev/null
command -v direnv >/dev/null 2>&1 && eval "$(direnv export zsh 2>/dev/null)" 2>/dev/null'
fi

# State file: persists cwd and exported vars across jobs. Seeded with the
# current env (post rc/env-file/cwd). Each job subshell sources it before
# running and writes it back after — so cd and export persist across jobs even
# though each job runs in its own subshell (needed to contain `exit N`).
_aas_state="$(mktemp)"
trap 'rm -f -- "$_aas_state" "${_aas_tmp:-}"; exit 0' INT TERM
trap 'rm -f -- "$_aas_state" "${_aas_tmp:-}"' EXIT
{ print -r -- "cd -- ${(q)PWD}"; export -p; } > "$_aas_state"

_aas_US=$'\x1f' _aas_RS=$'\x1e'
exec {_aas_fd}<>"$cmd_fifo"
while IFS= read -r -d "$_aas_RS" _aas_job <&$_aas_fd; do
  _aas_reply="${_aas_job%%${_aas_US}*}"
  _aas_rest="${_aas_job#*${_aas_US}}"
  if [[ "$_aas_rest" == *"${_aas_US}"* ]]; then
    _aas_id="${_aas_rest%%${_aas_US}*}"
    _aas_cmd="${_aas_rest#*${_aas_US}}"
  else
    _aas_id=""
    _aas_cmd="$_aas_rest"
  fi
  [[ -n "$_aas_reply" && -d "$_aas_reply" ]] || continue
  # Run in a subshell so `exit N` from user code is captured as the exit code
  # rather than terminating this persistent process. The subshell restores the
  # previous job's cwd/env from the state file, runs the command, then writes
  # the updated env back so cd and export persist across jobs. Note: a job that
  # calls `exit N` early is recorded with that exit code, but any cwd/env changes
  # made before the early exit are not persisted (shell-in-a-script semantics).
  (
    source "$_aas_state" 2>/dev/null
    set +u  # user commands must not inherit the runner's nounset (false failures)
    set -e  # fail the block at the FIRST failing command — a later success in a
            # multi-command block must not mask an earlier failure. (A block can
            # opt out of a deliberate non-zero with `… || true`.)
    eval "$_aas_cmd"
    _aas_rc=$?  # capture BEFORE the resync/state-write below, or they mask it
    set +e  # housekeeping below must not trip errexit or change the block's exit
    # Re-sync directory-scoped env managers so a config change made by THIS block
    # (e.g. `mise use cmake@X`) is visible to later blocks. The interactive shell
    # does this in a precmd hook; this eval loop has no prompt, so we do it here.
    eval "$_aas_env_hooks" 2>/dev/null  # dir-env re-sync (mise/direnv/…); see AI_ASSIST_ENV_HOOKS
    { print -r -- "cd -- ${(q)PWD}"; export -p; } > "$_aas_state"
    exit $_aas_rc  # the job's exit is the user command's, not the housekeeping's
  ) >"$_aas_reply/out" 2>"$_aas_reply/err" &
  _aas_pid=$!
  # Publish the pid so a stop action (broker) can interrupt this run by id.
  [[ -n "$_aas_id" && -n "$run_dir" && -d "$run_dir" ]] &&
    print -rn -- "$_aas_pid" > "$run_dir/${_aas_id}.pid"
  # Real execution timeout: poll, and kill the job tree if it overruns. This is
  # what actually bounds runtime — ai-assist-run's wait is only a backstop.
  _aas_max="${AI_ASSIST_RUN_TIMEOUT:-120}"
  _aas_el=0 _aas_timedout=0
  while kill -0 "$_aas_pid" 2>/dev/null; do
    sleep 0.1
    _aas_el=$(( _aas_el + 1 ))
    if (( _aas_el >= _aas_max * 10 )); then
      _aas_timedout=1
      _aas_kill_tree "$_aas_pid" TERM
      sleep 0.5; _aas_kill_tree "$_aas_pid" KILL
      break
    fi
  done
  wait "$_aas_pid"; _aas_code=$?
  [[ -n "$_aas_id" && -n "$run_dir" ]] && rm -f "$run_dir/${_aas_id}.pid"
  (( _aas_timedout )) && _aas_code=124  # report a timeout as 124, not the signal
  # Treat benign SIGPIPE (128+13) as success: a producer killed because a
  # downstream `| head` / `| grep -q` closed the pipe early is not a failure.
  [[ "$_aas_code" -eq 141 ]] && _aas_code=0
  print -rn -- "$_aas_code" >"$_aas_reply/exit"
  # Inject LAST_* into the state file so the next job can reference them.
  # Use a temp file to avoid corrupting state on write failure.
  _aas_tmp="$(mktemp)"
  {
    print -r -- "$(<"$_aas_state")"
    print -r -- "export LAST_EXCODE=${(q)_aas_code}"
    print -r -- "export LAST_STDOUT=${(q)$(<"$_aas_reply/out")}"
    print -r -- "export LAST_STDERR=${(q)$(<"$_aas_reply/err")}"
    if [[ -n "$_aas_id" ]]; then
      _aas_key="${_aas_id//[^A-Za-z0-9_]/_}"
      print -r -- "export AAS_OUT_${_aas_key}=${(q)$(<"$_aas_reply/out")}"
      print -r -- "export AAS_ERR_${_aas_key}=${(q)$(<"$_aas_reply/err")}"
      print -r -- "export AAS_EXIT_${_aas_key}=${(q)_aas_code}"
    fi
  } > "$_aas_tmp" && mv "$_aas_tmp" "$_aas_state"
  : >"$_aas_reply/done"
done
rm -f "$_aas_state"
