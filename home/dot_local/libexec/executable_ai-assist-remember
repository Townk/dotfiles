#!/usr/bin/env zsh
# ai-assist-remember — append a distilled fact to the project knowledge base.
# Self-contained (runs in the bare docked pane); mirrors assist::kb_path.
set -uo pipefail

project="${AI_ASSIST_PROJECT_ROOT:-$PWD}"
while (($#)); do
  case "$1" in
    --project) project="${2:-}"; shift 2 ;;
    --) shift; break ;;
    -*) shift ;;
    *) break ;;
  esac
done
fact="${1:-}"
[[ -n "$fact" ]] || { print -ru2 -- "ai-assist-remember: empty fact"; exit 2; }

data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/ai-assist"
key="$(printf '%s' "$project" | shasum -a 1 | awk '{print $1}')"
kb="$data_dir/projects/$key/knowledge.md"
mkdir -p "${kb:h}"
print -r -- "- $fact" >> "$kb"
