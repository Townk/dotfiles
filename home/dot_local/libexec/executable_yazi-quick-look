#!/usr/bin/env zsh
#
# yazi-quick-look — yazi's Ctrl+Space "Quick Look" dispatcher.
#
# Local macOS GUI session: Quick Look via LaunchServices (`open -n
# qlmanage.app --args -p`). qlmanage must NOT be exec'd straight from a yazi
# task: a child of a background terminal process gets no window activation
# (the panel opens behind every window), and on macOS 26.5 the Movie
# generator aborts — AVKit throws "Setting highlightedTimeRanges is not
# supported in your app" — when qlmanage inherits the terminal as its
# responsible process, so video files crashed the panel outright. Launched
# as its own app via LaunchServices both problems vanish, and `open`
# returns at once so no yazi task lingers while the panel is up.
#
# The LaunchServices launch severs TCC inheritance though: qlmanage owns
# no file-access grants of its own, so in TCC-protected folders
# (~/Downloads, ~/Documents, ...) it can't read the file — panels render
# as bare metadata cards, and the image generators (jpeg, png) abort
# outright (QLTryCatchAndCrash). Staging each file into unprotected
# $TMPDIR by hardlink (same inode — free on the same APFS volume; cp as
# the cross-volume fallback) restores real renders everywhere.
#
# There is deliberately NO crash-watchdog fallback to the floating pane
# on this branch: closing the panel within any watchdog window is
# indistinguishable from a crash, so the fallback fired a spurious pane
# right after a normal close. The pane is gated to sessions where Quick
# Look can't reach the screen at all.
#
# SSH or non-macOS: Quick Look can't reach this screen — float the unified
# `preview` render in the mux instead (same UX as the fzf-tab floating
# preview): a zellij float or a tmux popup, whichever backend this pane is
# in. Outside any mux there is nowhere to draw either → quiet no-op.

emulate -L zsh
set -u

QL_APP="/System/Library/Frameworks/QuickLook.framework/Versions/A/Resources/qlmanage.app"
# Matches our panel instances (and stale `qlmanage -p` ones) but not the
# `qlmanage -t` office thumbnailers the `preview` script may be running.
QL_MATCH='qlmanage -p '

# Hardlink (or copy) regular files into a private stage dir and fill
# $staged with the panel-safe paths. Non-regular targets and staging
# failures pass the original path through. Basenames are kept (they title
# the panel); collisions get an index prefix. The stage is rebuilt per
# press — the previous panel is already dead (pkill) by the time it runs.
typeset -ga staged
stage_for_panel() {
  local dir="${TMPDIR:-/tmp}/yazi-quick-look" f dst
  local -i i=0
  rm -rf "$dir"
  mkdir -p "$dir"
  staged=()
  for f in "$@"; do
    (( ++i ))
    if [[ ! -f "$f" ]]; then
      staged+=("$f")
      continue
    fi
    dst="$dir/${f:t}"
    [[ -e "$dst" ]] && dst="$dir/$i-${f:t}"
    if ln "$f" "$dst" 2>/dev/null || cp "$f" "$dst" 2>/dev/null; then
      staged+=("$dst")
    else
      staged+=("$f")
    fi
  done
}

main() {
  (( $# )) || return 0

  if [[ -z "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" \
        && "$OSTYPE" == darwin* && -d "$QL_APP" ]]; then
    # Replace any panel already up instead of stacking one instance per
    # keypress.
    pkill -f "$QL_MATCH" 2>/dev/null
    stage_for_panel "$@"
    exec open -n "$QL_APP" --args -p "${staged[@]}"
  fi

  # Quick Look cannot reach this screen (SSH or non-macOS): fall back to the
  # terminal viewer, the same one Ctrl+O and CMD+click use. Only INSIDE a mux
  # though — with no tab or float to put it in, term-quick-view would render
  # inline over yazi's own UI. Outside one this stays a quiet no-op.
  if [[ -n "${TMUX:-}${ZELLIJ:-}" ]] && command -v term-quick-view >/dev/null 2>&1; then
    term-quick-view "$1"
    return $?
  fi

  return 0
}

[[ -n ${YAZI_QUICK_LOOK_NO_RUN:-} ]] || main "$@"
