#!/usr/bin/env zsh
# ai-assist-docs — quick, offline command docs for the assist agents. Tries
# tealdeer (tldr) first, then the command's own --help/-h. Prints the docs and
# exits 0 on a hit; prints nothing and exits 1 on a total miss.
set -uo pipefail
cmd="${1:-}"
[[ -n "$cmd" ]] || { print -ru2 -- "ai-assist-docs: no command given"; exit 2; }

if command -v tldr >/dev/null 2>&1; then
  # tealdeer uses its local cache by default (no network unless --update); it has
  # no --offline flag (passing one errors out). `--` guards a cmd starting with -.
  if out="$(tldr -- ${=cmd} 2>/dev/null)" && [[ -n "$out" ]]; then
    # tealdeer "alias pages" (e.g. `convert`) carry no real docs — they say
    # "This command is an alias of `<target>`" and end with a `tldr <target>`
    # pointer. Follow that ONE hop to the target's actual page, which is what the
    # agent actually needs. Parse on an ANSI-stripped copy (tealdeer may colour).
    plain="$(print -r -- "$out" | sed $'s/\x1b\\[[0-9;]*m//g')"
    if print -r -- "$plain" | grep -qi 'alias of'; then
      target="$(print -r -- "$plain" \
        | sed -n 's/^[[:space:]]*tldr \(.*[^[:space:]]\)[[:space:]]*$/\1/p' | head -1)"
      if [[ -n "$target" && "$target" != "$cmd" ]]; then
        if real="$(tldr -- ${=target} 2>/dev/null)" && [[ -n "$real" ]]; then
          print -r -- "$real"; exit 0
        fi
      fi
    fi
    print -r -- "$out"; exit 0
  fi
fi
if command -v -- "$cmd" >/dev/null 2>&1; then
  for flag in --help -h; do
    if out="$("$cmd" "$flag" 2>/dev/null)" && [[ -n "$out" ]]; then
      print -r -- "$out"; exit 0
    fi
  done
fi
exit 1
