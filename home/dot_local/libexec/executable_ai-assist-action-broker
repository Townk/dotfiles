#!/usr/bin/env zsh
# ai-assist-action-broker — reads <kind>US<id>US<payload>RS action records the
# pager writes to a FIFO and performs them: `copy` (clipboard, or OSC 52 over
# SSH), `play` (type the block into the origin pane and run it), or `run`
# (execute via ai-assist-run in the agent shell and emit a result record).
# Spawned by ai-assist-render, which owns the FIFO lifecycle and kills this on
# pane exit. Self-contained (runs in the bare docked pane): no library sourcing,
# zellij by absolute path. Every action is best-effort — a missing tool is a
# silent no-op, never a crash.
set -uo pipefail

US=$'\x1f' RS=$'\x1e'
# Debug logging is OFF unless AI_ASSIST_DEBUG_LOG (or AI_ASSIST_BROKER_LOG) is set.
AI_ASSIST_BROKER_LOG="${AI_ASSIST_BROKER_LOG:-${AI_ASSIST_DEBUG_LOG:-}}"
# Re-export the resolved log path so the helpers we spawn (followup/wrapup/
# regenerate) log to the SAME file — they read AI_ASSIST_DEBUG_LOG, which may not
# have survived the env path down to here.
[[ -n "$AI_ASSIST_BROKER_LOG" ]] && export AI_ASSIST_DEBUG_LOG="$AI_ASSIST_BROKER_LOG"
_log() { [[ -n "${AI_ASSIST_BROKER_LOG:-}" ]] && print -r -- "$(date +%H:%M:%S) [broker] $*" >> "$AI_ASSIST_BROKER_LOG"; }
_dbg() { _log "$@"; }
fifo="" origin="" over_ssh=0
results="" shell_fifo="" run_dir="${AI_ASSIST_RUN_DIR:-}"
input_fifo="" regen_ctx="" regen_req="" regen_request=""

# broker::input_error — write a visible warning to the input FIFO so the pager
# is unblocked and displays the error instead of hanging on an empty read.
# Writing (and closing) the FIFO unblocks the pager's blocking open() on the
# read end and stops the spinner. No-op when input_fifo is unset or the write
# fails (best-effort).
broker::input_error() { [[ -n "$input_fifo" ]] && printf '\n\n> ⚠ %s\n' "$1" > "$input_fifo" 2>/dev/null || true; }
while (($#)); do
  case "$1" in
    --fifo)            fifo="${2:-}"; shift 2 ;;
    --origin-pane)     origin="${2:-}"; shift 2 ;;
    --over-ssh)        over_ssh=1; shift ;;
    --results-fifo)    results="${2:-}"; shift 2 ;;
    --shell-fifo)      shell_fifo="${2:-}"; shift 2 ;;
    --run-dir)         run_dir="${2:-}"; shift 2 ;;
    --input-fifo)      input_fifo="${2:-}"; shift 2 ;;
    --regen-ctx)       regen_ctx="${2:-}"; shift 2 ;;
    --regen-req)       regen_req="${2:-}"; shift 2 ;;
    --regen-request)   regen_request="${2:-}"; shift 2 ;;
    *)                 shift ;;
  esac
done
_log "start: fifo=$fifo origin=$origin shell_fifo='${shell_fifo:-EMPTY}' results='${results:-EMPTY}' input_fifo='${input_fifo:-EMPTY}'"

# zellij by absolute path (the docked pane's PATH is the minimal daemon one).
zj=""
for _z in "${commands[zellij]:-}" /opt/homebrew/bin/zellij /usr/local/bin/zellij \
          /snap/bin/zellij "$HOME/.local/bin/zellij"; do
  [[ -n "$_z" && -x "$_z" ]] && { zj="$_z"; break; }
done

# Local clipboard command (empty if none available).
clip=""
for _c in pbcopy wl-copy "xclip -selection clipboard"; do
  command -v "${_c%% *}" >/dev/null 2>&1 && { clip="$_c"; break; }
done

# Diff viewer (delta if present, else less).
viewer=""
for _v in "${commands[delta]:-}" /opt/homebrew/bin/delta /usr/local/bin/delta; do
  [[ -n "$_v" && -x "$_v" ]] && { viewer="$_v --paging=always"; break; }
done
[[ -n "$viewer" ]] || viewer="less"

# Hunk binary (overridable via AI_ASSIST_HUNK_BIN for tests; empty if not installed).
hunk_bin="${AI_ASSIST_HUNK_BIN:-}"
if [[ -z "$hunk_bin" ]]; then
  for _h in "${commands[hunk]:-}" /opt/homebrew/bin/hunk /usr/local/bin/hunk; do
    [[ -n "$_h" && -x "$_h" ]] && { hunk_bin="$_h"; break; }
  done
fi

# broker::copy — local clipboard, or OSC 52 to the tty over SSH.
broker::copy() {
  local payload="$1"
  if (( over_ssh )); then
    local b64; b64="$(print -rn -- "$payload" | base64 | tr -d '\n')"
    printf '\e]52;c;%s\a' "$b64" > "${AI_ASSIST_BROKER_TTY:-/dev/tty}" 2>/dev/null
  elif [[ -n "$clip" ]]; then
    print -rn -- "$payload" | ${(z)clip}
  fi
}

# broker::play — paste the payload into the origin pane, then submit with CR.
# The payload is wrapped in bracketed-paste markers (ESC[200~ … ESC[201~) so a
# multi-line block enters the shell as ONE multi-line command buffer — exactly
# like a terminal paste — instead of each embedded newline submitting a line on
# its own. The trailing CR then runs the whole buffer as a single command.
broker::play() {
  local payload="$1"
  [[ -n "$zj" && -n "$origin" ]] || return 0
  "$zj" action write --pane-id "$origin" 27 91 50 48 48 126 2>/dev/null  # ESC[200~ paste-start
  "$zj" action write-chars --pane-id "$origin" -- "$payload" 2>/dev/null
  "$zj" action write --pane-id "$origin" 27 91 50 48 49 126 2>/dev/null  # ESC[201~ paste-end
  "$zj" action write --pane-id "$origin" 13 2>/dev/null                  # 13 = CR = Enter
}

# broker::open_diff — open the patch side-by-side in a large floating zellij
# pane via hunk (--mode split) or the viewer fallback, anchored to the project
# root. Replaces broker::view_diff and broker::review_diff.
broker::open_diff() {
  local id="$1" diff="$2"
  [[ -n "$zj" ]] || return 0
  local patch; patch="$(mktemp "${TMPDIR:-/tmp}/ai-playbook-diff.XXXXXX")"
  print -r -- "$diff" > "$patch"  # trailing newline — git apply rejects a patch without one
  _dbg "open_diff id=$id patch=$patch bytes=$(wc -c < "$patch")"
  if [[ -n "$hunk_bin" ]]; then
    "$zj" action new-pane --floating --width 90% --height 90% --close-on-exit \
      --cwd "${AI_ASSIST_PROJECT_ROOT:-$PWD}" --name "diff:$id" \
      -- "$hunk_bin" patch --mode split "$patch" 2>/dev/null || true
  else
    # Prefer delta --side-by-side when delta is the viewer; else plain viewer.
    local _viewer_cmd
    if [[ "${viewer%% *}" == *delta* ]]; then
      _viewer_cmd="${viewer%% *} --side-by-side"
    else
      _viewer_cmd="${(z)viewer}"
    fi
    "$zj" action new-pane --floating --width 90% --height 90% --close-on-exit \
      --cwd "${AI_ASSIST_PROJECT_ROOT:-$PWD}" --name "diff:$id" \
      -- ${(z)_viewer_cmd} "$patch" 2>/dev/null || true
  fi
}

# broker::git_apply — write the patch and run `git apply` in the agent shell via
# ai-assist-run, then emit a result record (id/exit/logpath) on the results FIFO.
# Best-effort. Extra flags (e.g. --reverse for undo) are passed after $2.
# --recount: infer hunk line counts from the body instead of trusting the @@
# headers — agent-authored diffs reliably miscount hunks, and a wrong count makes
# git read past the hunk into the next @@ → "corrupt patch at :<line>"; the body
# itself is correct, so recounting applies it. --ignore-whitespace forgives
# context-line whitespace drift, another common authoring slip.
broker::git_apply() {
  local id="$1" diff="$2"; shift 2
  local extra="$*"   # e.g. "--reverse"
  [[ -n "$shell_fifo" ]] || return 0
  local run="${AI_ASSIST_RUN_BIN:-}"
  if [[ -z "$run" ]]; then
    for c in "$HOME/.local/libexec/ai-assist-run" "${commands[ai-assist-run]:-}"; do
      [[ -n "$c" && -x "$c" ]] && { run="$c"; break; }
    done
  fi
  [[ -n "$run" && -x "$run" ]] || return 0
  local patch; patch="$(mktemp "${TMPDIR:-/tmp}/ai-playbook-apply.XXXXXX")"
  print -r -- "$diff" > "$patch"  # trailing newline — git apply rejects a patch without one
  local log; log="$(mktemp "${TMPDIR:-/tmp}/ai-playbook-run.XXXXXX")"
  AI_ASSIST_SHELL_FIFO="$shell_fifo" "$run" --id "$id" -- \
    "git apply --recount --ignore-whitespace ${extra:+$extra }-- ${(q)patch}" >"$log" 2>&1
  local code=$?
  [[ -n "$results" ]] && print -rn -- "${id}${US}${code}${US}${log}${RS}" >> "$results"
}

# broker::apply_diff — apply a patch; broker::undo_diff — reverse it (apply⇄undo
# toggle). Both emit a result record so the pager can flip the button + re-gate
# dependents (a {needs=<id>} block re-locks when the patch is undone).
broker::apply_diff() { broker::git_apply "$1" "$2"; }
broker::undo_diff()  { broker::git_apply "$1" "$2" --reverse; }

# broker::run_block — execute a block in the agent shell via ai-assist-run, then
# emit a result record (id/exit/logpath) on the results FIFO. Best-effort.
# Runs asynchronously so a hung ai-assist-run cannot block the dispatch loop.
broker::run_block() {
  local id="$1" payload="$2"
  _log "run_block id=${id} shell_fifo=${shell_fifo:-EMPTY}"
  if [[ -z "$shell_fifo" ]]; then
    _log "run_block id=${id} NO_SHELL"
    [[ -n "$results" ]] && print -rn -- "${id}${US}1${US}/dev/null${RS}" >> "$results"
    return 0
  fi
  {
    local run="${AI_ASSIST_RUN_BIN:-}"
    if [[ -z "$run" ]]; then
      for c in "$HOME/.local/libexec/ai-assist-run" "${commands[ai-assist-run]:-}"; do
        [[ -n "$c" && -x "$c" ]] && { run="$c"; break; }
      done
    fi
    if [[ -z "$run" || ! -x "$run" ]]; then
      _log "run_block id=${id} NO_RUN_BIN"
      return 0
    fi
    local log; log="$(mktemp "${TMPDIR:-/tmp}/ai-playbook-run.XXXXXX")"
    _log "run start id=${id}"
    AI_ASSIST_SHELL_FIFO="$shell_fifo" "$run" --id "$id" -- "$payload" >"$log" 2>&1
    local code=$?
    _log "run done id=${id} exit=${code}"
    [[ -n "$results" ]] && print -rn -- "${id}${US}${code}${US}${log}${RS}" >> "$results"
    # Append a run-log line so ai-assist-wrapup / ai-assist-followup can report outcomes.
    [[ -n "$run_dir" ]] && printf '{"id":"%s","exit":%s,"ts":"%s","log":"%s"}\n' \
      "$id" "$code" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$log" >> "$run_dir/runlog.jsonl" 2>/dev/null || true
  } &
}

# broker::kill_tree — kill a process and all its descendants (depth-first).
broker::kill_tree() {
  local p="$1" sig="${2:-TERM}" c
  for c in ${(f)"$(pgrep -P "$p" 2>/dev/null)"}; do broker::kill_tree "$c" "$sig"; done
  kill -"$sig" "$p" 2>/dev/null
}

# broker::stop_block — interrupt a running block. Covers BOTH shell backends:
#   * eval-loop (default): the agent shell published the job's pid to
#     $run_dir/<id>.pid; kill the whole tree. Its wait then returns and the
#     normal result record (non-zero exit) flows back, flipping the block out of
#     "running".
#   * zpty interactive: the job is the hosted shell's foreground process (no
#     per-job pid). The controller polls for $run_dir/<id>.stop and sends ^C when
#     it appears, recording exit 143. So touch the stop flag too.
# The flag is touched whether or not a pidfile exists (the two backends are
# mutually exclusive at runtime; touching both is harmless and backend-agnostic).
broker::stop_block() {
  local id="$1" pidfile="${run_dir:+$run_dir/${1}.pid}" stopflag="${run_dir:+$run_dir/${1}.stop}" pid
  _log "stop_block id=${id} pidfile=${pidfile:-EMPTY} stopflag=${stopflag:-EMPTY}"
  # zpty backend: signal the controller via the stop flag (best-effort).
  [[ -n "$stopflag" ]] && : > "$stopflag" 2>/dev/null
  # eval-loop backend: kill the published job tree.
  if [[ -n "$pidfile" && -r "$pidfile" ]]; then
    pid="$(<"$pidfile")"
    if [[ -n "$pid" ]]; then
      broker::kill_tree "$pid" TERM
      _log "stop_block id=${id} killed pid=${pid}"
    fi
  else
    _log "stop_block id=${id} NO_PIDFILE"
  fi
}

# broker::regenerate — invoke ai-assist-regenerate in the background to re-run
# the original request and stream the fresh result into the input FIFO (same
# pane, no respawn). Runs in the background because the agent run takes seconds
# and the broker loop must remain responsive to other actions (copy/play/diff)
# while the re-run is in flight. Best-effort: guard checks ensure all required
# context is present and the helper is executable before launching.
broker::regenerate() {
  local regen_bin="${AI_ASSIST_REGENERATE_BIN:-}"
  if [[ -z "$regen_bin" ]]; then
    for _r in \
      "$(command -v ai-assist-regenerate 2>/dev/null)" \
      "$HOME/.local/libexec/ai-assist-regenerate"; do
      [[ -n "$_r" && -x "$_r" ]] && { regen_bin="$_r"; break; }
    done
  fi
  [[ -n "$regen_ctx" && -n "$regen_req" && -n "$input_fifo" && -n "$regen_bin" && -x "$regen_bin" ]] || return 0
  _log "regenerate: ctx=$regen_ctx req=$regen_req input_fifo=$input_fifo origin=${origin:-EMPTY}"
  "$regen_bin" --ctx "$regen_ctx" --req "$regen_req" --input-fifo "$input_fifo" \
    ${origin:+--origin-pane "$origin"} >/dev/null 2>&1 &
}

# broker::wrapup — invoke ai-assist-wrapup in the background to build a
# session summary and stream it into the existing pane via the input FIFO.
# Mirrors broker::regenerate: runs in the background, best-effort guard.
# Guard: input_fifo must be set AND (regen_request OR (regen_ctx AND regen_req))
# must be available so the helper can resolve the original request.
broker::wrapup() {
  local wrapup_bin="${AI_ASSIST_WRAPUP_BIN:-}"
  if [[ -z "$wrapup_bin" ]]; then
    for _w in \
      "$(command -v ai-assist-wrapup 2>/dev/null)" \
      "$HOME/.local/libexec/ai-assist-wrapup"; do
      [[ -n "$_w" && -x "$_w" ]] && { wrapup_bin="$_w"; break; }
    done
  fi
  # Bail out (and unblock the pager) if input_fifo is missing.
  if [[ -z "$input_fifo" ]]; then return 0; fi
  # Bail out with an error if the helper is not resolvable.
  if [[ -z "$wrapup_bin" || ! -x "$wrapup_bin" ]]; then
    broker::input_error "could not start the wrap-up"
    return 0
  fi
  # Bail out with an error if there is no way to resolve the original request.
  if [[ -z "$regen_request" && ( -z "$regen_ctx" || -z "$regen_req" ) ]]; then
    broker::input_error "could not start the wrap-up"
    return 0
  fi
  _log "wrapup: ctx=${regen_ctx:-EMPTY} req=${regen_req:-EMPTY} regen_request=${regen_request:-EMPTY} input_fifo=$input_fifo run_dir=${run_dir:-EMPTY}"
  "$wrapup_bin" \
    ${regen_ctx:+--ctx "$regen_ctx"} \
    ${regen_req:+--req "$regen_req"} \
    --input-fifo "$input_fifo" \
    ${run_dir:+--run-dir "$run_dir"} \
    ${regen_request:+--request-file "$regen_request"} \
    >/dev/null 2>&1 &
}

# broker::followup — invoke ai-assist-followup in the background to re-engage the
# agent with a "the previous fix did not work" prompt when a verify block fails.
# Mirrors broker::wrapup: runs in the background, best-effort guard.
# Guard: input_fifo must be set AND (regen_request OR (regen_ctx AND regen_req))
# must be available so the helper can resolve the original request.
broker::followup() {
  local block_id="$1" failed_cmd="$2"
  local followup_bin="${AI_ASSIST_FOLLOWUP_BIN:-}"
  if [[ -z "$followup_bin" ]]; then
    for _f in \
      "$(command -v ai-assist-followup 2>/dev/null)" \
      "$HOME/.local/libexec/ai-assist-followup"; do
      [[ -n "$_f" && -x "$_f" ]] && { followup_bin="$_f"; break; }
    done
  fi
  # Bail out (and unblock the pager) if input_fifo is missing.
  if [[ -z "$input_fifo" ]]; then return 0; fi
  # Bail out with an error if the helper is not resolvable.
  if [[ -z "$followup_bin" || ! -x "$followup_bin" ]]; then
    broker::input_error "could not start the follow-up"
    return 0
  fi
  # Bail out with an error if there is no way to resolve the original request.
  if [[ -z "$regen_request" && ( -z "$regen_ctx" || -z "$regen_req" ) ]]; then
    broker::input_error "could not start the follow-up"
    return 0
  fi
  _log "followup: ctx=${regen_ctx:-EMPTY} req=${regen_req:-EMPTY} regen_request=${regen_request:-EMPTY} input_fifo=$input_fifo block_id=${block_id} run_dir=${run_dir:-EMPTY}"
  "$followup_bin" \
    ${regen_ctx:+--ctx "$regen_ctx"} \
    ${regen_req:+--req "$regen_req"} \
    --input-fifo "$input_fifo" \
    ${run_dir:+--run-dir "$run_dir"} \
    --block-id "$block_id" --failed-cmd "$failed_cmd" \
    ${regen_request:+--request-file "$regen_request"} \
    >/dev/null 2>&1 &
}

# broker::dispatch — parse one 3-field record and route it.
broker::dispatch() {
  local rec="$1"
  local kind="${rec%%${US}*}"
  local rest="${rec#*${US}}"
  local id="${rest%%${US}*}"
  local payload="${rest#*${US}}"
  payload="${payload%${RS}}"
  case "$kind" in
    copy)        broker::copy "$payload" ;;
    play)        broker::play "$payload" ;;
    run)         broker::run_block "$id" "$payload" ;;
    stop)        broker::stop_block "$id" ;;
    diff)        broker::open_diff "$id" "$payload" ;;
    view-diff)   broker::open_diff "$id" "$payload" ;;  # back-compat alias
    review-diff) broker::open_diff "$id" "$payload" ;;  # back-compat alias
    apply-diff)  broker::apply_diff "$id" "$payload" ;;
    undo-diff)   broker::undo_diff "$id" "$payload" ;;
    regenerate)  broker::regenerate ;;
    wrapup)      broker::wrapup ;;
    followup)    broker::followup "$id" "$payload" ;;
  esac
}

# broker::run — hold the FIFO open read-write so the loop survives the pager's
# open/close per write (no EOF between writes), then dispatch each record.
broker::run() {
  local bfd rec
  exec {bfd}<>"$fifo"
  while IFS= read -r -d $'\x1e' rec <&$bfd; do
    broker::dispatch "$rec"
  done
}

# Main guard: tests source this with AI_ASSIST_BROKER_NORUN=1 to drive the
# functions directly; executed for real it runs the FIFO loop until killed.
if [[ "${AI_ASSIST_BROKER_NORUN:-0}" != 1 ]]; then
  [[ -n "$fifo" ]] || { print -u2 -- "ai-assist-action-broker: --fifo required"; exit 2; }
  broker::run
fi
