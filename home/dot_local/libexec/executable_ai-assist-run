#!/usr/bin/env zsh
# ai-assist-run — run a command in the agent's own shell (ai-assist-shell) and
# return its output. The agent's diagnosis tool and the playbook "run" engine.
set -uo pipefail

json=0
id=""
while (($#)); do
  case "$1" in
    --json) json=1; shift ;;
    --id)   id="${2:-}"; shift 2 ;;
    --)     shift; break ;;
    *)      break ;;
  esac
done
cmd="$*"
[[ -n "$cmd" ]] || { print -ru2 -- "ai-assist-run: no command given"; exit 2; }

fifo="${AI_ASSIST_SHELL_FIFO:-}"
[[ -n "$fifo" && -p "$fifo" ]] || {
  print -ru2 -- "ai-assist-run: no agent shell (AI_ASSIST_SHELL_FIFO unset/missing)."
  exit 3
}

US=$'\x1f' RS=$'\x1e'
reply="$(mktemp -d "${TMPDIR:-/tmp}/ai-assist-run.XXXXXX")"
trap 'rm -rf -- "$reply" 2>/dev/null' EXIT
trap 'rm -rf -- "$reply" 2>/dev/null; exit 130' INT
trap 'rm -rf -- "$reply" 2>/dev/null; exit 143' TERM

local max="${AI_ASSIST_RUN_TIMEOUT:-120}"
print -rn -- "${reply}${US}${id}${US}${cmd}${RS}" > "$fifo"
local elapsed=0 interval=0.02
while [[ ! -e "$reply/done" ]]; do
  sleep "$interval"
  (( elapsed++ ))
  if (( elapsed * interval >= max )); then
    print -ru2 -- "ai-assist-run: timed out after ${max}s (agent shell not responding)"
    exit 124
  fi
done

code="$(<"$reply/exit")"
: "${code:=1}"

if (( json )); then
  require_jq() { command -v jq >/dev/null || { print -ru2 -- "ai-assist-run: jq required for --json"; exit 4; }; }
  require_jq
  out="$(<"$reply/out")"; err="$(<"$reply/err")"
  jq -n --arg o "$out" --arg e "$err" --argjson x "$code" \
        '{stdout:$o, stderr:$e, exit:$x}'
else
  [[ -s "$reply/out" ]] && cat -- "$reply/out"
  [[ -s "$reply/err" ]] && cat -- "$reply/err" >&2
fi
exit "$code"
