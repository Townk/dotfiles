#!/usr/bin/env zsh
# ai-assist-triage — the detached triage orchestrator/router (Phase D).
#
# Spawned disowned by ai-assist-summon so the ZLE widget returns instantly. It
# owns the request lifecycle from the moment the float (ai-assist-input) is up:
#
#   1. Read ONE framed record off the OUT fifo the float writes:
#        submit␟<value>␞   the user pressed Enter
#        cancel␞           the user pressed Esc → dismiss, do nothing
#   2. Finalize request.json with the submitted value.
#   3. Resolve the harness NON-INTERACTIVELY (env → session pin → sole probed).
#      Several available + none pinned → no cheap pass possible without the fzf
#      picker → escalate (safe default; never worse than today).
#   4. Compute context/request hashes (best-effort) and look up the cache BEFORE
#      the cheap model. On a hit, replay by kind and return without classifying.
#   5. Drive the float's spinner with status␟<label>␞ records on the IN fifo,
#      run the harness's cheap `ai-assist-<h> --triage` pass, classify it.
#   6. Send exactly one close␞ to the IN fifo → the float dismisses.
#   7. Route — REUSING THE SAME TWO FIFOS for any docked pane:
#        command  → zellij action write-chars --pane-id <origin> (NO trailing CR)
#        answer   → docked pane: ai-assist-render renders the prose
#        escalate → docked pane: ai-assist-render runs the capable worker
#
# Error posture: any triage failure (no cheap pass / exit 3 / empty / unknown
# harness) routes to ESCALATE. Origin-pane missing → a command renders in the
# docked pager instead of being typed at the prompt.
#
# FIFO contracts honoured (from ai-assist-input, Task 1):
#  • the binary's writeOutFifo blocks until a reader opens OUT → we open OUT
#    read-side (exec {fd}<>) BEFORE reading, so it is always readable.
#  • the binary's readInFifo opens IN fresh per record → we hold IN open
#    read-write (exec {fd}<>) so status/close writes never block on a reader.
set -uo pipefail

source "${AI_ASSIST_LIB_DIR:-$HOME/.local/lib}/assist-agent-common.zsh"

US=$'\x1f'   # field separator inside a record
RS=$'\x1e'   # record terminator

# ── Debug logging (gated on AI_ASSIST_DEBUG_LOG) ─────────────────────────────
_dbg() { [[ -n "${AI_ASSIST_DEBUG_LOG:-}" ]] && printf '[triage %s] %s\n' "$(date -u +%H:%M:%S)" "$*" >> "$AI_ASSIST_DEBUG_LOG" 2>/dev/null || true; }

out_fifo="" in_fifo="" request="" origin_pane=""
while (($#)); do
  case "$1" in
    --out-fifo)    out_fifo="${2:-}"; shift 2 ;;
    --in-fifo)     in_fifo="${2:-}"; shift 2 ;;
    --request)     request="${2:-}"; shift 2 ;;
    --origin-pane) origin_pane="${2:-}"; shift 2 ;;
    *) shift ;;
  esac
done
[[ -n "$out_fifo" && -n "$in_fifo" && -n "$request" ]] || \
  die "usage: ai-assist-triage --out-fifo F --in-fifo G --request R [--origin-pane P]"

# ── IN fifo: hold it open read-write so status/close writes never block ───────
# (the binary opens IN fresh per record; an O_WRONLY open with no reader would
# block, and a write between the binary's per-record opens could SIGPIPE — the
# read-write hold sidesteps both.)
exec {in_fd}<>"$in_fifo"

emit_status() { print -rn -- "status${US}$1${RS}" >&$in_fd; }
emit_close()  { print -rn -- "close${RS}" >&$in_fd; }

# A single cleanup: the orchestrator owns the fifos for the whole request, so we
# remove them when we are truly done. The docked-pane branches pass the SAME
# fifos to ai-assist-render (which is told NOT to remove caller-provided fifos);
# but those branches spawn the pane and return immediately, so we must NOT delete
# the fifos out from under the just-spawned pager. Hence: only the no-pane paths
# (command-at-prompt, cancel) clean up here; the docked-pane paths leave the
# fifos for the pager's own pane lifetime (a stale fifo in TMPDIR is harmless).
cleanup_fifos() { rm -f -- "$out_fifo" "$in_fifo" 2>/dev/null || true; }

# ── 1. Read one record off the OUT fifo ──────────────────────────────────────
# Open OUT read-side FIRST (read-write so we never see premature EOF), so the
# binary's writeOutFifo unblocks the instant it opens the write end.
exec {out_fd}<>"$out_fifo"
rec=""
IFS= read -r -d "$RS" -u $out_fd rec || true
rec="${rec%$RS}"

verb="${rec%%$US*}"
value=""
[[ "$rec" == *"$US"* ]] && value="${rec#*$US}"

if [[ "$verb" == cancel || "$verb" != submit ]]; then
  # Cancel (or anything unexpected): dismiss the float, route nothing, clean up.
  emit_close
  cleanup_fifos
  exit 0
fi

# ── 2. Finalize the request with the submitted value ─────────────────────────
emit_status "Reading request…"
if command -v jq >/dev/null 2>&1 && [[ -s "$request" ]]; then
  tmp="$(mktemp "${request:h}/request.XXXXXX")" 2>/dev/null || tmp="${request}.tmp"
  if jq --arg u "$value" '.user_request = $u' "$request" > "$tmp" 2>/dev/null; then
    mv -f "$tmp" "$request"
  else
    rm -f -- "$tmp" 2>/dev/null || true
  fi
fi

# ── Harness discovery + non-interactive resolution ───────────────────────────
# Mirror the dispatcher: workers are the `ai-assist-<h>` siblings of the
# `ai-assist` dispatcher. Resolve the dispatcher's dir from PATH (overridable by
# AI_ASSIST_BIN_DIR for tests).
bin_dir="${AI_ASSIST_BIN_DIR:-}"
if [[ -z "$bin_dir" ]]; then
  disp="$(command -v -- ai-assist 2>/dev/null)" || disp=""
  [[ -n "$disp" ]] && bin_dir="${disp:A:h}"
fi
[[ -n "$bin_dir" ]] || bin_dir="$HOME/.local/bin"

worker_path() { print -r -- "$bin_dir/ai-assist-$1"; }

typeset -a HARNESSES=()
for w in "$bin_dir"/ai-assist-*(N-.); do
  [[ -x "$w" ]] || continue
  HARNESSES+=("${${w:t}#ai-assist-}")
done

is_harness() { local n="$1" h; for h in "${HARNESSES[@]}"; do [[ "$h" == "$n" ]] && return 0; done; return 1; }

# resolve_harness — print the chosen harness on stdout, or nothing if it would
# need the interactive picker (→ caller escalates). Precedence: explicit env,
# session pin, sole-available-via-probe. Never shows a picker.
resolve_harness() {
  if [[ -n "${AI_ASSIST_HARNESS:-}" ]] && is_harness "$AI_ASSIST_HARNESS"; then
    print -r -- "$AI_ASSIST_HARNESS"; return 0
  fi
  local pinned; pinned="$(assist::pin_read)"
  if [[ -n "$pinned" ]] && is_harness "$pinned"; then
    print -r -- "$pinned"; return 0
  fi
  local h; typeset -a avail=()
  for h in "${HARNESSES[@]}"; do
    "$(worker_path "$h")" --probe >/dev/null 2>&1 && avail+=("$h")
  done
  (( ${#avail[@]} == 1 )) && { print -r -- "${avail[1]}"; return 0; }
  return 1   # zero or several → non-interactive resolution impossible
}

# ── Routing helpers ──────────────────────────────────────────────────────────
render_bin() {
  local r="${AI_ASSIST_RENDER_BIN:-}"
  [[ -n "$r" && -x "$r" ]] && { print -r -- "$r"; return 0; }
  r="$HOME/.local/libexec/ai-assist-render"
  [[ -x "$r" ]] && { print -r -- "$r"; return 0; }
  print -r -- "$r"
}

# Read the request so REQ_* (project root, over_ssh, pane) are available for the
# docked pane spawn. Tolerant: missing fields just default.
assist::request_read "$request" 2>/dev/null || true
[[ -n "$origin_pane" ]] || origin_pane="${REQ_PANE_ID:-}"
# Export REQ_* fields that ai-assist-cache context-hash reads from env, so the
# cache helper subprocess sees the correct values. assist::request_read uses plain
# assignments (not export); any prior export state may be stale after jq reloads
# the values, so we explicitly re-export the fields the hash depends on.
export REQ_PROJECT_ROOT="${REQ_PROJECT_ROOT:-}"
export REQ_CWD="${REQ_CWD:-}"
export REQ_COMMAND_TEXT="${REQ_COMMAND_TEXT:-}"
export REQ_COMMAND_EXIT="${REQ_COMMAND_EXIT:-}"
export REQ_SCROLLBACK="${REQ_SCROLLBACK:-}"

# spawn_docked <render-args...> — open the docked pane running ai-assist-render
# with the SAME fifo pair reused (Task 5 flags). Render parks/closes on its own.
spawn_docked() {
  # CRITICAL: release our own read-write hold on the reused fifos BEFORE handing
  # them to the docked pager. We held IN/OUT open read-write to drive the float's
  # spinner; if we keep IN open here, it stays a live *writer* on the pipe, so the
  # pager never sees EOF after the one-shot render command finishes — the pane
  # opens but shows nothing. Closing both fds gives the pager/broker clean,
  # sole ownership (emit_status/emit_close are already done by now).
  exec {in_fd}>&- 2>/dev/null || true
  exec {out_fd}>&- 2>/dev/null || true
  local render; render="$(render_bin)"
  local -a render_flags=(
    --input-fifo "$in_fifo" --actions-fifo "$out_fifo"
  )
  [[ -n "$origin_pane" ]] && render_flags+=(--origin-pane "$origin_pane")
  [[ "${REQ_OVER_SSH:-false}" == true ]] && render_flags+=(--over-ssh)
  [[ -n "${REQ_PROJECT_ROOT:-}" ]] && render_flags+=(--project-root "$REQ_PROJECT_ROOT")
  [[ -n "${AI_ASSIST_DEBUG_LOG:-}" ]] && render_flags+=(--debug-log "$AI_ASSIST_DEBUG_LOG")
  render_flags+=(--shell-cwd "${REQ_CWD:-$PWD}")
  REQ_PROJECT_ROOT="${REQ_PROJECT_ROOT:-}" assist::spawn_pane "$render" "${render_flags[@]}" "$@"
}

# route_escalate <reason> — the capable path, exactly as today: hand off to the
# `ai-assist` dispatcher (resolved non-interactively to a specific worker when
# possible, else the bare dispatcher which picks for itself). The worker builds
# the capable harness command and spawns its OWN render-wrapped docked pane
# (title + spinner + glow), seeded with the escalation reason as caller guidance.
# This is the read-only "never worse than today" default for every error path.
#
# NOTE on fifo reuse: the float has already been dismissed (close␞ sent), so the
# OUT/IN pair is free. The worker's render pane creates its own fifos for the
# pager/broker — reusing the float's pair here would require the worker to accept
# pre-created fifos, which is out of scope for this task. The orchestrator-owned
# ANSWER/COMMAND-fallback renders DO reuse the pair (see spawn_docked).
route_escalate() {
  local reason="${1:-}"
  local -a guidance=()
  [[ -n "$reason" ]] && guidance=(-- "escalation reason: $reason")
  local h
  if h="$(resolve_harness)"; then
    "$(worker_path "$h")" --request "$request" "${guidance[@]}"
  else
    local disp="$bin_dir/ai-assist"
    [[ -x "$disp" ]] || disp="ai-assist"
    "$disp" --request "$request" "${guidance[@]}"
  fi
}

# ── Cache: resolve binary (BEST-EFFORT — never block a request) ──────────────
_cache_bin=""
for _cand in \
  "${AI_ASSIST_CACHE_BIN:-}" \
  "$(command -v -- ai-assist-cache 2>/dev/null)" \
  "$HOME/.local/libexec/ai-assist-cache"; do
  [[ -n "$_cand" && -x "$_cand" ]] && { _cache_bin="$_cand"; break; }
done

# ── Cache: compute context+request hashes BEFORE classify ────────────────────
# Best-effort: if anything fails, we fall through to the normal classify path.
_cache_ctx="" _cache_req=""
if [[ -n "$_cache_bin" ]]; then
  _cache_ctx="$("$_cache_bin" context-hash 2>/dev/null)" || _cache_ctx=""
  _cache_req="$("$_cache_bin" request-hash "$REQ_USER_REQUEST" 2>/dev/null)" || _cache_req=""
fi
_dbg "cache-hash: ctx=$_cache_ctx req=$_cache_req"
_dbg "cache-hash: REQ_COMMAND_TEXT=${REQ_COMMAND_TEXT:-<empty>} REQ_COMMAND_EXIT=${REQ_COMMAND_EXIT:-<empty>} REQ_SCROLLBACK_LEN=${#REQ_SCROLLBACK}"

# ── Cache: lookup BEFORE cheap model ─────────────────────────────────────────
# On a hit, replay by kind and exit WITHOUT running the classify step.
# AI_ASSIST_NO_CACHE=1 forces a miss (bypass for regenerate / testing).
if [[ -n "$_cache_bin" && -n "$_cache_ctx" && -n "$_cache_req" \
      && -z "${AI_ASSIST_NO_CACHE:-}" ]]; then
  _cache_entry="$("$_cache_bin" lookup "$_cache_ctx" "$_cache_req" 2>/dev/null)" || _cache_entry=""
  if [[ -n "$_cache_entry" && -f "$_cache_entry" ]]; then
    # HIT — read kind + created_at from front matter.
    _hit_kind="$("$_cache_bin" field "$_cache_entry" kind 2>/dev/null)" || _hit_kind=""
    _hit_created="$("$_cache_bin" field "$_cache_entry" created_at 2>/dev/null)" || _hit_created=""
    _dbg "cache-lookup: HIT $_cache_entry kind=$_hit_kind"

    # Bump recency log (best-effort).
    [[ -n "$_hit_kind" ]] && \
      "$_cache_bin" log "$_cache_ctx" "$_hit_kind" "$REQ_USER_REQUEST" 2>/dev/null || true

    # Dismiss the float.
    emit_close

    case "$_hit_kind" in
      command)
        # Re-stage the cached command into the origin pane via bracketed paste
        # (same sequence as the live command path, NO trailing CR).
        if [[ -n "$origin_pane" ]]; then
          _hit_payload="$("$_cache_bin" body "$_cache_entry" 2>/dev/null)" || _hit_payload=""
          zj="$(assist::zellij_bin)" || zj=""
          if [[ -n "$zj" && -n "$_hit_payload" ]]; then
            "$zj" action write --pane-id "$origin_pane" 27 91 50 48 48 126 2>/dev/null || true  # ESC[200~
            "$zj" action write-chars --pane-id "$origin_pane" -- "$_hit_payload" 2>/dev/null || true
            "$zj" action write --pane-id "$origin_pane" 27 91 50 48 49 126 2>/dev/null || true  # ESC[201~
          fi
          cleanup_fifos
        else
          # No origin pane → render in a docked pane (same fallback as live path).
          local -a _cached_flags=()
          [[ -n "$_hit_created" ]] && _cached_flags+=(--cached "$_hit_created")
          spawn_docked --cleanup-fifos "${_cached_flags[@]}" -- "$_cache_bin" body "$_cache_entry"
        fi
        ;;
      answer|playbook|*)
        # Replay answer/playbook (and any unknown future kinds) in a docked pane.
        local -a _cached_flags=()
        [[ -n "$_hit_created" ]] && _cached_flags+=(--cached "$_hit_created")
        [[ -n "$_cache_ctx" ]] && _cached_flags+=(--regen-ctx "$_cache_ctx")
        [[ -n "$_cache_req" ]] && _cached_flags+=(--regen-req "$_cache_req")
        spawn_docked --cleanup-fifos "${_cached_flags[@]}" -- "$_cache_bin" body "$_cache_entry"
        ;;
    esac
    exit 0
  fi
fi

# ── MISS (or cache unavailable / NO_CACHE set) ────────────────────────────────
_dbg "cache-lookup: MISS (or NO_CACHE=${AI_ASSIST_NO_CACHE:-0})"
# Fall through to the existing classify + route + Stage-2 persist flow.

# ── 3–4. Run the cheap pass (if a harness resolves) and classify ─────────────
kind="" payload=""
harness="$(resolve_harness)" || harness=""

if [[ -z "$harness" ]]; then
  # No non-interactive harness → skip the cheap pass, escalate.
  emit_status "Starting the assistant…"
  emit_close
  cleanup_fifos
  route_escalate "no harness could be resolved without a picker"
  exit 0
fi

emit_status "Thinking…"
worker="$(worker_path "$harness")"
raw=""
if [[ -x "$worker" ]]; then
  raw="$("$worker" --triage --request "$request" 2>/dev/null)"; trc=$?
else
  trc=3
fi

if (( trc == 3 )) || [[ -z "${raw//[[:space:]]/}" ]]; then
  # No cheap pass, or empty output → escalate (safe default).
  emit_status "Starting the assistant…"
  emit_close
  cleanup_fifos
  route_escalate "triage produced no usable result"
  exit 0
fi

classified="$(assist::triage_classify "$raw")"
kind="${classified%%$US*}"
payload="${classified#*$US}"

# Defensive: re-running the failed command is never a useful triage result —
# diagnosing a failure needs the capable agent. If the cheap pass merely echoed
# the failed command back (whitespace-insensitive), escalate instead of typing it.
if [[ "$kind" == command && -n "${REQ_COMMAND_TEXT:-}" \
      && "${payload//[[:space:]]/}" == "${REQ_COMMAND_TEXT//[[:space:]]/}" ]]; then
  kind="escalate"; payload="re-running the failed command is not a diagnosis"
fi

# ── Cache: build meta file for persist-on-produce ────────────────────────────
# (ctx/req already computed above; build meta only on a miss that has valid hashes)
_cache_meta=""
if [[ -n "$_cache_bin" && -n "$_cache_ctx" && -n "$_cache_req" ]]; then
  _cache_meta="$(mktemp "${request:h}/cache-meta.XXXXXX" 2>/dev/null)" || _cache_meta=""
  if [[ -n "$_cache_meta" ]]; then
    # Collapse the request to one line for front-matter (newlines → spaces).
    local _req_oneline="${REQ_USER_REQUEST//$'\n'/ }"
    {
      printf 'request=%s\n'      "$_req_oneline"
      printf 'project_root=%s\n' "${REQ_PROJECT_ROOT:-}"
      printf 'project_name=%s\n' "${REQ_PROJECT_NAME:-}"
      printf 'command=%s\n'      "${REQ_COMMAND_TEXT:-}"
      printf 'exit=%s\n'         "${REQ_COMMAND_EXIT:-}"
      printf 'harness=%s\n'      "$harness"
    } > "$_cache_meta" 2>/dev/null || { rm -f -- "$_cache_meta" 2>/dev/null; _cache_meta=""; }
  fi
fi

# ── 5. Dismiss the float ─────────────────────────────────────────────────────
emit_close

# ── 6. Route ─────────────────────────────────────────────────────────────────
# Determine the log kind (escalate → playbook for the prompt log).
_log_kind="$kind"
[[ "$_log_kind" == escalate ]] && _log_kind="playbook"

# Log every submit (best-effort).
if [[ -n "$_cache_bin" && -n "$_cache_ctx" ]]; then
  "$_cache_bin" log "$_cache_ctx" "$_log_kind" "$REQ_USER_REQUEST" 2>/dev/null || true
fi

case "$kind" in
  command)
    _dbg "route: command kind"
    if [[ -n "$origin_pane" ]]; then
      zj="$(assist::zellij_bin)" || zj=""
      if [[ -n "$zj" ]]; then
        # Put the command on the origin prompt via BRACKETED PASTE (ESC[200~ …
        # ESC[201~) with NO trailing CR — the broker's `play` minus the Enter.
        # Bracketed paste makes the whole payload land as ONE editable buffer the
        # user reviews + runs; any embedded newline can NEVER auto-execute.
        "$zj" action write --pane-id "$origin_pane" 27 91 50 48 48 126 2>/dev/null || true  # ESC[200~
        "$zj" action write-chars --pane-id "$origin_pane" -- "$payload" 2>/dev/null || true
        "$zj" action write --pane-id "$origin_pane" 27 91 50 48 49 126 2>/dev/null || true  # ESC[201~
      fi
      # Store the command result (best-effort).
      if [[ -n "$_cache_bin" && -n "$_cache_ctx" && -n "$_cache_req" ]]; then
        local _body_tmp
        _body_tmp="$(mktemp "${TMPDIR:-/tmp}/ai-assist-cmd-body.XXXXXX" 2>/dev/null)" || _body_tmp=""
        if [[ -n "$_body_tmp" ]]; then
          printf '%s\n' "$payload" > "$_body_tmp" 2>/dev/null || true
          local _store_args=("$_cache_ctx" "$_cache_req" command "$_body_tmp")
          [[ -n "$_cache_meta" ]] && _store_args+=(--meta-file "$_cache_meta")
          _store_args+=(--request-file "$request")
          "$_cache_bin" store "${_store_args[@]}" >/dev/null 2>&1 || true
          _dbg "cache-lookup: STORE command ctx=$_cache_ctx req=$_cache_req"
          rm -f -- "$_body_tmp" 2>/dev/null || true
        fi
      fi
      [[ -n "$_cache_meta" ]] && rm -f -- "$_cache_meta" 2>/dev/null || true
      cleanup_fifos
    else
      # Origin pane missing → render the command in the docked pager instead of
      # writing to a prompt we don't have.
      # Store before spawning (best-effort).
      if [[ -n "$_cache_bin" && -n "$_cache_ctx" && -n "$_cache_req" ]]; then
        local _body_tmp
        _body_tmp="$(mktemp "${TMPDIR:-/tmp}/ai-assist-cmd-body.XXXXXX" 2>/dev/null)" || _body_tmp=""
        if [[ -n "$_body_tmp" ]]; then
          printf '%s\n' "$payload" > "$_body_tmp" 2>/dev/null || true
          local _store_args=("$_cache_ctx" "$_cache_req" command "$_body_tmp")
          [[ -n "$_cache_meta" ]] && _store_args+=(--meta-file "$_cache_meta")
          _store_args+=(--request-file "$request")
          "$_cache_bin" store "${_store_args[@]}" >/dev/null 2>&1 || true
          _dbg "cache-lookup: STORE command ctx=$_cache_ctx req=$_cache_req (no-origin-pane branch)"
          rm -f -- "$_body_tmp" 2>/dev/null || true
        fi
      fi
      [[ -n "$_cache_meta" ]] && rm -f -- "$_cache_meta" 2>/dev/null || true
      spawn_docked --cleanup-fifos --harness "$harness" -- printf '%s\n' "$payload"
    fi
    ;;
  answer)
    _dbg "route: answer kind"
    # Store the answer result (best-effort).
    if [[ -n "$_cache_bin" && -n "$_cache_ctx" && -n "$_cache_req" ]]; then
      local _body_tmp
      _body_tmp="$(mktemp "${TMPDIR:-/tmp}/ai-assist-ans-body.XXXXXX" 2>/dev/null)" || _body_tmp=""
      if [[ -n "$_body_tmp" ]]; then
        printf '%s\n' "$payload" > "$_body_tmp" 2>/dev/null || true
        local _store_args=("$_cache_ctx" "$_cache_req" answer "$_body_tmp")
        [[ -n "$_cache_meta" ]] && _store_args+=(--meta-file "$_cache_meta")
        _store_args+=(--request-file "$request")
        "$_cache_bin" store "${_store_args[@]}" >/dev/null 2>&1 || true
        _dbg "cache-lookup: STORE answer ctx=$_cache_ctx req=$_cache_req"
        rm -f -- "$_body_tmp" 2>/dev/null || true
      fi
    fi
    [[ -n "$_cache_meta" ]] && rm -f -- "$_cache_meta" 2>/dev/null || true
    spawn_docked --cleanup-fifos --harness "$harness" -- printf '%s\n' "$payload"
    ;;
  escalate|*)
    _dbg "route: escalate kind"
    # Pass cache keys to render (via env) so it can persist the playbook after
    # streaming.  The worker spawns render and inherits this environment.
    # The meta file must outlive triage — render will remove it.
    # IMPORTANT: AI_ASSIST_CACHE_CTX/REQ/META are exported ONLY here (escalate
    # path). They must NOT be set globally — the replay/hit paths must leave them
    # unset so render does NOT attempt to re-persist a cached result.
    if [[ -n "$_cache_bin" && -n "$_cache_ctx" && -n "$_cache_req" && -n "$_cache_meta" ]]; then
      export AI_ASSIST_CACHE_CTX="$_cache_ctx"
      export AI_ASSIST_CACHE_REQ="$_cache_req"
      export AI_ASSIST_CACHE_META="$_cache_meta"
      _dbg "cache-lookup: STORE playbook ctx=$_cache_ctx req=$_cache_req (deferred to render)"
    else
      [[ -n "$_cache_meta" ]] && rm -f -- "$_cache_meta" 2>/dev/null || true
    fi
    cleanup_fifos
    route_escalate "$payload"
    ;;
esac

exit 0
