#!/usr/bin/env zsh
# ai-assist-wrapup — session wrap-up: verify outcomes, emit a solution summary,
# and distil one durable KB fact. Part of Phase C3b.
#
# Called by the broker's `wrapup` action handler with:
#   --ctx <context_hash> --req <request_hash> --input-fifo <path>
#   [--run-dir <d>] [--request-file <f>] [--harness <h>]
#
# Behaviour:
#   1. Resolve the original request (from --request-file if given, else sidecar,
#      else entry front matter).
#   2. Read the run log ($run_dir/runlog.jsonl) — best-effort, absent is OK.
#   3. Build a wrap-up system prompt in a temp file.
#   4. Run `worker --stream --prompt-file <prompt> --request <req>` and tee the
#      output to a solution artifact AND into --input-fifo (reusing the same
#      pane-stream path as ai-assist-regenerate).
#   5. Write the quit-sentinel when the worker is missing/non-exec.
#
# NOTE: this helper does NOT load the cached playbook body — it works uniformly
# for both fresh and cached-replay panes. The agent receives the original user
# request + run outcomes; it determines resolution from those alone.
#
# The harness-discovery block is intentionally duplicated from ai-assist-triage /
# ai-assist-regenerate (same logic, self-contained).
set -uo pipefail

source "${AI_ASSIST_LIB_DIR:-$HOME/.local/lib}/assist-agent-common.zsh"

# ── Debug logging (gated on AI_ASSIST_DEBUG_LOG) ─────────────────────────────
_dbg() { [[ -n "${AI_ASSIST_DEBUG_LOG:-}" ]] && printf '[wrapup %s] %s\n' "$(date -u +%H:%M:%S)" "$*" >> "$AI_ASSIST_DEBUG_LOG" 2>/dev/null || true; }

# ── Parse arguments ───────────────────────────────────────────────────────────
ctx="" req="" input_fifo="" run_dir="" request_file_override="" harness_override=""
while (($#)); do
  case "$1" in
    --ctx)           ctx="${2:-}";                  shift 2 ;;
    --req)           req="${2:-}";                  shift 2 ;;
    --input-fifo)    input_fifo="${2:-}";           shift 2 ;;
    --run-dir)       run_dir="${2:-}";              shift 2 ;;
    --request-file)  request_file_override="${2:-}"; shift 2 ;;
    --harness)       harness_override="${2:-}";     shift 2 ;;
    *) shift ;;
  esac
done

[[ -n "$ctx" && -n "$req" && -n "$input_fifo" ]] || {
  print -ru2 -- "usage: ai-assist-wrapup --ctx H --req H --input-fifo P [--run-dir D] [--request-file F] [--harness H]"
  exit 1
}
_dbg "invoked ctx=$ctx req=$req input-fifo=$input_fifo run-dir=${run_dir:-}"

# ── Cache binary — best-effort (same precedence as triage) ───────────────────
cache_bin=""
for _cand in \
  "${AI_ASSIST_CACHE_BIN:-}" \
  "$(command -v -- ai-assist-cache 2>/dev/null)" \
  "$HOME/.local/libexec/ai-assist-cache"; do
  [[ -n "$_cand" && -x "$_cand" ]] && { cache_bin="$_cand"; break; }
done

# ── Harness discovery — verbatim from ai-assist-triage / ai-assist-regenerate ─
bin_dir="${AI_ASSIST_BIN_DIR:-}"
if [[ -z "$bin_dir" ]]; then
  disp="$(command -v -- ai-assist 2>/dev/null)" || disp=""
  [[ -n "$disp" ]] && bin_dir="${disp:A:h}"
fi
[[ -n "$bin_dir" ]] || bin_dir="$HOME/.local/bin"

worker_path() { print -r -- "$bin_dir/ai-assist-$1"; }

typeset -a HARNESSES=()
for w in "$bin_dir"/ai-assist-*(N-.); do
  [[ -x "$w" ]] || continue
  HARNESSES+=("${${w:t}#ai-assist-}")
done

is_harness() {
  local n="$1" h
  for h in "${HARNESSES[@]}"; do [[ "$h" == "$n" ]] && return 0; done
  return 1
}

resolve_harness() {
  if [[ -n "${AI_ASSIST_HARNESS:-}" ]] && is_harness "$AI_ASSIST_HARNESS"; then
    print -r -- "$AI_ASSIST_HARNESS"; return 0
  fi
  local pinned; pinned="$(assist::pin_read)"
  if [[ -n "$pinned" ]] && is_harness "$pinned"; then
    print -r -- "$pinned"; return 0
  fi
  local h; typeset -a avail=()
  for h in "${HARNESSES[@]}"; do
    "$(worker_path "$h")" --probe >/dev/null 2>&1 && avail+=("$h")
  done
  (( ${#avail[@]} == 1 )) && { print -r -- "${avail[1]}"; return 0; }
  return 1
}

# ── Temp-file tracking (cleaned up on exit) ───────────────────────────────────
typeset -a _tmp_files=()
_cleanup() { rm -f -- "${_tmp_files[@]}" 2>/dev/null || true; }
trap '_cleanup' EXIT

# ── Quit sentinel: DLE 'q' DLE — the pager interprets this as "quit" ─────────
write_quit() { printf '\020q\020' > "$input_fifo" 2>/dev/null || true; }

# ── Error message: visible blockquote in the pane; keeps the pane open ────────
write_error() { printf '\n\n> ⚠ %s\n' "$1" > "$input_fifo" 2>/dev/null || true; }

# ── Resolve the request file ──────────────────────────────────────────────────
request_file=""

# Priority 1: caller-provided --request-file (fresh playbook path)
if [[ -n "$request_file_override" && -r "$request_file_override" ]]; then
  request_file="$request_file_override"
  _dbg "request-resolution: request-file (caller-provided) → $request_file"
fi

# Priority 2: sidecar from cache
if [[ -z "$request_file" && -n "$cache_bin" ]]; then
  request_file="$("$cache_bin" request-file "$ctx" "$req" 2>/dev/null)" || request_file=""
  [[ -n "$request_file" && -f "$request_file" ]] || request_file=""
  [[ -n "$request_file" ]] && _dbg "request-resolution: sidecar → $request_file"
fi

# Priority 3: reconstruct from entry front matter
if [[ -z "$request_file" ]]; then
  entry=""
  [[ -n "$cache_bin" ]] && entry="$("$cache_bin" lookup "$ctx" "$req" 2>/dev/null)" || entry=""

  if [[ -z "$entry" || ! -f "$entry" ]]; then
    _dbg "request-resolution: FAILED — no entry for ctx=$ctx req=$req; writing error and keeping pane open"
    write_error "could not load the request to wrap up"
    exit 0
  fi
  _dbg "request-resolution: reconstruct from entry front matter → $entry"

  _fm_request="$("$cache_bin" field "$entry" request    2>/dev/null)" || _fm_request=""
  _fm_command="$("$cache_bin" field "$entry" command    2>/dev/null)" || _fm_command=""
  _fm_exit="$(   "$cache_bin" field "$entry" exit       2>/dev/null)" || _fm_exit=""
  _fm_root="$(   "$cache_bin" field "$entry" project_root 2>/dev/null)" || _fm_root=""
  _fm_name="$(   "$cache_bin" field "$entry" project_name 2>/dev/null)" || _fm_name=""

  reconstructed_request="$(mktemp "${TMPDIR:-/tmp}/ai-assist-wrapup-req.XXXXXX")"
  _tmp_files+=("$reconstructed_request")

  if command -v jq >/dev/null 2>&1; then
    jq -n \
      --arg request   "$_fm_request" \
      --arg command   "$_fm_command" \
      --arg exit_code "$_fm_exit" \
      --arg root      "$_fm_root" \
      --arg name      "$_fm_name" \
      '{version:1, kind:"question",
        origin:{cwd:$root, project_root:$root},
        command:{text:$command, exit:($exit_code | tonumber? // null)},
        scrollback:"", user_request:$request,
        project:{name:$name, branch:""}}' \
      > "$reconstructed_request" 2>/dev/null || {
        printf '{"version":1,"kind":"question","origin":{"cwd":"%s","project_root":"%s"},"command":{"text":"%s","exit":null},"scrollback":"","user_request":"%s","project":{"name":"%s","branch":""}}\n' \
          "$_fm_root" "$_fm_root" "$_fm_command" "$_fm_request" "$_fm_name" \
          > "$reconstructed_request" 2>/dev/null
      }
  else
    printf '{"version":1,"kind":"question","origin":{"cwd":"%s","project_root":"%s"},"command":{"text":"%s","exit":null},"scrollback":"","user_request":"%s","project":{"name":"%s","branch":""}}\n' \
      "$_fm_root" "$_fm_root" "$_fm_command" "$_fm_request" "$_fm_name" \
      > "$reconstructed_request" 2>/dev/null
  fi

  request_file="$reconstructed_request"
fi

# ── Read REQ_* from the request file ─────────────────────────────────────────
assist::request_read "$request_file" 2>/dev/null || true
export REQ_PROJECT_ROOT="${REQ_PROJECT_ROOT:-}"
export REQ_USER_REQUEST="${REQ_USER_REQUEST:-}"
export REQ_CWD="${REQ_CWD:-}"
export REQ_COMMAND_TEXT="${REQ_COMMAND_TEXT:-}"
export REQ_COMMAND_EXIT="${REQ_COMMAND_EXIT:-}"

# ── Read the run log ──────────────────────────────────────────────────────────
runlog=""
[[ -n "$run_dir" && -f "$run_dir/runlog.jsonl" ]] && runlog="$(cat -- "$run_dir/runlog.jsonl")"

# ── Build the wrap-up system prompt into a temp file ─────────────────────────
promptfile="$(mktemp "${TMPDIR:-/tmp}/ai-assist-wrapup-prompt.XXXXXX")"
_tmp_files+=("$promptfile")

{
  printf 'You are a concise technical assistant wrapping up a terminal debugging session.\n\n'
  printf '## Original request\n%s\n\n' "${REQ_USER_REQUEST:-<unknown>}"
  printf '## Project root\n%s\n\n' "${REQ_PROJECT_ROOT:-(unknown)}"
  if [[ -n "$runlog" ]]; then
    printf '## Blocks the user ran (id / exit code / timestamp)\n'
    printf '%s\n\n' "$runlog"
    printf 'Exit code 0 = success; non-zero = failure.\n\n'
  else
    printf '## Blocks the user ran\nNo blocks were run in this session.\n\n'
  fi
  printf '## Your task\n'
  printf '(1) In 1-2 lines, state whether the original request now appears RESOLVED\n'
  printf '    given the run outcomes above.\n'
  printf '(2) Write a short `## Solution` section a teammate could reuse later.\n'
  printf '(3) If the request appears resolved, call `ai-assist-remember` exactly once\n'
  printf '    with one durable, reusable fact about this project — something that would\n'
  printf '    help a future session. Example:\n'
  printf '      ai-assist-remember "The test suite requires PGPASSWORD=test to be set."\n'
  printf '\n'
  printf 'Be concise: this is a wrap-up, not a new investigation. Do not re-diagnose.\n'
} > "$promptfile"

# ── Solution artifact setup ───────────────────────────────────────────────────
DATA="${AI_ASSIST_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/ai-assist}"
solutions_dir="$DATA/solutions"
mkdir -p "$solutions_dir" 2>/dev/null || true
utc_ts="$(date -u +%Y%m%dT%H%M%SZ)"
artifact="$solutions_dir/${ctx}-${utc_ts}.md"

# Write front-matter header to the artifact before the streamed body.
{
  printf '---\n'
  printf 'request: %s\n'      "${REQ_USER_REQUEST:-}"
  printf 'project_root: %s\n' "${REQ_PROJECT_ROOT:-}"
  printf 'created_at: %s\n'   "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf '---\n\n'
} > "$artifact" 2>/dev/null || artifact=""

# ── Resolve harness + worker ──────────────────────────────────────────────────
harness="${harness_override:-$(resolve_harness 2>/dev/null || true)}"
worker="$(worker_path "${harness:-unknown}")"
_dbg "harness=$harness worker=$worker"

if [[ -z "$harness" || ! -x "$worker" ]]; then
  # No capable worker — show an error in the pane; keep it open so the user sees it.
  _dbg "no capable worker available; writing error and keeping pane open"
  write_error "no assistant available for wrap-up"
  exit 0
fi

# ── Run: stream the wrap-up into the pane + save the artifact ────────────────
if [[ -n "$artifact" ]]; then
  "$worker" --stream --prompt-file "$promptfile" --request "$request_file" \
    | tee -a "$artifact" > "$input_fifo"
else
  "$worker" --stream --prompt-file "$promptfile" --request "$request_file" \
    > "$input_fifo"
fi
_rc=${pipestatus[1]:-$?}
_dbg "worker exited rc=$_rc; streamed output to input-fifo artifact=${artifact:-<none>}"

exit 0
