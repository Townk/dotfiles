#!/usr/bin/env zsh
# tmux-status-right — the ENTIRE right side of the status bar, rendered as
# the zj-hud gradient ribbon (mux migration Phase 4, D6 — a faithful port
# of zj-hud/src/bar/render.rs build_right_side + status segments).
#
#   tmux-status-right <client_key_table> <in_copy_mode:0|1> <session-name> \
#                    <prefix_pending:0|1>
#
# Invoked from status-right as a #() whose ARGUMENTS are format-expanded:
# when the key table / copy-mode state / session changes, the expanded
# command string changes and tmux re-runs it immediately — the mode pill
# updates instantly while the 10s status-interval refreshes widgets/clock.
#
# Anatomy (left to right): mode pill (hidden at rest, like zj-hud in
# Normal) - locked/nested exit hint - session pill (hidden for "main",
# kebab-case shown as Title Case) - info widgets (power/battery/wifi/host,
# zj-hud visibility rules) - clock. Segment backgrounds run a gradient
# from the mode color (tab chrome when no mode) at the RIGHT edge fading
# toward the bar background leftward; every segment opens with a powerline
# divider; text is an auto-darkened variant of its own pill (lightened on
# the near-bar stops). As-built deviation: linear sRGB interpolation
# approximates the plugin's OKLab gradient (visually close on these dark
# ramps).
#
# All colors come from the theme JSON projection — no hex lives here.
# Test seams: MUX_TMUX_BIN, PMSET_BIN, NETWORKSETUP_BIN,
# WIDGETS_FULLSCREEN_STATE, WIDGETS_HOSTNAME_ALIAS, THEME_PALETTE_JSON.

emulate -L zsh
setopt no_unset

TMUX_BIN="${MUX_TMUX_BIN:-tmux}"
PMSET="${PMSET_BIN:-/usr/bin/pmset}"
NETWORKSETUP="${NETWORKSETUP_BIN:-/usr/sbin/networksetup}"
FS_STATE="${WIDGETS_FULLSCREEN_STATE:-$HOME/.local/state/wezterm/fullscreen_state}"
# Ghostty's own mirror. WezTerm pushes its state from wezterm.lua on every
# window event; Ghostty has no such hook, so mux-fullscreen-probe fills this
# one from the client-resized hook — asynchronously, because ASKING costs
# seconds (see below) and this file is read on every repaint.
GHOSTTY_FS_STATE="${WIDGETS_GHOSTTY_FULLSCREEN_STATE:-$HOME/.local/state/mux/ghostty_fullscreen}"
HOST_ALIAS="${WIDGETS_HOSTNAME_ALIAS:-$HOME/.hostname-alias}"
# theme::json_path (C2) + theme::hex_rgb (C1). Resolved relative to this script
# (../lib) so it tracks the same tree as the executable, not a stale $HOME copy.
_tsr_self="${(%):-%x}"
source "${_tsr_self:h:h}/lib/theme-common.zsh" 2>/dev/null || true
unset _tsr_self
# THE single palette JSON every reader shares (C2): $THEME_PALETTE_JSON ->
# effective cache copy if readable -> canonical config. Retires this reader's
# old WIDGETS_THEME_JSON seam so the status bar (cache tier) and the mux dialogs
# can never render different palettes on one screen under SSH+override.
THEME_JSON="$(theme::json_path)"
# THE shared mode resolver (states, titles, icons, colors and the panel
# table behind each) — the which-key panel resolves through the same one.
source "${MUX_LIB_DIR:-$HOME/.local/lib}/mux/mode.zsh" 2>/dev/null || true

key_table="${1:-root}"
in_copy="${2:-0}"
sess="${3:-}"
prefix_on="${4:-0}"
search_on="${5:-0}"
renaming="${6:-}"
visual_on="${7:-0}"
searching_on="${8:-0}"
search_toggles="${9:-}"
cwidth="${10:-80}"
# The MODE STACK arrives as an ARGUMENT, not a lookup: status-right is a
# #() and tmux re-runs it when the format-expanded arguments change, so a
# stack read inside the script would leave the bar stale until the next
# status-interval tick — raising the panel would not clear the hint.
# `${11-…}` (no colon) keeps the fallback for callers that pass 10 args.
stack_raw="${11-$("$TMUX_BIN" show -gv @mux_stack 2>/dev/null)}"
# tmux draws its OWN [copy_position/copy_position_limit] (N results) box in
# the pane's top-right corner; status.conf empties copy-mode-position-format
# because it is unthemed chrome we do not own, and because those two numbers
# read as a match counter while actually being scroll depth. The fact worth
# keeping — how many matches the term has — rides in here instead. A search
# that matches nothing leaves tmux's count EMPTY, and "0 matches" is exactly
# the feedback that was missing when a case toggle silently emptied the pane.
search_count="${12:-}"
search_partial="${13:-0}"
search_idx="${14:-}"
client_term="${15:-}"
# The @jobs data ("<running> <failed>", empty = no live jobs) arrives as an
# ARGUMENT for the same reason the mode stack does: tmux re-runs the #()
# the moment the format-expanded value changes, so job starts/finishes
# repaint immediately instead of waiting out the status-interval tick.
jobs_raw="${16-$("$TMUX_BIN" show -gv @jobs 2>/dev/null)}"

# ---- theme colors (one jq pass) -------------------------------------------
# bar_bg fg tab_bg m_locked m_resize m_pane m_tab m_move m_scroll m_session
c=("${(@f)$(jq -r '
  .palette.base, .roles.ui.fg, .extended.tab.bg,
  .roles.mode.locked, .roles.mode.resize, .roles.mode.pane, .roles.mode.tab,
  .roles.mode.move, .roles.mode.scroll, .roles.mode.session, .roles.mode.tmux,
  .roles.mode.rename, .roles.mode.search, .roles.mode.visual, .palette.white,
  .palette.red
' "$THEME_JSON" 2>/dev/null)}") || c=()
(( ${#c} == 16 )) || exit 0
bar_bg="${c[1]}" fg_hi="${c[2]}" tab_bg="${c[3]}"
m_locked="${c[4]}" m_resize="${c[5]}" m_pane="${c[6]}" m_tab="${c[7]}"
m_move="${c[8]}" m_scroll="${c[9]}" m_session="${c[10]}" m_tmux="${c[11]}" m_rename="${c[12]}" m_search="${c[13]}" m_visual="${c[14]}" c_white="${c[15]}" c_red="${c[16]}"

# ---- color math -----------------------------------------------------------
# The per-channel hex split is theme::hex_rgb (C1) — "#rrggbb" -> "R G B";
# the consumers below read it once into an array. (The old to_hex inverse
# helper had no callers and retired with this consolidation.)

# Faithful zj-hud color math (OKLab gradient, HSL darken/lighten, WCAG
# contrast) — ported 1:1 from zj-hud/src/shared/color.rs. The earlier
# linear-sRGB lerp read muddier on the mid stops (Mode B color audit).
zmodload zsh/mathfunc 2>/dev/null || true

_lin() {  # srgb channel 0..255 -> linear 0..1 (REPLY)
  local -F v=$(( $1 / 255.0 ))
  if (( v <= 0.04045 )); then REPLY=$(( v / 12.92 ))
  else REPLY=$(( ((v + 0.055) / 1.055) ** 2.4 )); fi
}
_unlin() {  # linear 0..1 -> srgb channel 0..255 (REPLY, rounded+clamped)
  local -F v=$1
  (( v < 0.0 )) && v=0.0
  (( v > 1.0 )) && v=1.0
  if (( v <= 0.0031308 )); then v=$(( v * 12.92 ))
  else v=$(( 1.055 * v ** (1.0 / 2.4) - 0.055 )); fi
  REPLY=$(( int(floor(v * 255.0 + 0.5)) ))
}
oklab_of() {  # "#rrggbb" -> reply=(L a b)
  local -F r g b l m s l_ m_ s_
  local -a rgb; rgb=( ${(s: :)"$(theme::hex_rgb "$1")"} )
  _lin $rgb[1]; r=$REPLY
  _lin $rgb[2]; g=$REPLY
  _lin $rgb[3]; b=$REPLY
  l=$(( 0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b ))
  m=$(( 0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b ))
  s=$(( 0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b ))
  l_=$(( cbrt(l) )); m_=$(( cbrt(m) )); s_=$(( cbrt(s) ))
  reply=( $(( 0.2104542553 * l_ + 0.7936177850 * m_ - 0.0040720468 * s_ )) \
          $(( 1.9779984951 * l_ - 2.4285922050 * m_ + 0.4505937099 * s_ )) \
          $(( 0.0259040371 * l_ + 0.7827717662 * m_ - 0.8086757660 * s_ )) )
}
oklab_hex() {  # L a b -> REPLY="#rrggbb"
  local -F L=$1 a=$2 b2=$3 l_ m_ s_ l m s r g b
  local ri gi bi
  l_=$(( L + 0.3963377774 * a + 0.2158037573 * b2 ))
  m_=$(( L - 0.1055613458 * a - 0.0638541728 * b2 ))
  s_=$(( L - 0.0894841775 * a - 1.2914855480 * b2 ))
  l=$(( l_ * l_ * l_ )); m=$(( m_ * m_ * m_ )); s=$(( s_ * s_ * s_ ))
  r=$((  4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s ))
  g=$(( -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s ))
  b=$(( -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s ))
  _unlin $r; ri=$REPLY
  _unlin $g; gi=$REPLY
  _unlin $b; bi=$REPLY
  REPLY="$(printf '#%02x%02x%02x' "$ri" "$gi" "$bi")"
}
# lerp COLOR_A COLOR_B NUM DEN -> hex at NUM/DEN along the OKLab line
lerp() {
  local -F t=$(( $3 * 1.0 / $4 )) L a b
  local -a A B
  oklab_of "$1"; A=("${reply[@]}")
  oklab_of "$2"; B=("${reply[@]}")
  L=$(( A[1] + (B[1] - A[1]) * t ))
  a=$(( A[2] + (B[2] - A[2]) * t ))
  b=$(( A[3] + (B[3] - A[3]) * t ))
  oklab_hex $L $a $b
  print -rn -- "$REPLY"
}
to_hsl() {  # "#rrggbb" -> reply=(h s l)
  local -F r g b mx mn d h s l
  local -a rgb; rgb=( ${(s: :)"$(theme::hex_rgb "$1")"} )
  r=$(( rgb[1] / 255.0 )); g=$(( rgb[2] / 255.0 )); b=$(( rgb[3] / 255.0 ))
  mx=$r; (( g > mx )) && mx=$g; (( b > mx )) && mx=$b
  mn=$r; (( g < mn )) && mn=$g; (( b < mn )) && mn=$b
  d=$(( mx - mn ))
  l=$(( (mx + mn) / 2.0 ))
  if (( d == 0.0 )); then reply=( 0.0 0.0 $l ); return 0; fi
  s=$(( d / (1.0 - fabs(2.0 * l - 1.0)) ))
  if (( mx == r )); then h=$(( 60.0 * fmod((g - b) / d, 6.0) ))
  elif (( mx == g )); then h=$(( 60.0 * ((b - r) / d + 2.0) ))
  else h=$(( 60.0 * ((r - g) / d + 4.0) )); fi
  (( h < 0.0 )) && h=$(( h + 360.0 ))
  reply=( $h $s $l )
}
from_hsl() {  # h s l -> REPLY="#rrggbb"
  local -F h=$1 s=$2 l=$3 c x m r1 g1 b1
  local v
  if (( s == 0.0 )); then
    v=$(( int(floor(l * 255.0 + 0.5)) ))
    REPLY="$(printf '#%02x%02x%02x' "$v" "$v" "$v")"
    return 0
  fi
  c=$(( (1.0 - fabs(2.0 * l - 1.0)) * s ))
  x=$(( c * (1.0 - fabs(fmod(h / 60.0, 2.0) - 1.0)) ))
  m=$(( l - c / 2.0 ))
  case $(( int(h / 60.0) )) in
    0) r1=$c g1=$x b1=0.0 ;;
    1) r1=$x g1=$c b1=0.0 ;;
    2) r1=0.0 g1=$c b1=$x ;;
    3) r1=0.0 g1=$x b1=$c ;;
    4) r1=$x g1=0.0 b1=$c ;;
    *) r1=$c g1=0.0 b1=$x ;;
  esac
  REPLY="$(printf '#%02x%02x%02x' \
    $(( int(floor((r1 + m) * 255.0 + 0.5)) )) \
    $(( int(floor((g1 + m) * 255.0 + 0.5)) )) \
    $(( int(floor((b1 + m) * 255.0 + 0.5)) )))"
}
_rel_lum() {  # "#rrggbb" -> REPLY (WCAG relative luminance)
  local -F r g b
  local -a rgb; rgb=( ${(s: :)"$(theme::hex_rgb "$1")"} )
  _lin $rgb[1]; r=$REPLY
  _lin $rgb[2]; g=$REPLY
  _lin $rgb[3]; b=$REPLY
  REPLY=$(( 0.2126 * r + 0.7152 * g + 0.0722 * b ))
}
contrast() {  # A B -> REPLY (ratio)
  local -F l1 l2 hi lo
  _rel_lum "$1"; l1=$REPLY
  _rel_lum "$2"; l2=$REPLY
  if (( l1 > l2 )); then hi=$l1 lo=$l2; else hi=$l2 lo=$l1; fi
  REPLY=$(( (hi + 0.05) / (lo + 0.05) ))
}

# Auto-contrast fg, exactly format_segment: darken(0.8) in HSL; if the
# WCAG contrast against the pill is under 3.8, lighten(0.6) instead.
seg_fg() {
  local bg="$1" fg
  local -F h sat l ratio
  to_hsl "$bg"; h=${reply[1]} sat=${reply[2]} l=${reply[3]}
  local -F ld=$(( l - 0.8 ))
  (( ld < 0.0 )) && ld=0.0
  from_hsl $h $sat $ld; fg=$REPLY
  contrast "$bg" "$fg"; ratio=$REPLY
  if (( ratio < 3.8 )); then
    local -F ll=$(( l + 0.6 ))
    (( ll > 1.0 )) && ll=1.0
    from_hsl $h $sat $ll; fg=$REPLY
  fi
  print -rn -- "$fg"
}

# ---- glyphs ---------------------------------------------------------------
DIV=$'\Ue0ba'
I_LOCKED=$'\U000F033E' I_RESIZE=$'\U000F0A68' I_PANE=$'\Uebc8'
I_TAB=$'\U000F04E9'    I_MOVE=$'\U000F0655'   I_SCROLL=$'\U000F0A64'
I_SESSION=$'\U000F0640'   I_TMUX=$'\U000F0633'
I_RENAME=$'\U000F0455'    I_SEARCH=$'\Uf002'    I_COPY=$'\U000F018F'
I_TCASE=$'\Ueab1' I_TWORD=$'\Ueb7e' I_TWRAP=$'\U000F0547'
I_ALT=$'\U000F0635' I_ESC=$'\U000F12B7'
I_CLOCK=$'\U000F00F0'
I_WIFI_ON=$'\U000F05A9' I_WIFI_OFF=$'\U000F092E'
I_HOST=$'\U000F048D'
I_BATT=( $'\U000F008E' $'\U000F12A1' $'\U000F12A2' $'\U000F12A3' )

# ---- mode resolution -------------------------------------------------------
# THE MODE IS THE TOP OF THE STACK. tmux state gets no vote on WHICH state it
# is: the copy family is a single tmux fact (pane_in_mode) wearing three
# faces, so a search that stops matching (M-c on a lowercase term) clears
# search_present and used to read as Scroll — while the user was still
# standing in Search, with the term and the toggles in hand.
#
# What tmux state DOES get to say is whether the stack has gone stale: an
# entry nothing has popped, for a mode the client demonstrably left. Then
# the bar falls back to resolving from tmux, which is also the answer for a
# copy-mode entered outside the stack entirely (a hook, the app itself).
typeset -a mstack
mstack=(${(s: :)stack_raw})
_stack_live() {           # is the top entry still true of this client?
  local st="$1"
  case "$st" in
    scroll|copy|search)   [[ "$in_copy" == 1 ]] ;;
    command)              [[ "$prefix_on" == 1 || "$key_table" == prefix ]] ;;
    rename)               return 1 ;;   # the @renaming branch below owns it
    *) mux_mode::meta "$st" 2>/dev/null || return 1
       [[ -n "$MM_KEYTABLE" && "$key_table" == "$MM_KEYTABLE" ]] ;;
  esac
}
mode_color="" mode_body="" hint_body=""
mode_state=""
if (( ${#mstack} )); then
  mode_state="${mstack[-1]%%:*}"
  _stack_live "$mode_state" || mode_state=""
fi
if [[ -n "$mode_state" ]] && mux_mode::meta "$mode_state" 2>/dev/null; then
  mode_color="$MM_COLOR" mode_body="$MM_ICON $MM_TITLE"
elif mux_mode::resolve "$key_table" "$in_copy" "$visual_on" "$searching_on" \
       "$search_on" "$prefix_on" 2>/dev/null; then
  mode_color="$MM_COLOR" mode_body="$MM_ICON $MM_TITLE"
fi
case "${MM_STATE:-}" in
  search) hint_body=search ;;
  locked|nested) hint_body=exit ;;
esac
if [[ -n "$renaming" ]]; then
  # @renaming carries the KIND, so the hint can advertise the keys this
  # rename actually has: only a SESSION can be rolled a random name.
  mux_mode::meta rename 2>/dev/null && {
    mode_color="$MM_COLOR" mode_body="$MM_ICON $MM_TITLE"
    [[ "$renaming" == session ]] && hint_body=rename_session || hint_body=rename
  }
fi

# ---- ssh / fullscreen -----------------------------------------------------
# The host segment answers "is this session being USED remotely" — the
# attach truth: the session env, refreshed from each attaching client
# (a VNC/local attach is local; an ssh attach is remote). zj-hud checks
# its server's own env instead, which is static per server — per-attach
# is the intended semantic here (as-built deviation, user-ratified).
# The session-env probe canonicalized as mux::session_is_remote "$sess"
# (mux-bootstrap.zsh). Kept inline here: this is a tmux `#()` job that must
# NEVER block or error (see the note below), so it avoids sourcing an extra lib
# on the hot repaint path. Keep it in sync with the shared helper.
is_ssh=0
if [[ -n "$sess" ]]; then
  v="$("$TMUX_BIN" show-environment -t "$sess" SSH_CONNECTION 2>/dev/null)" || v=""
  [[ "$v" == SSH_CONNECTION=* ]] && is_ssh=1
fi
# NOTHING in here may ask the system a question that can BLOCK. tmux runs
# this as a `#()` job and will not start another while one is in flight, so
# a slow render does not merely lag the bar — it stops the bar being
# re-rendered at all between runs. Asking the accessibility API whether
# Ghostty is fullscreen cost 4-11 SECONDS a repaint (measured), so every mode
# pill was gone before the ribbon was next expanded: Alt+w lit nothing,
# because the whole mode began and ended inside one render. Both terminals
# therefore read a MIRROR that someone else keeps up to date.
# $(<f) reads in-process (no cat fork); the -r guard is required — an inline
# 2>/dev/null on $(<f) would run $NULLCMD and fork after all.
is_fullscreen=0
if (( is_ssh )); then
  # A REMOTE session cannot choose its mirror by terminal name, and does not
  # need to. It cannot, because through a nested mux `client_termname`
  # answers the INNER mux's TERM (tmux-256color) rather than the physical
  # terminal, so both branches below would miss and fullscreen could never
  # register on a remote shell — observed on the dev-shell: the window went
  # fullscreen and the ribbon never noticed. It does not need to, because
  # wezterm.lua writes its mirror only on the machine WezTerm itself runs
  # on; out here the probe's mirror is the only one anything maintains, and
  # it already carries the PEER's state whatever terminal the human is at
  # (mux-fullscreen-probe fills it from `window.fullscreen.state` over the
  # bridge, or from --flip straight after a toggle).
  [[ -r "$GHOSTTY_FS_STATE" && "$(<"$GHOSTTY_FS_STATE")" == true ]] && is_fullscreen=1
elif [[ "${client_term:l}" == *ghostty* ]]; then
  [[ -r "$GHOSTTY_FS_STATE" && "$(<"$GHOSTTY_FS_STATE")" == true ]] && is_fullscreen=1
elif [[ -r "$FS_STATE" && "$(<"$FS_STATE")" == true ]]; then
  is_fullscreen=1
fi

# System segments. The rule exists because FULLSCREEN HIDES THE MACOS MENU
# BAR: windowed, the menu bar already shows the clock and the battery, so the
# ribbon stays out of the way; fullscreen, it takes over. Width gate
# (fullscreen_min_cols 100) is zj-hud parity.
#
# Over ssh the two halves part company, because the menu bar that just
# disappeared belongs to the machine at the OTHER end of the tunnel:
#   clock          — machine-independent, and exactly what you just lost
#   battery/wifi   — these measure THIS machine, which is not the one you are
#                    sitting at. A mac-mini's mains-power reading tells you
#                    nothing about the laptop in front of you, so they stay
#                    hidden until they can be fetched from the origin.
# Before fullscreen was knowable over ssh this distinction could not arise —
# the whole group was simply suppressed for remote clients.
show_sys=0
show_clock=0
if (( is_fullscreen )); then
  cw="$("$TMUX_BIN" display -p '#{client_width}' 2>/dev/null)" || cw=""
  [[ "$cw" == <-> ]] || cw=999
  if (( cw >= 100 )); then
    show_clock=1
    (( is_ssh )) || show_sys=1
  fi
fi

# ---- segment bodies (left to right) ---------------------------------------
typeset -a bodies kinds

[[ -n "$mode_body" ]] && { bodies+=("$mode_body"); kinds+=(mode); }
# zj-hud's which-key hint: while the panel is NOT on screen in a live mode
# — hidden with M-. or a start_hidden mode like Scroll — the bar advertises
# the toggle ("󰘵 . keys").
# Visibility is a field of the top MODE-STACK entry (@mux_stack, see
# lib/mux/stack.zsh) — the bar reads the very same source the panel does, so
# the hint cannot contradict what is on screen.
wk_cfg="$(grep -m1 '^#cfg' "${WK_DATA:-$HOME/.config/mux/whichkey.data}" 2>/dev/null)"
wk_key="" wk_start_hidden=""
for kv in ${(ps:\t:)wk_cfg}; do
  case "$kv" in
    toggle=*) wk_key="${kv#*=}" ;;
    start_hidden=*) wk_start_hidden="${kv#*=}" ;;
  esac
done
wk_suppressed=0
if (( ${#mstack} )); then
  [[ "${mstack[-1]##*:}" == 1 ]] || wk_suppressed=1
else
  # a mode entered outside the stack (a hook, an app): fall back to the
  # start_hidden default for the state the resolver reports
  for sh in ${(s:,:)wk_start_hidden}; do
    [[ -n "$sh" && "$sh" == "${MM_STATE:-}" ]] && wk_suppressed=1
  done
fi
# …and never while a DIALOG owns the keyboard. The search input and the
# rename prompt are popups: they swallow every key, M-. included, so the
# hint would be advertising something the user cannot press. (SearchInput)
# stays quiet; (SearchMode) — term committed, dialog gone — advertises again.
dialog_up=0
[[ "$searching_on" == 1 || -n "$renaming" ]] && dialog_up=1
if [[ -n "$mode_body" && -n "$wk_key" ]] && (( wk_suppressed && ! dialog_up )); then
  bodies+=("@WKHINT@${wk_key}"); kinds+=(wkhint)
fi
if [[ "$hint_body" == search ]]; then
  # the count first, then zj-hud's search_hint_segment: case/word/wrap with
  # the glyph bright when on
  # X / N — the search's position over the match count. tmux exposes no
  # index (its whole search vocabulary is count/present/partial/timed_out),
  # so X is mux-search's own: the cursor may wander without moving it.
  [[ "$search_count" == <-> ]] || search_count=0
  [[ "$search_idx" == <-> ]] || search_idx=0
  (( search_count == 0 )) && search_idx=0
  [[ "$search_partial" == 1 ]] && search_count="${search_count}+"
  bodies+=("$I_TCASE case  $I_TWORD word  $I_TWRAP wrap"); kinds+=(shint)
  bodies+=("${search_idx} / ${search_count}"); kinds+=(count)
elif [[ "$hint_body" == rename_session ]]; then
  # The roll is advertised HERE rather than inside the input field: bindings
  # belong with the other bindings. khint bodies are KEYCAP\tLABEL pairs so
  # the paint below can two-tone them like the fixed `exit` hint.
  bodies+=("$I_ALT r"$'\t'"random"$'\t'"$I_ESC"$'\t'"cancel"); kinds+=(khint)
elif [[ "$hint_body" == rename ]]; then
  bodies+=("$I_ESC"$'\t'"cancel"); kinds+=(khint)
elif [[ -n "$hint_body" ]]; then
  bodies+=("$I_ALT $I_ESC  exit"); kinds+=(hint)
fi

if [[ -n "$sess" && "${(L)sess}" != main ]]; then
  # kebab-case -> Title Case (zj-hud session_segment)
  typeset -a words
  words=(${(s:-:)sess})
  bodies+=("$I_SESSION ${(j: :)${(C)words}}"); kinds+=(session)
fi

# The @jobs segment (phase 3, job-runner spec §8): N▶ running, M✗ unseen
# failures — the dashboard's promised "dismissed but still running"
# affordance. Data only in the option; presentation lives here. Hidden
# entirely when the option is empty (no live jobs, nothing unseen).
if [[ "$jobs_raw" == <->" "<-> ]]; then
  jobs_running="${jobs_raw%% *}"
  jobs_failed="${jobs_raw##* }"
  jobs_body=""
  (( jobs_running > 0 )) && jobs_body="${jobs_running}▶"
  if (( jobs_failed > 0 )); then
    [[ -n "$jobs_body" ]] && jobs_body+="  "
    jobs_body+="@JF@${jobs_failed}✗"
  fi
  [[ -n "$jobs_body" ]] && { bodies+=("$jobs_body"); kinds+=(jobs); }
fi

typeset -a w
if (( show_sys )); then
  batt="$("$PMSET" -g batt 2>/dev/null)" || batt=""
  pct="$(grep -Eo '[0-9]+%' <<<"$batt" | head -1)"; pct="${pct%\%}"
  if [[ "$batt" == *"AC Power"* && -n "$pct" ]]; then
    if (( pct == 100 )); then w+=($'\U000F0084')
    elif (( pct <= 5 )); then w+=($'\U000F089F'" ${pct}%")
    elif (( pct <= 39 )); then w+=($'\U000F12A4'" ${pct}%")
    elif (( pct <= 89 )); then w+=($'\U000F12A5'" ${pct}%")
    else w+=($'\U000F12A6'" ${pct}%")
    fi
  elif [[ "$batt" == *"Battery Power"* && -n "$pct" ]]; then
    if (( pct <= 5 )); then w+=("${I_BATT[1]} ${pct}%")
    elif (( pct <= 39 )); then w+=("${I_BATT[2]} ${pct}%")
    elif (( pct <= 89 )); then w+=("${I_BATT[3]} ${pct}%")
    else w+=("${I_BATT[4]} ${pct}%")
    fi
  fi
  wifi="$("$NETWORKSETUP" -getairportpower en0 2>/dev/null)" || wifi=""
  if [[ "${(L)wifi}" == *": on"* ]]; then w+=("$I_WIFI_ON"); else w+=("$I_WIFI_OFF"); fi
fi
if (( is_ssh )); then
  h=""
  [[ -r "$HOST_ALIAS" ]] && h="$(<"$HOST_ALIAS")"
  [[ -n "$h" ]] || h="$(hostname -s 2>/dev/null)" || h=""
  [[ -n "$h" ]] && w+=("$I_HOST $h")
fi
(( ${#w} )) && { bodies+=("${(j:  :)w}"); kinds+=(widgets); }

if (( show_clock )); then
  # One strftime (fork-free) instead of four date forks — which were also
  # non-atomic: crossing 12:00 between the %l:%M and %p reads rendered
  # "11:59PM" for a repaint. The | separator survives every field (%e/%l are
  # space-padded, never pipe-containing).
  if zmodload -F zsh/datetime b:strftime p:EPOCHSECONDS 2>/dev/null; then
    strftime -s dt '%a %b|%e|%l:%M|%p' "$EPOCHSECONDS"
  else
    dt="$(date '+%a %b|%e|%l:%M|%p')"
  fi
  dtp=("${(@s:|:)dt}")
  d="$dtp[1]"; e="$dtp[2]"; t="$dtp[3]"; ap="${(L)dtp[4]}"
  bodies+=("$I_CLOCK $d ${e## } ${t## }$ap"); kinds+=(time)
fi

n=${#bodies}
(( n )) || exit 0

# ---- gradient + emission --------------------------------------------------
base="${mode_color:-$tab_bg}"
out="" prev_bg="$bar_bg"
for (( i = 1; i <= n; i++ )); do
  # segment i (1-based, left to right) gets stop n-i of 0..n (right edge =
  # stop 0 = full base color; leftmost fades toward the bar background).
  bg="$(lerp "$base" "$bar_bg" $(( n - i )) "$n")"
  fg="$(seg_fg "$bg")"
  body="${bodies[i]}"
  if [[ "${kinds[i]}" == wkhint ]]; then
    wkk="${bodies[i]#@WKHINT@}"
    # glyphs like the panel's: M-. → 󰘵 .
    wkk="${wkk/M-/${I_ALT} }"
    out+="#[bg=${prev_bg},fg=${bg}]${DIV}#[bg=${bg},fg=${c_white}] ${wkk}#[fg=${fg}] keys "
  elif [[ "${kinds[i]}" == count ]]; then
    out+="#[bg=${prev_bg},fg=${bg}]${DIV}#[bg=${bg},fg=${fg}] ${bodies[i]} "
  elif [[ "${kinds[i]}" == shint ]]; then
    sc="${search_toggles[1]:-0}" sw="${search_toggles[2]:-0}" sp="${search_toggles[3]:-1}"
    [[ "$sc" == 1 ]] && cg="$c_white" || cg="$fg"
    [[ "$sw" == 1 ]] && wg="$c_white" || wg="$fg"
    [[ "$sp" == 1 ]] && pg="$c_white" || pg="$fg"
    out+="#[bg=${prev_bg},fg=${bg}]${DIV}#[bg=${bg}] #[fg=${cg}]${I_TCASE} #[fg=${fg}]case  #[fg=${wg}]${I_TWORD} #[fg=${fg}]word  #[fg=${pg}]${I_TWRAP} #[fg=${fg}]wrap "
  elif [[ "${kinds[i]}" == khint ]]; then
    # KEYCAP\tLABEL pairs: keycaps pop, labels stay dark — the same two-tone
    # zj-hud uses, but the CONTENT comes from the caller instead of being
    # fixed, so each mode can advertise its own keys.
    typeset -a hp; hp=("${(@ps:\t:)bodies[i]}")
    seg=""
    for (( j = 1; j <= ${#hp}; j += 2 )); do
      seg+="#[fg=${fg_hi}] ${hp[j]}#[fg=${fg}] ${hp[j+1]} "
    done
    out+="#[bg=${prev_bg},fg=${bg}]${DIV}#[bg=${bg}]${seg}"
  elif [[ "${kinds[i]}" == jobs ]]; then
    # the failure half pops red (the badge is the alarm); running count
    # keeps the segment's auto-contrast fg
    seg="${bodies[i]/@JF@/#[fg=${c_red}]}"
    out+="#[bg=${prev_bg},fg=${bg}]${DIV}#[bg=${bg},fg=${fg}] ${seg}#[fg=${fg}] "
  elif [[ "${kinds[i]}" == hint ]]; then
    # two-tone hint: keycap glyphs pop white-ish, the label stays dark —
    # zj-hud paints keycaps in hint_glyph_on over the mode color.
    out+="#[bg=${prev_bg},fg=${bg}]${DIV}#[bg=${bg},fg=${fg_hi}] ${I_ALT} ${I_ESC} #[fg=${fg}] exit "
  else
    out+="#[bg=${prev_bg},fg=${bg}]${DIV}#[bg=${bg},fg=${fg}] ${body} "
  fi
  prev_bg="$bg"
done
print -rn -- "${out}#[default]"

exit 0
