#!/usr/bin/env zsh
#
# fzf-tab-preview-open — open the highlighted fzf-tab candidate in a floating
# Zellij preview pane.
#
# Called from an fzf `execute-silent(...)` binding with fzf-tab's field-2
# display key. The helper resolves that key through fzf-tab's live compcap file.

emulate -L zsh
set -u

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

debug_log() {
  [[ -n ${FZF_TAB_PREVIEW_OPEN_DEBUG:-} ]] || return 0
  local log_dir="${XDG_CACHE_HOME:-$HOME/.cache}"
  mkdir -p "$log_dir" 2>/dev/null
  print -r -- "$*" >>"$log_dir/fzf-tab-preview-open.log"
}

resolve_fzf_tab_desc() {
  local desc="$1"
  local tmp_dir="${TMPPREFIX:-/tmp/zsh}-fzf-tab-$USER"
  local bs=$'\2'
  local file line
  local -a files

  files=("$tmp_dir"/compcap.*(N.om))
  for file in "$files[@]"; do
    for line in "${(@f)$(<"$file")}"; do
      [[ ${line%%$bs*} == "$desc" ]] || continue
      local -A v=("${(@0)${line#*$bs}}")
      [[ -n ${v[realdir]-} ]] || return 1
      print -r -- "${v[realdir]}${(Q)v[word]}"
      return 0
    done
  done

  return 1
}

target="${1:-}"
if [[ "$target" == "--fzf-tab-desc" ]]; then
  target="$(resolve_fzf_tab_desc "${2:-}")" || target=""
fi

debug_log "target=$target"
[[ -n "$target" && -f "$target" ]] || { debug_log "skip=not-file"; exit 0; }
source "${MUX_LIB:-$HOME/.local/lib}/mux.zsh"
mux::available || { debug_log "skip=no-mux"; exit 0; }

# Ask the raster pipeline what it can show — images, PDFs, office and iWork
# documents, fonts, video frames, cover art — instead of gating on image/*,
# which left Ctrl+O silent on everything else it can actually render.
# rasterisable answers WITHOUT converting, so a no is cheap.
source "${RASTER_LIB:-$HOME/.local/lib}/raster-common.zsh"
raster::rasterisable "$target" || { debug_log "skip=not-rasterisable"; exit 0; }

debug_log "open=$target"
# One quick-look implementation for every entry point (Ctrl+O here, CMD+click
# in WezTerm, Ctrl+Space in yazi): term-quick-view picks the tab-or-float per
# backend and renders.
term-quick-view "$target"
