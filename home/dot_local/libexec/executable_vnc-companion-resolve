#!/usr/bin/env zsh
# vnc-companion-resolve <screen-sharing-window-title>
#
# Maps a Screen Sharing window title to the ssh alias of a bootstrapped
# machine, so the VNC companion (hammerspoon) can raise the same ssh carrier
# an interactive session would. The truth source is the onboarded fragments'
# `Host` lines (alias + peer hostname + .local form, written by
# system-onboard): if any of those names appears in the title
# (case-insensitive), the FIRST token — the canonical alias, the one the
# Match hook and forwards are keyed to — is printed. rc 1 = not one of ours
# (an ad-hoc VNC target gets no companion, silently).
set -eu

title="${1:-}"
[[ -n "$title" ]] || exit 1
title="${title:l}"

confdir="${VNC_COMPANION_CONF_DIR:-$HOME/.ssh/config.d}"
[[ -d "$confdir" ]] || exit 1

local conf line alias name cn
for conf in "$confdir"/*.conf(N); do
  # The pretty ComputerName ("Thiago's Mac Mini") is what Screen Sharing
  # titles actually carry; ssh-prepare-connection heals it into the front
  # matter on every connect. Checked alongside the Host tokens.
  cn="$(awk '/^#[[:space:]]*---[[:space:]]*$/{n++;next} n==1 && sub(/^#[[:space:]]*computer-name:[[:space:]]*/,""){print;exit}' "$conf")"
  alias=""
  while IFS= read -r line; do
    [[ "$line" == Host\ * ]] || continue
    local -a names=(${=line})
    alias="${names[2]:-}"
    [[ -n "$alias" ]] || continue
    for name in "${names[@]:1}"; do
      if [[ "$title" == *"${name:l}"* ]]; then
        print -r -- "$alias"
        exit 0
      fi
    done
    break
  done < "$conf"
  if [[ -n "$alias" && -n "$cn" && "$title" == *"${cn:l}"* ]]; then
    print -r -- "$alias"
    exit 0
  fi
done
exit 1
