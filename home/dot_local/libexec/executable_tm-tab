#!/usr/bin/env zsh
# tm-tab [tm-args…] — open a Terminal Time Machine session in a NEW tab
# (yazi's `g t` lands here; works from any shell inside a mux too).
# Args are tm's: a path (dir = explore, file = scoped diff), --diff, etc.
#
# ZELLIJ: the tab is spawned WITH the session command baked into a generated
# layout — nothing is typed into panes (the old write-chars route raced
# tab-construction focus, spraying keys into plugin panes or the origin
# yazi). The layout derives from the deployed default.kdl, so the tab
# keeps the full zj-hud chrome its default_tab_template provides.
#
# TMUX: none of that is needed — `new-window` takes the command directly and
# the window inherits the session's chrome, so the whole layout dance is
# skipped (migration Phase 6.6).
emulate -L zsh
set -u

# Diagnostics on demand: `touch $BKP_STATE/tm-tab.debug` and every run
# xtraces into tm-tab.log alongside it. TM_TAB_* are spec seams — the
# user zshenv re-exports the XDG vars, so env overrides die at startup.
local _dbg="${TM_TAB_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}}/terminal-backup"
if [[ -e "$_dbg/tm-tab.debug" ]]; then
  exec 2>>"$_dbg/tm-tab.log"
  print -u2 "== run $(date +%T) argv: $*"
  setopt xtrace
fi

# Empty positionals happen (yazi's "$0" in an empty directory) — drop them.
set -- "${(@)@:#}"

source "${MUX_LIB:-$HOME/.local/lib}/mux.zsh"

# Outside any mux there is no tab to make: degrade to an inline session.
if ! mux::available; then
  exec system-backup browse "${@:-$PWD}"
fi

# Tab title from the anchor (last non-flag arg, PWD when none).
local a anchor="$PWD"
for a in "$@"; do
  [[ "$a" == --* ]] || anchor="$a"
done
local name="${${anchor:a}:t}"

# tmux: a window takes the command directly — no layout, no escaping dance.
if [[ "$(mux::backend)" == tmux ]]; then
  mux::new_tab --name "tm: $name" \
    -- "$HOME/.local/bin/system-backup" browse "${@:-$PWD}"
  return $?
fi

# The pane runs zsh -c so the session sees the full user environment
# (.zshenv always runs); (q) shell-quotes each arg into that command
# line, then the whole line is KDL-escaped (backslash first, quotes
# second) to survive the layout file.
local -a cmd=(exec "$HOME/.local/bin/system-backup" browse "${@:-$PWD}")
local sh_line="${(j: :)${(@q)cmd}}"
local kdl="${sh_line//\\/\\\\}"
kdl="${kdl//\"/\\\"}"
local kname="tm: ${name//\\/\\\\}"
kname="${kname//\"/\\\"}"

local base="${TM_TAB_LAYOUTS:-${XDG_CONFIG_HOME:-$HOME/.config}/zellij/layouts}/default.kdl"
local layout
layout=$(mktemp "${TMPDIR:-/tmp}/tm-tab.XXXXXX") || exit 1
{
  if [[ -r "$base" ]]; then
    # Everything but the closing brace: pane templates and the
    # default_tab_template (chrome + floating which-key panes) — the
    # tab node below gets wrapped by it.
    sed '$d' "$base"
  else
    print 'layout {'   # chrome-less fallback: still a working session
  fi
  print -r -- "    tab name=\"$kname\" focus=true {"
  print -r -- "        pane command=\"/bin/zsh\" {"
  print -r -- "            args \"-c\" \"$kdl\""
  print -r -- "            close_on_exit true"
  print -r -- "        }"
  print -r -- "    }"
  print '}'
} > "$layout"

zellij action new-tab --name "$kname" --layout "$layout"
local rc=$?
# The server reads the file on its own clock — reap it off the fast path.
( sleep 5; rm -f "$layout" ) &!
return $rc
