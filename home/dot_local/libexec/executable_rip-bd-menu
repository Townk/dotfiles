#!/usr/bin/env python3
"""rip-bd-menu — the Blu-ray session pre-fill harvester.

Reads the scan's title rows (JSONL on stdin: no, seconds, source, segments)
and the mounted disc's BD-J menu assets under <volume>/BDMV/JAR/, and prints
ONE JSON object the scan merges into its output:

  {"suggest": {"<no>": {"role": "extra"|"skip", "name": "...", "why": "..."}},
   "candidates": ["...", ...]}

Two independent layers (spec 2026-09-06-rip-bluray-prefill-design.md, with
its "Live-pass amendments" section):
  structure — from the rows alone: the feature's raw m2ts twin, play-all
              playlists and their parts;
  names     — the jar's SF_nn[_DS_mm]_<Slug>_onKeyPressed handler names,
              matched to the menu LABELS read by tesseract from each
              button's own crop of the resources_<lang>.xml sprite atlas.
Every layer degrades on its own: no JAR dir → structure only; no atlas
regions (or no ImageMagick) → whole-sheet OCR; tesseract failing →
slug-rendered names. Only unreadable stdin is an error (rc 2).
Never touches the drive through MakeMKV; reads files under BDMV/JAR only.
"""
import glob
import json
import os
import re
import subprocess
import sys
import tempfile
import zipfile

STOP_SLUGS = re.compile(
    r"^(audio|subtitles?|chaphighlight|chTxt\d+|sceneselections?|specialfeatures"
    r"|DeletedScenes|CommentaryBy|PlayAll|Play|DiscMenu|Off|Resume|Setup"
    # the live disc's setup buttons: setaudio01..NN, setsubtitle01..NN,
    # setsuboff — atlas regions like any other button, never a title's name
    r"|setaudio\d*|setsubtitles?\d*|setsuboff"
    r"|english|francais|french|espanol|spanish|nederlands|dutch|deutsch|german"
    r"|italiano|italian|portugues|portuguese|japanese|korean|chinese)$",
    re.I,
)
STOP_TEXT = re.compile(
    r"^(play|play all|audio|subtitles?|scene selections?|disc menu|special features"
    r"|deleted scenes|off|resume|set ?up|english.*|fran[cç]ais.*|espa[nñ]ol.*"
    r"|nederlands.*|deutsch.*|italiano.*|portugu[eê]s.*|commentary by.*)$",
    re.I,
)
SMALL = {"a", "an", "the", "of", "to", "in", "and", "or", "for", "at", "by"}
LANG2 = {"eng": "en", "fra": "fr", "fre": "fr", "spa": "es", "deu": "de", "ger": "de",
         "ita": "it", "nld": "nl", "dut": "nl", "por": "pt", "jpn": "ja"}


def warn(msg):
    print("rip-bd-menu: " + msg, file=sys.stderr)


def read_rows():
    rows = []
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            obj = json.loads(line)
        except ValueError:
            raise SystemExit(_fail("rows: not JSON: " + line[:60]))
        if "no" not in obj:
            continue
        segs = [s for s in str(obj.get("segments", "")).split(",") if s]
        try:
            no = int(obj["no"])
            seconds = int(obj.get("seconds") or 0)
        except (TypeError, ValueError):
            raise SystemExit(_fail("rows: not a number: " + line[:60]))
        rows.append({
            "no": no,
            "seconds": seconds,
            "source": str(obj.get("source", "")),
            "segments": segs,
        })
    return rows


def _fail(msg):
    warn(msg)
    return 2


def source_number(row):
    m = re.match(r"(\d+)", row["source"])
    return int(m.group(1)) if m else 10**9


# --- structure ---------------------------------------------------------------

def structure(rows):
    """Return (feature, suggest, playall_groups, standalone).

    feature is the row the panel's initRows will pick: the longest title,
    ties to the lowest no (spec rule 1) — NOT restricted to .mpls rows, so a
    disc whose feature is authored as a raw .m2ts is still recognised as the
    feature rather than named as an extra.

    suggest holds twin / playall / part entries (names empty). playall_groups
    is [(playall_row, [part_rows_in_segment_order]), ...] ordered by the
    play-all's own source number. standalone is every other non-feature row,
    ordered by distance from the nearest play-all group's playlist range.
    """
    suggest = {}
    feature = max(rows, key=lambda r: (r["seconds"], -r["no"])) if rows else None

    by_segs = {}
    for r in rows:
        if r["segments"]:
            by_segs.setdefault(tuple(r["segments"]), []).append(r)

    twins = set()
    for r in rows:
        if r is feature:
            continue
        key = tuple(r["segments"])
        if not key:
            continue
        for q in by_segs.get(key, []):
            if q is r:
                continue
            # A twin is an .m2ts/.mpls pair sharing segments (spec rule 2,
            # generalised): either q is the feature itself — covers a raw
            # .m2ts feature whose .mpls counterpart is then the twin — or r
            # is the .m2ts side of an ordinary .m2ts/.mpls pair.
            if q is feature or (r["source"].lower().endswith(".m2ts")
                                 and q["source"].lower().endswith(".mpls")):
                suggest[r["no"]] = {"role": "skip", "name": "", "why": "twin"}
                twins.add(r["no"])
                break

    single = {}
    for r in rows:
        if r is feature or r["no"] in twins:
            continue
        if len(r["segments"]) == 1:
            single.setdefault(r["segments"][0], r)

    groups = []  # (playall_row, [part_rows_in_segment_order])
    part_nos = set()
    for r in sorted(rows, key=source_number):
        if r is feature or r["no"] in twins or len(r["segments"]) < 2:
            continue
        if all(s in single for s in r["segments"]):
            suggest[r["no"]] = {"role": "skip", "name": "", "why": "playall"}
            parts = []
            for s in r["segments"]:
                p = single[s]
                if p["no"] not in part_nos:
                    parts.append(p)
                    part_nos.add(p["no"])
                    suggest[p["no"]] = {"role": "extra", "name": "", "why": "part"}
            groups.append((r, parts))

    playall_nos = {pr["no"] for pr, _ in groups}
    standalone = [r for r in rows
                  if r is not feature and r["no"] not in twins
                  and r["no"] not in playall_nos and r["no"] not in part_nos]
    # Special features are authored as a contiguous playlist block (spec
    # rule 8): order the standalone titles by distance from the NEAREST
    # play-all group's playlist range (each group's own min..max of its
    # source number and its parts'), so the featurette beside the scenes
    # (00719 next to 00714–00720) outranks pre-menu trailers at 00149 /
    # 01213, and a disc with several special-features menus measures each
    # standalone title against whichever group it actually sits beside.
    standalone.sort(key=lambda r: (group_distance(r, group_ranges(groups)),
                                   source_number(r)))
    return feature, suggest, groups, standalone


def group_ranges(groups):
    """[(lo, hi)] — each play-all group's min..max playlist source number."""
    out = []
    for pr, parts in groups:
        nums = [source_number(pr)] + [source_number(p) for p in parts]
        out.append((min(nums), max(nums)))
    return out


def group_distance(row, ranges):
    if not ranges:
        return 0
    n = source_number(row)
    return min(0 if lo <= n <= hi else min(abs(n - lo), abs(n - hi))
               for lo, hi in ranges)


# --- names -------------------------------------------------------------------

def slug_tokens(slug):
    return [t.lower() for t in re.findall(r"[A-Z]?[a-z]+|[A-Z]+(?![a-z])|\d+", slug)]


def slug_words(slug):
    return " ".join(t.capitalize() for t in slug_tokens(slug))


def title_case(s):
    """Title-case a menu string; small words lowercase in the MIDDLE only.

    Neither the first nor the LAST word is ever lowercased: a label that
    ends on a small word ends on it deliberately, and "The Making of"
    reads as a sentence someone cut short. "THE MAKING OF" -> "The Making
    Of" (final review, 2026-09-06).
    """
    words = s.split()
    last = len(words) - 1
    out = []
    for i, w in enumerate(words):
        lw = w.lower()
        if 0 < i < last and lw in SMALL:
            out.append(lw)
        elif w.isupper() or w.islower():
            out.append(w[:1].upper() + w[1:].lower())
        else:
            out.append(w)
    return " ".join(out)


TAG = re.compile(r"<\s*(composite|image)\b([^>]*)>", re.I)
ATTR = re.compile(r"([A-Za-z_][\w:.-]*)\s*=\s*\"([^\"]*)\"")


def atlas_regions(jar_dir, lang):
    """[(slug, sheet_png, (x, y, w, h))] in XML order, one region per slug.

    resources_<lang>.xml is a sprite ATLAS (live pass, 2026-09-06): a
    <composite name="X"> block lists the <image> regions of X.png in the same
    directory. `_n` (normal) is the clean reading; `_a` (activated) and `_s`
    (selected) are the glow variants and only stand in when `_n` is absent.
    A disc whose XML carries no regions returns [] and the caller falls back
    to whole-sheet OCR.
    """
    lang2 = LANG2.get(lang, lang[:2])
    name_re = re.compile(r"^%s_button_([A-Za-z0-9]+)_([ans])(?:_|$)" % re.escape(lang2))
    order, best = [], {}
    for xml in sorted(glob.glob(os.path.join(jar_dir, "*", "resources_%s.xml" % lang))):
        try:
            text = open(xml, encoding="utf-8", errors="replace").read()
        except OSError as e:
            warn("cannot read %s: %s" % (xml, e))
            continue
        sheet = None
        for tag in TAG.finditer(text):
            attrs = dict(ATTR.findall(tag.group(2)))
            if tag.group(1).lower() == "composite":
                sheet = attrs.get("name")
                continue
            m = name_re.match(attrs.get("name", ""))
            if not m or not sheet:
                continue
            try:
                box = tuple(int(attrs[k]) for k in ("x", "y", "width", "height"))
            except (KeyError, ValueError):
                continue
            key, rank = m.group(1).lower(), "nas".index(m.group(2))
            if key in best:
                if rank >= best[key][0]:
                    continue
            else:
                order.append(key)
            best[key] = (rank, m.group(1),
                         os.path.join(os.path.dirname(xml), sheet + ".png"), box)
    return [(best[k][1], best[k][2], best[k][3]) for k in order]


def clean_label(text):
    """Tidy one button's OCR reading: `|` is an I, `1FOOD` is two words."""
    s = " ".join("I" if t == "|" else t for t in text.split())
    s = re.sub(r"(\d)([A-Za-z]{2,})", r"\1 \2", s)
    return title_case(s)


def atlas_labels(jar_dir, lang):
    """({slug: label}, candidates, used_atlas) — OCR of each button's crop.

    Whole-sheet OCR of these atlases is unusable (light glow text on grey,
    three states side by side: tesseract read nothing or merged neighbours),
    so every non-stoplisted button is cropped out of its sheet with
    ImageMagick and read alone. used_atlas is False — the caller then runs
    the whole-sheet fallback — when the XML has no regions at all, or when
    ImageMagick is missing and every crop therefore failed.
    """
    regions = atlas_regions(jar_dir, lang)
    if not regions:
        return {}, [], False
    magick = os.environ.get("RIP_MAGICK_BIN", "magick")
    tess = os.environ.get("RIP_TESSERACT_BIN", "tesseract")
    labels, candidates, seen, cropped = {}, [], set(), 0
    with tempfile.TemporaryDirectory() as tmp:
        for slug, sheet, (x, y, w, h) in regions:
            if STOP_SLUGS.match(slug):
                continue
            out = os.path.join(tmp, "%s.png" % slug)
            try:
                # Flatten the transparent glow onto black, grey it, blow it up
                # and normalise: the live pass' recipe for making a 65 px-tall
                # menu label legible to tesseract. 15 s PER CROP, so one stuck
                # button cannot eat the scan's whole 60 s harvest budget.
                res = subprocess.run(
                    [magick, sheet, "-crop", "%dx%d+%d+%d" % (w, h, x, y),
                     "+repage", "-background", "black", "-flatten",
                     "-colorspace", "Gray", "-resize", "300%", "-normalize", out],
                    capture_output=True, text=True, timeout=15)
            except (OSError, subprocess.TimeoutExpired) as e:
                warn("magick failed on %s: %s" % (slug, e))
                continue
            if res.returncode != 0:
                warn("magick rc %d on %s" % (res.returncode, slug))
                continue
            cropped += 1
            try:
                res = subprocess.run([tess, out, "-", "-l", lang, "--psm", "6"],
                                     capture_output=True, text=True, timeout=15)
            except (OSError, subprocess.TimeoutExpired) as e:
                warn("tesseract failed on %s: %s" % (slug, e))
                continue
            if res.returncode != 0:
                warn("tesseract rc %d on %s" % (res.returncode, slug))
                continue
            label = clean_label(res.stdout)
            if not label:
                continue
            # The label map keeps every button it read (that is what handler
            # slugs are matched against); the DROPDOWN drops the UI words.
            labels[slug] = label
            key = label.lower()
            if len(label) >= 3 and not STOP_TEXT.match(label) and key not in seen:
                seen.add(key)
                candidates.append(label)
    if not cropped:
        warn("no atlas crop succeeded — falling back to whole-sheet OCR")
        return {}, [], False
    return labels, candidates, True


def handler_order(jar_dir):
    """[(sf, ds_or_None, slug)] sorted by (sf, ds), from every jar's bytes."""
    found = {}
    for jar in sorted(glob.glob(os.path.join(jar_dir, "*.jar"))):
        try:
            with zipfile.ZipFile(jar) as z:
                for name in z.namelist():
                    try:
                        data = z.read(name)
                    except Exception:
                        continue
                    for sf, ds, slug in re.findall(rb"SF_(\d+)(?:_DS_(\d+))?_([A-Za-z0-9]+)_onKeyPressed", data):
                        key = slug.decode().lower()
                        entry = (int(sf), int(ds) if ds else None, slug.decode())
                        found.setdefault(key, entry)
        except (zipfile.BadZipFile, OSError) as e:
            warn("cannot read %s: %s" % (jar, e))
    return sorted(found.values(), key=lambda e: (e[0], -1 if e[1] is None else e[1]))


def mappable_slugs(jar_dir):
    """[(slug, sf, ds)] — ONLY the jar's handler slugs, in (SF, DS) order.

    Live-pass amendment: button slugs are the label's FIRST words (`day1`,
    `howto`, `thinkim`) while handler slugs are its distinctive LAST words
    (`FoodPaste`, `PutOnSpacesuit`) — they do not coincide, and an XML-only
    slug maps to no title at all (it was naming menu stubs after audio-setup
    buttons). Buttons contribute LABELS; handlers contribute the mapping.
    """
    seen, ordered = set(), []
    for sf, ds, slug in handler_order(jar_dir):
        if slug.lower() in seen or STOP_SLUGS.match(slug):
            continue
        seen.add(slug.lower())
        ordered.append((slug, sf, ds))
    return ordered


def ocr_candidates(jar_dir, lang):
    """(candidates, ok). Blocks first, then single lines; stoplist applied."""
    tess = os.environ.get("RIP_TESSERACT_BIN", "tesseract")
    pngs = sorted(glob.glob(os.path.join(jar_dir, "*", "%s_composite_*.png" % lang))) \
        + sorted(glob.glob(os.path.join(jar_dir, "*", "common_composite_*.png")))
    blocks, lines = [], []
    ok = True
    for png in pngs:
        try:
            # 15 s PER SHEET, not 60: the scan gives the WHOLE harvest a 60 s
            # budget, and a disc carries several sprite sheets — one stuck
            # sheet must not consume the budget the rest of them need.
            res = subprocess.run([tess, png, "-", "--psm", "11", "-l", lang],
                                 capture_output=True, text=True, timeout=15)
        except (OSError, subprocess.TimeoutExpired) as e:
            warn("tesseract failed on %s: %s" % (png, e))
            ok = False
            break
        if res.returncode != 0:
            warn("tesseract rc %d on %s" % (res.returncode, png))
            ok = False
            break
        block = []
        for raw in res.stdout.split("\n") + [""]:
            line = re.sub(r"\s+", " ", raw).strip()
            if line:
                block.append(line)
            elif block:
                joined = " ".join(block)
                # Blocks first; the single lines of a WRAPPED label second,
                # and only when the block itself survived the stoplist —
                # "SCENE"/"SELECTIONS" or "DIRECTORS PHIL LORD" must never
                # become candidates on their own (spec rule 6).
                if len(joined) >= 3 and not STOP_TEXT.match(joined):
                    blocks.append(joined)
                    if len(block) > 1:
                        lines.extend(block)
                block = []
    if not ok:
        return [], False
    out, seen = [], set()
    for entry in blocks + lines:
        if len(entry) < 3 or STOP_TEXT.match(entry):
            continue
        key = entry.lower()
        if key in seen:
            continue
        seen.add(key)
        out.append(title_case(entry))
    return out, True


def letters(s):
    return re.sub(r"[^a-z0-9]", "", s.lower())


def match_names(slugs, candidates):
    """[(slug, sf, ds, name, why)] — each candidate consumed at most once.

    Only tokens of 3+ characters score a candidate (spec rule 7): short
    tokens like "a"/"i"/"on"/"of" match nearly any label and produced a
    false high-confidence name in review. Short tokens still render in the
    slug-rendered fallback name via slug_words, which uses every token.
    """
    free = list(candidates)
    out = []
    for slug, sf, ds in slugs:
        toks = [t for t in slug_tokens(slug) if len(t) >= 3]
        best, best_score = None, 0
        for cand in free:
            body = letters(cand)
            score = sum(1 for t in toks if t in body)
            if score > best_score:
                best, best_score = cand, score
        if best is not None and best_score >= 1:
            free.remove(best)
            out.append((slug, sf, ds, best, "menu"))
        else:
            out.append((slug, sf, ds, slug_words(slug), "slug"))
    return out


# --- main --------------------------------------------------------------------

def main():
    if len(sys.argv) != 2:
        return _fail("usage: rip-bd-menu <volume> < rows.jsonl")
    volume = sys.argv[1]
    try:
        rows = read_rows()
    except SystemExit as e:
        return e.code
    if not rows:
        return _fail("rows: nothing on stdin")

    feature, suggest, groups, standalone = structure(rows)

    jar_dir = os.path.join(volume, "BDMV", "JAR")
    lang = os.environ.get("RIP_BD_MENU_LANG", "eng")
    candidates, names = [], []
    if os.path.isdir(jar_dir):
        # Names run whenever JAR/ exists, independent of whether any handler
        # was found, and handlers are matched even when the label harvest came
        # back empty (tesseract failed) — they then keep their slug-rendered
        # fallback name (spec: the layers are independent in both directions).
        labels, candidates, used_atlas = atlas_labels(jar_dir, lang)
        if used_atlas:
            texts = list(labels.values())
        else:
            candidates, _ = ocr_candidates(jar_dir, lang)
            texts = list(candidates)
        slugs = mappable_slugs(jar_dir)
        if slugs:
            names = match_names(slugs, texts)
    else:
        warn("no BDMV/JAR under %s — structure only" % volume)

    mapped = 0
    if names:
        # DS-numbered names group by their SF menu; each group claims a
        # play-all BY PART COUNT (live-pass amendment): at minlength 30
        # MakeMKV also lists two-segment trailer playlists that are
        # structurally indistinguishable from a deleted-scenes play-all, so
        # position alone mapped the scene names onto a trailer.
        ds_group_map, ds_group_order = {}, []
        sf_names = []
        for _slug, sf, ds, name, why in names:
            if ds is None:
                sf_names.append((name, why))
                continue
            if sf not in ds_group_map:
                ds_group_map[sf] = []
                ds_group_order.append(sf)
            ds_group_map[sf].append((name, why))

        free = list(range(len(groups)))  # group indices, already in source order
        claimed = []
        for sf in ds_group_order:
            ds_group = ds_group_map[sf]
            if not free:
                break
            k = len(ds_group)
            exact = [g for g in free if len(groups[g][1]) == k]
            g = exact[0] if exact else min(free, key=lambda i: abs(len(groups[i][1]) - k))
            free.remove(g)
            claimed.append((g, ds_group))

        for g, ds_group in claimed:
            for row, (name, why) in zip(groups[g][1], ds_group):
                suggest[row["no"]] = {"role": "extra", "name": name, "why": why}
                mapped += 1
        # A play-all no DS group claimed is not a menu entry at all: skip it,
        # and skip its parts as segments of a skipped playlist.
        for g in free:
            playall_row, parts = groups[g]
            suggest[playall_row["no"]] = {"role": "skip", "name": "", "why": "unmapped"}
            for row in parts:
                suggest[row["no"]] = {"role": "skip", "name": "", "why": "segment"}

        # Standalone targets are >= 60 s (live-pass amendment): the menu-stub
        # playlists (30-51 s, 3-4 tiny segments) must never take a name. They
        # rank by distance from the nearest MATCHED group's playlist range.
        ranges = group_ranges([groups[g] for g, _ in claimed] or groups)
        targets = sorted((r for r in standalone if r["seconds"] >= 60),
                         key=lambda r: (group_distance(r, ranges), source_number(r)))
        for row, (name, why) in zip(targets, sf_names):
            suggest[row["no"]] = {"role": "extra", "name": name, "why": why}
            mapped += 1
    if mapped > 0:
        for r in rows:
            if r is feature or r["no"] in suggest:
                continue
            suggest[r["no"]] = {"role": "skip", "name": "", "why": "unmapped"}
        # parts the DS list did not cover keep role extra, name "" (why part)

    print(json.dumps({"suggest": {str(k): v for k, v in sorted(suggest.items())},
                      "candidates": candidates}, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
