#!/usr/bin/env zsh
# ai-assist-ask — the ONLY user-input channel for a running request. A thin shim
# over the input stdlib: it maps --type to the matching zj::* floating widget
# (which falls back to the inline input::* off-Zellij). All theming, chrome,
# geometry, and capture live in the stdlib now.
#
# Usage: ai-assist-ask [--type free|line|confirm|choose|form] [--title TEXT] "<question>" [choice...]
#   --title sets the dialog's ▓▓▓ header; the positional is the content (the
#           prompt). Without --title the header defaults to the content.
#   form: pass fields via repeated --field name:type:label[:param]
# Prints the answer on stdout. confirm prints "yes"/"no" and exits 0/1.
# Cancel (empty capture) exits 130.
set -uo pipefail

source "$HOME/.local/lib/zellij.zsh"

type="free"
title=""
question=""
other=""
multi=0
choices=()
fields=()
variant=()
while (($#)); do
  case "$1" in
    --type)  type="${2:-free}"; shift 2 ;;
    --title) title="${2-}"; shift 2 ;;
    --other) other="${2-}"; shift 2 ;;
    --multi) multi=1; shift ;;
    --field) fields+=("${2-}"); shift 2 ;;
    --danger)  variant+=(--danger); shift ;;
    --warning) variant+=(--warning); shift ;;
    --) shift; break ;;
    -*) shift ;;
    *)
      if [[ -z "$question" ]]; then question="$1"; else choices+=("$1"); fi
      shift
      ;;
  esac
done
[[ -n "$question" ]] || question="${1:-}"

# --title is the shared title/content split — passed through to zj::* (the
# machinery lives in the stdlib, not here). Omitted → header defaults to content.
titleopt=()
[[ -n "$title" ]] && titleopt=(--title "$title")

case "$type" in
  free) zj::text "${titleopt[@]}" "$question" ;;
  line) zj::line "${titleopt[@]}" "$question" ;;
  confirm) zj::confirm "${titleopt[@]}" "${variant[@]}" "$question" ;;
  choose)
    otheropt=()
    [[ -n "$other" ]] && otheropt=(--other "$other")
    multiopt=()
    ((multi)) && multiopt=(--multi)
    zj::choose "${titleopt[@]}" "${multiopt[@]}" "${otheropt[@]}" "$question" "${choices[@]}"
    ;;
  form)
    # Build the US/RS spec from --field name:type:label[:param] tokens.
    # name, type, label must not contain ':' but param may (e.g. "https://..." or "50:50").
    US=$'\x1f' RS=$'\x1e'
    spec=""
    local fname ftype flabel fparam rest rec
    for fld in "${fields[@]}"; do
      fname="${fld%%:*}"; rest="${fld#*:}"
      ftype="${rest%%:*}"; rest="${rest#*:}"
      flabel="${rest%%:*}"
      if [[ "$rest" == *:* ]]; then fparam="${rest#*:}"; else fparam=""; fi
      local _gs=$'\x1d'
      fparam="${fparam//\\x1d/$_gs}"
      fparam="${fparam//\\035/$_gs}"
      rec="${fname}${US}${ftype:-line}${US}${flabel}${US}${fparam}"
      [[ -z "$spec" ]] && spec="$rec" || spec="${spec}${RS}${rec}"
    done
    specfile="$(mktemp "${TMPDIR:-/tmp}/aiask-form.XXXXXX")"
    print -rn -- "$spec" > "$specfile"
    # For form, the positional is the form TITLE (header), not a prompt. Pass it
    # explicitly as --title so the form binary always gets its header, regardless
    # of whether the caller also passed their own --title override.
    local _form_title="${title:-$question}"
    zj::form --title "$_form_title" --spec "$specfile"
    rc=$?
    rm -f -- "$specfile"
    exit $rc
    ;;
  *)
    print -ru2 -- "ai-assist-ask: unknown --type '$type'"
    exit 2
    ;;
esac
exit $?
