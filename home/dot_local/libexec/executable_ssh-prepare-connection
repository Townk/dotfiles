#!/usr/bin/env zsh
# ssh-prepare-connection <config-file> — pre-connect prep, driven entirely by a
# header block in the loose ~/.ssh/config.d/<alias>.conf it is given. Every
# host's hook line is therefore identical; all per-host variance lives in the
# file's own header:
#   Match originalhost <names> exec "… ssh-prepare-connection <this-file> …"
# (ssh has no token for a config file's own path — see man ssh_config TOKENS —
# so the path is passed literally; each loose file names itself.)
#
# Header block — a `# ---` fenced comment near the top of the file:
#   # ---
#   # alias: <name …>             space-separated list of every configured
#   #                             entry point for this Host (system-onboard
#   #                             renders one full entry point per token: a
#   #                             Host name + a hooked Match). The FIRST token
#   #                             is the ssh target used to connect AND the
#   #                             theme color-map key; the rest are additional
#   #                             names this same fragment also answers to.
#   # prepare: all | <step …>     which prep steps to run (default: all)
#   # ---
#
# Steps (prepare):
#   gpg        — pre-create the remote gpg socketdir BEFORE the forward-bearing
#                master binds the gpg RemoteForward (always runs FIRST). See
#                step_gpg; the careful stale-socket logic lives in the remote
#                gpg-forward-prepare it invokes.
#   symbols-db — mirror THIS machine's glyph/gitmoji picker DB so remote pickers
#                render with this machine's font support.
#   theme      — resolve THIS machine's WezTerm tint for the target and push it
#                as a loose ~/.config/theme/override.toml.
#
# Resolve (self-healing): any line carrying a trailing `# @@resolve@@: <template>`
# marker is regenerated on each connect. The template (text after the marker) is
# canonical; the line's left side is its rendered cache. Each @@<key>@@ in the
# template is looked up live (see resolve_value) and substituted, then the line
# is rebuilt as  <indent><rendered>  # @@resolve@@: <template>  so it stays
# self-healing. This lets an endpoint that is remote-derived and cannot be
# expressed with an ssh token (e.g. a gpg socket path carrying the remote uid +
# gpgconf's homedir hash) never go stale — the lines self-declare, so no header
# list is needed. Eventually-consistent and best-effort: a rewrite lands for the
# NEXT connection, and a line whose keys can't all be resolved is left untouched.
# Because the fix is one connection late, a changed line also arms a marker on
# the remote (see arm_drift_marker) so the current session gets a blocking
# "reconnect" notice at login (see ~/.config/zsh/.zshrc).
#
# Idempotent and safe on every connection: rsync steps send only deltas; the
# gpg step only touches the remote's own socketdir; a resolve writes only when
# a value changed.
emulate -L zsh
setopt extended_glob
set -uo pipefail

config="${1:?usage: ssh-prepare-connection <config-file>}"
[[ -r "$config" ]] || { print -u2 -- "ssh-prepare-connection: cannot read '$config'"; exit 1; }

typeset -a all_steps=(gpg symbols-db theme mount)

trim() { local s="$1"; s="${s##[[:space:]]#}"; s="${s%%[[:space:]]#}"; print -r -- "$s"; }

# --- header parse ------------------------------------------------------------
typeset target="" prepare="" peer_hostname=""
parse_header() {
  local -a block
  block=("${(@f)$(awk '
    /^#[[:space:]]*---[[:space:]]*$/ { n++; next }
    n == 1 { print }
    n >= 2 { exit }
  ' "$config")}")
  local line
  for line in "${block[@]}"; do
    line="${line#\#}"; line="${line# }"           # drop the comment marker + one space
    case "$line" in
      # `alias:` is a space-separated list (system-onboard renders one full
      # entry point per token); the connection TARGET is the FIRST token
      # only — trim preserves surrounding whitespace semantics, `%% *` then
      # drops everything from the first internal space on.
      alias:*)   target="$(trim "${line#alias:}")"; target="${target%% *}" ;;
      prepare:*) prepare="$(trim "${line#prepare:}")" ;;
      peer-hostname:*) peer_hostname="$(trim "${line#peer-hostname:}")" ;;
    esac
  done
}

# --- prepare steps -----------------------------------------------------------
step_gpg() {
  # Bring up THIS machine's gpg-agent FIRST — it is the forward's local target
  # (the RemoteForward's far end is our ~/.config/gnupg/S.gpg-agent.extra). On
  # macOS there is no systemd to keep the agent alive, so it dies on reboot/
  # logout while its stale socket inode survives on the persistent FS. ssh then
  # connect()s that dead socket and the remote gpg sees "can't connect to the
  # agent: End of file". --launch starts a dead agent (re-binding a stale extra
  # socket) and is a no-op when it is already healthy, so every connect finds a
  # live target. Symmetric to the remote gpg-forward-prepare below.
  GNUPGHOME="${GNUPGHOME:-$HOME/.config/gnupg}" gpgconf --launch gpg-agent >/dev/null 2>&1 || true

  # Throwaway, forwarding-suppressed ssh: neither joins the shared mux nor binds
  # forwards; the remote path is single-quoted so the REMOTE shell expands ~.
  # The caller's _SYNCREMOTE sentinel stops this nested ssh from re-triggering
  # the hook. Runs before the rsync steps open the forward-bearing master.
  ssh -o ControlPath=none -o ClearAllForwardings=yes -o ConnectTimeout=5 \
    "$target" '~/.local/libexec/gpg-forward-prepare' </dev/null >/dev/null 2>&1
}

step_symbols_db() {
  rsync -z --timeout=8 -e 'ssh -o ConnectTimeout=5' \
    ~/.local/share/fonts/nerd-font/symbols.db \
    "$target:.local/share/fonts/nerd-font/" </dev/null >/dev/null 2>&1
}

step_theme() {
  local loc_lib="${XDG_CONFIG_HOME:-$HOME/.config}/mux/scripts/lib/terminal-location.zsh"
  [[ -r "$loc_lib" ]] || return 0
  source "$loc_lib"

  # Tint NAME for the target (the same resolution WezTerm uses); default grey.
  local name hex tmp
  name="$(tl_colorname_for_target "$target" 2>/dev/null)" || name="${TL_REMOTE_DEFAULT_COLOR:-grey}"
  [[ -n "$name" ]] || name="${TL_REMOTE_DEFAULT_COLOR:-grey}"

  # NAME -> hex via the shared lookup (lives in terminal-location.zsh).
  hex="$(tl_hex_for_colorname "$name")" || return 0   # unknown tint -> leave the remote as-is

  tmp="$(mktemp -t theme-override.XXXXXX)" || return 0
  {
    print -r -- "# Pushed by ssh-prepare-connection (theme step): per-session window tint ($name). Loose; not chezmoi-managed."
    print -r -- "base = \"$hex\""
  } >"$tmp"

  rsync -z --timeout=8 -e 'ssh -o ConnectTimeout=5' \
    "$tmp" "$target:.config/theme/override.toml" </dev/null >/dev/null 2>&1
  rm -f "$tmp"
}

step_mount() {
  # Clipboard peer mount (clipboard-mount spec §3.2): mount <peer-hostname>'s
  # / read-only via rclone SFTP so a file copied on it lands here as a
  # pasteable mount-relative file-url (Finder-native paste). Gated on the
  # fragment knowing the peer's LocalHostName (the store identity M rows
  # carry -- no peer-hostname, no mount key) AND on the clipboard bridge
  # being enabled for this host (the rendered RemoteForward line is the
  # signal -- both the mount below AND the identity push below it are
  # clipboard features). peer_hostname is re-validated here (defense in
  # depth: front matter is hand-editable, and this value becomes both a
  # mountpoint directory component and an ssh target) -- same shape rule as
  # system-onboard's valid_peer_hostname.
  [[ "$peer_hostname" == [A-Za-z0-9][A-Za-z0-9.-]# ]] || return 0
  grep -qE '^[[:space:]]*RemoteForward[[:space:]]+127\.0\.0\.1:2490[[:space:]]' "$config" || return 0

  # Stable self-name identity push (R-batch Task B amendment): the DRIVEN
  # machine may not know its own stable clipboard identity -- an ephemeral
  # cloud dev-shell's `hostname -s` changes daily (e.g.
  # cs-1j9nfzmx-medium-homedir-37836), so an M row carrying it would never
  # match THIS fragment's own peer-hostname (the mount key the laptop side
  # keys its mount on) or the `Host <name>` line its rsync pulls need.
  # peer_hostname IS that stable identity, and the sit-at machine -- right
  # here, right now -- is the one that knows it, so push it into the
  # target's clipboard state dir for pbcopy/pbpaste's self_host() to prefer.
  # Fail-soft, backgrounded/disowned exactly like step_gpg/step_theme's
  # throwaway ssh (must never make the connection wait); deliberately
  # UNCONDITIONAL on the Darwin/macfuse gate below -- identity matters even
  # when the mount itself can never work here (e.g. this SIT-AT machine
  # itself lacks rclone/MacFUSE), so it is pushed before that gate is even
  # checked. On a Mac target this simply (re)writes the LocalHostName
  # pbcopy/pbpaste already resolve on their own via scutil -- harmless, not
  # a behavior change there.
  print -rn -- "$peer_hostname" | ssh -o ControlPath=none -o ClearAllForwardings=yes \
    -o BatchMode=yes -o ConnectTimeout=5 "$target" \
    'd="${XDG_STATE_HOME:-$HOME/.local/state}/clipboard"; mkdir -p "$d" && cat > "$d/self-name"' \
    >/dev/null 2>&1 &!

  # Credential push (RECOB spec §9.2): the remote answers this machine's
  # reverse-tunneled bridge with a challenge response, so it needs THIS
  # machine's token -- which never crosses the wire itself, only digests of
  # it do. Keyed by owner (`tunnel-tokens/<our LocalHostName>`) rather than
  # one flat file, because two machines pushing to one shared remote would
  # otherwise silently invalidate each other, and because a stolen token is
  # then useless against any other machine.
  #
  # The mode is NOT copied from the self-name push above: that pattern lands
  # a file at whatever umask the remote login shell has, which is adequate
  # for a hostname and completely inadequate for a secret. `umask` BEFORE
  # the write and an explicit `chmod` after, so there is no instant in which
  # the token exists group- or world-readable.
  #
  # No token, no push: the file only exists once recobd has run here, so
  # this is a silent no-op until the daemon is installed (Phase 8). Same
  # fail-soft, backgrounded shape as every other step -- §9.2 accepts that a
  # brand-new remote can race its first push, and is explicit that making
  # this synchronous is not an option: the connection must never wait.
  local recob_token="${XDG_STATE_HOME:-$HOME/.local/state}/clipboard/accepted-token"
  if [[ -r "$recob_token" ]]; then
    local recob_owner
    recob_owner="$(scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null)"
    # The owner name becomes a filename on the remote: same shape rule as
    # every other identity in this file, checked before it is interpolated.
    if [[ "$recob_owner" == [A-Za-z0-9][A-Za-z0-9.-]# ]]; then
      ssh -o ControlPath=none -o ClearAllForwardings=yes \
        -o BatchMode=yes -o ConnectTimeout=5 "$target" \
        "umask 077; d=\"\${XDG_STATE_HOME:-\$HOME/.local/state}/clipboard/tunnel-tokens\";
         mkdir -p \"\$d\" && chmod 700 \"\$d\" &&
         cat > \"\$d/${recob_owner}\" && chmod 600 \"\$d/${recob_owner}\"" \
        < "$recob_token" >/dev/null 2>&1 &!
    fi
  fi

  # The mount itself (rclone/MacFUSE + Finder) is Darwin-only -- unlike the
  # identity push above, THIS part really is conditional on that (Finder is
  # the point; MacFUSE/rclone are the Mac side). Backgrounded + disowned:
  # the connection must never wait ~5s of rclone daemon-wait; a copy a few
  # seconds after connecting finds the mount healthy, and the dispatcher's
  # own self-heal covers the race.
  [[ "$OSTYPE" == darwin* ]] || return 0
  local cm="${CLIPBOARD_MOUNT_BIN:-$HOME/.local/libexec/clipboard-mount}"
  [[ -x "$cm" ]] || return 0
  "$cm" ensure "$peer_hostname" "$target" </dev/null >/dev/null 2>&1 &!
  return 0
}

# --- resolvers (predefined registry) -----------------------------------------
# resolve_value <key> — print the live value for a known key (non-zero when
# unknown or unresolvable). Each resolver validates its own output so a bad read
# can't render a broken line. Remote reads use the same throwaway, forwarding-
# suppressed ssh as step_gpg; _SYNCREMOTE stops the nested ssh from recursing.
resolve_value() {
  local key="$1" val
  case "$key" in
    gpg-agent-socket)
      val="$(ssh -o ControlPath=none -o ClearAllForwardings=yes -o ConnectTimeout=5 \
              "$target" 'gpgconf --list-dirs agent-socket' </dev/null 2>/dev/null)"
      val="${val//[[:space:]]/}"
      [[ "$val" == /* ]] || return 1              # must be an absolute socket path
      print -r -- "$val"
      ;;
    *)
      print -u2 -- "ssh-prepare-connection: unknown resolve key '$key'"
      return 2
      ;;
  esac
}

# heal_resolve_lines <config> — regenerate every line carrying a trailing
# `# @@resolve@@: <template>` marker. The template (text after the marker) is
# canonical; the left side is its rendered cache. Each @@<key>@@ in the template
# is resolved via the registry and substituted; the line is rebuilt as
#   <indent><rendered>  # @@resolve@@: <template>
# so it stays self-healing. Atomic: a hidden temp in the same dir (leading dot
# keeps it out of `Include config.d/*`) renamed over the file — no lock needed,
# since rename is atomic and concurrent writers resolve to the same value.
# Best-effort: a line whose keys can't all be resolved is left untouched.
# When a line actually changes, arm_drift_marker drops a marker on the remote so
# the current (still-superseded) session gets a "reconnect" notice at login.
heal_resolve_lines() {
  local config="$1" marker='@@resolve@@:'
  grep -qF -- "$marker" "$config" 2>/dev/null || return 0   # nothing to heal

  local -a lines
  lines=("${(@f)$(<"$config")}")
  local -i i changed=0
  local line indent tmpl rendered rest key val newline
  local -a keys new_values line_vals
  for (( i = 1; i <= ${#lines}; i++ )); do
    line="${lines[i]}"
    [[ "$line" == *"$marker"* ]] || continue
    [[ "$line" == [[:space:]]#\#* ]] && continue            # a comment merely MENTIONING the marker (e.g. this file's own docs), not a real resolve line
    tmpl="${line#*$marker}"; tmpl="${tmpl##[[:space:]]#}"    # template = text after the marker
    indent="${line%%[^[:space:]]*}"                          # preserve leading whitespace

    keys=(); rest="$tmpl"                                    # collect the unique @@key@@ tokens
    while [[ "$rest" =~ '@@([a-z0-9-]+)@@' ]]; do
      keys+=("$match[1]"); rest="${rest/@@$match[1]@@/}"
    done
    keys=("${(@u)keys}")

    rendered="$tmpl"; line_vals=(); local ok=1
    for key in "${keys[@]}"; do
      val="$(resolve_value "$key")" || { ok=0; break; }
      rendered="${rendered//@@$key@@/$val}"; line_vals+=("$val")
    done
    (( ok )) || continue

    newline="${indent}${rendered}  # @@resolve@@: ${tmpl}"
    [[ "$newline" == "$line" ]] || { lines[i]="$newline"; changed=1; new_values+=("${line_vals[@]}"); }
  done
  (( changed )) || return 0

  local tmp
  tmp="$(mktemp "${config:h}/.${config:t}.XXXXXX")" || return 0
  chmod 0600 "$tmp"
  if print -rl -- "${lines[@]}" > "$tmp" && mv -f "$tmp" "$config"; then
    arm_drift_marker "${new_values[@]}"
  else
    rm -f "$tmp"
  fi
}

# arm_drift_marker <new-value …> — a resolve line just changed, so THIS session
# is still on the superseded value (the heal only fixes the client config for the
# NEXT connection). Drop a marker on the remote whose mere EXISTENCE tells the
# login shell to warn "reconnect" (see ~/.config/zsh/.zshrc); it stores the new
# value(s) purely for debugging. No remote socket inspection — the client's heal
# is the drift oracle, so systemd socket-activation etc. are irrelevant. The
# corrected reconnect re-runs heal with nothing to change, so it never re-arms.
# Best-effort; _SYNCREMOTE (set by the hook) stops the nested ssh from recursing.
arm_drift_marker() {
  print -rl -- "$@" | ssh -o ControlPath=none -o ClearAllForwardings=yes -o ConnectTimeout=5 \
    "$target" 'd="${XDG_STATE_HOME:-$HOME/.local/state}/ssh"; mkdir -p "$d" && cat > "$d/new-socket"' 2>/dev/null || true
}

# --- run ---------------------------------------------------------------------
parse_header
[[ -n "$target" ]] || { print -u2 -- "ssh-prepare-connection: no 'alias:' in $config header"; exit 1; }

typeset -a steps
if [[ -z "$prepare" || "$prepare" == all ]]; then
  steps=("${all_steps[@]}")
else
  steps=(${=prepare})
fi

# gpg prep MUST precede any rsync step that opens the forward-bearing master, so
# hoist it to the front (and dedupe it) no matter where it appears.
if (( ${steps[(I)gpg]} )); then
  typeset -a rest=("${(@)steps:#gpg}")
  steps=(gpg "${rest[@]}")
fi

for step in "${steps[@]}"; do
  case "$step" in
    gpg)        step_gpg ;;
    symbols-db) step_symbols_db ;;
    theme)      step_theme ;;
    mount)      step_mount ;;
    *)
      print -u2 -- "ssh-prepare-connection: unknown step '$step' (known: ${(j:, :)all_steps})"
      exit 1
      ;;
  esac
done

heal_resolve_lines "$config"
