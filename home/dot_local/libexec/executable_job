#!/usr/bin/env zsh
# job — CLI front-end over lib/job.zsh for non-zsh callers (Hammerspoon,
# job-callback, POSIX scripts). zsh callers source the lib instead. NOT in
# ~/.local/bin on purpose: this is plumbing called by tools, not by the user.
set -eu
source "${0:A:h}/../lib/job.zsh"

# A follower starts its hangup decision as `$JOB_CLI hup-decide`: it must
# be the CLI the follower itself runs from.
export JOB_CLI="${JOB_CLI:-${0:A}}"

verb="${1:-}"
case "$verb" in
  start | progress | cancel | list | hud | watch | log | follow)
    shift
    "job::$verb" "$@"
    ;;
  owns-block)
    shift
    job::_rex_block_job "$@"
    ;;
  hup-decide)
    shift
    job::_follow_hup_decide "$@" || :
    exit 0
    ;;
  *)
    print -ru2 -- "usage: job <start|progress|cancel|list|hud|watch|log|follow|owns-block|hup-decide> ..."
    exit 1
    ;;
esac
