#!/usr/bin/env zsh
# sync-remote-assets <ssh-target> [step ...] — single entry point for every
# pre-connect host->remote sync this config needs. Meant to be driven by an
# ssh `Match host ... exec` hook (see ~/.ssh/config.example), but also
# runnable by hand: `sync-remote-assets <target> [step ...]`.
#
# With no [step ...] args, every registered step below runs (the ssh-hook use
# case). Passing one or more step names runs only those — handy to exercise a
# single step by hand without waiting on the others.
#
# Steps:
#   symbols-db — mirror the glyph/gitmoji picker DB
#                (~/.local/share/fonts/nerd-font/symbols.db) so remote pickers
#                render with THIS machine's font support.
#   theme      — resolve THIS machine's WezTerm background tint for <target>
#                (the onboarded machine's `color`, else its profile default,
#                else grey — see zellij/scripts/lib/terminal-location.zsh) and
#                push it as a loose ~/.config/theme/override.toml; the
#                remote's theme-apply folds it into the effective palette and
#                the Zellij `system` theme at shell startup.
#
# Idempotent and safe on every connection: each step's rsync sends only
# deltas, a near-instant no-op when nothing changed.
emulate -L zsh
set -uo pipefail

target="${1:?usage: sync-remote-assets <ssh-target> [step ...]}"
shift

typeset -a all_steps=(symbols-db theme)
typeset -a steps=("$@")
(( ${#steps} )) || steps=("${all_steps[@]}")

step_symbols_db() {
  rsync -z --timeout=8 -e 'ssh -o ConnectTimeout=5' \
    ~/.local/share/fonts/nerd-font/symbols.db \
    "$target:.local/share/fonts/nerd-font/" </dev/null >/dev/null 2>&1
}

step_theme() {
  local loc_lib="${XDG_CONFIG_HOME:-$HOME/.config}/zellij/scripts/lib/terminal-location.zsh"
  [[ -r "$loc_lib" ]] || return 0
  source "$loc_lib"

  # Tint NAME for the target (the same resolution WezTerm uses); default grey.
  local name hex tmp
  name="$(tl_colorname_for_target "$target" 2>/dev/null)" || name="${TL_REMOTE_DEFAULT_COLOR:-grey}"
  [[ -n "$name" ]] || name="${TL_REMOTE_DEFAULT_COLOR:-grey}"

  # NAME -> hex via the shared lookup (lives in terminal-location.zsh).
  hex="$(tl_hex_for_colorname "$name")" || return 0   # unknown tint -> leave the remote as-is

  tmp="$(mktemp -t theme-override.XXXXXX)" || return 0
  {
    print -r -- "# Pushed by sync-remote-assets (theme step): per-session window tint ($name). Loose; not chezmoi-managed."
    print -r -- "base = \"$hex\""
  } >"$tmp"

  rsync -z --timeout=8 -e 'ssh -o ConnectTimeout=5' \
    "$tmp" "$target:.config/theme/override.toml" </dev/null >/dev/null 2>&1
  rm -f "$tmp"
}

for step in "${steps[@]}"; do
  case "$step" in
    symbols-db) step_symbols_db ;;
    theme)      step_theme ;;
    *)
      print -u2 -- "sync-remote-assets: unknown step '$step' (known: ${(j:, :)all_steps})"
      exit 1
      ;;
  esac
done
