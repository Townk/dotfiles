#!/usr/bin/env zsh
# rip-provider-folder — books the operator already has, on a local disk.
#
# A folder is a SOURCE, exactly like a store is. This implements the same
# capabilities/list/acquire contract as rip-provider-libation, so the panel,
# the session worker, the push, the checksum verify and the staging cleanup
# all work on local books without knowing anything changed.
#
# m4b only, deliberately: the operator stores audiobooks in no other format.

set -eu -o pipefail

VERSION="1"
die() { print -ru2 -- "rip-provider-folder: $*"; exit 2 }

cmd_capabilities() {
  jq -nc --arg v "$VERSION" \
    '{name: "folder", version: $v, can_acquire: true, needs_gui: false}'
}

# _derive <bookdir> <root> — print \x1f-separated: author, title, source.
#
# Order: embedded tags, then directory structure, then the filename. Whichever
# wins is REPORTED as `derived_from`, because the operator has to be able to
# see what was guessed before ripping 40 books on trust.
# _dir_is_collection <dir> — true when the directory holds more than one .m4b.
#
# This is the whole distinction the provider turns on. A directory with ONE
# book is that book's own folder: its name is the title, and the cover and PDF
# sitting beside it are its own. A directory with SEVEN is a shelf — its name
# is the shelf's, and nothing in it belongs to any single book by position
# alone. Collapsing the two is what made a 7-book Harry Potter folder list as
# one 114-hour book carrying Book 1's tags.
_dir_is_collection() {
  local -a m=("$1"/*.m4b(N-.))
  (( ${#m} > 1 ))
}

# _sibling_of <m4b> <ext-pattern> — the companion belonging to THIS book, or
# empty. Stem match first (Book3.Foo.pdf beside Book3.Foo.m4b). A bare
# directory-level file counts only when the directory holds exactly one book:
# on a shelf a lone cover.jpg belongs to no one book, and attaching it to all
# of them would be a guess wearing the costume of a fact.
_sibling_of() {
  local f="$1" pat="$2" d="${f:h}" stem="${f:t:r}" hit
  hit="$(print -rl -- "$d/$stem."${~pat}(N-.) | head -1)"
  if [[ -n "$hit" ]]; then
    print -r -- "$hit"
    return 0
  fi
  _dir_is_collection "$d" && return 0
  print -rl -- "$d"/*.${~pat}(N-.) | head -1
}

# _embedded_cover <m4b> — the book's own cover art, extracted from the file
# and cached, or empty. Used only when no sidecar image exists.
#
# We already trust this file's embedded tags for author, title and duration;
# refusing to trust them for the cover was an inconsistency, not a policy. A
# ripped-from-Audible collection routinely carries art inside the m4b and no
# .jpg beside it, so "no sidecar" is the common case, not the exotic one.
#
# Cached because extraction costs an ffmpeg exec per file and browse lists a
# whole tree at once: the key is path + mtime + size, so a re-tagged or
# replaced file misses the cache and is re-extracted, while an unchanged tree
# browses at full speed the second time.
#
# RIP_COVER_CACHE exists so tests can point this somewhere disposable. Like
# every other RIP_* seam it falls back to the PRODUCTION path, so a test that
# forgets to export it writes to the real cache rather than failing loudly.
_embedded_cover() {
  setopt localoptions noerrexit nopipefail
  local f="$1" codec ext key out
  command -v ffmpeg >/dev/null 2>&1 || return 0
  command -v ffprobe >/dev/null 2>&1 || return 0

  # Only an ATTACHED PICTURE is cover art. A stray video stream in an audio
  # container is not, and copying one out would hand the panel a frame of
  # video to render as a book cover.
  codec="$(ffprobe -v error -select_streams v -show_entries stream=codec_name:stream_disposition=attached_pic \
             -of csv=p=0 -- "$f" 2>/dev/null | awk -F, '$2 == 1 { print $1; exit }')"
  [[ -n "$codec" ]] || return 0
  # Always JPEG, whatever the source codec is, because we re-encode anyway
  # (see the scale below) — which also means no codec-to-extension mapping to
  # get wrong. A PNG cover loses an alpha channel it almost never has, at a
  # size where it could not be seen.
  ext=jpg

  local cache="${RIP_COVER_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/rip/folder-covers}"
  key="$(print -r -- "$f"$'\x1f'"$(_file_stamp "$f")" | shasum -a 256 2>/dev/null | cut -d' ' -f1)"
  [[ -n "$key" ]] || return 0
  out="$cache/$key.$ext"
  [[ -f "$out" ]] && { print -r -- "$out"; return 0; }

  mkdir -p -- "$cache" 2>/dev/null || return 0
  # Extract to a temp and rename: a browse interrupted mid-extraction must
  # not leave a truncated image in the cache that every later browse then
  # serves from, forever, without ever re-extracting it.
  # The temp MUST keep the real extension: ffmpeg picks its muxer from the
  # output filename, so a ".part" suffix makes it fail to find any output
  # format at all — and this function reports a failed extraction exactly the
  # same way it reports a book with no art, so that failure was invisible.
  # Dot-prefixed instead, and in the cache dir, so the mv stays atomic.
  local tmp="$cache/.$key.$$.$ext"
  # DOWNSCALED, and that is not an optimisation — it is what makes this safe
  # to turn on for every book. The panel renders a cover in a 48px box
  # (rip-library.css .row .cover), embedded art in a retail m4b is routinely
  # 1000x1000 and ~350KB, and library-dialog.lua inlines every file:// cover
  # into the page as a base64 data URI. Extracting at full size would put
  # ~100MB of base64 in the document for a 300-book tree. 128px wide leaves
  # headroom for a 2x display and lands each cover around 6KB.
  if ffmpeg -v error -y -i "$f" -an -vframes 1 -vf 'scale=128:-1' -c:v mjpeg -q:v 4 -- "$tmp" </dev/null >/dev/null 2>&1 \
     && [[ -s "$tmp" ]] && mv -f -- "$tmp" "$out"; then
    print -r -- "$out"
    return 0
  fi
  rm -f -- "$tmp"
  return 0
}

# _file_stamp <file> — mtime and size, the cheap identity of a file's contents
# for cache purposes. Separate from rip::_file_bytes in the library: this
# binary is standalone and does not source it.
_file_stamp() {
  stat -f '%m %z' -- "$1" 2>/dev/null || stat -c '%Y %s' -- "$1" 2>/dev/null
}

# _book_files <m4b> — everything that must travel with this book, published
# into the global array _RIP_BOOK_FILES.
#
# A global, not a "$(...)" capture, on purpose: command substitution forks,
# and an array assigned inside the fork dies with it. This repo has been bitten
# by that three times.
_book_files() {
  local f="$1" d="${1:h}" stem="${1:t:r}" c
  _RIP_BOOK_FILES=("$f")
  for c in "$d/$stem."*(N-.); do
    [[ "$c" == "$f" ]] || _RIP_BOOK_FILES+=("$c")
  done
  _dir_is_collection "$d" && return 0
  for c in "$d"/*(N-.); do
    [[ "$c" == *.m4b ]] && continue
    (( ${_RIP_BOOK_FILES[(Ie)$c]} )) || _RIP_BOOK_FILES+=("$c")
  done
}

_derive() {
  setopt localoptions noerrexit nopipefail
  local f="$1" root="$2" d="${1:h}" author title

  if [[ -f "$f" ]] && command -v ffprobe >/dev/null 2>&1; then
    local tags
    tags="$(ffprobe -v error -show_entries format_tags=album_artist,artist,album,title \
              -of default=noprint_wrappers=1:nokey=0 -- "$f" 2>/dev/null)"
    author="$(print -r -- "$tags" | sed -n 's/^TAG:album_artist=//p' | head -1)"
    [[ -n "$author" ]] || author="$(print -r -- "$tags" | sed -n 's/^TAG:artist=//p' | head -1)"
    title="$(print -r -- "$tags" | sed -n 's/^TAG:album=//p' | head -1)"
    if [[ -n "$author" && -n "$title" ]]; then
      print -r -- "$author"$'\x1f'"$title"$'\x1f'"tags"
      return 0
    fi
  fi

  # Directory structure: <Author>/<Title>/ relative to the root. This is free
  # and already correct for a collection organised the way cantina stores books.
  # Guarded against d == root: without it the empty-strip leaves the WHOLE
  # absolute path in $rel, which trivially contains a "/" and gets routed
  # here even though the book sits directly in the root — the author would
  # then become the root's own PARENT directory name.
  # ...and only when the book's own directory is NOT a shelf. In
  # <Author>/<Title>/one.m4b the directory names the book; in
  # <Anything>/{a,b,c}.m4b it names the shelf, and borrowing it would hand
  # every book on that shelf the same author and title.
  local rel="${d#$root/}"
  if [[ "$d" != "$root" && "$rel" == */* ]] && ! _dir_is_collection "$d"; then
    print -r -- "${rel:h:t}"$'\x1f'"${rel:t}"$'\x1f'"path"
    return 0
  fi

  # Last resort. Marked plainly so the panel can flag it as a guess.
  #
  # Field separator is \x1f (unit separator), NOT a tab: `IFS=$'\t' read`
  # in cmd_list collapses a LEADING tab as ordinary IFS whitespace (POSIX
  # field-splitting), silently swallowing the empty author field on this
  # branch and shifting title/src left by one — title would read back as
  # the literal string "filename" instead of the actual book name, and src
  # (this branch label) would read back empty. \x1f is not whitespace, so
  # it is never collapsed; this repo already uses it elsewhere as a field
  # separator for exactly this reason.
  # Last resort, and WHICH name depends on the same shelf test. A directory
  # holding exactly one book IS that book's folder, so its name is the title
  # (SingleBook/x.m4b is "SingleBook", not "x"). On a shelf the directory
  # names the shelf, and a file loose in the root has no directory of its own
  # to borrow — both fall back to the file's own stem.
  local base
  if [[ "$d" != "$root" ]] && ! _dir_is_collection "$d"; then
    base="${d:t}"
  else
    base="${f:t:r}"
  fi
  print -r -- ""$'\x1f'"$base"$'\x1f'"filename"
}

cmd_list() {
  setopt localoptions noerrexit nopipefail
  local root="${1:?list: root required}"
  [[ -d "$root" ]] || die "no such directory: $root"
  root="${root:A}"

  # fd, no depth limit (the operator asked for none). -0 so a newline in a
  # path cannot split a record. Directories are deduped by the assoc array.
  #
  # --follow IS LOAD-BEARING (review finding, 2026-08-25). Without it fd's
  # `--type f` examines the dirent itself, so a SYMLINKED .m4b is not a file
  # and a symlinked directory is not descended into — either shape is
  # silently invisible to browse, while cmd_acquire below was DELIBERATELY
  # fixed to follow exactly those links (see its `(N-.)` note: "the
  # operator's real store is exactly the kind of thing a symlink-based
  # collection points at"). The two must agree, or acquire's symlink support
  # is unreachable because nothing can ever be selected. Matches this repo's
  # own fd idiom in dot_config/zsh/completion.sh.
  # One .m4b is one book. m4b is a single-file whole-book format, so a
  # directory holding several is a shelf, not a book in parts — see
  # _dir_is_collection. Keying this scan by DIRECTORY silently dropped six of
  # seven books in a real collection folder and summed their durations into
  # the survivor.
  local -a books=()
  local f
  while IFS= read -r -d '' f; do
    books+=("$f")
  done < <(fd --follow --absolute-path --type f --extension m4b --print0 . "$root" 2>/dev/null)

  # `one`/`n` are declared HERE, once, not re-declared inside the loop body
  # below: a `local` statement that re-declares an already-local name on a
  # later pass through this same function scope makes zsh print "name=value"
  # to STDOUT for that variable (reproduced in isolation; not documented
  # behavior we could find, but 100% repeatable) — corrupting the JSON
  # stream with bare `one=...` / `n=...` lines between rows.
  local author title src cover dur has_pdf n
  for f in "${(@o)books}"; do
    IFS=$'\x1f' read -r author title src <<< "$(_derive "$f" "$root")"
    # A sidecar image wins: it is what the operator put there deliberately.
    # Embedded art is the fallback, not the other way round.
    cover="$(_sibling_of "$f" '(jpg|jpeg|png)')"
    [[ -n "$cover" ]] || cover="$(_embedded_cover "$f")"
    dur=0
    if command -v ffprobe >/dev/null 2>&1; then
      n="$(ffprobe -v error -show_entries format=duration -of csv=p=0 -- "$f" 2>/dev/null)"
      [[ "$n" == <->* ]] && dur=${n%%.*}
    fi
    # A sibling PDF is a real, local, checkable signal — unlike everything
    # else Audible-shaped in this row, this one costs nothing to establish
    # honestly, so it is not left null/false by default.
    has_pdf=false
    [[ -n "$(_sibling_of "$f" 'pdf')" ]] && has_pdf=true
    jq -nc \
      --arg id "$f" --arg title "$title" --arg author "$author" \
      --arg src "$src" --arg cover "$cover" --argjson dur "$dur" \
      --argjson has_pdf "$has_pdf" --arg v "$VERSION" '
      {id: $id,
       title: $title,
       subtitle: null,
       authors: (if $author == "" then [] else [$author] end),
       narrators: [],
       duration_s: $dur,
       series: null,
       series_position: null,
       language: null,
       abridged: false,
       published: null,
       has_pdf: $has_pdf,
       cover: (if $cover == "" then null else "file://" + $cover end),
       acquired: true,
       acquired_utc: null,
       plus: false,
       absent: false,
       ids: {},
       derived_from: $src,
       path: (if $author == "" then $title else $author + "/" + $title end),
       provider: "folder",
       provider_version: $v,
       format: "m4b"}'
  done
}

# cmd_acquire <bookdir> <destdir> [relpath] — COPY a local book into staging.
#
# COPY, never move. The push deletes the STAGED copy after a verified
# transfer, never the source, so the operator keeps their original collection
# and the extra disk is transient. A move would mean a failed verify leaves no
# original anywhere — and this is the one flow where the local copy IS the
# original. There is no --move here, deliberately.
#
# Built under a temporary name and renamed into place only on success: a
# half-copied directory sitting under the final name would be pushed as a
# truncated book, and the push cannot tell the difference (rip::ab_import
# was bitten by exactly this).
cmd_acquire() {
  setopt localoptions noerrexit nopipefail
  # $src is a FILE now, not a directory: one .m4b is one book (see
  # _dir_is_collection). -f, not -e, and it follows a symlink deliberately —
  # the operator's real store is exactly the kind of thing a symlink-based
  # collection points at.
  local src="$1" dest="$2"
  [[ -f "$src" ]] || die "no such file: $src"
  [[ "$src" == *.m4b ]] || die "not an m4b: $src"

  # The caller OWNS the destination path. Do not re-derive it here when it is
  # given: (a) a later panel lets the operator EDIT author/title inline
  # before ripping, and re-deriving would silently discard that edit; (b) a
  # root guessed as ${src:h:h} is wrong for a book sitting directly under the
  # chosen root — for /root/Book that yields "/", promoting the root's own
  # name into "author". `acquire <id> <destdir> [relpath]` is additive: a
  # provider that names its own output (libation) ignores a third argument,
  # exactly as `list [root]` is ignored by a provider that owns a catalogue.
  # rip::ab_worker always passes the plan item's own path here now, so this
  # fallback is unreachable in production.
  #
  # When relpath is absent anyway, do NOT guess a directory structure:
  # without the real scan root, /a/b/Book cannot be told apart from a loose
  # book AT /a/b — the information needed to tell an "Author" folder from
  # the root itself simply is not in $src's path (acquire is never handed
  # the root the way `list <root>` is). Guessing is the harmful direction —
  # it invents provenance and can land a book under a wrong shelf. Declining
  # to guess is visible (the book stages under its own directory name, no
  # author) and harmless. So: title is the book directory's own basename,
  # author is empty, full stop.
  local rel="${3:-${src:t:r}}"

  mkdir -p "$dest" || die "cannot create $dest"
  local staging="$dest/$rel"

  # ALREADY STAGED — CHECKED HERE, BEFORE THE COPY, AND NOT AN ERROR
  # (review finding, 2026-08-25). This test used to sit AFTER the copy loop,
  # with a comment claiming rip::ab_worker refuses an already-staged book
  # upstream. It does not: ab_worker's only pre-acquire check asks the
  # SERVER (rip::ab_have), which by construction says "absent" for a book
  # that is staged but not yet pushed. And a staged-but-unpushed book is not
  # an exotic state — it is the documented retry path: "a push or verify
  # failure keeps everything staged for a plain `rip-push audiobooks` retry
  # with no re-download". Re-running the session over that staging tree
  # re-copied every book in full, multi-gigabyte and all, and then threw the
  # copy away.
  #
  # rc 0, not `die`: the destination already holds this book, which is
  # exactly what this call was asked to bring about. Failing here reported an
  # acquire failure (and, via ab_worker, a whole-session rc 2) for a push
  # that went on to deliver everything. Idempotent, so say so and stop.
  if [[ -e "$staging" ]]; then
    print -r -- "rip-provider-folder: already staged, nothing to copy: $rel"
    return 0
  fi
  # Anchor OUTSIDE $dest, not under "${staging:h}": $dest is
  # rip::staging_for audiobooks, the exact tree rip::push_worker walks and
  # ships. A temp built one or two levels inside it — as this line used to
  # do — is a dot-directory, but `find` descends into dot-directories
  # regardless, and `cp -p` preserves the source mtime, so the push's age
  # gate offers no protection either: a copied file looks "settled" the
  # instant it exists. A killed acquire then leaves a partial book the next
  # push ships as real, sidecar and all; worse, push_worker already runs
  # concurrently with an acquire batch (its own comment says so), so even
  # an uninterrupted copy can have its still-open files verify-deleted out
  # from under it mid-write. rip::ab_import hit this exact prohibition
  # first (rip.zsh: "Do NOT anchor to ROOT/audiobooks — temp files there
  # would be enumerated and shipped") — ${dest:h} is the same fix: the
  # staging root itself, one level above "audiobooks", which neither the
  # watcher nor the push enumerates, and still the same filesystem as
  # $dest so the final `mv` stays an atomic rename.
  local tmp="${dest:h}/.rip-folder.$$"
  mkdir -p "${staging:h}" || die "cannot create ${staging:h}"
  rm -rf -- "$tmp"
  mkdir -p "$tmp" || die "cannot create the staging temp for $rel"

  print -r -- "progress -1 copying"
  # This book's own file plus the companions that belong to IT — not every
  # file in the directory, which on a shelf is six other people's books.
  local -a _RIP_BOOK_FILES=()
  _book_files "$src"
  local f copy_rc=0
  # (N-.): the precondition above (`*.m4b(N)`, no type qualifier) counts a
  # SYMLINKED .m4b as present — the operator's real store is exactly the
  # kind of thing a symlink-based collection points at. A plain `(N.)`
  # examines the dirent itself (a symlink's own type is "l", never "."),
  # so it silently skipped every such file: precondition says "audio
  # present", copy loop disagrees and copies nothing for it, and the run
  # still exits 0 with a book that has a cover but no sound. `-` toggles
  # the qualifier to examine the symlink's TARGET, so a symlink to a
  # regular file matches `.` the same way the file itself would.
  for f in "${_RIP_BOOK_FILES[@]}"; do
    if ! cp -p -- "$f" "$tmp/"; then
      copy_rc=1
      break
    fi
  done
  if (( copy_rc != 0 )); then
    rm -rf -- "$tmp"
    die "copy failed for ${f:t}"
  fi

  # Belt-and-suspenders on the same disagreement: even with the glob fixed
  # above, publish nothing unless every .m4b the precondition counted
  # actually landed as a real file in $tmp — a captured outcome, not
  # "the copy loop returned 0 so it must be fine".
  local -a landed=("$tmp"/*.m4b(N-.))
  if (( ${#landed} != 1 )); then
    rm -rf -- "$tmp"
    die "audio did not land in staging for $rel (expected 1, got ${#landed})"
  fi

  # Re-checked immediately before the rename, and HARD this time. The cheap
  # test above answers the ordinary case; this one closes the window between
  # them, which is a genuine race (rip::push_worker already runs concurrently
  # with an acquire batch — its own comment says so). It must stay: `mv` of a
  # directory onto an existing directory does not replace it, it moves the
  # source INSIDE it, so without this the temp would end up nested one level
  # down inside the book and pushed as part of it.
  if [[ -e "$staging" ]]; then
    rm -rf -- "$tmp"
    die "already staged: $rel"
  fi
  if ! mv -- "$tmp" "$staging"; then
    rm -rf -- "$tmp"
    die "could not publish $rel into staging"
  fi
  return 0
}

case "${1:-}" in
  capabilities) cmd_capabilities ;;
  list) shift; cmd_list "${1:-}" ;;
  acquire) shift; cmd_acquire "${1:?acquire: id required}" "${2:?acquire: destdir required}" "${3:-}" ;;
  "" | --help)
    print -ru2 -- 'usage: rip-provider-folder capabilities | list <root> | acquire <id> <destdir> [relpath]'
    exit 2
    ;;
  *) die "unknown verb: $1" ;;
esac
