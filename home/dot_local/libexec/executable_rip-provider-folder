#!/usr/bin/env zsh
# rip-provider-folder — books the operator already has, on a local disk.
#
# A folder is a SOURCE, exactly like a store is. This implements the same
# capabilities/list/acquire contract as rip-provider-libation, so the panel,
# the session worker, the push, the checksum verify and the staging cleanup
# all work on local books without knowing anything changed.
#
# m4b only, deliberately: the operator stores audiobooks in no other format.

set -eu -o pipefail

VERSION="1"
die() { print -ru2 -- "rip-provider-folder: $*"; exit 2 }

cmd_capabilities() {
  jq -nc --arg v "$VERSION" \
    '{name: "folder", version: $v, can_acquire: true, needs_gui: false}'
}

# _derive <bookdir> <root> — print \x1f-separated: author, title, source.
#
# Order: embedded tags, then directory structure, then the filename. Whichever
# wins is REPORTED as `derived_from`, because the operator has to be able to
# see what was guessed before ripping 40 books on trust.
_derive() {
  setopt localoptions noerrexit nopipefail
  local d="$1" root="$2" f author title
  f="$(print -rl -- "$d"/*.m4b(N) | head -1)"

  if [[ -n "$f" ]] && command -v ffprobe >/dev/null 2>&1; then
    local tags
    tags="$(ffprobe -v error -show_entries format_tags=album_artist,artist,album,title \
              -of default=noprint_wrappers=1:nokey=0 -- "$f" 2>/dev/null)"
    author="$(print -r -- "$tags" | sed -n 's/^TAG:album_artist=//p' | head -1)"
    [[ -n "$author" ]] || author="$(print -r -- "$tags" | sed -n 's/^TAG:artist=//p' | head -1)"
    title="$(print -r -- "$tags" | sed -n 's/^TAG:album=//p' | head -1)"
    if [[ -n "$author" && -n "$title" ]]; then
      print -r -- "$author"$'\x1f'"$title"$'\x1f'"tags"
      return 0
    fi
  fi

  # Directory structure: <Author>/<Title>/ relative to the root. This is free
  # and already correct for a collection organised the way cantina stores books.
  # Guarded against d == root: without it the empty-strip leaves the WHOLE
  # absolute path in $rel, which trivially contains a "/" and gets routed
  # here even though the book sits directly in the root — the author would
  # then become the root's own PARENT directory name.
  local rel="${d#$root/}"
  if [[ "$d" != "$root" && "$rel" == */* ]]; then
    print -r -- "${rel:h:t}"$'\x1f'"${rel:t}"$'\x1f'"path"
    return 0
  fi

  # Last resort. Marked plainly so the panel can flag it as a guess.
  #
  # Field separator is \x1f (unit separator), NOT a tab: `IFS=$'\t' read`
  # in cmd_list collapses a LEADING tab as ordinary IFS whitespace (POSIX
  # field-splitting), silently swallowing the empty author field on this
  # branch and shifting title/src left by one — title would read back as
  # the literal string "filename" instead of the actual book name, and src
  # (this branch label) would read back empty. \x1f is not whitespace, so
  # it is never collapsed; this repo already uses it elsewhere as a field
  # separator for exactly this reason.
  print -r -- ""$'\x1f'"${d:t}"$'\x1f'"filename"
}

cmd_list() {
  setopt localoptions noerrexit nopipefail
  local root="${1:?list: root required}"
  [[ -d "$root" ]] || die "no such directory: $root"
  root="${root:A}"

  # fd, no depth limit (the operator asked for none). -0 so a newline in a
  # path cannot split a record. Directories are deduped by the assoc array.
  local -A seen=()
  local f d
  while IFS= read -r -d '' f; do
    d="${f:h}"
    seen[$d]=1
  done < <(fd --absolute-path --type f --extension m4b --print0 . "$root" 2>/dev/null)

  # `one`/`n` are declared HERE, once, not re-declared inside the loop body
  # below: a `local` statement that re-declares an already-local name on a
  # later pass through this same function scope makes zsh print "name=value"
  # to STDOUT for that variable (reproduced in isolation; not documented
  # behavior we could find, but 100% repeatable) — corrupting the JSON
  # stream with bare `one=...` / `n=...` lines between rows.
  local author title src cover dur has_pdf one n
  for d in "${(@ko)seen}"; do
    IFS=$'\x1f' read -r author title src <<< "$(_derive "$d" "$root")"
    cover="$(print -rl -- "$d"/*.(jpg|jpeg|png)(N) | head -1)"
    dur=0
    if command -v ffprobe >/dev/null 2>&1; then
      for one in "$d"/*.m4b(N); do
        n="$(ffprobe -v error -show_entries format=duration -of csv=p=0 -- "$one" 2>/dev/null)"
        [[ "$n" == <->* ]] && dur=$(( dur + ${n%%.*} ))
      done
    fi
    # A sibling PDF is a real, local, checkable signal — unlike everything
    # else Audible-shaped in this row, this one costs nothing to establish
    # honestly, so it is not left null/false by default.
    has_pdf=false
    [[ -n "$(print -rl -- "$d"/*.pdf(N) | head -1)" ]] && has_pdf=true
    jq -nc \
      --arg id "$d" --arg title "$title" --arg author "$author" \
      --arg src "$src" --arg cover "$cover" --argjson dur "$dur" \
      --argjson has_pdf "$has_pdf" --arg v "$VERSION" '
      {id: $id,
       title: $title,
       subtitle: null,
       authors: (if $author == "" then [] else [$author] end),
       narrators: [],
       duration_s: $dur,
       series: null,
       series_position: null,
       language: null,
       abridged: false,
       published: null,
       has_pdf: $has_pdf,
       cover: (if $cover == "" then null else "file://" + $cover end),
       acquired: true,
       acquired_utc: null,
       plus: false,
       absent: false,
       ids: {},
       derived_from: $src,
       path: (if $author == "" then $title else $author + "/" + $title end),
       provider: "folder",
       provider_version: $v,
       format: "m4b"}'
  done
}

# cmd_acquire <bookdir> <destdir> [relpath] — COPY a local book into staging.
#
# COPY, never move. The push deletes the STAGED copy after a verified
# transfer, never the source, so the operator keeps their original collection
# and the extra disk is transient. A move would mean a failed verify leaves no
# original anywhere — and this is the one flow where the local copy IS the
# original. There is no --move here, deliberately.
#
# Built under a temporary name and renamed into place only on success: a
# half-copied directory sitting under the final name would be pushed as a
# truncated book, and the push cannot tell the difference (rip::ab_import
# was bitten by exactly this).
cmd_acquire() {
  setopt localoptions noerrexit nopipefail
  local src="$1" dest="$2"
  [[ -d "$src" ]] || die "no such directory: $src"
  local -a audio=("$src"/*.m4b(N))
  (( ${#audio} )) || die "no m4b in $src — nothing to acquire"

  # The caller OWNS the destination path. Do not re-derive it here when it is
  # given: (a) a later panel lets the operator EDIT author/title inline
  # before ripping, and re-deriving would silently discard that edit; (b) a
  # root guessed as ${src:h:h} is wrong for a book sitting directly under the
  # chosen root — for /root/Book that yields "/", promoting the root's own
  # name into "author". `acquire <id> <destdir> [relpath]` is additive: a
  # provider that names its own output (libation) ignores a third argument,
  # exactly as `list [root]` is ignored by a provider that owns a catalogue.
  # rip::ab_worker always passes the plan item's own path here now, so this
  # fallback is unreachable in production.
  #
  # When relpath is absent anyway, do NOT guess a directory structure:
  # without the real scan root, /a/b/Book cannot be told apart from a loose
  # book AT /a/b — the information needed to tell an "Author" folder from
  # the root itself simply is not in $src's path (acquire is never handed
  # the root the way `list <root>` is). Guessing is the harmful direction —
  # it invents provenance and can land a book under a wrong shelf. Declining
  # to guess is visible (the book stages under its own directory name, no
  # author) and harmless. So: title is the book directory's own basename,
  # author is empty, full stop.
  local rel="${3:-${src:t}}"

  mkdir -p "$dest" || die "cannot create $dest"
  local staging="$dest/$rel"
  # Anchor OUTSIDE $dest, not under "${staging:h}": $dest is
  # rip::staging_for audiobooks, the exact tree rip::push_worker walks and
  # ships. A temp built one or two levels inside it — as this line used to
  # do — is a dot-directory, but `find` descends into dot-directories
  # regardless, and `cp -p` preserves the source mtime, so the push's age
  # gate offers no protection either: a copied file looks "settled" the
  # instant it exists. A killed acquire then leaves a partial book the next
  # push ships as real, sidecar and all; worse, push_worker already runs
  # concurrently with an acquire batch (its own comment says so), so even
  # an uninterrupted copy can have its still-open files verify-deleted out
  # from under it mid-write. rip::ab_import hit this exact prohibition
  # first (rip.zsh: "Do NOT anchor to ROOT/audiobooks — temp files there
  # would be enumerated and shipped") — ${dest:h} is the same fix: the
  # staging root itself, one level above "audiobooks", which neither the
  # watcher nor the push enumerates, and still the same filesystem as
  # $dest so the final `mv` stays an atomic rename.
  local tmp="${dest:h}/.rip-folder.$$"
  mkdir -p "${staging:h}" || die "cannot create ${staging:h}"
  rm -rf -- "$tmp"
  mkdir -p "$tmp" || die "cannot create the staging temp for $rel"

  print -r -- "progress -1 copying"
  local f copy_rc=0
  # (N-.): the precondition above (`*.m4b(N)`, no type qualifier) counts a
  # SYMLINKED .m4b as present — the operator's real store is exactly the
  # kind of thing a symlink-based collection points at. A plain `(N.)`
  # examines the dirent itself (a symlink's own type is "l", never "."),
  # so it silently skipped every such file: precondition says "audio
  # present", copy loop disagrees and copies nothing for it, and the run
  # still exits 0 with a book that has a cover but no sound. `-` toggles
  # the qualifier to examine the symlink's TARGET, so a symlink to a
  # regular file matches `.` the same way the file itself would.
  for f in "$src"/*(N-.); do
    if ! cp -p -- "$f" "$tmp/"; then
      copy_rc=1
      break
    fi
  done
  if (( copy_rc != 0 )); then
    rm -rf -- "$tmp"
    die "copy failed for ${f:t}"
  fi

  # Belt-and-suspenders on the same disagreement: even with the glob fixed
  # above, publish nothing unless every .m4b the precondition counted
  # actually landed as a real file in $tmp — a captured outcome, not
  # "the copy loop returned 0 so it must be fine".
  local -a landed=("$tmp"/*.m4b(N-.))
  if (( ${#landed} != ${#audio} )); then
    rm -rf -- "$tmp"
    die "audio did not land in staging for $rel (expected ${#audio}, got ${#landed})"
  fi

  # The destination must not already exist: publishing over it would silently
  # merge two books. rip::ab_worker refuses an already-staged book upstream,
  # so reaching here means something raced us.
  if [[ -e "$staging" ]]; then
    rm -rf -- "$tmp"
    die "already staged: $rel"
  fi
  if ! mv -- "$tmp" "$staging"; then
    rm -rf -- "$tmp"
    die "could not publish $rel into staging"
  fi
  return 0
}

case "${1:-}" in
  capabilities) cmd_capabilities ;;
  list) shift; cmd_list "${1:-}" ;;
  acquire) shift; cmd_acquire "${1:?acquire: id required}" "${2:?acquire: destdir required}" "${3:-}" ;;
  "" | --help)
    print -ru2 -- 'usage: rip-provider-folder capabilities | list <root> | acquire <id> <destdir> [relpath]'
    exit 2
    ;;
  *) die "unknown verb: $1" ;;
esac
