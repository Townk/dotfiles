#!/usr/bin/env zsh
# tmux-alert-notify <activity|silence|bell> <window-name> — host OSD for
# tmux window alerts (mux migration Phase 4, D6). Mirrors the zellij
# zj_hud_alarm notify UX through the shared common.zsh `notify` helper
# (Hammerspoon OSD).
#
# Skipped over ssh: the OSD renders on the tmux HOST's screen, invisible
# to a remote client — the status-bar flag icon still shows there (ledger
# row). The ssh truth comes from the attached client's session env.

set -euo pipefail

kind="${1:-activity}"
win="${2:-}"
TMUX_BIN="${MUX_TMUX_BIN:-tmux}"

# The BELL is gated; the alarms are not. They are different in kind:
#
#   activity / silence  are ALARMS the user armed by hand (`⌥w` → "alarm on
#                       updated" / "alarm on idle", which set monitor-activity
#                       / monitor-silence). You asked to be told, so tell you.
#   bell                nobody armed. monitor-bell is on by default and any
#                       program can ring it, and it is already reported twice
#                       without an OSD — the terminal rings it (that audible
#                       path is the emulator's; we pass no --sound) and the
#                       window's status entry takes window-status-bell-style.
#                       A third, screen-centre popup for it is noise.
#
# `set -g @bell_osd on` opts the bell back in.
if [[ "$kind" == bell ]]; then
  osd="$("$TMUX_BIN" show -gv @bell_osd 2>/dev/null)" || osd=""
  case "${osd:l}" in
    on | 1 | true | yes) ;;
    *) exit 0 ;;
  esac
fi

# Skipped over ssh even when enabled: the OSD renders on the tmux HOST's
# screen. Note `-SSH_CONNECTION` (a leading dash) is what a LOCAL session
# reports — only the `SSH_CONNECTION=` prefix means a remote client.
sess="$("$TMUX_BIN" list-clients -F '#{client_session}' 2>/dev/null | head -1)" || sess=""
if [[ -n "$sess" ]]; then
  v="$("$TMUX_BIN" show-environment -t "$sess" SSH_CONNECTION 2>/dev/null)" || v=""
  [[ "$v" == SSH_CONNECTION=* ]] && exit 0
fi

case "$kind" in
  activity) icon="glyph:nf-md-bell_ring"  msg="Activity in ${win:-a window}" ;;
  silence)  icon="glyph:nf-md-bell_sleep" msg="Idle: ${win:-a window} went quiet" ;;
  bell)     icon="glyph:nf-md-bell_alert" msg="Bell in ${win:-a window}" ;;
  *)        icon="glyph:nf-md-bell"       msg="Alert in ${win:-a window}" ;;
esac

source "$HOME/.local/lib/common.zsh" 2>/dev/null || exit 0
notify --icon "$icon" "$msg" >/dev/null 2>&1 || true
exit 0
