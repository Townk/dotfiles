#!/usr/bin/env python3
"""Benchmark local OpenAI-compatible chat models.

Writes JSONL results under ~/.local/state/local-llm/ so the speed gateway can
route "auto" requests from measured throughput instead of static guesses.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path


DEFAULT_MODELS = ("Qwen3.6-35B-A3B-6bit", "gemma-4-12B-it-8bit")
PROMPTS = {
    "short": "Explain the difference between a unit test and an integration test in one paragraph.",
    "medium": "\n".join(
        [
            "You are reviewing a small TypeScript service. Summarize the risk profile.",
            "Focus on correctness, missing tests, and operational failure modes.",
            "Pretend these files are in scope:",
            *[f"src/module_{i:02d}.ts exports handlers, validators, and repository helpers." for i in range(80)],
        ]
    ),
    "long": "\n".join(
        [
            "Map this synthetic codebase and produce a concise implementation plan.",
            "Keep only durable architectural observations.",
            *[
                f"file src/service_{i:03d}.ts: handler calls validator_{i:03d}, repository_{i:03d}, and emits audit event {i:03d}."
                for i in range(900)
            ],
        ]
    ),
}


def state_path() -> Path:
    root = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    return root / "local-llm" / "benchmarks.jsonl"


def post_json(url: str, payload: dict, timeout: float) -> tuple[dict, float]:
    body = json.dumps(payload).encode("utf-8")
    request = urllib.request.Request(
        url,
        data=body,
        headers={"Content-Type": "application/json", "Authorization": "Bearer local-benchmark"},
        method="POST",
    )
    start = time.perf_counter()
    with urllib.request.urlopen(request, timeout=timeout) as response:
        raw = response.read()
    elapsed = time.perf_counter() - start
    return json.loads(raw.decode("utf-8")), elapsed


def benchmark_one(base_url: str, model: str, prompt_name: str, max_tokens: int, timeout: float) -> dict:
    url = base_url.rstrip("/") + "/chat/completions"
    prompt = (
        PROMPTS[prompt_name]
        + f"\n\nBenchmark instruction: write at least {max_tokens} output tokens. "
        + "Use numbered short sentences and continue until the response budget is exhausted."
    )
    payload = {
        "model": model,
        "messages": [
            {
                "role": "system",
                "content": "You are a terse coding assistant. Answer directly.",
            },
            {"role": "user", "content": prompt},
        ],
        "temperature": 0,
        "max_tokens": max_tokens,
        "stream": False,
    }
    result, elapsed = post_json(url, payload, timeout)
    usage = result.get("usage") or {}
    completion_tokens = usage.get("completion_tokens")
    prompt_tokens = usage.get("prompt_tokens")
    if completion_tokens is None:
        content = (((result.get("choices") or [{}])[0]).get("message") or {}).get("content", "")
        # Fallback is approximate; mlx_vlm.server normally returns usage.
        completion_tokens = max(1, len(content.split()))
    generation_tps = completion_tokens / elapsed if elapsed > 0 else 0.0
    return {
        "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "base_url": base_url,
        "model": model,
        "prompt": prompt_name,
        "max_tokens": max_tokens,
        "elapsed_s": round(elapsed, 3),
        "prompt_tokens": prompt_tokens,
        "completion_tokens": completion_tokens,
        "generation_tps": round(generation_tps, 3),
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--base-url", default=os.environ.get("LOCAL_LLM_BASE_URL", "http://127.0.0.1:8000/v1"))
    parser.add_argument("--model", action="append", dest="models", help="Model id to benchmark; repeatable.")
    parser.add_argument("--prompt", choices=sorted(PROMPTS), action="append", dest="prompts")
    parser.add_argument("--max-tokens", type=int, default=128)
    parser.add_argument("--timeout", type=float, default=600)
    parser.add_argument("--fail-under", type=float, default=0.0, help="Exit non-zero if generation TPS is below this.")
    parser.add_argument("--output", type=Path, default=state_path())
    parser.add_argument("--json", action="store_true", help="Print JSONL instead of a table.")
    args = parser.parse_args()

    models = args.models or list(DEFAULT_MODELS)
    prompts = args.prompts or ["short", "medium"]
    args.output.parent.mkdir(parents=True, exist_ok=True)

    rows: list[dict] = []
    failed = False
    for model in models:
        for prompt_name in prompts:
            try:
                row = benchmark_one(args.base_url, model, prompt_name, args.max_tokens, args.timeout)
            except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as exc:
                row = {
                    "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                    "base_url": args.base_url,
                    "model": model,
                    "prompt": prompt_name,
                    "error": str(exc),
                }
                failed = True
            rows.append(row)
            with args.output.open("a", encoding="utf-8") as handle:
                handle.write(json.dumps(row, sort_keys=True) + "\n")
            if args.fail_under and row.get("generation_tps", 0) < args.fail_under:
                failed = True

    if args.json:
        for row in rows:
            print(json.dumps(row, sort_keys=True))
    else:
        print("model\tprompt\tcompletion_tokens\telapsed_s\tgeneration_tps")
        for row in rows:
            if "error" in row:
                print(f"{row['model']}\t{row['prompt']}\tERROR\t-\t{row['error']}")
            else:
                print(
                    f"{row['model']}\t{row['prompt']}\t{row['completion_tokens']}\t"
                    f"{row['elapsed_s']}\t{row['generation_tps']}"
                )

    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
