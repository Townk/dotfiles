#!/usr/bin/env zsh
# clipboard-mirror-dispatch — receiver for the laptop→remote clipboard history
# mirror (Phase 5, docs/clipboard-universal-project.md §11). The [clipboard-
# mirror] launchd service socat-listens on a per-user unix socket and EXECs
# this once per accepted connection, with the connection wired to stdin/stdout.
#
# A laptop, while SSH'd into this host with the mirror -L StreamLocalForward up,
# pushes each of its local captures here as a single framed record:
#
#   request:  <'M'><4-byte BE length N><N-byte payload>
#   response: <'O'|'E'><4-byte BE length N><N-byte payload>
#
#   payload = ref_id US kind US app US len RS preview RS text_plain
#             (US = 0x1f, RS = 0x1e; text_plain is the remainder and may
#              itself contain RS/newlines — only the FIRST two RS delimit)
#
# We upsert a `laptop-ref` row (keyed on ref_id) carrying only TEXT + METADATA
# — never blobs. The remote picker shows it origin-badged; Ctrl-Y on it asks
# the laptop to restore-by-id over the reverse channel (full rich, zero
# transfer). See clipboard-history.lua's push_to_mirror for the sender.
#
# Byte-safe like clipboard-bridge-dispatch: `setopt nomultibyte` so the length
# prefix and payload are counted/sliced as raw bytes, and the read loop's
# scratch var is declared once outside the loop (a bare re-`local` inside the
# loop prints the variable to stdout in zsh — see that script's notes).

set -u
zmodload zsh/system
zmodload zsh/datetime
setopt nomultibyte

DB_FILE="${PICK_CLIPBOARD_DB:-${XDG_DATA_HOME:-$HOME/.local/share}/pick-clipboard/history.db}"
MAX_REF_ROWS=1000

read_n() {
  local n=$1 timeout=$2
  local -i got=0
  local chunk
  REPLY=""
  while (( got < n )); do
    sysread -s $(( n - got )) -t "$timeout" chunk
    case $? in
      0) REPLY+="$chunk"; (( got += $#chunk )) ;;
      *) return 1 ;;
    esac
  done
  return 0
}

be32_to_int() {
  local b=$1
  local c1=${b[1,1]} c2=${b[2,2]} c3=${b[3,3]} c4=${b[4,4]}
  local -i b1=$(( #c1 )) b2=$(( #c2 )) b3=$(( #c3 )) b4=$(( #c4 ))
  print -r -- $(( (b1 << 24) | (b2 << 16) | (b3 << 8) | b4 ))
}

# Emit <status><BE32 payload-len><payload>. printf's \NNN octal handling writes
# the real length bytes (including NULs) straight to the socket.
send_frame() {
  local stat_byte=$1 payload=$2
  local -i n=$#payload
  printf '%s' "$stat_byte"
  printf "\\$(printf %03o $(( (n >> 24) & 255 )))\\$(printf %03o $(( (n >> 16) & 255 )))\\$(printf %03o $(( (n >> 8) & 255 )))\\$(printf %03o $(( n & 255 )))"
  printf '%s' "$payload"
}
send_ok()  { send_frame O "${1:-}"; }
send_err() { send_frame E "$1"; }

# --- read one framed record ------------------------------------------------
read_n 1 5 || exit 0
[[ "$REPLY" == "M" ]] || { send_err "bad opcode"; exit 0 }
read_n 4 5 || exit 0
length=$(be32_to_int "$REPLY")
payload=""
if (( length > 0 )); then
  read_n "$length" 5 || exit 0
  payload=$REPLY
fi

# --- parse: meta RS preview RS text -----------------------------------------
US=$'\x1f' RS=$'\x1e'
meta=${payload%%${RS}*}
rest=${payload#*${RS}}
preview=${rest%%${RS}*}
text=${rest#*${RS}}
local -a f
IFS=$US read -rA f <<< "$meta"
ref_id=${f[1]:-} kind=${f[2]:-} app=${f[3]:-} len=${f[4]:-0}

[[ "$ref_id" == <-> ]] || { send_err "bad ref_id"; exit 0 }
[[ "$len" == <-> ]] || len=0

# --- upsert a laptop-ref row (text + metadata only, no blobs) ----------------
# Arbitrary text goes through readfile() rather than SQL string literals so
# quotes/newlines/binary in the payload can't break or inject the statement.
tmpd=$(mktemp -d "${TMPDIR:-/tmp}/clip-mirror.XXXXXX") || { send_err "mktemp"; exit 0 }
print -rn -- "$preview" > "$tmpd/preview"
print -rn -- "$text"    > "$tmpd/text"
print -rn -- "$app"     > "$tmpd/app"
print -rn -- "$kind"    > "$tmpd/kind"
ts=$EPOCHREALTIME

existing=$(sqlite3 "$DB_FILE" "SELECT id FROM clips WHERE origin='laptop-ref' AND ref_id=$ref_id;" 2>/dev/null)
if [[ -n "$existing" ]]; then
  sqlite3 "$DB_FILE" "UPDATE clips SET last_ts=$ts, \
    text_preview=CAST(readfile('$tmpd/preview') AS TEXT), \
    text_plain=CAST(readfile('$tmpd/text') AS TEXT), \
    len=$len, type_kind=CAST(readfile('$tmpd/kind') AS TEXT), \
    source_app=CAST(readfile('$tmpd/app') AS TEXT) WHERE id=$existing;" 2>/dev/null
else
  sqlite3 "$DB_FILE" "INSERT INTO clips \
    (text_preview, text_plain, len, first_ts, last_ts, source_app, type_kind, origin, ref_id, pinned) \
    VALUES (CAST(readfile('$tmpd/preview') AS TEXT), CAST(readfile('$tmpd/text') AS TEXT), \
    $len, $ts, $ts, CAST(readfile('$tmpd/app') AS TEXT), CAST(readfile('$tmpd/kind') AS TEXT), \
    'laptop-ref', $ref_id, 0);" 2>/dev/null
fi

# Bound the mirror: drop oldest laptop-ref rows past the cap (the local watcher's
# own retention also sweeps, but a headless-ish remote may get no local writes).
sqlite3 "$DB_FILE" "DELETE FROM clips WHERE origin='laptop-ref' AND id NOT IN \
  (SELECT id FROM clips WHERE origin='laptop-ref' ORDER BY last_ts DESC LIMIT $MAX_REF_ROWS);" 2>/dev/null

rm -rf -- "$tmpd"
send_ok ""
