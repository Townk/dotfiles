#!/usr/bin/env python3
"""Small OpenAI-compatible gateway for local MLX models.

The gateway keeps Pi's provider simple while enforcing local constraints:
`local-agent-auto` routes to the fastest healthy model from recent benchmarks,
and oversized generations are capped before they can drag an interactive
session below the local throughput floor.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from typing import Any


AUTO_MODEL = "local-agent-auto"
DEFAULT_MODELS = ("Qwen3.6-35B-A3B-6bit", "gemma-4-12B-it-8bit")


def default_state_file() -> Path:
    root = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    return root / "local-llm" / "benchmarks.jsonl"


def estimate_tokens(value: Any) -> int:
    if isinstance(value, str):
        return max(1, len(value) // 4)
    if isinstance(value, list):
        return sum(estimate_tokens(item) for item in value)
    if isinstance(value, dict):
        return sum(estimate_tokens(item) for item in value.values())
    return 0


class SpeedPolicy:
    def __init__(
        self,
        state_file: Path,
        models: tuple[str, ...],
        preferred_model: str,
        floor_tps: float,
        max_tokens: int,
        long_prompt_tokens: int,
        long_prompt_max_tokens: int,
    ) -> None:
        self.state_file = state_file
        self.models = models
        self.preferred_model = preferred_model
        self.floor_tps = floor_tps
        self.max_tokens = max_tokens
        self.long_prompt_tokens = long_prompt_tokens
        self.long_prompt_max_tokens = long_prompt_max_tokens

    def latest_tps(self) -> dict[str, float]:
        latest: dict[str, float] = {}
        if not self.state_file.exists():
            return latest
        try:
            lines = self.state_file.read_text(encoding="utf-8").splitlines()
        except OSError:
            return latest
        for line in lines[-200:]:
            try:
                row = json.loads(line)
            except json.JSONDecodeError:
                continue
            model = row.get("model")
            tps = row.get("generation_tps")
            if isinstance(model, str) and isinstance(tps, (int, float)):
                latest[model] = float(tps)
        return latest

    def choose_model(self, requested: str | None) -> tuple[str, str]:
        if requested and requested != AUTO_MODEL:
            return requested, "explicit"

        latest = self.latest_tps()
        preferred_tps = latest.get(self.preferred_model)
        if self.preferred_model in self.models and (preferred_tps is None or preferred_tps >= self.floor_tps):
            reason = "preferred" if preferred_tps is None else "preferred-healthy"
            return self.preferred_model, reason

        healthy = [
            model
            for model in self.models
            if model != self.preferred_model and latest.get(model, 0.0) >= self.floor_tps
        ]
        if healthy:
            return max(healthy, key=lambda model: latest.get(model, 0.0)), "healthy-benchmark"
        if self.preferred_model in self.models:
            return self.preferred_model, "preferred-no-healthy-fallback"
        return self.models[0], "fallback"

    def apply(self, payload: dict[str, Any]) -> tuple[dict[str, Any], dict[str, Any]]:
        changed = dict(payload)
        requested = changed.get("model")
        model, reason = self.choose_model(requested if isinstance(requested, str) else None)
        changed["model"] = model

        prompt_tokens = estimate_tokens(changed.get("messages", changed.get("prompt", "")))
        cap = self.long_prompt_max_tokens if prompt_tokens >= self.long_prompt_tokens else self.max_tokens
        current_max = changed.get("max_tokens")
        if not isinstance(current_max, int) or current_max <= 0 or current_max > cap:
            changed["max_tokens"] = cap

        return changed, {
            "requested_model": requested,
            "routed_model": model,
            "route_reason": reason,
            "prompt_tokens_estimate": prompt_tokens,
            "max_tokens": changed["max_tokens"],
        }


class GatewayHandler(BaseHTTPRequestHandler):
    server_version = "local-llm-gateway/1"

    def log_message(self, fmt: str, *args: object) -> None:
        sys.stderr.write("%s - %s\n" % (self.log_date_time_string(), fmt % args))

    @property
    def gateway(self) -> "GatewayServer":
        return self.server  # type: ignore[return-value]

    def send_json(self, status: int, payload: dict[str, Any]) -> None:
        body = json.dumps(payload).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self) -> None:
        if self.path == "/health":
            self.send_json(200, {"ok": True, "target": self.gateway.target})
            return
        if urllib.parse.urlparse(self.path).path == "/v1/models":
            self.send_json(200, self.models_payload())
            return
        self.proxy()

    def do_POST(self) -> None:
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path not in ("/v1/chat/completions", "/v1/completions"):
            self.proxy()
            return

        length = int(self.headers.get("Content-Length", "0"))
        raw = self.rfile.read(length)
        try:
            payload = json.loads(raw.decode("utf-8"))
        except json.JSONDecodeError:
            self.send_json(400, {"error": {"message": "request body must be JSON"}})
            return
        if not isinstance(payload, dict):
            self.send_json(400, {"error": {"message": "request body must be a JSON object"}})
            return

        routed, meta = self.gateway.policy.apply(payload)
        self.log_message(
            "route requested=%s routed=%s reason=%s prompt_est=%s max_tokens=%s",
            meta["requested_model"],
            meta["routed_model"],
            meta["route_reason"],
            meta["prompt_tokens_estimate"],
            meta["max_tokens"],
        )
        self.proxy(body=json.dumps(routed).encode("utf-8"))

    def proxy(self, body: bytes | None = None, augment_models: bool = False) -> None:
        target_url = self.gateway.target.rstrip("/") + self.path
        headers = {
            key: value
            for key, value in self.headers.items()
            if key.lower() not in {"host", "content-length", "connection", "accept-encoding"}
        }
        if body is not None:
            headers["Content-Type"] = "application/json"
        request = urllib.request.Request(target_url, data=body, headers=headers, method=self.command)
        try:
            with urllib.request.urlopen(request, timeout=self.gateway.timeout) as response:
                status = response.status
                response_headers = response.headers
                response_body = response.read()
        except urllib.error.HTTPError as exc:
            status = exc.code
            response_headers = exc.headers
            response_body = exc.read()
        except urllib.error.URLError as exc:
            self.send_json(502, {"error": {"message": f"upstream unavailable: {exc}"}})
            return

        if augment_models and response_body:
            response_body = self.augment_models(response_body)

        self.send_response(status)
        for key, value in response_headers.items():
            if key.lower() in {"connection", "transfer-encoding", "content-encoding", "content-length"}:
                continue
            self.send_header(key, value)
        self.send_header("Content-Length", str(len(response_body)))
        self.end_headers()
        self.wfile.write(response_body)

    def augment_models(self, body: bytes) -> bytes:
        try:
            payload = json.loads(body.decode("utf-8"))
        except json.JSONDecodeError:
            return body
        data = payload.get("data")
        if isinstance(data, list) and not any(item.get("id") == AUTO_MODEL for item in data if isinstance(item, dict)):
            data.insert(
                0,
                {
                    "id": AUTO_MODEL,
                    "object": "model",
                    "created": int(time.time()),
                    "owned_by": "local-llm-gateway",
                },
            )
        return json.dumps(payload).encode("utf-8")

    def models_payload(self) -> dict[str, Any]:
        now = int(time.time())
        return {
            "object": "list",
            "data": [
                {"id": AUTO_MODEL, "object": "model", "created": now, "owned_by": "local-llm-gateway"},
                *[
                    {"id": model, "object": "model", "created": now, "owned_by": "llama-swap"}
                    for model in self.gateway.policy.models
                ],
            ],
        }


class GatewayServer(ThreadingHTTPServer):
    def __init__(self, address: tuple[str, int], handler: type[GatewayHandler], target: str, policy: SpeedPolicy, timeout: float) -> None:
        super().__init__(address, handler)
        self.target = target
        self.policy = policy
        self.timeout = timeout


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--host", default=os.environ.get("LOCAL_LLM_GATEWAY_HOST", "127.0.0.1"))
    parser.add_argument("--port", type=int, default=int(os.environ.get("LOCAL_LLM_GATEWAY_PORT", "8002")))
    parser.add_argument("--target", default=os.environ.get("LOCAL_LLM_TARGET", "http://127.0.0.1:8000/v1"))
    parser.add_argument("--state-file", type=Path, default=default_state_file())
    parser.add_argument("--model", action="append", dest="models", help="Routable backend model id; repeatable.")
    parser.add_argument("--preferred-model", default=os.environ.get("LOCAL_LLM_PREFERRED_MODEL", "Qwen3.6-35B-A3B-6bit"))
    parser.add_argument("--floor-tps", type=float, default=float(os.environ.get("LOCAL_LLM_FLOOR_TPS", "25")))
    parser.add_argument("--max-tokens", type=int, default=int(os.environ.get("LOCAL_LLM_MAX_TOKENS", "2048")))
    parser.add_argument("--long-prompt-tokens", type=int, default=int(os.environ.get("LOCAL_LLM_LONG_PROMPT_TOKENS", "6000")))
    parser.add_argument("--long-prompt-max-tokens", type=int, default=int(os.environ.get("LOCAL_LLM_LONG_PROMPT_MAX_TOKENS", "512")))
    parser.add_argument("--timeout", type=float, default=float(os.environ.get("LOCAL_LLM_UPSTREAM_TIMEOUT", "900")))
    args = parser.parse_args()

    models = tuple(args.models or DEFAULT_MODELS)
    policy = SpeedPolicy(
        state_file=args.state_file,
        models=models,
        preferred_model=args.preferred_model,
        floor_tps=args.floor_tps,
        max_tokens=args.max_tokens,
        long_prompt_tokens=args.long_prompt_tokens,
        long_prompt_max_tokens=args.long_prompt_max_tokens,
    )
    server = GatewayServer((args.host, args.port), GatewayHandler, args.target, policy, args.timeout)
    print(f"local-llm-gateway listening on http://{args.host}:{args.port} -> {args.target}", flush=True)
    server.serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main())
