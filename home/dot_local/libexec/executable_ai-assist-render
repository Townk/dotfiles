#!/usr/bin/env zsh
# ai-assist-render — beautify the ai-assist docked pane.
#
# The agent harness runs headless, so its stdout is raw markdown text. This
# wrapper becomes the docked pane's command (the workers spawn
# `ai-assist-render --harness <name> -- <harness cmd>` instead of the harness
# directly): it creates an input FIFO, streams the harness output into it, and
# launches `ai-assist-pager` in the foreground — the pager owns the pane from
# the start (title, spinner while waiting, streaming render once text arrives).
# If the pager isn't installed it falls back to `glow`, then a width-aware
# `fold`. The pane parks on exit (workers spawn it without --close-on-exit) so
# the reply stays for review.
#
# Reached by absolute path from the workers (~/.local/libexec is not on PATH,
# and the docked pane's PATH is the non-interactive one). Self-contained: no
# library sourcing, so it runs cleanly in a bare zellij pane.
set -uo pipefail

# Force narrow (1-cell) width for East-Asian-ambiguous characters (em-dash,
# ellipsis, smart quotes, nerd-font icons). The pager's width library reads this
# at process start; the docked pane inherits the zellij daemon env where LANG may
# be unset, which otherwise makes those chars count as 2 cells and the pager's
# background fills come up short. WezTerm renders them as 1 cell, so narrow matches.
export RUNEWIDTH_EASTASIAN=0

harness="agent"
origin_pane=""
over_ssh=0
shell_env=""
shell_cwd=""
shell_bin=""
shell_pid=""
shell_fifo=""
project_root=""
# Caller-provided fifo paths (Phase D orchestrator reuse). When set, render uses
# them instead of mktemp-ing and does NOT remove them on exit (caller owns them).
# Exception: when --cleanup-fifos is passed, the caller delegates cleanup to this
# pane — provided fifos are then added to the EXIT trap's removal set.
provided_in_fifo=""
provided_actions_fifo=""
provided_shell_fifo=""
provided_results_fifo=""
cleanup_provided_fifos=0
while (($#)); do
  case "$1" in
    --harness)        harness="${2:-agent}"; shift 2 ;;
    --origin-pane)    origin_pane="${2:-}"; shift 2 ;;
    --over-ssh)       over_ssh=1; shift ;;
    --shell-env)      shell_env="${2:-}"; shift 2 ;;
    --shell-cwd)      shell_cwd="${2:-}"; shift 2 ;;
    --shell-bin)      shell_bin="${2:-}"; shift 2 ;;
    --project-root)   project_root="${2:-}"; shift 2 ;;
    --input-fifo)     provided_in_fifo="${2:-}"; shift 2 ;;
    --actions-fifo)   provided_actions_fifo="${2:-}"; shift 2 ;;
    --shell-fifo)     provided_shell_fifo="${2:-}"; shift 2 ;;
    --results-fifo)   provided_results_fifo="${2:-}"; shift 2 ;;
    --cleanup-fifos)  cleanup_provided_fifos=1; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
done
# Propagate project root so ai-assist-remember (and any other tool) keys the
# KB on the canonical project root rather than the agent shell's cwd.
[[ -n "$project_root" ]] && export AI_ASSIST_PROJECT_ROOT="$project_root"

# Ensure ~/.local/libexec is on PATH so the agent harness can invoke
# ai-assist-run, ai-assist-ask, ai-assist-remember etc. by name.
# The docked pane runs in a non-interactive shell whose PATH omits this dir;
# guard against double-prepend.
case ":$PATH:" in
  *":$HOME/.local/libexec:"*) ;;
  *) export PATH="$HOME/.local/libexec:$PATH" ;;
esac
cmd=("$@")
[[ ${#cmd[@]} -gt 0 ]] || { print -u2 -- "ai-assist-render: no command after --"; exit 2; }

# Pane width (fall back to 100 if we can't query the tty).
typeset -i cols
cols=$(tput cols 2>/dev/null) || cols=0
((cols > 0)) || cols=100
typeset -i body=$((cols > 6 ? cols - 2 : 80))

# Ownership tracking: fifos this process mktemp-ed are appended here and removed
# by the EXIT trap. Caller-provided fifos are NOT appended — the caller owns them.
typeset -a _owned_fifos=()

# Agent's own shell (Phase C1): a real shell seeded with the origin env + cwd,
# reachable by the harness's `ai-assist-run` through AI_ASSIST_SHELL_FIFO. Owned
# by this pane's lifetime, like the action-broker. Spawned BEFORE the broker so
# that shell_fifo is already set when the broker is launched.
if [[ -n "$shell_cwd" || -n "$shell_env" ]]; then
  : "${shell_bin:=$HOME/.local/libexec/ai-assist-shell}"
  if [[ -x "$shell_bin" ]]; then
    if [[ -n "$provided_shell_fifo" ]]; then
      shell_fifo="$provided_shell_fifo"
      # Caller-provided — not owned.
    else
      shell_fifo="$(mktemp -u "${TMPDIR:-/tmp}/ai-assist-shell.XXXXXX")"
      mkfifo -m 600 "$shell_fifo"
      _owned_fifos+=("$shell_fifo")
    fi
    typeset -a shell_flags=(--cmd-fifo "$shell_fifo")
    [[ -n "$shell_env" ]] && shell_flags+=(--env-file "$shell_env")
    [[ -n "$shell_cwd" ]] && shell_flags+=(--cwd "$shell_cwd")
    "$shell_bin" "${shell_flags[@]}" &
    shell_pid=$!
    export AI_ASSIST_SHELL_FIFO="$shell_fifo"
  fi
fi

# Results FIFO: the broker writes run-result records here; the pager reads them.
# Use caller-provided path when given; otherwise mktemp a new one (and own it).
# Created here — before the broker — so it can be passed to the broker spawn.
if [[ -n "$provided_results_fifo" ]]; then
  results_fifo="$provided_results_fifo"
  # Caller-provided — not owned; do not append to _owned_fifos.
else
  results_fifo="$(mktemp -u "${TMPDIR:-/tmp}/ai-assist-res.XXXXXX")"
  mkfifo -m 600 "$results_fifo"
  _owned_fifos+=("$results_fifo")
fi

# Actions FIFO + broker: when we know the originating pane, create a FIFO (or use
# a caller-provided one), spawn the broker (it performs copy/play), and hand the
# pager --actions-fifo. The broker's lifetime is this pane's — the EXIT trap below
# kills it and removes any mktemp'd FIFO. Resolve the broker by absolute path (the
# docked pane's PATH lacks ~/.local/libexec); AI_ASSIST_BROKER_BIN overrides for tests.
fifo=""
broker_pid=""
if [[ -n "$origin_pane" ]]; then
  broker="${AI_ASSIST_BROKER_BIN:-}"
  if [[ -z "$broker" ]]; then
    for cand in \
      "$(command -v -- ai-assist-action-broker 2>/dev/null)" \
      "$HOME/.local/libexec/ai-assist-action-broker"; do
      [[ -n "$cand" && -x "$cand" ]] && { broker="$cand"; break; }
    done
  fi
  if [[ -n "$broker" && -x "$broker" ]]; then
    if [[ -n "$provided_actions_fifo" ]]; then
      fifo="$provided_actions_fifo"
      # Caller-provided — not owned; do not append to _owned_fifos.
    else
      fifo="$(mktemp -u "${TMPDIR:-/tmp}/ai-assist-act.XXXXXX")"
      if mkfifo -m 600 "$fifo" 2>/dev/null; then
        _owned_fifos+=("$fifo")
      else
        fifo=""
      fi
    fi
    if [[ -n "$fifo" ]]; then
      "$broker" --fifo "$fifo" --origin-pane "$origin_pane" \
        ${shell_fifo:+--shell-fifo "$shell_fifo"} --results-fifo "$results_fifo" \
        ${over_ssh:+--over-ssh} &
      broker_pid=$!
    fi
  fi
elif [[ -n "$provided_actions_fifo" ]]; then
  # Caller provided an actions fifo but no --origin-pane: honour the path so the
  # pager can still receive actions, but don't start the broker.
  fifo="$provided_actions_fifo"
fi

# Input FIFO: the harness streams stdout+stderr into this; the pager reads from it.
# Use caller-provided path when given; otherwise mktemp a new one (and own it).
if [[ -n "$provided_in_fifo" ]]; then
  in_fifo="$provided_in_fifo"
  # Caller-provided — not owned; do not append to _owned_fifos.
else
  in_fifo="$(mktemp -u "${TMPDIR:-/tmp}/ai-assist-in.XXXXXX")"
  mkfifo -m 600 "$in_fifo"
  _owned_fifos+=("$in_fifo")
fi

# Cleanup trap: kill broker + agent shell; remove ONLY the fifos this process
# created (tracked in _owned_fifos). Caller-provided fifos are left in place so
# the orchestrator can reuse them — UNLESS --cleanup-fifos was passed, in which
# case those provided fifos are also removed (the caller delegated ownership).
# Also removes the secrets env-snapshot ($shell_env) so it does not outlive this pane.
_cleanup_render() {
  [[ -n "$broker_pid" ]] && kill "$broker_pid" 2>/dev/null
  [[ -n "$shell_pid" ]] && kill "$shell_pid" 2>/dev/null
  (( ${#_owned_fifos[@]} )) && rm -f -- "${_owned_fifos[@]}"
  if (( cleanup_provided_fifos )); then
    [[ -n "$provided_in_fifo" ]]      && rm -f -- "$provided_in_fifo" 2>/dev/null
    [[ -n "$provided_actions_fifo" ]] && rm -f -- "$provided_actions_fifo" 2>/dev/null
    [[ -n "$provided_shell_fifo" ]]   && rm -f -- "$provided_shell_fifo" 2>/dev/null
    [[ -n "$provided_results_fifo" ]] && rm -f -- "$provided_results_fifo" 2>/dev/null
  fi
  [[ -n "$shell_env" ]] && rm -f -- "$shell_env"
}
trap '_cleanup_render' EXIT INT TERM

# Launch ai-assist-pager in the FOREGROUND: it owns the pane (title, spinner,
# streaming render). Resolve by absolute path — the docked pane's PATH lacks GOBIN
# (~/.local/share/go/bin where `go install` puts the binary). Try PATH first, then
# the known go-install locations by absolute path. AI_ASSIST_PAGER_BIN overrides
# (and is honoured even if missing, so tests can force the glow fallback).
# Not exec'd, so the cleanup trap still fires and the pane parks on the pager's
# final static render.
pager="${AI_ASSIST_PAGER_BIN:-}"
if [[ -z "$pager" ]]; then
  for cand in \
    "$(command -v -- ai-assist-pager 2>/dev/null)" \
    "${GOBIN:+$GOBIN/ai-assist-pager}" \
    "$HOME/.local/share/go/bin/ai-assist-pager" \
    "$HOME/go/bin/ai-assist-pager"; do
    [[ -n "$cand" && -x "$cand" ]] && { pager="$cand"; break; }
  done
fi

# Stream harness stdout+stderr into the input FIFO in the background, then
# launch the pager (or glow fallback) in the foreground. Keep the harness PID so
# its real exit code can be propagated below — the viewer's own status reflects
# the renderer, not the agent.
{ "${cmd[@]}" 2>&1; } > "$in_fifo" &
harness_pid=$!

if [[ -n "$pager" && -x "$pager" ]]; then
  # Build flags as a zsh array to avoid the word-split bug with optional flags.
  typeset -a pager_flags
  pager_flags=(--harness "$harness" --input-fifo "$in_fifo" --results-fifo "$results_fifo")
  [[ -n "$fifo" ]] && pager_flags+=(--actions-fifo "$fifo")
  "$pager" "${pager_flags[@]}"
else
  theme="$HOME/.config/glow/catppuccin-mocha.json"
  # Feed glow via the input FIFO. `glow FILE` opens its own pager (hangs the
  # docked pane); piping via stdin renders straight to stdout instead.
  if command -v glow >/dev/null 2>&1; then
    if [[ -r "$theme" ]]; then
      cat "$in_fifo" | glow --style "$theme" --width "$body"
    else
      cat "$in_fifo" | glow --width "$body"
    fi
  else
    cat "$in_fifo" | fold -s -w "$body"
  fi
fi

# The viewer (pager/glow/fold) returns at FIFO EOF — i.e. once the harness has
# finished and closed its write end. Reap the harness and propagate its real
# exit code so callers (and tests) see the agent's status, not the renderer's.
# The EXIT trap still fires afterwards to tear down broker/shell/FIFOs.
wait "$harness_pid"; rc=$?
exit "$rc"
