#!/usr/bin/env zsh
# ai-assist-render — beautify the ai-assist docked pane.
#
# The agent harness runs headless, so its stdout is raw markdown text. This
# wrapper becomes the docked pane's command (the workers spawn
# `ai-assist-render --harness <name> -- <harness cmd>` instead of the harness
# directly): it runs the harness with output BUFFERED while a braille spinner
# shows progress, then hands the captured markdown to `ai-assist-pager` — an
# interactive TUI viewer (per-element no-wrap + horizontal scroll for code and
# tables, full-width bands, vertical scroll) which also draws the header. If the
# pager isn't installed it falls back to `glow`, then a width-aware `fold`. The
# pane parks on exit (workers spawn it without --close-on-exit) so the reply
# stays for review.
#
# Reached by absolute path from the workers (~/.local/libexec is not on PATH,
# and the docked pane's PATH is the non-interactive one). Self-contained: no
# library sourcing, so it runs cleanly in a bare zellij pane.
set -uo pipefail

# Force narrow (1-cell) width for East-Asian-ambiguous characters (em-dash,
# ellipsis, smart quotes, nerd-font icons). The pager's width library reads this
# at process start; the docked pane inherits the zellij daemon env where LANG may
# be unset, which otherwise makes those chars count as 2 cells and the pager's
# background fills come up short. WezTerm renders them as 1 cell, so narrow matches.
export RUNEWIDTH_EASTASIAN=0

harness="agent"
origin_pane=""
over_ssh=0
while (($#)); do
  case "$1" in
    --harness)     harness="${2:-agent}"; shift 2 ;;
    --origin-pane) origin_pane="${2:-}"; shift 2 ;;
    --over-ssh)    over_ssh=1; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
done
cmd=("$@")
[[ ${#cmd[@]} -gt 0 ]] || { print -u2 -- "ai-assist-render: no command after --"; exit 2; }

# Pane width (fall back to 100 if we can't query the tty).
typeset -i cols
cols=$(tput cols 2>/dev/null) || cols=0
((cols > 0)) || cols=100
typeset -i body=$((cols > 6 ? cols - 2 : 80))

# SGR (inline — no theme sourcing).
mauve=$'\e[1;38;2;203;166;247m'
blue=$'\e[38;2;137;180;250m'
reset=$'\e[0m'

# Run the harness, buffering stdout+stderr; spinner while it works.
out=$(mktemp -t ai-assist-render) || exit 1
"${cmd[@]}" >"$out" 2>&1 &
pid=$!

# Title block while the harness works: blank line, the pane title, a blank line,
# then the spinner renders on the line below (the pager draws this same title
# once it takes over). Matches the pager's header so the handoff is seamless.
printf '\n  %s▓▓▓ ai-assist — %s%s\n\n' "$mauve" "$harness" "$reset"

spin=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
typeset -i i=1 start=$SECONDS
while kill -0 "$pid" 2>/dev/null; do
  printf '\r  %s%s%s working… %ds  ' "$blue" "${spin[i]}" "$reset" "$((SECONDS - start))"
  sleep 0.1
  i=$((i % 10 + 1))
done
wait "$pid"; rc=$?
printf '\r\e[K' # clear the spinner line

# Actions FIFO + broker: when we know the originating pane, create a FIFO, spawn
# the broker (it performs copy/play), and hand the pager --actions-fifo. The
# broker's lifetime is this pane's — the EXIT trap below kills it and removes the
# FIFO. Resolve the broker by absolute path (the docked pane's PATH lacks
# ~/.local/libexec); AI_ASSIST_BROKER_BIN overrides for tests.
fifo=""
broker_pid=""
if [[ -n "$origin_pane" ]]; then
  broker="${AI_ASSIST_BROKER_BIN:-}"
  if [[ -z "$broker" ]]; then
    for cand in \
      "$(command -v -- ai-assist-action-broker 2>/dev/null)" \
      "$HOME/.local/libexec/ai-assist-action-broker"; do
      [[ -n "$cand" && -x "$cand" ]] && { broker="$cand"; break; }
    done
  fi
  if [[ -n "$broker" && -x "$broker" ]]; then
    fifo="$(mktemp -u "${TMPDIR:-/tmp}/ai-assist-act.XXXXXX")"
    if mkfifo -m 600 "$fifo" 2>/dev/null; then
      "$broker" --fifo "$fifo" --origin-pane "$origin_pane" ${over_ssh:+--over-ssh} &
      broker_pid=$!
    else
      fifo=""
    fi
  fi
fi
# Fold broker + FIFO cleanup into the existing tmpfile trap.
trap 'rm -f -- "$out"; [[ -n "$broker_pid" ]] && kill "$broker_pid" 2>/dev/null; [[ -n "$fifo" ]] && rm -f -- "$fifo"' EXIT INT TERM

# Hand the captured markdown to ai-assist-pager (interactive: per-element no-wrap
# + horizontal scroll for code/tables, full-width bands, vertical scroll; it draws
# the header). Resolve by absolute path — the docked pane's PATH lacks GOBIN where
# the binary lives. If the pager isn't installed yet, fall back to glow (then a
# width-aware fold) so the feature degrades gracefully. Not exec'd, so the tempfile
# trap still fires and the pane parks on the pager's final static render.
# The docked pane inherits the zellij daemon's PATH, which does NOT include GOBIN
# (~/.local/share/go/bin where `go install` puts the binary) — so a bare PATH
# lookup fails there. Try PATH first, then the known go-install locations by
# absolute path. AI_ASSIST_PAGER_BIN overrides (and is honoured even if missing,
# so tests can force the glow fallback).
pager="${AI_ASSIST_PAGER_BIN:-}"
if [[ -z "$pager" ]]; then
  for cand in \
    "$(command -v -- ai-assist-pager 2>/dev/null)" \
    "${GOBIN:+$GOBIN/ai-assist-pager}" \
    "$HOME/.local/share/go/bin/ai-assist-pager" \
    "$HOME/go/bin/ai-assist-pager"; do
    [[ -n "$cand" && -x "$cand" ]] && { pager="$cand"; break; }
  done
fi
if [[ -n "$pager" && -x "$pager" ]]; then
  "$pager" --harness "$harness" ${fifo:+--actions-fifo "$fifo"} "$out"
else
  theme="$HOME/.config/glow/catppuccin-mocha.json"
  # Feed glow via STDIN, not a file argument: `glow FILE` opens its pager (it
  # would hang the docked pane); reading stdin renders straight to stdout.
  if command -v glow >/dev/null 2>&1; then
    if [[ -r "$theme" ]]; then
      glow --style "$theme" --width "$body" < "$out"
    else
      glow --width "$body" < "$out"
    fi
  else
    fold -s -w "$body" < "$out"
  fi
fi

exit "$rc"
