#!/usr/bin/env zsh
# ai-assist-render — beautify the ai-assist docked pane.
#
# The agent harness runs headless, so its stdout is raw markdown text. This
# wrapper becomes the docked pane's command (the workers spawn
# `ai-assist-render --harness <name> -- <harness cmd>` instead of the harness
# directly): it creates an input FIFO, streams the harness output into it, and
# launches `ai-assist-pager` in the foreground — the pager owns the pane from
# the start (title, spinner while waiting, streaming render once text arrives).
# If the pager isn't installed it falls back to `glow`, then a width-aware
# `fold`. The pane parks on exit (workers spawn it without --close-on-exit) so
# the reply stays for review.
#
# Reached by absolute path from the workers (~/.local/libexec is not on PATH,
# and the docked pane's PATH is the non-interactive one). Self-contained: no
# library sourcing, so it runs cleanly in a bare zellij pane.
set -uo pipefail

# Force narrow (1-cell) width for East-Asian-ambiguous characters (em-dash,
# ellipsis, smart quotes, nerd-font icons). The pager's width library reads this
# at process start; the docked pane inherits the zellij daemon env where LANG may
# be unset, which otherwise makes those chars count as 2 cells and the pager's
# background fills come up short. WezTerm renders them as 1 cell, so narrow matches.
export RUNEWIDTH_EASTASIAN=0

harness="agent"
origin_pane=""
over_ssh=0
while (($#)); do
  case "$1" in
    --harness)     harness="${2:-agent}"; shift 2 ;;
    --origin-pane) origin_pane="${2:-}"; shift 2 ;;
    --over-ssh)    over_ssh=1; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
done
cmd=("$@")
[[ ${#cmd[@]} -gt 0 ]] || { print -u2 -- "ai-assist-render: no command after --"; exit 2; }

# Pane width (fall back to 100 if we can't query the tty).
typeset -i cols
cols=$(tput cols 2>/dev/null) || cols=0
((cols > 0)) || cols=100
typeset -i body=$((cols > 6 ? cols - 2 : 80))

# Actions FIFO + broker: when we know the originating pane, create a FIFO, spawn
# the broker (it performs copy/play), and hand the pager --actions-fifo. The
# broker's lifetime is this pane's — the EXIT trap below kills it and removes the
# FIFO. Resolve the broker by absolute path (the docked pane's PATH lacks
# ~/.local/libexec); AI_ASSIST_BROKER_BIN overrides for tests.
fifo=""
broker_pid=""
if [[ -n "$origin_pane" ]]; then
  broker="${AI_ASSIST_BROKER_BIN:-}"
  if [[ -z "$broker" ]]; then
    for cand in \
      "$(command -v -- ai-assist-action-broker 2>/dev/null)" \
      "$HOME/.local/libexec/ai-assist-action-broker"; do
      [[ -n "$cand" && -x "$cand" ]] && { broker="$cand"; break; }
    done
  fi
  if [[ -n "$broker" && -x "$broker" ]]; then
    fifo="$(mktemp -u "${TMPDIR:-/tmp}/ai-assist-act.XXXXXX")"
    if mkfifo -m 600 "$fifo" 2>/dev/null; then
      "$broker" --fifo "$fifo" --origin-pane "$origin_pane" ${over_ssh:+--over-ssh} &
      broker_pid=$!
    else
      fifo=""
    fi
  fi
fi

# Input FIFO: the harness streams stdout+stderr into this; the pager reads from it.
in_fifo="$(mktemp -u "${TMPDIR:-/tmp}/ai-assist-in.XXXXXX")"
mkfifo -m 600 "$in_fifo"

# Cleanup trap: remove input FIFO + actions FIFO + kill broker on exit/signal.
trap '[[ -n "$broker_pid" ]] && kill "$broker_pid" 2>/dev/null; [[ -n "$fifo" ]] && rm -f -- "$fifo"; rm -f -- "$in_fifo"' EXIT INT TERM

# Launch ai-assist-pager in the FOREGROUND: it owns the pane (title, spinner,
# streaming render). Resolve by absolute path — the docked pane's PATH lacks GOBIN
# (~/.local/share/go/bin where `go install` puts the binary). Try PATH first, then
# the known go-install locations by absolute path. AI_ASSIST_PAGER_BIN overrides
# (and is honoured even if missing, so tests can force the glow fallback).
# Not exec'd, so the cleanup trap still fires and the pane parks on the pager's
# final static render.
pager="${AI_ASSIST_PAGER_BIN:-}"
if [[ -z "$pager" ]]; then
  for cand in \
    "$(command -v -- ai-assist-pager 2>/dev/null)" \
    "${GOBIN:+$GOBIN/ai-assist-pager}" \
    "$HOME/.local/share/go/bin/ai-assist-pager" \
    "$HOME/go/bin/ai-assist-pager"; do
    [[ -n "$cand" && -x "$cand" ]] && { pager="$cand"; break; }
  done
fi

# Stream harness stdout+stderr into the input FIFO in the background, then
# launch the pager (or glow fallback) in the foreground.
{ "${cmd[@]}" 2>&1; } > "$in_fifo" &

if [[ -n "$pager" && -x "$pager" ]]; then
  # Build flags as a zsh array to avoid the word-split bug with optional flags.
  typeset -a pager_flags
  pager_flags=(--harness "$harness" --input-fifo "$in_fifo")
  [[ -n "$fifo" ]] && pager_flags+=(--actions-fifo "$fifo")
  "$pager" "${pager_flags[@]}"
else
  theme="$HOME/.config/glow/catppuccin-mocha.json"
  # Feed glow via the input FIFO. `glow FILE` opens its own pager (hangs the
  # docked pane); piping via stdin renders straight to stdout instead.
  if command -v glow >/dev/null 2>&1; then
    if [[ -r "$theme" ]]; then
      cat "$in_fifo" | glow --style "$theme" --width "$body"
    else
      cat "$in_fifo" | glow --width "$body"
    fi
  else
    cat "$in_fifo" | fold -s -w "$body"
  fi
fi
