#!/usr/bin/env zsh
# clipboard-mount — single owner of the clipboard peer-mount layout: a
# read-only `rclone mount` (SFTP backend on the already-installed MacFUSE) of
# a peer's / under ${XDG_STATE_HOME}/clipboard/mnt/<host>, so a file copied on
# that peer can land on THIS Mac's pasteboard as an ordinary mount-relative
# public.file-url and Cmd+V in Finder becomes a native Finder copy (progress
# window and all). Spec:
# docs/superpowers/specs/2026-07-13-clipboard-mount-subsystem-design.md
#
# Subcommands:
#   ensure <host> [<alias>]   mount if needed (idempotent, flock-guarded);
#                             <alias> defaults to <host> — the ssh fragment's
#                             `Host` line already answers to the peer's
#                             LocalHostName (system-onboard R2), the same fact
#                             Ctrl-Y's `rsync -e ssh <source_host>:…` relies on
#   check <host>              bounded health probe; prints the mountpoint and
#                             exits 0 iff mounted AND answering; read-only —
#                             remounting is the CALLER's move (the dispatcher's
#                             self-heal), so this stays cheap for hot paths
#   unmount <host>            force teardown of one host's mount
#   sweep                     reap every unhealthy/orphaned mount under the
#                             mnt root (launchd interval agent + check-failure
#                             kick both land here)
#   map <host> <abspath>…     pure path mapping: peer path -> mountpoint path
#                             (the mount mirrors the peer's / 1:1, so this is
#                             concatenation; CLI/test surface — the dispatcher
#                             does the same concat inline on NUL-joined
#                             payloads, which this output form can't carry)
#
# <host> is the peer's LocalHostName as it appears in store rows' source_host
# (the M payload's host field). It crosses a trust boundary (wire payload),
# so it gets the same strict RFC-hostname-ish charset check system-onboard's
# valid_peer_hostname applies — and that check doubles as path-traversal
# defense, since <host> becomes a directory component of MNT_ROOT.
emulate -L zsh
setopt extended_glob
set -uo pipefail
zmodload zsh/system   # zsystem flock (ensure's serialization)
zmodload zsh/datetime # EPOCHREALTIME (cm::probe's errfile uniqueness)

MNT_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/clipboard/mnt"
LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/clipboard-mount"
# ensure's per-host flock wait. Env-overridable purely as a test seam (the
# busy-lock spec would otherwise sit through the full wait); default unchanged.
CLIPBOARD_MOUNT_LOCK_TIMEOUT_S="${CLIPBOARD_MOUNT_LOCK_TIMEOUT_S:-10}"
# rclone's mise shim, used only when rclone isn't already on PATH (the
# headless clipboard-bridge launchd service has no shims dir on PATH — see
# cm::ensure). Env-overridable purely as a test seam (a hermetic spec can't
# depend on this real machine's mise install state); default unchanged.
CLIPBOARD_MOUNT_RCLONE_SHIM="${CLIPBOARD_MOUNT_RCLONE_SHIM:-$HOME/.local/share/mise/shims/rclone}"

usage() {
  print -u2 -- "usage: clipboard-mount ensure <host> [<alias>] | check <host> | unmount <host> | sweep | map <host> <abspath>..."
  exit 1
}

# Same shape rule as system-onboard's valid_peer_hostname: alnum first char,
# then alnum/dot/dash. Rejects empty, leading dash/dot, globs, whitespace,
# unicode, and anything path-traversal-shaped.
cm::valid_host() {
  [[ "${1:-}" == [A-Za-z0-9][A-Za-z0-9.-]# ]]
}

cm::mountpoint() {
  cm::valid_host "${1:-}" || { print -u2 -- "clipboard-mount: invalid host '${1:-}'"; return 1 }
  print -r -- "$MNT_ROOT/$1"
}

cm::map() {
  [[ $# -gt 0 ]] || { print -u2 -- "clipboard-mount: map needs a host"; return 1 }
  local host="$1"; shift
  local mp; mp=$(cm::mountpoint "$host") || return 1
  (( $# > 0 )) || { print -u2 -- "clipboard-mount: map needs at least one path"; return 1 }
  local p
  for p in "$@"; do
    [[ "$p" == /* ]] || { print -u2 -- "clipboard-mount: not absolute: $p"; return 1 }
    [[ "$p" != */../* && "$p" != */.. ]] ||
      { print -u2 -- "clipboard-mount: unsafe path: $p"; return 1 }
    print -r -- "${mp}${p}"
  done
}

# cm::is_mounted <mp> — mount-table membership. macOS `mount` prints
# "<devname> on <mp> (macfuse, …)"; the " on … (" frame makes prefix-sharing
# mountpoints unambiguous.
cm::is_mounted() {
  mount 2>/dev/null | grep -qF " on $1 ("
}

# cm::probe <mp> [<timeout-s>=1] — bounded liveness LOOKUP. Stat-ing the
# mountpoint ROOT is a trap: the kernel's attribute cache can answer a root
# stat straight out of cache with NO daemon round-trip at all, so a mount
# whose rclone daemon has died (dev-shell recycled, network drop, …) still
# comes back rc 0 "healthy" — `ls` (readdir) then hits the daemon for real
# and fails with ENXIO "Device not configured". To force an actual
# round-trip, this probes a LOOKUP of a nonexistent CHILD instead: the attr
# cache has nothing cached for a path that's never existed, so the kernel
# has no choice but to ask the daemon.
#
# That trade means a bare rc can no longer discriminate health: ENOENT
# (daemon alive, answered "no such file") and ENXIO/ENOTCONN/EIO (daemon
# dead, kernel/fs layer answered instead) are BOTH non-zero rc from `stat`.
# So the probe captures stderr and classifies the outcome:
#   * rc!=0 and stderr contains "No such file" → HEALTHY (a real round-trip
#     happened and the daemon answered ENOENT, the expected "empty" result)
#   * rc==0 (the probe child bizarrely already exists)   → HEALTHY (rc 0 can
#     only mean the daemon answered a real lookup either way)
#   * rc!=0 with any other stderr (ENXIO, ENOTCONN, EIO, …) → DEAD
#   * doesn't complete within the budget                    → DEAD
# `LC_ALL=C` pins the stderr wording to the C locale so the ENOENT match
# doesn't get fooled by a localized message.
#
# The timeout path is unchanged and just as load-bearing as before: a lookup
# against a HUNG/dead FUSE volume can wedge in the kernel where even
# SIGKILL doesn't reap it, so this NEVER `wait`s a still-running probe —
# background the stat, poll its liveness, and on timeout kill-9 and walk
# away (rc 1 / DEAD). `timeout(1)` is deliberately not used here — it
# blocks in wait() on an unkillable child.
cm::probe() {
  local mp=$1 timeout_s=${2:-1}
  local pid errfile
  # $$ alone is NOT unique here: zsh subshells keep the parent's $$ while
  # being distinct OS processes — check's async `( cm::sweep ) &!` kick
  # would compute the SAME errfile path as its parent. Real per-invocation
  # entropy (µs clock + $RANDOM) makes every probe's errfile its own, so
  # even a timed-out probe's walked-away stat can't touch a later one's.
  errfile="${TMPDIR:-/tmp}/.clipboard-mount-probe.$$.${EPOCHREALTIME/./}.$RANDOM.err"
  LC_ALL=C stat -f %i -- "$mp/.clipboard-mount-probe.$$" >/dev/null 2>"$errfile" &
  pid=$!
  local -i waited_ms=0 budget_ms=$(( timeout_s * 1000 ))
  while (( waited_ms < budget_ms )); do
    if ! kill -0 "$pid" 2>/dev/null; then
      wait "$pid" 2>/dev/null
      local -i rc=$?
      if (( rc == 0 )) || grep -q 'No such file' "$errfile" 2>/dev/null; then
        rm -f "$errfile"
        return 0
      fi
      rm -f "$errfile"
      return 1
    fi
    sleep 0.05
    (( waited_ms += 50 ))
  done
  kill -9 "$pid" 2>/dev/null
  rm -f "$errfile"
  return 1
}

# cm::rclone_pids_for <mp> — pids of rclone mount daemons serving <mp>
# (matched via ps command line; macOS has no /proc).
cm::rclone_pids_for() {
  local mp=$1
  local -a pids=()
  local pid cmdline
  for pid in ${(f)"$(pgrep -f 'rclone mount' 2>/dev/null)"}; do
    cmdline=$(ps -p "$pid" -o command= 2>/dev/null) || continue
    # Whole-argv-word match, not a bare substring: a plain *"$mp"* match would
    # also hit a prefix-sharing sibling mountpoint (e.g. tearing down host
    # `foo` would substring-match and kill the rclone serving `foo-bar` too).
    # $mp is always a full argv word (either the mountpoint arg itself, or
    # followed by another flag), so requiring a surrounding space (or a
    # trailing end-of-string, since it's the command's last argv word here)
    # pins the match to the exact word.
    [[ "$cmdline" == *" $mp "* || "$cmdline" == *" $mp" ]] && pids+=("$pid")
  done
  (( ${#pids[@]} )) && print -r -- "${pids[@]}"
  return 0
}

# cm::teardown <host> — force teardown, always rc 0 (teardown is fail-soft
# cleanup; nothing above it can do better than "tried"). Escalation:
# plain umount -> diskutil unmount force -> kill -9 the owning rclone.
# rmdir LAST and best-effort-twice: removing the empty dir is what turns a
# stale pasted file-url into an instant "no such file" instead of a beachball.
cm::teardown() {
  local host=$1 mp
  mp=$(cm::mountpoint "$host") || return 0
  # teardown used to run lock-free, so check's async sweep-kick (and the 60s
  # launchd sweep agent) could force-unmount/kill/rmdir a mount that a
  # concurrent flock-holding `ensure` was still in the middle of creating.
  # Take the SAME per-host lock ensure uses, non-blocking: if another process
  # holds it, an ensure is in flight and will settle the mount's health
  # itself — never fight the winner, just bail. `zsystem flock` is backed by
  # POSIX fcntl record locks, NOT BSD flock(2): locks are associated with the
  # PROCESS (not the fd), so a process re-locking a file it already holds
  # (e.g. `ensure` calling teardown internally, same process, different fd)
  # succeeds immediately instead of blocking or failing. But fcntl's trap is
  # the flip side of that: closing ANY fd the process has open on the file
  # drops ALL of that process's locks on it — including the one `ensure` is
  # currently holding. That's exactly why the lockfile touch below is
  # conditional on the file not already existing: when `ensure` calls
  # teardown, the lockfile was already created before `ensure` locked it, so
  # skipping the touch here means no fd gets opened-then-closed and `ensure`'s
  # lock survives; re-acquiring the lock on a fresh fd within the same process
  # is safe under fcntl regardless. Only the standalone case (no lockfile yet
  # — a bare `unmount`/`sweep` before any `ensure` ever ran for this host)
  # takes the create-close path, and that's harmless there since this process
  # holds no lock yet for it to drop. The fd is held open to process exit
  # exactly like ensure's own lock fd; fine here too since unmount/sweep
  # processes are short-lived.
  local lock="$MNT_ROOT/.$host.lock"
  [[ -e "$lock" ]] || : >> "$lock" 2>/dev/null
  zsystem flock -t 0 "$lock" 2>/dev/null || return 0
  if ! umount "$mp" 2>/dev/null; then
    diskutil unmount force "$mp" >/dev/null 2>&1 || true
  fi
  local pid
  for pid in ${(s: :)"$(cm::rclone_pids_for "$mp")"}; do
    [[ -n "$pid" ]] && kill -9 "$pid" 2>/dev/null || true
  done
  rmdir "$mp" 2>/dev/null || { sleep 0.5; rmdir "$mp" 2>/dev/null } || true
  return 0
}

# cm::sweep — reap every unhealthy/orphaned mount under MNT_ROOT. Healthy
# mounts to reachable peers are deliberately LEFT ALONE even with no ssh
# session open (teardown is health-driven, not session-driven — spec §3.3):
# a lingering healthy mount keeps an already-pasted file-url valid and costs
# nothing.
cm::sweep() {
  local mp host
  for mp in "$MNT_ROOT"/*(N/); do
    host="${mp:t}"
    cm::is_mounted "$mp" && cm::probe "$mp" && continue
    cm::teardown "$host"
  done
  return 0
}

# cm::check <host> — the dispatcher's gate (spec §3.1): mountpoint printed +
# rc 0 iff healthy. Deliberately read-only — remount-on-failure is the
# caller's move (the dispatcher's self-heal chain owns that), which keeps
# check cheap enough for the hot copy path. Missing dir = instant negative
# (the common unmounted case). Present-but-unhealthy additionally kicks an
# async, fd-detached sweep so the broken mount gets reaped without this
# caller waiting on it.
cm::check() {
  local host=$1 mp
  mp=$(cm::mountpoint "$host") || return 1
  [[ -d "$mp" ]] || return 1
  if ! cm::is_mounted "$mp" || ! cm::probe "$mp"; then
    ( cm::sweep ) </dev/null >/dev/null 2>&1 &!
    return 1
  fi
  print -r -- "$mp"
}

# cm::ensure <host> [<alias>] — idempotent mount-if-needed (spec §3.1).
# flock-guarded per host so copy-storm self-heals and the Match-hook can't
# race each other into double mounts; the lock fd is held until exit.
#
# The rclone invocation, choice by choice (each is load-bearing — see spec):
#  * --sftp-ssh external-ssh mode (the ssh= connection-string option): rclone
#    shells out to OUR ssh, reusing the alias/keys/agent/per-host config —
#    zero rclone remote config, uniform for macOS and Linux peers. The alias
#    charset check above doubles as quoting safety: it can't contain quotes,
#    so the single-quoted connection-string value never breaks.
#  * ControlPath=none + ClearAllForwardings: the mount's ssh is fully
#    independent of the interactive session's mux — it can never become the
#    ControlMaster, never double-binds the clipboard/gpg RemoteForwards, and
#    a teardown can never kill a user session.
#  * BatchMode=yes: this runs headless (launchd, background subshells); a
#    password prompt would hang forever, so forbid it.
#  * _SYNCREMOTE=1: rclone's nested ssh must not re-trigger the Match-hook
#    (same sentinel every prepare step uses).
#  * --daemon-wait 5s: on macOS this is a CONSTANT sleep (default 1m!), so it
#    must be pinned low; callers background ensure anyway.
#  * --daemon-timeout 10s: kernel-op cap — the anti-beachball backstop.
#  * --read-only + -o nobrowse: never write to the peer; no Finder sidebar
#    clutter (paths stay fully readable, which is all a pasted url needs).
#  * --vfs-cache-mode off: Finder paste is a sequential read; stream it.
cm::ensure() {
  local host=${1:?usage: clipboard-mount ensure <host> [<alias>]}
  local alias="${2:-$host}"
  local mp
  mp=$(cm::mountpoint "$host") || return 1
  cm::valid_host "$alias" || { print -u2 -- "clipboard-mount: invalid alias '$alias'"; return 1 }

  mkdir -p "$MNT_ROOT" "$LOG_DIR" 2>/dev/null
  local lock="$MNT_ROOT/.$host.lock"
  : >> "$lock"
  zsystem flock -t "$CLIPBOARD_MOUNT_LOCK_TIMEOUT_S" "$lock" 2>/dev/null || { print -u2 -- "clipboard-mount: ensure '$host' busy"; return 1 }

  # probe #1 of 2 (pre-check): strictly sequential with the post-mount probe
  # below — same process, and cm::probe returns before anything else runs
  # (even on timeout it walks away rather than waiting), so the two calls
  # can never overlap; unique per-invocation errfiles cover the leftover
  # hung-stat case regardless.
  if [[ -d "$mp" ]] && cm::is_mounted "$mp" && cm::probe "$mp"; then
    return 0
  fi
  [[ -d "$mp" ]] && cm::teardown "$host"

  # rclone lives under mise (aqua backend: the official, cmount-capable
  # binaries -- Homebrew's build hard-disables `rclone mount` on macOS).
  # Check the shim FIRST, PATH second. On the interactive PATH, mise's shims
  # dir already precedes /opt/homebrew/bin, so checking the shim first just
  # makes that existing precedence explicit. It matters more headlessly: the
  # clipboard-bridge launchd service's PATH has no shims dir at all, so a
  # PATH-first check would let any stray Homebrew-built rclone sitting on
  # that PATH win instead -- and brew's build hard-refuses `rclone mount` on
  # macOS by construction, so every self-heal mount would fail. Shim-first
  # gets the same resolution in both contexts. mise shims are symlinks to the
  # mise binary itself (argv[0] dispatch), so exec'ing the shim directly
  # needs no PATH help at all; `command -v rclone` remains the fallback for
  # machines without a mise shim (or a non-mise rclone install).
  local rclone_bin
  if [[ -x "$CLIPBOARD_MOUNT_RCLONE_SHIM" ]]; then
    rclone_bin="$CLIPBOARD_MOUNT_RCLONE_SHIM"
  elif rclone_bin=$(command -v rclone 2>/dev/null); then
    :
  else
    print -u2 -- "clipboard-mount: rclone not installed (mise); clips stay lazy"
    return 1
  fi
  mkdir -p "$mp" 2>/dev/null || { print -u2 -- "clipboard-mount: cannot create $mp"; return 1 }

  if ! _SYNCREMOTE=1 "$rclone_bin" mount \
      ":sftp,ssh='ssh -o ControlPath=none -o ClearAllForwardings=yes -o BatchMode=yes -o ConnectTimeout=5 ${alias}':/" \
      "$mp" \
      --daemon --daemon-wait 5s --daemon-timeout 10s \
      --read-only --vfs-cache-mode off \
      --volname "${host} clipboard" -o nobrowse \
      --log-file "$LOG_DIR/${host}.log" --log-level NOTICE \
      </dev/null >/dev/null 2>>"$LOG_DIR/${host}.log"; then
    cm::teardown "$host"
    print -u2 -- "clipboard-mount: rclone mount of '$host' failed (see $LOG_DIR/${host}.log)"
    return 1
  fi
  # probe #2 of 2 (post-mount verify): sequential with probe #1 above — see
  # the comment there; a timed-out probe #1's lingering stat can't clobber
  # this call's errfile (unique names per invocation).
  if cm::is_mounted "$mp" && cm::probe "$mp"; then
    return 0
  fi
  print -u2 -- "clipboard-mount: mount of '$host' came up unhealthy; tearing down"
  cm::teardown "$host"
  return 1
}

case "${1:-}" in
  map)     shift; cm::map "$@" ;;
  unmount) shift; cm::mountpoint "${1:-}" >/dev/null || exit 1; cm::teardown "$1" ;;
  sweep)   cm::sweep ;;
  check)   shift; cm::check "${1:?usage: clipboard-mount check <host>}" ;;
  ensure)  shift; cm::ensure "$@" ;;
  *)       usage ;;
esac
