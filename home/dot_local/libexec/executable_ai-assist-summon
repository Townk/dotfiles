#!/usr/bin/env zsh
# ai-assist-summon — interactive entry point behind the ai-assist trigger (the
# Ctrl+Alt+A ZLE widget in dot_config/zsh/functions.d/widgets.sh).
#
# Runs as a NORMAL subprocess, deliberately NOT inside the ZLE/widget context:
# sourcing assist-agent-common.zsh from within a ZLE widget triggers a parse
# error in the live interactive shell, but it sources cleanly here. The widget
# stays thin (just calls this, then `zle reset-prompt`).
#
# Phase D flow (one-shot-first triage): capture context → create ONE pair of
# framed fifos (OUT: float→orchestrator, IN: orchestrator→float) → build the
# partial request.json → spawn the FLOAT (ai-assist-input, which transitions
# input→spinner in place) and the DETACHED orchestrator (ai-assist-triage),
# then return immediately so the prompt stays responsive. The orchestrator owns
# the whole lifecycle from there (read submit, triage, route 3 ways), reusing
# the same fifos for any docked pane.
#
# The shell env it needs (ATUIN_SESSION, ZELLIJ_PANE_ID, ZELLIJ_SESSION_NAME,
# PWD) is inherited from the shell that invoked the widget.
set -eu -o pipefail

source "${AI_ASSIST_LIB_DIR:-$HOME/.local/lib}/assist-agent-common.zsh"
source "$HOME/.local/lib/input-common.zsh"
# zj::available (and the float-spawn helpers) live here — summon runs under
# `set -eu`, so calling zj::available without this source aborts the whole
# entry path with `command not found`.
source "$HOME/.local/lib/zellij.zsh"

# This script's own dir, so we reach the sibling libexec helper by absolute path
# (~/.local/libexec is not on PATH).
LIBEXEC="${0:A:h}"

assist::capture_command
CAP_PROJECT="${${CAP_DIR:-$PWD}:t}"
CAP_BRANCH="$(git -C "${CAP_DIR:-$PWD}" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
if [[ "${CAP_KIND:-}" == error ]]; then
  CAP_SCROLLBACK="$(assist::capture_scrollback "$CAP_CMD")"
fi

# ── Build the partial request.json ───────────────────────────────────────────
# The user's request is empty for now; the orchestrator fills user_request from
# the float's submit record. Everything else (origin pane, cwd, command,
# scrollback, project) is captured here while we still have the origin shell.
req="$(assist::session_dir)/request.json"
mkdir -p "${req:h}"
assist::build_request "$(assist::prefill_template)" "$req"

# ── Spawn the FLOAT running ai-assist-input directly with the two fifos ───────
# Unlike the generic zj::text path (which wraps input-widget under zellij-modal
# to capture a single answer on exit), the orchestrated float runs the binary
# DIRECTLY: it owns its own lifecycle via the fifos (submit/cancel out, status/
# close in), so there is no capture-on-exit. Borderless + self-measured, like
# the other floats. Off-Zellij there is no float to spawn — bail BEFORE creating
# any fifos (the trigger is only bound inside Zellij), so the early-exit path
# never leaks a pair.
zj::available || exit 0

# ── Create the ONE pair of framed fifos (created once, reused float→pager) ────
# Only on the in-Zellij path: the float reads them and the orchestrator owns
# their lifecycle from here on.
out_fifo="$(mktemp -u "${TMPDIR:-/tmp}/ai-assist-out.XXXXXX")"
in_fifo="$(mktemp -u "${TMPDIR:-/tmp}/ai-assist-in.XXXXXX")"
mkfifo -m 600 "$out_fifo" "$in_fifo" || exit 1

bin="${ZELLIJ_BIN:-$(command -v zellij)}"
input_bin="$(_input::bin)"

prompt="How can I help you today?"
icon="󰧑"   # U+F09D1 (brain) — the ai-assist prompt glyph
pane_w=57
height=3

# Theme flags for the binary (truecolor catppuccin), like input::text.
theme::args

# Measure the exact rendered pane height (TTY-less, fast). Fall back to a sane
# default if the measure does not yield a plain integer.
measured_h="$("$input_bin" --type text --measure --width "$pane_w" \
  --title ai-assist --prompt "$prompt" --height "$height" --icon "$icon" \
  "${AI_THEME_ARGS[@]}" </dev/null 2>/dev/null)" || measured_h=""
[[ "$measured_h" == <-> ]] || measured_h=9

# The float: a floating, pinned, borderless pane running the binary with the two
# fifos. COLORTERM is carried through `env` because `zellij action new-pane` does
# not propagate it (so gum/lipgloss otherwise drop to 256-color).
"$bin" action new-pane --floating --close-on-exit \
  --name "" --borderless true --pinned true --width "$pane_w" --height "$measured_h" --cwd "$PWD" \
  -- env "COLORTERM=${COLORTERM:-truecolor}" \
  "$input_bin" --type text --title ai-assist --prompt "$prompt" \
  --height "$height" --icon "$icon" \
  --out-fifo "$out_fifo" --in-fifo "$in_fifo" \
  "${AI_THEME_ARGS[@]}" >/dev/null 2>&1

# ── Spawn the DETACHED orchestrator, then return immediately ─────────────────
# Disowned, stdio → /dev/null, so the ZLE widget unblocks at once and the prompt
# stays live. The orchestrator reads submit off OUT, runs triage, drives the
# spinner on IN, then routes — reusing the same fifos for any docked pane.
"$LIBEXEC/ai-assist-triage" \
  --out-fifo "$out_fifo" --in-fifo "$in_fifo" \
  --request "$req" --origin-pane "${ZELLIJ_PANE_ID:+terminal_$ZELLIJ_PANE_ID}" \
  </dev/null >/dev/null 2>&1 &!

exit 0
