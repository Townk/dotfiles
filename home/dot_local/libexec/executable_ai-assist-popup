#!/usr/bin/env zsh
# ai-assist-popup — floating prompt for the user's request. Runs ai-assist-input
# (Enter submit / Shift+Enter newline) inside a zellij-modal capture pane and
# prints the submitted text on stdout (empty + exit 130 on cancel).
set -euo pipefail
prefill=""
[[ "${1:-}" == "--prefill" ]] && { prefill="${2:-}"; shift 2; }

input_bin="${AI_ASSIST_INPUT_BIN:-ai-assist-input}"

# Resolve to an absolute path while we still have the interactive PATH (inherited
# from the trigger widget's shell). The floating pane's command runs under a
# non-login, non-interactive zsh (zellij-modal) that loads ~/.zshenv but NOT
# ~/.zshrc — where GOBIN (~/.local/share/go/bin, where ai-assist-input lives) is
# added to PATH. Passing a bare name into the float would fail to resolve there
# (the pane would just blink shut). Resolve here so the float gets the full path.
if command -v -- "$input_bin" >/dev/null 2>&1; then
  input_bin="$(command -v -- "$input_bin")"
fi

if [[ -z "${ZELLIJ:-}" ]]; then
  # No Zellij → inline fallback (used in tests / bare shells).
  exec "$input_bin" --value "$prefill" --title "ai-assist"
fi

modal="$HOME/.config/zellij/scripts/zellij-modal"

# ai-assist-input now renders its OWN title block (title + rule), so zellij-modal
# is run without a --title (its title block is skipped). The widget's textarea
# height is fixed by --height (it never sizes to the pane height). The float pane
# is sized in absolute rows to fit the chrome around the textarea: the widget's
# title + rule (2) + its border (2) + its hint line (1) + the pane frame (2) = 7.
input_height=8
pane_height=$((input_height + 7))

fifo="$(mktemp -u "${TMPDIR:-/tmp}/aiask-fifo.XXXXXX")"
mkfifo -m 600 "$fifo"
trap 'rm -f "$fifo"' EXIT INT TERM
"${ZELLIJ_BIN:-zellij}" action new-pane --floating --close-on-exit \
  --name "" --borderless false --pinned true --width 70% --height "$pane_height" --cwd "$PWD" \
  -- "$modal" --capture "$fifo" \
  -- "$input_bin" --value "$prefill" --height "$input_height" --title "ai-assist" >/dev/null
result="$(cat "$fifo")"; rm -f "$fifo"
[[ -n "$result" ]] || exit 130
print -r -- "$result"
