#!/usr/bin/env zsh
# ai-assist-popup — floating prompt for the user's request. A thin wrapper over
# the input stdlib's zj::text: a borderless, self-measured floating text widget
# (Enter submit / Shift+Enter newline) that prints the submitted text on stdout
# (empty submission or cancel → exit 130).
#
# All chrome, theming, geometry, the binary-path resolution (the float's pane
# PATH lacks GOBIN), and the off-Zellij inline fallback live in the stdlib now —
# this used to hand-roll `zellij action new-pane` with a bordered pane and a
# hardcoded height, which showed the Zellij border and cut the widget off.
set -uo pipefail

prefill=""
prompt="How can I help you today?"
icon="󰧑"   # U+F09D1 (brain) — the ai-assist prompt glyph (overrides the default ❯)
height=3   # 3-line textarea
while (($#)); do
  case "$1" in
    --prefill) prefill="${2:-}"; shift 2 ;;
    --prompt)  prompt="${2:-}"; shift 2 ;;
    --icon)    icon="${2:-}"; shift 2 ;;
    --height)  height="${2:-}"; shift 2 ;;
    *)         shift ;;
  esac
done

source "$HOME/.local/lib/zellij.zsh"

# --title sets the widget's ▓▓▓ header; the positional is the prompt/description
# rendered above the input box; --value prefills the textarea; --icon/--height
# override zj::text's defaults. zj::text measures the exact pane height, renders
# borderless (the widget draws its own frame), and falls back to inline
# input::text when not inside Zellij.
args=(--title "ai-assist")
[[ -n "$prompt" ]]  && args+=("$prompt")
[[ -n "$prefill" ]] && args+=(--value "$prefill")
[[ -n "$height" ]]  && args+=(--height "$height")
[[ -n "$icon" ]]    && args+=(--icon "$icon")
zj::text "${args[@]}"
