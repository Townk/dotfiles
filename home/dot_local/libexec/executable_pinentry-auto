#!/bin/sh
# pinentry-auto — gpg-agent's `pinentry-program` dispatcher.
#
# Kept in POSIX sh on purpose (the rest of this repo is zsh): gpg-agent execs it
# in a minimal, non-interactive environment, and all it does is branch and exec
# another binary — there is nothing here that warrants a shell dependency.
#
# Three ways this Mac is driven, three different pinentries:
#
#   SSH      -> pinentry-ui       prompt on the session tty, or a mux float
#                                 when that tty belongs to an AI agent pane
#   VNC      -> pinentry-ui       the terminal being viewed, and pinentry-ui
#                                 hands over to pinentry-mac when there is none
#   physical -> pinentry-touchid  Touch ID (own fallback to pinentry-mac)
#
# SSH is detected client-side: interactive shells export USE_CURSES=1 when
# remote (see dot_config/zsh/environment.sh) and gpg forwards $PINENTRY_USER_DATA
# through the agent to us. It must be done there, not here, because gpg-agent's
# environment has no SSH_CONNECTION to test. pinentry-touchid also does NOT honor
# USE_CURSES (jorgelbg/pinentry-touchid#26), so this branch must come first.
#
# VNC vs. physical is decided here, because at the shell level a Screen Sharing
# session is indistinguishable from sitting at the machine — both are the console
# user in the same Aqua session — and because the state can change (connect /
# disconnect) independently of any shell. The one thing a VNC viewer has that a
# person at the keyboard does not is a live inbound connection on the Screen
# Sharing port, so we probe for that fresh on every invocation. It matters
# because Touch ID cannot be satisfied by a remote viewer (no reachable sensor);
# pinentry-touchid then returns "Operation cancelled" instead of falling back, so
# VNC has to be routed to the pinentry-mac GUI, which renders on the very desktop
# the viewer is looking at.

# viewing_over_vnc — true when a macOS Screen Sharing (VNC) client is currently
# attached. $4 is the local-address column of `netstat -an`; matching the port
# there (not anywhere on the line) avoids a false positive when this Mac is
# itself a VNC *client* of another host.
viewing_over_vnc() {
  /usr/sbin/netstat -an -p tcp 2>/dev/null | /usr/bin/awk '
    $4 ~ /\.5900$/ && $NF == "ESTABLISHED" { found = 1 }
    END { exit found ? 0 : 1 }
  '
}

# The curses lane splits again inside pinentry-ui: an SSH session driven by a
# human gets the prompt in the pane they are looking at, but one driven by an
# AI coding agent gets it in a tmux float, because the agent's pty is a screen
# nobody is watching (docs/pinentry-ui-design.md).
#
# The guard is what makes a staged rollout safe, and it is not a formality:
# nothing in this repo builds automatically, so a host that has pulled the
# dotfiles but not run `make -C custom-builds/pinentry-ui install` has no
# binary here at all. It then signs exactly as it did before any of this
# existed. That same fall-through is the last line of the blast-radius rule —
# no front-end may ever become the only way to authenticate.
case "${PINENTRY_USER_DATA:-}" in
  *USE_CURSES*)
    [ -x "$HOME/.local/libexec/pinentry-ui" ] &&
      exec "$HOME/.local/libexec/pinentry-ui" "$@"
    exec /opt/homebrew/bin/pinentry-curses "$@"
    ;;
esac

# Over VNC the question is not "GUI or terminal" — it is "is there a terminal at
# all", and this script cannot answer that. The `ttyname` arrives over Assuan
# AFTER the exec, so the dispatcher has already chosen by the time anyone knows.
# So hand the lane to pinentry-ui and let it decide with the fact in hand: it
# draws in the terminal when there is one (a shell on the desktop being viewed,
# which used to get a GUI dialog for no reason) and hands the conversation to
# pinentry-mac when there is not (a commit from an editor's source-control panel
# with no GPG_TTY). Touch ID cannot serve either case here — no reachable sensor
# for a remote viewer, and it cancels rather than falling back.
if viewing_over_vnc; then
  [ -x "$HOME/.local/libexec/pinentry-ui" ] &&
    exec "$HOME/.local/libexec/pinentry-ui" "$@"
  exec /opt/homebrew/bin/pinentry-mac "$@"
fi

exec /opt/homebrew/bin/pinentry-touchid "$@"
