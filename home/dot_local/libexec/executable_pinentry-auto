#!/bin/sh
# pinentry-auto — the front door for every password this machine asks for.
#
# Two personalities, chosen by the name it was invoked as. As `pinentry-auto` it
# is gpg-agent's `pinentry-program` dispatcher, described below. As
# `askpass-auto` (a symlink to this file) it is what SUDO_ASKPASS, SSH_ASKPASS
# and GIT_ASKPASS point at — see the block above `viewing_over_vnc`.
#
# Kept in POSIX sh on purpose (the rest of this repo is zsh): gpg-agent execs it
# in a minimal, non-interactive environment, and all it does is branch and exec
# another binary — there is nothing here that warrants a shell dependency.
#
# Four ways this Mac is being driven, decided PER REQUEST by the `presence`
# helper (same directory), four different pinentries:
#
#   touchid -> pinentry-touchid  at the console with a reachable sensor
#                                (own fallback to pinentry-mac)
#   gui     -> pinentry-mac      at the console, no sensor to touch
#   vnc     -> pinentry-ui       the terminal being viewed, and pinentry-ui
#                                hands over to pinentry-mac when there is none
#   remote  -> pinentry-ui       prompt on the session tty, or a mux float
#                                when that tty belongs to an AI agent pane
#
# Per request is the design, not a nicety (docs/superpowers/specs/
# 2026-08-31-presence-aware-pinentry-design.md): the previous dispatcher
# trusted $PINENTRY_USER_DATA, which the shell exports ONCE at birth from its
# SSH_* markers — and a tmux pane outlives the attach that created it. A pane
# born over SSH kept steering to the mux float while the user sat at the very
# keyboard whose Touch ID sensor was plugged in and waiting. So on a Mac with
# the helper installed, USE_CURSES is not consulted at all; presence probes
# the machine fresh (console lock state, input recency, VNC connections,
# sensor reachability) each time a password is asked for.
#
# The USE_CURSES ladder below the presence block is not dead code; it is two
# live paths. Off a Mac there is nothing to probe — the helper prints `remote`
# unconditionally there, and the ladder's non-Darwin branch reaches the same
# pinentry-ui anyway. And on a Mac where the helper is missing or answers
# nonsense (a freshly provisioned host mid-apply, a broken probe), falling
# through to the ladder is the blast-radius rule: the host behaves exactly as
# it did before presence existed, and signing never has a new way to fail.
#
# Why Touch ID cannot serve the vnc lane: no sensor is reachable from the far
# side of a Screen Sharing connection, and pinentry-touchid returns
# "Operation cancelled" instead of falling back — so that lane goes to a GUI
# drawn on the very desktop the viewer is looking at.

# The askpass personality, reached when invoked through the `askpass-auto`
# symlink. sudo, ssh and git ask for a password the crude way — prompt in
# argv[1], secret on stdout, non-zero means no answer — and this is the same
# front door for them (docs/askpass-design.md).
#
# It branches on almost nothing, on purpose. There is no Touch ID rung here:
# pinentry-touchid is a keychain-backed store for a GPG passphrase, keyed by key
# fingerprint, so it cannot produce an account password — and Touch ID for sudo
# already happened upstream in PAM (pam_tid in /etc/pam.d/sudo_local) before any
# askpass helper runs. There is no float-versus-GUI branch either, because this
# script cannot see whether a pane exists; pinentry-ui decides that with the
# facts in hand, exactly as it does for the VNC lane below.
#
# Failing closed here is a real cost, not a formality: with `sudo -A` there is
# no prompt underneath us, so a missing binary means sudo cannot authenticate in
# that pane. `\sudo` is the documented escape, which is why the -A comes from an
# alias rather than from a wrapper on PATH.
case "${0##*/}" in
  askpass-auto)
    [ -x "$HOME/.local/libexec/pinentry-ui" ] || exit 1
    exec "$HOME/.local/libexec/pinentry-ui" --askpass "$@"
    ;;
esac

# exec_stock — hand over to whatever pinentry this system ships, and never
# return. This is the floor of every lane, so it searches rather than guessing:
# Homebrew on a Mac, the distro path on Linux, and `pinentry` last because there
# it is usually an alternatives symlink already pointing at the curses build.
# Absolute paths only — gpg-agent's PATH is not a login shell's.
exec_stock() {
  for p in /opt/homebrew/bin/pinentry-curses /usr/local/bin/pinentry-curses \
    /usr/bin/pinentry-curses /usr/bin/pinentry; do
    [ -x "$p" ] && exec "$p" "$@"
  done
  echo "pinentry-auto: no pinentry found on this system" >&2
  exit 1
}

# viewing_over_vnc — true when a macOS Screen Sharing (VNC) client is currently
# attached. $4 is the local-address column of `netstat -an`; matching the port
# there (not anywhere on the line) avoids a false positive when this Mac is
# itself a VNC *client* of another host.
viewing_over_vnc() {
  /usr/sbin/netstat -an -p tcp 2>/dev/null | /usr/bin/awk '
    $4 ~ /\.5900$/ && $NF == "ESTABLISHED" { found = 1 }
    END { exit found ? 0 : 1 }
  '
}

# `uname` by absolute path, both of them, for the same reason every other tool
# here is absolute: gpg-agent's PATH is not a login shell's, and a bare `uname`
# that fails to run would leave this empty — sending a Mac down the branch that
# skips Touch ID. Debian merged /bin into /usr/bin, older systems did not.
for u in /usr/bin/uname /bin/uname; do
  [ -x "$u" ] && { os=$("$u" -s); break; }
done

# The presence lanes (see the header). Each lane keeps a fall-through under
# it, because every binary here is optional on some host: pinentry-ui is
# compiled by hand, pinentry-touchid and pinentry-mac come from Homebrew. An
# answer this case does not recognise — including an empty one from a helper
# that failed — falls out of the case and down to the ladder below.
if [ "${os:-Darwin}" = Darwin ] && [ -x "$HOME/.local/libexec/presence" ]; then
  case "$("$HOME/.local/libexec/presence" 2>/dev/null)" in
    touchid)
      [ -x /opt/homebrew/bin/pinentry-touchid ] &&
        exec /opt/homebrew/bin/pinentry-touchid "$@"
      exec /opt/homebrew/bin/pinentry-mac "$@"
      ;;
    gui)
      exec /opt/homebrew/bin/pinentry-mac "$@"
      ;;
    vnc)
      [ -x "$HOME/.local/libexec/pinentry-ui" ] &&
        exec "$HOME/.local/libexec/pinentry-ui" "$@"
      exec /opt/homebrew/bin/pinentry-mac "$@"
      ;;
    remote)
      [ -x "$HOME/.local/libexec/pinentry-ui" ] &&
        exec "$HOME/.local/libexec/pinentry-ui" "$@"
      exec_stock "$@"
      ;;
  esac
fi

# The legacy ladder — reached off a Mac, and on a Mac only when the presence
# helper is missing or broken. The curses lane splits again inside
# pinentry-ui: an SSH session driven by a human gets the prompt in the pane
# they are looking at, but one driven by an AI coding agent gets it in a tmux
# float, because the agent's pty is a screen nobody is watching
# (docs/pinentry-ui-design.md).
#
# The guard is what makes a staged rollout safe, and it is not a formality: the
# apply hook that builds pinentry-ui is soft by design — no toolchain, or a
# compile error, warns and skips — so "dotfiles applied, no binary" stays a
# perfectly ordinary state of a host. It then signs exactly as it did before any
# of this existed. That same fall-through is the last line of the blast-radius
# rule — no front-end may ever become the only way to authenticate.
case "${PINENTRY_USER_DATA:-}" in
  *USE_CURSES*)
    [ -x "$HOME/.local/libexec/pinentry-ui" ] &&
      exec "$HOME/.local/libexec/pinentry-ui" "$@"
    exec_stock "$@"
    ;;
esac

# Everything below decides between macOS surfaces. Off a Mac there is only one
# surface, and pinentry-ui already knows what to do with it: draw in the
# terminal when there is one, fail when there is not.
if [ "${os:-Darwin}" != Darwin ]; then
  [ -x "$HOME/.local/libexec/pinentry-ui" ] &&
    exec "$HOME/.local/libexec/pinentry-ui" "$@"
  exec_stock "$@"
fi

# Over VNC the question is not "GUI or terminal" — it is "is there a terminal at
# all", and this script cannot answer that. The `ttyname` arrives over Assuan
# AFTER the exec, so the dispatcher has already chosen by the time anyone knows.
# So hand the lane to pinentry-ui and let it decide with the fact in hand: it
# draws in the terminal when there is one (a shell on the desktop being viewed,
# which used to get a GUI dialog for no reason) and hands the conversation to
# pinentry-mac when there is not (a commit from an editor's source-control panel
# with no GPG_TTY). Touch ID cannot serve either case here — no reachable sensor
# for a remote viewer, and it cancels rather than falling back.
if viewing_over_vnc; then
  [ -x "$HOME/.local/libexec/pinentry-ui" ] &&
    exec "$HOME/.local/libexec/pinentry-ui" "$@"
  exec /opt/homebrew/bin/pinentry-mac "$@"
fi

exec /opt/homebrew/bin/pinentry-touchid "$@"
