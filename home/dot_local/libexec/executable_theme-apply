#!/usr/bin/env zsh
# theme-apply — resolve the EFFECTIVE theme (canonical ⊕ loose override) into the
# runtime files the shell, dialogs, ai-playbook, the file viewers, and tmux
# read.
#
#   canonical : ~/.config/theme/chezmoi-system.{json,zsh}  and the tmux theme
#               ~/.config/tmux/themes/chezmoi-system-base.conf
#               — all chezmoi-generated from theme.yaml; NEVER modified here.
#   override  : ~/.config/theme/override.toml  — loose, per-machine, OPTIONAL.
#               Flat `token = "hex"` ('#' optional), e.g. `base = "#1c232f"`
#               (this session's WezTerm tint). Any palette token; `base` is the
#               common one.
#   effective : $XDG_CACHE_HOME/theme/chezmoi-system.{json,zsh}  (shell consumers, via
#               THEME_PALETTE_FILE/JSON) and ~/.config/tmux/themes/chezmoi-system.conf
#               (the theme tmux.conf sources).
#
# Run early in shell init, BEFORE the mux attach, so `chezmoi-system.conf` exists when
# the session starts (see dot_zshrc). With no override.toml the effective files
# equal the canonical ones — nothing changes. Idempotent + cheap: a stamped
# staleness check makes the common (unchanged) case a few stats.
emulate -L zsh
set -uo pipefail

theme_dir="${XDG_CONFIG_HOME:-$HOME/.config}/theme"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/theme"
canon_json="$theme_dir/chezmoi-system.json"
canon_zsh="$theme_dir/chezmoi-system.zsh"
override="$theme_dir/override.toml"
eff_json="$cache/chezmoi-system.json"
eff_zsh="$cache/chezmoi-system.zsh"
tmux_themes="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/themes"
canon_tmux="$tmux_themes/chezmoi-system-base.conf"
eff_tmux="$tmux_themes/chezmoi-system.conf"
stamp="$cache/.stamp"

[[ -r "$canon_json" && -r "$canon_zsh" ]] || exit 0
command -v jq >/dev/null 2>&1 || exit 0
mkdir -p "$cache" || exit 0

# Live-reload the tmux side (D15): a running tmux server re-reads colors on
# `source-file`. Default socket only;
# named -L/-S sockets (none in this config yet) would need their own dispatch.
reload_tmux() {
  command -v tmux >/dev/null 2>&1 || return 0
  [[ -f "$eff_tmux" ]] || return 0
  tmux has-session 2>/dev/null || return 0
  tmux source-file "$eff_tmux" >/dev/null 2>&1 || true
}

# The override represents "viewing this machine from elsewhere" (the WezTerm SSH
# tint), so only honor it in a REMOTE session — a local session at the machine
# keeps the canonical theme. An always-remote box (a headless dev-shell) is
# unchanged; the host has no override file. The flag rides the staleness key so
# switching local<->remote regenerates the effective files.
remote=0
# The canonical remote-detection triple (== mux::is_remote, mux-bootstrap.zsh);
# kept inline here since theme-apply runs as a bare `zsh` with a sandboxed $HOME
# and does not otherwise load that layer.
[[ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]] && remote=1

# --- staleness: skip when inputs unchanged and outputs present ---------------
# mtimes via zstat into REPLY: this runs on every interactive shell start, and
# the $(date -r …) form paid five fork+execs on the common unchanged path —
# with zstat the header's "a few stats" claim is literal. date(1) remains as
# the fallback for a zsh built without the module.
if zmodload -F zsh/stat b:zstat 2>/dev/null; then
  mt() { local -a s; zstat -A s +mtime -- "$1" 2>/dev/null && REPLY=$s[1] || REPLY=0; }
else
  mt() { REPLY="$(date -r "$1" +%s 2>/dev/null || echo 0)"; }
fi
mt "$override";   key="o:$REPLY"
mt "$canon_json"; key+=" p:$REPLY"
mt "$canon_tmux"; key+=" t:$REPLY"
key+=" s:$remote"
# $(<f) reads in-process (no fork); the -r guard replaces cat's 2>/dev/null —
# an inline redirect on $(<f) would spawn $NULLCMD and defeat the whole point.
stamp_val=""
[[ -r "$stamp" ]] && stamp_val="$(<"$stamp")"
if [[ -f "$eff_json" && -f "$eff_zsh" && "$stamp_val" == "$key" \
   && ( ! -r "$canon_tmux" || -f "$eff_tmux" ) ]]; then
  exit 0
fi

# --- override.toml (flat `name = "hex"`, '#' optional) -> JSON {name:"#hex"} --
# Only in a remote session (see above); local sessions fall through with ov={}.
ov='{}'
if (( remote )) && [[ -r "$override" ]]; then
  ov=$(awk -F= '
    /^[[:space:]]*#/ { next }
    /=/ {
      k = $1; gsub(/[[:space:]]/, "", k)
      v = $2; gsub(/[[:space:]"]/, "", v); sub(/^#/, "", v)
      if (k ~ /^[A-Za-z0-9_]+$/ && v ~ /^[0-9a-fA-F]{6}$/)
        printf "%s\"%s\":\"#%s\"", (n++ ? "," : ""), k, v
    }' "$override")
  ov="{$ov}"
fi

# --- effective chezmoi-system.json: overlay the override tokens onto .palette --------
if jq --argjson ov "$ov" '.palette = (.palette + $ov)' "$canon_json" >"$eff_json.tmp" 2>/dev/null; then
  mv "$eff_json.tmp" "$eff_json"
else
  rm -f "$eff_json.tmp"
  cp "$canon_json" "$eff_json"
  cp "$canon_zsh" "$eff_zsh"
  [[ -r "$canon_tmux" ]] && cp "$canon_tmux" "$eff_tmux" && reload_tmux
  print -r -- "$key" >"$stamp"
  exit 0
fi

# --- effective chezmoi-system.zsh: insert override C_HEX_* before the gated SGR block,
# so the C_* truecolor twins recompute from the overridden hex automatically ---
ov_lines=$(print -r -- "$ov" | jq -r 'to_entries[] | "C_HEX_\(.key | ascii_upcase)=\"\(.value)\""' 2>/dev/null)
if awk -v ins="$ov_lines" '
  /^if \[ -t 1 \]; then$/ && !done { if (length(ins)) print ins; done = 1 }
  { print }
' "$canon_zsh" >"$eff_zsh.tmp"; then
  mv "$eff_zsh.tmp" "$eff_zsh"
else
  rm -f "$eff_zsh.tmp"
  cp "$canon_zsh" "$eff_zsh"
fi

# --- effective tmux theme: substitute each overridden token's #hex literal.
# The generated conf's contract (tmux-theme.conf.tmpl) is lowercase #rrggbb
# from theme.yaml slots, so a plain global #hex→#hex swap per overridden
# token is exact (all slots are 6-digit; no longer hex runs exist).
if [[ -r "$canon_tmux" ]]; then
  typeset -a tmux_sed
  tmux_sed=()
  while IFS=$'\t' read -r tok hex; do
    [[ -n "$tok" ]] || continue
    chex=$(jq -r --arg t "$tok" '.palette[$t] // empty' "$canon_json")
    [[ -n "$chex" ]] || continue
    chex="${${chex#\#}:l}" ohex="${${hex#\#}:l}"
    [[ "$chex" == "$ohex" ]] && continue
    tmux_sed+=(-e "s/#${chex}/#${ohex}/g")
  done < <(print -r -- "$ov" | jq -r 'to_entries[] | "\(.key)\t\(.value)"' 2>/dev/null)
  if (( ${#tmux_sed} )); then
    sed "${tmux_sed[@]}" "$canon_tmux" >"$eff_tmux.tmp" && mv "$eff_tmux.tmp" "$eff_tmux" \
      || { rm -f "$eff_tmux.tmp"; cp "$canon_tmux" "$eff_tmux"; }
  else
    cp "$canon_tmux" "$eff_tmux"
  fi
  reload_tmux
fi

print -r -- "$key" >"$stamp"
