#!/usr/bin/env zsh
# theme-apply — resolve the EFFECTIVE theme (canonical ⊕ loose override) into the
# runtime files the shell, dialogs, ai-playbook, the file viewers, and Zellij
# (hence the zj-hud bar) read.
#
#   canonical : ~/.config/theme/chezmoi-system.{json,zsh}  and the Zellij theme
#               ~/.config/zellij/themes/chezmoi-system-base.kdl
#               — all chezmoi-generated from theme.yaml; NEVER modified here.
#   override  : ~/.config/theme/override.toml  — loose, per-machine, OPTIONAL.
#               Flat `token = "hex"` ('#' optional), e.g. `base = "#1c232f"`
#               (this session's WezTerm tint). Any palette token; `base` is the
#               common one.
#   effective : $XDG_CACHE_HOME/theme/chezmoi-system.{json,zsh}  (shell consumers, via
#               THEME_PALETTE_FILE/JSON) and ~/.config/zellij/themes/chezmoi-system.kdl
#               (the theme `config.kdl` loads; zj-hud's bar follows it).
#
# Run early in shell init, BEFORE the Zellij attach, so `chezmoi-system.kdl` exists when
# the session starts (see dot_zshrc). With no override.toml the effective files
# equal the canonical ones — nothing changes. Idempotent + cheap: a stamped
# staleness check makes the common (unchanged) case a few stats.
emulate -L zsh
set -uo pipefail

theme_dir="${XDG_CONFIG_HOME:-$HOME/.config}/theme"
zellij_themes="${XDG_CONFIG_HOME:-$HOME/.config}/zellij/themes"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/theme"
canon_json="$theme_dir/chezmoi-system.json"
canon_zsh="$theme_dir/chezmoi-system.zsh"
canon_kdl="$zellij_themes/chezmoi-system-base.kdl"
override="$theme_dir/override.toml"
eff_json="$cache/chezmoi-system.json"
eff_zsh="$cache/chezmoi-system.zsh"
eff_kdl="$zellij_themes/chezmoi-system.kdl"
stamp="$cache/.stamp"
nonce="$cache/zellij-reload-nonce"

[[ -r "$canon_json" && -r "$canon_zsh" ]] || exit 0
command -v jq >/dev/null 2>&1 || exit 0
mkdir -p "$cache" || exit 0

# Force a live Zellij reload so a RUNNING session re-reads the freshly regenerated
# effective theme (chezmoi-system.kdl). Zellij watches config.kdl, NOT the themes
# dir, so write a fresh token to the loose (untracked) nonce file and re-render
# config.kdl (which inlines it in a comment) via a SCOPED apply — config.kdl ONLY,
# never a bare `chezmoi apply`. No-op without chezmoi or a rendered config.kdl.
bump_reload_nonce() {
  command -v chezmoi >/dev/null 2>&1 || return 0
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/zellij/config.kdl"
  [[ -f "$cfg" ]] || return 0
  print -r -- "${RANDOM}${RANDOM}$(date +%s)" >"$nonce" 2>/dev/null || return 0
  chezmoi apply "$cfg" >/dev/null 2>&1 || true
}

# The override represents "viewing this machine from elsewhere" (the WezTerm SSH
# tint), so only honor it in a REMOTE session — a local session at the machine
# keeps the canonical theme. An always-remote box (a headless dev-shell) is
# unchanged; the host has no override file. The flag rides the staleness key so
# switching local<->remote regenerates the effective files.
remote=0
[[ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]] && remote=1

# --- staleness: skip when inputs unchanged and outputs present ---------------
mt() { date -r "$1" +%s 2>/dev/null || echo 0; }
key="o:$(mt "$override") p:$(mt "$canon_json") k:$(mt "$canon_kdl") s:$remote"
if [[ -f "$eff_json" && -f "$eff_zsh" && "$(cat "$stamp" 2>/dev/null)" == "$key" \
   && ( ! -r "$canon_kdl" || -f "$eff_kdl" ) ]]; then
  exit 0
fi

# --- override.toml (flat `name = "hex"`, '#' optional) -> JSON {name:"#hex"} --
# Only in a remote session (see above); local sessions fall through with ov={}.
ov='{}'
if (( remote )) && [[ -r "$override" ]]; then
  ov=$(awk -F= '
    /^[[:space:]]*#/ { next }
    /=/ {
      k = $1; gsub(/[[:space:]]/, "", k)
      v = $2; gsub(/[[:space:]"]/, "", v); sub(/^#/, "", v)
      if (k ~ /^[A-Za-z0-9_]+$/ && v ~ /^[0-9a-fA-F]{6}$/)
        printf "%s\"%s\":\"#%s\"", (n++ ? "," : ""), k, v
    }' "$override")
  ov="{$ov}"
fi

# --- effective chezmoi-system.json: overlay the override tokens onto .palette --------
if jq --argjson ov "$ov" '.palette = (.palette + $ov)' "$canon_json" >"$eff_json.tmp" 2>/dev/null; then
  mv "$eff_json.tmp" "$eff_json"
else
  rm -f "$eff_json.tmp"
  cp "$canon_json" "$eff_json"
  cp "$canon_zsh" "$eff_zsh"
  [[ -r "$canon_kdl" ]] && sed 's/chezmoi-system-base {/chezmoi-system {/' "$canon_kdl" >"$eff_kdl"
  bump_reload_nonce
  print -r -- "$key" >"$stamp"
  exit 0
fi

# --- effective chezmoi-system.zsh: insert override C_HEX_* before the gated SGR block,
# so the C_* truecolor twins recompute from the overridden hex automatically ---
ov_lines=$(print -r -- "$ov" | jq -r 'to_entries[] | "C_HEX_\(.key | ascii_upcase)=\"\(.value)\""' 2>/dev/null)
if awk -v ins="$ov_lines" '
  /^if \[ -t 1 \]; then$/ && !done { if (length(ins)) print ins; done = 1 }
  { print }
' "$canon_zsh" >"$eff_zsh.tmp"; then
  mv "$eff_zsh.tmp" "$eff_zsh"
else
  rm -f "$eff_zsh.tmp"
  cp "$canon_zsh" "$eff_zsh"
fi

# --- effective Zellij theme: substitute each overridden token's "R G B" triple
# in the canonical theme. zj-hud's bar follows the theme background, so a `base`
# override tints the bar; KDL color values sit at end-of-line, so anchor on
# " R G B$" to avoid matching a longer number. ---------------------------------
if [[ -r "$canon_kdl" ]]; then
  rgb() { local h="${1#\#}"; print -r -- "$(( 16#${h:0:2} )) $(( 16#${h:2:2} )) $(( 16#${h:4:2} ))"; }
  # Rename the block to `chezmoi-system` (the name config.kdl loads), then substitute
  # each overridden token's "R G B" triple (KDL color values sit at end-of-line).
  typeset -a sed_args
  sed_args=(-e 's/chezmoi-system-base {/chezmoi-system {/')
  while IFS=$'\t' read -r tok hex; do
    [[ -n "$tok" ]] || continue
    chex=$(jq -r --arg t "$tok" '.palette[$t] // empty' "$canon_json")
    [[ -n "$chex" ]] || continue
    crgb="$(rgb "$chex")"
    ergb="$(rgb "$hex")"
    [[ "$crgb" == "$ergb" ]] && continue
    sed_args+=(-e "s/ ${crgb}\$/ ${ergb}/")
  done < <(print -r -- "$ov" | jq -r 'to_entries[] | "\(.key)\t\(.value)"' 2>/dev/null)
  sed "${sed_args[@]}" "$canon_kdl" >"$eff_kdl.tmp" && mv "$eff_kdl.tmp" "$eff_kdl" \
    || { rm -f "$eff_kdl.tmp"; cp "$canon_kdl" "$eff_kdl"; }
fi

bump_reload_nonce
print -r -- "$key" >"$stamp"
