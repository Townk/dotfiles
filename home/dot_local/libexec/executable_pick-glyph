#!/usr/bin/env zsh
# pick-glyph — fzf-based glyph picker for Nerd Fonts + Unicode symbols.
#
# Backed by the symbols database built by the custom Symbols Nerd Font
# pipeline at
#   ${XDG_DATA_HOME:-$HOME/.local/share}/fonts/nerd-font/symbols.db
# (see ~/.local/share/chezmoi/custom-builds/nerd-fonts/symbols-db/). Every
# row in that DB is a glyph the terminal can actually render (the build runs
# a renderability probe), so the picker never shows tofu. One fzf line is
# streamed per row straight out of SQLite — no jq, no assembled-lines cache.
#
# Each line shows:
#   <glyph>  U+XXXX  <name>   :shortcode: :extras: #tags @groups <desc> <kw>
# The trailing metadata after the name is dark-grey and exists mainly to be
# searched: the visible string is what fzf matches against (--with-nth=1), so
# typing a shortcode, a '#tag' (e.g. #emoji), an '@group' (@md/@fa/@usr), a
# keyword, or words from the description all narrow the list. The name column
# is fixed at 40 cells (long names truncate with '…') to keep things aligned.
#
# Output modes (each bound to a key via the pick::start API):
#   Enter / Ctrl-G   raw glyph                    e.g. ❤
#   Ctrl-N           the primary :shortcode: if the glyph has one, else its
#                    name                         e.g. :heart:
#   Ctrl-P           \u{HEX} escape sequence      e.g. \u{2764}
# The Alt- twins (Alt-Enter/G = glyph, Alt-N = shortcode, Alt-P = code-point)
# insert WITHOUT closing the picker: the value goes to the originating zellij
# pane when embedded (PICK_INJECT_PANE / PICK_INJECT_ZELLIJ, set by
# zellij-modal), otherwise to the system clipboard.
#
# Recently-picked glyphs float to the top: each pick stamps `last_used` in the
# DB and the query orders by it. --resume reopens with the previous query and
# cursor position restored.

set -eu -o pipefail

PICK_NAME=pick-glyph
PICK_LIB_DIR="${PICK_LIB_DIR:-$HOME/.local/lib}"
source "${PICK_SYMBOLS_LIB:-$PICK_LIB_DIR/pick-symbols-common.zsh}" ||
  {
    print -ru2 -- "pick-glyph: cannot source pick-symbols-common.zsh from $PICK_LIB_DIR"
    exit 1
  }

DB_FILE="${PICK_GLYPH_DB:-${XDG_DATA_HOME:-$HOME/.local/share}/fonts/nerd-font/symbols.db}"

usage() {
  cat <<EOF
Usage:
  pick-glyph [OPTIONS]

Interactively pick a Nerd Font / Unicode glyph via fzf and print it.

Inside the picker:
  Enter / Ctrl-G     output the raw glyph (default)
  Ctrl-N             output the primary name (or the :shortcode:)
  Ctrl-P             output \u{HEX} escape syntax
  Alt-Enter / Alt-G  insert the glyph WITHOUT closing the picker
  Alt-N / Alt-P      same, but insert the :shortcode: / code-point
                     (sink: the originating zellij pane when embedded,
                      else the system clipboard)
  Tab / Ctrl-A       (with --multi) mark / select-all

Recently-picked glyphs float to the top. Narrow the list by typing a
shortcode, a #tag (#emoji, #unicode, ...), an @group (@md, @fa, @usr, ...),
a keyword, or words from a glyph's description.

Options:
  -m, --multi      select multiple glyphs (concatenated on output)
  -c, --copy       copy the result to the clipboard instead of stdout
  -q, --query Q    seed fzf with an initial query string
      --resume     reopen with the previous query + cursor restored
      --no-border  suppress fzf's border (for embedding in a bordered pane)
      --db FILE    override the symbols.db path
  -h, --help       show this help

Examples:
  pick-glyph                  # interactive picker, print the glyph
  pick-glyph -c -q rocket     # find rocket icons, copy to clipboard
  pick-glyph -m -q '#fa'      # multi-select from Font Awesome
EOF
}

pick_symbols::parse_args "$@"
pick_symbols::require_db

# Geometry/UI is overridable by embedders (pick-glyph-zellij sets a tall
# height + side padding for its floating pane). The hint line shows the submit
# keys, the insert-and-stay (Alt) keys, and — only with --multi — the marking
# keys (so fzf never adds a second header row).
hints=$'󰘴 G: glyph  ·  󰘴 N: name  ·  󰘴 P: code-point  ·  󰘵 G/N/P: insert'
if ((multi)); then
  hints+=$'  ·  ⭾ : select  ·  󰘴 A: select-all'
fi

pick_args=(
  --header "Pick a glyph"
  --hints "$hints"
  --height "${PICK_GLYPH_HEIGHT:-35%}"
  --margin "${PICK_GLYPH_MARGIN:-0,0,0,0}"
  --padding "${PICK_GLYPH_PADDING:-1,1,1,1}"
  --input-border "${PICK_GLYPH_INPUT_BORDER:-1}"
  --output field:1            # Enter -> glyph
  --key-output ctrl-g:field:1 # Ctrl-G -> glyph
  --key-output ctrl-n:field:7 # Ctrl-N -> name or :shortcode:
  --key-output ctrl-p:field:3 # Ctrl-P -> \u{HEX}
  --key-background alt-enter:field:1
  --key-background alt-g:field:1
  --key-background alt-n:field:7
  --key-background alt-p:field:3
  --on-items-picked pick_symbols::record_recency
  --cache-state
)
if ((multi)); then pick_args+=(--multi=''); fi
if ((copy)); then pick_args+=(--copy-only); fi
if ((resume)); then pick_args+=(--resume); fi
if ((no_border)); then pick_args+=(--no-border); fi
if [[ -n "$query" ]]; then pick_args+=(--query "$query"); fi

# Stream straight off idx_symbols_recency. Visible columns are colour-coded;
# the hidden tail (after CHAR(31), fields split on CHAR(30)) carries clean,
# uncoloured OUTPUT values so ANSI never leaks into stdout:
#   1=glyph  2=name  3=\u{HEX}  4=tags  5=description  6=search-blob
#   7=:shortcode: (or name)
sqlite3 -escape off "$DB_FILE" "
  WITH palette AS (
    SELECT
      CHAR(27) || '[0m'                AS reset,
      CHAR(27) || '[38;2;255;255;255m' AS glyph_color,
      CHAR(27) || '[38;2;147;153;178m' AS text_color,
      CHAR(27) || '[38;2;137;180;250m' AS name_color,
      CHAR(27) || '[38;2;127;132;156m' AS meta_color
  )
  SELECT
      glyph_color || symbol || reset
      || IFNULL(printf('%*s', MAX(0, 2 - display_width), ''), '')
      || '  '
      || text_color || printf('%-8s', printf('U+%04X', code_point))
      || '  '
      || name_color
      || CASE WHEN length(name) > 40 THEN substr(name, 1, 39) || '…'
              ELSE printf('%-40s', name) END
      || reset
      || ' ' || meta_color
      || CASE WHEN shortcode <> '' THEN ' :' || shortcode || ':' ELSE '' END
      || CASE WHEN extra_shortcodes <> '' THEN
             ' :' || REPLACE(extra_shortcodes, ' ', ': :') || ':' ELSE '' END
      || CASE WHEN tags <> '' THEN ' #' || REPLACE(tags, ' ', ' #') ELSE '' END
      || CASE WHEN source_keys <> '' THEN ' @' || REPLACE(source_keys, ' ', ' @') ELSE '' END
      || CASE WHEN description <> '' THEN ' ' || description ELSE '' END
      || CASE WHEN keywords <> '' THEN ' ' || keywords ELSE '' END
      || reset
      || CHAR(31)
      || symbol || CHAR(30)
      || name || CHAR(30)
      || '\u{' || printf('%X', code_point) || '}' || CHAR(30)
      || tags || CHAR(30)
      || description || CHAR(30)
      || shortcode || ' ' || extra_shortcodes || ' ' || source_keys || ' ' || keywords || CHAR(30)
      || CASE WHEN shortcode <> '' THEN ':' || shortcode || ':' ELSE name END
  FROM symbols, palette
  ORDER BY last_used DESC, name ASC;
" | pick::start "${pick_args[@]}"
