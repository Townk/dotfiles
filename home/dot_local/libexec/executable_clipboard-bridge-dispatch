#!/usr/bin/env zsh
# clipboard-bridge-dispatch — the clipboard-bridge service's per-connection
# handler (Phase 5, universal-clipboard project spec §11). socat EXECs this
# once per accepted connection on 127.0.0.1:2489, with the connection's
# bytes wired to our stdin/stdout — see services.toml.tmpl.
#
# Backward compatible with the pre-Phase-5 bridge: the OLD client (`pbpaste`
# / universal.lua's paste(), both doing a bare `nc -U -w1 <socket>` with NO
# input) just connects and waits for pbpaste's output. If nothing arrives
# within LEGACY_GRACE_S, we assume that's what's happening and fall back to
# dumping pbpaste immediately, unframed — exactly the old behavior. A
# well-behaved new-protocol client sends its opcode byte the instant it
# connects, so a real timeout is a reliable signal of "old client", not a
# slow new one.
#
# Wire protocol (new clients only, all multi-byte integers big-endian):
#   request:  <1 byte opcode><4 bytes length N><N bytes payload>
#   response: <1 byte status: 'O' ok | 'E' error><4 bytes length N><N bytes payload>
#
# Opcodes:
#   G  get            req: empty                    resp: clipboard text
#   R  get-regtype    req: empty                     resp: 1 byte v|l|b
#   W  window action  req: <action>[ <arg>]          resp: empty | state | error
#      Acts on the TERMINAL WINDOW on this machine for a session running at
#      the far end of the tunnel: `fullscreen-toggle <ghostty|wezterm>` and
#      `fullscreen-state` (true|false|empty). The bridge is already the wire
#      between a remote mux and the machine its terminal lives on; fullscreen
#      used to be refused over SSH, which described the plumbing rather than
#      what was possible. See clip::op_window_action.
#   H  get-host       req: empty                     resp: this machine's hostname
#      Lets a consumer stamp the origin of the clip it just read from here, so
#      it can materialize a self-contained copy with correct provenance (§11).
#   T  set (copy)     req: <1 byte regtype><text>    resp: empty
#      Sets the real pbcopy clipboard AND records {regtype, sha256(text)} so
#      a later R reflects it — until something else changes the clipboard,
#      which self-invalidates via the hash compare (see clip::get_regtype).
#      Used by universal.lua's copy() instead of OSC 52 when bridge-up (no
#      OSC52-vs-bridge race: this is the only path that sets the clipboard).
#   P  persist        req: source_host US kind US app US regtype RS text
#      Materialize a used peer clip into THIS machine's store (§11). Sent to the
#      LOCAL bridge by the nvim provider on paste-over-tunnel. resp: empty | err.
#   C  copy (rich)    req: <2 bytes uti_len><uti><blob>  resp: empty | error text
#   F  fetch-file     req: absolute path (UTF-8)     resp: file bytes | error text
#      Handed a directory instead of a file, replies the EXACT error text
#      "is-directory" (M3) -- a remote pbpaste greps for that string to know
#      to retry the same path as an A archive-stream. See clip::op_fetch_file.
#   A  archive-stream req: absolute directory path (UTF-8)
#                     resp: BE64 byte-count header + raw tar stream | err
#      F's directory sibling (M3, files-yazi design §4): replies `O` + BE32
#      len=8 + a BE64 total-byte-count -- a `du`-based size ESTIMATE for
#      progress display only, NO directional guarantee -- then the raw
#      `tar -cf -` stream of the directory until EOF: no trailing frame,
#      the client just reads until the peer closes. Unreadable entries are
#      rejected up front with an E frame; see clip::op_archive_stream for
#      the full size/error semantics.
#   O  declare-origin req: source_host US text        resp: empty | err
#      Records that the NEXT pasteboard change hashing to sha256(text) was
#      really copied on source_host (§23) -- sent by a machine SSH'd into the
#      peer just before it sets the peer clipboard. See clip::op_declare_origin.
#   U  set-file-urls req: <path NUL path ...> | "id:<rowid>"  resp: empty | err
#      Puts a real file clip on THIS Mac's pasteboard (files-yazi design §4):
#      form A writes NSFilenamesPboardType (all paths) + public.file-url
#      (first path) via hs.pasteboard.writeAllData; form B does a full-
#      fidelity restore of a stored clip by rowid. The watcher then captures
#      the new pasteboard state -- same full-circle design as pbcopy's O/P
#      frames. Callers: pbcopy (files-yazi T3), pick-clipboard (T9).
#   L  list-files    req: empty  resp: <type_kind US source_host US last_ts
#                                        US path NUL path ...> | err
#      Returns the manifest of the CURRENT clipboard entry, resolved through
#      the store's latest row (files-yazi design §4) -- no payload in, no
#      pasteboard access, this is a pure store query. "not-files" if the
#      latest row isn't kind files/file/directory (retried once after a
#      brief sleep to ride out the watcher's ~0.5s capture lag); "empty-store"
#      if there are no rows at all. Callers: pbpaste --manifest (files-yazi
#      T4), the yazi smart-paste plugin (T8).
#   S  get-current-ts req: empty  resp: decimal last_ts, or empty
#      The CURRENT clipboard's copy-time, so a consumer surfacing a peer's live
#      clipboard as a synthetic row can sort it chronologically instead of
#      always pinning it to the top (X9, pick-clipboard's live-peer row, §22).
#      Resolved by TEXT-CONTENT match against the store (the picker's own §22.5
#      dedup query), so it matches HS-watcher-captured rows too -- NOT by hash.
#      See clip::op_get_ts for the exact fallback chain.
#   M  manifest-persist-local (X2-redo; Fix A retired N below in favor of a
#      second use of this same op) req: source_host US path NUL path ...
#      resp: empty | err
#      Record-only: writes ONLY the `files` store row (via
#      clip::persist_files_manifest_row), no pasteboard write and no
#      declare-origin. Originally added because pbcopy over SSH used to
#      persist the SSH'd-into machine's own origin clip via a plain `U`
#      (relying on the Hammerspoon watcher to capture the pasteboard write
#      into the store) -- but that machine is typically locked/headless when
#      reached over SSH, and the watcher's loginwindow guard skips ALL
#      capture in that state (live-confirmed: `U` set the pasteboard but no
#      store row ever appeared). `M` bypasses the watcher entirely, mirroring
#      how `P` (persist, plain text) already bypasses it for the identical
#      reason. Fix A: pbcopy's SSH files branch now ALSO sends this same op
#      (same payload) to the reverse-tunneled peer bridge instead of the
#      retired `N` op (see below) -- files are lazy (§12), so the peer must
#      only get a record of the manifest, never a pasteboard write. Callers:
#      pbcopy (files-yazi X2-redo, SSH files branch, both the local AND
#      peer halves as of Fix A).
#
#   N  push-manifest -- RETIRED (Fix A). Used to be the cross-machine sibling
#      of U (files-yazi design §5, T11): declared origin + set the PEER's
#      pasteboard to the newline-joined paths as plain TEXT, on top of
#      inserting the `files` manifest row. That pasteboard write was the bug
#      Fix A exists to fix: it got reflected back up through the peer's live
#      clipboard and showed up as a confusing "remote text" twin of the same
#      clip on the origin's own TUI picker. pbcopy's SSH files branch was the
#      only caller (grepped repo-wide) and now sends `M` (record-only, see
#      above) to both ports instead, so the opcode itself has been removed
#      from the dispatch table below. clip::declare_origin_core's optional
#      suppress-echo 3rd arg (only ever passed by this retired op) and
#      clipboard-history.lua's matching consumption of it are left in place,
#      unused but harmless -- see the comment on declare_origin_core.
#
# Rich payload writes (C) go through hs.pasteboard.writeAllData via a
# throwaway generated Lua script run as `hs <file>` (NOT `hs -c`, which hangs
# on this box — confirmed empirically; see the comment above clip::hs_run).
# Deliberately does NOT call into the running apps.clipboard-history module
# via `hs -c`/`hs <file>` for its own state (its `db` upvalue was observed
# nil from a fresh `hs <file>` invocation despite `package.loaded` already
# holding the module — likely a stale/duplicate instance from Hammerspoon's
# selective hot-reload; unconfirmed root cause, not this script's bug to
# fix). Instead this script talks to the SQLite store directly (same
# technique pick-clipboard already uses) and only uses `hs.pasteboard.*`
# core APIs (verified reliable) for the actual pasteboard write.

set -u

# Core library: framing + store ops + portable helpers (Phase 7 spec §2).
# ${0:A:h}/../lib resolves correctly in BOTH layouts: the repo checkout
# (home/dot_local/libexec -> home/dot_local/lib, which shellspec runs
# against) and the installed target (~/.local/libexec -> ~/.local/lib).
LIB_DIR="${CLIPBOARD_LIB_DIR:-${0:A:h}/../lib}"
source "$LIB_DIR/clipboard-store-core.zsh"

# --init-store: run just the schema bootstrap and exit (validation + tests;
# spec §3). Accepted on every platform -- the DDL is the same everywhere.
if [[ "${1:-}" == --init-store ]]; then
  clip::ensure_schema
  exit $?
fi

# Platform backend (spec §2): Darwin -> pasteboard/hs; anything else -> the
# store-as-pasteboard headless backend. CLIPBOARD_PLATFORM overrides for
# tests (value 'linux-headless' forces the Linux backend on a Mac).
case "${CLIPBOARD_PLATFORM:-$(uname -s)}" in
  (Darwin|macos) source "$LIB_DIR/clipboard-platform-macos.zsh" ;;
  (*)            source "$LIB_DIR/clipboard-platform-linux-headless.zsh" ;;
esac
pb::init

# --- connection handler ----------------------------------------------------

read_n 1 "$LEGACY_GRACE_S"
if [[ "$REPLY_STATUS" != "ok" ]]; then
  # Legacy bare-connect client (or a truly empty probe) -- old behavior.
  pb::legacy_dump
fi
opcode=$REPLY

read_n 4 "$READ_TIMEOUT_S"
if [[ "$REPLY_STATUS" != "ok" ]]; then
  exit 0
fi
length=$(be32_to_int "$REPLY")

payload=""
if (( length > 0 )); then
  read_n "$length" "$READ_TIMEOUT_S"
  if [[ "$REPLY_STATUS" != "ok" ]]; then
    exit 0
  fi
  payload=$REPLY
fi

case "$opcode" in
  G) clip::op_get ;;
  S) clip::op_get_ts ;;
  R) clip::op_get_regtype ;;
  H) clip::op_get_host ;;
  T) clip::op_set "$payload" ;;
  P) clip::op_persist "$payload" ;;
  O) clip::op_declare_origin "$payload" ;;
  C) clip::op_copy "$payload" ;;
  F) clip::op_fetch_file "$payload" ;;
  A) clip::op_archive_stream "$payload" ;;
  U) clip::op_set_file_urls "$payload" ;;
  L) clip::op_list_files ;;
  M) clip::op_manifest_persist_local "$payload" ;;
  W) clip::op_window_action "$payload" ;;
  *) send_err "unknown opcode" ;;
esac
