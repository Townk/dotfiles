#compdef system-onboard
#
# Completion for system-onboard. All inputs are flags (a bare run on a TTY
# starts an interactive form). --local self-onboards this machine and has no
# SSH, so it's incompatible with --hostname; the exclusion lists encode that.
# --alias / --hostname take free (loose, never-committed) values, so no live
# candidates are offered beyond _hosts for the SSH endpoint.

_system-onboard() {
  _arguments -s \
    '(- *)'{-h,--help}'[show help and exit]' \
    '(--local)--hostname[real SSH endpoint (loose only; never committed)]:hostname:_hosts' \
    '--alias[SSH alias, or (with --local) the operator-map key]:alias:' \
    '--profile[machine profile]:profile:(personal work dev-shell)' \
    '(--local)--kind[slot kind]:kind:(human headless)' \
    '--color[WezTerm window tint (palette name; operator map, loose)]:color:(cyan blue amber teal purple grey)' \
    '(--hostname --kind)--local[self-onboard THIS machine (human only; no SSH)]' \
    '--rotate-secrets[re-collect this slot'\''s secrets even if its fragment exists]' \
    '--no-apply[(with --local) set the slot but skip the final chezmoi apply]' \
    '--no-commit[do everything except git commit/push]' \
    '--no-push[commit but do not push]' \
    '--dry-run[print the plan; make no local or remote changes]'
}

_system-onboard "$@"
