#compdef ai-commit
#
# Completion for ai-commit, the harness dispatcher. The first positional may
# name a harness ({{ if eq .profile "work" }}pi, claude, cursor{{ else }}pi, claude{{ end }}); every remaining word is forwarded verbatim to
# the matching `ai-commit-<harness>` worker, so once a harness is chosen we
# defer to that worker's own completion (autoloaded by name). Running bare
# auto-picks the sole installed harness (or fzf-picks among several).
#
# Off the work profile the cursor harness is not deployed (see
# .chezmoiignore.tmpl), so this completion omits it — the offered harnesses
# always match the `ai-commit-*` workers actually present on disk.

_ai-commit() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '(- *)'{-h,--help}'[show help and exit]' \
    '1: :->harness' \
    '*:: :->rest'

  case "$state" in
    harness)
      _values 'harness' \
        'pi[plan commits via pi-coding-agent]' \
        'claude[plan commits via Claude Code]'{{ if eq .profile "work" }} \
        'cursor[plan commits via Cursor Agent]'{{ end }}
      ;;
    rest)
      case "$words[1]" in
        pi)     _ai-commit-pi ;;
        claude) _ai-commit-claude ;;
{{- if eq .profile "work" }}
        cursor) _ai-commit-cursor ;;
{{- end }}
      esac
      ;;
  esac
}

_ai-commit "$@"
