#compdef system-update
#
# Completion for the interactive system-update wrapper. Running it bare kicks
# off the full update pass, then the wrapper refreshes the parent shell. The
# --keep-shell modifier belongs to the wrapper and suppresses that refresh; the
# underlying script only sees the update/help args.

_arguments \
  '(- *)'{-h,--help}'[show help and exit]' \
  '(-h --help)--keep-shell[skip the closing exec zsh (for automated scripts)]'
