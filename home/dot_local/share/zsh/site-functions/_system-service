#compdef system-service
#
# Completion for system-service, the unified manifest + brew services
# dispatcher. Service-name completions are sourced LIVE from the workers
# (cheap: each manifest side is a TOML key read; the brew side is
# `brew services list --json`, which the user has already paid for if
# they're shelling here).

# __system-service-all-names — combined manifest + brew service name list.
# Used by start/stop/restart/info, where either source is a valid target.
__system-service-all-names() {
  local -a manifest brew names
  manifest=( ${(f)"$(system-service-launchd declared 2>/dev/null)"}
             ${(f)"$(system-service-systemd declared 2>/dev/null)"} )
  brew=(    ${(f)"$(system-service-brew    names    2>/dev/null)"} )
  names=( $manifest $brew )
  (( ${#names} )) && _describe -t services 'service' names
}

_system-service() {
  local context state state_descr line
  typeset -A opt_args

  local -a help_flag
  help_flag=(
    '(- *)'{-h,--help}'[show help and exit]'
  )

  _arguments -C \
    $help_flag \
    '1: :->cmd' \
    '*:: :->cmdargs'

  case "$state" in
    cmd)
      _values 'subcommand' \
        'list[aggregate manifest + brew services into one table]' \
        'start[start a service]' \
        'stop[stop a service]' \
        'restart[restart a service]' \
        'info[show resolved manifest + launchctl/systemctl/brew detail]' \
        'sync[reconcile manifest-declared services with services.toml]' \
        'restart-for[internal: restart services tied to a package]' \
        'help[show help]'
      ;;
    cmdargs)
      case "$words[1]" in
        start|stop|restart|info)
          # Per-subcommand --help short-circuits in the script BEFORE the
          # name is looked up, so we offer the help flag alongside names.
          _arguments $help_flag \
            ':service:__system-service-all-names'
          ;;
        restart-for)
          # restart-for matches by service-name OR cmd[0] basename; surfacing
          # known service names covers the common case (e.g. omlx tool → omlx
          # service). Accepts multiple positionals.
          _arguments $help_flag \
            '*:package:__system-service-all-names'
          ;;
        list|sync)
          _arguments $help_flag
          ;;
      esac
      ;;
  esac
}

_system-service "$@"
