#compdef system-secrets
#
# Completion for system-secrets, the secrets-manifest + per-slot manager.
# Secret NAMEs and opaque slot ids are deliberately NOT offered as live
# candidates: NAMEs live in the (committed) manifest while slot ids live only
# in the loose operator map, and surfacing either from completion would couple
# this file to those paths. Structure mirrors the dispatch in
# dot_local/bin/executable_system-secrets.

_system-secrets() {
  local context state state_descr line
  typeset -A opt_args

  local -a help_flag
  help_flag=(
    '(- *)'{-h,--help}'[show help and exit]'
  )

  _arguments -C \
    $help_flag \
    '1: :->cmd' \
    '*:: :->cmdargs'

  case "$state" in
    cmd)
      _values 'subcommand' \
        'list[show manifest + known slots]' \
        'add[declare (if new) + set a secret on this machine]' \
        'rotate[re-collect a secret (default: this machine) or rebuild a slot]' \
        'help[show help]'
      ;;
    cmdargs)
      case "$words[1]" in
        add)
          _arguments $help_flag \
            ':secret name (UPPER_SNAKE_CASE):'
          ;;
        rotate)
          _arguments $help_flag \
            '(--all)--slot[target a specific opaque slot]:slot:' \
            '(--slot)--all[fan out to every managed slot that needs the secret]' \
            ':secret name:'
          ;;
        list)
          _arguments $help_flag
          ;;
      esac
      ;;
  esac
}

_system-secrets "$@"
