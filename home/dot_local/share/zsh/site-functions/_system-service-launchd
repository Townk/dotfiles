#compdef system-service-launchd
#
# Completion for system-service-launchd. Most callers go through the
# top-level `system-service` dispatcher, but the worker is a useful direct
# target for debugging (`render <name>` to inspect generated plist XML, etc.).

__system-service-launchd-names() {
  local -a names
  names=( ${(f)"$(system-service-launchd declared 2>/dev/null)"} )
  (( ${#names} )) && _describe -t services 'launchd service' names
}

_system-service-launchd() {
  local context state state_descr line
  typeset -A opt_args

  _arguments -C \
    '1: :->cmd' \
    '*:: :->cmdargs'

  case "$state" in
    cmd)
      _values 'subcommand' \
        'list[show declared launchd services]' \
        'start[bootstrap a service]' \
        'stop[bootout a service]' \
        'restart[stop + start]' \
        'info[show plist + launchctl detail]' \
        'sync[reconcile plists with services.toml]' \
        'render[emit plist XML on stdout]' \
        'declared[print declared service names]' \
        'matching[print services whose key or cmd-zero basename matches a pkg]' \
        'status[print normalized status (running/stopped/error/none)]'
      ;;
    cmdargs)
      case "$words[1]" in
        start|stop|restart|info|render|status)
          _arguments ':service:__system-service-launchd-names'
          ;;
        # `matching <pkg>` takes an arbitrary package name (binary basename or
        # service key) — no completion source.
        # `list|sync|declared` take no positional args.
      esac
      ;;
  esac
}

_system-service-launchd "$@"
