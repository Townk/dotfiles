#!/usr/bin/env bash
# pick-glyph-build-suppl — generate the Unicode names supplement for pick-glyph.
#
# The Symbols Nerd Font that backs the picker only ships codepoints
# that are actually drawn into its cmap. Box Drawing (U+2500–U+257F),
# IPA, Mathematical Operators, Geometric Shapes, Currency, etc. all
# live in other fonts on the user's system and are absent from
# glyphs.json. This script enumerates everything that Python's
# `unicodedata.name()` knows about (BMP + the symbols-heavy planes
# in the SMP) so the picker can offer them too.
#
# Output schema (compatible with the primary glyphs.json):
#
#   {
#     "schema_version": 1,
#     "version":        <SUPPL_VERSION>,
#     "generated_at":   "YYYY-MM-DDTHH:MM:SS+00:00",
#     "python":         "3.x.y",
#     "unicodedata":    "<version>",
#     "glyphs": {
#       "u-2500": { "char": "─", "code": "2500",
#                   "source": "unicode-stdlib", "width": 1,
#                   "unicode_name": "BOX DRAWINGS LIGHT HORIZONTAL" },
#       ...
#     }
#   }
#
# `width` is the terminal cell-advance (0/1/2) derived from
# unicodedata (combining marks → 0, East-Asian Wide/Fullwidth → 2,
# else 1). pick-glyph uses it to pad the glyph column so the name
# column starts at a fixed x across rows. It's an approximation of
# wcwidth — emoji that need VS16 to widen still report their bare
# (1-cell) advance, matching what the picker actually renders since
# it shows the un-suffixed codepoint.
#
# Excludes the algorithmic blocks (CJK Unified, Hangul Syllables,
# Tangut, Egyptian Hieroglyphs, etc.) — they'd dominate the picker
# with hundreds of thousands of one-off names without adding value
# for symbol selection. If you ever want them, drop the entry from
# SKIP_PREFIXES and bump SUPPL_VERSION.
#
# Renderability filter (macOS): `unicodedata.name()` knows tens of
# thousands of codepoints, but the terminal can only DRAW the ones some
# installed font covers — the rest show up as tofu (a notdef box) and
# are useless to pick. On macOS we ask CoreText (via a tiny embedded
# `swift` probe) the same question the terminal does — "following the
# system font cascade, does any real font claim this codepoint, or do
# we land on the LastResort font?" — and drop the ones that don't. This
# is scoped to the standard-Unicode supplement ONLY; the curated Nerd
# Font icons live in the Private Use Area and are rendered by Symbols
# Nerd Font explicitly, which the default cascade wouldn't find, so
# they must never go through this probe. Off automatically when not on
# macOS or `swift` is absent (keeps every entry), or via
# --no-render-filter. The result is recorded in the output's
# `render_filter` field.
#
# Usage:
#   pick-glyph-build-suppl [--force] [--no-render-filter] [OUT_PATH]
#
# Default OUT_PATH is "$XDG_CACHE_HOME/pick-glyph/unicode-suppl.json"
# (falling back to ~/.cache/pick-glyph/unicode-suppl.json). The cache
# is skipped (no work) when the existing file's `.version` matches
# SUPPL_VERSION, unless --force is passed.

set -euo pipefail

SUPPL_VERSION=3

default_out="${XDG_CACHE_HOME:-$HOME/.cache}/pick-glyph/unicode-suppl.json"
force=0
render_filter=1
out=""

while (( $# > 0 )); do
  case "$1" in
    -f|--force) force=1; shift ;;
    --no-render-filter) render_filter=0; shift ;;
    -h|--help)
      sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    --) shift; break ;;
    -*) echo "pick-glyph-build-suppl: unknown flag: $1" >&2; exit 2 ;;
    *)
      if [[ -z "$out" ]]; then
        out="$1"
      else
        echo "pick-glyph-build-suppl: too many positional args" >&2
        exit 2
      fi
      shift
      ;;
  esac
done

out="${out:-$default_out}"

command -v python3 >/dev/null 2>&1 \
  || { echo "pick-glyph-build-suppl: python3 not found in PATH" >&2; exit 1; }

# Skip work when the existing cache already matches SUPPL_VERSION,
# unless the caller forced a rebuild.
if (( ! force )) && [[ -s "$out" ]]; then
  cached=$(python3 - "$out" <<'PY' 2>/dev/null || true
import json, sys
try:
    with open(sys.argv[1], "r", encoding="utf-8") as f:
        d = json.load(f)
    print(d.get("version", 0))
except Exception:
    print(0)
PY
  )
  if [[ "$cached" == "$SUPPL_VERSION" ]]; then
    exit 0
  fi
fi

mkdir -p -- "$(dirname -- "$out")"

# All the real work lives in the embedded Python — `unicodedata.name`
# is the source of truth and a Python heredoc keeps the data and the
# rendering side-by-side.
python3 - "$SUPPL_VERSION" "$out" "$render_filter" <<'PY'
import json
import os
import platform
import shutil
import subprocess
import sys
import tempfile
import unicodedata
from datetime import datetime, timezone

version = int(sys.argv[1])
out_path = sys.argv[2]
render_filter = sys.argv[3] != "0"

# Algorithmic-name blocks: huge ranges (CJK Unified is ~98k entries
# alone) where the "name" is just the block name plus the codepoint.
# They'd swamp the picker without aiding navigation. Suppressing them
# here cuts the supplement from ~150k entries to ~25k.
SKIP_PREFIXES = (
    "CJK UNIFIED IDEOGRAPH-",
    "CJK COMPATIBILITY IDEOGRAPH-",
    "HANGUL SYLLABLE ",
    "TANGUT IDEOGRAPH-",
    "TANGUT COMPONENT-",
    "KHITAN SMALL SCRIPT CHARACTER-",
    "NUSHU CHARACTER-",
    "EGYPTIAN HIEROGLYPH ",
    "ANATOLIAN HIEROGLYPH ",
    "VARIATION SELECTOR-",
)

# Terminal cell advance for a single character, used by pick-glyph to
# pad the glyph column. A pragmatic wcwidth: zero-width for combining
# marks / format controls, 2 for East-Asian Wide & Fullwidth, else 1.
# Not perfect for VS16 emoji (we never emit the selector, so the bare
# codepoint's advance is what the picker renders), but good enough to
# keep the columns aligned for the overwhelming 1-cell majority.
def cell_width(ch):
    if unicodedata.combining(ch):
        return 0
    if unicodedata.category(ch) in ("Mn", "Me", "Cf"):
        return 0
    if unicodedata.east_asian_width(ch) in ("W", "F"):
        return 2
    return 1

# CoreText renderability probe (macOS). Reads hex codepoints on stdin,
# echoes back only the ones a real font claims when following the
# system cascade from a base monospace (Menlo). A codepoint that even
# the system fallback can't satisfy lands on the "LastResort" font —
# that's exactly the tofu box the terminal would draw, so we drop it.
SWIFT_PROBE = r'''
import CoreText
import Foundation

let base = CTFontCreateWithName("Menlo" as CFString, 13.0, nil)

func renderable(_ cp: Int) -> Bool {
    guard let scalar = Unicode.Scalar(cp) else { return false }
    let s = String(scalar) as NSString
    let chosen = CTFontCreateForString(base, s, CFRangeMake(0, s.length))
    return (CTFontCopyPostScriptName(chosen) as String) != "LastResort"
}

while let line = readLine() {
    let t = line.trimmingCharacters(in: .whitespaces)
    if let cp = Int(t, radix: 16), renderable(cp) { print(t) }
}
'''


def coretext_renderable(codes):
    """Return the subset of `codes` (lowercase hex strings) the terminal
    can actually draw, or None if the probe could not run."""
    fd, swift_path = tempfile.mkstemp(suffix=".swift")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(SWIFT_PROBE)
        proc = subprocess.run(
            ["swift", swift_path],
            input="\n".join(codes),
            capture_output=True,
            text=True,
            timeout=300,
        )
        if proc.returncode != 0:
            sys.stderr.write(proc.stderr)
            return None
        return {ln.strip() for ln in proc.stdout.splitlines() if ln.strip()}
    finally:
        try:
            os.unlink(swift_path)
        except OSError:
            pass


# Walk every assigned codepoint up to U+30000 (covers BMP + the
# symbols-heavy SMP planes: emoji, mahjong, dominoes, playing cards,
# pictographs, math alphanumerics, etc.). Past U+30000 it's almost
# all CJK Ext-G/H/I and Tangut, which we'd be skipping anyway.
glyphs = {}
for cp in range(0x20, 0x30000):
    ch = chr(cp)
    try:
        name = unicodedata.name(ch)
    except ValueError:
        continue
    if name.startswith(SKIP_PREFIXES):
        continue
    glyphs["u-{:04x}".format(cp)] = {
        "code": format(cp, "04x"),
        "char": ch,
        "source": "unicode-stdlib",
        "width": cell_width(ch),
        "unicode_name": name,
    }

# Drop codepoints the terminal can't render. macOS-only (CoreText); a
# no-op everywhere else so other platforms keep the full list. Any
# failure (swift errors, timeout) is non-fatal — we keep every entry
# and record why in `render_filter`.
if not render_filter:
    filter_mode = "disabled"
elif platform.system() != "Darwin" or not shutil.which("swift"):
    filter_mode = "unavailable"
else:
    before = len(glyphs)
    keep = coretext_renderable([v["code"] for v in glyphs.values()])
    if keep is None:
        filter_mode = "error"
        sys.stderr.write(
            "pick-glyph-build-suppl: render probe failed; keeping all entries\n"
        )
    else:
        glyphs = {k: v for k, v in glyphs.items() if v["code"] in keep}
        filter_mode = "coretext"
        sys.stderr.write(
            "pick-glyph-build-suppl: dropped {} unrenderable codepoints "
            "({} -> {})\n".format(before - len(glyphs), before, len(glyphs))
        )

data = {
    "schema_version": 1,
    "version": version,
    "generated_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
    "python": sys.version.split()[0],
    "unicodedata": unicodedata.unidata_version,
    "render_filter": filter_mode,
    "count": len(glyphs),
    "glyphs": glyphs,
}

# Atomic write — never leave a half-written cache file in place if
# the python crashes mid-dump (e.g. disk full).
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(out_path), prefix=".suppl.")
try:
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False)
    os.replace(tmp, out_path)
except Exception:
    try: os.unlink(tmp)
    except OSError: pass
    raise

print(f"pick-glyph-build-suppl: wrote {len(glyphs)} entries to {out_path}", file=sys.stderr)
PY
