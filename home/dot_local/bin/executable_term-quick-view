#!/usr/bin/env zsh
#
# term-quick-view [--render] <path> — a single-file quick look in the terminal.
#
# Two modes:
#   (default)  open the "Quick View" tab and render <path> in it. One tab at a
#              time: a second call reuses the one already open (mux::new_tab
#              --singleton on tmux) rather than stacking tabs. Outside a mux
#              it renders inline, right here.
#   --render   BE the viewer: paint the chrome and the file into THIS pane and
#              wait for a key. The launcher re-execs itself this way inside the
#              tab; nothing else should need it.
#
# Images render through chafa; everything else through `preview`. Consumers:
# WezTerm's CMD+click (mux-open), fzf-tab's Ctrl+O, and yazi's Ctrl+Space when
# Quick Look cannot reach the screen (SSH, non-macOS).

emulate -L zsh
set -u

# _tqv_humanize_size BYTES -> a human size on stdout (empty for a non-number).
# >=1 MiB is rendered in tenths of a MiB ("1.0MB", "2.1MB"); below that, KiB
# rounded up. The tenths are computed directly as bytes * 10 / 1MiB, so an exact
# 1 MiB reads "1.0MB" — the old `bytes / 104858` split reported exact-MiB files
# a tenth low and rendered 1 MiB as ".9MB".
_tqv_humanize_size() {
  local _bytes="$1" _hsize
  if [[ "$_bytes" == <-> ]] && (( _bytes >= 1048576 )); then
    _hsize="$(( _bytes * 10 / 1048576 ))"
    printf '%s.%sMB\n' "${_hsize%?}" "${_hsize: -1}"
  elif [[ "$_bytes" == <-> ]]; then
    printf '%sKB\n' "$(( (_bytes + 1023) / 1024 ))"
  fi
}

# Sourcing seam: the spec loads this file with TERM_QUICK_VIEW_LIB set to pull
# in the helpers above without running the viewer. `return` works only in a
# sourced file, so the guard variable (set by the test alone) keeps normal
# execution from ever reaching it.
[[ -n "${TERM_QUICK_VIEW_LIB:-}" ]] && return 0

TERM_QUICK_VIEW_NAME="${TERM_QUICK_VIEW_NAME:-Quick View}"

_mode=view
[[ "${1:-}" == --render ]] && { _mode=render; shift }
# NB: not `path` — in zsh that is the array tied to $PATH.
file="${1:-}"
[[ -n "$file" && -e "$file" ]] || exit 0
file="${file:A}"

export PATH="${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

if [[ "$_mode" == view ]]; then
  source "${MUX_LIB:-$HOME/.local/lib}/mux.zsh"
  _self="${0:A}"
  if mux::available; then
    # A TAB on BOTH backends. The zellij float predates this viewer; a full
    # tab reads better for a picture and — more to the point — keeps one
    # implementation instead of two. The NAME is the singleton's identity: it
    # must match what the renderer names the tab, or a second call opens a
    # second one.
    # --session only when a caller handed us one. Inside a pane $ZELLIJ/$TMUX
    # answer for themselves; from WezTerm's GUI (mux-open) there is no session
    # in the environment at all, and zellij refuses an untargeted new-tab.
    local -a _sess=()
    [[ -n "${MUX_SESSION:-}" ]] && _sess=(--session "$MUX_SESSION")
    mux::new_tab "${_sess[@]}" --name "$TERM_QUICK_VIEW_NAME" --singleton \
      -- "$_self" --render "$file"
    exit $?
  fi
  # No mux: render inline in the caller's terminal.
  exec "$_self" --render "$file"
fi

# A sixel image is ONE DCS string and tmux discards any string sequence
# larger than its `input-buffer-size` (a SERVER option, default 1 MiB —
# measured: 1,032,961 bytes rendered, 1,174,685 did not). Our tmux.conf
# raises it, so ASK the server rather than hard-coding: the shrink below is
# then a safety net for a machine whose config has not been applied, not a
# quality ceiling. 5% margin covers the clear/cursor bytes around it.
#
# The cap is TMUX'S, and only tmux's. Zellij has no equivalent DCS limit, so
# applying one there is pure loss: a 2.2MB stream got shrunk to 70% and the
# picture came out visibly small inside a correctly-sized frame (zellij pass,
# 2026-07-27 — the debug log said `SHRINKING: 2285652 > 1000000` while
# `pane=` and `box=` were both right, which is what separated this from the
# sizing bug it looked like). 0 means no ceiling.
_max="${TERM_QUICK_VIEW_MAX_BYTES:-}"
if [[ -z "$_max" ]]; then
  _max=0
  if [[ -n "${TMUX:-}" ]]; then
    _max=1000000
    _lim="$(tmux show -sv input-buffer-size 2>/dev/null)"
    [[ "$_lim" == <-> ]] && (( _lim > 1000 )) && _max=$(( _lim * 95 / 100 ))
  fi
fi

# Graphics protocol. Left to chafa's auto-detection everywhere EXCEPT Ghostty,
# which does not support sixel and never will — that is a stated decision by
# its maintainer, not a gap waiting to be filled. Its Kitty graphics support
# is excellent, so ask for that explicitly; auto-detection through tmux lands
# on sixel (tmux advertises it) and Ghostty renders nothing at all.
#
# The outer terminal, not $TERM: inside a pane $TERM is tmux's own
# (tmux-256color), which says nothing about what will finally draw the pixels.
# tmux knows the attached client's terminal as #{client_termname}.
#
# --passthrough tmux wraps the APC payload so the server forwards it instead
# of eating it; tmux.conf already sets `allow-passthrough on`, which is the
# other half of that. Outside tmux there is nothing to pass through.
#
# TERM_QUICK_VIEW_ARGS stays a caller override — only defaulted when unset.
if [[ -z "${TERM_QUICK_VIEW_ARGS:-}" ]]; then
  _outer="${TERM:-}"
  [[ -n "${TMUX:-}" ]] && _outer="$(tmux display -p '#{client_termname}' 2>/dev/null)"
  if [[ "$_outer" == *ghostty* ]]; then
    if [[ -n "${TMUX:-}" ]]; then
      # Chafa added tmux passthrough in 1.14. A stale system Chafa must not
      # turn an otherwise usable preview into a blank pane.
      if chafa --help 2>&1 | command grep -q -- '--passthrough'; then
        TERM_QUICK_VIEW_ARGS="-f kitty --passthrough tmux"
      else
        TERM_QUICK_VIEW_ARGS="-f symbols"
      fi
    else
      TERM_QUICK_VIEW_ARGS="-f kitty"
    fi
  fi
fi
# Name the tab and give it its own glyph. The window pill prefixes a
# manually-named window with a generic tab icon, so the glyph goes in
# @win_icon (which the theme's win_body prefers) rather than into the name —
# otherwise the status bar shows two.
if [[ -n "${TMUX:-}" ]]; then
  tmux rename-window "$TERM_QUICK_VIEW_NAME" 2>/dev/null || :
  tmux set -w @win_icon "󰛐" 2>/dev/null || :
elif [[ -n "${ZELLIJ:-}" ]]; then
  # zellij has no per-tab icon option, so the glyph rides in the tab name.
  zellij action rename-tab "󰛐 $TERM_QUICK_VIEW_NAME" 2>/dev/null || :
fi

_out=$(mktemp "${TMPDIR:-/tmp}/quickview.XXXXXX") || exit 1
trap 'rm -f -- "$_out"' EXIT INT TERM HUP

# Breathing room: BOUND the image, then let chafa centre it in the real
# terminal. The padding is the remainder, symmetric by construction.
#
# Neither of the obvious alternatives works. chafa's --margin-* reserve the
# RIGHT and BOTTOM only. And printing our own left padding before handing
# over is cancelled the moment chafa centres vertically: it does that with
# NEWLINES, and every newline resets the column to 1 — which is why a
# width-constrained image (nothing to centre horizontally) came out flush
# left while square ones looked fine (Mode B 2026-07-26).
#
# --view-size is deliberately absent too: it made chafa centre inside a box
# that was not the pane, so the picture sat off-centre AND smaller.
_padx="${TERM_QUICK_VIEW_PAD_X:-6}"
_pady="${TERM_QUICK_VIEW_PAD_Y:-2}"
# Ask TMUX for the pane size, not the tty. In a window created by mux-open —
# spawned from WezTerm's environment rather than by a client — the pane's
# winsize is still 80x24 when the command starts, so `tput` bounded every
# image to a 68x20 box in a 130x33 window: ~40% small, on every render
# (Mode B 2026-07-26, caught by the debug log). tmux knows the real size
# immediately; tput is the fallback outside a mux.
#
# Zellij has the SAME problem and needed its own answer: it has no client-size
# query at all, so the shim derives the tab's usable extent from its
# non-floating panes (_mux_zj_terminal_size). Without this branch $TMUX is
# unset under zellij, tput answers with the unsettled default, and the chrome
# lays itself out for 80x24 inside a much larger tab — the image still
# rendered, the frame around it did not fit (zellij pass, 2026-07-27).
#
# The shim is sourced HERE rather than at the top so the tmux and no-mux paths
# pay nothing for it.
_cols="" _rows=""
if [[ -n "${TMUX:-}" ]]; then
  _geo="$(tmux display -p -t "${TMUX_PANE:-}" '#{pane_width} #{pane_height}' 2>/dev/null)"
  [[ "$_geo" == <->" "<-> ]] && { _cols="${_geo%% *}"; _rows="${_geo##* }" }
elif [[ -n "${ZELLIJ:-}" ]]; then
  source "${MUX_LIB:-$HOME/.local/lib}/mux.zsh" 2>/dev/null || true
  if (( ${+functions[mux::terminal_size]} )); then
    _geo="$(mux::terminal_size 2>/dev/null)"
    [[ "$_geo" == <->" "<-> ]] && { _cols="${_geo%% *}"; _rows="${_geo##* }" }
  fi
fi
[[ -n "$_cols" ]] || _cols="$(tput cols 2>/dev/null || echo 80)"
[[ -n "$_rows" ]] || _rows="$(tput lines 2>/dev/null || echo 24)"
# The frame owns 4 rows top (border, blank, header, blank) and 4 bottom
# (blank, footer, blank, border), plus a column of border either side on top
# of the padding.
_chrome_v=8
_box_w=$(( _cols - 2 * _padx )); (( _box_w < 8 )) && _box_w=8
_box_h=$(( _rows - _chrome_v )); (( _box_h < 4 )) && _box_h=4

# Anything that can BE an image becomes one: PDFs, office documents, iWork
# bundles, fonts, videos, cover art, and the raster formats chafa cannot
# decode itself. That pipeline lives in raster-common.zsh — the same one
# `preview` uses — so this script never learns a converter, and a format
# taught there shows up here for free.
#
# Resolved next to this script: bin/ and lib/ sit side by side in the repo
# and deployed alike.
_lib="${TERM_QUICK_VIEW_LIB:-${0:A:h}/../lib}"
[[ -r "$_lib/raster-common.zsh" ]] || _lib="$HOME/.local/lib"
source "$_lib/raster-common.zsh"

_raster="$(raster::for_file "$file" "${TERM_QUICK_VIEW_PAGE:-0}" 2>/dev/null)" || _raster=""
_is_image=0
[[ -n "$_raster" && -r "$_raster" ]] && _is_image=1

# Header glyph follows the SOURCE, not the raster it became.
case "$(file -b --mime-type -L "$file" 2>/dev/null):${file:l:e}" in
  image/*) _icon="󰋩" ;;
  application/pdf*|*:pdf) _icon="󰈦" ;;
  *:docx|*:doc|*:odt|*:pages) _icon="󰈬" ;;
  *:xlsx|*:xls|*:ods|*:numbers) _icon="󰈛" ;;
  *:pptx|*:ppt|*:odp|*:key) _icon="󰈧" ;;
  video/*) _icon="󰈫" ;;
  audio/*) _icon="󰈣" ;;
  font/*|*:ttf|*:otf|*:woff|*:woff2|*:ttc) _icon="󰛖" ;;
  *) _icon="󰈔" ;;
esac

_render() {  # _render [percent-of-box] — the percent is only the shrink path
  local pct="${1:-100}"
  local w=$(( _box_w * pct / 100 )) h=$(( _box_h * pct / 100 ))
  (( w < 8 )) && w=8
  (( h < 4 )) && h=4
  if (( ! _is_image )); then
    # Not rasterisable (text, archives, binaries): `preview` still has a
    # renderer for it, and it paints its own way.
    FZF_PREVIEW_COLUMNS="$w" FZF_PREVIEW_LINES="$h" \
      preview "$file" >"$_out" 2>/dev/null
    return
  fi
  if [[ -n "${TERM_QUICK_VIEW_ARGS:-}" ]]; then
    chafa ${=TERM_QUICK_VIEW_ARGS} --align center,center -s "${w}x${h}" \
      "$_raster" >"$_out" 2>/dev/null
  else
    chafa --align center,center -s "${w}x${h}" "$_raster" >"$_out" 2>/dev/null
  fi
}

_size() { wc -c < "$_out" 2>/dev/null | tr -d " " || print 0 }

# Diagnostics on demand, the tm-tab convention: `touch
# $XDG_STATE_HOME/term-quick-view.debug` and every render appends what it
# decided — geometry, stream size, the cap, and whether it shrank.
_dbg="${XDG_STATE_HOME:-$HOME/.local/state}/term-quick-view"
_log() { [[ -e "$_dbg.debug" ]] && print -r -- "$(date +%T) $*" >> "$_dbg.log" 2>/dev/null || : }

rc=0
_render || rc=$?
_log "img=${file:t} pane=${_cols}x${_rows} box=${_box_w}x${_box_h} bytes=$(_size) max=$_max"
if (( _max > 0 )) && (( $(_size) > _max )); then
  _log "  SHRINKING: $(_size) > $_max"
  # Only when the stream would overrun tmux's input-buffer-size (rare now
  # that tmux.conf raises it): bound the cells until it fits.
  for _pct in 70 50 35 25; do
    _render "$_pct" || rc=$?
    _log "  retry ${_pct}% -> $(_size) bytes"
    (( $(_size) <= _max )) && break
  done
fi

# Own the pane, then drop ONE row before painting. chafa centres vertically
# inside a view one row shorter than the pane (it keeps the last row clear),
# so its own arithmetic always lands the picture a row high — for any height,
# top = bottom - 1. The newline squares it up.
print -n -- $'\e[2J\e[H'
print ""

cat -- "$_out"

# Chrome LAST, positioned absolutely. It has to come after the image because
# chafa centres horizontally with leading SPACES, which paint over whatever
# is under them — including the left border. Absolute addressing (no
# newlines) means nothing scrolls, which is what drags a sixel out of tmux's
# grid. The frame never writes into the image's own cells.
source "$HOME/.local/lib/theme-common.zsh" 2>/dev/null || :
_fg() { theme::sgr_fg "$1" 2>/dev/null || : }
_c_name="$(_fg "${C_HEX_MAUVE:-}")"
_c_size="$(_fg "${C_HEX_GREEN:-}")"
_c_dims="$(_fg "${C_HEX_YELLOW:-}")"
_c_hint="$(_fg "${C_HEX_OVERLAY0:-}")"
_rst="${C_RES:-$'\e[0m'}"

# file size, humanised
_bytes=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null || wc -c <"$file" 2>/dev/null | tr -d ' ')
_hsize="$(_tqv_humanize_size "$_bytes")"
# pixel dimensions, when a tool can tell us
# %d, not the raw field: sips reports PDF page size in POINTS with three
# decimals ("612.000x792.000"), which reads like noise in a header.
_dims="$(sips -g pixelWidth -g pixelHeight "$file" 2>/dev/null |
  awk '/pixelWidth/{w=$2} /pixelHeight/{h=$2} END{ if (w && h) printf "%dx%d", w, h }')"
[[ -n "$_dims" ]] || _dims="$(magick identify -format '%wx%h' "$file" 2>/dev/null)" || _dims=""
[[ -n "$_dims" ]] || _dims="$(identify -format '%wx%h' "$file" 2>/dev/null)" || _dims=""

{
  # header on the second row: name left, size + dimensions right
  local _right="" _rlen=0
  [[ -n "$_hsize" ]] && { _right="${_c_size}${_hsize}${_rst}"; _rlen=${#_hsize} }
  [[ -n "$_dims" ]] && { _right="$_right ${_c_dims}(${_dims})${_rst}"; _rlen=$(( _rlen + ${#_dims} + 3 )) }
  # Column is 1-BASED: positioning at $_padx leaves _padx-1 cells before the
  # text, so the title sat one column left of the frame it is supposed to line
  # up with. The right-hand side below already had the +1 (it computes an END
  # column), which is why only the left edge looked wrong.
  printf '\e[2;%dH%s%s %s%s' "$(( _padx + 1 ))" "$_c_name" "$_icon" "${file:t}" "$_rst"
  (( _rlen )) && printf '\e[2;%dH%s' "$(( _cols - _padx - _rlen + 1 ))" "$_right"

  # hint, centred, two rows off the bottom
  local _hint="Press any key to dismiss"
  printf '\e[%d;%dH%s%s%s' "$(( _rows - 1 ))" "$(( (_cols - ${#_hint}) / 2 + 1 ))" "$_c_hint" "$_hint" "$_rst"

  # keep the cursor hidden — chafa turns it back on at the end of its stream
  printf '\e[?25l'
}

# NOTHING below this line may write to the pane.
read -k1 -s || :
printf '\e[?25h'   # the pane is going away, but leave the cursor as we found it
exit $rc
