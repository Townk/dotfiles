#!/usr/bin/env zsh
# system-package-cargo — sync `cargo install`-managed binaries against
# ~/.config/packages/Cargofile. Lines are `<crate> [cargo-install-args...]`;
# the first word is the canonical crate name (matched against
# `cargo install --list`), the rest is passed straight to `cargo install`,
# so flags like `--locked`, `--features=...`, or `--git=...` land verbatim.
#
# Cargo (and rust toolchain) is provided by mise so this worker has nothing
# to do with brew. Binaries land in $CARGO_HOME/bin (~/.cargo/bin by default).

set -eu -o pipefail

source "$HOME/.local/lib/system-package-common.sh"

CARGOFILE="$PKG_DIR/Cargofile"
CARGO_MANIFEST_STAMP="$PKG_STATE_DIR/cargo.manifest"

# cargo_installed_crates
# Print one crate name per line. Parses the canonical `cargo install --list`
# format:
#
#   <name> v<version>[ (<source>)]:
#       <bin1>
#       <bin2>
#
# Each crate header is at column 0 and ends with `:`. Indented lines are
# binary names — ignored. The trailing source annotation (e.g. `(git+...)`,
# `(/local/path)`) is also ignored; the leading word is always the crate name.
cargo_installed_crates() {
  cargo install --list 2>/dev/null \
    | awk '/^[^[:space:]].*:$/ {print $1}'
}

# cargo_installed_versions
# Print `name\tversion` for every installed crate. Strips the leading `v`
# from the version (cargo prints `v6.5.0`, we want `6.5.0`) and the trailing
# `:` that's glued to $2 when the crate has no source annotation (the line
# is `name vX.Y.Z:` instead of `name vX.Y.Z (source):`).
cargo_installed_versions() {
  cargo install --list 2>/dev/null \
    | awk '/^[^[:space:]].*:$/ {
        name = $1
        ver = $2
        sub(/^v/, "", ver)
        sub(/:$/, "", ver)
        print name "\t" ver
      }'
}

# cargo_list_rows <outdated:true|false>
# Output one "name\tversion[annotation]" TSV row per installed crate.
# Outdated check hits the crates.io v1 API (in parallel via pkg::outdated_rows);
# crates installed from git or a local path won't be on crates.io and silently
# skip the annotation.
cargo_list_rows() {
  local outdated="${1:-false}"
  if [[ "$outdated" == true ]]; then
    cargo_installed_versions \
      | pkg::outdated_rows \
          'curl -fsSL "https://crates.io/api/v1/crates/$1" 2>/dev/null | jq -r ".crate.max_stable_version // empty"' \
      | sort
  else
    cargo_installed_versions | sort
  fi
}

do_list() {
  local outdated=false
  while (( $# > 0 )); do
    case "$1" in
      -u|--update) outdated=true; shift ;;
      -a|--all)    shift ;;  # no-op: cargo has no transient-dep concept here
      *) die "unknown flag for list: $1" ;;
    esac
  done
  cargo_list_rows "$outdated"
}

# cargo_provision <cargofile-line>
# Install or upgrade one Cargofile entry, preferring a prebuilt binary.
#
# Bare entries (crate name only) go through `cargo binstall` when it's
# available: binstall's default strategy order (crate-meta-data, quick-install,
# compile) grabs a prebuilt artifact when one exists and compiles from source
# otherwise — a faster drop-in for `cargo install`. It records installs in the
# same $CARGO_HOME/.crates2.json that `cargo install --list` reads, so the
# detection logic above stays correct. Without cargo-binstall it falls back to
# plain `cargo install`. binstall skips crates already at the latest version,
# so it is safe on the upgrade pass too.
#
# Entries carrying extra args (--features, --git, --locked, …) still use
# `cargo install` directly: those flags express a source-build intent the
# prebuilt path can't honor. They only use `--force` when the manifest line
# changed since the last successful sync, so normal runs can let cargo skip
# crates already at the latest version.
cargo_provision() {
  local line="$1"
  local force="${2:-false}"
  local -a args=( ${(z)line} )
  if [[ "$line" != "${line%% *}" ]]; then
    if [[ "$force" == true ]]; then
      cargo install --force "${args[@]}"
    else
      cargo install "${args[@]}"
    fi
  elif (( HAVE_BINSTALL )); then
    cargo binstall --no-confirm "${args[@]}"
  else
    cargo install "${args[@]}"
  fi
}

cargo_manifest_line_changed() {
  local crate="$1" line="$2"
  [[ -f "$CARGO_MANIFEST_STAMP" ]] || return 1

  local previous=""
  previous=$(awk -v c="$crate" '$1 == c {print; exit}' "$CARGO_MANIFEST_STAMP")
  [[ -n "$previous" && "$previous" != "$line" ]]
}

cargo_write_manifest_stamp() {
  local manifest="$1"
  mkdir -p "$PKG_STATE_DIR"
  cp "$manifest" "$CARGO_MANIFEST_STAMP"
}

# Per-crate actions for the for_each loops in do_sync. They read do_sync's
# locals (declared_full) and HAVE_BINSTALL via dynamic scope at call time, and
# return non-zero on failure so for_each can tally.
_cargo_install_one() {
  local crate="$1" line
  line=$(awk -v c="$crate" '$1 == c {print; exit}' "$declared_full")
  cargo_provision "$line" || { log_warn "failed to install $crate"; return 1; }
}
_cargo_upgrade_one() {
  local line="$1" crate="${1%% *}" force=false
  cargo_manifest_line_changed "$crate" "$line" && force=true
  cargo_provision "$line" "$force" || { log_warn "failed to upgrade $crate"; return 1; }
}

do_sync() {
  log_info "Syncing cargo crates..."

  # Prefer prebuilt binaries for bare crates when cargo-binstall is present
  # (see cargo_provision); detected once, falls back to `cargo install`.
  HAVE_BINSTALL=0
  command -v cargo-binstall >/dev/null 2>&1 && HAVE_BINSTALL=1

  local declared_full declared installed before_snap after_snap
  declared_full=$(mktemp); declared=$(mktemp); installed=$(mktemp)
  before_snap=$(mktemp); after_snap=$(mktemp)
  trap "rm -f '$declared_full' '$declared' '$installed' '$before_snap' '$after_snap'" EXIT

  cargo_installed_versions > "$before_snap"

  pkg::manifest_read "$CARGOFILE" > "$declared_full"
  awk '{print $1}' "$declared_full" > "$declared"
  cargo_installed_crates > "$installed"
  local had_failures=0

  # Uninstall extras BEFORE installing missing — same swap-collision
  # rationale as the uv/npm workers (two crates that ship a binary of the
  # same name would otherwise refuse to overwrite each other).
  pkg::diff_only_in "$installed" "$declared" | while IFS= read -r crate; do
    [[ -n "$crate" ]] && cargo uninstall "$crate"
  done

  # Install missing. for_each runs the action per crate and tallies failures.
  for_each "cargo install" _cargo_install_one \
    < <(pkg::diff_only_in "$declared" "$installed") || had_failures=1

  # Upgrade everything still declared. cargo_provision is the canonical
  # upgrade path: cargo / binstall short-circuit when a crate is already at
  # the latest version, so the cost is one fast registry check per crate.
  for_each "cargo upgrade" _cargo_upgrade_one < "$declared_full" || had_failures=1

  (( had_failures == 0 )) && cargo_write_manifest_stamp "$declared_full"

  # Restart services whose backing crate changed version.
  cargo_installed_versions > "$after_snap"
  pkg::restart_changed "$before_snap" "$after_snap"
  return 0
}

usage() {
  cat <<EOF
Usage:
  system-package-cargo list [-u|--update]
  system-package-cargo sync
  system-package-cargo -h | --help | help

Syncs \`cargo install\`-managed binaries against ~/.config/packages/Cargofile.

list flags:
  -u, --update   annotate packages with available updates (queries crates.io)
  -a, --all      no-op (cargo has no transient-dep concept here)

After sync, any system service whose backing crate changed version and is
currently running is restarted.
EOF
}

usage_list() {
  cat <<EOF
Usage:
  system-package-cargo list [-u|--update]

Emits TSV "<name>\t<version>" rows for every \`cargo install\`-installed crate.

Flags:
  -u, --update   annotate each row with the latest stable version
                 (queried from crates.io's v1 API; git/local crates skip)
  -a, --all      no-op (cargo has no transient-dep concept)
EOF
}

usage_sync() {
  cat <<EOF
Usage:
  system-package-cargo sync

Reconciles ~/.config/packages/Cargofile against \`cargo install --list\`:

  • Lines are \`<crate> [cargo-install-args...]\`. The first word is the
    canonical crate name; the rest is forwarded to \`cargo install\` (works
    with \`--locked\`, \`--features=...\`, \`--git=...\`, etc.).
  • Crates with extra args are reinstalled with \`--force\` so flag changes
    take effect; bare entries get a regular \`cargo install\` (no-op when
    already up-to-date).

After sync, services whose backing crate was just upgraded and are
currently running are restarted.
EOF
}

main() {
  if [[ $# -eq 0 ]] || is_help "${1:-}"; then
    usage; exit 0
  fi
  local cmd="$1"; shift
  case "$cmd" in
    list)
      args_contain_help "$@" && { usage_list; exit 0; }
      do_list "$@"
      ;;
    sync)
      args_contain_help "$@" && { usage_sync; exit 0; }
      do_sync
      ;;
    *) usage >&2; die "unknown subcommand: $cmd" ;;
  esac
}

main "$@"
