#!/usr/bin/env zsh
# system-secrets — manage the secrets manifest and per-slot secret material.
#
# Usage:
#   system-secrets list                          show manifest + known slots
#   system-secrets add <NAME>                    declare (if new) + set NAME on this machine
#   system-secrets rotate <NAME> [--slot S|--all] re-collect NAME (default: this machine)
#   system-secrets rotate [--slot S|--all]       rebuild a slot's whole secret set
#
# Shares system-secrets-common.zsh with `system-onboard`, so the way slots are
# built, encrypted, and audited cannot drift between onboarding and later edits.
# Committed artifacts use OPAQUE SLOT IDS only (this repo is public).

set -eu -o pipefail

source "$HOME/.local/lib/system-secrets-common.zsh"

VALID_PROFILES=(personal work dev-shell)

usage() {
  cat <<EOF
Manage this machine's secrets — the values behind the env var NAMES declared in
the manifest (home/.chezmoidata/secrets.yaml), which also records each secret's
prompt and the profiles that need it (no values, no company data live there).

Usage:
  system-secrets list                           show manifest + known slots
  system-secrets add <NAME>                     declare (if new) + set NAME on this machine
  system-secrets rotate <NAME> [--slot S|--all] re-collect NAME (default: this machine)
  system-secrets rotate [--slot S|--all]        rebuild a slot's whole secret set
  system-secrets -h | --help | help             show this help

\`add\` declares a secret if new, ensures THIS machine's profile requires it, and
stores its value in one step. \`rotate\` re-collects an existing secret on this
machine (or --slot / --all); with no NAME it rebuilds the slot's whole set.
Values are SOPS+age encrypted per-secret (secrets/<slot>/<NAME>.sops.sh, headless)
or 1Password references (human).
EOF
}

# Resolve which known slots exist (operator map keys).
known_slots() {
  [[ -f "$OPERATOR_MAP" ]] || return 0
  yq -r 'keys | .[]' "$OPERATOR_MAP" 2>/dev/null || true
}

is_valid_profile() {
  local p
  for p in "${VALID_PROFILES[@]}"; do [[ "$1" == "$p" ]] && return 0; done
  return 1
}

# this_machine_slot / this_machine_profile — read this host's chezmoi data.
this_machine_slot() {
  local s
  s="$(chezmoi data | yq -r '.secretsSlot // ""' 2>/dev/null || true)"
  [[ -n "$s" ]] || die "this machine has no secretsSlot (run 'system-onboard --local' first)"
  printf '%s' "$s"
}

this_machine_profile() {
  local p
  p="$(chezmoi data | yq -r '.profile // ""' 2>/dev/null || true)"
  [[ -n "$p" ]] || die "this machine has no chezmoi profile (run 'chezmoi init' first)"
  printf '%s' "$p"
}

# require_tools_for_slot <slot> — headless slots encrypt locally, so they need
# sops/age; human slots resolve 1Password references and need neither.
require_tools_for_slot() {
  [[ "$(sec::map_get "$1" kind)" == headless ]] && require_cmd sops age
  return 0
}

# refresh_current_fragment <slot> — if <slot> is THIS machine's, re-render its
# fragment so the new value is live without a full apply.
refresh_current_fragment() {
  local slot="$1" current
  current="$(chezmoi data | yq -r '.secretsSlot // ""' 2>/dev/null || true)"
  [[ "$slot" == "$current" ]] || return 0
  log_info "refreshing this machine's rendered secret fragment …"
  if CHEZMOI_REFRESH_SECRETS=1 chezmoi apply "$HOME/.config/zsh/secrets.d/$slot.sh"; then
    # The fragment on disk is current; the caller's shell is not (see the hint).
    sec::shell_reload_hint
  else
    log_warn "could not refresh ~/.config/zsh/secrets.d/$slot.sh; run CHEZMOI_REFRESH_SECRETS=1 chezmoi apply manually"
  fi
}

# slots_requiring <name> — every known slot whose profile requires NAME.
slots_requiring() {
  local name="$1" s prof
  while IFS= read -r s; do
    [[ -n "$s" ]] || continue
    prof="$(sec::map_get "$s" profile)"
    if sec::manifest_requires "$prof" "$name"; then
      printf '%s\n' "$s"
    fi
  done < <(known_slots)
}

cmd_list() {
  sec::manifest_check
  print -r -- "${C_BWH}Secrets (manifest — committed, no values)${C_RES}"
  yq -r '.secrets[] | "  " + .name + "  [" + (.requiredFor | join(",")) + "]  " + .prompt' \
    "$MANIFEST"
  if [[ -f "$OPERATOR_MAP" ]] && [[ -n "$(known_slots)" ]]; then
    print -r -- ""
    print -r -- "${C_BWH}Slots (operator map — local-only, never committed)${C_RES}"
    yq -r 'to_entries[] | "  " + .key + "  " + .value.kind + "  " + .value.profile + "  (" + .value.alias + ")"' \
      "$OPERATOR_MAP"
  else
    print -r -- ""
    log_info "no slots onboarded yet (see \`system-onboard\`)"
  fi
}

cmd_add() {
  local name="${1:-}"
  [[ -n "$name" ]] || {
    usage >&2
    die "add requires a secret NAME"
  }
  sec::valid_name "$name" || die "invalid name '$name' (use UPPER_SNAKE_CASE)"

  local slot profile
  slot="$(this_machine_slot)"
  profile="$(this_machine_profile)"
  [[ -n "$(sec::map_get "$slot" kind)" ]] ||
    die "slot $slot is not in this machine's operator map (run system-onboard)"
  require_tools_for_slot "$slot"

  # 1. Manifest: declare a new secret, or ensure THIS machine's profile requires
  #    an existing one (else the value can't materialize here).
  if ! sec::manifest_has "$name"; then
    local prompt profiles p
    prompt::required prompt "One-line description for $name:"
    prompt::default profiles \
      "Profiles needing it (comma-separated of: ${(j:,:)VALID_PROFILES})" "$profile"
    for p in ${(s:,:)profiles}; do
      is_valid_profile "${p// /}" || die "unknown profile: '$p'"
    done
    # This machine's profile must be included so the value materializes here.
    case ",${profiles// /}," in
      *",$profile,"*) ;;
      *) profiles="${profiles},$profile" ;;
    esac
    sec::manifest_add "$name" "$prompt" "$profiles"
    log_ok "added $name to the manifest"
  elif sec::manifest_add_profile "$name" "$profile"; then
    log_ok "added profile '$profile' to $name (this machine needs it)"
  else
    log_info "$name already declared for profile '$profile'"
  fi

  # 2. Store this machine's value for NAME.
  sec::materialize_secret "$slot" "$name"

  # 3. Commit and refresh this host's rendered fragment.
  local paths
  paths=("${(@f)$(sec::commit_paths_for_slot "$slot")}")
  sec::git_commit "feat(secrets): add $name on $slot" "${paths[@]}"
  refresh_current_fragment "$slot"

  log_info "other '$profile' machines will also need $name: run 'system-secrets add $name' there (or 'system-secrets rotate $name --all')"
}

# rebuild_and_commit <slot> — full-rebuild one slot and commit its artifacts.
rebuild_and_commit() {
  local slot="$1"
  sec::valid_slot "$slot" || die "invalid slot id: $slot"
  [[ -n "$(sec::map_get "$slot" kind)" ]] ||
    die "unknown slot '$slot' (not in the operator map)"
  require_tools_for_slot "$slot"
  sec::rebuild_slot "$slot"
  local paths
  paths=("${(@f)$(sec::commit_paths_for_slot "$slot")}")
  sec::git_commit "feat(secrets): update $slot" "${paths[@]}"
  refresh_current_fragment "$slot"
}

# materialize_and_commit <slot> <name> — set/rotate ONE secret and commit.
materialize_and_commit() {
  local slot="$1" name="$2"
  sec::valid_slot "$slot" || die "invalid slot id: $slot"
  [[ -n "$(sec::map_get "$slot" kind)" ]] ||
    die "unknown slot '$slot' (not in the operator map)"
  require_tools_for_slot "$slot"
  sec::materialize_secret "$slot" "$name"
  local paths
  paths=("${(@f)$(sec::commit_paths_for_slot "$slot")}")
  sec::git_commit "feat(secrets): rotate $name on $slot" "${paths[@]}"
  refresh_current_fragment "$slot"
}

cmd_rotate() {
  local name="" slot="" all=0
  while (($#)); do
    case "$1" in
      --slot)
        slot="${2:-}"
        shift 2
        ;;
      --all)
        all=1
        shift
        ;;
      -*) die "unknown flag: $1" ;;
      *)
        name="$1"
        shift
        ;;
    esac
  done
  [[ -n "$slot" && "$all" == 1 ]] && die "--slot and --all are mutually exclusive"

  # NAME given: rotate just that secret on the target slot(s).
  if [[ -n "$name" ]]; then
    sec::manifest_has "$name" || die "'$name' is not in the manifest"
    local -a targets
    if [[ -n "$slot" ]]; then
      targets=("$slot")
    elif ((all)); then
      targets=("${(@f)$(slots_requiring "$name")}")
      targets=(${targets:#})
      ((${#targets[@]})) || {
        log_warn "no onboarded slot requires '$name'"
        return 0
      }
    else
      targets=("$(this_machine_slot)")
    fi
    local s prof
    for s in "${targets[@]}"; do
      sec::valid_slot "$s" || die "invalid slot id: $s"
      [[ -n "$(sec::map_get "$s" kind)" ]] || die "unknown slot '$s' (not in the operator map)"
      prof="$(sec::map_get "$s" profile)"
      if ! sec::manifest_requires "$prof" "$name"; then
        log_warn "slot $s (profile $prof) does not require '$name'; skipping"
        continue
      fi
      log_info "rotating $name on slot $s"
      materialize_and_commit "$s" "$name"
    done
    return
  fi

  # No NAME: full slot rebuild.
  if ((all)); then
    local -a slots
    slots=("${(@f)$(known_slots)}")
    slots=(${slots:#})
    ((${#slots[@]})) || {
      log_warn "no slots to rebuild"
      return 0
    }
    prompt::confirm "Rebuild all ${#slots[@]} slot(s)? This re-collects every value." ||
      {
        log_info "aborted"
        return 0
      }
    local s
    for s in "${slots[@]}"; do
      log_info "rebuilding slot $s"
      rebuild_and_commit "$s"
    done
    return
  fi
  [[ -n "$slot" ]] || slot="$(this_machine_slot)"
  rebuild_and_commit "$slot"
}

main() {
  [[ $# -ge 1 ]] || {
    usage
    exit 0
  }
  is_help "$1" && {
    usage
    exit 0
  }

  sec::repo_paths
  require_cmd yq

  local cmd="$1"
  shift
  case "$cmd" in
    list)
      args_contain_help "$@" && {
        usage
        exit 0
      }
      cmd_list
      ;;
    add)
      args_contain_help "$@" && {
        usage
        exit 0
      }
      cmd_add "$@"
      ;;
    rotate)
      args_contain_help "$@" && {
        usage
        exit 0
      }
      cmd_rotate "$@"
      ;;
    *)
      usage >&2
      die "unknown subcommand: $cmd"
      ;;
  esac
}

main "$@"
