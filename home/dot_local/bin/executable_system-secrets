#!/usr/bin/env zsh
# system-secrets — manage the secrets manifest and per-slot secret material.
#
# Usage:
#   system-secrets list                       show manifest + known slots
#   system-secrets add <NAME>                 declare a new secret in the manifest
#   system-secrets rotate <NAME> [--slot S]   re-collect the secret(s) on a slot
#   system-secrets reconcile [--slot S]       rebuild a slot to match the manifest
#
# Shares system-secrets-common.sh with `system-onboard`, so the way slots are
# built, encrypted, and audited cannot drift between onboarding and later edits.
# Committed artifacts use OPAQUE SLOT IDS only (this repo is public).

set -eu -o pipefail

source "$HOME/.local/lib/system-secrets-common.sh"

VALID_PROFILES=(personal work dev-shell)

usage() {
  cat <<EOF
Usage:
  system-secrets list                       show manifest + known slots
  system-secrets add <NAME>                 declare a new secret in the manifest
  system-secrets rotate <NAME> [--slot S]   re-collect the secret(s) on a slot
  system-secrets reconcile [--slot S]       rebuild a slot to match the manifest
  system-secrets -h | --help | help         show this help

The manifest (home/.chezmoidata/secrets.yaml) holds env var NAMES, prompts, and
the profiles that need each secret — no values, no company data. Actual values
are SOPS+age encrypted per opaque slot (headless) or 1Password references
(human). \`rotate\`/\`reconcile\` re-collect a slot's full required set, since a
headless blob is encrypted only to that box's key and can't be partially read.
EOF
}

# Resolve which known slots exist (operator map keys).
known_slots() {
  [[ -f "$OPERATOR_MAP" ]] || return 0
  yq -r 'keys | .[]' "$OPERATOR_MAP" 2>/dev/null || true
}

is_valid_profile() {
  local p
  for p in "${VALID_PROFILES[@]}"; do [[ "$1" == "$p" ]] && return 0; done
  return 1
}

cmd_list() {
  sec::manifest_check
  print -r -- "${C_BWH}Secrets (manifest — committed, no values)${C_RES}"
  yq -r '.secrets[] | "  " + .name + "  [" + (.requiredFor | join(",")) + "]  " + .prompt' \
    "$MANIFEST"
  if [[ -f "$OPERATOR_MAP" ]] && [[ -n "$(known_slots)" ]]; then
    print -r -- ""
    print -r -- "${C_BWH}Slots (operator map — local-only, never committed)${C_RES}"
    yq -r 'to_entries[] | "  " + .key + "  " + .value.kind + "  " + .value.profile + "  (" + .value.alias + ")"' \
      "$OPERATOR_MAP"
  else
    print -r -- ""
    log_info "no slots onboarded yet (see \`system-onboard\`)"
  fi
}

cmd_add() {
  local name="${1:-}"
  [[ -n "$name" ]] || { usage >&2; die "add requires a secret NAME"; }
  sec::valid_name "$name" || die "invalid name '$name' (use UPPER_SNAKE_CASE)"
  sec::manifest_has "$name" && die "'$name' is already in the manifest"

  local prompt profiles
  prompt::required prompt "One-line description for $name:"
  prompt::required profiles "Profiles needing it (comma-separated of: ${(j:,:)VALID_PROFILES}):"

  local p
  for p in ${(s:,:)profiles}; do
    is_valid_profile "${p// /}" || die "unknown profile: '$p'"
  done

  name="$name" pr="$prompt" profs="${profiles// /}" yq -i '
    .secrets += [{
      "name": strenv(name),
      "prompt": strenv(pr),
      "requiredFor": (strenv(profs) | split(","))
    }]' "$MANIFEST"
  log_ok "added $name to the manifest"
  sec::git_commit "feat(secrets): add $name to the manifest" "$MANIFEST"
  log_info "push it to machines with: system-secrets reconcile --slot <slot>"
}

# rebuild_and_commit <slot> — rebuild one slot and commit its artifacts.
rebuild_and_commit() {
  local slot="$1"
  sec::valid_slot "$slot" || die "invalid slot id: $slot"
  [[ -n "$(sec::map_get "$slot" kind)" ]] \
    || die "unknown slot '$slot' (not in the operator map)"
  sec::rebuild_slot "$slot"
  local paths
  paths=("${(@f)$(sec::commit_paths_for_slot "$slot")}")
  sec::git_commit "feat(secrets): update $slot" "${paths[@]}"

  local current_slot
  current_slot="$(chezmoi data | yq -r '.secretsSlot // ""' 2>/dev/null || true)"
  if [[ "$slot" == "$current_slot" ]]; then
    log_info "refreshing this machine's rendered secret fragment …"
    CHEZMOI_REFRESH_SECRETS=1 chezmoi apply "$HOME/.config/zsh/secrets.d/$slot.sh" \
      || log_warn "could not refresh ~/.config/zsh/secrets.d/$slot.sh; run CHEZMOI_REFRESH_SECRETS=1 chezmoi apply manually"
  fi
}

cmd_rotate() {
  local name="" slot=""
  while (( $# )); do
    case "$1" in
      --slot) slot="${2:-}"; shift 2 ;;
      -*)     die "unknown flag: $1" ;;
      *)      name="$1"; shift ;;
    esac
  done

  if [[ -n "$slot" ]]; then
    rebuild_and_commit "$slot"
    return
  fi

  [[ -n "$name" ]] || { usage >&2; die "rotate requires <NAME> or --slot"; }
  sec::manifest_has "$name" || die "'$name' is not in the manifest"

  # Rotate every slot whose profile requires NAME.
  local s any=0 profile
  while IFS= read -r s; do
    [[ -n "$s" ]] || continue
    profile="$(sec::map_get "$s" profile)"
    if sec::manifest_names_for_profile "$profile" | grep -Fxq "$name"; then
      any=1
      log_info "rotating slot $s (profile $profile)"
      rebuild_and_commit "$s"
    fi
  done < <(known_slots)
  (( any )) || log_warn "no onboarded slot requires '$name'"
}

cmd_reconcile() {
  local slot=""
  while (( $# )); do
    case "$1" in
      --slot) slot="${2:-}"; shift 2 ;;
      -*)     die "unknown flag: $1" ;;
      *)      die "unexpected argument: $1" ;;
    esac
  done

  if [[ -n "$slot" ]]; then
    rebuild_and_commit "$slot"
    return
  fi

  local slots
  slots=("${(@f)$(known_slots)}")
  slots=(${slots:#})
  (( ${#slots[@]} )) || { log_warn "no slots to reconcile"; return 0; }
  prompt::confirm "Reconcile all ${#slots[@]} slot(s)? This re-collects every value." \
    || { log_info "aborted"; return 0; }
  local s
  for s in "${slots[@]}"; do
    log_info "reconciling slot $s"
    rebuild_and_commit "$s"
  done
}

main() {
  [[ $# -ge 1 ]] || { usage; exit 0; }
  is_help "$1" && { usage; exit 0; }

  sec::repo_paths
  require_cmd yq

  local cmd="$1"; shift
  case "$cmd" in
    list)      args_contain_help "$@" && { usage; exit 0; }; cmd_list ;;
    add)       args_contain_help "$@" && { usage; exit 0; }; require_cmd sops age; cmd_add "$@" ;;
    rotate)    args_contain_help "$@" && { usage; exit 0; }; require_cmd sops age; cmd_rotate "$@" ;;
    reconcile) args_contain_help "$@" && { usage; exit 0; }; require_cmd sops age; cmd_reconcile "$@" ;;
    *)         usage >&2; die "unknown subcommand: $cmd" ;;
  esac
}

main "$@"
