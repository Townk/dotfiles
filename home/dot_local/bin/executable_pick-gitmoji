#!/usr/bin/env zsh
# pick-gitmoji — fzf-based picker for the gitmoji catalog.
#
# Backed by the gitmoji rows of the symbols database built by the custom
# Symbols Nerd Font pipeline at
#   ${XDG_DATA_HOME:-$HOME/.local/share}/fonts/nerd-font/symbols.db
# (the rows whose `tags` include 'gitmoji'). The build's renderability probe
# guarantees every emoji here draws in the terminal, and emoji-presentation
# width is taken from the DB's display_width column — so no per-glyph width
# overrides and no ZWJ-sequence special-casing are needed here. One fzf line
# is streamed per row straight out of SQLite — no jq, no network fetch.
#
# Each line shows:
#   <emoji>  :name:  <description>      e.g. 🎨  :art:  Improve structure / format
#
# Output modes (each bound to a key via the pick::start API):
#   Enter    raw emoji        (e.g. 🎨)
#   Ctrl-N   :name:           (e.g. :art:)
# The Alt- twins (Alt-Enter = emoji, Alt-N = :name:) insert WITHOUT closing
# the picker: the value goes to the originating zellij pane when embedded
# (PICK_INJECT_PANE / PICK_INJECT_ZELLIJ, set by zellij-modal), otherwise to
# the system clipboard.
#
# Recently-picked gitmojis float to the top: each pick stamps `last_used` in
# the DB and the query orders by it. --resume reopens with the previous query
# and cursor position restored.

set -eu -o pipefail

PICK_NAME=pick-gitmoji
PICK_LIB_DIR="${PICK_LIB_DIR:-$HOME/.local/lib}"
source "${PICK_COMMON_LIB:-$PICK_LIB_DIR/pick-common.zsh}" \
  || { print -ru2 -- "pick-gitmoji: cannot source pick-common.zsh from $PICK_LIB_DIR"; exit 1; }

DB_FILE="${PICK_GITMOJI_DB:-${XDG_DATA_HOME:-$HOME/.local/share}/fonts/nerd-font/symbols.db}"

# Thin alias to the shared error helper (prefixes $PICK_NAME and exits).
die() { pick::die "$@"; }

usage() {
  cat <<EOF
Usage:
  pick-gitmoji [OPTIONS]

Interactively pick a gitmoji via fzf and print it.

Inside the picker:
  Enter            output the raw emoji (default)
  Ctrl-N           output the :name: code (e.g. :tada:)
  Alt-Enter        insert the emoji WITHOUT closing the picker
  Alt-N            same, but insert the :name: code
                   (sink: the originating zellij pane when embedded,
                    else the system clipboard)
  Tab / Ctrl-A     (with --multi) mark / select-all

Recently-picked gitmojis float to the top. Type a name or words from a
gitmoji's description to narrow the list.

Options:
  -m, --multi      select multiple gitmojis (concatenated on output)
  -c, --copy       copy the result to the clipboard instead of stdout
  -q, --query Q    seed fzf with an initial query string
      --resume     reopen with the previous query + cursor restored
      --no-border  suppress fzf's border (for embedding in a bordered pane)
      --db FILE    override the symbols.db path
  -h, --help       show this help

Examples:
  pick-gitmoji                # interactive picker, print the emoji
  pick-gitmoji -c -q rocket   # find the rocket gitmoji, copy to clipboard
  pick-gitmoji -q test        # narrow to test-related gitmojis
EOF
}

multi=0
copy=0
query=""
resume=0
no_border=0

while (( $# > 0 )); do
  case "$1" in
    -m|--multi)   multi=1; shift ;;
    -c|--copy)    copy=1; shift ;;
    -q|--query)   [[ $# -ge 2 ]] || die "missing arg for $1"; query="$2"; shift 2 ;;
    --db)         [[ $# -ge 2 ]] || die "missing arg for $1"; DB_FILE="$2"; shift 2 ;;
    --resume)     resume=1; shift ;;
    --no-border)  no_border=1; shift ;;
    -h|--help)    usage; exit 0 ;;
    --)           shift; break ;;
    *) die "unknown arg: $1 (try --help)" ;;
  esac
done

pick::need sqlite3
[[ -f "$DB_FILE" ]] || die "symbols DB not found: $DB_FILE
Build it with: chezmoi apply (runs the symbols-db hook)"

# Recency in the DB: stamp last_used on every picked gitmoji so the next
# launch floats it up. Field 1 of the hidden tail is the emoji itself, which
# is the symbols-table primary key.
record_gitmoji_recency() {
  (( $# )) || return 0
  local now sym vals=""
  now=$(date +%s)
  for sym in "$@"; do
    [[ -z "$sym" ]] && continue
    sym=${sym//\'/\'\'}   # SQL-escape single quotes
    vals+="'${sym}',"
  done
  [[ -z "$vals" ]] && return 0
  sqlite3 "$DB_FILE" "UPDATE symbols SET last_used=$now WHERE symbol IN (${vals%,});"
}

hints=$'󰌑 : emoji  ·  󰘴 N: :name:  ·  ⌥ ⏎/N: insert & stay'
if (( multi )); then
  hints+=$'  ·  ⭾ : select  ·  󰘴 A: select-all'
fi

pick_args=(
  --header "Pick a gitmoji"
  --hints "$hints"
  --height       "${PICK_GITMOJI_HEIGHT:-45%}"
  --margin       "${PICK_GITMOJI_MARGIN:-0,0,0,0}"
  --padding      "${PICK_GITMOJI_PADDING:-0,0,0,0}"
  --input-border "${PICK_GITMOJI_INPUT_BORDER:-1}"
  --output field:1               # Enter -> emoji
  --key-output ctrl-n:field:2    # Ctrl-N -> :name:
  --key-background alt-enter:field:1
  --key-background alt-n:field:2
  --on-items-picked record_gitmoji_recency
  --cache-state
)
if (( multi ));     then pick_args+=( --multi='' ); fi
if (( copy ));      then pick_args+=( --copy-only ); fi
if (( resume ));    then pick_args+=( --resume ); fi
if (( no_border )); then pick_args+=( --no-border ); fi
if [[ -n "$query" ]]; then pick_args+=( --query "$query" ); fi

# Stream the gitmoji rows. The :name: column is padded to the widest code so
# descriptions line up. Visible columns are colour-coded; the hidden tail
# (after CHAR(31), fields split on CHAR(30)) carries clean OUTPUT values:
#   1=emoji  2=:name:
sqlite3 -escape off "$DB_FILE" "
  WITH palette AS (
    SELECT
      CHAR(27) || '[0m'                AS reset,
      CHAR(27) || '[38;2;255;255;255m' AS glyph_color,
      CHAR(27) || '[38;2;137;180;250m' AS name_color,
      CHAR(27) || '[38;2;127;132;156m' AS meta_color
  ),
  geom AS (
    SELECT MAX(length(shortcode) + 2) AS code_w
    FROM symbols WHERE tags LIKE '%gitmoji%'
  )
  SELECT
      glyph_color || symbol || reset
      || IFNULL(printf('%*s', MAX(0, 2 - display_width), ''), '')
      || '  '
      || name_color
      || printf('%-' || code_w || 's', ':' || shortcode || ':')
      || reset
      || '  ' || meta_color || description || reset
      || CHAR(31)
      || symbol || CHAR(30)
      || ':' || shortcode || ':'
  FROM symbols, palette, geom
  WHERE tags LIKE '%gitmoji%'
  ORDER BY last_used DESC, shortcode ASC;
" | pick::start "${pick_args[@]}"
