#!/usr/bin/env zsh
# system-package-go — sync `go install`-installed binaries against
# ~/.config/packages/Gofile. Manifest entries are full module paths.

set -eu -o pipefail

source "$HOME/.local/lib/system-package-common.sh"

GOFILE="$PKG_DIR/Gofile"

go_bin_dir() {
  go env GOBIN 2>/dev/null | grep . || printf '%s/bin\n' "$(go env GOPATH)"
}

# Print one "<package_path>\t<binary_basename>" per line for everything in
# $GOBIN that go can identify. Skips files that aren't Go binaries (where
# `go version -m` fails).
go_installed_pairs() {
  local bin_dir; bin_dir=$(go_bin_dir)
  [[ -d "$bin_dir" ]] || return 0
  local f="" pkg_path=""
  for f in "$bin_dir"/*(N); do
    [[ -x "$f" && -f "$f" ]] || continue
    pkg_path=$( { go version -m "$f" 2>/dev/null || true; } \
              | awk '$1=="path" {print $2; exit}')
    [[ -n "$pkg_path" ]] && printf '%s\t%s\n' "$pkg_path" "${f:t}" || true
  done
}

go_list_installed() {
  go_installed_pairs | awk -F'\t' '{print $1}'
}

# go_snapshot_versions — TSV "binary_name\tversion" rows. Keys on the
# binary's basename (not the module path) because service cmd[0] resolves
# to a binary on PATH, so binary-name is what `system-service restart-for`
# will look up.
go_snapshot_versions() {
  go_installed_triples | awk -F'\t' '{print $2 "\t" $3}'
}

# go_installed_triples
# Output one "<mod_path>\t<binary_name>\t<mod_version>" row per installed binary.
# mod_path is the MODULE path (from the "mod" line), suitable for go list -m -versions.
go_installed_triples() {
  local bin_dir; bin_dir=$(go_bin_dir)
  [[ -d "$bin_dir" ]] || return 0
  local f="" pkg_path="" mod_path="" mod_ver="" vout=""
  for f in "$bin_dir"/*(N); do
    [[ -x "$f" && -f "$f" ]] || continue
    vout=$( { go version -m "$f" 2>/dev/null || true; } )
    pkg_path=$(printf '%s' "$vout" | awk '$1=="path" {print $2; exit}')
    mod_path=$(printf '%s' "$vout" | awk '$1=="mod"  {print $2; exit}')
    mod_ver=$(printf '%s' "$vout"  | awk '$1=="mod"  {print $3; exit}')
    [[ -n "$pkg_path" ]] && printf '%s\t%s\t%s\n' \
      "${mod_path:-$pkg_path}" "${f:t}" "${mod_ver:-unknown}" || true
  done
}

# go_list_rows <outdated:true|false>
# Output one "binary_name\tversion[annotation]" TSV row per installed binary.
go_list_rows() {
  local outdated="${1:-false}"
  local mod_path="" bin_name="" ver="" latest=""

  go_installed_triples | while IFS=$'\t' read -r mod_path bin_name ver; do
    latest=""
    if [[ "$outdated" == true ]]; then
      latest=$(go list -m -versions "$mod_path" 2>/dev/null \
               | awk '{print $NF}' || true)
      # When there are no tagged versions, $NF is just the module path — skip it
      if [[ -n "$latest" && "$latest" != "$mod_path" && "$latest" != "$ver" ]]; then
        ver="${ver} ${PKG_C_YEL}(update available: ${latest})${PKG_C_RES}"
      fi
    fi
    printf '%s\t%s\n' "$bin_name" "$ver"
  done | sort
}

do_list() {
  local outdated=false
  while (( $# > 0 )); do
    case "$1" in
      -u|--update) outdated=true; shift ;;
      -a|--all)    shift ;;  # no-op: go has no transient-dep concept here
      *) pkg_die "unknown flag for list: $1" ;;
    esac
  done
  go_list_rows "$outdated"
}

do_sync() {
  pkg_info "Syncing go binaries..."

  local declared installed pairs before_snap after_snap
  declared=$(mktemp); installed=$(mktemp); pairs=$(mktemp)
  before_snap=$(mktemp); after_snap=$(mktemp)
  trap "rm -f '$declared' '$installed' '$pairs' '$before_snap' '$after_snap'" EXIT

  go_snapshot_versions > "$before_snap"

  pkg_manifest_read "$GOFILE" > "$declared"
  go_installed_pairs > "$pairs"
  awk -F'\t' '{print $1}' "$pairs" > "$installed"

  # Uninstall extras BEFORE installing missing — keeps swaps that share a
  # binary basename (e.g. v1→v2 path migrations) from colliding on disk.
  local bin_dir; bin_dir=$(go_bin_dir)
  pkg_diff_only_in "$installed" "$declared" | while IFS= read -r pkg; do
    [[ -z "$pkg" ]] && continue
    local bin=""
    bin=$(awk -F'\t' -v p="$pkg" '$1==p {print $2; exit}' "$pairs")
    [[ -n "$bin" && -f "$bin_dir/$bin" ]] && rm -v "$bin_dir/$bin"
  done

  # Install missing
  pkg_diff_only_in "$declared" "$installed" | while IFS= read -r pkg; do
    [[ -z "$pkg" ]] && continue
    go install "$pkg@latest" || pkg_warn "failed to install $pkg"
  done

  # Upgrade everything still declared (re-running go install fetches latest)
  while IFS= read -r pkg; do
    [[ -z "$pkg" ]] && continue
    go install "$pkg@latest" || pkg_warn "failed to upgrade $pkg"
  done < "$declared"

  # Restart services whose backing binary changed version. Keyed on binary
  # basename (matches what `system-service restart-for` resolves cmd[0] to).
  go_snapshot_versions > "$after_snap"
  local -a changed=( ${(f)"$(pkg_changed_versions "$before_snap" "$after_snap")"} )
  (( ${#changed[@]} > 0 )) && pkg_restart_services_for "${changed[@]}"
}

usage() {
  cat <<EOF
Usage:
  system-package-go list [-u|--update]
  system-package-go sync
  system-package-go -h | --help | help

Syncs \`go install\`-managed binaries against ~/.config/packages/Gofile.

Manifest entries are full module paths (e.g. \`github.com/x/y/cmd/foo\`);
binaries land in \$GOBIN (\`go env GOPATH\`/bin by default).

list flags:
  -u, --update   annotate packages with available updates (queries the module proxy)
  -a, --all      no-op (go has no transient-dep concept here)

After sync, services whose backing binary changed version and are currently
running are restarted. Matching is by binary basename, since that is what
service cmd[0] resolves to on PATH.
EOF
}

usage_list() {
  cat <<EOF
Usage:
  system-package-go list [-u|--update]

Emits TSV "<binary_name>\t<version>" rows for every \`go install\`-installed
binary in \$GOBIN.

Flags:
  -u, --update   annotate each row with the latest module version
                 (queried via \`go list -m -versions <mod>\`)
  -a, --all      no-op (go has no transient-dep concept)
EOF
}

usage_sync() {
  cat <<EOF
Usage:
  system-package-go sync

Reconciles ~/.config/packages/Gofile against the installed binaries in
\$GOBIN. Every declared module is re-installed at \`@latest\`; any binary
in \$GOBIN whose module path no longer appears in the manifest is removed.

After sync, services whose backing binary changed version and are
currently running are restarted.
EOF
}

main() {
  if [[ $# -eq 0 ]] || pkg_is_help "${1:-}"; then
    usage; exit 0
  fi
  local cmd="$1"; shift
  case "$cmd" in
    list)
      pkg_args_contain_help "$@" && { usage_list; exit 0; }
      do_list "$@"
      ;;
    sync)
      pkg_args_contain_help "$@" && { usage_sync; exit 0; }
      do_sync
      ;;
    *) usage >&2; pkg_die "unknown subcommand: $cmd" ;;
  esac
}

main "$@"
