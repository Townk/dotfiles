#!/usr/bin/env zsh
# system-package-go — sync `go install`-installed binaries against
# ~/.config/packages/Gofile. Manifest entries are full module paths, with an
# optional `@<version>` pin (e.g. `example.com/cmd/tool@v1.2.0-RC1`): pinned
# entries install/upgrade to exactly that version; unpinned ones track
# `@latest`. Note Go's `@latest` never resolves to a prerelease — an RC must
# be pinned explicitly.

set -eu -o pipefail

source "$HOME/.local/lib/system-package-common.zsh"

GOFILE="$PKG_DIR/Gofile"

go_bin_dir() {
  local bin_dir goroot mise_data_dir
  bin_dir=$(go env GOBIN 2>/dev/null)
  goroot=$(go env GOROOT)
  mise_data_dir="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}"

  # Never reconcile a Go toolchain directory. mise exports GOBIN as its
  # toolchain's bin directory, where treating undeclared binaries as extras
  # would delete `go` and `gofmt` themselves.
  if [[ -n "$bin_dir" &&
    "$bin_dir" != "$goroot/bin" &&
    "$bin_dir" != "$mise_data_dir"/installs/go/*/bin ]]; then
    printf '%s\n' "$bin_dir"
  else
    printf '%s/bin\n' "$(go env GOPATH)"
  fi
}

# Print one "<package_path>\t<binary_basename>" per line for everything in
# $GOBIN that go can identify. Skips files that aren't Go binaries (where
# `go version -m` fails).
go_installed_pairs() {
  local bin_dir
  bin_dir=$(go_bin_dir)
  [[ -d "$bin_dir" ]] || return 0
  local f="" pkg_path=""
  for f in "$bin_dir"/*(N); do
    [[ -x "$f" && -f "$f" ]] || continue
    pkg_path=$({ go version -m "$f" 2>/dev/null || true; } |
      awk '$1=="path" {print $2; exit}')
    [[ -n "$pkg_path" ]] && printf '%s\t%s\n' "$pkg_path" "${f:t}" || true
  done
}

go_list_installed() {
  go_installed_pairs | awk -F'\t' '{print $1}'
}

# go_snapshot_versions — TSV "binary_name\tversion" rows. Keys on the
# binary's basename (not the module path) because service cmd[0] resolves
# to a binary on PATH, so binary-name is what `system-service restart-for`
# will look up.
go_snapshot_versions() {
  go_installed_triples | awk -F'\t' '{print $2 "\t" $3}'
}

# go_installed_triples
# Output one "<mod_path>\t<binary_name>\t<mod_version>" row per installed binary.
# mod_path is the MODULE path (from the "mod" line), suitable for go list -m -versions.
go_installed_triples() {
  local bin_dir
  bin_dir=$(go_bin_dir)
  [[ -d "$bin_dir" ]] || return 0
  local f="" pkg_path="" mod_path="" mod_ver="" vout=""
  for f in "$bin_dir"/*(N); do
    [[ -x "$f" && -f "$f" ]] || continue
    vout=$({ go version -m "$f" 2>/dev/null || true; })
    pkg_path=$(printf '%s' "$vout" | awk '$1=="path" {print $2; exit}')
    mod_path=$(printf '%s' "$vout" | awk '$1=="mod"  {print $2; exit}')
    mod_ver=$(printf '%s' "$vout" | awk '$1=="mod"  {print $3; exit}')
    [[ -n "$pkg_path" ]] && printf '%s\t%s\t%s\n' \
      "${mod_path:-$pkg_path}" "${f:t}" "${mod_ver:-unknown}" || true
  done
}

# go_list_rows <outdated:true|false>
# Output one "binary_name\tversion[annotation]" TSV row per installed binary.
go_list_rows() {
  local outdated="${1:-false}"
  local mod_path="" bin_name="" ver="" latest=""

  go_installed_triples | while IFS=$'\t' read -r mod_path bin_name ver; do
    latest=""
    if [[ "$outdated" == true ]]; then
      latest=$(go list -m -versions "$mod_path" 2>/dev/null |
        awk '{print $NF}' || true)
      # No output means the proxy query failed; $NF being the module path
      # itself means the module has no tagged versions. Both leave the latest
      # version UNKNOWN, which has to render differently from "current" —
      # otherwise an unreachable module proxy reports the whole $GOBIN as
      # up to date.
      if [[ -z "$latest" || "$latest" == "$mod_path" ]]; then
        ver="${ver} ${C_DIM}(update check failed)${C_RES}"
      elif [[ "$latest" != "$ver" ]]; then
        ver="${ver} ${C_YEL}(update available: ${latest})${C_RES}"
      fi
    fi
    printf '%s\t%s\n' "$bin_name" "$ver"
  done | sort
}

do_list() {
  local outdated=false
  while (($# > 0)); do
    case "$1" in
      -u | --update)
        outdated=true
        shift
        ;;
      -a | --all) shift ;; # no-op: go has no transient-dep concept here
      *) die "unknown flag for list: $1" ;;
    esac
  done
  go_list_rows "$outdated"
}

do_sync() {
  pkg::sync_parse_args "$@"
  log_info "Syncing go binaries..."

  local declared declared_raw vers installed pairs before_snap after_snap package_bin_dir go_executable want
  package_bin_dir=$(go_bin_dir)
  export GOBIN="$package_bin_dir"
  go_executable="$(go env GOROOT)/bin/go"
  [[ -x "$go_executable" ]] || die "Go toolchain executable not found: $go_executable"

  pkg::tmpset declared declared_raw vers installed pairs before_snap after_snap

  go_snapshot_versions >"$before_snap"

  # Split optional `@<version>` pins off the manifest entries: $declared keeps
  # the BARE module paths (the reconciliation identity — `go version -m`
  # reports paths, never pins, so diffs/cleanup key on the path alone) and
  # $vers maps path → pinned version ("latest" when unpinned).
  pkg::manifest_read "$GOFILE" >"$declared_raw"
  while IFS= read -r entry; do
    [[ -z "$entry" ]] && continue
    local pin_path="${entry%%@*}" pin_ver="latest"
    [[ "$entry" == *@* ]] && pin_ver="${entry#*@}"
    print -r -- "$pin_path" >>"$declared"
    printf '%s\t%s\n' "$pin_path" "$pin_ver" >>"$vers"
  done <"$declared_raw"
  go_installed_pairs >"$pairs"
  awk -F'\t' '{print $1}' "$pairs" >"$installed"

  # Uninstall extras BEFORE installing missing — keeps swaps that share a
  # binary basename (e.g. v1→v2 path migrations) from colliding on disk.
  local bin_dir
  bin_dir=$(go_bin_dir)
  pkg::diff_only_in "$installed" "$declared" | while IFS= read -r pkg; do
    [[ -z "$pkg" ]] && continue
    local bin=""
    bin=$(awk -F'\t' -v p="$pkg" '$1==p {print $2; exit}' "$pairs")
    [[ -n "$bin" && -f "$bin_dir/$bin" ]] || continue
    # on-remove hooks run BEFORE the delete so a hook may invoke the binary
    # itself (e.g. `ai-playbook man uninstall`). Soft-fail, never blocks rm.
    pkg::run_hooks "$bin" "on-remove"
    rm -v "$bin_dir/$bin" || log_warn "failed to remove $bin_dir/$bin"
  done

  # Install missing (at the pinned version when one is declared)
  pkg::diff_only_in "$declared" "$installed" | while IFS= read -r pkg; do
    [[ -z "$pkg" ]] && continue
    want=$(awk -F'\t' -v p="$pkg" '$1==p {print $2; exit}' "$vers")
    spin::streamed "go: ${pkg##*/}" \
      "$go_executable" install "$pkg@${want:-latest}" || log_warn "failed to install $pkg"
  done

  # Upgrade everything still declared (re-running go install fetches the
  # pinned version — a no-op when already on it — or latest when unpinned).
  # `go install` prints nothing at all until something goes wrong or a build
  # starts talking, so each module gets a spinner through its silent stretch.
  while IFS= read -r pkg; do
    [[ -z "$pkg" ]] && continue
    want=$(awk -F'\t' -v p="$pkg" '$1==p {print $2; exit}' "$vers")
    spin::streamed "go: ${pkg##*/}" \
      "$go_executable" install "$pkg@${want:-latest}" || log_warn "failed to upgrade $pkg"
  done <"$declared"

  # Restart services whose backing binary changed version. Keyed on binary
  # basename (matches what `system-service restart-for` resolves cmd[0] to).
  go_snapshot_versions >"$after_snap"
  report::changes "$before_snap" "$after_snap" binary
  pkg::restart_changed "$before_snap" "$after_snap"
  # Fire on-change hooks (hooks.toml) for every binary whose version changed
  # this sync — installed, upgraded, or downgraded (e.g. regenerate the
  # binary's self-installed man pages/completions).
  pkg::hooks_changed "$before_snap" "$after_snap"
  return 0
}

usage() {
  cat <<EOF
Syncs \`go install\`-managed binaries against ~/.config/packages/Gofile.

Manifest entries are module paths, optionally pinned with \`@<version>\`
(e.g. example.com/cmd/tool@v1.2.0-RC1). Pinned entries install/upgrade to
exactly that version; unpinned ones track @latest (which never resolves to a
prerelease — RCs must be pinned).

Usage:
  system-package-go list [-u|--update]
  system-package-go sync [-v|--verbose]
  system-package-go -h | --help | help

Manifest entries are full module paths (e.g. \`github.com/x/y/cmd/foo\`);
binaries land in \$GOBIN (\`go env GOPATH\`/bin by default).

list flags:
  -u, --update   annotate packages with available updates (queries the module proxy)
  -a, --all      no-op (go has no transient-dep concept here)

sync flags:
  -v, --verbose  also report expected, nothing-to-do outcomes

After sync, services whose backing binary changed version and are currently
running are restarted. Matching is by binary basename, since that is what
service cmd[0] resolves to on PATH.
EOF
}

usage_list() {
  cat <<EOF
Usage:
  system-package-go list [-u|--update]

Emits TSV "<binary_name>\t<version>" rows for every \`go install\`-installed
binary in \$GOBIN.

Flags:
  -u, --update   annotate each row with the latest module version
                 (queried via \`go list -m -versions <mod>\`)
  -a, --all      no-op (go has no transient-dep concept)
EOF
}

usage_sync() {
  cat <<EOF
Usage:
  system-package-go sync [-v|--verbose]

Flags:
  -v, --verbose  also report expected, nothing-to-do outcomes that a routine
                 sync keeps quiet

Reconciles ~/.config/packages/Gofile against the installed binaries in
\$GOBIN. Every declared module is re-installed at \`@latest\`; any binary
in \$GOBIN whose module path no longer appears in the manifest is removed.

After sync, services whose backing binary changed version and are
currently running are restarted.
EOF
}

main() {
  if [[ $# -eq 0 ]] || is_help "${1:-}"; then
    usage
    exit 0
  fi
  local cmd="$1"
  shift
  case "$cmd" in
    list)
      args_contain_help "$@" && {
        usage_list
        exit 0
      }
      do_list "$@"
      ;;
    sync)
      args_contain_help "$@" && {
        usage_sync
        exit 0
      }
      do_sync "$@"
      ;;
    *)
      usage >&2
      die "unknown subcommand: $cmd"
      ;;
  esac
}

main "$@"
