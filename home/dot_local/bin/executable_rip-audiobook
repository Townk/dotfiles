#!/usr/bin/env zsh
# rip-audiobook — acquire audiobooks from a provider and push them to
# cantina as ONE observable job:: job. Thin by design: behavior lives in
# rip.zsh (the rip-disc pattern).
#
#   rip-audiobook --library                 provider rows, JSON lines
#   rip-audiobook --server-library          <Author>/<Title> cantina holds
#   rip-audiobook --have "<Author>/<Title>" 0 have / 1 absent / 2 unknown
#   rip-audiobook --import <path> <Author> <Title> stage a DRM-free file you already have
#   rip-audiobook --session <plan.json>     enqueue a session
#   rip-audiobook --retire "<Author>/<Title>" [--apply]  remove one stored book
#   rip-audiobook --canonicalize-authors [--apply]      collapse author spelling variants
#   rip-audiobook --repair-sidecars [--apply]           report + repair missing/empty book identity
#   rip-audiobook --repair-companions [--apply]         record the PDFs/covers stored books already carry
#   rip-audiobook --adopt-asin "<Author>/<Title>" <ASIN> [--apply]  confirm one proposed ASIN
#   rip-audiobook --at-risk                 stored books that can never be re-acquired
#   rip-audiobook --server-editions         stored books with a published date, JSON lines
#   rip-audiobook --session-worker <plan>   internal: the job body
#
# --provider <name> selects the provider (default: libation).

set -eu -o pipefail

RIP_LIB_DIR="${RIP_LIB_DIR:-$HOME/.local/lib}"
source "$RIP_LIB_DIR/rip.zsh" || {
  print -ru2 -- "rip-audiobook: cannot source rip.zsh from $RIP_LIB_DIR"
  exit 1
}

provider=""
if [[ "${1:-}" == "--provider" ]]; then
  shift
  provider="${1:?--provider: name required}"
  shift
fi

case "${1:-}" in
  --library) rip::ab_library "$provider" ;;
  --server-library) rip::ab_server_library ;;
  --have) shift; rip::ab_have "${1:?book path required}" ;;
  --import) shift; rip::ab_import "${1:?source path required}" "${2:?author required}" "${3:?title required}" ;;
  --session) shift; rip::ab_enqueue "${1:?plan file required}" ;;
  --session-worker) shift; rip::ab_worker "${1:?plan file required}" ;;
  --editions) rip::ab_editions ;;
  --backfill-published) shift; rip::ab_backfill_published "${1:-}" ;;
  --retire) shift; rip::ab_retire "${1:?--retire: \"<Author>/<Title>\" required}" "${2:-}" ;;
  --canonicalize-authors) shift; rip::ab_canonicalize_authors "${1:-}" ;;
  --repair-sidecars) shift; rip::ab_repair_sidecars "${1:-}" ;;
  --repair-companions) shift; rip::ab_repair_companions "${1:-}" ;;
  --adopt-asin) shift; rip::ab_adopt_asin "${1:?--adopt-asin: \"<Author>/<Title>\" required}" "${2:?--adopt-asin: ASIN required}" "${3:-}" ;;
  --at-risk) rip::ab_at_risk ;;
  --server-editions) rip::_server_sidecars | jq -c 'select((.published // "") != "") | {author:(.authors[0] // ""), title:(.title // ""), published, path:._path}' ;;
  "" | --help)
    print -ru2 -- 'usage: rip-audiobook [--provider <name>] --library | --server-library | --have "<Author>/<Title>" | --import <path> "<Author>" "<Title>" | --session <plan.json> | --editions | --backfill-published [--apply] | --retire "<Author>/<Title>" [--apply] | --canonicalize-authors [--apply] | --repair-sidecars [--apply] | --repair-companions [--apply] | --adopt-asin "<Author>/<Title>" <ASIN> [--apply] | --at-risk | --server-editions'
    exit 2
    ;;
  *) print -ru2 -- "rip-audiobook: unknown option: $1"; exit 2 ;;
esac
