#!/usr/bin/env zsh
# qmk-flash — pick up the keyboard's freshly built firmware and install it on
# both halves, over the in-firmware updater when the board runs one and over
# USB in the UF2 bootloader when it does not.
#
# The successor to the hand-run `wait-until … && scp` snippet. What it adds is
# mostly about knowing what you are about to flash BEFORE you touch the board:
# it resolves the NEWEST matching build and reports its age (a forgotten
# rebuild is the failure this catches), then validates it — only then does it
# go near the board.
#
# THE UPDATER (the default). The firmware is an updater build: a running half
# takes a new image over raw HID, and the half with USB relays the other half's
# image over the split cable, so one `sval_update.py pair LEFT.svup RIGHT.svup`
# installs both halves with no reset button and no cable swap. It ALWAYS
# installs both, and that is upstream's constraint rather than a preference:
# updater builds of different commits cannot talk over the split link, so a
# keyboard with one half updated types on one side only. Hence the checks that
# bracket the install. Before it, both .svup files must carry the SAME build
# version string — the firmware's own presence check compares only the upstream
# release, which two different builds of this repo share. After it, the version
# the board reports must be the one that was sent. A failure in between is
# reported as what it may have left behind: halves on different builds, with
# the way out (rerun, or BOOTSEL).
#
# The updater scripts belong to the firmware they talk to, so they are taken
# from beside the .svup files (the build copies them out of the same upstream
# checkout) rather than from a copy of their own. They run through uv with
# hidapi, so no Mac needs a Python package installed by hand.
#
# BOOTSEL (the fallback, and `--bootsel`). When the board does not answer as an
# updater build — the one-time migration from older firmware, a half left in
# BOOTSEL by an interrupted update — the .uf2 images go over the RP2040's UF2
# bootloader instead, one half at a time. The firmware for every half is
# resolved and validated up front, so the hands-on part (reset, then swap the
# USB cables over for the left half) is one uninterrupted stretch with no
# waiting mixed in.
#
# The image is NOT copied onto the bootloader drive. The drive is unmounted and
# the flash goes over the RP2040's PICOBOOT interface via picotool, which buys
# two things the file copy could not. It VERIFIES the written flash and returns
# a status that means something, where a copy could only infer success from the
# drive disappearing (the bootloader reboots the instant the last UF2 block
# lands, so the copy itself usually ends in a spurious I/O error). And because
# nothing is mounted when the board reboots, macOS stops posting "Disk Not
# Ejected Properly" every single flash — that notification fires only when a
# MOUNTED volume's device vanishes, which an A/B test on macOS 26.6.1
# confirmed. The drive is still what we wait for: it is proof the board reached
# BOOTSEL and that the auto-mount settled, and picotool's own `info` segfaults
# on this OS version, so it is no use as a probe.
#
# The firmware comes from THIS machine by default (host `localhost`), which is
# the machine that builds it. A machine that flashes a board while building
# elsewhere says so in its config file — see `--help`. The two paths differ only
# in how the files are obtained: locally they are globbed and used in place,
# with no ssh hop and no copy.
#
# A MAC WITH NO BUILD OF ITS OWN takes its firmware from a GitHub release
# instead (`--release [TAG]`): the release carries the same .svup, .uf2 and
# updater files the build produces, so once downloaded into a scratch directory
# the rest of the run treats that directory as the local firmware dir.
#
# Usage: qmk-flash [left|right|both] [--bootsel] [--host HOST] [--dir DIR]
#                  [--release [TAG]] [--timeout SECS]
emulate -L zsh
set -uo pipefail
zmodload zsh/datetime
zmodload -F zsh/stat b:zstat

source "$HOME/.local/lib/common.zsh" || {
  print -ru2 -- "qmk-flash: cannot source common.zsh"
  exit 1
}

# Defaults; config.toml folds over these, and flags over that.
host=localhost
firmware_dir=Projects/platforms/keyboards/qmk-config
timeout=120

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/qmk-flash/config.toml"

usage() {
  cat <<EOF
Usage: qmk-flash [left|right|both] [--bootsel] [--host HOST] [--dir DIR]
                 [--release [TAG]] [--timeout SECS]

Resolve the newest matching firmware and install it on the keyboard.

By default both halves are updated in place over the in-firmware updater, with
no reset button and no cable swap. The updater always installs both: halves on
different builds cannot talk to each other, so naming one half is refused
there. Close any raw-HID app that talks to the board, such as Keybard, first:
the updater's replies go to every open handle. (The overlay's own reader,
svalwatch, is paused and resumed for you through Hammerspoon.)

When the board does not answer as an updater build (older firmware, a half
stuck in BOOTSEL), it falls back to the UF2 bootloader: double-click RESET on
each half, right then left, so the wait for the left half's drive is where you
swap the USB cables over. \`--bootsel\` goes straight there, and is the one way
to flash a single half — which must end up on the same build as the other.

  --bootsel        skip the updater and flash over the UF2 bootloader
  --host HOST      machine holding the firmware; \`localhost\` (the default)
                   reads it straight off this machine with no ssh hop
  --dir DIR        firmware directory, absolute or relative to HOME on whichever
                   machine --host names
  --release [TAG]  take the firmware from a GitHub release of Townk/qmk-config
                   (the latest, or TAG such as v1.0.35) instead of a build;
                   needs gh, and excludes --host
  --timeout SECS   how long to wait for a bootloader drive, or for the board to
                   answer again after an update
  -h, --help       show this help

The update for a half is the newest file matching *_<half>_*.svup (or
*.<half>.svup) in DIR, with sval_update.py and make_update.py beside it; its
BOOTSEL firmware is the newest *_<half>_*.uf2 there.

Defaults come from \$XDG_CONFIG_HOME/qmk-flash/config.toml when it exists, and
flags override it. Every key is optional:

    host    = "buildbox.local"
    dir     = "Projects/keyboards/qmk-config"
    timeout = 180

Current effective defaults: host=${host} dir=${firmware_dir} timeout=${timeout}

Examples:
  qmk-flash
  qmk-flash --release
  qmk-flash --release v1.0.35
  qmk-flash --bootsel both
  qmk-flash --bootsel right --timeout 300
EOF
}

# --- configuration ----------------------------------------------------------

# config_load — fold config.toml over the built-in defaults. Read through yq+jq
# exactly as services.toml and images.toml are (system-service-common,
# system-images), so this repo has ONE config idiom rather than a second
# hand-rolled parser. A missing file is the normal case: the defaults already
# describe a machine that builds its own firmware, so only a machine fetching
# from elsewhere has anything to say. An unknown key is reported rather than
# ignored — this file is hand-edited, and a silent typo would look like the
# setting simply not working.
config_load() {
  [[ -r "$CONFIG" ]] || return 0
  require_cmd yq jq
  local json key val
  json=$(yq -p toml -o json '.' "$CONFIG" 2>/dev/null) || die "cannot parse ${CONFIG}"
  while IFS=$'\t' read -r key val; do
    case "$key" in
      host) host=$val ;;
      dir) firmware_dir=$val ;;
      timeout) timeout=$val ;;
      *) log_warn "ignoring unknown key in ${CONFIG}: ${key}" ;;
    esac
  done < <(jq -r 'to_entries[] | select(.value != null and .value != "")
                  | "\(.key)\t\(.value)"' <<<"$json")
}

# --- helpers ----------------------------------------------------------------

# Every ssh/rsync hop runs at LogLevel=ERROR: this host's ssh config sets up a
# remote forward that the build host often refuses ("Warning: remote port
# forwarding failed for listen port …"), and that warning is pure noise here —
# left in, it reads like the transfer failed.
SSH=(ssh -o LogLevel=ERROR)

# The updater scripts' Python. `--no-project` because they are run from a
# firmware checkout (or a scratch dir) whose own pyproject, if any, is not
# theirs; `--with hidapi` is their one dependency, resolved into uv's cache on
# first use so no Mac needs it installed by hand; `-I` keeps the current
# directory and PYTHON* variables out of their import path. sval_update.py
# finds make_update.py on its own (it puts its directory on sys.path); the
# inline snippet in svup_version says so explicitly.
UVPY=(uv run --no-project --quiet --with hidapi python -I)

RELEASE_REPO=Townk/qmk-config

is_local() { [[ "$host" == localhost ]] }

# uf2_drive — the mount point of an attached UF2 bootloader drive, if any.
uf2_drive() {
  local -a hits=(/Volumes/*/INFO_UF2.TXT(N))
  (($#hits)) || return 1
  print -r -- "${hits[1]:h}"
}

# human_age <epoch> — "just now" / "7m ago" / "3h ago" / "2d ago". Rounded and
# single-unit on purpose: this answers "is this the build I just made?", and no
# finer resolution than that changes the decision.
human_age() {
  local -i secs=$((EPOCHSECONDS - $1))
  ((secs < 90)) && {
    print -r -- "just now"
    return
  }
  ((secs < 5400)) && {
    print -r -- "$(((secs + 30) / 60))m ago"
    return
  }
  ((secs < 172800)) && {
    print -r -- "$(((secs + 1800) / 3600))h ago"
    return
  }
  print -r -- "$(((secs + 43200) / 86400))d ago"
}

# firmware_path — $firmware_dir as an absolute path.
firmware_path() {
  case "$firmware_dir" in
    /*) print -r -- "$firmware_dir" ;;
    *) print -r -- "$HOME/$firmware_dir" ;;
  esac
}

# fw_pattern <half> <ext> — how one half's file of type <ext> (uf2 or svup) is
# recognised: FW_GLOB for the local directory, FW_REGEX (an ERE) for the remote
# listing. The .svup pattern also takes `.<half>.`, the spelling of the release
# assets (svalboard-…-v1.0.35.left.svup), next to the local build's
# `_<half>_`; the .uf2 one takes both spellings too, so a downloaded release
# can feed the BOOTSEL fallback.
fw_pattern() {
  local half=$1
  case $2 in
    uf2)
      FW_GLOB="*[_.]${half}(_*|).uf2"
      FW_REGEX="[_.]${half}(_.*)?[.]uf2"
      ;;
    svup)
      FW_GLOB="*[_.]${half}(_*|).svup"
      FW_REGEX="[_.]${half}(_.*)?[.]svup"
      ;;
  esac
}

# resolve_local <half> [ext] — newest matching .uf2 (or .svup) in the local
# firmware dir. Sets FW_NAME, FW_EPOCH and FW_LOCAL (the file itself: nothing
# needs copying).
resolve_local() {
  local half=$1 ext=${2:-uf2} dir
  dir=$(firmware_path)
  [[ -d "$dir" ]] || die "no such directory: ${dir}"
  fw_pattern "$half" "$ext"
  # (N) nullglob, (.) regular files only, (om) newest first; ${~…} so the
  # pattern held in a variable is globbed rather than taken literally.
  local -a hits=("$dir"/${~FW_GLOB}(N.om))
  (($#hits)) || die "no ${half}-half firmware (*_${half}_*.${ext}) in ${dir}"
  FW_LOCAL=${hits[1]}
  FW_NAME=${FW_LOCAL:t}
  FW_EPOCH=$(zstat +mtime -- "$FW_LOCAL")
}

# resolve_remote <half> [ext] — same, over ssh. Sets FW_NAME and FW_EPOCH.
resolve_remote() {
  local half=$1 ext=${2:-uf2} line rc=0
  fw_pattern "$half" "$ext"
  # Filtered with grep rather than a remote glob: the build host's login shell
  # is zsh, where an unmatched glob is an error raised BEFORE ls runs — so `ls
  # … 2>/dev/null` cannot swallow it and "no matches found" leaks into our own
  # error path. Listing the directory and filtering never expands a pattern.
  line=$("${SSH[@]}" "$host" "cd ${(q)firmware_dir} 2>/dev/null || exit 3
f=\$(ls -t | grep -E '${FW_REGEX}\$' | head -1)
[ -n \"\$f\" ] || exit 4
printf '%s\t%s\n' \"\$(date -r \"\$f\" +%s)\" \"\$f\"") || rc=$?
  case $rc in
    0) ;;
    3) die "no such directory on ${host}: ${firmware_dir}" ;;
    4) die "no ${half}-half firmware (*_${half}_*.${ext}) in ${host}:${firmware_dir}" ;;
    *) die "cannot reach ${host} (ssh exit ${rc})" ;;
  esac
  FW_EPOCH=${line%%$'\t'*}
  FW_NAME=${line#*$'\t'}
}

# pull_remote — copy the resolved remote file into this run's scratch dir (which
# common.zsh sweeps on exit). Sets FW_LOCAL.
pull_remote() {
  FW_LOCAL=$(common::tmpfile) || die "cannot create a scratch file"
  # -s (--protect-args) so the remote shell never re-splits the name.
  rsync -s -e "${SSH[*]}" --info=progress2 --human-readable -- \
    "${host}:${firmware_dir}/${FW_NAME}" "$FW_LOCAL" ||
    die "could not fetch ${FW_NAME} from ${host}"
}

# check_uf2 — "UF2\n" + the 0x9E5D5157 second magic word. Checked before the
# board is ever put into bootloader mode, and before picotool is asked to parse
# it: a truncated or wrong-format file should cost a diagnostic, not a reset.
check_uf2() {
  [[ $(head -c 8 -- "$FW_LOCAL" | xxd -p) == 5546320a57515d9e ]] ||
    die "${FW_NAME} is not a UF2 image (bad magic) — refusing to flash it"
}

# fetch <half> — make this half's firmware available locally and validate it.
# Sets FW_NAME and FW_LOCAL.
fetch() {
  local half=$1
  if is_local; then
    resolve_local "$half"
  else
    resolve_remote "$half"
  fi
  log_info "${half}: ${C_BWH}${FW_NAME}${C_RES} ${C_DIM}(built $(human_age "$FW_EPOCH"))${C_RES}"
  is_local || pull_remote
  check_uf2
}

# await_drive <half> — the reset prompt and the bounded wait for the drive.
# Sets DRIVE; rc 1 on timeout. The poll runs in a subshell so the spinner can
# animate in this one (spin::wait needs a pid, poll::until has no output of its
# own); DRIVE is a global rather than stdout because log_info writes to stdout
# too and a `$(…)` capture here would swallow the narration.
await_drive() {
  local half=$1 pid
  if DRIVE=$(uf2_drive); then
    log_info "bootloader drive already mounted: ${DRIVE}"
    return 0
  fi

  print
  print -r -- "  ${C_BWH}Double-click the RESET button on the ${half:u} half.${C_RES}"
  print -r -- "  ${C_DIM}Flashing starts on its own the moment the bootloader drive appears.${C_RES}"
  print
  notify --icon glyph:nf-md-gesture_double_tap --sound Tink \
    "Double-click RESET on the ${half:u} half" >/dev/null 2>&1 || true

  (poll::until "$timeout" 0.4 uf2_drive >/dev/null) &
  pid=$!
  spin::wait $pid "waiting for the ${half} half's bootloader drive…"
  wait $pid || return 1
  DRIVE=$(uf2_drive) || return 1
  # The spinner's row is gone the instant the poll ends, so say what ended it.
  # Without this the only evidence the reset was even noticed is the spinner
  # vanishing, which is indistinguishable from it having died.
  log_ok "bootloader drive up: ${DRIVE}"
}

# flash <half> <file> <name>
flash() {
  local half=$1 file=$2 name=$3
  await_drive "$half" ||
    die "no bootloader drive appeared within ${timeout}s — is the ${half} half plugged in?"

  # Unmounting is what keeps macOS quiet about the reboot that follows, so it is
  # a hard failure rather than something to shrug off: flashing with the volume
  # still mounted works, but earns the eject warning this exists to avoid.
  #
  # Behind a spinner because it takes seconds and says nothing until it is done.
  # It is the first of the two silent stretches between the reset and the first
  # block landing, and an unbroken spinner across both is what keeps them from
  # reading as a hang. spin::quiet still surfaces diskutil's output when it
  # fails, and drops its "Volume … unmounted" line when it does not.
  spin::quiet "unmounting ${DRIVE:t}…" diskutil unmount "$DRIVE" ||
    die "could not unmount ${DRIVE} — something is holding it open"

  # -t uf2 because picotool infers the file type from the EXTENSION, and a
  # scratch copy is a mktemp name with none.
  #
  # Streamed rather than run live: opening the PICOBOOT interface is the second
  # silent stretch, so the spinner covers it and then gets out of the way the
  # instant picotool speaks — its progress and verification are the point and
  # nothing is withheld. The progress bar survives the pipe spin::stream mirrors
  # through: picotool writes each update with an explicit flush and never asks
  # whether it has a tty (picotool 2.3.0, main.cpp progress_bar::progress).
  spin::streamed "flashing the ${half} half…" \
    picotool load -v -x -t uf2 "$file" || {
    notify --icon glyph:nf-md-alert --sound Basso "${half:u} half NOT flashed" \
      >/dev/null 2>&1 || true
    die "picotool could not flash ${name} — double-click RESET on the ${half} half and rerun (the drive is unmounted now, so a rerun needs a fresh reset)"
  }

  log_ok "${half} half flashed and verified — rebooted into ${name}"
  notify --icon glyph:nf-md-check --sound Glass "${half:u} half flashed" \
    >/dev/null 2>&1 || true
}

# --- the in-firmware updater -----------------------------------------------

# overlay <call> <verb> — pause or resume the overlay's raw-HID reader
# (svalwatch) through Hammerspoon. It holds the board's raw-HID interface open
# all the time, and the updater's replies go to every open handle; going
# through Hammerspoon rather than killing it is what keeps its restart logic
# from undoing the kill, or counting it as a crash. Best effort on purpose: an
# overlay that could not be paused is a risk to the flash, not a reason to
# refuse it, and an `hs` that is missing (or a Hammerspoon that is not running)
# must not stand between the owner and a flash. -t 3 bounds the IPC round trip.
overlay() {
  "${HS:-hs}" -t 3 -c "require(\"svalboard\").$1" >/dev/null 2>&1 ||
    log_warn "could not ${2} the overlay (svalwatch) through Hammerspoon"
}

# overlay_pause / overlay_resume — overlay, plus the bookkeeping that lets
# every way out of the paused window (success, failure, the BOOTSEL fallback,
# a signal) resume exactly once. The flag is raised BEFORE the hs call, so a
# Ctrl-C landing during the pause itself still resumes.
OVERLAY_PAUSED=0
overlay_pause() {
  OVERLAY_PAUSED=1
  overlay 'pause(300)' pause
}
overlay_resume() {
  ((OVERLAY_PAUSED)) || return 0
  OVERLAY_PAUSED=0
  overlay 'resume()' resume
}

# fetch_release [TAG] — download a release's update files, firmware and updater
# scripts into a scratch directory (the exit sweep takes it along, as with
# pull_updates), then point the run at it as if it were a local firmware dir:
# every resolver below then globs it with no further special case. Without a
# tag, gh takes the latest release.
fetch_release() {
  local tag=$1 label=${1:-the latest release}
  local -a tagarg=()
  [[ -n $tag ]] && tagarg=("$tag")
  UP_DIR=$(common::tmpfile) && rm -f -- "$UP_DIR" && mkdir -- "$UP_DIR" ||
    die "cannot create a scratch directory"
  log_info "downloading ${label} of ${RELEASE_REPO}…"
  gh release download "${tagarg[@]}" -R "$RELEASE_REPO" \
    -p '*.svup' -p '*.uf2' -p 'sval_update.py' -p 'make_update.py' -D "$UP_DIR" ||
    die "could not download ${label} of ${RELEASE_REPO} — is the tag right, and is gh logged in?"
  host=localhost
  firmware_dir=$UP_DIR
}

# pull_updates <left.svup> <right.svup> — copy both update files and both
# updater scripts from the build host into ONE scratch directory, the layout
# the scripts expect (sval_update.py imports make_update.py from its own
# directory). Sets UP_DIR. The directory is carved out of common.zsh's
# per-run scratch dir, so the exit sweep takes it along; a tmpfile name is
# swapped for a directory of the same name because that dir is private to
# this process and nothing can race for the name in between.
pull_updates() {
  local f
  local -a src=()
  UP_DIR=$(common::tmpfile) && rm -f -- "$UP_DIR" && mkdir -- "$UP_DIR" ||
    die "cannot create a scratch directory"
  for f in "$@" sval_update.py make_update.py; do
    src+=("${host}:${firmware_dir}/${f}")
  done
  # One rsync for all four, so one ssh connection; -s as in pull_remote.
  rsync -s -e "${SSH[*]}" --info=progress2 --human-readable -- \
    "${src[@]}" "$UP_DIR/" ||
    die "could not fetch the update files (and sval_update.py, make_update.py) from ${host}"
}

# svup_version <file> — the build version string a .svup carries in its
# manifest, read offline with the make_update.py that sits beside it. Parsing
# the file this far doubles as the check that it IS an update file at all.
svup_version() {
  "${UVPY[@]}" -c 'import sys
sys.path.insert(0, sys.argv[1])
import make_update as m
print(m.manifest_version(m.parse_manifest(m.parse_svup(open(sys.argv[2], "rb").read())[0])))' \
    "$UP_DIR" "$1"
}

# resolve_updates — the newest .svup for each half, both updater scripts, and
# the build version both halves are about to get. Sets UP_DIR (the ONE
# directory holding all four: the firmware dir itself locally, a scratch copy
# with --host), UP_LEFT, UP_RIGHT and UP_VERSION. Everything here happens
# before the board is touched, and a mismatch between the halves stops it
# right here — after the probe would already be too late to be cheap.
resolve_updates() {
  local half f left right
  local -A name
  for half in left right; do
    if is_local; then
      resolve_local "$half" svup
    else
      resolve_remote "$half" svup
    fi
    log_info "${half}: ${C_BWH}${FW_NAME}${C_RES} ${C_DIM}(built $(human_age "$FW_EPOCH"))${C_RES}"
    name[$half]=$FW_NAME
  done
  if is_local; then
    UP_DIR=$(firmware_path)
  else
    pull_updates "${name[left]}" "${name[right]}"
  fi
  UP_LEFT=$UP_DIR/${name[left]}
  UP_RIGHT=$UP_DIR/${name[right]}
  for f in sval_update.py make_update.py; do
    [[ -r "$UP_DIR/$f" ]] ||
      die "no ${f} beside the update files in ${UP_DIR} — the build puts it there, so rebuild"
  done

  left=$(svup_version "$UP_LEFT") && [[ -n $left ]] ||
    die "cannot read the build version of ${name[left]} — is it an update file?"
  right=$(svup_version "$UP_RIGHT") && [[ -n $right ]] ||
    die "cannot read the build version of ${name[right]} — is it an update file?"
  # The board's own presence check would let two different builds of the same
  # upstream release through, so this is the check that keeps a stale .svup
  # (only one half rebuilt) from splitting the keyboard.
  [[ $left == "$right" ]] ||
    die "the halves are from different builds (left ${left}, right ${right}) — rebuild so both come from the same build"
  UP_VERSION=$left
}

# updater_info — ask the USB half for its updater INFO. Succeeds, setting
# INFO_JSON, only when sval_update.py exits 0 AND reports protocol 4 or later:
# earlier updaters lack the INFO page that carries the version string, so the
# read-back could never confirm what they installed. stderr is dropped because
# a board on non-updater firmware answers with a traceback, and that is the
# normal case the BOOTSEL fallback exists for, not an error to show.
updater_info() {
  local json
  json=$("${UVPY[@]}" "$UP_DIR/sval_update.py" info 2>/dev/null) || return 1
  jq -e '(.protocol // 0) >= 4' <<<"$json" >/dev/null 2>&1 || return 1
  INFO_JSON=$json
}

# probe — updater_info behind a spinner (uv's first run resolves hidapi, which
# takes long enough to look like a hang). The subshell is what lets the
# spinner animate here; nothing from INFO_JSON is needed yet.
probe() {
  local pid
  (updater_info) &
  pid=$!
  spin::wait $pid "asking the board whether it runs the updater…"
  wait $pid
}

# readback — wait, up to --timeout, for the board to answer again after the
# install, and set INFO_JSON from that answer. `pair` already waited for both
# halves to report the same release, so this normally answers at once; the
# bound is for a USB re-enumeration that is slow to settle. Polled in a
# subshell for the spinner (as await_drive does), so the answer comes back
# through a scratch file.
readback() {
  local pid out
  out=$(common::tmpfile) || return 1
  (poll::until "$timeout" 1 updater_info && print -r -- "$INFO_JSON" >"$out") &
  pid=$!
  spin::wait $pid "reading the build back from the board…"
  wait $pid || return 1
  INFO_JSON=$(<"$out")
}

# updater_failed <what> — the loud failure for anything that went wrong once
# the install had started: by then either half may have taken the new build,
# so what it says is what the keyboard may be left as and how to finish.
UPDATER_SPLIT="the halves may now run different builds and cannot talk to each other; rerun qmk-flash to finish, or flash over BOOTSEL: qmk-flash --bootsel both"
updater_failed() {
  notify --icon glyph:nf-md-alert --sound Basso "Svalboard update NOT finished" \
    >/dev/null 2>&1 || true
  die "${1} — ${UPDATER_SPLIT}"
}

# on_signal <status> — the INT/TERM handler for the whole paused window, from
# the pause before the probe to the end of the read-back. zsh runs neither an
# `always` block nor (on TERM) the EXIT trap when a signal ends the script, so
# without this a Ctrl-C mid-update would leave the overlay paused until its
# 300s cap AND drop the one message that matters: once pair has started, the
# halves may be on different builds. Exits 130/143, the shell's own codes.
#
# PAIR_STATE says which message is true: 1 while pair runs, 2 once it has
# returned (the read-back). An interrupted pair does not ABORT its session
# (sval_update.py only does that for its own errors, not a KeyboardInterrupt),
# and the board refuses a new one as BUSY until the stalled session times out,
# which it does after 30 s with no op (docs/updater.md) — hence the wait
# before the rerun.
#
# Everything it says goes to SIGNAL_STDERR, a copy of the real stderr taken
# when the traps are armed: the signal can be taken while a builtin with its
# own `2>/dev/null` is running (the spinners' `kill -0` probe, during the
# probe and the read-back), and a trap inherits that redirection, so a plain
# log_error would vanish.
PAIR_STATE=0
on_signal() {
  {
    print
    overlay_resume
    if ((PAIR_STATE)); then
      notify --icon glyph:nf-md-alert --sound Basso "Svalboard update interrupted" \
        >/dev/null 2>&1 || true
    fi
    case $PAIR_STATE in
      1) log_error "the update was interrupted mid-install — the halves may now run different builds and cannot talk to each other; wait 30s for the board to drop the interrupted session, then rerun qmk-flash to finish, and a half that shows up as RPI-RP2 goes through BOOTSEL: qmk-flash --bootsel <half>" ;;
      2) log_error "interrupted before the build could be read back — ${UPDATER_SPLIT}" ;;
    esac
  } 2>&$SIGNAL_STDERR
  exit "$1"
}

# flash_updater — install both halves over the updater, then confirm the build
# the board reports is the one that was sent.
flash_updater() {
  local rc=0 got
  # The overlay is already paused: the run paused it before the probe.
  #
  # pair updates the other half first (relayed over the split link), then the
  # USB half, then waits for both to report the same release; --yes because
  # the only question it asks is about images built for another pointing
  # device, and these were built for this board.
  #
  # Run in the FOREGROUND, not behind spin::streamed: a spinner's command is a
  # background job, and a non-interactive shell starts background jobs with
  # SIGINT ignored, so a Ctrl-C would end qmk-flash while pair carried on
  # flashing, orphaned, against an overlay that was already resumed. In the
  # foreground it gets the Ctrl-C itself and stops (KeyboardInterrupt); the
  # shell holds its own INT trap until pair has exited, and on_signal then
  # says what was left behind. No spinner is lost that matters: pair prints
  # its own progress from the first chunk.
  #
  # The resume sits in an `always` block so a failed pair still gives the
  # overlay back. Nothing in the try block may exit (zsh skips `always` on
  # exit), hence the status is carried out in rc and acted on after. Signals
  # skip `always` too; on_signal covers those, and a SIGKILL, which nothing
  # can catch, is covered by the pause itself lifting on its own after 300s.
  log_info "updating both halves over the updater (left ${UP_LEFT:t}, right ${UP_RIGHT:t})…"
  PAIR_STATE=1
  {
    "${UVPY[@]}" "$UP_DIR/sval_update.py" pair "$UP_LEFT" "$UP_RIGHT" --yes || rc=$?
  } always {
    overlay_resume
  }
  PAIR_STATE=2
  ((rc == 0)) || updater_failed "sval_update.py pair failed (exit ${rc})"

  readback || updater_failed "the board did not answer within ${timeout}s after the update"
  got=$(jq -r '.version // empty' <<<"$INFO_JSON")
  [[ $got == "$UP_VERSION" ]] ||
    updater_failed "the board reports build ${got:-(none)} after the update, not ${UP_VERSION}"

  log_ok "both halves updated — running ${UP_VERSION}"
  notify --icon glyph:nf-md-check --sound Glass "Svalboard updated (${UP_VERSION})" \
    >/dev/null 2>&1 || true
}

# --- BOOTSEL ----------------------------------------------------------------

# both_named — true when the halves to flash include both (`both`, or `left
# right` spelt out in either order).
both_named() { ((${halves[(I)left]} && ${halves[(I)right]})) }

# run_bootsel — today's path: every half's .uf2 resolved and validated, then
# one reset-and-flash per half.
run_bootsel() {
  local half
  require_cmd picotool diskutil xxd
  # A single half is the recovery case (one half stuck as RPI-RP2), and it is
  # allowed only because the owner named it; the keyboard works again only
  # once the other half runs the same build.
  both_named ||
    log_warn "the other half must end up on this same build, or the halves cannot talk"

  # Resolve everything first: nothing asks for a button press until every
  # image is on this machine and known good.
  typeset -A fw_file fw_name
  for half in $halves; do
    fetch "$half"
    fw_file[$half]=$FW_LOCAL
    fw_name[$half]=$FW_NAME
  done

  for half in $halves; do
    flash "$half" "${fw_file[$half]}" "${fw_name[$half]}"
  done
}

# --- arguments --------------------------------------------------------------

# The config is read BEFORE help is answered, because usage() reports the
# effective defaults and a help screen that misreports the host it will actually
# use is worse than one that fails: an unparseable config then says so by name,
# which is the thing you needed to know anyway.
config_load

{ is_help "${1:-}" || args_contain_help "$@" } && {
  usage
  exit 0
}

halves=()
bootsel=0
release=0
release_tag=
host_given=0
while (($#)); do
  case "$1" in
    left | l)
      halves+=(left)
      shift
      ;;
    right | r)
      halves+=(right)
      shift
      ;;
    both | all)
      halves=(right left)
      shift
      ;;
    --bootsel)
      bootsel=1
      shift
      ;;
    --host)
      [[ -n ${2:-} ]] || die "--host needs a value"
      host=$2
      host_given=1
      shift 2
      ;;
    --host=*)
      host=${1#--host=}
      host_given=1
      shift
      ;;
    --release)
      release=1
      # A value that is not a flag is the tag; a bare --release is "latest".
      if [[ -n ${2:-} && $2 != -* ]]; then
        release_tag=$2
        shift
      fi
      shift
      ;;
    --release=*)
      release=1
      release_tag=${1#--release=}
      shift
      ;;
    --dir)
      [[ -n ${2:-} ]] || die "--dir needs a value"
      firmware_dir=$2
      shift 2
      ;;
    --dir=*)
      firmware_dir=${1#--dir=}
      shift
      ;;
    --timeout)
      [[ -n ${2:-} ]] || die "--timeout needs a value"
      timeout=$2
      shift 2
      ;;
    --timeout=*)
      timeout=${1#--timeout=}
      shift
      ;;
    *)
      log_error "unknown argument: $1"
      usage >&2
      exit 2
      ;;
  esac
done

[[ $timeout == <-> ]] || die "--timeout takes whole seconds, got: ${timeout}"
# Both halves by default, on either path: the updater installs both anyway,
# and over BOOTSEL a single half is the exception you name. Right first, so the
# BOOTSEL wait for the left half's drive is where the cables get swapped.
((${#halves})) || halves=(right left)

# Refused up front, before the probe: one half is a BOOTSEL-only operation, so
# it is asked for by name (--bootsel) rather than reached by the accident of a
# probe that happened to fail, and saying so costs nothing on the board.
((bootsel)) || both_named ||
  die "the updater always installs both halves (both must run the same build); use BOOTSEL for one half: --bootsel ${halves[1]}"

((release && host_given)) && die "--release and --host are exclusive"
((release)) && require_cmd gh
((release)) || is_local || require_cmd ssh rsync

# --- run --------------------------------------------------------------------

((release)) && fetch_release "$release_tag"

if ((bootsel)); then
  run_bootsel
  exit
fi

# uv runs the updater scripts; jq reads their JSON. picotool and friends are
# required only once the run actually falls back to BOOTSEL.
require_cmd uv jq
# A release from before the updater builds has no .svup files; say so by tag
# rather than letting the glob in resolve_local report a bare missing file.
if ((release)); then
  local_svups=("$UP_DIR"/*.svup(N))
  (($#local_svups)) ||
    die "${release_tag:-the latest release} of ${RELEASE_REPO} has no .svup files (it predates the in-firmware updater) — pick a newer release, or flash over BOOTSEL: qmk-flash --release ${release_tag} --bootsel"
fi
resolve_updates

# The overlay is paused BEFORE the probe, not just for the install: svalwatch
# holds the board's raw-HID interface open, and if that handle keeps the probe
# from opening the device, the probe would fail and send a perfectly good
# updater build down the BOOTSEL path. The halves' version check above stays
# ahead of the pause, so a refused run never touches the overlay at all.
#
# The traps are armed here, at the top level, because this script runs under
# `emulate -L zsh` (LOCAL_TRAPS): a trap set inside a function would be undone
# the moment that function returned.
exec {SIGNAL_STDERR}>&2
trap 'on_signal 130' INT
trap 'on_signal 143' TERM
overlay_pause
if probe; then
  flash_updater
  trap - INT TERM
else
  # Resumed before the fallback, so the overlay is back while the owner is
  # busy with the reset button, and the BOOTSEL path runs exactly as it does
  # without an updater in the picture (a Ctrl-C there is today's behaviour).
  overlay_resume
  trap - INT TERM
  log_info "the board is not on updater firmware (or not reachable): using BOOTSEL"
  run_bootsel
fi
