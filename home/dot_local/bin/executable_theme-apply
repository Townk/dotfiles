#!/usr/bin/env zsh
# theme-apply — resolve the EFFECTIVE palette (canonical ⊕ loose override) into
# runtime files that the shell, dialogs, ai-playbook and the file viewers read
# through THEME_PALETTE_FILE / THEME_PALETTE_JSON.
#
#   canonical : ~/.config/theme/palette.{json,zsh}  — generated from theme.yaml
#               by chezmoi; NEVER modified here, so chezmoi stays drift-free.
#   override  : ~/.config/theme/override.toml        — loose, per-machine,
#               OPTIONAL. Flat `token = "hex"` (the '#' is optional), e.g.
#                   base = "#1c232f"   # this session's WezTerm tint
#               Any palette token may be overridden; `base` is the common one.
#   effective : $XDG_CACHE_HOME/theme/palette.{json,zsh}  — written here.
#
# Run early in shell init; the caller exports the two env vars at the cache
# paths (see dot_zshrc). With no override.toml the effective files equal the
# canonical ones, so nothing changes. Idempotent and dependency-light: a no-op
# (exit 0) when the canonical palette or jq is missing.
emulate -L zsh
set -uo pipefail

theme_dir="${XDG_CONFIG_HOME:-$HOME/.config}/theme"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/theme"
canon_json="$theme_dir/palette.json"
canon_zsh="$theme_dir/palette.zsh"
override="$theme_dir/override.toml"
eff_json="$cache/palette.json"
eff_zsh="$cache/palette.zsh"

[[ -r "$canon_json" && -r "$canon_zsh" ]] || exit 0
command -v jq >/dev/null 2>&1 || exit 0
mkdir -p "$cache" || exit 0

# --- override.toml (flat `name = "hex"`, '#' optional) -> JSON {name:"#hex"} --
ov='{}'
if [[ -r "$override" ]]; then
  ov=$(awk -F= '
    /^[[:space:]]*#/ { next }
    /=/ {
      k = $1; gsub(/[[:space:]]/, "", k)
      v = $2; gsub(/[[:space:]"]/, "", v); sub(/^#/, "", v)
      if (k ~ /^[A-Za-z0-9_]+$/ && v ~ /^[0-9a-fA-F]{6}$/)
        printf "%s\"%s\":\"#%s\"", (n++ ? "," : ""), k, v
    }' "$override")
  ov="{$ov}"
fi

# --- effective JSON: overlay the override tokens onto .palette ----------------
if jq --argjson ov "$ov" '.palette = (.palette + $ov)' "$canon_json" >"$eff_json.tmp" 2>/dev/null; then
  mv "$eff_json.tmp" "$eff_json"
else
  rm -f "$eff_json.tmp"
  cp "$canon_json" "$eff_json"
  cp "$canon_zsh" "$eff_zsh"
  exit 0
fi

# --- effective zsh: insert the override C_HEX_* re-assignments just before the
# gated SGR block, so the C_* truecolor twins recompute from the overridden hex
# automatically (no need to re-emit the escapes here). ------------------------
ov_lines=$(print -r -- "$ov" | jq -r 'to_entries[] | "C_HEX_\(.key | ascii_upcase)=\"\(.value)\""' 2>/dev/null)
if awk -v ins="$ov_lines" '
  /^if \[ -t 1 \]; then$/ && !done { if (length(ins)) print ins; done = 1 }
  { print }
' "$canon_zsh" >"$eff_zsh.tmp"; then
  mv "$eff_zsh.tmp" "$eff_zsh"
else
  rm -f "$eff_zsh.tmp"
  cp "$canon_zsh" "$eff_zsh"
fi
