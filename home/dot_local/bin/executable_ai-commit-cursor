#!/usr/bin/env zsh
#
# ai-commit-cursor — AI-driven git commits via Cursor Agent's commit skill.
#
# Asks cursor-agent to analyze the working tree, group changes into logical
# commits, and produce Conventional Commits-format messages. The script owns
# every git operation. Dry-runs and --no-commit save the plan in .git so a
# later run can execute the same plan without asking the model again.
#
# Agent contract: cursor-agent reads the diff, writes a JSON plan to a
# tempfile, then exits. It never runs `git add` or `git commit`. The script
# reads the plan and stages + commits one group at a time.
#
# Usable standalone or as a harness behind the `ai-commit` dispatcher, which
# discovers this script via the `ai-commit-*` naming and the --probe contract.

set -eu -o pipefail

# ────────────────────────────────────────────────────────────────────
# Defaults — overridable via env or flags
# ────────────────────────────────────────────────────────────────────
: "${AI_COMMIT_CURSOR_BIN:=cursor-agent}"
: "${AI_COMMIT_MODEL:=}"
: "${AI_COMMIT_CURSOR_SKILL_PATH:=$HOME/.cursor/skills/code-commit/SKILL.md}"
: "${AI_COMMIT_CURSOR_SANDBOX:=}"

# ────────────────────────────────────────────────────────────────────
# Probe contract (used by the `ai-commit` dispatcher to detect available
# harnesses): print a short label and exit 0 iff the backing CLI is present,
# else exit 1 silently. Handled before anything heavier so it stays cheap.
# ────────────────────────────────────────────────────────────────────
if [[ "${1:-}" == --probe ]]; then
  command -v "$AI_COMMIT_CURSOR_BIN" >/dev/null 2>&1 || exit 1
  print -r -- "Cursor Agent"
  exit 0
fi

# ────────────────────────────────────────────────────────────────────
# Shared commit-agent engine: pulls in the base (C_*, log_*, die), the prompt
# module (prompt::confirm), and the cagent:: plan/spinner/commit helpers.
# ────────────────────────────────────────────────────────────────────
source "$HOME/.local/lib/commit-agent-common.zsh"

usage() {
  cat <<EOF
Usage: ai-commit-cursor [options] [-- extra-guidance...]

Use Cursor Agent headless mode to group the working tree's changes into one
or more logical commits and create them using the local code-commit skill.

EOF
  cagent::usage_options_head "Cursor Agent"
  cat <<EOF
  -m, --model <id>    Override Cursor model. If omitted, Cursor Agent uses
                      its configured default. Can also be set with
                      AI_COMMIT_MODEL.
  -L, --list-models   List available Cursor Agent models for use with -m,
                      then exit. Does not require a git repository.
      --sandbox <m>   Pass Cursor Agent sandbox mode: enabled|disabled.
                      Can also be set with AI_COMMIT_CURSOR_SANDBOX.
EOF
  cagent::usage_options_tail "cursor-agent"
  cat <<EOF

Environment:
  AI_COMMIT_CURSOR_BIN         Cursor Agent binary (default: cursor-agent).
  AI_COMMIT_MODEL              Default model. Empty means Cursor's default.
  AI_COMMIT_CURSOR_SKILL_PATH  Path to the code-commit skill.
  AI_COMMIT_CURSOR_SANDBOX     Cursor sandbox mode: enabled|disabled.

Logs:
  cursor-agent's stdout+stderr is appended to
  \${XDG_STATE_HOME:-\$HOME/.local/state}/ai-commit-cursor/errors.log
EOF
}

# ────────────────────────────────────────────────────────────────────
# Parse args — shared parser; -L/--sandbox are this worker's extra flags.
# ────────────────────────────────────────────────────────────────────
list_models=0
model="$AI_COMMIT_MODEL"
sandbox="$AI_COMMIT_CURSOR_SANDBOX"

cagent::worker_flag() {
  case "$1" in
    -L | --list-models)
      list_models=1
      REPLY=1
      return 0
      ;;
    --sandbox)
      [[ $# -ge 2 ]] || die "--sandbox needs a value"
      sandbox="$2"
      REPLY=2
      return 0
      ;;
  esac
  return 1
}

cagent::parse_args "$@"

case "$sandbox" in
  "" | enabled | disabled) ;;
  *) die "--sandbox must be enabled or disabled" ;;
esac

if [[ "$list_models" -eq 1 ]]; then
  command -v "$AI_COMMIT_CURSOR_BIN" >/dev/null 2>&1 || die "Cursor Agent ($AI_COMMIT_CURSOR_BIN) not on PATH"
  "$AI_COMMIT_CURSOR_BIN" --list-models
  exit $?
fi

# ────────────────────────────────────────────────────────────────────
# Pre-flight (shared): repo cd, plan-cache freshness, staged-changes
# refusal, change detection.
# ────────────────────────────────────────────────────────────────────
cagent::preflight ai-commit-cursor

# ────────────────────────────────────────────────────────────────────
# Plan: reuse the cached plan, or ask cursor-agent for one. The prompt body
# is shared (cagent::plan_prompt); cursor's own part is the skill it is told
# to read first.
# ────────────────────────────────────────────────────────────────────
trap cagent::cleanup EXIT INT TERM
cagent::begin ai-commit-cursor

if [[ "$use_cached_plan" -eq 1 ]]; then
  cagent::load_cached_plan
else
  command -v "$AI_COMMIT_CURSOR_BIN" >/dev/null 2>&1 || die "Cursor Agent ($AI_COMMIT_CURSOR_BIN) not on PATH"
  [[ -r "$AI_COMMIT_CURSOR_SKILL_PATH" ]] ||
    die "commit skill not readable: $AI_COMMIT_CURSOR_SKILL_PATH"

  conventions=$(
    cat <<EOF
Before planning, read and follow the Cursor Agent skill at:

\`${AI_COMMIT_CURSOR_SKILL_PATH}\`

Use that skill for commit selection and message-format conventions
(Conventional Commits subject, optional Markdown body, no sign-offs, etc.).
EOF
  )
  prompt="$(cagent::plan_prompt "$conventions" " per the code-commit skill" "Write the plan")"

  cagent::log_run_header "bin=$AI_COMMIT_CURSOR_BIN model=${model:-<default>} sandbox=${sandbox:-<config>}"

  if [[ -n "$model" ]]; then
    log_info "Planning commits with Cursor Agent ${C_BWH}${model}${C_RES}…"
  else
    log_info "Planning commits with Cursor Agent's configured model…"
  fi

  cursor_args=(
    --print
    --output-format text
    --trust
    --force
    --workspace "$repo_root"
  )

  [[ -n "$model" ]] && cursor_args+=(--model "$model")
  [[ -n "$sandbox" ]] && cursor_args+=(--sandbox "$sandbox")

  cagent::run_agent cursor-agent "$AI_COMMIT_CURSOR_BIN" "${cursor_args[@]}" "$prompt"
fi

# ────────────────────────────────────────────────────────────────────
# Validate, summarize, cache, and execute the plan (shared).
# ────────────────────────────────────────────────────────────────────
cagent::finish "$*" \
  "Cursor Agent returned a reply but did not create $plan_file." \
  "Try a stronger model or verbose mode:" \
  "  ai-commit-cursor --model gpt-5 --verbose $*"
