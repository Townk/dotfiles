#!/usr/bin/env zsh
# chezmoi-reverse: propagate destination edits back to chezmoi source templates.
# Usage: chezmoi-reverse [--no-merge] [--] <file> [<file>...]
#
# --no-merge: when a hunk would require an interactive three-way merge,
# leave the source untouched and emit `needs-merge` instead of invoking
# `chezmoi merge`. Useful from non-interactive callers (e.g. editor hooks)
# that want to detect drift without blocking on a merge tool.
set -euo pipefail

usage() {
  cat <<'EOF'
Propagate destination edits back to chezmoi source templates: for each file,
diff the deployed copy against its rendered source and patch the source so the
change lives in the repo (re-adds plain files, patches templates, falls back to
`chezmoi merge` on conflicts).

Usage:
  chezmoi-reverse [--no-merge] [--] <file> [<file>...]

Options:
  --no-merge   on a conflict needing a 3-way merge, leave the source untouched
               and emit `needs-merge` instead of opening a merge tool (for
               non-interactive callers such as editor hooks)
  -h, --help   show this help
EOF
}

no_merge=0
while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help | help)
      usage
      exit 0
      ;;
    --no-merge)
      no_merge=1
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "usage: chezmoi-reverse [--no-merge] [--] <file> [<file>...]" >&2
      exit 2
      ;;
    *) break ;;
  esac
done

if [ $# -eq 0 ]; then
  echo "usage: chezmoi-reverse [--no-merge] [--] <file> [<file>...]" >&2
  exit 2
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

emit() { printf '%s\t%s\n' "$1" "$2"; }

reverse_one() {
  local file="$1" src rendered patch err base is_template
  err="$work/err"
  if ! src=$(chezmoi source-path "$file" 2>"$err"); then
    cat "$err" >&2
    emit failed "$file"
    return 1
  fi
  base=$(basename "$src")
  case "$base" in
    encrypted_*)
      chezmoi merge "$file" || true
      emit merged "$file"
      return 0
      ;;
    run_*.tmpl | symlink_*.tmpl | symlink_* | modify_*.tmpl | modify_*)
      # These sources are not a simple render of the target: run_ scripts and
      # symlinks have no file body to diff, and a modify_ target is the OUTPUT
      # of a script run against the live file — so patching the source from
      # target drift is unsound. Leave the source authoritative and skip.
      emit skipped "$file"
      return 1
      ;;
  esac
  if [[ "$base" == *.tmpl ]]; then
    is_template=1
  else
    is_template=0
  fi
  rendered="$work/rendered"
  patch="$work/patch"
  if ! chezmoi cat "$file" >"$rendered" 2>"$err"; then
    cat "$err" >&2
    emit failed "$file"
    return 1
  fi
  if diff -U0 "$rendered" "$file" >"$patch"; then
    emit clean "$file"
    return 0
  fi
  if [ "$is_template" -eq 0 ]; then
    if chezmoi re-add "$file" >/dev/null 2>"$err"; then
      emit applied "$file"
      return 0
    fi
    cat "$err" >&2
    emit failed "$file"
    return 1
  fi
  cp "$src" "$src.bak"
  if patch --fuzz=0 --no-backup-if-mismatch "$src" <"$patch" >/dev/null 2>&1 &&
    [ ! -e "$src.rej" ]; then
    rm -f "$src.bak"
    emit applied "$file"
    return 0
  fi
  cp "$src.bak" "$src"
  rm -f "$src.bak" "$src.rej" "$src.orig"
  if [ "$no_merge" -eq 1 ]; then
    emit needs-merge "$file"
    return 1
  fi
  chezmoi merge "$file" || true
  emit merged "$file"
  return 0
}

rc=0
for f in "$@"; do
  reverse_one "$f" || rc=1
done
exit "$rc"
