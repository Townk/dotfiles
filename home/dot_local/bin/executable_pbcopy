#!/bin/sh
# pbcopy — universal clipboard copy: same command everywhere, whether this
# shell is sitting at the Mac or SSH'd into a remote host.
#
# No args (sacred, byte-for-byte unchanged since before files-yazi Phase 6):
#
# Local (no SSH): delegates straight to the real platform clipboard tool
# (macOS's own /usr/bin/pbcopy, or wl-copy/xclip on Linux).
#
# Over SSH: base64-encodes stdin and writes an OSC 52 "set clipboard"
# sequence directly to the controlling terminal. Zellij re-emits OSC 52 to
# the focused client's terminal (copy_command is intentionally unset in
# config.kdl.tmpl), so it rides up through WezTerm to the Mac's system
# clipboard. Write-only — no terminal round-trip, so unlike an OSC 52
# *read* (which Zellij refuses to answer) this never hangs. See pbpaste for
# the read side of this bridge, and the RemoteForward that system-onboard writes
# into ~/.ssh/config.d/<alias>.conf (default on; --no-clipboard to skip) for the
# reverse SSH tunnel it depends on.
#
# Path args (files-yazi Phase 6 design §5): `pbcopy <path>…` puts a real
# file clip on the Mac's pasteboard instead of reading stdin.
#   Local (no SSH) → send op `U` (NUL-joined absolute paths) to this
#   machine's own bridge on 127.0.0.1:2489, and — unlike the fire-and-forget
#   O/P frames below — actually check the reply, since there is no local-tool
#   fallback for a file clip: `E` status fails loudly.
#   Over SSH + reverse-bridge-up (T11) → send op `N` (push-manifest: this
#   host US NUL-joined absolute paths) to the reverse-tunneled peer bridge
#   (CLIPBOARD_BRIDGE_PORT, default 2490 — same port pbpaste's --manifest
#   already reads from). Bridge-up is a real probe (`nc -z`), not just "are
#   we SSH'd in": an iPad/Blink session has no reverse tunnel at all.
#   Over SSH, no bridge → loud error: OSC 52 is text-only and cannot carry
#   files at all (unlike the plain-text branch below, which always has the
#   OSC 52 fallback).
#
# Standalone POSIX sh, no library sourcing: this needs to work from any
# caller (editors, git, other scripts) with zero fragile dependencies, same
# rationale as ~/.local/bin/wait-until.
#
# Usage: printf '%s' "$text" | pbcopy
#        pbcopy <path>...

set -eu

case "${1:-}" in
  -h | --help)
    cat <<'EOF'
Universal clipboard copy — the same pbcopy everywhere, whether you're at the Mac
or SSH'd into a remote host. Reads stdin and puts it on the Mac's system
clipboard.

Local: delegates to the platform tool (/usr/bin/pbcopy, wl-copy, or xclip).
Over SSH: writes an OSC 52 sequence that rides up through Zellij/WezTerm to the
Mac's clipboard (write-only, never hangs). See pbpaste for the read side.

Usage: printf '%s' "$text" | pbcopy
EOF
    exit 0
    ;;
esac

# A leading "--" (end-of-options marker) lets a path literally starting with
# "-" (e.g. a file named -h) still reach file mode below.
if [ "${1:-}" = "--" ]; then
  shift
fi

# POSIX-safe absolute-path canonicalization for file mode: no arrays, no
# `realpath` (not guaranteed present on every box this ships to). Caller has
# already checked existence.
abspath() {
  _p=$1
  (cd "$(dirname -- "$_p")" && printf '%s/%s' "$(pwd -P)" "$(basename -- "$_p")")
}

# Emit a framed request <opcode><BE32 len><payload> to 127.0.0.1:<port>.
# Best-effort by default: a down bridge is a silent no-op (never blocks the
# copy) -- unless a 4th arg names a file to capture the reply into, which
# file mode below needs (there's no local-tool fallback for a file clip, so
# a down/erroring bridge there must be a loud failure, not a silent one).
send_frame() {
  _op=$1 _port=$2 _payfile=$3 _replyfile=${4:-}
  _len=$(wc -c < "$_payfile" | tr -d ' ')
  if [ -n "$_replyfile" ]; then
    # `|| true`: under `set -e`, a connection-refused (or missing `nc`)
    # failure here would otherwise kill the script on the spot, bypassing
    # the caller's reply check entirely -- an empty $_replyfile falls
    # through to that check instead, which reports it properly.
    {
      printf '%s' "$_op"
      printf "\\$(printf %03o $(((_len>>24)&255)))\\$(printf %03o $(((_len>>16)&255)))\\$(printf %03o $(((_len>>8)&255)))\\$(printf %03o $((_len&255)))"
      cat "$_payfile"
    } | nc -w2 127.0.0.1 "$_port" > "$_replyfile" 2>/dev/null || true
  else
    {
      printf '%s' "$_op"
      printf "\\$(printf %03o $(((_len>>24)&255)))\\$(printf %03o $(((_len>>16)&255)))\\$(printf %03o $(((_len>>8)&255)))\\$(printf %03o $((_len&255)))"
      cat "$_payfile"
    } | nc -w2 127.0.0.1 "$_port" >/dev/null 2>&1 || true
  fi
}

if [ -z "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]; then
  if [ $# -gt 0 ]; then
    # File-object mode, local branch (files-yazi design §5): build a
    # NUL-joined absolute-path payload and send it as a `U` frame to this
    # Mac's own bridge, then check the reply for real (see send_frame above).
    payfile=$(mktemp "${TMPDIR:-/tmp}/pbcopy-u.XXXXXX") || { echo "pbcopy: mktemp failed" >&2; exit 1; }
    replyfile=$(mktemp "${TMPDIR:-/tmp}/pbcopy-ur.XXXXXX") || { rm -f "$payfile"; echo "pbcopy: mktemp failed" >&2; exit 1; }
    trap 'rm -f "$payfile" "$replyfile"' EXIT INT TERM

    _first=1
    for _p in "$@"; do
      if [ ! -e "$_p" ]; then
        echo "pbcopy: no such file: $_p" >&2
        exit 1
      fi
      _ap=$(abspath "$_p")
      if [ "$_first" -eq 1 ]; then
        printf '%s' "$_ap" >> "$payfile"
        _first=0
      else
        printf '\000%s' "$_ap" >> "$payfile"
      fi
    done

    send_frame U 2489 "$payfile" "$replyfile"
    _status=$(head -c 1 "$replyfile" 2>/dev/null || true)
    if [ "$_status" = "O" ]; then
      exit 0
    fi
    if [ "$_status" = "E" ]; then
      _msg=$(tail -c +6 "$replyfile" 2>/dev/null)
      echo "pbcopy: ${_msg:-bridge reported an error}" >&2
      exit 1
    fi
    echo "pbcopy: clipboard bridge is not reachable on 127.0.0.1:2489" >&2
    exit 1
  fi

  # Absolute path, not a PATH lookup: ~/.local/bin (this script's own home)
  # is prepended to PATH ahead of /usr/bin, so `command -v pbcopy` would
  # just resolve back to us and recurse forever.
  if [ -x /usr/bin/pbcopy ]; then
    exec /usr/bin/pbcopy
  elif command -v wl-copy >/dev/null 2>&1; then
    exec wl-copy
  elif command -v xclip >/dev/null 2>&1; then
    exec xclip -selection clipboard
  else
    echo "pbcopy: no local clipboard tool found (pbcopy/wl-copy/xclip)" >&2
    exit 1
  fi
fi

if [ $# -gt 0 ]; then
  # File-object mode over SSH (files-yazi design §5, T11): manifest-push to
  # the reverse-tunneled peer bridge, if it's up -- OSC 52 cannot carry files
  # at all, so unlike the plain-text branch below there is no other way.
  bridge_port="${CLIPBOARD_BRIDGE_PORT:-2490}"
  if ! nc -z -w1 127.0.0.1 "$bridge_port" >/dev/null 2>&1; then
    echo "pbcopy: file clips need the reverse bridge (OSC 52 cannot carry files)" >&2
    exit 1
  fi

  host=$(scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null)

  payfile=$(mktemp "${TMPDIR:-/tmp}/pbcopy-n.XXXXXX") || { echo "pbcopy: mktemp failed" >&2; exit 1; }
  replyfile=$(mktemp "${TMPDIR:-/tmp}/pbcopy-nr.XXXXXX") || { rm -f "$payfile"; echo "pbcopy: mktemp failed" >&2; exit 1; }
  trap 'rm -f "$payfile" "$replyfile"' EXIT INT TERM

  printf '%s\037' "$host" > "$payfile"
  _first=1
  for _p in "$@"; do
    if [ ! -e "$_p" ]; then
      echo "pbcopy: no such file: $_p" >&2
      exit 1
    fi
    _ap=$(abspath "$_p")
    if [ "$_first" -eq 1 ]; then
      printf '%s' "$_ap" >> "$payfile"
      _first=0
    else
      printf '\000%s' "$_ap" >> "$payfile"
    fi
  done

  send_frame N "$bridge_port" "$payfile" "$replyfile"
  _status=$(head -c 1 "$replyfile" 2>/dev/null || true)
  if [ "$_status" = "O" ]; then
    exit 0
  fi
  if [ "$_status" = "E" ]; then
    _msg=$(tail -c +6 "$replyfile" 2>/dev/null)
    echo "pbcopy: ${_msg:-bridge reported an error}" >&2
    exit 1
  fi
  echo "pbcopy: clipboard bridge is not reachable on 127.0.0.1:$bridge_port" >&2
  exit 1
fi

sink="${PBCOPY_OSC52_SINK:-/dev/tty}"
[ "$sink" != /dev/tty ] || [ -e /dev/tty ] || {
  echo "pbcopy: no controlling terminal to send OSC 52 through" >&2
  exit 1
}

# Buffer stdin ONCE so the O declaration, the OSC 52 delivery, and the local P
# record all hash over identical bytes (spec §23 hash-domain invariant).
tmp=$(mktemp "${TMPDIR:-/tmp}/pbcopy.XXXXXX") || { echo "pbcopy: mktemp failed" >&2; exit 1; }
trap 'rm -f "$tmp"' EXIT INT TERM
cat > "$tmp"

host=$(scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null)

# 1. Declare origin to the sit-Mac FIRST (before the bytes land, so its watcher
#    tags the row remote(host)). Payload: <host> US <text>.
if [ -n "$host" ]; then
  odecl=$(mktemp "${TMPDIR:-/tmp}/pbcopy-o.XXXXXX" 2>/dev/null) || odecl=""
  if [ -n "$odecl" ]; then
    { printf '%s\037' "$host"; cat "$tmp"; } > "$odecl"
    send_frame O 2490 "$odecl"
    rm -f "$odecl"
  fi
fi

# 2. Deliver the bytes (unchanged OSC 52 semantics).
data=$(base64 < "$tmp" | tr -d '\n')
printf '\033]52;c;%s\033\\' "$data" > "$sink"

# 3. Record a local row on THIS machine (the origin). regtype: linewise iff the
#    text ends in a newline, else charwise. Payload: host US "text" US "" US rt RS text.
if [ -n "$host" ]; then
  if [ -n "$(tail -c1 "$tmp")" ]; then rt=v; else rt=l; fi   # non-empty last byte => no trailing \n => charwise
  ppersist=$(mktemp "${TMPDIR:-/tmp}/pbcopy-p.XXXXXX" 2>/dev/null) || ppersist=""
  if [ -n "$ppersist" ]; then
    { printf '%s\037text\037\037%s\036' "$host" "$rt"; cat "$tmp"; } > "$ppersist"
    send_frame P 2489 "$ppersist"
    rm -f "$ppersist"
  fi
fi
