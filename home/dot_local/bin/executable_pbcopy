#!/bin/sh
# pbcopy — universal clipboard copy.
#
# A trampoline. The implementation is `system-clip`, one compiled client built
# from the daemon's own codec (spec D2/D6), so the wire format has exactly one
# implementation rather than three interpretations of one document.
#
# WHY THIS FILE STILL EXISTS, rather than a symlink or a shell alias:
#
#   * An alias lives only in an interactive shell. Most pbcopy invocations do
#     not come from one — nvim's provider fallback, Hammerspoon, git and editor
#     integrations and other scripts all resolve the name through PATH.
#   * A symlink would put the public name back inside the binary, which would
#     have to learn argv[0] dispatch. The binary should not know what the
#     commands that call it are named; renaming this file is then a chezmoi
#     change with no rebuild.
#
# The cost is one exec, which spec §1.2 already accounts for: the compiled
# client's win is that the protocol has one implementation, not the
# milliseconds.
exec "${SYSTEM_CLIP_BIN:-$HOME/.local/bin/system-clip}" copy "$@"
