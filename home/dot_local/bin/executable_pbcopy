#!/bin/sh
# pbcopy — universal clipboard copy: same command everywhere, whether this
# shell is sitting at the Mac or SSH'd into a remote host.
#
# No args (sacred, byte-for-byte unchanged since before files-yazi Phase 6):
#
# Local (no SSH): delegates straight to the real platform clipboard tool
# (macOS's own /usr/bin/pbcopy, or wl-copy/xclip on Linux).
#
# Over SSH: sets the sit-at machine's clipboard through the reverse-tunneled
# bridge with op `T` (text + regtype), which is what universal.lua's copy()
# already does — the bridge carries the register TYPE, and its reply says
# whether the copy landed. OSC 52 is the FALLBACK for when that bridge is not
# there (an iPad/Blink session has no reverse tunnel at all): base64-encode
# stdin and write a "set clipboard" sequence to the controlling terminal, which
# Zellij re-emits to the focused client's terminal (copy_command is
# intentionally unset in config.kdl.tmpl) so it rides up through WezTerm to the
# Mac's system clipboard. Write-only — no terminal round-trip, so unlike an OSC
# 52 *read* (which Zellij refuses to answer) this never hangs.
#
# The bridge comes first because OSC 52 needs a controlling terminal and a
# HEADLESS caller has none: copy-pwd runs from the tmux server via run-shell,
# where /dev/tty exists as a device node but cannot be opened. Back when OSC 52
# was the only tier, that write failed with ENXIO and took dash down with it.
#
# See pbpaste for the read side of this bridge, and the RemoteForward that
# system-onboard writes into ~/.ssh/config.d/<alias>.conf (default on;
# --no-clipboard to skip) for the reverse SSH tunnel it depends on.
#
# Path args (files-yazi Phase 6 design §5, corrected by X2, corrected again
# by X2-redo, corrected again by Fix A): `pbcopy <path>…` puts a real file
# clip on the Mac's pasteboard instead of reading stdin. A file belongs to
# the machine whose bytes it is, so this ALWAYS records a local origin clip
# first — SSH only adds a second, best-effort step.
#   Local (no SSH) → send op `U` (NUL-joined absolute paths) to this
#   machine's trusted mode-0600 Unix socket, and — unlike the fire-and-forget
#   O/P frames below — actually check the reply, since there is no local-tool
#   fallback for a file clip: `E` status fails loudly.
#   Over SSH → send op `M` (manifest-persist-local: this host US NUL-joined
#   absolute paths) to THIS machine's trusted socket first — the
#   primary action, reply-checked exactly like the local branch's `U` above —
#   then best-effort send the SAME op `M` (same payload) to the
#   reverse-tunneled peer bridge (CLIPBOARD_BRIDGE_PORT, default 2490 — same
#   port pbpaste's --manifest already reads from), so the peer can pull
#   lazily. `M`, unlike `U`, deliberately does NOT set the pasteboard on
#   EITHER end: the local send doesn't because the machine reached over SSH
#   is typically locked/headless, where the Hammerspoon watcher's
#   loginwindow guard skips ALL capture — a plain `U` here would set the
#   pasteboard with nothing ever landing in the store (live-confirmed). The
#   peer send doesn't because files are lazy (§12): the peer only gets a
#   manifest POINTER, materialized on Ctrl-Y, so its live pasteboard must
#   stay untouched. `M` persists the row directly on whichever machine
#   receives it, bypassing the watcher entirely — the exact same reason
#   plain-text pbcopy (below) never sets the origin pasteboard either, only
#   `P`-persists to the store. (Fix A: the peer send used to be op `N`
#   [push-manifest], which ALSO set the peer's pasteboard to the paths as
#   plain TEXT — that text placeholder got reflected back and shown as a
#   confusing "remote text" twin on the origin's own TUI picker. `M` fixes
#   that by never touching any pasteboard.) Bridge-up is a real probe
#   (`nc -z`), not just "are we SSH'd in": an iPad/Blink session has no
#   reverse tunnel at all. A down/outdated/erroring peer bridge only warns on
#   stderr and exits 0 — the local clip already succeeded, so a missing peer
#   notification never fails the command. The LOCAL trusted `M` is the
#   unconditional primary on every platform as of Phase 7 (spec §5): every
#   onboarded machine, macOS or Linux, has its own bridge/store, so an
#   unreachable local socket is always real breakage -- there is no more store-less
#   platform for a peer push to stand in for.
#
#   Exit-code contract for file mode over SSH:
#     local M reachable, O reply       -> 0 (peer push best-effort from here: its failure only warns)
#     local M reachable, E reply       -> 1 (the local record is the primary action)
#     local M unreachable              -> 1 (every platform has its own bridge as of Phase 7)
#
# --content <file> (M3, files-yazi design): puts a file's raw BYTES on the
# pasteboard under a detected UTI (extension map first, `file --mime-type -b`
# fallback, else a loud "cannot infer UTI" error) — a rich-type sibling of
# the path-args file-OBJECT mode above, not a text/file-reference copy.
#   Local (no SSH) → send op `C` (copy-rich: uti + blob) to 127.0.0.1:2489,
#   reply-checked the same way as `U` above.
#   Over SSH + reverse-bridge-up → send `C` to the reverse-tunneled peer
#   bridge (same CLIPBOARD_BRIDGE_PORT/probe convention as `N` above).
#   Over SSH, no bridge → loud error: OSC 52 is text-only and cannot carry
#   rich types any more than it can carry files.
#
# Standalone POSIX sh, no library sourcing: this needs to work from any
# caller (editors, git, other scripts) with zero fragile dependencies, same
# rationale as ~/.local/bin/wait-until.
#
# Usage: printf '%s' "$text" | pbcopy
#        pbcopy <path>...
#        pbcopy --content <file>

set -eu

case "${1:-}" in
  -h | --help)
    cat <<'EOF'
Universal clipboard copy — the same pbcopy everywhere, whether you're at the Mac
or SSH'd into a remote host. Reads stdin and puts it on the Mac's system
clipboard.

Local: delegates to the platform tool (/usr/bin/pbcopy, wl-copy, or xclip).
Over SSH: writes an OSC 52 sequence that rides up through Zellij/WezTerm to the
Mac's clipboard (write-only, never hangs). See pbpaste for the read side.

pbcopy <path>...        puts a real file clip on the pasteboard.
pbcopy --content <file> puts the file's raw bytes on the pasteboard under a
                        detected UTI (rich-type copy).

Usage: printf '%s' "$text" | pbcopy
EOF
    exit 0
    ;;
esac

# A leading "--" (end-of-options marker) lets a path literally starting with
# "-" (e.g. a file named -h) still reach file mode below.
if [ "${1:-}" = "--" ]; then
  shift
fi

# POSIX-safe absolute-path canonicalization for file mode: no arrays, no
# `realpath` (not guaranteed present on every box this ships to). Caller has
# already checked existence.
abspath() {
  _p=$1
  (cd "$(dirname -- "$_p")" && printf '%s/%s' "$(pwd -P)" "$(basename -- "$_p")")
}

# self_host — resolve the identity THIS machine stamps on outgoing M/O/P
# rows' host field (R-batch Task B amendment). Some boxes have no STABLE
# `hostname -s`: an ephemeral cloud dev-shell's hostname changes daily (e.g.
# cs-1j9nfzmx-medium-homedir-37836), so an M row carrying it would never
# match the mount key the sit-at machine's peer-hostname front matter expects
# (clipboard-mount spec §3.2), nor the `Host <name>` line its rsync pulls
# need. The DRIVEN machine can't know its own stable name in that case -- but
# the sit-at machine CAN, because it configured peer-hostname in its own ssh
# config front matter to reach here. ssh-prepare-connection's step_mount
# pushes that value into this state dir at connect time (fail-soft,
# backgrounded -- see its comment for the full rationale). Preference order:
#   1. $XDG_STATE_HOME/clipboard/self-name, if present, a SINGLE line, and
#      shaped like a safe hostname/mount-key component
#      ([A-Za-z0-9][A-Za-z0-9.-]*) -- validated defensively, not just parsed:
#      this file sits on a shared dev box and could be stale, hand-edited, or
#      multi-line garbage, and its value becomes both an M-row host field and
#      (on whichever machine later reads it back as a peer) a mount-key/ssh
#      target -- an unchecked value is a real hazard, not merely cosmetic.
#   2. scutil --get LocalHostName (macOS's own stable-ish name -- what every
#      call site here used before this function existed).
#   3. hostname -s (last resort: the only thing guaranteed to exist,
#      ephemeral or not).
self_host() {
  _sh_file="${XDG_STATE_HOME:-$HOME/.local/state}/clipboard/self-name"
  if [ -f "$_sh_file" ]; then
    _sh_name=$(cat "$_sh_file" 2>/dev/null) || _sh_name=""
    # A literal embedded newline (command substitution above only strips
    # TRAILING newlines, never internal ones) means the file has a second
    # line -- reject rather than silently take just the first line, since a
    # multi-line file is exactly the "someone/something wrote garbage here"
    # shape this whole check exists to catch.
    _sh_nl='
'
    case "$_sh_name" in
      *"$_sh_nl"*) _sh_name="" ;;
    esac
    # Shape validation, in two NEGATIVE steps -- deliberately NOT the
    # single positive pattern [A-Za-z0-9][A-Za-z0-9.-]* the zsh siblings
    # use (with `#`, zsh's zero-or-more QUANTIFIER, which anchors the whole
    # string). In POSIX `case` syntax `*` is a WILDCARD, not a quantifier:
    # that positive pattern only anchors the first TWO characters, so
    # "ab; rm -rf /tmp" would MATCH it. Instead: (a) reject any character
    # outside the allowlist anywhere in the string, (b) require an
    # alphanumeric first character -- together equivalent to the zsh
    # pattern's intent.
    case "$_sh_name" in
      *[!A-Za-z0-9.-]*) _sh_name="" ;;
    esac
    case "$_sh_name" in
      [!A-Za-z0-9]*) _sh_name="" ;;
    esac
    if [ -n "$_sh_name" ]; then
      printf '%s' "$_sh_name"
      return 0
    fi
  fi
  scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null
}

# Emit a framed request <opcode><BE32 len><payload> to 127.0.0.1:<port>.
# Best-effort by default: a down bridge is a silent no-op (never blocks the
# copy) -- unless a 4th arg names a file to capture the reply into, which
# file mode below needs (there's no local-tool fallback for a file clip, so
# a down/erroring bridge there must be a loud failure, not a silent one).
send_frame() {
  _op=$1 _port=$2 _payfile=$3 _replyfile=${4:-}
  _len=$(wc -c < "$_payfile" | tr -d ' ')
  if [ -n "$_replyfile" ]; then
    # `|| true`: under `set -e`, a connection-refused (or missing `nc`)
    # failure here would otherwise kill the script on the spot, bypassing
    # the caller's reply check entirely -- an empty $_replyfile falls
    # through to that check instead, which reports it properly.
    {
      printf '%s' "$_op"
      printf "\\$(printf %03o $(((_len>>24)&255)))\\$(printf %03o $(((_len>>16)&255)))\\$(printf %03o $(((_len>>8)&255)))\\$(printf %03o $((_len&255)))"
      cat "$_payfile"
    } | nc -w2 127.0.0.1 "$_port" > "$_replyfile" 2>/dev/null || true
  else
    {
      printf '%s' "$_op"
      printf "\\$(printf %03o $(((_len>>24)&255)))\\$(printf %03o $(((_len>>16)&255)))\\$(printf %03o $(((_len>>8)&255)))\\$(printf %03o $((_len&255)))"
      cat "$_payfile"
    } | nc -w2 127.0.0.1 "$_port" >/dev/null 2>&1 || true
  fi
}

LOCAL_BRIDGE_SOCKET="${CLIPBOARD_BRIDGE_LOCAL_SOCKET:-$HOME/.local/state/cb.sock}"

# Trusted-local sibling of send_frame. The service, not this request, assigns
# trust by accepting it on a mode-0600 Unix socket that SSH never forwards.
send_frame_unix() {
  _op=$1 _sock=$2 _payfile=$3 _replyfile=${4:-}
  _len=$(wc -c < "$_payfile" | tr -d ' ')
  if [ -n "$_replyfile" ]; then
    {
      printf '%s' "$_op"
      printf "\\$(printf %03o $(((_len>>24)&255)))\\$(printf %03o $(((_len>>16)&255)))\\$(printf %03o $(((_len>>8)&255)))\\$(printf %03o $((_len&255)))"
      cat "$_payfile"
    } | nc -U -w2 "$_sock" > "$_replyfile" 2>/dev/null || true
  else
    {
      printf '%s' "$_op"
      printf "\\$(printf %03o $(((_len>>24)&255)))\\$(printf %03o $(((_len>>16)&255)))\\$(printf %03o $(((_len>>8)&255)))\\$(printf %03o $((_len&255)))"
      cat "$_payfile"
    } | nc -U -w2 "$_sock" >/dev/null 2>&1 || true
  fi
}

# The socket file is a cheap macOS readiness check. On Linux, start the
# socket-activated unit once when absent, then let the request/reply decide.
ensure_trusted_bridge() {
  [ -S "$LOCAL_BRIDGE_SOCKET" ] && return 0
  [ "$(uname)" = Darwin ] && return 1
  command -v systemctl >/dev/null 2>&1 || return 1
  systemctl --user start clipboard-bridge-trusted.socket >/dev/null 2>&1 || true
  [ -S "$LOCAL_BRIDGE_SOCKET" ]
}

# ensure_local_bridge -- 0 iff this machine's own bridge (127.0.0.1:2489)
# answers a connect scan, self-healing on Linux first (Phase 7 spec §5): a
# stopped clipboard-bridge.socket is restarted best-effort via systemd user
# socket activation, then re-probed once. On macOS the bridge is launchd-
# supervised -- no kick, the probe verdict stands.
ensure_local_bridge() {
  nc -z -w1 127.0.0.1 2489 >/dev/null 2>&1 && return 0
  [ "$(uname)" = Darwin ] && return 1
  command -v systemctl >/dev/null 2>&1 || return 1
  systemctl --user start clipboard-bridge.socket >/dev/null 2>&1 || true
  nc -z -w1 127.0.0.1 2489 >/dev/null 2>&1
}

# unknown_opcode_hint <port> -- rework R7: an E reply whose payload is
# EXACTLY "unknown opcode" means one side's clipboard-bridge predates file
# clips (U/M/C are newer than the always-supported plain-text G/O/P) --
# the bare relayed "pbcopy: unknown opcode" left no clue which machine
# needed the update. Callers pass 2489 as the local-machine tag even when U/M
# traveled over the trusted Unix socket; anything else names the
# reverse-tunneled peer. The tag decides which side the hint should name.
unknown_opcode_hint() {
  if [ "$1" = 2489 ]; then
    printf '%s' "this machine's clipboard bridge is outdated (unknown opcode) -- chezmoi apply + restart clipboard-bridge"
  else
    printf '%s' "peer bridge doesn't support file clips yet (unknown opcode) -- update chezmoi on the other machine"
  fi
}

# UTI detection for --content mode below: extension map first (fast, no
# external process needed for the common cases), then `file --mime-type -b`
# as a fallback for extensionless or misnamed files. Prints the UTI on
# stdout and returns 0, or returns 1 (nothing printed) when neither table
# has a match — caller turns that into the "cannot infer UTI" error.
detect_uti() {
  _duti_f=$1
  _duti_base=$(basename -- "$_duti_f")
  case "$_duti_base" in
    *.*) _duti_ext=$(printf '%s' "${_duti_base##*.}" | tr '[:upper:]' '[:lower:]') ;;
    *) _duti_ext="" ;;
  esac
  case "$_duti_ext" in
    png) printf '%s' public.png; return 0 ;;
    jpg|jpeg) printf '%s' public.jpeg; return 0 ;;
    tif|tiff) printf '%s' public.tiff; return 0 ;;
    pdf) printf '%s' com.adobe.pdf; return 0 ;;
    txt) printf '%s' public.utf8-plain-text; return 0 ;;
    gif) printf '%s' com.compuserve.gif; return 0 ;;
    webp) printf '%s' org.webmproject.webp; return 0 ;;
  esac
  _duti_mime=$(file --mime-type -b -- "$_duti_f" 2>/dev/null)
  case "$_duti_mime" in
    image/png) printf '%s' public.png; return 0 ;;
    image/jpeg) printf '%s' public.jpeg; return 0 ;;
    image/tiff) printf '%s' public.tiff; return 0 ;;
    application/pdf) printf '%s' com.adobe.pdf; return 0 ;;
    text/plain) printf '%s' public.utf8-plain-text; return 0 ;;
    image/gif) printf '%s' com.compuserve.gif; return 0 ;;
    image/webp) printf '%s' org.webmproject.webp; return 0 ;;
  esac
  return 1
}

# --content <file> (M3 UTI mode, files-yazi design): put the file's raw
# BYTES on the clipboard under a detected UTI via bridge op `C` (copy-rich —
# see clip::op_copy in clipboard-bridge-dispatch: its payload framing is
# <2-byte BE uti_len><uti><blob>; send_frame's outer opcode+BE32-length
# wraps that whole thing, exactly like every other op). Handled as its own
# top-level mode, entirely separate from the no-arg/path-args branches
# below, since it dispatches to `C` (not `U`/`N`) and needs its own honest
# SSH-no-bridge error (OSC 52 is text-only and can't carry rich types any
# more than it can carry files — see the file-mode comment above for the
# same rationale).
if [ "${1:-}" = "--content" ]; then
  shift
  if [ $# -ne 1 ]; then
    echo "pbcopy: --content takes exactly one file" >&2
    exit 1
  fi
  content_file=$1
  if [ ! -e "$content_file" ]; then
    echo "pbcopy: no such file: $content_file" >&2
    exit 1
  fi
  content_uti=$(detect_uti "$content_file") || {
    echo "pbcopy: cannot infer UTI for $content_file" >&2
    exit 1
  }

  payfile=$(mktemp "${TMPDIR:-/tmp}/pbcopy-c.XXXXXX") || { echo "pbcopy: mktemp failed" >&2; exit 1; }
  replyfile=$(mktemp "${TMPDIR:-/tmp}/pbcopy-cr.XXXXXX") || { rm -f "$payfile"; echo "pbcopy: mktemp failed" >&2; exit 1; }
  trap 'rm -f "$payfile" "$replyfile"' EXIT INT TERM

  # op_copy's inner framing: a 2-byte big-endian length, then that many UTI
  # bytes, then the raw blob -- built into the payfile via `cat` (never
  # $(...), which would mangle a blob containing NULs).
  _uti_len=$(printf '%s' "$content_uti" | wc -c | tr -d ' ')
  {
    printf "\\$(printf %03o $(((_uti_len>>8)&255)))\\$(printf %03o $((_uti_len&255)))"
    printf '%s' "$content_uti"
    cat "$content_file"
  } > "$payfile"

  # Local-vs-remote: the canonical remote-detection triple (the identity of
  # mux::is_remote in mux-bootstrap.zsh). Inlined because this is POSIX /bin/sh
  # and cannot source the zsh lib; keep it in sync (all three vars, incl.
  # SSH_TTY). Same test recurs below and in manifest_port().
  if [ -z "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]; then
    content_port=2489
  else
    content_port="${CLIPBOARD_BRIDGE_PORT:-2490}"
    if ! nc -z -w1 127.0.0.1 "$content_port" >/dev/null 2>&1; then
      echo "pbcopy: --content needs the reverse bridge (OSC 52 cannot carry rich types)" >&2
      exit 1
    fi
  fi

  send_frame C "$content_port" "$payfile" "$replyfile"
  _status=$(head -c 1 "$replyfile" 2>/dev/null || true)
  if [ "$_status" = "O" ]; then
    exit 0
  fi
  if [ "$_status" = "E" ]; then
    _msg=$(tail -c +6 "$replyfile" 2>/dev/null)
    if [ "$_msg" = "unknown opcode" ]; then
      echo "pbcopy: $(unknown_opcode_hint "$content_port")" >&2
    else
      echo "pbcopy: ${_msg:-bridge reported an error}" >&2
    fi
    exit 1
  fi
  echo "pbcopy: clipboard bridge is not reachable on 127.0.0.1:$content_port" >&2
  exit 1
fi

if [ -z "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]; then
  if [ $# -gt 0 ]; then
    # File-object mode, local branch (files-yazi design §5): build a
    # NUL-joined absolute-path payload and send it as a `U` frame to this
    # Mac's own bridge, then check the reply for real (see send_frame above).
    payfile=$(mktemp "${TMPDIR:-/tmp}/pbcopy-u.XXXXXX") || { echo "pbcopy: mktemp failed" >&2; exit 1; }
    replyfile=$(mktemp "${TMPDIR:-/tmp}/pbcopy-ur.XXXXXX") || { rm -f "$payfile"; echo "pbcopy: mktemp failed" >&2; exit 1; }
    trap 'rm -f "$payfile" "$replyfile"' EXIT INT TERM

    _first=1
    for _p in "$@"; do
      if [ ! -e "$_p" ]; then
        echo "pbcopy: no such file: $_p" >&2
        exit 1
      fi
      _ap=$(abspath "$_p")
      if [ "$_first" -eq 1 ]; then
        printf '%s' "$_ap" >> "$payfile"
        _first=0
      else
        printf '\000%s' "$_ap" >> "$payfile"
      fi
    done

    ensure_trusted_bridge || true # self-heal on Linux; reply check decides
    send_frame_unix U "$LOCAL_BRIDGE_SOCKET" "$payfile" "$replyfile"
    _status=$(head -c 1 "$replyfile" 2>/dev/null || true)
    if [ "$_status" = "O" ]; then
      exit 0
    fi
    if [ "$_status" = "E" ]; then
      _msg=$(tail -c +6 "$replyfile" 2>/dev/null)
      if [ "$_msg" = "unknown opcode" ]; then
        echo "pbcopy: $(unknown_opcode_hint 2489)" >&2
      else
        echo "pbcopy: ${_msg:-bridge reported an error}" >&2
      fi
      exit 1
    fi
    echo "pbcopy: trusted clipboard bridge is not reachable at $LOCAL_BRIDGE_SOCKET" >&2
    exit 1
  fi

  # Absolute path, not a PATH lookup: ~/.local/bin (this script's own home)
  # is prepended to PATH ahead of /usr/bin, so `command -v pbcopy` would
  # just resolve back to us and recurse forever.
  # PBCOPY_DARWIN_BIN: test seam (same class as PBCOPY_OSC52_SINK) -- lets
  # the spec suite, which runs on a Mac where /usr/bin/pbcopy exists, force
  # this branch to fall through to the Linux paths.
  _darwin_pb="${PBCOPY_DARWIN_BIN:-/usr/bin/pbcopy}"
  if [ -x "$_darwin_pb" ]; then
    exec "$_darwin_pb"
  elif command -v wl-copy >/dev/null 2>&1; then
    exec wl-copy
  elif command -v xclip >/dev/null 2>&1; then
    exec xclip -selection clipboard
  else
    # Headless Linux (Phase 7 spec §5): no display clipboard exists -- the
    # store IS the clipboard. Send op T (regtype from the trailing-newline
    # heuristic) to this machine's own bridge.
    if ensure_local_bridge; then
      _tmp=$(mktemp "${TMPDIR:-/tmp}/pbcopy-t.XXXXXX") || { echo "pbcopy: mktemp failed" >&2; exit 1; }
      trap 'rm -f "$_tmp"' EXIT INT TERM
      cat > "$_tmp"
      if [ -n "$(tail -c1 "$_tmp")" ]; then _rt=v; else _rt=l; fi
      _tpay=$(mktemp "${TMPDIR:-/tmp}/pbcopy-tp.XXXXXX") || { echo "pbcopy: mktemp failed" >&2; exit 1; }
      trap 'rm -f "$_tmp" "$_tpay"' EXIT INT TERM
      { printf '%s' "$_rt"; cat "$_tmp"; } > "$_tpay"
      _trep=$(mktemp "${TMPDIR:-/tmp}/pbcopy-tr.XXXXXX") || { echo "pbcopy: mktemp failed" >&2; exit 1; }
      trap 'rm -f "$_tmp" "$_tpay" "$_trep"' EXIT INT TERM
      send_frame T 2489 "$_tpay" "$_trep"
      _tst=$(head -c 1 "$_trep" 2>/dev/null || true)
      [ "$_tst" = "O" ] && exit 0
      if [ "$_tst" = "E" ]; then
        _tmsg=$(tail -c +6 "$_trep" 2>/dev/null)
        if [ "$_tmsg" = "unknown opcode" ]; then
          echo "pbcopy: $(unknown_opcode_hint 2489)" >&2
        else
          echo "pbcopy: ${_tmsg:-clipboard bridge rejected the copy}" >&2
        fi
        exit 1
      fi
      echo "pbcopy: clipboard bridge rejected the copy" >&2
      exit 1
    fi
    echo "pbcopy: no local clipboard tool found (pbcopy/wl-copy/xclip) and the clipboard bridge is not reachable on 127.0.0.1:2489" >&2
    exit 1
  fi
fi

if [ $# -gt 0 ]; then
  # File-object mode over SSH (X2 rework, corrects the files-yazi design §5
  # push-only description; X2-redo corrects X2 itself -- see below): a
  # file's bytes live on THIS machine, so copying it here makes it a local
  # clip on THIS machine first and foremost. That local record (to this
  # machine's own bridge, 2489) is the PRIMARY action: it's what the local
  # picker's history is built from, and there is no local-tool fallback for
  # a file clip, so its failure is a hard error.
  #
  # X2-redo: the primary send is now `M` (manifest-persist-local), not `U`.
  # X2's `U` set the origin pasteboard and relied on the Hammerspoon
  # watcher to capture it into the store -- but the watcher's loginwindow
  # guard skips ALL capture when the origin has no interactive GUI session,
  # which is ALWAYS true for a machine reached over SSH (locked/headless).
  # Live-confirmed: `U` set the pasteboard, but no store row ever appeared.
  # `M` persists the row directly, bypassing the watcher -- and, since it
  # never touches the pasteboard at all, this branch now matches plain-text
  # pbcopy over SSH below, which also never sets the origin pasteboard,
  # only `P`-persists to the store.
  #
  # The peer manifest push (SAME op `M`, to the reverse-tunneled bridge,
  # 2490) is a SECONDARY, best-effort courtesy so the far side can pull
  # lazily (§12) -- a down or outdated peer bridge only warns; it never fails
  # the command, since the local record already succeeded by the time it's
  # attempted.
  #
  # Fix A (corrects X2-redo's peer send): the peer push used to be op `N`
  # (push-manifest), which -- on top of inserting the manifest row -- ALSO
  # set the PEER's pasteboard to the newline-joined paths as plain TEXT. That
  # text placeholder got reflected back up to the origin (the peer's live
  # clipboard is what the origin's own TUI picker surfaces) and showed up
  # there as a confusing "remote text" twin of the same clip. Files are
  # lazy (§12): the peer is only supposed to get a manifest POINTER,
  # materialized on Ctrl-Y -- its live pasteboard must not be touched by this
  # push at all. So the peer send is now the SAME `M` op as the local send
  # above (record-only, no pasteboard write); no `N` frame is sent anymore.
  #
  # host resolution: self_host() (see its definition near abspath() above),
  # not a bare scutil/hostname call -- this is exactly the row this fragment's
  # ephemeral-hostname dev-shells need a STABLE identity for (R-batch Task B
  # amendment).
  host=$(self_host)

  # Path canonicalization + existence check + NUL-join, done ONCE: both the
  # local M payload and the peer M payload carry the identical
  # "<host> US path NUL path ..." shape.
  pathsfile=$(mktemp "${TMPDIR:-/tmp}/pbcopy-paths.XXXXXX") || { echo "pbcopy: mktemp failed" >&2; exit 1; }
  trap 'rm -f "$pathsfile"' EXIT INT TERM

  _first=1
  for _p in "$@"; do
    if [ ! -e "$_p" ]; then
      echo "pbcopy: no such file: $_p" >&2
      exit 1
    fi
    _ap=$(abspath "$_p")
    if [ "$_first" -eq 1 ]; then
      printf '%s' "$_ap" >> "$pathsfile"
      _first=0
    else
      printf '\000%s' "$_ap" >> "$pathsfile"
    fi
  done

  # Both M sends (local and peer) carry the byte-identical payload -- built
  # once, sent to both ports below.
  mn_payfile=$(mktemp "${TMPDIR:-/tmp}/pbcopy-mn.XXXXXX") || { echo "pbcopy: mktemp failed" >&2; exit 1; }
  trap 'rm -f "$pathsfile" "$mn_payfile"' EXIT INT TERM
  { printf '%s\037' "$host"; cat "$pathsfile"; } > "$mn_payfile"

  # 1. Local origin record: `M` to this machine's trusted Unix socket, reply
  #    checked exactly like the non-SSH local branch's `U` above (E status
  #    fails loudly; unreachable is a hard error -- no local-tool fallback
  #    exists for a file clip).
  m_replyfile=$(mktemp "${TMPDIR:-/tmp}/pbcopy-mr.XXXXXX") || { echo "pbcopy: mktemp failed" >&2; exit 1; }
  trap 'rm -f "$pathsfile" "$mn_payfile" "$m_replyfile"' EXIT INT TERM

  ensure_trusted_bridge || true # self-heal on Linux; reply check below decides
  send_frame_unix M "$LOCAL_BRIDGE_SOCKET" "$mn_payfile" "$m_replyfile"
  _mstatus=$(head -c 1 "$m_replyfile" 2>/dev/null || true)
  if [ "$_mstatus" = "E" ]; then
    _mmsg=$(tail -c +6 "$m_replyfile" 2>/dev/null)
    if [ "$_mmsg" = "unknown opcode" ]; then
      echo "pbcopy: $(unknown_opcode_hint 2489)" >&2
    else
      echo "pbcopy: ${_mmsg:-bridge reported an error}" >&2
    fi
    exit 1
  fi
  if [ "$_mstatus" != "O" ]; then
    echo "pbcopy: this machine's trusted clipboard bridge is not reachable at $LOCAL_BRIDGE_SOCKET" >&2
    exit 1
  fi

  # 2. Peer manifest push: the SAME op `M` (record-only) to the
  #    reverse-tunneled bridge (2490 / CLIPBOARD_BRIDGE_PORT) -- same payload
  #    as the local send above. This is purely best-effort: the local record
  #    already succeeded (the only way to reach this point, per the hard
  #    fail above), so nothing past this point can fail the command; every
  #    non-success outcome here is a warning on stderr, not an error.
  #
  #    Fix A: this used to be op `N` (push-manifest), which also set the
  #    PEER's pasteboard to the paths as plain text -- files are lazy (§12),
  #    so the peer's live pasteboard must never be touched by this push; `M`
  #    only persists the manifest row on the peer's own store.
  bridge_port="${CLIPBOARD_BRIDGE_PORT:-2490}"
  if ! nc -z -w1 127.0.0.1 "$bridge_port" >/dev/null 2>&1; then
    echo "pbcopy: file copied to this machine's clipboard; peer not notified -- reverse bridge down" >&2
    exit 0
  fi

  peer_replyfile=$(mktemp "${TMPDIR:-/tmp}/pbcopy-mr2.XXXXXX") || {
    echo "pbcopy: file copied to this machine's clipboard; peer not notified -- mktemp failed" >&2
    exit 0
  }
  trap 'rm -f "$pathsfile" "$mn_payfile" "$m_replyfile" "$peer_replyfile"' EXIT INT TERM

  send_frame M "$bridge_port" "$mn_payfile" "$peer_replyfile"
  _peerstatus=$(head -c 1 "$peer_replyfile" 2>/dev/null || true)
  if [ "$_peerstatus" = "O" ]; then
    exit 0
  fi
  if [ "$_peerstatus" = "E" ]; then
    _peermsg=$(tail -c +6 "$peer_replyfile" 2>/dev/null)
    if [ "$_peermsg" = "unknown opcode" ]; then
      echo "pbcopy: $(unknown_opcode_hint "$bridge_port")" >&2
      exit 0
    fi
    echo "pbcopy: file copied to this machine's clipboard; peer not notified -- ${_peermsg:-bridge reported an error}" >&2
    exit 0
  fi
  echo "pbcopy: file copied to this machine's clipboard; peer not notified -- clipboard bridge is not reachable on 127.0.0.1:$bridge_port" >&2
  exit 0
fi

sink="${PBCOPY_OSC52_SINK:-/dev/tty}"

# Buffer stdin ONCE so the O declaration, the OSC 52 delivery, and the local P
# record all hash over identical bytes (spec §23 hash-domain invariant).
tmp=$(mktemp "${TMPDIR:-/tmp}/pbcopy.XXXXXX") || { echo "pbcopy: mktemp failed" >&2; exit 1; }
trap 'rm -f "$tmp"' EXIT INT TERM
cat > "$tmp"

# host resolution: self_host() (R-batch Task B amendment) -- same stable-
# identity concern as the file-mode host= above; see its definition near
# abspath() for the full self-name-vs-scutil-vs-hostname rationale.
host=$(self_host)

# regtype for both the T payload and the P row below: linewise iff the text
# ends in a newline, else charwise (non-empty last byte => no trailing \n).
if [ -n "$(tail -c1 "$tmp")" ]; then rt=v; else rt=l; fi

# 1. Declare origin to the sit-Mac FIRST (before the bytes land, so its watcher
#    tags the row remote(host)). Payload: <host> US <text>.
if [ -n "$host" ]; then
  odecl=$(mktemp "${TMPDIR:-/tmp}/pbcopy-o.XXXXXX" 2>/dev/null) || odecl=""
  if [ -n "$odecl" ]; then
    { printf '%s\037' "$host"; cat "$tmp"; } > "$odecl"
    send_frame O 2490 "$odecl"
    rm -f "$odecl"
  fi
fi

# 2. Deliver the bytes: bridge first (op T, reply-checked -- it carries the
#    regtype and needs no terminal), OSC 52 only if that didn't land.
delivered=0
tpay=$(mktemp "${TMPDIR:-/tmp}/pbcopy-st.XXXXXX" 2>/dev/null) || tpay=""
if [ -n "$tpay" ]; then
  trep=$(mktemp "${TMPDIR:-/tmp}/pbcopy-str.XXXXXX" 2>/dev/null) || trep=""
  if [ -n "$trep" ]; then
    { printf '%s' "$rt"; cat "$tmp"; } > "$tpay"
    send_frame T 2490 "$tpay" "$trep"
    if [ "$(head -c 1 "$trep" 2>/dev/null || true)" = "O" ]; then
      delivered=1
    fi
    rm -f "$trep"
  fi
  rm -f "$tpay"
fi

# An E reply or a down bridge both land here and stay quiet: OSC 52 is about to
# carry the same bytes, and a warning on a copy that then succeeds is noise.
#
# The write IS the openability test. `[ -e /dev/tty ]` was not one -- the device
# node exists even when there is no controlling terminal to open, so the guard
# passed and the redirect failed later, taking dash down with exit 2. A failing
# redirect inside an `if` condition is exempt from errexit (measured under
# dash), so this probes and delivers in one step.
if [ "$delivered" -eq 0 ]; then
  data=$(base64 < "$tmp" | tr -d '\n')
  if printf '\033]52;c;%s\033\\' "$data" > "$sink" 2>/dev/null; then
    delivered=1
  fi
fi

if [ "$delivered" -eq 0 ]; then
  echo "pbcopy: cannot deliver the copy -- the clipboard bridge is not reachable on 127.0.0.1:2490 and $sink cannot be opened for OSC 52" >&2
  exit 1
fi

# 3. Record a local row on THIS machine (the origin).
#    Payload: host US "text" US "" US rt RS text.
if [ -n "$host" ]; then
  ppersist=$(mktemp "${TMPDIR:-/tmp}/pbcopy-p.XXXXXX" 2>/dev/null) || ppersist=""
  if [ -n "$ppersist" ]; then
    { printf '%s\037text\037\037%s\036' "$host" "$rt"; cat "$tmp"; } > "$ppersist"
    send_frame P 2489 "$ppersist"
    rm -f "$ppersist"
  fi
fi
