#!/usr/bin/env zsh
# system-onboard — reconcile a machine into this dotfiles system.
#
# Usage:
#   system-onboard --alias <ssh-alias> --hostname <ssh-host> \
#                  --profile <personal|work|dev-shell|server|appliance> [--kind human|headless]
#
# Idempotent and safe to rerun after partial failure. With no args on a TTY it
# runs an interactive form. Run from an already-trusted operator host that has
# this repo checked out and can commit/push, and that can already SSH to the
# target (password, temp key, or provider console — onboarding can make access
# persistent but cannot create trust from nothing).
#
# LEAK-SAFE BOUNDARY (this repo is PUBLIC): the alias and real endpoint are
# written ONLY to the loose, unmanaged layer (~/.ssh/config.d/<alias>.conf and
# the operator map ~/.config/chezmoi/onboard-map.yaml). Committed artifacts use
# the machine's OPAQUE SLOT ID only. Every commit runs the leak audit.

set -eu -o pipefail

# Allow tests to override the library path. When sourced in tests, this env var
# points to the library in the worktree; in production it's unset and we default
# to the deployed location.
: "${SYSTEM_SECRETS_LIB:=$HOME/.local/lib/system-secrets-common.zsh}"
source "$SYSTEM_SECRETS_LIB"

# --- arguments ---------------------------------------------------------------
ALIAS="" HOSTNAME="" PROFILE="" KIND="" COLOR="" PREPARE="" LOGIN_USER=""
# Set for the duration of a remote onboarding: see write_ssh_conf / finalize_gpg_forward.
GPG_FORWARD_DEFER=0
DRY_RUN=0 NO_COMMIT=0 NO_PUSH=0 ROTATE_SECRETS=0 LOCAL=0 NO_APPLY=0 SECRETS_REBUILT=0
NO_CLIPBOARD=0
VALID_PROFILES=(personal work dev-shell server appliance)
# ssh-prepare-connection steps a host's front matter may request (see
# ~/.local/libexec/ssh-prepare-connection). `--prepare` also accepts the meta
# values `none` (no pre-connect hook at all) and `all` (every step).
readonly PREPARE_STEPS=(gpg symbols-db theme mount)

usage() {
  cat <<EOF
Reconcile a machine into this dotfiles system: assign it a secrets slot, wire
up SSH/profile, and apply chezmoi. Idempotent; run from a trusted operator
host, or use --local to self-onboard this machine.

Usage:
  system-onboard --alias <ssh-alias> --hostname <ssh-host> \\
                 --profile <personal|work|dev-shell|server|appliance> [--kind human|headless] [--user <login>]
  system-onboard --local [--alias <name>] [--profile <p>] [--color <name>] [--no-apply]
  system-onboard update <alias> --color <name>   set a machine's window tint
  system-onboard update <alias> --clear          clear it (revert to default)
  system-onboard update <alias> --clipboard      (re)enable its clipboard forward
  system-onboard update <alias> --no-clipboard   remove its clipboard forward
  system-onboard update <alias> --prepare <spec> set its pre-connect prep steps
  system-onboard colors                          list machines' tints + palette
  system-onboard decommission <alias> [--purge-tools] [--purge-apt]
                                      [--keep-target] [--yes] [--dry-run] [--no-push]
                       retire a machine: (headless) tear it down over SSH —
                       units, sshd drop-in, tool links, every chezmoi-managed
                       file, chezmoi state, identity, secrets fragment, login
                       shell (--purge-tools also removes the tool homes: mise,
                       cargo, rustup, go, uv, npm, nvim, zsh plugins, pi,
                       claude); then drop the loose ssh fragment + map entry
                       and commit/push the removal of its committed artifacts.
                       Host packages (apt) stay unless --purge-apt: then the
                       packages the bootstrap's own apt runs installed (per
                       the box's apt history, dependencies included) are
                       purged, refused if apt would take anything else with
                       them. A human machine owns its own config: only the
                       operator side is decommissioned.

Flags:
  --local              self-onboard THIS machine (human only; no SSH). Assigns a
                       slot, builds the 1Password fragment, sets secretsSlot, and
                       applies. Makes this machine an operator (stores the SA token).
  --alias <name>       SSH alias for a remote target, or (with --local) the friendly
                       operator-map key (default: this host's short name). Loose only.
  --hostname <host>    real SSH endpoint (loose only; never committed)
  --user <login>       ssh login user for the target (e.g. root on a hypervisor).
                       Loose only: written to the fragment's front matter as
                       'user:' and rendered as a User line. Hand-edit the front
                       matter to change it later.
  --profile <p>        personal | work | dev-shell | server | appliance (with --local, defaults to this
                       machine's configured chezmoi profile)
  --kind <k>           human | headless (default: from the profile's traits —
                       headless profiles → headless, else human)
  --color <name>       optional WezTerm window tint for this machine (a palette
                       name; list them with \`system-onboard colors\`). Unknown
                       names fall back to grey. Loose only (operator map).
  --no-clipboard       skip the clipboard reverse-forward for this machine
                       (default: set one up so the target's nvim/pickers can read
                       this machine's clipboard). Toggle later with
                       \`system-onboard update <alias> --clipboard|--no-clipboard\`.
  --prepare <spec>     pre-connect prep steps for this host, written to the ssh
                       fragment's front matter: none | all | a comma/space list of
                       $(IFS=,; echo "${PREPARE_STEPS[*]}") (default: all for a
                       headless target, theme for a human one).
                       \`none\` writes no Match hook (clipboard-only). Change later
                       with \`system-onboard update <alias> --prepare <spec>\`.
  --rotate-secrets     re-collect this slot's secrets even if its fragment exists
  --no-apply           (with --local) provision + set secretsSlot but skip the final
                       chezmoi apply (the bootstrap runs the heavy apply itself)
  --no-commit          do everything except git commit/push
  --no-push            commit but do not push
  --dry-run            print the plan; make no local or remote changes
  -h | --help | help   show this help

Reconciles SSH access, the target's chezmoi init, a per-machine opaque secrets
slot, the encrypted/1Password-backed secret fragment, the commit, and the
remote apply. A self-onboarded human target is detected over SSH and only its
connectivity is reconciled. Safe to rerun.
EOF
}

# ssh wrapper — `command` bypasses the interactive z4h `ssh` shell function,
# which is not loaded in non-interactive shells. A non-interactive ssh session
# also gets a minimal PATH (no Homebrew, ~/.local/bin, mise shims or snap), so
# chezmoi — and the tools it shells out to at apply (op for op:// references,
# sops/age for the headless decrypt) — would not be found. Normalize PATH on
# every remote command so tool resolution is consistent across macOS and Linux.
# REMOTE_PATH keeps $HOME/$PATH literal for the remote shell to expand.
REMOTE_PATH='$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$HOME/.local/share/mise/shims:/snap/bin'
rexec() { command ssh "$ALIAS" "export PATH=\"$REMOTE_PATH:\$PATH\"; $*"; }

# --- argument parsing --------------------------------------------------------
parse_args() {
  while (($#)); do
    case "$1" in
      --alias)
        ALIAS="${2:-}"
        shift 2
        ;;
      --hostname)
        HOSTNAME="${2:-}"
        shift 2
        ;;
      --user)
        LOGIN_USER="${2:-}"
        shift 2
        ;;
      --profile)
        PROFILE="${2:-}"
        shift 2
        ;;
      --kind)
        KIND="${2:-}"
        shift 2
        ;;
      --color)
        COLOR="${2:-}"
        shift 2
        ;;
      --prepare)
        PREPARE="${2:-}"
        shift 2
        ;;
      --rotate-secrets)
        ROTATE_SECRETS=1
        shift
        ;;
      --local)
        LOCAL=1
        shift
        ;;
      --no-apply)
        NO_APPLY=1
        shift
        ;;
      --no-commit)
        NO_COMMIT=1
        shift
        ;;
      --no-push)
        NO_PUSH=1
        shift
        ;;
      --no-clipboard)
        NO_CLIPBOARD=1
        shift
        ;;
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      -h | --help | help)
        usage
        exit 0
        ;;
      *)
        usage >&2
        die "unknown argument: $1"
        ;;
    esac
  done
}

is_valid_profile() {
  local p
  for p in "${VALID_PROFILES[@]}"; do [[ "$1" == "$p" ]] && return 0; done
  return 1
}

# Interactive form when invoked bare on a TTY.
interactive_form() {
  have_tty || {
    usage >&2
    die "no arguments and no TTY"
  }
  log_info "Interactive onboarding (Ctrl-C to abort)"
  prompt::required ALIAS "SSH alias (local only):"
  prompt::required HOSTNAME "SSH hostname / endpoint (local only):"
  prompt::choice PROFILE "Profile" "${VALID_PROFILES[@]}"
}

# Self (local) onboarding has no SSH: --hostname is unused, --alias is just the
# operator-map key (defaults to this host's short name), and the profile comes
# from the machine's own chezmoi config unless overridden. Macs only (human).
validate_local_inputs() {
  [[ -z "$LOGIN_USER" ]] ||
    die "--user is not used with --local (self onboarding has no SSH)"
  [[ -z "$HOSTNAME" ]] ||
    die "--hostname is not used with --local (self onboarding has no SSH)"
  [[ -n "$ALIAS" ]] || ALIAS="$(hostname -s)"
  [[ "$ALIAS" =~ '^[A-Za-z0-9._-]+$' ]] ||
    die "alias must be filename-safe ([A-Za-z0-9._-]): $ALIAS"
  local configured
  configured="$(chezmoi data | yq -r '.profile // ""')" ||
    die "could not read this machine's chezmoi profile"
  if [[ -n "$PROFILE" ]]; then
    [[ -z "$configured" || "$PROFILE" == "$configured" ]] ||
      die "--profile '$PROFILE' != this machine's configured profile '$configured' (run 'chezmoi init' to change it)"
  else
    [[ -n "$configured" ]] ||
      die "no chezmoi profile configured; run 'chezmoi init' first or pass --profile"
    PROFILE="$configured"
  fi
  is_valid_profile "$PROFILE" || die "invalid profile: $PROFILE"
  KIND="human"
  if sec::profile_is_headless "$PROFILE"; then
    die "--local is human-only; a headless box ($PROFILE) is onboarded by an operator over SSH"
  fi
}

validate_inputs() {
  [[ -z "$PREPARE" ]] || validate_prepare "$PREPARE"
  if ((LOCAL)); then
    validate_local_inputs
    return 0
  fi
  [[ -n "$ALIAS" && -n "$HOSTNAME" && -n "$PROFILE" ]] ||
    {
      usage >&2
      die "--alias, --hostname, and --profile are required"
    }
  [[ "$ALIAS" =~ '^[A-Za-z0-9._-]+$' ]] ||
    die "alias must be filename-safe ([A-Za-z0-9._-]): $ALIAS"
  [[ -z "$LOGIN_USER" || "$LOGIN_USER" =~ '^[A-Za-z0-9._-]+$' ]] ||
    die "user must be filename-safe ([A-Za-z0-9._-]): $LOGIN_USER"
  is_valid_profile "$PROFILE" || die "invalid profile: $PROFILE"
  if [[ -z "$KIND" ]]; then
    if sec::profile_is_headless "$PROFILE"; then KIND="headless"; else KIND="human"; fi
  fi
  [[ "$KIND" == human || "$KIND" == headless ]] ||
    die "invalid kind: $KIND (human|headless)"
  # Default prep steps follow the kind: a headless box needs every step —
  # gpg (signing through the forwarded agent), symbols-db (the pickers' DB is
  # built on macOS and only reaches Linux by this mirror), theme, mount. A
  # human Mac builds its own DB and signs locally: theme only.
  if [[ -z "$PREPARE" ]]; then
    if [[ "$KIND" == headless ]]; then PREPARE=all; else PREPARE=theme; fi
  fi
}

# Refuse to run on top of UNRELATED local changes. The tool's own artifacts
# (sops rules, blobs, fragments, generations, manifest — sec::is_artifact_path)
# may be dirty from a previous run that died mid-way, e.g. during secret entry;
# a rerun must reconcile those, not refuse itself — that is the idempotency
# contract. commit_and_push stages exact artifact paths, so unrelated files can
# never ride along. Allowed outright when --no-commit.
check_working_tree() {
  ((NO_COMMIT || DRY_RUN)) && return 0
  local -a dirty unrelated
  local p
  dirty=("${(@f)$(git -C "$REPO_ROOT" diff --name-only HEAD)}")
  for p in "${dirty[@]}"; do
    [[ -n "$p" ]] || continue
    sec::is_artifact_path "$p" || unrelated+=("$p")
  done
  ((${#unrelated})) &&
    die "working tree has unrelated changes (${(j:, :)unrelated}); commit/stash them or pass --no-commit"
  return 0
}

# --- step 2: SSH (loose) -----------------------------------------------------
# Clipboard bridge reverse-forward, folded into the per-alias fragment onboard
# already writes (default on; --no-clipboard to skip, or toggle later with
# `system-onboard update <alias> --clipboard|--no-clipboard`). LOOPBACK TCP ports,
# not a unix socket, and that choice is load-bearing: macOS OpenSSH silently
# ignores StreamLocalBindUnlink for remote (-R) socket forwards, so any unclean
# disconnect strands a stale socket that kills the reverse forward for every later
# session. A forwarded TCP port is owned by the ssh process and freed by the OS the
# instant the session ends, so a fresh (or multiplexed) session always rebinds
# cleanly. The remote gets a loopback listener on :$CLIPBOARD_REMOTE_PORT that
# tunnels back to this machine's clipboard-bridge on :$CLIPBOARD_LOCAL_PORT; the
# remote's nvim provider + pickers read this machine's clipboard through it.
readonly CLIPBOARD_REMOTE_PORT=2490
readonly CLIPBOARD_LOCAL_PORT=2489
# 6c: the LocalForward counterpart — the machine I'm VISITING, reachable from
# here on :2491 so copies made on this machine push their pointer at copy time.
readonly CLIPBOARD_VISITED_PORT=2491
# 6c part 2: the visiting machine's read-only file plane (clipboard-file-serve
# on ITS loopback :2492), forwarded to the visited machine so Finder paste of
# our file clips streams bytes lazily through a reverse mount.
readonly CLIPBOARD_FILES_PORT=2492
# ...published on the VISITED machine at :2493 — its own serve owns :2492
# there (the 2489/2490 own-vs-forwarded split, applied to the file plane).
readonly CLIPBOARD_FILES_FWD_PORT=2493

# gpg-agent forward — rendered when `prepare` implies gpg (contains `gpg`, or is
# `all`). The remote bind path carries the remote uid + gpgconf's homedir hash,
# neither expressible as an ssh token, so it is self-healed per-connect by
# ssh-prepare-connection from the trailing `# @@resolve@@:` template. A fresh
# render seeds the LEFT side with a pending absolute path (ssh rejects a bare
# @@placeholder@@ as a forwarding spec), which heals on the first connect.
readonly GPG_FWD_LOCAL='%d/.config/gnupg/S.gpg-agent.extra'
readonly GPG_FWD_TEMPLATE="RemoteForward @@gpg-agent-socket@@ ${GPG_FWD_LOCAL}"
readonly GPG_FWD_PENDING='/nonexistent/S.gpg-agent.pending-first-connect'

# validate_prepare <spec> — accept `none`, `all`, or a comma/space list of known
# steps; die on anything else so we never write a hook that can't run.
validate_prepare() {
  local spec="$1" tok
  [[ "$spec" == none || "$spec" == all ]] && return 0
  for tok in ${=${spec//,/ }}; do
    (( ${PREPARE_STEPS[(Ie)$tok]} )) \
      || die "invalid --prepare step '$tok' (valid: none, all, ${(j:, :)PREPARE_STEPS})"
  done
}

# valid_peer_hostname <name> — allowlist gate for a peer's captured (or
# hand-edited) LocalHostName BEFORE it lands on an ssh_config `Host` line.
# `Host` patterns glob: an unvalidated `*` (a garbage or hostile capture)
# would match EVERY outgoing ssh host and silently extend this fragment's
# RemoteForwards (clipboard bridge, gpg agent) to all of them. Accept only an
# RFC-hostname-ish shape — alnum first char, then alnum/dot/dash — and reject
# everything else (empty, leading dash/dot, globs, whitespace, unicode).
# Unlike ALIAS this value crosses a trust boundary (it is read back from the
# remote machine and from hand-editable front matter), so it gets the strict
# charset check ALIAS never needed.
valid_peer_hostname() {
  setopt local_options extended_glob   # `#` (zero-or-more) needs extended_glob
  [[ "$1" == [A-Za-z0-9][A-Za-z0-9.-]# ]]
}

# default_frontmatter <alias> <prepare> [user] — the front matter written for a
# brand-new (or front-matter-less) fragment. Hand-editable afterwards;
# system-onboard only ever PRESERVES an existing front matter, never rewrites
# it, so this seeds it once.
default_frontmatter() {
  # Canonical form is space-separated (the hook splits on both, but one token
  # per step is what a reader expects to see).
  local alias="$1" prepare="${2//,/ }" user="${3:-}"
  # Fenced front matter FIRST (top of the file), like YAML front matter — the
  # parser and the preservation logic both key off it, so it stays at line 1.
  print -r -- "# ---"
  print -r -- "# alias: $alias"
  print -r -- "# prepare: $prepare"
  [[ -z "$user" ]] || print -r -- "# user: $user"
  print -r -- "# ---"
  print -r -- "# Loose per-host ssh fragment written by system-onboard — NOT chezmoi-managed,"
  print -r -- "# never committed (holds the real endpoint). The fenced block above is the"
  print -r -- "# ssh-prepare-connection front matter (kept at the very top): hand-edit 'prepare'"
  print -r -- "# and system-onboard re-renders everything from 'Host' down (see"
  print -r -- "# ~/.ssh/config.example); everything above 'Host' is preserved verbatim."
}

# write_ssh_conf <conf> <alias> <hostname> <want_clipboard 0|1> [peer_hostname_hint]
# Single writer for the loose per-alias fragment (used by reconcile_ssh, the
# `update` clipboard/prepare toggles, and reconcile_peer_hostname). The file
# has two zones: the hand-authored FRONT MATTER (every line above `Host`) and
# the MECHANICAL block (`Host` and below). The front matter is preserved
# verbatim; the mechanical block is re-rendered from the front matter's
# `prepare` (and now `peer-hostname`), so an update/regeneration never
# clobbers hand-authored intent. `prepare` implying gpg renders the gpg-agent
# forward + the pre-connect hook; an already-healed gpg line is preserved
# as-is.
#
# `alias` (the front matter's `alias:` line) is a SPACE-SEPARATED LIST: every
# token is a full entry point (Host name + hooked pre-connect Match, same as
# the primary). The FIRST token is the primary — this is what `$alias` (arg2)
# always is for every caller — and it alone keys the fragment's own filename
# and its `Match ... ssh-prepare-connection ~/.ssh/config.d/<primary>.conf`
# path. The front matter's list is the hand-authored surface, so when it names
# MORE tokens than arg2 alone, the front matter wins for rendering (an
# operator can add `mini m1` to an already-onboarded `mac-mini` fragment by
# hand and re-run `system-onboard update` to pick them up). Every token is
# allowlist-gated with the same shape rule as valid_peer_hostname before it
# can reach an ssh `Host` pattern (patterns GLOB: an unvalidated `*` token
# would extend this fragment's RemoteForwards to every outgoing host) — an
# invalid token is dropped (logged, never fatal: this is a hand-editable
# zone).
#
# `peer_hostname_hint` (5th arg, optional): the peer's own LocalHostName,
# captured post-verify by reconcile_peer_hostname. It is spliced into the
# front matter as `# peer-hostname: <name>` the FIRST time it's known (front
# matter has no such line yet); after that the front matter's own line wins
# and the hint is ignored, so a hand-edit or removal sticks — same
# preserve-once-then-verbatim contract as `alias`/`prepare`. This is what lets
# `Host` carry a second name: the clipboard store stamps a file row's
# `source_host` with the ORIGIN's LocalHostName (see pbcopy's `scutil --get
# LocalHostName || hostname -s`), not our alias for it, so a puller's `rsync
# -e ssh $source_host:...` only resolves if this machine's ssh config also
# knows that exact name.
write_ssh_conf() {
  local conf="$1" alias="$2" hostname="$3" want_clip="$4" peer_hint="${5:-}"
  setopt local_options extended_glob

  # Preserve the leading front matter + any already-healed gpg line; synthesize a
  # default front matter for a brand-new / front-matter-less fragment.
  local frontmatter="" gpg_line=""
  if [[ -f "$conf" ]] && grep -qiE '^[[:space:]]*Host[[:space:]]' "$conf"; then
    frontmatter="$(awk 'tolower($1)=="host"{exit} {print}' "$conf")"
    gpg_line="$(grep -iE '^[[:space:]]*RemoteForward .*@@resolve@@:' "$conf" 2>/dev/null | head -1 || true)"
  fi
  [[ "$frontmatter" == *alias:* ]] || frontmatter="$(default_frontmatter "$alias" "${PREPARE:-theme}" "${LOGIN_USER:-}")"

  # `prepare` from the (preserved or default) front matter drives the render.
  local prepare
  prepare="$(print -r -- "$frontmatter" | awk '/^#[[:space:]]*prepare:/{sub(/^#[[:space:]]*prepare:[[:space:]]*/,"");print;exit}')"
  [[ -n "$prepare" ]] || prepare="theme"
  # `none` (or empty) ⇒ clipboard-only, no pre-connect hook. Otherwise the hook
  # renders, and gpg additionally gates the gpg-agent forward.
  local want_hook=1 want_gpg=0
  [[ "$prepare" == none ]] && want_hook=0
  [[ "$prepare" == all || "$prepare" == *gpg* ]] && want_gpg=1
  # First onboarding: the gpg listen path can only be resolved once the target
  # carries the provisioning script (after its first apply), and a pending
  # placeholder makes every earlier connection print "remote port forwarding
  # failed for listen path /nonexistent/…". Defer the line while onboarding
  # runs; an already-healed line is never dropped. finalize_gpg_forward renders
  # and resolves it once the target is converged.
  if (( GPG_FORWARD_DEFER )) && [[ -z "$gpg_line" ]]; then want_gpg=0; fi

  # `alias` — parse the (preserved or default) front matter's `alias:` field
  # into the full list of configured names. `${=...}` splits on whitespace;
  # each token then passes the same allowlist gate as a captured
  # peer-hostname (ssh `Host` patterns glob, so a stray `*` token would
  # silently extend this fragment's RemoteForwards to every outgoing host).
  # An invalid token is dropped and warned about, never fatal. Falls back to
  # arg2 if the field is somehow empty (defense in depth; default_frontmatter
  # always seeds it), and to arg2 again if every token was rejected — the
  # Host line must always carry at least the primary.
  local alias_field
  alias_field="$(print -r -- "$frontmatter" | awk '/^#[[:space:]]*alias:/{sub(/^#[[:space:]]*alias:[[:space:]]*/,"");print;exit}')"
  [[ -n "$alias_field" ]] || alias_field="$alias"
  local -a aliases
  local tok
  for tok in ${=alias_field}; do
    if valid_peer_hostname "$tok"; then
      aliases+=("$tok")
    else
      log_warn "ignoring invalid alias token '$tok' in $conf front matter — not a safe ssh Host name"
    fi
  done
  aliases=("${(@u)aliases}")            # dedupe, order-preserving
  (( ${#aliases} )) || aliases=("$alias")

  # `peer-hostname` — same "read from front matter, seed once if absent" deal
  # as `prepare` above. Seed it into the front matter (before the closing `#
  # ---` fence) the first time a hint arrives; once the line exists it is
  # preserved verbatim on every later render (hand-editable, never re-derived).
  # Both sources pass valid_peer_hostname before use — the hint before it is
  # persisted, AND the front-matter value on every read (defense in depth:
  # front matter is hand-editable, and a rejected value must never become an
  # ssh `Host` glob pattern). A rejected value renders as if absent.
  local peer_hostname
  peer_hostname="$(print -r -- "$frontmatter" | awk '/^#[[:space:]]*peer-hostname:/{sub(/^#[[:space:]]*peer-hostname:[[:space:]]*/,"");print;exit}')"
  if [[ -n "$peer_hostname" ]] && ! valid_peer_hostname "$peer_hostname"; then
    log_warn "ignoring invalid peer-hostname '$peer_hostname' in $conf front matter — not a safe ssh Host name"
    peer_hostname=""
  elif [[ -z "$peer_hostname" && -n "$peer_hint" ]]; then
    if valid_peer_hostname "$peer_hint"; then
      peer_hostname="$peer_hint"
      frontmatter="$(print -r -- "$frontmatter" | awk -v val="$peer_hostname" '
        /^#[[:space:]]*---[[:space:]]*$/ { n++; if (n == 2) print "# peer-hostname: " val }
        { print }
      ')"
    else
      log_warn "ignoring invalid captured peer hostname '$peer_hint' — not a safe ssh Host name"
    fi
  fi

  # `user` — the ssh login user. Same preserve-once contract: read from the
  # front matter; seed it there (before the closing fence) the first time a
  # LOGIN_USER arrives; a hand-edited value must pass the same charset gate
  # as the alias, else it renders as if absent.
  local login_user
  login_user="$(print -r -- "$frontmatter" | awk '/^#[[:space:]]*user:/{sub(/^#[[:space:]]*user:[[:space:]]*/,"");print;exit}')"
  if [[ -n "$login_user" && ! "$login_user" =~ '^[A-Za-z0-9._-]+$' ]]; then
    log_warn "ignoring invalid user '$login_user' in $conf front matter — not a safe login name"
    login_user=""
  elif [[ -z "$login_user" && -n "${LOGIN_USER:-}" ]]; then
    login_user="$LOGIN_USER"
    frontmatter="$(print -r -- "$frontmatter" | awk -v val="$login_user" '
      /^#[[:space:]]*---[[:space:]]*$/ { n++; if (n == 2) print "# user: " val }
      { print }
    ')"
  fi

  {
    print -r -- "$frontmatter"
    # `Host` answers to every configured alias, plus the peer's own
    # LocalHostName and its mDNS `.local` form when known — so every way a
    # human or tool reaches this machine gets the fragment:
    #   $aliases              — every operator-configured name (hooked below)
    #   $peer_hostname        — the store identity; a peer's `rsync -e ssh
    #                           $source_host:...` clipboard pull resolves it.
    #                           Deliberately NOT hooked below (unless it is
    #                           ALSO a configured alias): pulls must stay
    #                           plain, fast connections with no prep steps.
    #   $peer_hostname.local  — the mDNS name humans type (and quick-launch
    #                           entries carry); hooked below like the aliases.
    #                           The retired clipboard.config scoped its forward
    #                           to exactly this name — dropping it silently cut
    #                           the reverse bridge off every FQDN session.
    # Skipped entirely when the peer hostname IS the primary alias (arg2) —
    # same "no new information" gate as before list support landed.
    local -a host_names=("${aliases[@]}")
    if [[ -n "$peer_hostname" && "$peer_hostname" != "$alias" ]]; then
      (( ${host_names[(Ie)$peer_hostname]} )) || host_names+=("$peer_hostname")
      if [[ "$peer_hostname" != *.* ]]; then
        # Flat LocalHostName: also answer to its mDNS .local form. A dotted
        # peer-hostname is a real DNS name — no .local variant exists for it.
        local peer_local="$peer_hostname.local"
        (( ${host_names[(Ie)$peer_local]} )) || host_names+=("$peer_local")
      fi
    fi
    print -r -- "Host ${host_names[*]}"
    print -r -- "    HostName $hostname"
    if [[ -n "$login_user" ]]; then
      print -r -- "    User $login_user"
    fi
    if ((want_clip)); then
      print -r -- "    # Clipboard bridge — exposes this machine's clipboard to $alias so its nvim /"
      print -r -- "    # pickers can read it. Toggle: system-onboard update $alias --no-clipboard"
      print -r -- "    RemoteForward 127.0.0.1:$CLIPBOARD_REMOTE_PORT 127.0.0.1:$CLIPBOARD_LOCAL_PORT"
      # While a first onboarding runs, the target's own bridge is not up yet, so
      # a copy made here would only produce "channel N: open failed: connect
      # failed" noise through this route; finalize_gpg_forward re-renders it.
      if (( ! GPG_FORWARD_DEFER )); then
        print -r -- "    # …and the visited direction (6c): a route to $alias's own bridge, so"
        print -r -- "    # copies made HERE push their pointer there at copy time (Cmd+V native)."
        print -r -- "    LocalForward 127.0.0.1:$CLIPBOARD_VISITED_PORT 127.0.0.1:$CLIPBOARD_LOCAL_PORT"
      fi
      print -r -- "    # …and this machine's read-only file plane (6c part 2), so $alias can"
      print -r -- "    # reverse-mount our file clips and Finder-paste them natively."
      print -r -- "    RemoteForward 127.0.0.1:$CLIPBOARD_FILES_FWD_PORT 127.0.0.1:$CLIPBOARD_FILES_PORT"
    fi
    if ((want_gpg)); then
      print -r -- "    # gpg agent-socket forward — the remote bind path (remote uid + gpgconf"
      print -r -- "    # homedir hash) can't be an ssh token, so ssh-prepare-connection re-renders"
      print -r -- "    # the '# @@resolve@@:' template into this line's left side each connect"
      print -r -- "    # (self-heals on the NEXT connection)."
      if [[ -n "$gpg_line" ]]; then
        print -r -- "    ${gpg_line##[[:space:]]#}"          # preserve the already-healed value
      else
        print -r -- "    RemoteForward $GPG_FWD_PENDING $GPG_FWD_LOCAL  # @@resolve@@: $GPG_FWD_TEMPLATE"
      fi
      print -r -- "    StreamLocalBindUnlink yes"
    fi
    if ((want_hook)); then
      print -r -- ""
      print -r -- "# Pre-connect prep — ssh-prepare-connection reads this file's front matter"
      print -r -- "# (prepare: $prepare) and runs the steps (and heals any '# @@resolve@@:' line"
      print -r -- "# above). The _SYNCREMOTE sentinel stops the nested ssh/rsync from re-triggering"
      print -r -- "# this hook. Rendered by system-onboard from 'prepare'."
      print -r -- "# Deliberately keyed to every configured alias only, even when Host also"
      print -r -- "# answers to the peer's bare LocalHostName below — a clipboard pull"
      print -r -- "# connecting under that bare name skips the theme/gpg pre-connect hook"
      print -r -- "# (see write_ssh_conf)."
      # Hooked entry points: every configured alias (each one is a FULL entry
      # point — that's the whole point of a front-matter alias LIST) plus the
      # mDNS `.local` form when the peer hostname is known — both are how
      # HUMANS open sessions, and both must get the prep steps
      # (theme/mount/...). The BARE peer hostname is deliberately absent
      # unless it is itself a configured alias: it is the machine-to-machine
      # pull identity.
      local -a hook_names=("${aliases[@]}")
      if [[ -n "$peer_hostname" && "$peer_hostname" != "$alias" && "$peer_hostname" != *.* ]]; then
        local peer_local="$peer_hostname.local"
        (( ${hook_names[(Ie)$peer_local]} )) || hook_names+=("$peer_local")
      fi
      local hook_hosts="${(j:,:)hook_names}"
      print -r -- 'Match originalhost '"$hook_hosts"' exec "[ -n \"$_SYNCREMOTE\" ] || _SYNCREMOTE=1 ~/.local/libexec/ssh-prepare-connection ~/.ssh/config.d/'"$alias"'.conf </dev/null >/dev/null 2>&1; false"'
    fi
  } >"$conf"
  chmod 0600 "$conf"
}

reconcile_ssh() {
  local confdir="$HOME/.ssh/config.d" conf="$HOME/.ssh/config.d/$ALIAS.conf"
  local sshcfg="$HOME/.ssh/config"
  local want_clip=$((!NO_CLIPBOARD)) clipmsg
  ((want_clip)) && clipmsg="+ clipboard forward" || clipmsg="no clipboard forward"
  if ((DRY_RUN)); then
    log_info "[dry-run] would ensure $conf (Host $ALIAS → ${LOGIN_USER:+$LOGIN_USER@}$HOSTNAME, $clipmsg) and the Include in $sshcfg"
    return 0
  fi
  mkdir -p "$confdir"
  chmod 0700 "$confdir"
  if [[ -f "$conf" ]]; then
    local cur
    cur="$(awk 'tolower($1)=="hostname"{print $2; exit}' "$conf")"
    if [[ -n "$cur" && "$cur" != "$HOSTNAME" ]]; then
      prompt::confirm "$conf maps $ALIAS to '$cur', not '$HOSTNAME'. Overwrite?" ||
        die "refusing to overwrite conflicting SSH config for $ALIAS"
    fi
  fi
  write_ssh_conf "$conf" "$ALIAS" "$HOSTNAME" "$want_clip"
  log_ok "ssh config.d entry for $ALIAS ($clipmsg)"

  if [[ ! -f "$sshcfg" ]] || ! grep -Eq '^\s*Include\s+~?/?.*\.ssh/config\.d/\*' "$sshcfg"; then
    log_warn "$sshcfg lacks an Include for ~/.ssh/config.d/* — appending (Match all + Include)"
    { printf '\nMatch all\nInclude ~/.ssh/config.d/*\n'; } >>"$sshcfg"
    [[ -f "$sshcfg" ]] && chmod 0600 "$sshcfg"
  fi
}

# --- step 3: access ----------------------------------------------------------
verify_access() {
  if ((DRY_RUN)); then
    log_info "[dry-run] would verify: ssh $ALIAS true"
    return 0
  fi
  log_info "verifying SSH access to $ALIAS …"
  rexec true 2>/dev/null ||
    die "cannot ssh to '$ALIAS'. Establish first-contact access (password/temp key/console) and rerun."
  log_ok "ssh access to $ALIAS"
}

# --- step 3.5: peer hostname (clipboard ssh-alias coverage) ------------------
# The universal-clipboard store stamps a file clip's `source_host` with the
# ORIGIN machine's own LocalHostName (see pbcopy/pbpaste's `scutil --get
# LocalHostName 2>/dev/null || hostname -s` — that one-liner already
# self-selects the right command per OS, so it's rexec'd verbatim rather than
# reimplemented per-platform here). A puller's picker later does `rsync -e ssh
# $source_host:...`, so THIS machine's ssh config must also resolve that exact
# name for $ALIAS, not just our own alias for it. Runs after verify_access so
# rexec is known to work; persists the captured name in the fragment's front
# matter (write_ssh_conf's `peer_hostname_hint`) so a later `system-onboard
# update` can re-render the extra Host alias without reconnecting.
reconcile_peer_hostname() {
  if ((DRY_RUN)); then
    log_info "[dry-run] would capture $ALIAS's LocalHostName for the ssh alias"
    return 0
  fi
  local peer_hostname
  peer_hostname="$(rexec 'scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null' 2>/dev/null | tr -d '[:space:]')" || true
  if [[ -z "$peer_hostname" ]]; then
    log_warn "could not determine $ALIAS's LocalHostName — a clipboard pull naming it as source_host may not resolve"
    return 0
  fi
  # Allowlist gate BEFORE the name is persisted or rendered: this value came
  # from the remote machine, and ssh `Host` patterns glob — a stray `*` here
  # would extend this fragment's RemoteForwards to every outgoing ssh host.
  # (write_ssh_conf re-checks on every read; this keeps garbage out of the
  # front matter in the first place.) Same degradation as a failed rexec:
  # warn and proceed without a peer alias.
  if ! valid_peer_hostname "$peer_hostname"; then
    log_warn "captured LocalHostName '$peer_hostname' from $ALIAS is not a safe ssh Host name — proceeding without a peer alias"
    return 0
  fi
  local conf="$HOME/.ssh/config.d/$ALIAS.conf" want_clip=$((!NO_CLIPBOARD))
  write_ssh_conf "$conf" "$ALIAS" "$HOSTNAME" "$want_clip" "$peer_hostname"
  if [[ "$peer_hostname" != "$ALIAS" ]]; then
    log_ok "ssh alias for $ALIAS also covers its LocalHostName ($peer_hostname)"
  fi
}

# --- step 4: remote basics + bootstrap ---------------------------------------
# The tools a target needs before onboarding can continue: chezmoi (init +
# apply), mise (the headless toolbox, sops/age), zsh (the login shell every
# rendered config assumes). A headless target missing any of them gets the
# operator's CHECKED-OUT .setup.sh streamed over the session (bash -s), so it
# bootstraps with the exact version being committed — no raw-URL drift, no
# prior push needed. Under the pipe there is no TTY, which is the branch the
# headless path is built for. A human target keeps the refusal: its bootstrap
# needs a person for the Xcode / 1Password gates.
readonly BOOTSTRAP_TOOLS='chezmoi mise zsh'

# remote_missing_tools — prints the BOOTSTRAP_TOOLS the target cannot resolve
# on the normalized remote PATH (space-separated, possibly empty).
remote_missing_tools() {
  rexec "for t in $BOOTSTRAP_TOOLS; do command -v \"\$t\" >/dev/null 2>&1 || printf '%s ' \"\$t\"; done"
}

# known_bootstrap_tools <raw> — echoes only the whitespace-separated tokens of
# <raw> that are one of BOOTSTRAP_TOOLS (space-separated), dropping everything
# else. rexec's stdout is whatever the target's login/interactive shell prints
# before our command runs (motd, a package-manager nag, an rc-file echo); an
# unfiltered read would let that noise masquerade as a phantom missing tool.
known_bootstrap_tools() {
  local word
  for word in ${=1}; do
    [[ " $BOOTSTRAP_TOOLS " == *" $word "* ]] && printf '%s ' "$word"
  done
}

reconcile_remote_basics() {
  if ((DRY_RUN)); then
    if [[ "$KIND" == headless ]]; then
      log_info "[dry-run] would ensure XDG dirs on $ALIAS, probe for $BOOTSTRAP_TOOLS, and stream .setup.sh --profile $PROFILE if any is missing"
    else
      log_info "[dry-run] would ensure XDG dirs on $ALIAS and refuse if $BOOTSTRAP_TOOLS are missing (human: run .setup.sh --profile $PROFILE there)"
    fi
    return 0
  fi
  rexec 'mkdir -p ~/.config ~/.cache ~/.local/bin ~/.local/share ~/.local/state' ||
    die "failed to create XDG dirs on $ALIAS"
  local missing
  missing="$(remote_missing_tools)" || die "could not probe $ALIAS for bootstrap tools"
  missing="$(known_bootstrap_tools "$missing")"
  missing="${missing% }"
  if [[ -n "$missing" ]]; then
    if [[ "$KIND" == headless ]]; then
      log_info "bootstrapping $ALIAS (missing: $missing) — streaming .setup.sh --profile $PROFILE …"
      rexec "bash -s -- --profile $PROFILE" <"$REPO_ROOT/.setup.sh" ||
        die "remote bootstrap failed on $ALIAS (see the .setup.sh output above)"
      missing="$(remote_missing_tools)" || die "could not re-probe $ALIAS after bootstrap"
      missing="$(known_bootstrap_tools "$missing")"
      missing="${missing% }"
      [[ -z "$missing" ]] ||
        die "bootstrap left $ALIAS without: $missing"
    else
      die "$ALIAS is missing: $missing. A human machine bootstraps itself — run '.setup.sh --profile $PROFILE' there (README § Bootstrap a fresh machine), then rerun."
    fi
  fi
  log_ok "remote XDG dirs + bootstrap tools present"
}

# --- step 5: age identity (headless) ----------------------------------------
RECIPIENT=""
reconcile_age_identity() {
  [[ "$KIND" == headless ]] || return 0
  local keypath="\$HOME/$AGE_KEY_REL"
  if ((DRY_RUN)); then
    log_info "[dry-run] would ensure age identity at ~/$AGE_KEY_REL on $ALIAS and read its recipient"
    RECIPIENT="age1dryrun000000000000000000000000000000000000000000000000000"
    return 0
  fi
  if ! rexec "test -f $keypath"; then
    log_info "generating age identity on $ALIAS …"
    rexec "mkdir -p \"\$(dirname $keypath)\" && chmod 700 \"\$(dirname $keypath)\" && chezmoi age-keygen -o $keypath >/dev/null && chmod 600 $keypath" ||
      die "failed to generate age identity on $ALIAS"
  fi
  RECIPIENT="$(rexec "chezmoi age-keygen -y $keypath" | tr -d '[:space:]')" ||
    die "failed to read age recipient from $ALIAS"
  [[ "$RECIPIENT" == age1* ]] || die "unexpected age recipient from $ALIAS: $RECIPIENT"
  log_ok "age recipient: $RECIPIENT"
}

# --- step 6: slot assignment -------------------------------------------------
SLOT=""
assign_slot() {
  SLOT="$(sec::map_slot_for_alias "$ALIAS")"
  if [[ -n "$SLOT" ]]; then
    # Existing mapping: enforce no silent profile/recipient change.
    local mapped_profile mapped_recipient
    mapped_profile="$(sec::map_get "$SLOT" profile)"
    [[ "$mapped_profile" == "$PROFILE" ]] ||
      die "alias '$ALIAS' is slot $SLOT with profile '$mapped_profile', not '$PROFILE' (hard stop)"
    if [[ "$KIND" == headless ]]; then
      mapped_recipient="$(sec::map_get "$SLOT" recipient)"
      if [[ -n "$mapped_recipient" && -n "$RECIPIENT" && "$mapped_recipient" != "$RECIPIENT" ]]; then
        die "slot $SLOT recipient changed ($mapped_recipient → $RECIPIENT); use a rotate flow (hard stop)"
      fi
    fi
    log_info "reusing slot $SLOT for $ALIAS"
  elif [[ -n "$REMOTE_SELF_SLOT" ]]; then
    # The target already carries this slot in its OWN chezmoi config (a prior
    # operator onboarded it). This operator's loose map has no entry yet, but
    # the box's slot is authoritative — reuse it rather than mint a second one
    # (MED-4). sec::map_set below records it into this operator's map.
    SLOT="$REMOTE_SELF_SLOT"
    log_info "reusing $ALIAS's authoritative slot $SLOT (from its chezmoi config)"
  else
    # Allocate a fresh, collision-free opaque slot.
    while :; do
      SLOT="$(sec::gen_slot)"
      [[ -z "$(sec::map_get "$SLOT" kind)" ]] && break
    done
    log_info "assigned new slot $SLOT for $ALIAS"
  fi
  if ((DRY_RUN)); then
    log_info "[dry-run] would record $SLOT → (alias $ALIAS, $PROFILE, $KIND) in the operator map"
    return 0
  fi
  sec::map_set "$SLOT" "$ALIAS" "$PROFILE" "$KIND" "$RECIPIENT"
  if [[ "$KIND" == headless ]]; then
    sec::sops_rule_set "$SLOT" "$RECIPIENT"
  fi
}

# --- step 6.5: window-tint color (optional) ----------------------------------
# Record the optional --color on the slot's operator-map entry (loose only). A
# no-op when --color was not given; honors --dry-run. Called after the slot is
# recorded, so sec::map_set has already created/merged the entry.
apply_slot_color() {
  [[ -n "$COLOR" ]] || return 0
  if ((DRY_RUN)); then
    log_info "[dry-run] would set color '$COLOR' on slot $SLOT in the operator map"
    return 0
  fi
  sec::map_set_color "$SLOT" "$COLOR"
  log_ok "recorded color '$COLOR' for slot $SLOT"
}

# --- step 7: secrets ---------------------------------------------------------
reconcile_secrets() {
  local frag
  frag="$(sec::fragment_path "$SLOT")"
  if [[ -f "$frag" ]] && ((!ROTATE_SECRETS)); then
    log_info "fragment for $SLOT exists; skipping secret entry (use --rotate-secrets to re-collect)"
    return 0
  fi
  if ((DRY_RUN)); then
    log_info "[dry-run] would collect $PROFILE secrets and write the $KIND fragment for $SLOT"
    return 0
  fi
  sec::rebuild_slot "$SLOT"
  SECRETS_REBUILT=1
}

# --- step 8: commit & push ---------------------------------------------------
commit_and_push() {
  if ((NO_COMMIT)); then
    log_info "--no-commit: leaving changes uncommitted"
    return 0
  fi
  if ((DRY_RUN)); then
    log_info "[dry-run] would commit opaque artifacts for $SLOT and push"
    return 0
  fi
  local paths
  paths=("${(@f)$(sec::commit_paths_for_slot "$SLOT")}")
  sec::git_commit "feat(secrets): onboard $SLOT" "${paths[@]}"
  if ((NO_PUSH)); then
    log_info "--no-push: not pushing"
    return 0
  fi
  git -C "$REPO_ROOT" push >/dev/null 2>&1 &&
    log_ok "pushed" ||
    log_warn "git push failed (push manually before the remote applies)"
}

# --- step 9: converge remote -------------------------------------------------
# Ordering matters: the target must PULL the just-pushed source BEFORE we
# (re)init, so the config is regenerated from the NEW .chezmoi.toml.tmpl (with
# secretsSlot + the SOPS_AGE_KEY_FILE [env]); only then apply. apply runs with
# --force because the session has no TTY — chezmoi must never try to prompt
# (e.g. "X changed since chezmoi last wrote it") over SSH.
converge_remote() {
  if ((DRY_RUN)); then
    log_info "[dry-run] would: ssh $ALIAS — pull source, chezmoi init (profile=$PROFILE, slot=$SLOT), chezmoi apply --force, prune any stale ~/.config/zsh/secrets.d/*.sh that is not $SLOT.sh, record slot $SLOT in $ALIAS's own operator map"
    return 0
  fi

  local repo_remote src_git
  repo_remote="$(git -C "$REPO_ROOT" remote get-url origin 2>/dev/null || true)"
  src_git='${XDG_DATA_HOME:-$HOME/.local/share}/chezmoi/.git'

  # 1. Bring the source to the pushed commit: pull if already cloned, else clone.
  if rexec "test -d \"$src_git\""; then
    log_info "pulling latest source on $ALIAS …"
    rexec "chezmoi git pull" ||
      die "remote source pull failed on $ALIAS (resolve its git state and rerun)"
  else
    [[ -n "$repo_remote" ]] ||
      die "$ALIAS has no chezmoi source and this host has no 'origin' remote to clone from"
    log_info "cloning source on $ALIAS from $repo_remote …"
    rexec "CHEZMOI_PROFILE=$PROFILE CHEZMOI_SECRETS_SLOT=$SLOT chezmoi init $repo_remote" ||
      die "remote chezmoi clone/init failed on $ALIAS"
  fi

  # 2. Regenerate the target's config from the NOW-updated template (secretsSlot
  #    + the headless SOPS_AGE_KEY_FILE [env]). No token needed: there is no
  #    [onepassword] mode to render — human slots resolve op:// via `output "op"`.
  log_info "initializing chezmoi on $ALIAS (profile=$PROFILE, slot=$SLOT) …"
  rexec "CHEZMOI_PROFILE=$PROFILE CHEZMOI_SECRETS_SLOT=$SLOT chezmoi init" ||
    die "remote chezmoi init failed on $ALIAS"

  # 3. Apply non-interactively. The fragment is rendered DURING apply, so each
  #    kind needs its resolver reachable first:
  #    - headless: `output "sops"` decrypts the blob. sops/age (the mise toolbox)
  #      may not be installed yet on a box provisioned before they were added,
  #      so prime them (apply the mise config, then install).
  #    - human: the secret fragment normally reuses its rendered cache. When this
  #      run rebuilt secrets, force one refresh. Over SSH the desktop app can't
  #      authorize op, so inject the loose service-account token for this
  #      invocation → op runs in service mode. Never exported into a shell.
  #    (PATH is normalized by rexec so both resolvers are found.)
  local pre=""
  [[ "$KIND" == human ]] &&
    pre="export OP_SERVICE_ACCOUNT_TOKEN=\"\$(cat ~/$OP_TOKEN_REL 2>/dev/null)\"; "
  [[ "$KIND" == human && "$SECRETS_REBUILT" == 1 ]] &&
    pre="${pre}export CHEZMOI_REFRESH_SECRETS=1; "

  if [[ "$KIND" == headless ]]; then
    log_info "ensuring decrypt toolchain (sops, age) on $ALIAS …"
    # A targeted apply never creates parent directories; on a fresh box the
    # conf.d dir does not exist yet, so create it first.
    rexec "mkdir -p ~/.config/mise/conf.d && chezmoi apply --force ~/.config/mise/conf.d/headless-linux.toml" ||
      log_warn "could not pre-apply mise toolbox config on $ALIAS"
    # sops/age come from GitHub releases, and the box has no token yet — its
    # fragment needs sops to render. Lend this operator's own MISE_GITHUB_TOKEN
    # for the one command, over stdin (never argv: no process list, no
    # history); without one, the anonymous budget usually covers two lookups.
    local prime='command -v mise >/dev/null 2>&1 && mise install sops age -y'
    if [[ -n "${MISE_GITHUB_TOKEN:-}" ]]; then
      print -r -- "$MISE_GITHUB_TOKEN" |
        rexec 'command -v mise >/dev/null 2>&1 && { IFS= read -r t; MISE_GITHUB_TOKEN="$t" mise install sops age -y; }' ||
        log_warn "could not install sops/age via mise on $ALIAS — decrypt will fail until 'mise install' runs there"
    else
      rexec "$prime" ||
        log_warn "could not install sops/age via mise on $ALIAS — decrypt will fail until 'mise install' runs there"
    fi
  fi

  log_info "applying on $ALIAS …"
  if [[ "$KIND" == headless && -n "${MISE_GITHUB_TOKEN:-}" ]]; then
    # The apply renders the secrets fragment through the sops shim, and mise
    # resolves the whole toolset (rust@latest, …) before running any shim —
    # anonymously, since the only token on the box sits inside the file being
    # decrypted. Lend the operator token over stdin for the apply as well.
    print -r -- "$MISE_GITHUB_TOKEN" |
      rexec "${pre}IFS= read -r t; MISE_GITHUB_TOKEN=\"\$t\" chezmoi apply --force" ||
      die "remote chezmoi apply failed on $ALIAS"
  else
    rexec "${pre}chezmoi apply --force" ||
      die "remote chezmoi apply failed on $ALIAS"
  fi

  if rexec "test -r ~/.config/zsh/secrets.d/$SLOT.sh"; then
    log_ok "secret fragment materialized on $ALIAS"
  elif [[ "$KIND" == headless ]]; then
    log_warn "secret fragment not found on $ALIAS after apply — check the remote age key and SOPS_AGE_KEY_FILE"
  else
    log_warn "secret fragment not found on $ALIAS after apply — check the SA token (~/$OP_TOKEN_REL) and the op:// references"
  fi

  # Reconcile a box left dual-fragment by a prior operator: drop every
  # secrets.d/*.sh that is not the active slot's, so secrets.sh no longer sources
  # a stale slot's vars alongside the live one (MED-4 follow-up).
  prune_remote_fragments

  log_info "remote status:"
  rexec "${pre}chezmoi status --exclude scripts" || true

  reconcile_remote_map
}

# --- step 9.6: deferred forwards, once the target can serve them ------------
# Counterpart of the deferral in write_ssh_conf: re-render the fragment with
# the gpg line and the visited-direction clipboard route, and run the
# pre-connect hook once (it resolves the remote socket
# path through a forward-free ssh and pushes the theme), so the first
# forward-bearing connection binds cleanly instead of warning.
finalize_gpg_forward() {
  GPG_FORWARD_DEFER=0
  local conf="$HOME/.ssh/config.d/$ALIAS.conf"
  [[ -f "$conf" ]] || return 0
  if ((DRY_RUN)); then
    log_info "[dry-run] would render the deferred forwards for $ALIAS and resolve the gpg one once"
    return 0
  fi
  write_ssh_conf "$conf" "$ALIAS" "$HOSTNAME" $((!NO_CLIPBOARD))
  grep -qiE '^#[[:space:]]*prepare:.*(gpg|all)' "$conf" || return 0
  if _SYNCREMOTE=1 "$HOME/.local/libexec/ssh-prepare-connection" "$conf" </dev/null >/dev/null 2>&1; then
    log_ok "gpg-agent forward resolved for $ALIAS"
  else
    log_warn "gpg-agent forward left pending for $ALIAS (heals on the next connection)"
  fi
}

# --- step 9.5: record the target's OWN map entry ----------------------------
# A remotely-onboarded machine gets the SA token (operator-capable) but, unlike
# a --local self-onboard, never recorded its own slot in ITS operator map — so
# its local `system-secrets list/rotate` couldn't see its own slot.
# Upsert just THIS machine's entry into the target's loose map (a deep merge, so
# any peers it may already manage are preserved). Values mirror sec::map_set;
# idempotent. yq is resolved via rexec's normalized REMOTE_PATH. Runs from
# converge_remote, so it covers both the operator-driven and self-onboarded
# branches. Best-effort: a failure only costs the target its self-management.
reconcile_remote_map() {
  local entry color_kv=""
  # Self-manage with the same tint: fold color into the entry only when set (an
  # empty color is harmless to the consumer, but don't write noise).
  [[ -n "$COLOR" ]] && color_kv=', "color": strenv(cl)'
  entry="$(slot="$SLOT" al="$ALIAS" pr="$PROFILE" kd="$KIND" rc="$RECIPIENT" cl="$COLOR" \
    yq -n -o=json -I=0 \
    "{strenv(slot): {\"alias\": strenv(al), \"profile\": strenv(pr), \"kind\": strenv(kd), \"recipient\": strenv(rc)${color_kv}}}")" ||
    {
      log_warn "could not build the operator-map entry for $ALIAS"
      return 0
    }
  printf '%s' "$entry" |
    rexec 'f="$HOME/.config/chezmoi/onboard-map.yaml"; mkdir -p "$HOME/.config/chezmoi"; [ -f "$f" ] || { printf "{}\n" > "$f"; chmod 600 "$f"; }; m="$(yq ea "select(fileIndex==0) * select(fileIndex==1)" "$f" -)" && printf "%s\n" "$m" > "$f" && chmod 600 "$f"' &&
    log_ok "recorded slot $SLOT in $ALIAS's own operator map (it can self-manage)" ||
    log_warn "could not record $SLOT in $ALIAS's operator map (its local system-secrets won't list the slot)"
}

# --- step 9.6: prune stale secret fragments (MED-4 follow-up) ----------------
# MED-4 stopped a re-onboard from MINTING a second slot; this reconciles a box
# ALREADY left in the dual-fragment state. secrets.sh globs
# ~/.config/zsh/secrets.d/*.sh and sources EVERY match, so a box that carries a
# prior operator's <old-slot>.sh alongside the active <slot>.sh sources both,
# and the alphabetically-later slot silently wins overlapping vars. chezmoi will
# not clean this up: the non-active fragment is .chezmoiignore'd on this box, so
# chezmoi neither manages nor prunes it. After apply has materialized the ACTIVE
# fragment, remove every OTHER secrets.d/*.sh over the same rexec channel.
#
# SAFETY (this deletes files on a remote):
#   - Guard on a NON-EMPTY active slot FIRST — a bug that left SLOT empty must
#     never fall through and match every fragment as "not the active slot".
#   - Gate on the ACTIVE fragment actually being present on the remote: a broken
#     apply that never materialized it must NOT let this strip the box of every
#     fragment (total secret loss). No active fragment ⇒ prune nothing.
#   - Only ever the SLOT-shaped rendered name ~/.config/zsh/secrets.d/slot-*.sh:
#     an outer path-safety regex first rejects anything with a slash / '..' /
#     oddball char, then a slot-fragment regex (slot-<id>.sh) gates removal, so a
#     hand-placed custom.sh is left untouched and nothing outside that dir is
#     ever reachable by the rm below.
#   - Never the active slot's own fragment.
#   - Honors --dry-run (logs the intent, deletes nothing).
#   - Fail-soft: a listing or removal hiccup is logged and skipped, never fatal
#     — a stale-fragment cleanup must not abort an otherwise-good onboarding.
prune_remote_fragments() {
  # Load-bearing guard: an empty active slot wipes NOTHING.
  if [[ -z "$SLOT" ]]; then
    log_warn "active slot is empty — skipping stale-fragment cleanup (refusing to touch $ALIAS's secrets.d)"
    return 0
  fi
  local active="$SLOT.sh"

  # Gate: only prune once the ACTIVE fragment is confirmed in place. If a broken
  # apply left it missing, pruning the others would strip the box of ALL secrets
  # — far worse than the dual-fragment state we're reconciling — so bail.
  if ! rexec "test -r ~/.config/zsh/secrets.d/$active" 2>/dev/null; then
    log_warn "active fragment $active not present on $ALIAS — skipping stale-fragment cleanup (refusing to prune without the live fragment in place)"
    return 0
  fi

  # Enumerate the remote's fragment basenames. The `[ -e ]` guard makes an empty
  # dir (glob stays literal) print nothing rather than the pattern itself.
  local listing
  listing="$(rexec 'for f in ~/.config/zsh/secrets.d/*.sh; do [ -e "$f" ] && printf "%s\n" "${f##*/}"; done' 2>/dev/null)" || {
    log_warn "could not list secret fragments on $ALIAS — skipping stale-fragment cleanup"
    return 0
  }

  local frag
  while IFS= read -r frag; do
    [[ -n "$frag" ]] || continue
    # Outer path-safety guard: only ever a bare <name>.sh basename from that one
    # dir. A slash, '..', or any other shape is skipped so nothing outside
    # secrets.d can ever be reached by the rm below.
    if [[ "$frag" == */* || ! "$frag" =~ '^[A-Za-z0-9._-]+\.sh$' ]]; then
      log_warn "skipping unexpected entry '$frag' in $ALIAS's secrets.d (not a plain fragment name)"
      continue
    fi
    # Never the active slot's own fragment.
    [[ "$frag" == "$active" ]] && continue
    # Inner shape gate: only the rendered slot-fragment name (slot-<id>.sh) is
    # ever removed, so a hand-placed custom.sh in secrets.d is left alone.
    if [[ ! "$frag" =~ '^slot-[A-Za-z0-9]+\.sh$' ]]; then
      log_info "leaving non-slot fragment '$frag' in $ALIAS's secrets.d untouched (only slot-*.sh fragments are pruned)"
      continue
    fi
    if ((DRY_RUN)); then
      log_info "[dry-run] would remove stale secret fragment ~/.config/zsh/secrets.d/$frag on $ALIAS"
      continue
    fi
    if rexec "rm -f ~/.config/zsh/secrets.d/$frag"; then
      log_ok "removed stale secret fragment $frag on $ALIAS (kept $active)"
    else
      log_warn "could not remove stale secret fragment $frag on $ALIAS — remove it by hand"
    fi
  done <<< "$listing"
}

# --- step 9 (local): converge this machine -----------------------------------
# Self path. `chezmoi init` writes secretsSlot into THIS machine's config so
# .chezmoiignore stops ignoring the slot's fragment; then apply renders it.
# No token is injected: account (desktop-app) mode resolves op:// (incl. the
# Private vault for GPG). With --no-apply we set the slot but leave the heavy
# apply to the caller (the .setup.sh bootstrap runs a single apply itself).
converge_local() {
  if ((DRY_RUN)); then
    if ((NO_APPLY)); then
      log_info "[dry-run] would: chezmoi init (profile=$PROFILE, slot=$SLOT); skip apply (--no-apply)"
    else
      log_info "[dry-run] would: chezmoi init (profile=$PROFILE, slot=$SLOT) then chezmoi apply"
    fi
    return 0
  fi
  log_info "setting secretsSlot=$SLOT (profile=$PROFILE) in this machine's chezmoi config …"
  CHEZMOI_PROFILE="$PROFILE" CHEZMOI_SECRETS_SLOT="$SLOT" chezmoi init ||
    die "chezmoi init failed (could not set secretsSlot)"
  if ((NO_APPLY)); then
    log_info "--no-apply: secretsSlot set; the bootstrap apply will render the fragment"
    return 0
  fi
  log_info "applying on this machine …"
  if ((SECRETS_REBUILT)); then
    CHEZMOI_REFRESH_SECRETS=1 chezmoi apply || die "chezmoi apply failed"
  else
    chezmoi apply || die "chezmoi apply failed"
  fi
  if [[ -r "$HOME/.config/zsh/secrets.d/$SLOT.sh" ]]; then
    log_ok "secret fragment materialized at ~/.config/zsh/secrets.d/$SLOT.sh"
  else
    log_warn "secret fragment not found after apply — check the op:// references and the 1Password app"
  fi
}

# --- remote self-onboard detection -------------------------------------------
# Read the target's OWN chezmoi config over SSH. `chezmoi data` is the
# authoritative record of the slot a box already carries, and it is
# kind-agnostic — so we read it for BOTH kinds:
#   - human: a non-empty secretsSlot means it self-onboarded via `--local`; the
#     operator must NOT mint/rebuild, only reconcile connectivity (see main).
#   - headless: the alias->slot record is the per-operator loose map, so a
#     DIFFERENT operator's empty map would otherwise look "unallocated" and mint
#     a SECOND slot, orphaning the box's existing secrets/<slot> tree (MED-4).
#     The box's own secretsSlot is authoritative; assign_slot reuses it.
# An empty slot on either kind falls back to the operator-driven mint flow.
REMOTE_SELF_SLOT="" REMOTE_SELF_PROFILE=""
detect_remote_self_onboard() {
  if ((DRY_RUN)); then
    log_info "[dry-run] would read $ALIAS's chezmoi secretsSlot to detect self-onboarding"
    return 0
  fi
  local data
  data="$(rexec 'chezmoi data' 2>/dev/null)" || return 0
  REMOTE_SELF_SLOT="$(printf '%s' "$data" | yq -r '.secretsSlot // ""' 2>/dev/null)"
  REMOTE_SELF_PROFILE="$(printf '%s' "$data" | yq -r '.profile // ""' 2>/dev/null)"
}

# --- step 8.5: 1Password service-account token (human) ----------------------
# Every onboarded Mac is ALSO made an operator: it gets the same raw service-
# account token the operator holds, at the SAME loose path
# (~/.local/share/op/service-account), so its own system-onboard/system-secrets
# (and a converge's SSH apply) can drive `op` non-interactively.
#
# This file is a LOOSE per-machine secret — NEVER committed, and deliberately
# NOT under ~/.config/zsh/secrets.d, so no shell sources it: interactive
# sessions stay in 1Password "account" (desktop-app) mode with full Private
# access. The token is injected into the environment only when needed (the SSH
# apply), never globally exported. It is the raw token string (what `sec::op`
# cats), not a sourceable `export` line. Piped to the remote over stdin so it
# never appears in argv.
OP_TOKEN_REL=".local/share/op/service-account"
reconcile_op_token() {
  [[ "$KIND" == human ]] || return 0
  if ((DRY_RUN)); then
    log_info "[dry-run] would copy the SA token to $ALIAS at ~/$OP_TOKEN_REL (make it an operator)"
    return 0
  fi
  if rexec "test -s ~/$OP_TOKEN_REL" && ((!ROTATE_SECRETS)); then
    log_info "service-account token already present on $ALIAS (use --rotate-secrets to replace)"
    return 0
  fi
  sec::op_ensure_token
  local token
  token="$(cat "$OP_SA_TOKEN_FILE")"
  printf '%s' "$token" |
    rexec "umask 077; mkdir -p ~/.local/share/op && cat > ~/$OP_TOKEN_REL && chmod 600 ~/$OP_TOKEN_REL" ||
    die "failed to write service-account token to $ALIAS"
  token=""
  log_ok "configured $ALIAS as an operator (SA token at ~/$OP_TOKEN_REL, loose, 0600)"
}

# --- decommission: retire a machine ------------------------------------------
# The reverse of onboarding, idempotent. Target side first (headless only:
# a human Mac owns its own config), then this operator's loose layer, then
# the committed artifacts in ONE commit through the leak-audited path.
# Host packages (apt) stay by default: nothing on the box itself can tell
# which pre-existed the bootstrap, and they are harmless. With PURGE_APT=1 the
# apt history is the witness: the operator passes the package lists its own
# bootstrap scripts install (ONBOARD_APT_PACKAGES) and the script purges what
# the history records those exact `apt-get install -y -qq <ours…>` runs as
# having installed — dependencies included, nothing else — after a
# simulation proves apt would remove nothing beyond that set.
# Streamed as `bash -s` like the bootstrap; generic —
# it derives what to remove from `chezmoi managed` on the target, and the
# operator passes the managed directory names from its own source tree
# (MANAGED_CONFIG_DIRS, MANAGED_SHARE_DIRS) so a box that already lost
# chezmoi — a rerun after a partial teardown — still loses every one of them.
readonly DECOMMISSION_SCRIPT='
set -u
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
as_root() { if [ "$(id -u)" -eq 0 ]; then "$@"; elif sudo -n true 2>/dev/null; then sudo -n "$@"; else return 1; fi; }
echo "== user units"
if [ -d "$HOME/.config/systemd/user" ]; then
  for u in "$HOME"/.config/systemd/user/*.socket "$HOME"/.config/systemd/user/*.service; do
    [ -e "$u" ] || continue
    systemctl --user disable --now "$(basename "$u")" >/dev/null 2>&1 || true
  done
fi
echo "== sshd drop-in, tool links"
if [ -f /etc/ssh/sshd_config.d/99-gpg-agent-forward.conf ]; then
  as_root rm -f /etc/ssh/sshd_config.d/99-gpg-agent-forward.conf && as_root systemctl reload ssh 2>/dev/null \
    || echo "   sshd drop-in left in place (no root/sudo)"
fi
for l in /usr/local/bin/*; do
  [ -L "$l" ] || continue
  case "$(readlink "$l")" in "$HOME"/.local/share/mise/*) as_root rm -f "$l" 2>/dev/null || true ;; esac
done
echo "== chezmoi-managed files and directories, state, identity, secrets"
# Shared containers are never removed whole: they may hold things that
# pre-date the bootstrap (a user tool in ~/.local/bin, another app under
# ~/.config). Every other managed directory is ours entirely — compiled
# zsh files, plugin clones and state written under it included — so it goes
# with everything in it.
is_shared_container() {
  case "$1" in
    .config|.local|.local/bin|.local/share|.local/state|.local/lib|.local/libexec|.local/opt|.ssh|.cache|Library|Library/*) return 0 ;;
  esac
  return 1
}
if command -v chezmoi >/dev/null 2>&1 && [ -d "$HOME/.local/share/chezmoi" ]; then
  chezmoi managed --include=files,symlinks 2>/dev/null | while IFS= read -r t; do rm -f -- "$HOME/$t"; done
  chezmoi managed --include=dirs 2>/dev/null | sort -r | while IFS= read -r d; do
    if is_shared_container "$d"; then rmdir -- "$HOME/$d" 2>/dev/null || true; else rm -rf -- "$HOME/$d"; fi
  done
  chezmoi purge --force >/dev/null 2>&1 || true
fi
for d in ${MANAGED_CONFIG_DIRS:-}; do rm -rf -- "$HOME/.config/$d"; done
for d in ${MANAGED_SHARE_DIRS:-}; do rm -rf -- "$HOME/.local/share/$d"; done
rm -rf "$HOME/.local/share/chezmoi" "$HOME/.config/chezmoi" "$HOME/.local/state/chezmoi" "$HOME/.config/zsh/secrets.d" "$HOME"/.cache/chezmoi*
echo "== state, caches and scratch our stack wrote"
# Always ours, whatever --purge-tools says: runtime state, caches and /tmp
# scratch that the deployed stack creates on first use.
rm -rf "$HOME"/.local/state/{clipboard,mise,mux,nvim,ssh,theme,yazi,zsh,zellij,tmux,atuin,pueue,share,pick} \
       "$HOME"/.config/{glow,go,theme} \
       "$HOME"/.local/share/{atuin,Trash,zoxide,tealdeer,tldr,gitstatus} \
       "$HOME"/.cache/{glow,pick,yazi,bat,mise,nvim,zsh,gitstatus,tree-sitter,zellij,mux,theme,quick-launch,node-gyp,npm,pip,uv,go-build,go-mod,sigstore-rust,chezmoi-drift} "$HOME"/.cache/p10k* \
       "/tmp/tmux-$(id -u)" "/tmp/yazi-$(id -u)" /tmp/zsh-abbr-privileged-users /tmp/zsh-job-queue "/tmp/hsperfdata_$(id -un)" /tmp/node-compile-cache /tmp/core-js-banners
if [ -f "$HOME/.ssh/config" ]; then
  # Drop the appended pair, then the blank line that separated it from what
  # was there before (trailing blank lines only).
  awk '"'"'/^Match all$/ { getline nxt; if (nxt ~ /^Include ~\/\.ssh\/config\.d\/\*$/) next; print; print nxt; next } { print }'"'"' "$HOME/.ssh/config" |
    awk '"'"'{ l[NR]=$0 } END { n=NR; while (n>0 && l[n]=="") n--; for (i=1;i<=n;i++) print l[i] }'"'"' >"$HOME/.ssh/config.tmp" && mv -f "$HOME/.ssh/config.tmp" "$HOME/.ssh/config"
fi
# Containers our stack created and nothing else uses any more.
rmdir -- "$HOME/.local/state" "$HOME/.local" 2>/dev/null || true
[ -f "$HOME/.bashrc" ] || { [ -f /usr/share/base-files/dot.bashrc ] && cp /usr/share/base-files/dot.bashrc "$HOME/.bashrc"; }
[ -f "$HOME/.profile" ] || { [ -f /usr/share/base-files/dot.profile ] && cp /usr/share/base-files/dot.profile "$HOME/.profile"; }
echo "== login shell"
case "$(getent passwd "$(id -un)" | cut -d: -f7)" in */zsh) chsh -s /bin/bash "$(id -un)" 2>/dev/null || echo "   login shell left as zsh (chsh refused)" ;; esac
if [ "${PURGE_TOOLS:-0}" = 1 ]; then
  echo "== tool homes"
  rm -rf "$HOME"/.local/share/{mise,cargo,rustup,go,uv,nvim,zsh,fonts,man,services,npm,pnpm} \
         "$HOME"/.local/{bin,lib,libexec,opt} \
         "$HOME"/{.pi,.claude,.cargo,.rustup,go,.npm,.zshenv,.bash_profile,AGENTS.md}
fi
if [ "${PURGE_APT:-0}" = 1 ]; then
  echo "== apt packages the bootstrap installed"
  hist="${APT_HISTORY_DIR:-/var/log/apt}"
  if ! command -v apt-get >/dev/null 2>&1; then
    echo "   no apt-get here; nothing to purge"
  elif [ -z "${ONBOARD_APT_PACKAGES:-}" ]; then
    echo "   no bootstrap package list received; nothing to purge"
  else
    # Every apt run our scripts issue has the exact shape
    # `apt-get install -y -qq <pkgs…>` with pkgs drawn from the lists the
    # operator passed (whole list, or one package on the per-package retry).
    # Anything else in the history — a hand-typed install, a run by another
    # tool — is not ours, even when it names one of our packages.
    recorded=$({ zcat -f "$hist"/history.log.*.gz 2>/dev/null; cat "$hist"/history.log 2>/dev/null; } |
      awk -v ours=" $ONBOARD_APT_PACKAGES " '"'"'
        /^Commandline: apt-get install -y -qq / { ok=1; for (i=6;i<=NF;i++) if (index(ours, " " $i " ")==0) ok=0; next }
        /^Install:/ && ok { sub(/^Install: /,""); n=split($0,a,", "); for (i=1;i<=n;i++){ sub(/:[a-z0-9]+ \(.*$/,"",a[i]); print a[i] } }
        /^End-Date/ { ok=0 }'"'"' | sort -u)
    still=""
    for p in $recorded; do
      case "$(dpkg-query -W -f='"'"'${db:Status-Abbrev}'"'"' "$p" 2>/dev/null)" in ii*) still="$still $p" ;; esac
    done
    if [ -z "$still" ]; then
      echo "   nothing to purge (no bootstrap install in the apt history, or already gone)"
    else
      # apt follows reverse dependencies: refuse rather than take a package
      # the bootstrap did not install (something installed later on top of
      # ours) down with the set.
      extra=""
      for p in $(as_root apt-get purge -s -y $still 2>/dev/null | awk '"'"'/^(Remv|Purg) /{print $2}'"'"' | sort -u); do
        case " $still " in *" $p "*) ;; *) extra="$extra $p" ;; esac
      done
      if [ -n "$extra" ]; then
        echo "   apt would also remove packages the bootstrap did not install — purge skipped:$extra"
      elif as_root env DEBIAN_FRONTEND=noninteractive NEEDRESTART_SUSPEND=1 apt-get purge -y -qq $still >/dev/null 2>&1; then
        echo "   purged $(echo $still | wc -w | tr -d " ") packages"
        as_root env DEBIAN_FRONTEND=noninteractive NEEDRESTART_SUSPEND=1 apt-get autoremove --purge -y -qq >/dev/null 2>&1 || true
      else
        echo "   apt-get purge failed (rerun; it is idempotent)"
      fi
    fi
  fi
fi
echo "== done"
'

# bootstrap_apt_packages — every package name our own bootstrap installs with
# apt (.setup.sh's base set and the headless run-script's APT_PACKAGES),
# space-separated: the witness list the decommission script matches the
# target's apt history against.
bootstrap_apt_packages() {
  local -a pkgs
  local setup="$REPO_ROOT/.setup.sh"
  local script="$REPO_ROOT/home/.chezmoiscripts/run_once_after_15-setup-dev-shell-tools.sh.tmpl"
  [[ -f "$setup" ]] && pkgs+=(${=$(sed -n 's/^ *apt-get install -y -qq //p' "$setup")})
  [[ -f "$script" ]] && pkgs+=(${=$(sed -n '/^APT_PACKAGES=(/,/^)/{ /^APT_PACKAGES=(/d; /^)/d; s/#.*//; p; }' "$script")})
  print -r -- "${(j: :)${(u)pkgs}}"
}

# managed_dir_names <source dir> — the target names of that directory's
# top-level entries, space-separated (chezmoi attribute prefixes stripped):
# what `chezmoi managed` would list for it, derivable without the target.
managed_dir_names() {
  [[ -d "$1" ]] || return 0
  local e; local -a names
  for e in "$1"/*(N:t) "$1"/.*(N:t); do
    e="${e#private_}"; e="${e#readonly_}"; e="${e#exact_}"; e="${e#executable_}"; e="${e#symlink_}"
    e="${e/#dot_/.}"; e="${e%.tmpl}"
    [[ "$e" == .chezmoi* ]] && continue
    names+=("$e")
  done
  print -r -- "${(j: :)${(u)names}}"
}

cmd_decommission() {
  local target="" purge_tools=0 purge_apt=0 keep_target=0 yes=0 no_push=0
  while (($#)); do
    case "$1" in
      --purge-tools) purge_tools=1; shift ;;
      --purge-apt) purge_apt=1; shift ;;
      --keep-target) keep_target=1; shift ;;
      --yes | -y) yes=1; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --no-push) no_push=1; shift ;;
      -h | --help | help) usage; exit 0 ;;
      -*) usage >&2; die "decommission: unknown flag: $1" ;;
      *)
        [[ -z "$target" ]] && { target="$1"; shift; } || { usage >&2; die "decommission: unexpected argument: $1"; }
        ;;
    esac
  done
  [[ -n "$target" ]] || { usage >&2; die "decommission: <alias> is required"; }
  [[ "$target" =~ '^[A-Za-z0-9._-]+$' ]] || die "alias must be filename-safe ([A-Za-z0-9._-]): $target"

  SLOT="$(sec::map_slot_for_alias "$target")"
  [[ -n "$SLOT" ]] || die "no slot for alias '$target' in the operator map ($OPERATOR_MAP)"
  local kind
  kind="$(sec::map_get "$SLOT" kind)"
  ALIAS="$target"
  local conf="$HOME/.ssh/config.d/$target.conf"
  # Commit paths depend on the map entry's kind — collect them before it goes.
  local -a paths
  paths=("${(@f)$(sec::commit_paths_for_slot "$SLOT")}")

  log_info "${C_BWH}Decommissioning $target ($SLOT, $kind)${C_RES}"

  # 1. target
  if [[ "$kind" == headless ]] && ((!keep_target)); then
    local what="units, sshd drop-in, tool links, every chezmoi-managed file, chezmoi state, identity, secrets fragment, login shell"
    ((purge_apt)) && what+=", apt packages the bootstrap installed"
    local managed_config managed_share apt_packages
    managed_config="$(managed_dir_names "$REPO_ROOT/home/dot_config")"
    managed_share="$(managed_dir_names "$REPO_ROOT/home/dot_local/share")"
    apt_packages="$(bootstrap_apt_packages)"
    ((purge_tools)) && what+=", tool homes"
    if ((DRY_RUN)); then
      log_info "[dry-run] would tear down $target over ssh: $what"
    else
      ((yes)) || prompt::confirm "Tear down $target ($SLOT): $what?" || die "aborted"
      rexec true || die "cannot reach $target — pass --keep-target to decommission the operator side only"
      print -r -- "$DECOMMISSION_SCRIPT" |
        rexec "PURGE_TOOLS=$purge_tools PURGE_APT=$purge_apt MANAGED_CONFIG_DIRS='$managed_config' MANAGED_SHARE_DIRS='$managed_share' ONBOARD_APT_PACKAGES='$apt_packages' bash -s" ||
        die "teardown failed on $target (rerun; it is idempotent)"
      log_ok "torn down $target"
    fi
  elif [[ "$kind" == human ]]; then
    log_info "$target is a human machine and owns its own config; decommissioning the operator side only"
  else
    log_info "--keep-target: leaving $target untouched"
  fi

  # 2. loose layer
  if ((DRY_RUN)); then
    log_info "[dry-run] would remove $conf and the map entry for $SLOT"
  else
    rm -f -- "$conf"
    sec::map_del "$SLOT"
    log_ok "loose layer cleared for $target"
  fi

  # 3. committed artifacts
  if ((DRY_RUN)); then
    log_info "[dry-run] would remove the committed artifacts of $SLOT and commit (push: $((!no_push)))"
    return 0
  fi
  NO_COMMIT=0 check_working_tree
  sec::decommission_slot "$SLOT"
  sec::git_commit "chore(secrets): decommission $SLOT" "${paths[@]}"
  if ((no_push)); then
    log_info "--no-push: not pushing"
  else
    git -C "$REPO_ROOT" push >/dev/null 2>&1 && log_ok "pushed" || log_warn "git push failed (push manually)"
  fi
  log_ok "decommissioned $target ($SLOT)"
}

# --- window-tint color management (config, not secrets; no SSH) ---------------
# The palette (valid names → hex) is owned by the terminal-mux WezTerm
# integration and shared via tint-palette.toml; we only READ it to list/validate.
TINT_PALETTE_FILE="${TINT_PALETTE_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/wezterm/tint-palette.toml}"

# Print available palette color names, one per line. Empty (success) when the
# palette file is absent — e.g. a headless box where wezterm config isn't
# rendered — so callers degrade gracefully.
tint_palette_names() {
  [[ -f "$TINT_PALETTE_FILE" ]] || return 0
  yq -p=toml -o=json '.' "$TINT_PALETTE_FILE" 2>/dev/null | jq -r 'keys[]' 2>/dev/null || true
}

# Return 0 if <name> is a known palette color. Also 0 when the palette is
# unreadable — we don't block on validation (the consumer falls back to grey).
tint_palette_has() {
  local want="$1" n names
  names="$(tint_palette_names)"
  [[ -n "$names" ]] || return 0
  while IFS= read -r n; do [[ "$n" == "$want" ]] && return 0; done <<< "$names"
  return 1
}

# system-onboard update <alias> --color <name> | --clear
# Set or clear a machine's window-tint color in the loose operator map. No SSH,
# no commit (the map is loose, never committed). Honors --dry-run.
cmd_update() {
  local target="" color="" clear=0 clip=-1 prepare_spec="" have_prepare=0
  while (($#)); do
    case "$1" in
      --color) color="${2:-}"; shift 2 ;;
      --clear) clear=1; shift ;;
      --clipboard) clip=1; shift ;;
      --no-clipboard) clip=0; shift ;;
      --prepare) prepare_spec="${2:-}"; have_prepare=1; shift 2 ;;
      --dry-run) DRY_RUN=1; shift ;;
      -h | --help | help) usage; exit 0 ;;
      -*) usage >&2; die "update: unknown flag: $1" ;;
      *)
        [[ -z "$target" ]] && { target="$1"; shift; } || { usage >&2; die "update: unexpected argument: $1"; }
        ;;
    esac
  done
  [[ -n "$target" ]] || { usage >&2; die "update: <alias> is required"; }

  # Exactly one action per call. (Assignment form, not ((n++)): under `set -e` a
  # post-increment that yields 0 returns non-zero and would abort the script.)
  local n=0
  ((clear)) && n=$((n + 1))
  [[ -n "$color" ]] && n=$((n + 1))
  ((clip >= 0)) && n=$((n + 1))
  ((have_prepare)) && n=$((n + 1))
  ((n == 1)) || die "update: pass exactly one of --color <name> | --clear | --clipboard | --no-clipboard | --prepare <spec>"

  # Clipboard toggle: rewrites only the loose ssh fragment. No SSH, no operator map.
  if ((clip >= 0)); then
    local conf="$HOME/.ssh/config.d/$target.conf"
    [[ -f "$conf" ]] || die "no ssh config.d entry for '$target' at $conf — onboard it first"
    local hostname
    hostname="$(awk 'tolower($1)=="hostname"{print $2; exit}' "$conf")"
    [[ -n "$hostname" ]] || die "$conf has no HostName line — refusing to rewrite; edit it by hand"
    local state; ((clip)) && state=enabled || state=disabled
    if ((DRY_RUN)); then
      log_info "[dry-run] would rewrite $conf with the clipboard forward $state"
      return 0
    fi
    write_ssh_conf "$conf" "$target" "$hostname" "$clip"
    log_ok "clipboard forward $state for '$target'"
    return 0
  fi

  # Prepare change: rewrite the front matter's `prepare:` line, then re-render the
  # mechanical block from it (adds/removes the hook + gpg forward). Loose ssh
  # fragment only; no SSH, no operator map. The current clipboard state is kept.
  if ((have_prepare)); then
    local conf="$HOME/.ssh/config.d/$target.conf"
    [[ -f "$conf" ]] || die "no ssh config.d entry for '$target' at $conf — onboard it first"
    validate_prepare "$prepare_spec"
    local hostname
    hostname="$(awk 'tolower($1)=="hostname"{print $2; exit}' "$conf")"
    [[ -n "$hostname" ]] || die "$conf has no HostName line — refusing to rewrite; edit it by hand"
    local want_clip=0
    if grep -qE "^[[:space:]]*RemoteForward 127\.0\.0\.1:$CLIPBOARD_REMOTE_PORT " "$conf"; then want_clip=1; fi
    if ((DRY_RUN)); then
      log_info "[dry-run] would set prepare '$prepare_spec' for '$target' and re-render $conf"
      return 0
    fi
    # Replace the first `# prepare:` line in the front matter (above Host).
    local tmp rc; tmp="$(mktemp)"
    awk -v val="${prepare_spec//,/ }" '
      tolower($1)=="host" { host=1 }
      !host && !done && /^#[[:space:]]*prepare:/ { print "# prepare: " val; done=1; next }
      { print }
      END { exit(done ? 0 : 3) }
    ' "$conf" > "$tmp" && rc=0 || rc=$?
    ((rc == 0)) || { rm -f "$tmp"; die "$conf front matter has no '# prepare:' line — edit it by hand"; }
    mv "$tmp" "$conf"
    write_ssh_conf "$conf" "$target" "$hostname" "$want_clip"
    log_ok "prepare set to '$prepare_spec' for '$target'"
    return 0
  fi

  local slot
  slot="$(sec::map_slot_for_alias "$target")"
  [[ -n "$slot" ]] || die "no onboarded machine with alias '$target' (see: system-onboard colors)"

  if ((clear)); then
    if ((DRY_RUN)); then
      log_info "[dry-run] would clear the color on slot $slot ($target)"
      return 0
    fi
    sec::map_clear_color "$slot"
    log_ok "cleared color for '$target' — reverts to its profile default"
    return 0
  fi

  tint_palette_has "$color" || log_warn "unknown color '$color' — it will fall back to grey downstream"
  if ((DRY_RUN)); then
    log_info "[dry-run] would set color '$color' on slot $slot ($target)"
    return 0
  fi
  sec::map_set_color "$slot" "$color"
  log_ok "set color '$color' for '$target'"
}

# system-onboard colors — list each onboarded machine's tint, then the palette.
cmd_colors() {
  case "${1:-}" in -h | --help | help) usage; exit 0 ;; esac
  log_info "Machines:"
  local rows al col
  rows="$(yq -r 'to_entries[] | [.value.alias, (.value.color // "")] | @tsv' "$OPERATOR_MAP" 2>/dev/null || true)"
  if [[ -z "$rows" ]]; then
    print -- "  (no onboarded machines)"
  else
    while IFS=$'\t' read -r al col; do
      [[ -n "$al" ]] || continue
      if [[ -n "$col" ]]; then
        printf '  %-22s %s\n' "$al" "$col"
      else
        printf '  %-22s %s\n' "$al" "unset (profile default)"
      fi
    done <<< "$rows"
  fi
  log_info "Available colors:"
  local names
  names="$(tint_palette_names)"
  if [[ -z "$names" ]]; then
    print -- "  (palette file not found: $TINT_PALETTE_FILE)"
  else
    print -- "$names" | sed 's/^/  /'
  fi
}

main() {
  # Lightweight management subcommands (no SSH, no onboarding): manage the
  # window-tint color of an already-onboarded machine in the loose operator map.
  case "${1:-}" in
    update)
      shift
      sec::repo_paths
      require_cmd yq jq
      cmd_update "$@"
      return $?
      ;;
    colors)
      shift
      sec::repo_paths
      require_cmd yq jq
      cmd_colors "$@"
      return $?
      ;;
    decommission)
      shift
      sec::repo_paths
      require_cmd yq git ssh
      cmd_decommission "$@"
      return $?
      ;;
  esac

  parse_args "$@"
  sec::repo_paths
  require_cmd chezmoi git yq

  # --- self (local) onboarding ---------------------------------------------
  if ((LOCAL)); then
    validate_inputs
    require_cmd op
    log_info "${C_BWH}Self-onboarding this machine as $ALIAS ($PROFILE/$KIND)${C_RES}"
    check_working_tree
    if ((DRY_RUN)); then
      log_info "[dry-run] would ensure the SA token (operator status) at $OP_SA_TOKEN_FILE"
    else
      sec::op_ensure_token # also makes this machine an operator
    fi
    assign_slot
    apply_slot_color
    reconcile_secrets
    commit_and_push
    converge_local
    log_ok "self-onboarding complete for $ALIAS (slot $SLOT)"
    return 0
  fi

  require_cmd ssh
  if [[ -z "$ALIAS$HOSTNAME$PROFILE" ]]; then
    interactive_form
  fi
  validate_inputs
  # Headless onboarding encrypts locally, so it needs sops/age here. Human
  # onboarding uses 1Password references only — don't require them.
  [[ "$KIND" == headless ]] && require_cmd sops age
  GPG_FORWARD_DEFER=1

  log_info "${C_BWH}Onboarding $ALIAS ($PROFILE/$KIND)${C_RES}"
  check_working_tree
  reconcile_ssh
  verify_access
  reconcile_peer_hostname
  reconcile_remote_basics

  # Read the target's authoritative slot (both kinds; see detect_...). A profile
  # mismatch is a hard stop regardless of kind.
  detect_remote_self_onboard
  if [[ -n "$REMOTE_SELF_SLOT" ]]; then
    [[ -z "$REMOTE_SELF_PROFILE" || "$PROFILE" == "$REMOTE_SELF_PROFILE" ]] ||
      die "$ALIAS self-onboarded with profile '$REMOTE_SELF_PROFILE', not '$PROFILE' (hard stop)"
  fi

  # A human target that already self-onboarded OWNS its slot via `--local`:
  # reconcile connectivity + bring it current, but never mint/rebuild secrets.
  # (Headless boxes are always operator-managed — their secrets are encrypted to
  # the box's PUBLIC key here — so they fall through to the flow below, where
  # assign_slot reuses REMOTE_SELF_SLOT instead of minting a second one.)
  if [[ "$KIND" == human && -n "$REMOTE_SELF_SLOT" ]]; then
    SLOT="$REMOTE_SELF_SLOT"
    log_info "$ALIAS already self-onboarded (slot $SLOT); reconciling connectivity only"
    if ((DRY_RUN)); then
      log_info "[dry-run] would record $SLOT → (alias $ALIAS, $PROFILE, $KIND) in the operator map"
    else
      sec::map_set "$SLOT" "$ALIAS" "$PROFILE" "$KIND" ""
    fi
    apply_slot_color
    converge_remote
    finalize_gpg_forward
    log_ok "connectivity reconciled for $ALIAS (self-onboarded slot $SLOT)"
    return 0
  fi

  # Operator-driven: mint a new slot, or reuse the box's authoritative one.
  reconcile_age_identity
  assign_slot
  apply_slot_color
  reconcile_secrets
  commit_and_push
  reconcile_op_token
  converge_remote
  finalize_gpg_forward
  log_ok "onboarding complete for $ALIAS (slot $SLOT)"
}

# SYSTEM_ONBOARD_NO_RUN (test-only escape hatch, same convention as
# PICK_CLIPBOARD_NO_RUN in executable_pick-clipboard): a test harness sources
# this file with it set so it can call write_ssh_conf/default_frontmatter
# directly against a temp conf file, without main() ever running (no SSH, no
# git, no chezmoi apply). `return` unwinds a sourced file; `exit` covers the
# (unsupported) case of executing this script with the var set directly.
if [[ -n "${SYSTEM_ONBOARD_NO_RUN:-}" ]]; then
  return 0 2>/dev/null || exit 0
fi

main "$@"
