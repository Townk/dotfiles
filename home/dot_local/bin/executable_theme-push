#!/usr/bin/env zsh
# theme-push <ssh-target> — deliver THIS machine's background tint to a remote as
# a loose theme override, so the remote session's themed surfaces (the zj-hud
# bar, fzf, dialogs, file viewers) match the wash WezTerm paints on the window
# for that target.
#
# The tint NAME for <target> is resolved exactly as WezTerm resolves it — the
# onboarded machine's `color`, else its profile default, else grey (see
# zellij/scripts/lib/terminal-location.zsh) — and looked up in the shared
# tint-palette.toml. We write `base = "<hex>"` to <target>:~/.config/theme/
# override.toml; the remote's theme-apply folds it into the effective palette and
# the Zellij `system` theme at shell startup.
#
# Idempotent and safe on every connection (rsync sends only deltas). Meant to be
# driven by an ssh `Match host ... exec` hook (see ~/.ssh/config.example), but
# also runnable by hand: `theme-push <target>`.
emulate -L zsh
set -uo pipefail

target="${1:?usage: theme-push <ssh-target>}"

loc_lib="${XDG_CONFIG_HOME:-$HOME/.config}/zellij/scripts/lib/terminal-location.zsh"
[[ -r "$loc_lib" ]] || exit 0
source "$loc_lib"

# Tint NAME for the target (the same resolution WezTerm uses); default grey.
name="$(tl_colorname_for_target "$target" 2>/dev/null)" || name="${TL_REMOTE_DEFAULT_COLOR:-grey}"
[[ -n "$name" ]] || name="${TL_REMOTE_DEFAULT_COLOR:-grey}"

# NAME -> hex via the shared lookup (lives in terminal-location.zsh).
hex="$(tl_hex_for_colorname "$name")" || exit 0   # unknown tint → leave the remote as-is

# Stage the override and rsync it. Timeouts mirror the symbols.db hook so a
# sleeping or unreachable target can't stall the login.
tmp="$(mktemp -t theme-override.XXXXXX)" || exit 0
{
  print -r -- "# Pushed by theme-push: per-session window tint ($name). Loose; not chezmoi-managed."
  print -r -- "base = \"$hex\""
} >"$tmp"

rsync -z --timeout=8 -e 'ssh -o ConnectTimeout=5' \
  "$tmp" "$target:.config/theme/override.toml" </dev/null >/dev/null 2>&1
rm -f "$tmp"
