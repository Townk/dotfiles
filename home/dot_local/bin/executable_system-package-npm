#!/usr/bin/env zsh
# system-package-npm — sync globally-installed npm packages against
# ~/.config/packages/Npmfile.

set -eu -o pipefail

source "$HOME/.local/lib/system-package-common.zsh"

NPMFILE="$PKG_DIR/Npmfile"

# Flags passed to sync-time `npm install -g` / `npm update -g` (not uninstall).
NPM_SYNC_FLAGS=(--no-fund)

# Packages npm itself manages as part of its runtime. Always filtered out.
NPM_RUNTIME=(npm corepack node-gyp)

npm_list_installed() {
  npm ls -g --depth=0 --json 2>/dev/null |
    jq -r '(.dependencies // {}) | keys[]' |
    grep -vxF -e "${(j:
:)NPM_RUNTIME}" || true
}

# npm_snapshot_versions — TSV "name\tversion" rows for global packages
# (excluding the npm runtime trio). Used to detect which globals changed
# across a sync so services tied to them get restarted.
npm_snapshot_versions() {
  npm ls -g --depth=0 --json 2>/dev/null |
    jq -r '(.dependencies // {}) | to_entries[]
             | select(.key as $k | ["npm", "corepack", "node-gyp"] | index($k) | not)
             | "\(.key)\t\(.value.version)"' 2>/dev/null || true
}

# npm_outdated_names
# Names of global packages with a newer version available, one per line.
# Returns non-zero when the QUERY failed, so a caller can tell "nothing is
# outdated" from "we don't know": `npm outdated` exits 1 when it FINDS
# something, so the exit code is useless and a parseable JSON object (it prints
# `{}` when nothing is outdated) is the only honest success signal.
npm_outdated_names() {
  local json=""
  json=$(npm outdated -g --json 2>/dev/null || true)
  printf '%s' "$json" | jq -e 'type == "object"' >/dev/null 2>&1 || return 1
  printf '%s' "$json" | jq -r 'keys[]' 2>/dev/null || true
}

# npm_list_rows <outdated:true|false>
# Output one "name\tversion[annotation]" TSV row per installed global package.
npm_list_rows() {
  local outdated="${1:-false}"

  # Get installed packages with versions, filtering runtime packages
  local installed_json=""
  installed_json=$(npm ls -g --depth=0 --json 2>/dev/null || printf '{}')

  # Get outdated map if needed
  local -A outdated_map
  if [[ "$outdated" == true ]]; then
    local outdated_json=""
    outdated_json=$(npm outdated -g --json 2>/dev/null || true)
    # `npm outdated` exits 1 when it FINDS something outdated, so the exit code
    # can't tell success from failure — a parseable JSON object is the only
    # honest signal (it prints `{}` when nothing is outdated). Treating a failed
    # query as an empty map would render every global package as current.
    if printf '%s' "$outdated_json" | jq -e 'type == "object"' >/dev/null 2>&1; then
      while IFS=$'\t' read -r name ver; do
        [[ -n "$name" ]] && outdated_map[$name]="$ver"
      done < <(printf '%s' "$outdated_json" |
        jq -r 'to_entries[] | "\(.key)\t\(.value.latest)"' 2>/dev/null || true)
    else
      pkg::warn_update_check_failed "npm outdated -g --json"
    fi
  fi

  # Emit rows, filtering out runtime packages via jq
  printf '%s' "$installed_json" |
    jq -r '(.dependencies // {}) | to_entries[]
             | select(.key as $k | ["npm", "corepack", "node-gyp"] | index($k) | not)
             | "\(.key)\t\(.value.version)"' 2>/dev/null |
    while IFS=$'\t' read -r name ver; do
      if [[ "$outdated" == true && -n "${outdated_map[$name]:-}" ]]; then
        ver="${ver} ${C_YEL}(update available: ${outdated_map[$name]})${C_RES}"
      fi
      printf '%s\t%s\n' "$name" "$ver"
    done
}

do_list() {
  local outdated=false
  while (($# > 0)); do
    case "$1" in
      -u | --update)
        outdated=true
        shift
        ;;
      -a | --all) shift ;; # no-op: npm has no transient-dep concept here
      *) die "unknown flag for list: $1" ;;
    esac
  done
  npm_list_rows "$outdated"
}

# npm_line_install_spec <manifest-line>
# Spec passed to `npm install -g`. For `name -- <spec>` lines, everything
# after the `--` token; otherwise the bare package name (pkg::line_canonical).
npm_line_install_spec() {
  local line="$1"
  if pkg::line_has_spec "$line"; then
    print -r -- "${line#*-- }"
  else
    pkg::line_canonical "$line"
  fi
}

# npm_build_global_if_needed <canonical-name>
# Tarball/git MCP servers may ship source-only with main=dist/index.js.
npm_build_global_if_needed() {
  local name="$1" root dir main
  root="$(npm root -g 2>/dev/null)" || return 0
  dir="$root/$name"
  [[ -d "$dir" && -f "$dir/package.json" ]] || return 0
  main=$(command jq -r '.main // empty' "$dir/package.json" 2>/dev/null)
  [[ "$main" == dist/index.js && ! -f "$dir/$main" ]] || return 0
  command jq -e '.scripts.build' "$dir/package.json" >/dev/null 2>&1 || return 0
  log_info "Building global npm package: $name"
  # A global install omits devDependencies, so the package's own build
  # toolchain is absent and `npm run build` falls through to whatever is on
  # PATH — e.g. the global `typescript`, whose major may reject the package's
  # tsconfig. Install devDeps, build against them, then prune them back out.
  (
    cd "$dir" &&
      npm install "${NPM_SYNC_FLAGS[@]}" --no-audit --include=dev &&
      npm run build
  ) || log_warn "build failed for $name"
  (cd "$dir" && npm prune --omit=dev "${NPM_SYNC_FLAGS[@]}" --no-audit) >/dev/null 2>&1 || true
}

do_sync() {
  pkg::sync_parse_args "$@"
  log_info "Syncing npm globals..."

  local declared_full declared installed before_snap after_snap line
  pkg::tmpset declared_full declared installed before_snap after_snap

  npm_snapshot_versions >"$before_snap"

  pkg::manifest_read "$NPMFILE" >"$declared_full"
  while IFS= read -r line; do
    [[ -n "$line" ]] && pkg::line_canonical "$line"
  done <"$declared_full" >"$declared"
  npm_list_installed >"$installed"

  # Uninstall extras BEFORE installing missing — if a swap puts two
  # packages on the same binary path (e.g. both ship `bin/pi`), npm
  # install would fail with EEXIST.
  pkg::diff_only_in "$installed" "$declared" | while IFS= read -r pkg; do
    [[ -n "$pkg" ]] || continue
    npm uninstall -g "$pkg" || log_warn "failed to uninstall $pkg"
  done
  pkg::diff_only_in "$declared" "$installed" | while IFS= read -r pkg; do
    [[ -z "$pkg" ]] && continue
    while IFS= read -r line; do
      [[ "$(pkg::line_canonical "$line")" == "$pkg" ]] || continue
      npm install -g "${NPM_SYNC_FLAGS[@]}" "$(npm_line_install_spec "$line")" || log_warn "failed to install $pkg"
      npm_build_global_if_needed "$pkg"
      break
    done <"$declared_full"
  done

  # `npm update -g` re-resolves the whole global tree and costs the better part
  # of a minute whether or not anything moved — the same on a routine sync where
  # every package is current. `npm outdated -g` answers "does anything actually
  # need updating?" in well under a second, so ask that first and update only
  # what it names. When the query itself fails we can't narrow safely, so fall
  # back to updating everything declared rather than silently skipping updates.
  local outdated_raw="" narrow=1
  outdated_raw=$(npm_outdated_names) || narrow=0
  local -A outdated_set=()
  if ((narrow)); then
    local n
    for n in ${(f)outdated_raw}; do
      [[ -n "$n" ]] && outdated_set[$n]=1
    done
  else
    pkg::warn_update_check_failed "npm outdated -g --json"
  fi

  # Registry packages go to npm in ONE call — `--` install-spec lines have no
  # registry entry to update and only need their post-install build check.
  local -a to_update=()
  local canon=""
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    canon=$(pkg::line_canonical "$line")
    if pkg::line_has_spec "$line"; then
      npm_build_global_if_needed "$canon"
      continue
    fi
    ((narrow)) && [[ -z "${outdated_set[$canon]:-}" ]] && continue
    to_update+=("$canon")
  done <"$declared_full"

  # --silent: npm reports "change <pkg> X => X" and "changed N packages" even
  # when the version is identical, so its output says nothing about what
  # actually happened. report::changes answers that from version snapshots,
  # and spin::quiet still surfaces npm's output if the update fails. Under
  # --verbose that chatter is what was asked for, so --silent comes off.
  if ((${#to_update} > 0)); then
    local -a npm_quiet=(--silent)
    ((PKG_VERBOSE)) && npm_quiet=()
    pkg::run_tool "npm: updating globals" \
      npm update -g "${NPM_SYNC_FLAGS[@]}" "${npm_quiet[@]}" "${to_update[@]}" || true
  fi

  # Restart services whose backing global package changed version.
  npm_snapshot_versions >"$after_snap"
  report::changes "$before_snap" "$after_snap" package
  pkg::restart_changed "$before_snap" "$after_snap"
  return 0
}

usage() {
  cat <<EOF
Syncs globally-installed npm packages against ~/.config/packages/Npmfile.

Usage:
  system-package-npm list [-u|--update]
  system-package-npm sync [-v|--verbose]
  system-package-npm -h | --help | help

Manifest lines may use \`<name> -- <install-spec>\` for non-registry installs;
the canonical \`<name>\` is diffed against \`npm ls -g\`, and the spec after
\`--\` is passed to \`npm install -g\`.

The npm runtime packages (npm, corepack, node-gyp) are always filtered out
of both the list output and the install/uninstall diff.

list flags:
  -u, --update   annotate packages with available updates
  -a, --all      no-op (npm has no transient-dep concept here)

sync flags:
  -v, --verbose  also report expected, nothing-to-do outcomes

After sync, services whose backing global package changed version and are
currently running are restarted.
EOF
}

usage_list() {
  cat <<EOF
Usage:
  system-package-npm list [-u|--update]

Emits TSV "<name>\t<version>" rows for every globally-installed npm package
(excluding the npm runtime trio: npm, corepack, node-gyp).

Flags:
  -u, --update   annotate each row with the latest available version
                 (queried via \`npm outdated -g --json\`)
  -a, --all      no-op (npm has no transient-dep concept)
EOF
}

usage_sync() {
  cat <<EOF
Usage:
  system-package-npm sync [-v|--verbose]

Flags:
  -v, --verbose  also report expected, nothing-to-do outcomes that a routine
                 sync keeps quiet

Reconciles ~/.config/packages/Npmfile against \`npm ls -g\`:

  • Globals in the manifest but not installed → \`npm install -g\`
  • Globals installed but not in the manifest → \`npm uninstall -g\`
    (runtime packages are exempt from removal)
  • Registry packages that \`npm outdated -g\` reports as behind are updated in
    one batched \`npm update -g <name...>\`; when nothing is behind, that call
    is skipped entirely (it costs ~a minute even as a no-op).
    \`--\` install-spec lines are not passed to \`npm update\` (no registry).

After sync, services whose backing global package was just upgraded and
are currently running are restarted.
EOF
}

main() {
  if [[ $# -eq 0 ]] || is_help "${1:-}"; then
    usage
    exit 0
  fi
  local cmd="$1"
  shift
  case "$cmd" in
    list)
      args_contain_help "$@" && {
        usage_list
        exit 0
      }
      do_list "$@"
      ;;
    sync)
      args_contain_help "$@" && {
        usage_sync
        exit 0
      }
      do_sync "$@"
      ;;
    *)
      usage >&2
      die "unknown subcommand: $cmd"
      ;;
  esac
}

main "$@"
