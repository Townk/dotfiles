#!/usr/bin/env zsh
# system-images — declarative manager for case-sensitive sparse disk images.
#
# Images are declared in ~/.config/packages/images.toml (loose, per-machine —
# never tracked by chezmoi, since a mountpoint/name can name work resources).
# Each top-level key is the single source of truth for THREE things:
#   [work]  →  image file  $IMG_DIR/work.sparseimage
#           →  volume name  (hdiutil -volname work)
#           →  mount dir    <mountpoint>/work
# so `mountpoint` in the TOML is the PARENT directory and the leaf is the key.
#
# Reconciliation (`sync`) only ever CREATES and MOUNTS — it never deletes an
# image, because images hold real data. Deletion is the separate, interactively
# confirmed `remove`. Login-time mounting is handled out-of-band by a generic
# launchd agent (the `[images-automount]` entry in services.toml runs
# `system-images mount --all`); this tool owns no launchd state of its own.
#
# Subcommands: list | status <name> | create <name> | mount <name>|--all |
#              unmount <name> | sync | remove <name>
# Internal:    names   (declared keys, used by completion)
#
# macOS only (hdiutil / diskutil); excluded elsewhere via .chezmoiignore.tmpl.

set -eu -o pipefail

source "$HOME/.local/lib/system-package-common.zsh"

require_cmd yq jq hdiutil plutil

# images.toml lives in $PKG_DIR (~/.config/packages) alongside the other
# system-* manifests. The images themselves live in XDG state.
IMGFILE="${IMGFILE:-$PKG_DIR/images.toml}"
IMG_DIR="${IMG_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/images}"

usage() {
  cat <<EOF
Manage the local sparse disk images declared in images.toml — create, mount,
sync, and remove them.

Usage:
  system-images                       alias for \`list\`
  system-images list                  show declared + on-disk images
  system-images status  <name>        show one image's resolved config + state
  system-images create  <name>        create the sparse image (from images.toml)
  system-images mount   <name>        mount one image
  system-images mount   --all         mount every automount image
  system-images unmount <name>        detach one image
  system-images sync                  create missing + mount automount (never deletes)
  system-images remove  <name>        delete an image file (interactive, destructive)
  system-images -h | --help | help    show this help

Manifest: $IMGFILE
Images:   $IMG_DIR

Run \`system-images <command> --help\` for per-command details.
EOF
}

usage_for() {
  case "$1" in
    create)
      cat <<EOF
Usage:
  system-images create <name>

Creates \$IMG_DIR/<name>.sparseimage from the images.toml entry:
  hdiutil create -type SPARSE -fs 'Case-sensitive APFS' \\
    -size <size|max> -volname <name> ...

\`size\` defaults to "max" → the host root volume's total capacity (a sparse
image only consumes real space as written, so this is just a ceiling).
Refuses if the image file already exists.
EOF
      ;;
    mount)
      cat <<EOF
Usage:
  system-images mount <name>
  system-images mount --all

Attaches the image at <mountpoint>/<name> with -nobrowse (hidden from Finder).
\`--all\` mounts every image whose entry sets \`automount = true\`; images whose
file does not yet exist are skipped (so the login agent is a clean no-op on a
machine with no images.toml).
EOF
      ;;
    sync)
      cat <<EOF
Usage:
  system-images sync

For each declared image: create it if the file is missing, ensure the mount
directory, and mount it if \`automount\` is set and it isn't already mounted.
Never deletes — removing an image is the separate \`remove\` command.
EOF
      ;;
    remove)
      cat <<EOF
Usage:
  system-images remove <name>

Permanently deletes \$IMG_DIR/<name>.sparseimage (unmounting it first). Refuses
without an interactive terminal and requires typing the image name to confirm.
EOF
      ;;
    *)
      usage
      ;;
  esac
}

# img::toml_json — cached-free JSON view of images.toml. Empty `{}` if the
# manifest doesn't exist (it's loose; a machine may have none).
img::toml_json() {
  if [[ -f "$IMGFILE" ]]; then
    yq -p toml -o json '.' "$IMGFILE"
  else
    printf '{}\n'
  fi
}

# img::names — top-level keys, one per line
img::names() {
  img::toml_json | jq -r 'keys[]' 2>/dev/null || true
}

# img::declared <name> → 0 iff <name> exists in images.toml
img::declared() {
  img::toml_json | jq -e --arg n "$1" 'has($n)' >/dev/null 2>&1
}

# img::field <name> <field> → raw value or empty
img::field() {
  img::toml_json | jq -r --arg n "$1" --arg f "$2" '.[$n][$f] // empty'
}

# img::imgpath <name> → absolute path of the sparseimage file
img::imgpath() { printf '%s/%s.sparseimage\n' "$IMG_DIR" "$1"; }

# img::mountdir <name> → <mountpoint>/<name>, with ~ expanded to $HOME
img::mountdir() {
  local name="$1" mp
  mp=$(img::field "$name" mountpoint)
  [[ -n "$mp" ]] || die "image '$name' has no mountpoint in $IMGFILE"
  mp="${mp/#\~/$HOME}"
  printf '%s/%s\n' "${mp%/}" "$name"
}

# img::automount <name> → 0 iff automount = true
img::automount() {
  [[ "$(img::field "$1" automount)" == "true" ]]
}

# img::attach_info <name> → the single source of truth for "is this image
# attached, and where". Matches the image by its image-path (NOT by any
# declared/derived mount directory), so an image the user attached by any
# means — Finder double-click, `open x.sparseimage`, or a bare
# `hdiutil attach` (all of which mount at /Volumes/<volname>) — is seen too.
#
# On success prints one line, "<dev-node>\t<mount-point>":
#   * <dev-node>    the image's whole-disk /dev entry — what `hdiutil detach`
#                   wants (a device, never a mount point).
#   * <mount-point> the first mounted volume's mount point, or empty when the
#                   image is attached with no mounted volume (e.g. ejected in
#                   Finder while the /dev/diskN device lingers).
# Returns 0 iff the image is attached at all, 1 otherwise. Shared by
# img::is_mounted and `remove` so both agree on attach state.
img::attach_info() {
  local img js line
  img=$(img::imgpath "$1")
  js=$(hdiutil info -plist 2>/dev/null | plutil -convert json -o - -- - 2>/dev/null) || return 1
  line=$(printf '%s' "$js" | jq -r --arg p "$img" '
    .images[]? | select(."image-path" == $p)
    | ([.["system-entities"][]?["dev-entry"]] | map(select(. != null)) | .[0] // "")
      + "\t"
      + ([.["system-entities"][]? | select(has("mount-point")) | .["mount-point"]] | .[0] // "")
  ') || return 1
  [[ -n "$line" ]] || return 1
  printf '%s\n' "$line"
}

# img::is_mounted <name> → 0 iff the image is attached AND has a mounted
# volume, wherever that volume sits. Delegates to img::attach_info, so a
# volume mounted outside the declared <mountdir>/<name> is reported mounted
# rather than silently unmounted.
img::is_mounted() {
  local info
  info=$(img::attach_info "$1") || return 1
  [[ -n "${info#*$'\t'}" ]]
}

# img::mount_point <name> → the actual mount point when attached+mounted,
# else empty. Returns 1 when the image is not attached at all.
img::mount_point() {
  local info
  info=$(img::attach_info "$1") || return 1
  printf '%s\n' "${info#*$'\t'}"
}

# img::du <file> → human-readable real on-disk usage
img::du() { du -h "$1" 2>/dev/null | awk '{print $1; exit}'; }

# img::disk_total → root volume total capacity as an hdiutil size (e.g. "994g")
img::disk_total() {
  local kb
  kb=$(df -k / | awk 'NR==2 {print $2}')
  [[ -n "$kb" ]] || die "could not determine root volume capacity"
  printf '%sg\n' "$((kb / 1024 / 1024))"
}

# img::size_arg <name> → the -size value (declared size, or disk total for max)
img::size_arg() {
  local s
  s=$(img::field "$1" size)
  if [[ -n "$s" && "$s" != "max" ]]; then
    printf '%s\n' "$s"
  else
    img::disk_total
  fi
}

# img::fs_arg <name> → the hdiutil -fs string (only case-sensitive-apfs for now)
img::fs_arg() {
  case "$(img::field "$1" filesystem)" in
    "" | case-sensitive-apfs) printf 'Case-sensitive APFS\n' ;;
    *) die "unsupported filesystem for '$1' (only 'case-sensitive-apfs')" ;;
  esac
}

# --- subcommands ------------------------------------------------------------

img::create_one() {
  local name="$1"
  img::declared "$name" || die "no such image in $IMGFILE: $name"
  local img
  img=$(img::imgpath "$name")
  [[ -e "$img" ]] && die "image already exists: $img"
  local fs size
  fs=$(img::fs_arg "$name")
  size=$(img::size_arg "$name")
  mkdir -p "$IMG_DIR"
  log_info "creating $name.sparseimage (fs='$fs', size=$size, volname=$name)"
  # Pass the path without the extension; hdiutil appends .sparseimage for SPARSE.
  hdiutil create -type SPARSE -fs "$fs" -size "$size" -volname "$name" "$IMG_DIR/$name"
  log_ok "created $img"
}

img::mount_one() {
  local name="$1"
  img::declared "$name" || die "no such image in $IMGFILE: $name"
  local img
  img=$(img::imgpath "$name")
  [[ -e "$img" ]] || die "image file missing (run 'system-images create $name' or 'sync'): $img"
  # Skip if the image is attached AT ALL (anywhere) — re-running `hdiutil
  # attach` on an already-attached image fails, which aborts under set -e.
  local info
  if info=$(img::attach_info "$name"); then
    local mp="${info#*$'\t'}"
    if [[ -n "$mp" ]]; then
      log_info "$name already mounted at $mp"
    else
      log_info "$name already attached (no mounted volume)"
    fi
    return 0
  fi
  local dir
  dir=$(img::mountdir "$name")
  mkdir -p "$dir"
  hdiutil attach "$img" -mountpoint "$dir" -nobrowse >/dev/null
  log_ok "mounted $name at $dir"
}

img::mount_all() {
  local name=""
  for name in ${(f)"$(img::names)"}; do
    [[ -z "$name" ]] && continue
    img::automount "$name" || continue
    local img
    img=$(img::imgpath "$name")
    [[ -e "$img" ]] || {
      log_warn "skip $name: image file missing ($img)"
      continue
    }
    img::attach_info "$name" >/dev/null && continue   # already attached anywhere
    local dir
    dir=$(img::mountdir "$name")
    mkdir -p "$dir"
    if hdiutil attach "$img" -mountpoint "$dir" -nobrowse >/dev/null; then
      log_ok "mounted $name at $dir"
    else
      log_warn "failed to mount $name"
    fi
  done
}

do_mount() {
  if [[ "${1:-}" == "--all" ]]; then
    img::mount_all
  else
    [[ $# -eq 1 ]] || {
      usage_for mount >&2
      die "mount requires one image name or --all"
    }
    img::mount_one "$1"
  fi
}

do_unmount() {
  [[ $# -eq 1 ]] || die "usage: unmount <name>"
  local name="$1"
  img::declared "$name" || die "no such image in $IMGFILE: $name"
  # Detach by DEVICE, resolved from the image itself, so a volume mounted
  # outside the declared dir (Finder / `open` / bare attach) is still torn
  # down — detaching the declared dir would be a no-op there.
  local info
  if ! info=$(img::attach_info "$name"); then
    log_info "$name not mounted"
    return 0
  fi
  local dev="${info%%$'\t'*}" mp="${info#*$'\t'}"
  hdiutil detach "$dev" >/dev/null
  log_ok "unmounted $name (${mp:-$dev})"
}

do_sync() {
  log_info "Syncing sparse images..."
  local name=""
  for name in ${(f)"$(img::names)"}; do
    [[ -z "$name" ]] && continue
    [[ -e "$(img::imgpath "$name")" ]] || img::create_one "$name"
    img::automount "$name" && img::mount_one "$name"
  done
  log_ok "image sync complete"
}

do_status() {
  [[ $# -eq 1 ]] || die "usage: status <name>"
  local name="$1"
  img::declared "$name" || die "no such image in $IMGFILE: $name"
  local img
  img=$(img::imgpath "$name")
  printf '%s%s%s\n' "$C_BWH" "$name" "$C_RES"
  printf '  image:      %s%s\n' "$img" "$([[ -e "$img" ]] && printf '' || printf '  (missing)')"
  printf '  volname:    %s\n' "$name"
  printf '  mountpoint: %s\n' "$(img::mountdir "$name")"
  local st_info st_mounted='no'
  if st_info=$(img::attach_info "$name"); then
    local st_mp="${st_info#*$'\t'}"
    if [[ -n "$st_mp" ]]; then
      st_mounted="yes (at $st_mp)"
    else
      st_mounted="attached (no mounted volume)"
    fi
  fi
  printf '  mounted:    %s\n' "$st_mounted"
  printf '  automount:  %s\n' "$(img::automount "$name" && printf 'yes' || printf 'no')"
  printf '  manifest entry:\n'
  img::toml_json | jq --arg n "$name" '.[$n]' | sed 's/^/    /'
}

# do_list — emit TSV rows: Image\tState\tSize\tMountpoint (piped to
# pkg::table_print by the caller). State: mounted | attached (device present,
# no mounted volume) | unmounted | missing (declared, no file) | undeclared
# (file on disk but not in images.toml). When mounted, the Mountpoint column
# shows the ACTUAL mount point, which may differ from the declared dir.
do_list() {
  local name img dir state size f base info mp
  for name in ${(f)"$(img::names)"}; do
    [[ -z "$name" ]] && continue
    img=$(img::imgpath "$name")
    dir=$(img::mountdir "$name")
    if [[ ! -e "$img" ]]; then
      state="missing"
      size="-"
    elif info=$(img::attach_info "$name"); then
      mp="${info#*$'\t'}"
      size=$(img::du "$img")
      if [[ -n "$mp" ]]; then
        state="mounted"
        dir="$mp"            # report the ACTUAL mount point
      else
        state="attached"     # /dev/diskN present but no mounted volume
      fi
    else
      state="unmounted"
      size=$(img::du "$img")
    fi
    printf '%s\t%s\t%s\t%s\n' "$name" "$state" "$size" "$dir"
  done
  for f in "$IMG_DIR"/*.sparseimage(N); do
    base="${f:t:r}"
    img::declared "$base" && continue
    printf '%s\t%s\t%s\t%s\n' "$base" "undeclared" "$(img::du "$f")" "-"
  done
}

# img::confirm_name <name> → the interactive "type the name" gate for the
# destructive `remove`. Factored into its own seam so do_remove's teardown +
# delete logic is unit-testable without a controlling terminal. Returns 0 on
# a correct confirmation; dies otherwise (or when there is no tty).
img::confirm_name() {
  local name="$1"
  have_tty || die "remove needs an interactive terminal (it is destructive)"
  printf '%s⚠ this permanently deletes %s and ALL its contents.%s\n' \
    "$C_YEL" "$(img::imgpath "$name")" "$C_RES" >&2
  printf 'Type the image name (%s) to confirm: ' "$name" >&2
  local ans=""
  IFS= read -r ans </dev/tty || true
  [[ "$ans" == "$name" ]] || die "aborted (got '$ans')"
}

do_remove() {
  [[ $# -eq 1 ]] || die "usage: remove <name>"
  local name="$1"
  img::declared "$name" || die "no such image in $IMGFILE: $name"
  local img
  img=$(img::imgpath "$name")
  [[ -e "$img" ]] || die "image file does not exist: $img"
  img::confirm_name "$name"
  # Detach by DEVICE, resolved from the image itself — never by the declared
  # mount dir. If the image is attached elsewhere (Finder / open) or ejected
  # in Finder with the /dev/diskN device still live, a mount-dir detach is a
  # silent no-op and `rm -f` would unlink the backing store of a LIVE device
  # (unrecoverable). Detach the device, then REFUSE to delete unless the image
  # is confirmed no longer attached.
  local info dev
  if info=$(img::attach_info "$name"); then
    dev="${info%%$'\t'*}"
    [[ -n "$dev" ]] && hdiutil detach "$dev" >/dev/null 2>&1 || true
    if img::attach_info "$name" >/dev/null 2>&1; then
      die "image '$name' is still attached (detach failed); refusing to delete $img"
    fi
  fi
  rm -f "$img"
  log_ok "removed $img"
}

main() {
  local cmd="${1:-list}"
  shift 2>/dev/null || true

  case "$cmd" in
    -h | --help | help)
      usage
      exit 0
      ;;
    list)
      args_contain_help "$@" && {
        usage_for list
        exit 0
      }
      do_list | pkg::table_print $'Image\tState\tSize\tMountpoint'
      ;;
    sync)
      args_contain_help "$@" && {
        usage_for sync
        exit 0
      }
      do_sync
      ;;
    mount)
      args_contain_help "$@" && {
        usage_for mount
        exit 0
      }
      do_mount "$@"
      ;;
    status | create | unmount | remove)
      args_contain_help "$@" && {
        usage_for "$cmd"
        exit 0
      }
      [[ $# -eq 1 ]] || {
        usage_for "$cmd" >&2
        die "$cmd requires exactly one image name"
      }
      case "$cmd" in
        status) do_status "$1" ;;
        create) img::create_one "$1" ;;
        unmount) do_unmount "$1" ;;
        remove) do_remove "$1" ;;
      esac
      ;;
    names) img::names ;;
    *)
      usage
      die "unknown subcommand: $cmd"
      ;;
  esac
}

# Run main only when executed as a script, not when sourced — this lets the
# ShellSpec suite source the file to drive the img:: helpers in-process. When
# run as `zsh system-images …`, $zsh_eval_context is exactly "toplevel"; a
# `source` from another shell/function appends ":file", so the guard is a
# no-op change for every real invocation.
if [[ "$zsh_eval_context" == toplevel ]]; then
  main "$@"
fi
