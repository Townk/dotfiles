#!/usr/bin/env zsh
# rip-disc — rip the disc in the drive as ONE observable job:: job. Two
# flows share this bin:
#
#   SESSION (the Rip Session Review panel, ripper/session-dialog.lua): the
#   panel scans the disc, the operator marks every title Feature / Extra /
#   Skip and names them, and the resulting plan becomes one job that rips,
#   encodes, publishes and pushes the whole disc.
#
#   AUTO (UX v2, unchanged): makemkvcon rips the longest title into
#   .work/autorip, then the pipeline encodes, pushes, verifies, and cleans.
#
#   rip-disc "<Title (Year)>"           auto: enqueue
#   rip-disc --worker "<title>"         auto: internal, the job body
#   rip-disc --scan                     session: one JSON line per disc title
#   rip-disc --have "<Movie (Year)>"    session: 0 have / 1 absent / 2 unknown
#   rip-disc --library                  session: the server's movies, one per line
#   rip-disc --session <plan.json>      session: enqueue the plan
#   rip-disc --session-worker <plan>    session: internal, the job body

set -eu -o pipefail

RIP_LIB_DIR="${RIP_LIB_DIR:-$HOME/.local/lib}"
source "$RIP_LIB_DIR/rip.zsh" || {
  print -ru2 -- "rip-disc: cannot source rip.zsh from $RIP_LIB_DIR"
  exit 1
}

case "${1:-}" in
  --scan) rip::session_scan ;;
  --have) shift; rip::session_have "${1:?movie title required}" ;;
  --library) rip::session_library ;;
  --session) shift; rip::session_enqueue "${1:?plan file required}" ;;
  --session-worker) shift; rip::session_worker "${1:?plan file required}" ;;
  --worker) shift; rip::disc_worker "${1:?title required}" ;;
  "" | --help) print -ru2 -- 'usage: rip-disc "<Title (Year)>" | --scan | --have "<Movie (Year)>" | --library | --session <plan.json>'; exit 2 ;;
  *) rip::disc_enqueue "$1" ;;
esac
