#!/usr/bin/env zsh
#
# preview — render a preview for fzf's `--preview` hook, Yazi's shell
# previewer, and any other terminal tool that calls it with a file path.
#
# Dispatch (top-down, first match wins):
#
#   1. Pre-dispatch guards: empty arg, directory, missing/unreadable
#      file, zero-byte file — each one short-circuits to a banner or
#      a directory listing before any expensive work runs.
#   2. By-extension routing: extensions encode user intent that MIME
#      alone can't (e.g. `.ipynb` is `application/json` but wants
#      notebook-specific rendering). Most-specific wins.
#   3. By-MIME routing: handles content where the extension is missing
#      or insufficient — images, archives, audio/video, PDFs.
#   4. Encoding fallback: `binary` → hex dump.
#   5. Default: syntax-highlighted text via bat.
#
# Each handler is a `preview-*` function. Add a new file type by
# writing the handler and dropping a case arm into `main()`. Handlers
# read pane geometry from globals `w`, `h`, `max_lines` set by
# `geometry()`, and return non-zero when their required tool isn't
# installed so the dispatcher can fall through to a more generic path.
#
# Lives as a script (not a zsh function) so fzf's preview subshell —
# spawned via `$SHELL -c '<cmd>'`, non-interactive, no ~/.config/zsh/.zshrc — can
# find it via PATH.

set -u

[[ -r ~/.local/lib/image-protocol-support.zsh ]] && . ~/.local/lib/image-protocol-support.zsh

# === Helpers ===

# Render a centered, bannered status message inside the preview pane.
# Used for placeholder text like "Nothing to preview" or "<Empty File>"
# — single-line strings that look out of place rendered raw at column 0.
#
# Tries figlet first with the user's `phm-minecraft.flf` font, then
# falls back to plain text if (a) figlet isn't on PATH or (b) the
# rendered banner would overflow `box_w`. Either way the output is
# centered horizontally and vertically inside the requested box.
#
# Args:
#   $1   text to render (single line; figlet handles word art)
#   $2   box width in columns (default 80)
#   $3   box height in lines  (default 24)
function stamp-msg() {
  local text="$1"
  local box_w="${2:-80}"
  local box_h="${3:-24}"

  local figlet_fonts_dir="${XDG_DATA_HOME:-$HOME/.local/share}/fonts/figlet"
  local figlet_font="phm-minecraft.flf"

  local use_fallback=0
  local text_w=0
  local text_h=0
  local final_output=""

  if command -v figlet >/dev/null 2>&1; then
    # 1. Force figlet to render with massive limits to prevent premature wrapping
    local raw_figlet
    raw_figlet=$(figlet -d "$figlet_fonts_dir" -f "$figlet_font" -w 9999 "$text")

    # Measure figlet's true footprint. Split into a line array with
    # zsh's (f) flag, then take ${#first_line} for width and $#array
    # for height — no subprocess overhead vs. the previous wc pipes.
    local -a raw_lines=(${(f)raw_figlet})
    local figlet_true_w=${#raw_lines[1]}

    # 2. Check if the banner breaks out of your boundaries
    if ((figlet_true_w > box_w)); then
      use_fallback=1
    else
      # If it fits perfectly, commit the cached output
      final_output="$raw_figlet"
      text_h=$#raw_lines
      text_w=$figlet_true_w
    fi
  else
    use_fallback=1
  fi

  # 3. Fallback logic (Plain text configuration)
  if ((use_fallback)); then
    # Re-measure raw single-line text width
    text_w=${#text}

    # If even the standard text is too wide for box_w, truncate or clamp width
    if ((text_w > box_w)); then
      text_w=$box_w
    fi
    local -a text_lines=(${(f)text})
    text_h=$#text_lines
    final_output="$text"
  fi

  # 4. Geometry Centering Calculations
  local pad_top=$(((box_h - text_h) / 2))
  local pad_left=$(((box_w - text_w) / 2))

  ((pad_top < 0)) && pad_top=0
  ((pad_left < 0)) && pad_left=0

  # Print layout vertical padding. Guard against pad_top=0: `printf` runs
  # its format string once even with zero args, which would emit a stray
  # newline.
  ((pad_top > 0)) && printf '\n%.0s' $(seq 1 "$pad_top")

  # Generate spacing padding matching the offset
  local left_space=$(printf '%*s' "$pad_left" "")

  # 5. Output rendering loop
  printf '%s\n' "$final_output" | while IFS= read -r line; do
    # If line truncation is needed for plain text overflowing box_w:
    if ((use_fallback && ${#line} > box_w)); then
      printf '%s%s\n' "$left_space" "${line:0:$box_w}"
    else
      printf '%s%s\n' "$left_space" "$line"
    fi
  done
}

# Run a command as if it were attached to an interactive TTY, even
# though fzf has handed us pipe stdio. Some tools (notably `ouch list
# -t` and other tree/colorized renderers) detect "stdout is not a tty"
# and silently downgrade to a plain, scriptable format that strips
# colors and structure — useless for a fancy preview. Wrapping them
# through `unbuffer(1)` or `script(1)` allocates a pseudo-tty so the
# tool produces its full output, which fzf can then render.
#
# Prefers `unbuffer` (from the `expect` package) when available.
# Otherwise falls back to `script(1)`, using BSD-style invocation on
# macOS and GNU-style on Linux (the two flavors take different args).
#
# Args:
#   $1   command to run
#   $2+  arguments to pass to the command
function force-tty() {
  if (($# < 1)); then
    echo "Usage: force-tty <command> [args...]" >&2
    return 2
  fi

  local cmd="$1"
  shift

  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "force-tty: command not found: $cmd" >&2
    return 127
  fi

  if command -v unbuffer >/dev/null 2>&1; then
    unbuffer "$cmd" "$@"
  elif [[ "$(uname -s)" = "Darwin" ]]; then
    script -q /dev/null "$cmd" "$@"
  else
    local quoted
    printf -v quoted '%q ' "$cmd" "$@"
    script -q -c "$quoted" /dev/null
  fi
}

# === Raster cache ===
#
# Expensive raster renders (PDF pages, video frames, font sheets, Adobe
# renders, cover art) cache under $PREVIEW_CACHE_DIR, shared by the fzf
# and yazi callers. Chafa output itself is never cached — it depends on
# pane geometry and terminal protocol; only the intermediate PNG is.

zmodload -F zsh/stat b:zstat 2>/dev/null
PREVIEW_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/preview"

# Deterministic cache path for a rendered raster of $1. Key = source path
# + mtime + size + tag + skip, so touching the source invalidates and PDF
# pages / video seeks get distinct entries.
#
# Args: $1 source path, $2 tag (handler name), $3 skip variant (default 0)
function raster-cache-path() {
  local src="$1" tag="$2" skip="${3:-0}" mt sz key
  mt=$(zstat +mtime "$src" 2>/dev/null) || mt=0
  sz=$(zstat +size "$src" 2>/dev/null) || sz=0
  key=$(print -rn -- "$src|$mt|$sz|$tag|$skip" | shasum | cut -d' ' -f1)
  print -rn -- "$PREVIEW_CACHE_DIR/$key.png"
}

# Run a render function only when the cache file is missing. The function
# must write its raster to $RASTER_OUT — a temp path that keeps the .png
# suffix (fontimage and pdftocairo key output format off the extension) —
# which is then moved into place, so a killed render never leaves a
# truncated raster to be served later.
#
# Args: $1 cache file (from raster-cache-path), $2+ render fn and its args
function render-cached() {
  local out="$1"
  shift
  [[ -s $out ]] && return 0
  mkdir -p "${out:h}" 2>/dev/null || return 1
  local tmp="$out.$$.png"
  RASTER_OUT="$tmp" "$@" >/dev/null 2>&1
  local exitcode=$?
  if (( exitcode == 0 )) && [[ -s $tmp ]]; then
    mv -f "$tmp" "$out"
    return 0
  fi
  rm -f "$tmp"
  return 1
}

# Chafa a raster at the current pane geometry (shared image-paint tail for
# every raster handler on the fzf/text path).
function preview-raster() {
  command -v chafa >/dev/null 2>&1 || return 1
  local chafa_format
  chafa_format=(${(z)$(get_chafa_format_args)})
  chafa "${chafa_format[@]}" -s "${w:-80}x${h:-24}" "$1" 2>/dev/null
}

# Opportunistic cache prune: at most once a day (stamp file), drop rasters
# untouched for 30 days. Called backgrounded from main().
function prune-raster-cache() {
  [[ -d $PREVIEW_CACHE_DIR ]] || return 0
  local stamp="$PREVIEW_CACHE_DIR/.prune-stamp" now mt
  now=$(date +%s)
  mt=$(zstat +mtime "$stamp" 2>/dev/null) || mt=0
  ((now - mt < 86400)) && return 0
  touch "$stamp"
  find "$PREVIEW_CACHE_DIR" -type f -name '*.png' -mtime +30 -delete 2>/dev/null
}

function get_chafa_format_args() {
  local protocols

  if protocols=$(get_terminal_image_protocol 2>/dev/null); then
    if [[ " $protocols " == *" Sixel "* ]]; then
      echo "-f sixel"
    elif [[ " $protocols " == *" iTerm2 "* ]]; then
      echo "-f iterm"
    elif [[ " $protocols " == *" Kitty "* ]]; then
      echo "-f kitty"
    else
      echo "-f symbols"
    fi
  else
    echo "-f symbols"
  fi
}

# === Handlers ===
#
# Convention:
#   - Take the target path as $1.
#   - Read pane geometry from globals `w`, `h`, `max_lines`.
#   - `command -v` guard up front; return 1 when the tool isn't
#     installed so the dispatcher can try a more generic handler.
#   - Cap text output at $max_lines lines.

function preview-dir() {
  eza -F -h --group-directories-first --icons --hyperlink --tree \
    --color=always --level=2 "$1" | head -200
}

function preview-csv() {
  command -v tv >/dev/null 2>&1 || return 1
  tv -a --no-streaming -f -j -D "$1" | head -"$max_lines"
}

function preview-md() {
  command -v glow >/dev/null 2>&1 || return 1
  command -v expect >/dev/null 2>&1 || return 1
  local style="${XDG_CONFIG_HOME:-$HOME/.config}/glow/chezmoi-system.json"
  # glow 2.x (termenv v0.16) only emits 16-color ANSI on a pipe even with
  # CLICOLOR_FORCE, and hangs on a pseudo-TTY because lipgloss sends terminal
  # queries (OSC 10/11, DSR 6n) and blocks waiting for responses. We use
  # expect to spawn glow on a real pty, answer those queries, and relay the
  # TrueColor output.
  GW_STYLE="$style" GW_WIDTH="$w" GW_FILE="$1" expect -c '
    log_user 0
    set timeout 3
    spawn glow -s $env(GW_STYLE) -w $env(GW_WIDTH) $env(GW_FILE)
    expect {
      -re "\033\\]11;\\?" { send "\033\]11;rgb:1e1e/2e2e/2e2e\033\\" ; exp_continue }
      -re "\033\\]10;\\?" { send "\033\]10;rgb:cdcd/d6d6/f4f4\033\\" ; exp_continue }
      -re "\033\\\[6n"    { send "\033\[1;1R" ; exp_continue }
      -re ".+"            { puts -nonewline $expect_out(0,string) ; exp_continue }
      eof
    }
  ' 2>/dev/null | tr -d '\r' | head -"$max_lines"
}

function preview-rich() {
  command -v rich >/dev/null 2>&1 || return 1
  # `--theme catppuccin-mocha` requires the catppuccin-pygments package
  # in rich-cli's uv venv (declared via `--with` in dot_config/packages/Uvfile.tmpl).
  rich -w "$w" -j --left --guides --line-numbers --theme catppuccin-mocha \
    --force-terminal "$1" | head -"$max_lines"
}

function preview-json() {
  command -v jq >/dev/null 2>&1 || return 1
  jq -C --indent 2 <"$1" | head -"$max_lines"
}

function preview-yaml() {
  command -v yq >/dev/null 2>&1 || return 1
  yq -C --indent 2 <"$1" | head -"$max_lines"
}

function preview-xml() {
  command -v xq >/dev/null 2>&1 || return 1
  xq -c --indent 2 <"$1" | head -"$max_lines"
}

function preview-disk-image() {
  [[ "$(uname -s)" == "Darwin" ]] || return 1
  local viewer="$HOME/.local/libexec/disk-image-view"
  [[ -x $viewer ]] || return 1
  "$viewer" "$1" -W "$w" | head -"$max_lines"
}

function preview-ics() {
  local viewer="$HOME/.local/libexec/ics-view"
  [[ -x $viewer ]] || return 1
  "$viewer" "$1" -W "$w" | head -"$max_lines"
}

function preview-sqlite() {
  local viewer="$HOME/.local/libexec/sqlite-view"
  [[ -x $viewer ]] || return 1
  "$viewer" "$1" -W "$w" | head -"$max_lines"
}

function preview-archive() {
  local out
  if command -v ouch >/dev/null 2>&1; then
    out=$(force-tty ouch list -q -y -t "$1" 2>/dev/null)
    if [[ -n ${out//[[:space:]]/} ]]; then
      print -r -- "$out" | head -"$max_lines"
      return 0
    fi
  fi
  # Formats ouch can't read (lzh, cab, …): 7zz covers the long tail.
  command -v 7zz >/dev/null 2>&1 || return 1
  7zz l "$1" 2>/dev/null | head -"$max_lines"
}

function preview-font() {
  local cache
  # Tag carries a sample-algorithm version: bumping it invalidates sheets
  # rendered by older sample logic (the font file itself rarely changes).
  cache=$(raster-cache-path "$1" font-grid4) || return 1
  render-cached "$cache" render-font-sheet "$1" || return 1
  preview-raster "$cache"
}

# Sample text drawn from the font's own cmap (fc-query charset), spread
# evenly across its coverage — so symbol/icon fonts (e.g. Nerd Fonts
# symbols-only builds) show real glyphs instead of .notdef tofu, while
# text fonts still lead with their alphabet. Empty output → caller falls
# back to fontimage's built-in Latin sample.
#
# Output: line 1 is "space"/"nospace" — whether the cmap covers U+0020
# (fonts without it, e.g. emoji-only builds, render every space separator
# as .notdef tofu, so the renderer must not join glyphs with spaces) —
# followed by one glyph per line.
function font-sample-text() {
  command -v fc-query >/dev/null 2>&1 || return 1
  local -a ranges bounds
  ranges=($(fc-query --format '%{charset}' "$1" 2>/dev/null))
  ((${#ranges})) || return 1

  local lo hi total=0 has_space=0
  for range in "${ranges[@]}"; do
    if [[ $range == *-* ]]; then
      lo=$((16#${range%-*})); hi=$((16#${range#*-}))
    else
      lo=$((16#$range)); hi=$lo
    fi
    ((lo <= 0x20 && hi >= 0x20)) && has_space=1
    ((hi < 0x21)) && continue                      # controls/space
    ((lo < 0x21)) && lo=0x21
    ((lo >= 0xd800 && hi <= 0xdfff)) && continue   # surrogates
    ((lo >= 0xfe00 && hi <= 0xfe0f)) && continue   # variation selectors
    ((lo >= 0x1f3fb && hi <= 0x1f3ff)) && continue # skin-tone modifiers
    bounds+=("$lo $hi")
    ((total += hi - lo + 1))
  done
  ((total)) || return 1

  local want=36 stride=$((total / 36)) idx=0 n=0 cp
  local -a out=()
  ((stride < 1)) && stride=1
  for b in "${bounds[@]}"; do
    lo=${b%% *}; hi=${b##* }
    for ((cp = lo; cp <= hi; cp++)); do
      if ((idx % stride == 0 && n < want)); then
        if ((cp < 0x7f || cp > 0xa0)); then        # skip DEL..NBSP block
          out+=("${(#)cp}")
          ((n++))
        fi
      fi
      ((idx++))
      ((n >= want)) && break
    done
    ((n >= want)) && break
  done
  ((${#out})) || return 1
  ((has_space)) && print space || print nospace
  print -rl -- "${out[@]}"
}

# No font-name header anywhere: renderers can only draw it with the font
# under preview, which turns into .notdef tofu for symbol/emoji fonts.
function render-font-sheet() {
  local -a lines glyphs
  lines=("${(@f)$(font-sample-text "$1")}")
  local sep="  "
  if ((${#lines} > 1)); then
    [[ ${lines[1]} == nospace ]] && sep=""
    glyphs=("${(@)lines[2,-1]}")
  fi

  # Preferred: per-glyph hb-view tiles composed with magick montage —
  # uniform cells and real padding regardless of the font's metrics (a
  # spacing character can't be used: emoji-only cmaps draw it as tofu),
  # and HarfBuzz rasterizes color-glyph tables (COLR/SVG/CBDT) that
  # fontimage renders blank.
  if command -v hb-view >/dev/null 2>&1 && command -v magick >/dev/null 2>&1 &&
    ((${#glyphs})); then
    local tmpd
    tmpd=$(mktemp -d) || return 1
    {
      local g i=0 tile
      for g in "${glyphs[@]}"; do
        [[ -n $g ]] || continue
        tile=$(printf '%s/%02d.png' "$tmpd" "$i")
        hb-view --font-file="$1" --font-size=96 --margin=4 \
          --output-file="$tile" "$g" 2>/dev/null || rm -f "$tile"
        ((i++))
      done
      local -a tiles=("$tmpd"/*.png(N))
      if ((${#tiles} >= 8)); then
        # Normalize each tile to a uniform padded cell (shrink-only), then
        # append rows of 6 and stack them. montage(1) would be the obvious
        # tool but it insists on resolving ImageMagick's annotation font
        # even for unlabeled grids, which this build doesn't have.
        local t
        for t in "${tiles[@]}"; do
          magick "$t" -resize '128x128>' -background white -gravity center \
            -extent 176x176 "$t" 2>/dev/null
        done
        local -a rowfiles=()
        local r rowf
        for ((r = 1; r <= ${#tiles}; r += 6)); do
          rowf="$tmpd/zrow$r.png"
          magick "${tiles[@]:$((r - 1)):6}" +append "$rowf" 2>/dev/null || continue
          rowfiles+=("$rowf")
        done
        ((${#rowfiles})) &&
          magick "${rowfiles[@]}" -background white -append "$RASTER_OUT" \
            2>/dev/null &&
          return 0
      fi
    } always {
      rm -rf "$tmpd"
    }
  fi

  # Fallbacks: single-pass renderers (glyph gaps only when the cmap has a
  # real space; row layout only in fontimage's --text lines).
  local -a row rows
  local g
  for g in "${glyphs[@]}"; do
    [[ -n $g ]] || continue
    row+=("$g")
    if ((${#row} == 8)); then
      rows+=("${(pj.$sep.)row}")
      row=()
    fi
  done
  ((${#row})) && rows+=("${(pj.$sep.)row}")

  if command -v hb-view >/dev/null 2>&1 && ((${#rows})); then
    hb-view --font-file="$1" --font-size=80 --margin=24 --line-space=40 \
      --output-file="$RASTER_OUT" "${(pj:\n:)rows}" 2>/dev/null && return 0
  fi
  if command -v fontimage >/dev/null 2>&1; then
    if ((${#rows})); then
      local -a targs=()
      for g in "${rows[@]}"; do targs+=(--text "$g"); done
      fontimage --width 1600 --pixelsize 80 "${targs[@]}" \
        -o "$RASTER_OUT" "$1" 2>/dev/null && return 0
    fi
    fontimage --width 1600 --pixelsize 80 -o "$RASTER_OUT" "$1" \
      2>/dev/null && return 0
  fi
  command -v magick >/dev/null 2>&1 || return 1
  local flat="${(j: :)glyphs}"
  magick -size 1600x -background black -fill white -font "$1" -pointsize 80 \
    label:"${flat:-AaBbCcDdEe FfGgHhIiJj 0123456789}" "$RASTER_OUT"
}

# Seek percent from --skip: 0 → ffmpegthumbnailer's 10% default, else 5%
# per unit clamped to 95% (matches the granularity yazi's mediainfo plugin
# used, so seek keys page through the file in sensible steps).
function video-seek-pct() {
  local skip="${OPT_SKIP:-0}"
  if ((skip <= 0)); then
    print -n 10
  elif ((skip * 5 > 95)); then
    print -n 95
  else
    print -n $((skip * 5))
  fi
}

function preview-video() {
  command -v ffmpegthumbnailer >/dev/null 2>&1 || return 1
  local pct cache
  pct=$(video-seek-pct)
  cache=$(raster-cache-path "$1" video "$pct") || return 1
  render-cached "$cache" render-video-frame "$1" "$pct" || return 1
  # Reserve room below for mediainfo, unless we only want the image.
  [[ -z ${PREVIEW_IMAGE_ONLY:-} ]] && h=$(((h * 6) / 10))
  preview-raster "$cache"
  [[ -z ${PREVIEW_IMAGE_ONLY:-} ]] && preview-mediainfo "$1"
  return 0
}

function render-video-frame() {
  ffmpegthumbnailer -i "$1" -o "$RASTER_OUT" -s 0 -t "$2%" -q 8
}

# Cover art above metadata when the file embeds any; metadata alone
# otherwise. Artless files re-probe on every preview (~50ms ffmpeg exit)
# rather than negative-caching — YAGNI until it shows up in practice.
function preview-audio() {
  local cache
  cache=$(raster-cache-path "$1" cover) || return 1
  if render-cached "$cache" render-audio-cover "$1"; then
    [[ -z ${PREVIEW_IMAGE_ONLY:-} ]] && h=$(((h * 6) / 10))
    preview-raster "$cache"
  fi
  preview-mediainfo "$1"
}

function render-audio-cover() {
  command -v ffmpeg >/dev/null 2>&1 || return 1
  ffmpeg -y -v error -i "$1" -an -frames:v 1 -update 1 "$RASTER_OUT"
}

# Adobe formats: magick renders the first page/layer-flatten (EPS needs
# ghostscript behind magick — when that's missing the render fails and
# dispatch falls through to text metadata).
function preview-adobe() {
  command -v magick >/dev/null 2>&1 || return 1
  local cache
  cache=$(raster-cache-path "$1" adobe) || return 1
  render-cached "$cache" render-adobe "$1" || return 1
  [[ -z ${PREVIEW_IMAGE_ONLY:-} ]] && h=$(((h * 6) / 10))
  preview-raster "$cache"
  [[ -z ${PREVIEW_IMAGE_ONLY:-} ]] && preview-mediainfo "$1"
  return 0
}

function render-adobe() {
  magick "$1[0]" -flatten -background white -alpha remove "$RASTER_OUT"
}

# Clamped 1-based page from --skip (skip 0 = page 1). pdfinfo's page count
# bounds it so seeking past the end sticks on the last page.
function pdf-page() {
  local pages page
  pages=$(pdfinfo "$1" 2>/dev/null | awk '/^Pages:/{print $2}')
  [[ -n $pages ]] || pages=1
  page=$((${OPT_SKIP:-0} + 1))
  ((page > pages)) && page=$pages
  print -n -- "$page"
}

function preview-pdf() {
  command -v pdftocairo >/dev/null 2>&1 || return 1
  local page cache
  page=$(pdf-page "$1")
  cache=$(raster-cache-path "$1" pdf "$page") || return 1
  render-cached "$cache" render-pdf-page "$1" "$page" || return 1
  preview-raster "$cache"
}

# pdftocairo -singlefile appends .png to its output prefix — strip the
# suffix from $RASTER_OUT so the file lands exactly there.
function render-pdf-page() {
  pdftocairo -png -f "$2" -l "$2" -singlefile "$1" "${RASTER_OUT%.png}"
}

function preview-image() {
  preview-raster "$1" || return 1

  # PREVIEW_IMAGE_ONLY (set by the zellij click-to-open image pane): show just
  # the image, no metadata, so it fills the pane without needing a scroll.
  if [[ -z ${PREVIEW_IMAGE_ONLY:-} ]] && command -v mediainfo >/dev/null 2>&1; then
    preview-mediainfo "$1"
  fi

  return 0
}

# mediainfo's raw output is plain `key : value` lines under bare
# section headers — parses as YAML-ish, so bat's YAML grammar gives
# colored headers, dim colons, and key/value differentiation with no
# custom logic. Approximates the styled output of Yazi's mediainfo
# plugin without parsing the output ourselves.
function preview-mediainfo() {
  command -v mediainfo >/dev/null 2>&1 || return 1
  mediainfo "$1" |
    bat --language=yaml --style=plain --color=always \
      --theme=chezmoi-system --terminal-width="$w" |
    head -"$max_lines"
}

function preview-binary() {
  if ! command -v hexyl >/dev/null 2>&1; then
    stamp-msg "Binary file" "$w" "$h"
    return
  fi
  # `--terminal-width` alone expands hexyl to as many byte-panels as
  # fit (2 panels ~76 cols, 3 panels ~100 cols, 4 panels ~125 cols);
  # `--panels=auto` is mutually exclusive with it and not needed.
  hexyl --color=always --terminal-width="$w" "$1" 2>/dev/null |
    head -"$max_lines"
}

function preview-text() {
  bat --theme=chezmoi-system --style=numbers,changes --color=always \
    --terminal-width="$w" "$1" 2>/dev/null | head -"$max_lines"
}

# === Dispatch ===

# Width/height/cap globals consumed by every handler.
#
# Precedence per source: explicit -W/-H flags (yazi shim, libexec callers)
# → FZF_PREVIEW_{COLUMNS,LINES} (fzf exports per invocation; subtract 1
# column for fzf's overlaid scrollbar) → piper's lowercase $w/$h env
# (yazi piper previewer) → 80x40 defaults.
#
# FZF_PREVIEW_FULL is the toggle wired up via ctrl-f in zshrc — set,
# it lifts the height cap so the whole file flows into the buffer.
# Unset, max_lines is `h * 3` (one viewport + two screens of scroll).
function geometry() {
  if [[ -n ${OPT_H:-} ]]; then
    h=$OPT_H
  elif [[ -n ${FZF_PREVIEW_LINES:-} ]]; then
    h=$FZF_PREVIEW_LINES
  elif [[ -z ${h:-} ]]; then
    h=40
  fi

  if [[ -n ${OPT_W:-} ]]; then
    w=$OPT_W
  elif [[ -n ${FZF_PREVIEW_COLUMNS:-} ]]; then
    w=$FZF_PREVIEW_COLUMNS
    ((w > 4)) && ((w--))
  elif [[ -z ${w:-} ]]; then
    w=80
  fi

  if [[ -n ${FZF_PREVIEW_FULL:-} ]]; then
    max_lines=999999
  else
    max_lines=$((h * 3))
  fi
}

# Yazi's native image renderer (image crate) handles these directly — the
# raster is the file itself. Everything else image-shaped goes through a
# conversion into the cache: rsvg-convert for SVG (magick commonly lacks
# an SVG delegate), magick for the rest.
function render-image-convert() {
  if [[ ${1:l} == *.svg ]] && command -v rsvg-convert >/dev/null 2>&1; then
    rsvg-convert --width 1024 --keep-aspect-ratio -o "$RASTER_OUT" "$1" && return 0
  fi
  command -v magick >/dev/null 2>&1 || return 1
  magick "$1[0]" -flatten "$RASTER_OUT"
}

# Machine half of the handlers: ensure the raster for <path> exists and
# print its path. Prints nothing for types with no raster. Never fails —
# a failed render is just "no raster".
#
# Args: $1 path, $2 mime
function raster-for() {
  local target="$1" mime="$2" cache
  case "$mime" in
    image/png | image/jpeg | image/gif | image/webp | image/bmp | image/tiff)
      print -rn -- "$target"
      ;;
    image/vnd.adobe.photoshop | application/postscript)
      cache=$(raster-cache-path "$target" adobe) &&
        render-cached "$cache" render-adobe "$target" &&
        print -rn -- "$cache"
      ;;
    image/*)
      cache=$(raster-cache-path "$target" imgconv) &&
        render-cached "$cache" render-image-convert "$target" &&
        print -rn -- "$cache"
      ;;
    video/*)
      local pct
      pct=$(video-seek-pct)
      cache=$(raster-cache-path "$target" video "$pct") &&
        render-cached "$cache" render-video-frame "$target" "$pct" &&
        print -rn -- "$cache"
      ;;
    audio/*)
      cache=$(raster-cache-path "$target" cover) &&
        render-cached "$cache" render-audio-cover "$target" &&
        print -rn -- "$cache"
      ;;
    application/pdf)
      local page
      page=$(pdf-page "$target")
      cache=$(raster-cache-path "$target" pdf "$page") &&
        render-cached "$cache" render-pdf-page "$target" "$page" &&
        print -rn -- "$cache"
      ;;
    font/* | application/vnd.ms-opentype)
      cache=$(raster-cache-path "$target" font-grid4) &&
        render-cached "$cache" render-font-sheet "$target" &&
        print -rn -- "$cache"
      ;;
  esac
  return 0
}

# --pixels entry point: line 1 = raster path (empty when the type has no
# raster), remainder = the text block. Consumed by the preview.yazi shim.
function main-pixels() {
  # Same raw-path-first unquoting rule as main() — the yazi shim always
  # passes raw paths, so only fall back to `${(Q)}` when the raw form
  # doesn't exist (fzf-quoted display strings).
  local target=${1:-}
  [[ -e $target || -L $target ]] || target=${(Q)target}
  geometry
  # geometry()'s max_lines is 3x the pane for fzf scroll-through. The yazi
  # shim can't scroll the text under an image (skip drives pdf pages /
  # video seek instead), and every emitted line shrinks the image area it
  # computes — so cap the text block at exactly one pane.
  max_lines=$h
  prune-raster-cache &!

  if [[ ! -e $target && ! -L $target ]]; then
    print -u2 "preview: no such file: $target"
    exit 1
  fi

  local mime
  mime=$(file --mime-type --brief --dereference "$target" 2>/dev/null)

  # Extension beats MIME for the same cases main() special-cases.
  case "${target:l}" in
    *.ttf | *.otf | *.woff | *.woff2 | *.ttc) mime="font/generic" ;;
    *.psd | *.ai | *.eps) mime="image/vnd.adobe.photoshop" ;;
  esac

  raster-for "$target" "$mime"
  print

  case "$mime" in
    image/* | video/* | audio/* | application/pdf | \
      font/* | application/vnd.ms-opentype | application/postscript)
      preview-mediainfo "$target"
      ;;
    *)
      PREVIEW_IMAGE_ONLY=1 main "$1"
      ;;
  esac
}

function main() {
  # fzf passes the selection as `{}` (bare fzf, super-cd, completion). The
  # display form can be shell-quoted (e.g. `2\ color\ sign\ .2mm.3mf`), so
  # $1 inherits those backslashes verbatim. `${(Q)var}` strips one level of
  # shell quoting — converting `2\ color\ sign\ .2mm.3mf` back to
  # `2 color sign .2mm.3mf` — so the subsequent stat checks find the file.
  # Yazi/piper hand over RAW paths, though — a real file whose name contains
  # a backslash or quote must not be unquoted, so prefer the path as-given
  # whenever it exists.
  local target=${1:-}
  [[ -e $target || -L $target ]] || target=${(Q)target}

  geometry
  prune-raster-cache &!

  # --- Pre-dispatch guards ---
  # Each guard rules out a class of failure mode before committing to
  # a handler. All are cheap stat checks — no forks — so doing them
  # up front saves running a tool that would just produce empty output.

  if [[ -z $target ]]; then
    stamp-msg "Nothing to preview" "$w" "$h"
    return
  fi
  if [[ -d $target && ${target:l} == *.sparsebundle ]]; then
    preview-disk-image "$target" && return
  fi
  if [[ -d $target ]]; then
    preview-dir "$target"
    return
  fi
  if [[ ! -f $target ]]; then
    # Broken symlink, device, socket, etc.
    stamp-msg "Nothing to preview" "$w" "$h"
    return
  fi
  if [[ ! -r $target ]]; then
    stamp-msg "Permission denied" "$w" "$h"
    return
  fi
  if [[ ! -s $target ]]; then
    stamp-msg "<Empty File>" "$w" "$h"
    return
  fi

  # --- By-extension dispatch ---
  # Extensions encode user intent. `.ipynb` is `application/json` by
  # MIME but you want notebook-specific rendering; same for `.vil`/
  # `.kbi` (custom JSON variants). Handlers return non-zero when the
  # required tool isn't installed, letting dispatch fall through to
  # the MIME pass (and ultimately to bat).
  case "${target:l}" in
    *.csv) preview-csv "$target" && return ;;
    *.md) preview-md "$target" && return ;;
    *.rst | *.ipynb) preview-rich "$target" && return ;;
    *.json | *.vil | *.kbi) preview-json "$target" && return ;;
    *.yml | *.yaml) preview-yaml "$target" && return ;;
    *.xml) preview-xml "$target" && return ;;
    *.dmg | *.sparseimage | *.cdr | *.img | *.iso) preview-disk-image "$target" && return ;;
    *.ics) preview-ics "$target" && return ;;
    *.ttf | *.otf | *.woff | *.woff2 | *.ttc) preview-font "$target" && return ;;
    *.psd | *.ai | *.eps) preview-adobe "$target" && return ;;
    *.db | *.sqlite | *.sqlite3) preview-sqlite "$target" && return ;;
  esac

  # --- By-MIME dispatch ---
  # Fallback for files where the extension was missing or insufficient.
  # Image/archive/AV identification works regardless of filename.
  local mime encoding
  mime=$(file --mime-type --brief --dereference "$target" 2>/dev/null)
  encoding=$(file --mime-encoding --brief --dereference "$target" 2>/dev/null)

  case "$mime" in
    application/zip | application/*zip* | application/gzip | \
      application/zstd | application/x-tar | application/x-bzip2 | \
      application/x-7z-compressed | application/x-rar | application/x-xz | \
      application/x-lzh-compressed | application/vnd.ms-cab-compressed)
      preview-archive "$target" && return
      ;;
    application/pdf)
      preview-pdf "$target" && return
      ;;
    font/* | application/vnd.ms-opentype)
      preview-font "$target" && return
      ;;
    image/vnd.adobe.photoshop | application/postscript)
      preview-adobe "$target" && return
      preview-mediainfo "$target" && return
      ;;
    image/*)
      # Reserve room below for mediainfo, unless we only want the image.
      [[ -n ${PREVIEW_IMAGE_ONLY:-} ]] || h=$(((h * 6) / 10))
      preview-image "$target" && return
      ;;
    video/*)
      preview-video "$target" && return
      preview-mediainfo "$target" && return
      ;;
    audio/*)
      preview-audio "$target" && return
      preview-mediainfo "$target" && return
      ;;
    application/subrip)
      preview-mediainfo "$target" && return
      ;;
  esac

  # Binary files that didn't match a media/archive rule: hex dump.
  if [[ $encoding == binary ]]; then
    preview-binary "$target"
    return
  fi

  # Default: syntax-highlighted text via bat.
  preview-text "$target"
}

# Test escape hatch: `PREVIEW_NO_RUN=1 source preview` loads the functions
# without parsing args or running main (see tests/preview_spec.sh).
if [[ -n ${PREVIEW_NO_RUN:-} ]]; then
  return 0 2>/dev/null || exit 0
fi

# --- CLI ---
typeset -g OPT_W='' OPT_H='' OPT_SKIP=0 OPT_PIXELS=0
while (($#)); do
  case "$1" in
    -h | --help | help)
      cat <<'EOF'
Render a preview for fzf's --preview hook, Yazi's preview.yazi shim, or any
tool that calls it with a file path. Routes by extension then MIME: images
(chafa / Kitty graphics), audio/video (mediainfo), archives, PDFs, notebooks
and data files, binary hex dump, and syntax-highlighted text via bat as the
fallback.

Usage: preview [--pixels] [-W cols] [-H lines] [--skip N] <path>

  -W/-H     pane geometry (otherwise FZF_PREVIEW_* or piper's $w/$h env)
  --skip N  PDF page (N+1) / video seek (N*5%, clamped to 95%)
  --pixels  machine interface: line 1 = raster path, rest = text block
EOF
      exit 0
      ;;
    -W) OPT_W="${2:-}"; { (($# >= 2)) && shift 2 } || shift ;;
    -H) OPT_H="${2:-}"; { (($# >= 2)) && shift 2 } || shift ;;
    --skip) OPT_SKIP="${2:-0}"; { (($# >= 2)) && shift 2 } || shift ;;
    --pixels) OPT_PIXELS=1; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
done

if ((OPT_PIXELS)); then
  if (($# < 1)); then
    print -u2 "Usage: preview --pixels [--skip N] <path>"
    exit 2
  fi
  main-pixels "$@"
else
  main "$@"
fi
