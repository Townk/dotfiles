#!/usr/bin/env zsh
# system-service — unified service dispatcher.
#
# Routes lifecycle verbs to the appropriate worker:
#   • services declared in ~/.config/packages/services.toml → this OS's
#     manifest worker (system-service-launchd on macOS, system-service-systemd
#     on Linux)
#   • services known to `brew services list` (macOS only)    → system-service-brew
#
# `list` aggregates both sources into a single table with a Source column.
# `sync` only touches the manifest side; brew package reconciliation happens
# in `system-package brew sync` and isn't ours to coordinate.
#
# `restart-for <pkg>` is an internal hook called by `system-package-* sync`
# after a package version bump: it finds any service (manifest or brew)
# associated with <pkg> and restarts it iff it's currently running. Manually
# stopped services stay stopped.
#
# Usage:
#   system-service                 # alias for `list`
#   system-service list
#   system-service start   <name>
#   system-service stop    <name>
#   system-service restart <name>
#   system-service info    <name>
#   system-service sync
#   system-service restart-for <pkg>...   # internal — see above

set -eu -o pipefail

source "$HOME/.local/lib/system-package-common.zsh"

# One manifest-backed worker per OS (launchd ↔ systemd), plus brew as a
# darwin-only second source. SERVICE_OS is a test seam (specs set it to
# Linux/Darwin to exercise both routings on any host).
SERVICE_OS="${SERVICE_OS:-$(uname -s)}"
if [[ "$SERVICE_OS" == Darwin ]]; then
  MANIFEST_WORKER=launchd
  HAVE_BREW=1
else
  MANIFEST_WORKER=systemd
  HAVE_BREW=0
fi

SUBCOMMANDS=(list start stop restart info sync)

usage() {
  cat <<EOF
Unified service dispatcher: manage manifest-declared services (launchd on
macOS, systemd user units on Linux) and brew services on macOS through one
interface (list/start/stop/restart/info/sync).

Usage:
  system-service                       alias for \`list\`
  system-service list                  show all services (manifest + brew)
  system-service start   <name>        start a service
  system-service stop    <name>        stop a service
  system-service restart <name>        restart a service
  system-service info    <name>        show manifest + backend/brew detail
  system-service sync                  reconcile manifest services with services.toml
  system-service restart-for <pkg>...  internal: restart services tied to <pkg>
  system-service -h | --help | help    show this help

Run \`system-service <command> --help\` for per-command details.
EOF
}

usage_for() {
  case "$1" in
    list)
      cat <<EOF
Usage:
  system-service list

Aggregates manifest-declared services (declared in
~/.config/packages/services.toml; launchd on macOS, systemd user units on
Linux) and brew-managed services (\`brew services list\`, macOS only) into a
single Source/Service/Status/User/File table.

Status vocabulary: running | stopped | error | none.
EOF
      ;;
    start | stop | restart)
      cat <<EOF
Usage:
  system-service $1 <name>

Routes to the worker that owns <name>:
  • manifest (services.toml entry) → system-service-$MANIFEST_WORKER $1 <name>
  • brew     (brew services, macOS only) → system-service-brew     $1 <name>

For manifest services, \`start\` writes the unit (re-rendered from the TOML
entry), bootstraps/enables it, and ensures any working_dir / log_path /
error_log_path directories exist. \`stop\` tears the unit down. \`restart\` is
\`stop\` + \`start\`.
EOF
      ;;
    info)
      cat <<EOF
Usage:
  system-service info <name>

Prints the resolved manifest entry / unit path / normalized status, plus the
full backend detail (\`launchctl print\` on macOS, \`systemctl --user show\` on
Linux) or \`brew services info\` (brew, macOS only) output.
EOF
      ;;
    sync)
      cat <<EOF
Usage:
  system-service sync

Reconciles manifest-declared services with ~/.config/packages/services.toml:
  • declared but not installed → write unit + start
  • declared with drifted unit → write unit + restart
  • installed but not declared → tear down + remove unit

Does NOT touch brew services — brew package reconciliation is run by
\`system-package brew sync\`.
EOF
      ;;
    restart-for)
      cat <<EOF
Usage:
  system-service restart-for <pkg>...

Internal hook called by \`system-package-* sync\` after a version bump.
For each <pkg>:
  • manifest: restart services whose top-level key OR cmd[0] basename
    equals <pkg>, but only if currently running.
  • brew:     restart the brew service named <pkg>, but only if started (macOS only)
    (macOS only).

Manually-stopped services stay stopped — an upgrade never auto-resurrects
a daemon the user had taken down.
EOF
      ;;
    *)
      usage
      ;;
  esac
}

worker_check() {
  command -v "system-service-$1" >/dev/null ||
    die "worker not found: system-service-$1"
}

# is_manifest_service <name> — declared in services.toml (this OS's worker)?
is_manifest_service() {
  worker_check "$MANIFEST_WORKER"
  "system-service-$MANIFEST_WORKER" declared | grep -Fxq "$1"
}

# is_brew_service <name> — listed by brew services list?
is_brew_service() {
  worker_check brew
  system-service-brew names | grep -Fxq "$1"
}

# route <verb> <name> — dispatch a lifecycle verb to the right worker
route() {
  local verb="$1" name="$2"
  local in_manifest=0 in_brew=0
  is_manifest_service "$name" && in_manifest=1
  if ((HAVE_BREW)); then
    is_brew_service "$name" && in_brew=1
  fi

  if ((HAVE_BREW && in_manifest && in_brew)); then
    die "service '$name' is declared in BOTH services.toml AND brew services. Remove one."
  elif ((in_manifest)); then
    "system-service-$MANIFEST_WORKER" "$verb" "$name"
  elif ((HAVE_BREW && in_brew)); then
    system-service-brew "$verb" "$name"
  else
    die "unknown service: $name"
  fi
}

# do_list — merge manifest + brew rows into one Source/Service/Status/User/File table
do_list() {
  # Both probes BEFORE the pipe group: a missing worker must die before any
  # partial table output has been emitted.
  worker_check "$MANIFEST_WORKER"
  if ((HAVE_BREW)); then
    worker_check brew
  fi
  {
    "system-service-$MANIFEST_WORKER" list | awk -F'\t' -v w="$MANIFEST_WORKER" '{print w "\t" $0}'
    if ((HAVE_BREW)); then
      system-service-brew list | awk -F'\t' '{print "brew\t" $0}'
    fi
  } | pkg::table_print $'Source\tService\tStatus\tUser\tFile' 1
}

# do_sync — only the manifest worker reconciles. brew's bundle handles its
# side at `system-package brew sync` time.
do_sync() {
  worker_check "$MANIFEST_WORKER"
  "system-service-$MANIFEST_WORKER" sync
}

# brew_service_status <name> — normalised status for a brew-managed service.
# Mirrors the vocabulary used by the manifest workers: running/stopped/none.
brew_service_status() {
  local name="$1"
  brew services list --json 2>/dev/null |
    jq -r --arg n "$name" '
        (.[] | select(.name == $n) | .status) // "none"
        | if . == "started"   then "running"
          elif . == "scheduled" then "stopped"
          else . end' 2>/dev/null
}

# do_restart_for <pkg>...
# Triggered by `system-package-* sync` after a version bump. For each pkg:
#   • manifest: find services whose top-level key or cmd[0] basename == pkg,
#     restart any that are currently running (status=running).
#   • brew:     if a brew service named <pkg> exists and is started, restart
#     it (macOS only).
# Services that are stopped/none/error are intentionally left alone so a
# manually-stopped daemon isn't auto-resurrected by an upgrade.
do_restart_for() {
  (($# > 0)) || return 0
  worker_check "$MANIFEST_WORKER"
  ((HAVE_BREW)) && worker_check brew

  local pkg=""
  for pkg in "$@"; do
    [[ -z "$pkg" ]] && continue

    # Manifest side — a pkg can map to >1 service (rare, but possible if
    # the user declared multiple [section]s wrapping the same binary).
    # NB: `status` is a read-only special parameter in zsh (alias for $?),
    # so we use svc_state / brew_state locals instead.
    local svc="" svc_state=""
    while IFS= read -r svc; do
      [[ -z "$svc" ]] && continue
      svc_state=$("system-service-$MANIFEST_WORKER" status "$svc" 2>/dev/null || true)
      if [[ "$svc_state" == "running" ]]; then
        log_info "restarting $MANIFEST_WORKER service '$svc' (package '$pkg' upgraded)"
        "system-service-$MANIFEST_WORKER" restart "$svc" ||
          log_warn "failed to restart $MANIFEST_WORKER service '$svc'"
      fi
    done < <("system-service-$MANIFEST_WORKER" matching "$pkg" 2>/dev/null || true)

    if ((HAVE_BREW)); then
      # Brew side — service name == formula name by convention. If brew
      # doesn't know about pkg as a service, the names-list check
      # short-circuits.
      if system-service-brew names 2>/dev/null | grep -Fxq "$pkg"; then
        local brew_state
        brew_state=$(brew_service_status "$pkg")
        if [[ "$brew_state" == "running" ]]; then
          log_info "restarting brew service '$pkg' (formula upgraded)"
          system-service-brew restart "$pkg" ||
            log_warn "failed to restart brew service '$pkg'"
        fi
      fi
    fi
  done
}

main() {
  local cmd="${1:-list}"
  shift 2>/dev/null || true

  case "$cmd" in
    -h | --help | help)
      usage
      exit 0
      ;;
    list)
      args_contain_help "$@" && {
        usage_for list
        exit 0
      }
      do_list
      ;;
    sync)
      args_contain_help "$@" && {
        usage_for sync
        exit 0
      }
      do_sync
      ;;
    start | stop | restart | info)
      # Critical: catch --help BEFORE route(), or `route info --help` would
      # try (and fail noisily) to look up a service literally named `--help`.
      args_contain_help "$@" && {
        usage_for "$cmd"
        exit 0
      }
      [[ $# -eq 1 ]] || {
        usage_for "$cmd" >&2
        die "$cmd requires exactly one service name"
      }
      route "$cmd" "$1"
      ;;
    restart-for)
      args_contain_help "$@" && {
        usage_for restart-for
        exit 0
      }
      [[ $# -ge 1 ]] || {
        usage_for restart-for >&2
        die "restart-for requires at least one package name"
      }
      do_restart_for "$@"
      ;;
    *)
      usage
      die "unknown subcommand: $cmd"
      ;;
  esac
}

main "$@"
