#!/usr/bin/env zsh
#
# ai-commit-pi — AI-driven git commits via pi-coding-agent's commit skill.
#
# Asks pi to analyze the working tree, group changes into logical commits,
# and produce Conventional Commits-format messages. The script owns every
# git operation, so --dry-run and --no-commit reuse the same plan that
# default mode executes — there is no second code path that could drift.
#
# Agent contract: pi reads the diff, writes a JSON plan to a tempfile,
# then exits. It never runs `git add` or `git commit`. The script reads
# the plan and stages + commits one group at a time.
#
# Usable standalone or as a harness behind the `ai-commit` dispatcher, which
# discovers this script via the `ai-commit-*` naming and the --probe contract.

set -eu -o pipefail

# ────────────────────────────────────────────────────────────────────
# Defaults — overridable via env or flags
# ────────────────────────────────────────────────────────────────────
: "${AI_COMMIT_MODEL:=opencode-go/deepseek-v4-flash}"
: "${AI_COMMIT_THINKING:=medium}"

# ────────────────────────────────────────────────────────────────────
# Probe contract (used by the `ai-commit` dispatcher to detect available
# harnesses): print a short label and exit 0 iff the backing CLI is present,
# else exit 1 silently. Handled before anything heavier so it stays cheap.
# ────────────────────────────────────────────────────────────────────
if [[ "${1:-}" == --probe ]]; then
  command -v pi >/dev/null 2>&1 || exit 1
  print -r -- "Pi Coding Agent"
  exit 0
fi

# ────────────────────────────────────────────────────────────────────
# Shared commit-agent engine: pulls in the base (C_*, log_*, die), the prompt
# module (prompt::confirm), and the cagent:: plan/spinner/commit helpers.
# ────────────────────────────────────────────────────────────────────
source "$HOME/.local/lib/commit-agent-common.zsh"

usage() {
  cat <<EOF
Usage: ai-commit-pi [options] [-- extra-guidance...]

Use pi-coding-agent to group the working tree's changes into one or more
logical commits and create them using the project's commit skill.

Options:
  -u, --untracked     Also include untracked files in the commits.
  -d, --dry-run       Print the plan (groupings + messages) without
                      staging or committing anything.
  -n, --no-commit     For each planned commit: stage the files, open
                      \$EDITOR with the message, then prompt to commit.
                      Saying No aborts without creating the commit.
  -m, --model <id>    Override model (default: \$AI_COMMIT_MODEL or
                      opencode-go/deepseek-v4-flash). Supports pi's
                      provider/id and fuzzy patterns.
      --thinking <l>  Override thinking level: off|minimal|low|medium|
                      high|xhigh (default: \$AI_COMMIT_THINKING or medium).
  -v, --verbose       Show pi-coding-agent output as it plans.
  -h, --help          Show this help.

Extra positional args (after \`--\`) are passed to the agent as
additional commit guidance — file globs to scope to, scope hints,
JIRA references, etc.

Environment:
  AI_COMMIT_MODEL     Default model.
  AI_COMMIT_THINKING  Default thinking level.

Logs:
  pi-coding-agent's stdout+stderr (which pi's TUI clears from the
  terminal on exit) is appended to
  \${XDG_STATE_HOME:-\$HOME/.local/state}/ai-commit-pi/errors.log
EOF
}

# ────────────────────────────────────────────────────────────────────
# Parse args
# ────────────────────────────────────────────────────────────────────
include_untracked=0
dry_run=0
no_commit=0
verbose=0
model="$AI_COMMIT_MODEL"
thinking="$AI_COMMIT_THINKING"
extra_guidance=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -u|--untracked) include_untracked=1; shift ;;
    -d|--dry-run)   dry_run=1; shift ;;
    -n|--no-commit) no_commit=1; shift ;;
    -m|--model)     [[ $# -ge 2 ]] || die "--model needs a value"; model="$2"; shift 2 ;;
    --thinking)     [[ $# -ge 2 ]] || die "--thinking needs a value"; thinking="$2"; shift 2 ;;
    -v|--verbose)   verbose=1; shift ;;
    -h|--help)      usage; exit 0 ;;
    --)             shift; extra_guidance=("$@"); break ;;
    -*)             usage >&2; die "unknown flag: $1" ;;
    *)              extra_guidance=("$@"); break ;;
  esac
done

[[ "$dry_run" -eq 1 && "$no_commit" -eq 1 ]] \
  && die "--dry-run and --no-commit are mutually exclusive"

# ────────────────────────────────────────────────────────────────────
# Pre-flight
# ────────────────────────────────────────────────────────────────────
command -v pi  >/dev/null 2>&1 || die "pi-coding-agent (pi) not on PATH"
command -v git >/dev/null 2>&1 || die "git not on PATH"
command -v jq  >/dev/null 2>&1 || die "jq is required to parse the agent's plan"

git rev-parse --git-dir >/dev/null 2>&1 \
  || die "not inside a git repository"

# Refuse pre-existing staged changes — keeps dry-run / no-commit / default
# modes from getting tangled with whatever the user had half-staged. The
# user can `git reset` (to unstage) or `git commit` (to commit them) first.
if ! git diff --cached --quiet; then
  die "you already have staged changes; \`git reset\` to unstage (or commit them) first"
fi

have_modified=0
git diff --quiet || have_modified=1

have_untracked=0
[[ -n "$(git ls-files --others --exclude-standard)" ]] && have_untracked=1

if [[ "$have_modified" -eq 0 && "$have_untracked" -eq 0 ]]; then
  log_ok "nothing to commit, working tree clean"
  exit 0
fi
if [[ "$have_modified" -eq 0 && "$include_untracked" -eq 0 ]]; then
  log_warn "only untracked files present; pass -u/--untracked to include them"
  exit 0
fi

# ────────────────────────────────────────────────────────────────────
# Build prompt
# ────────────────────────────────────────────────────────────────────
tmpdir="$(mktemp -d -t ai-commit-pi.XXXXXX)"
pi_pid=""
cleanup() {
  [[ -n "$pi_pid" ]] && kill "$pi_pid" 2>/dev/null
  rm -rf "$tmpdir"
}
trap cleanup EXIT INT TERM

plan_file="$tmpdir/plan.json"

scope_clause="modified (tracked) files only"
[[ "$include_untracked" -eq 1 ]] && scope_clause="modified files AND untracked files"

extra_block=""
if [[ ${#extra_guidance[@]} -gt 0 ]]; then
  extra_block=$'\n\nAdditional guidance from the caller:\n'"${extra_guidance[*]}"
fi

prompt=$(cat <<EOF
You are PLANNING a series of git commits. Use the project's **commit**
skill for message-format conventions (Conventional Commits subject,
optional Markdown body, comment-character preflight, etc.), but DO NOT
execute any \`git add\` or \`git commit\` — the calling script does that.

Workflow:

1. Inspect the working tree with \`git status\` and \`git diff\`
   (per-file as needed). Scope: ${scope_clause}.
2. Group the changes into one or more logical commits. Prefer ONE
   commit when changes are coherent; only split when topics are
   clearly independent.
3. For each group, draft a polished message per the commit skill
   (subject + Markdown body sized to the change).
4. Use the **Write** tool to save the plan as JSON at the absolute path
   \`${plan_file}\`. Do not just describe the plan in your reply — the
   calling script reads it from disk. The file MUST exist when you
   finish. Shape MUST be EXACTLY:

\`\`\`json
{
  "commits": [
    {
      "files": ["relative/path/one", "relative/path/two"],
      "message": "feat(scope): subject\\n\\n## Changes Description\\n\\n..."
    }
  ]
}
\`\`\`

Rules:
- File paths must be repo-relative, exactly as \`git status\` prints them.
- Every in-scope changed file must appear in exactly one commit's
  \`files\` array. No duplicates, no omissions.
- \`message\` is the full commit message (subject + blank line + body
  when warranted); use JSON \`\\n\` for newlines.
- Do NOT stage. Do NOT commit. Do NOT push.
- When you are done, reply with the literal text \`PLAN_WRITTEN\` and
  nothing else.${extra_block}
EOF
)

# ────────────────────────────────────────────────────────────────────
# Run agent
# ────────────────────────────────────────────────────────────────────
# Always capture pi's stdout+stderr to a persistent log. pi runs a TUI
# in text mode and clears the screen on exit, so any error it printed
# would otherwise be gone before the user could read it — even with
# --verbose.
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/ai-commit-pi"
mkdir -p "$state_dir"
log_file="$state_dir/errors.log"

{
  print -- ""
  print -- "─── $(date '+%Y-%m-%d %H:%M:%S') ─────────────────────────"
  print -- "model=$model thinking=$thinking untracked=$include_untracked dry_run=$dry_run no_commit=$no_commit"
} >> "$log_file"

log_info "Planning commits with ${C_BWH}${model}${C_RES} (thinking: ${thinking})…"

pi_args=(
  --print
  --mode json
  --no-session
  --model "$model"
  --thinking "$thinking"
)

if [[ "$verbose" -eq 1 ]]; then
  pi "${pi_args[@]}" "$prompt" 2>&1 | tee -a "$log_file"
  rc=${pipestatus[1]}
else
  pi "${pi_args[@]}" "$prompt" >>"$log_file" 2>&1 &
  pi_pid=$!
  cagent::spinner "$pi_pid"
  wait "$pi_pid"
  rc=$?
  pi_pid=""
fi

[[ "$rc" -eq 0 ]] || die "pi-coding-agent failed (see $log_file)"

if [[ ! -s "$plan_file" ]]; then
  log_warn "the model returned a reply but did not call the Write tool to"
  log_warn "create $plan_file. Try a stricter model:"
  log_warn "  AI_COMMIT_MODEL=anthropic/claude-sonnet-4.6 ai-commit-pi $*"
  die "no plan written (see $log_file)"
fi

if ! jq -e '.commits | type == "array" and length > 0' "$plan_file" >/dev/null 2>&1; then
  die "agent produced an invalid plan (see $log_file and $plan_file)"
fi

total_files=$(jq '[.commits[].files[]] | length' "$plan_file")
[[ "$total_files" -gt 0 ]] || die "plan groups have no files"

commit_count=$(jq -r '.commits | length' "$plan_file")

# ────────────────────────────────────────────────────────────────────
# Plan summary
# ────────────────────────────────────────────────────────────────────
cagent::print_plan_summary "$plan_file" "$commit_count"

# ────────────────────────────────────────────────────────────────────
# Execute
# ────────────────────────────────────────────────────────────────────
if [[ "$dry_run" -eq 1 ]]; then
  cagent::print_dry_run "$plan_file"
  exit 0
fi

cagent::execute_plan "$plan_file" "$commit_count" "$tmpdir" "$no_commit"
