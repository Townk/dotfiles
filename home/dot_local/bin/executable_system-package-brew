#!/usr/bin/env zsh
# system-package-brew — sync Homebrew formulas, casks, and MAS apps
# against ~/.config/packages/Brewfile.bootstrap + Brewfile.

set -eu -o pipefail

source "$HOME/.local/lib/system-package-common.zsh"

BREWFILE_BOOT="$PKG_DIR/Brewfile.bootstrap"
BREWFILE_MAIN="$PKG_DIR/Brewfile"

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

# Dev-tool runtimes that should be owned by mise, not brew. Matches direct
# installs (installed_on_request:true) only — transient deps pulled in by
# other formulas are out of scope (PATH precedence keeps mise's copy live).
# Pattern intentionally includes versioned variants (`python@3.11`,
# `openjdk@21`) since those are the most common shapes brew ships.
BREW_MISE_PATTERN='^(go|python|node|ruby|perl|rust|kotlin|java|openjdk|lua|luajit|cmake|ninja|just|uv|bun|deno|zig)(@[0-9.]+)?$'

# Direct-installed formulas that are intentionally provisioned via brew.
# Add new entries here together with a documented reason in the Brewfile.
BREW_MISE_ALLOWED=(
  # NeoVim links against LuaJIT and mise-plugins/mise-luaJIT fails to
  # build on macOS 26 (bundled luarocks 3.13.0 rockspec is rejected by
  # the modern lua parser). Revisit when the plugin is fixed.
  "luajit"
)

brew_write_bundle_file() {
  local bundle_file="$1"
  command cat "$BREWFILE_BOOT" "$BREWFILE_MAIN" > "$bundle_file"
}

brew_bundle_list_entries() {
  local kind="$1" bundle_file="$2"
  HOMEBREW_NO_AUTO_UPDATE=1 brew bundle list "--$kind" --file="$bundle_file" 2>/dev/null \
    | awk 'NF && $0 !~ /^==>/ {print}'
}

brew_short_name() {
  local name="$1"
  if [[ "$name" == */*/* ]]; then
    print -r -- "${name:t}"
  else
    print -r -- "$name"
  fi
}

brew_tap_from_full_name() {
  local name="$1"
  [[ "$name" == */*/* ]] && print -r -- "${name:h}"
  return 0
}

brew_declared_taps() {
  local bundle_file="$1"
  {
    brew_bundle_list_entries tap "$bundle_file"
    local kind="" entry="" tap=""
    for kind in formula cask; do
      while IFS= read -r entry; do
        tap=$(brew_tap_from_full_name "$entry")
        [[ -n "$tap" ]] && print -r -- "$tap"
      done < <(brew_bundle_list_entries "$kind" "$bundle_file")
    done
  } | sort -u || true
}

brew_declared_short_names() {
  local kind="$1" bundle_file="$2"
  local entry=""
  while IFS= read -r entry; do
    [[ -n "$entry" ]] && brew_short_name "$entry"
  done < <(brew_bundle_list_entries "$kind" "$bundle_file") | sort -u || true
}

brew_declared_formula_names() {
  local bundle_file="$1"
  local -a formulae=()
  local entry=""
  while IFS= read -r entry; do
    [[ -n "$entry" ]] && formulae+=("$(brew_short_name "$entry")")
  done < <(brew_bundle_list_entries formula "$bundle_file")

  (( ${#formulae[@]} > 0 )) || return 0

  local json=""
  if json=$(HOMEBREW_NO_AUTO_UPDATE=1 brew info --json=v1 --formula "${formulae[@]}" 2>/dev/null); then
    printf '%s' "$json" | jq -r '.[].name' | sort -u
  else
    printf '%s\n' "${formulae[@]}" | sort -u
  fi
}

brew_trust_file() {
  if [[ -n "${HOMEBREW_USER_CONFIG_HOME:-}" ]]; then
    print -r -- "$HOMEBREW_USER_CONFIG_HOME/trust.json"
  elif [[ -n "${XDG_CONFIG_HOME:-}" ]]; then
    print -r -- "$XDG_CONFIG_HOME/homebrew/trust.json"
  else
    print -r -- "$HOME/.homebrew/trust.json"
  fi
}

brew_trusted_taps() {
  local trust_file
  trust_file=$(brew_trust_file)
  [[ -f "$trust_file" ]] || return 0
  jq -r '.trustedtaps[]? | ascii_downcase' "$trust_file" 2>/dev/null | sort -u || true
}

brew_check_trusted_taps() {
  local bundle_file="$1"
  local -A trusted_set
  local tap="" trust_file=""
  trust_file=$(brew_trust_file)

  while IFS= read -r tap; do
    [[ -n "$tap" ]] && trusted_set[${tap:l}]=1
  done < <(brew_trusted_taps)

  local -a missing=()
  while IFS= read -r tap; do
    [[ -n "$tap" ]] || continue
    [[ "$tap" == homebrew/* ]] && continue
    [[ -n "${trusted_set[${tap:l}]:-}" ]] || missing+=("$tap")
  done < <(brew_declared_taps "$bundle_file")

  (( ${#missing[@]} == 0 )) && return 0

  log_error "Homebrew taps are declared but not trusted in $trust_file:"
  for tap in "${missing[@]}"; do
    log_error "  $tap"
  done
  die "add missing taps to ~/.config/homebrew/trust.json before syncing"
}

brew_installed_casks() {
  brew list --cask 2>/dev/null | awk 'NF {print $1}' | sort -u
}

brew_installed_taps() {
  brew tap 2>/dev/null | sort -u
}

brew_formula_has_installed_dependents() {
  local formula="$1"
  [[ -n "$(brew uses --installed "$formula" 2>/dev/null)" ]]
}

brew_cleanup_packages() {
  local bundle_file="$1"
  log_info "Cleaning Homebrew packages missing from Brewfile..."

  local tmpdir
  tmpdir=$(mktemp -d)
  {
    local declared_formulae="$tmpdir/declared-formulae"
    local installed_formulae="$tmpdir/installed-formulae"
    local declared_casks="$tmpdir/declared-casks"
    local installed_casks="$tmpdir/installed-casks"
    local declared_taps="$tmpdir/declared-taps"
    local installed_taps="$tmpdir/installed-taps"

    brew_declared_formula_names "$bundle_file" > "$declared_formulae"
    brew_direct_formulas > "$installed_formulae"
    brew_declared_short_names cask "$bundle_file" > "$declared_casks"
    brew_installed_casks > "$installed_casks"
    brew_declared_taps "$bundle_file" > "$declared_taps"
    brew_installed_taps > "$installed_taps"

    local cask="" formula="" tap=""
    pkg::diff_only_in "$installed_casks" "$declared_casks" | while IFS= read -r cask; do
      [[ -n "$cask" ]] || continue
      brew uninstall --cask --force "$cask" \
        || log_warn "skipped extra cask that could not be uninstalled: $cask"
    done

    pkg::diff_only_in "$installed_formulae" "$declared_formulae" | while IFS= read -r formula; do
      [[ -z "$formula" ]] && continue
      if brew_formula_has_installed_dependents "$formula"; then
        log_warn "skipped extra formula still required by another package: $formula"
        continue
      fi
      brew uninstall --formula --force "$formula" \
        || log_warn "skipped extra formula that could not be uninstalled: $formula"
    done
    brew autoremove || log_warn "brew autoremove failed"

    pkg::diff_only_in "$installed_taps" "$declared_taps" | while IFS= read -r tap; do
      [[ -z "$tap" || "$tap" == "homebrew/core" ]] && continue
      brew untap "$tap" || log_warn "skipped tap still in use: $tap"
    done
  } always {
    rm -rf "$tmpdir"
  }
}

# brew_direct_formulas
# Print one name per line for every formula installed with
# installed_on_request:true (i.e. user/Brewfile-driven, not a transient dep).
# Sources from INSTALL_RECEIPT.json directly because `brew info --json=v2
# --installed` is ~100x slower for the same data.
brew_direct_formulas() {
  local cellar=""
  cellar=$(brew --cellar 2>/dev/null) || cellar=""
  [[ -z "$cellar" ]] && return 0
  local receipts=("$cellar"/*/*/INSTALL_RECEIPT.json(N))
  (( ${#receipts[@]} > 0 )) || return 0
  jq -r 'select(.installed_on_request)
         | input_filename | split("/")[-3]' \
    "${receipts[@]}" 2>/dev/null | sort -u || true
}

# brew_check_dev_leakage
# Emit a loud warning for every direct-installed formula that matches
# BREW_MISE_PATTERN and isn't in BREW_MISE_ALLOWED. Soft warning by design
# (rc 0) — the goal is to surface drift, not break sync runs that the user
# can't immediately fix.
brew_check_dev_leakage() {
  local -a leaked=()
  local f=""
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    [[ "$f" =~ $BREW_MISE_PATTERN ]] || continue
    local allowed=0 a=""
    for a in "${BREW_MISE_ALLOWED[@]}"; do
      [[ "$a" == "$f" ]] && { allowed=1; break }
    done
    (( allowed )) || leaked+=("$f")
  done < <(brew_direct_formulas)

  (( ${#leaked[@]} == 0 )) && return 0

  log_warn "${C_BWH}brew is provisioning dev-tool runtimes that mise should own:${C_RES}"
  for f in "${leaked[@]}"; do
    log_warn "  • ${f}"
  done
  log_warn "Move these to dot_config/mise/config.toml, or add to BREW_MISE_ALLOWED with a reason."
}

# brew_list_rows <outdated:true|false>
# Output one "type\tname\tversion[annotation]" TSV row per installed package.
# Type is one of: formula (user-installed), dep (transient dependency),
# cask, mas. Rows are sorted by (type, name) with type ordered
# formula → dep → cask → mas.
brew_list_rows() {
  local outdated="${1:-false}"
  local show_all="${2:-false}"
  local -A outdated_map
  local -A pkg_map
  local -A type_map
  local -A direct_set

  # Set of formulas where installed_on_request:true — i.e. the user (or a
  # Brewfile) explicitly installed them. Anything not in this set is a
  # transient dependency. Reading INSTALL_RECEIPT.json directly is ~100x
  # faster than `brew info --json=v2 --installed` for the same data.
  local cellar=""
  cellar=$(brew --cellar 2>/dev/null) || cellar=""
  if [[ -n "$cellar" ]]; then
    local receipts=("$cellar"/*/*/INSTALL_RECEIPT.json(N))
    if (( ${#receipts[@]} > 0 )); then
      local n=""
      while IFS= read -r n; do
        [[ -n "$n" ]] && direct_set[$n]=1
      done < <(jq -r 'select(.installed_on_request)
                      | input_filename | split("/")[-3]' \
                "${receipts[@]}" 2>/dev/null | sort -u || true)
    fi
  fi

  # Build outdated map (only if -u)
  if [[ "$outdated" == true ]]; then
    local formula_json="" cask_json=""
    formula_json=$(brew outdated --json --formula 2>/dev/null || printf '[]')
    cask_json=$(brew outdated --json --cask 2>/dev/null || printf '[]')

    # Parse formulas
    local name="" ver=""
    while IFS=$'\t' read -r name ver; do
      [[ -n "$name" ]] && outdated_map[$name]="$ver"
    done < <(printf '%s' "$formula_json" \
             | jq -r '.[] | "\(.name)\t\(.current_version)"' 2>/dev/null || true)

    # Parse casks
    while IFS=$'\t' read -r name ver; do
      [[ -n "$name" ]] && outdated_map[$name]="$ver"
    done < <(printf '%s' "$cask_json" \
             | jq -r '.[] | "\(.name)\t\(.current_version)"' 2>/dev/null || true)

    # MAS outdated: lines like "id name (oldver -> newver)"
    if command -v mas >/dev/null 2>&1; then
      local line="" mas_name="" mas_newver=""
      while IFS= read -r line; do
        mas_name=$(printf '%s' "$line" \
                   | sed 's/^[[:space:]]*[0-9][0-9 ]*//' \
                   | sed 's/ ([^)]*->[ ]*[^)]*) *$//')
        mas_newver=$(printf '%s' "$line" \
                     | grep -oE '\(.*->[ ]*([^)]+)\)$' \
                     | grep -oE '[^> ]+\)$' \
                     | tr -d ')' || true)
        [[ -n "$mas_name" && -n "$mas_newver" ]] && outdated_map[$mas_name]="$mas_newver"
      done < <(mas outdated 2>/dev/null || true)
    fi
  fi

  # Collect installed packages with their type
  # Formulas — split into "formula" (direct) vs "dep" (transient) using
  # the direct_set computed above. Skip transient deps unless show_all.
  local name="" ver=""
  while IFS=' ' read -r name ver; do
    [[ -n "$name" && -n "$ver" ]] || continue
    if [[ -n "${direct_set[$name]:-}" ]]; then
      pkg_map[$name]="$ver"
      type_map[$name]="formula"
    elif [[ "$show_all" == true ]]; then
      pkg_map[$name]="$ver"
      type_map[$name]="dep"
    fi
  done < <(brew list --versions --formula 2>/dev/null || true)

  # Casks
  while IFS=' ' read -r name ver; do
    [[ -n "$name" && -n "$ver" ]] && {
      pkg_map[$name]="$ver"
      type_map[$name]="cask"
    }
  done < <(brew list --versions --cask 2>/dev/null || true)

  # MAS apps: "id name (version)"
  if command -v mas >/dev/null 2>&1; then
    local line="" mas_name="" mas_ver=""
    while IFS= read -r line; do
      mas_name=$(printf '%s' "$line" \
                 | sed 's/^[[:space:]]*[0-9][0-9 ]*//' \
                 | sed 's/ ([^)]*) *$//')
      mas_ver=$(printf '%s' "$line" \
                | grep -oE '\([^)]+\)$' \
                | tr -d '()')
      [[ -n "$mas_name" && -n "$mas_ver" ]] && {
        pkg_map[$mas_name]="$mas_ver"
        type_map[$mas_name]="mas"
      }
    done < <(mas list 2>/dev/null || true)
  fi

  # Emit rows sorted by (type rank, name). Type rank: formula=1, dep=2, cask=3,
  # mas=4 — so formulas appear first, then transient deps, casks, App Store apps.
  local k="" v="" t="" rank=0
  {
    for k in "${(@k)pkg_map}"; do
      v="${pkg_map[$k]}"
      t="${type_map[$k]}"
      if [[ "$outdated" == true && -n "${outdated_map[$k]:-}" ]]; then
        v="${v} ${C_YEL}(update available: ${outdated_map[$k]})${C_RES}"
      fi
      case "$t" in
        formula) rank=1 ;;
        dep)     rank=2 ;;
        cask)    rank=3 ;;
        mas)     rank=4 ;;
        *)       rank=9 ;;
      esac
      printf '%d\t%s\t%s\t%s\n' "$rank" "$t" "$k" "$v"
    done
  } | sort -t$'\t' -k1,1n -k3,3 | cut -f2-
}

do_list() {
  local outdated=false show_all=false
  while (( $# > 0 )); do
    case "$1" in
      -u|--update) outdated=true; shift ;;
      -a|--all)    show_all=true; shift ;;
      *) die "unknown flag for list: $1" ;;
    esac
  done
  brew_list_rows "$outdated" "$show_all"
}

# brew_snapshot_versions — TSV "name\tversion" rows for installed formulas.
# Casks and MAS apps are intentionally excluded: only formulas can ship a
# `brew services` plist, so they're the only ecosystem entries that can map
# to a service we'd want to restart.
brew_snapshot_versions() {
  brew list --versions --formula 2>/dev/null | awk '{print $1 "\t" $2}'
}

do_sync() {
  log_info "Syncing Homebrew packages..."

  local before_snap after_snap bundle_file
  before_snap=$(mktemp); after_snap=$(mktemp); bundle_file=$(mktemp)
  trap "rm -f '$before_snap' '$after_snap' '$bundle_file'" EXIT

  brew_snapshot_versions > "$before_snap"

  brew_write_bundle_file "$bundle_file"
  brew_check_trusted_taps "$bundle_file"

  HOMEBREW_NO_AUTO_UPDATE=1 brew bundle install -q --upgrade --file="$bundle_file" \
    || die "brew bundle install failed"
  brew_cleanup_packages "$bundle_file"

  # Tripwire: warn if any direct-installed formula matches a tool mise should
  # own. Runs after cleanup so it observes the post-sync truth.
  brew_check_dev_leakage

  # Restart any brew/launchd service whose backing formula changed version.
  # `brew bundle install --upgrade` does NOT restart formula-provided
  # services on its own, so a freshly-upgraded daemon keeps running the
  # old binary until we kick it.
  brew_snapshot_versions > "$after_snap"
  pkg::restart_changed "$before_snap" "$after_snap"
  return 0
}

usage() {
  cat <<EOF
Syncs Homebrew formulas, casks, and MAS apps against:
  ~/.config/packages/Brewfile.bootstrap
  ~/.config/packages/Brewfile

Usage:
  system-package-brew list [-u|--update] [-a|--all]
  system-package-brew sync
  system-package-brew -h | --help | help

list flags:
  -u, --update   annotate packages with available updates
  -a, --all      include transient (non-direct) dependencies

After sync, any brew service whose formula version changed and is currently
running is restarted.
EOF
}

usage_list() {
  cat <<EOF
Usage:
  system-package-brew list [-u|--update] [-a|--all]

Emits TSV "<type>\t<name>\t<version>" rows for every installed brew package.
Type is one of: formula (user-installed), dep (transient dependency), cask, mas.

Flags:
  -u, --update   annotate each row with the latest available version
  -a, --all      include transient (non-direct) dependencies in the output
EOF
}

usage_sync() {
  cat <<EOF
Usage:
  system-package-brew sync

Runs \`brew bundle install --upgrade\` against the concatenation of
~/.config/packages/Brewfile.bootstrap and ~/.config/packages/Brewfile, cleans
up Homebrew packages that are no longer declared, then warns about any
direct-installed formula that should be owned by mise.

After install, any brew service whose formula version changed AND is
currently running is restarted (\`brew bundle install --upgrade\` does NOT
restart formula-provided services on its own).
EOF
}

main() {
  if [[ $# -eq 0 ]] || is_help "${1:-}"; then
    usage; exit 0
  fi
  local cmd="$1"; shift
  case "$cmd" in
    list)
      args_contain_help "$@" && { usage_list; exit 0; }
      do_list "$@"
      ;;
    sync)
      args_contain_help "$@" && { usage_sync; exit 0; }
      do_sync
      ;;
    *) usage >&2; die "unknown subcommand: $cmd" ;;
  esac
}

main "$@"
