#!/bin/sh
# pbpaste — universal clipboard paste. Read side of the pbcopy/pbpaste pair;
# see pbcopy for the full picture.
#
# Local (no SSH): delegates straight to the real platform clipboard tool
# (macOS's own /usr/bin/pbpaste, or wl-paste/xclip on Linux).
#
# Over SSH: reads the Mac's clipboard back through a reverse SSH tunnel
# instead of OSC 52 (which Zellij refuses to answer — a terminal-based read
# would just hang). system-onboard's RemoteForward (in the loose
# ~/.ssh/config.d/<alias>.conf; default on) tunnels the Mac's clipboard-bridge
# (launchd `clipboard-bridge` -> socat on 127.0.0.1:2489) to loopback :2490 on
# this host. We speak its framing protocol — a one-byte `G` (get) op — and strip
# the 5-byte <status><length> header off the reply. TCP, not a unix socket:
# macOS OpenSSH silently ignores StreamLocalBindUnlink for remote (-R) socket
# forwards, so a dropped session would strand a stale socket. When the tunnel is
# down there is no local clipboard to fall back to, so this fails loudly instead
# of silently returning nothing.
#
# `pbpaste --manifest` (files-yazi design §5): instead of the clipboard text,
# print the CURRENT clipboard entry's file manifest via bridge op `L`
# (list-files, T2) -- a pure store query, no pasteboard access. Four lines to
# stdout: `kind\t<type_kind>`, `host\t<source_host>`, `ts\t<last_ts>`, then one
# `path\t<path>` line per file. Non-files clip / bridge error / bridge down:
# exit 1, nothing on stdout, reason on stderr. Same port convention as
# pbcopy's U/P frames and this file's own G frame: 2489 locally (this
# machine's own bridge), CLIPBOARD_BRIDGE_PORT (default 2490) over SSH (the
# reverse-tunneled peer bridge). Callers: the Alt+p widget (T6), the yazi
# smart-paste plugin (T8); `pbpaste --files` (T5) reuses the same fetch/parse
# functions below, only the final rendering differs.
#
# `pbpaste --files [--force] [--quiet|--progress|--porcelain] [dir]` (T5,
# design §5/§8): materializes the CURRENT file clip into `dir` (default cwd).
# This task implements ONLY manifests whose host is THIS host -- a manifest
# from a different host exits 1 pointing at the future cross-machine
# milestone (T13). Local engine, tiered (§8):
#   1. darwin: `cp -Rc` (APFS clonefile). Per `man cp`, `-c` transparently
#      falls back to a plain byte copy when cloning isn't possible
#      (cross-volume, non-APFS) and STILL returns success -- tier 2 is only
#      reached if the `cp -c` invocation itself errors (non-darwin, a real
#      cp failure), not merely "cross-volume".
#   2. `/opt/homebrew/bin/rsync -a --info=progress2`, if that exact binary is
#      executable (stock macOS openrsync lacks --info=progress2).
#   3. `cp -a`, with an honest one-line stderr note that there is no live
#      meter for this transfer.
# Everything materializes into `<dir>/.pbpaste-staging.$$/` first; each item
# is `mv`d into its final name individually, so a kill at any point --
# including inside the OS copy syscalls -- never leaves a partial entry in
# the target, only in the (disposable) staging dir. Catchable signals
# (INT/TERM) clean the staging dir on the spot via a trap; an untrappable
# SIGKILL can leave one behind, so every invocation sweeps any stale
# `.pbpaste-staging.*` left by a previous killed run before starting its own.
# Existing target names are refused (all conflicts listed on one stderr
# message) unless `--force`, checked BEFORE any transfer. Output is the
# progress skeleton this task establishes (§8): TTY (or `--progress`) prints
# a `✓ name (size)` line per item plus a final summary; non-TTY (or
# `--quiet`) is silent; `--porcelain` prints
# `progress\t<path>\t<bytes_done>\t<bytes_total>` per item and a terminal
# `done\t<files>\t<bytes>\t<seconds>` -- a CONTRACT later tasks and tests
# parse, so it may only grow columns, never reshape existing ones. For these
# local tiers every item is a single instant operation, so bytes_done always
# equals bytes_total (no partial in-flight progress to report yet). Like the
# accepted literal-newline limit on paths (see manifest_parse), a path
# containing a literal TAB would break the porcelain field count -- accepted,
# not engineered around.
#
# Standalone POSIX sh, no library sourcing — see pbcopy.
#
# Usage: text=$(pbpaste)
#        pbpaste --manifest
#        pbpaste --files [--force] [--quiet|--progress|--porcelain] [dir]

set -eu

case "${1:-}" in
  -h | --help)
    cat <<'EOF'
Universal clipboard paste — the read side of the pbcopy/pbpaste pair. Prints the
Mac's clipboard to stdout, whether you're at the Mac or SSH'd in.

Local: delegates to the platform tool (/usr/bin/pbpaste, wl-paste, or xclip).
Over SSH: reads the Mac's clipboard back over the clipboard-bridge reverse tunnel
(loopback TCP :2490, set up by system-onboard) instead of OSC 52, which would
hang. Fails loudly when the tunnel is down. See pbcopy for the write side.

--manifest: print the current clipboard entry's file manifest (kind/host/ts/
path lines) instead of its text. Exits 1 (nothing on stdout) if the current
clip isn't a files clip, or the bridge is down.

--files [--force] [--quiet|--progress|--porcelain] [dir]: materialize the
current file clip into dir (default: cwd). Refuses existing names unless
--force. Only manifests originating on this host are supported so far
(remote hosts land in a later milestone). TTY prints a line per item plus a
summary; --porcelain prints a stable machine-readable progress/done stream;
--quiet is silent; non-TTY is silent by default.

Usage: text=$(pbpaste)
       pbpaste --manifest
       pbpaste --files [--force] [--quiet|--progress|--porcelain] [dir]
EOF
    exit 0
    ;;
esac

# --- --manifest (files-yazi design §5) --------------------------------------
#
# manifest_port: 2489 (this machine's own bridge) locally, else
# CLIPBOARD_BRIDGE_PORT (default 2490, the reverse-tunneled peer bridge --
# same var the plain-paste G frame below honors).
manifest_port() {
  if [ -z "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]; then
    echo 2489
  else
    echo "${CLIPBOARD_BRIDGE_PORT:-2490}"
  fi
}

# manifest_fetch <replyfile> -- sends an empty `L` frame to the manifest port
# and captures the raw <status><BE32 len><payload> reply into <replyfile>.
# Best-effort: a down bridge / missing nc just leaves the file short or
# empty, which manifest_parse's status check below reports as a normal error
# (mirrors pbcopy's send_frame `|| true` rationale: under `set -e` a
# connection-refused failure here must not kill the script before the reply
# check runs).
manifest_fetch() {
  _replyfile=$1
  _port=$(manifest_port)
  printf 'L\000\000\000\000' | nc -w 2 127.0.0.1 "$_port" > "$_replyfile" 2>/dev/null || true
}

# manifest_parse <replyfile> -- on an `O` reply, sets $MANIFEST_KIND /
# $MANIFEST_HOST / $MANIFEST_TS and writes the NUL-joined path list to
# $MANIFEST_PATHFILE; returns 0. On any failure (bridge down, `E` status,
# empty reply) prints a reason to stderr and returns 1 -- caller must not
# print anything to stdout in that case.
#
# Byte-level, not string-level: the payload can hold embedded NULs (the path
# separators), which a POSIX shell variable can't carry intact through
# command substitution (truncates at the first NUL) -- so the payload is
# sliced and split entirely at the file level (dd/tr), never read into a
# shell scalar as a whole. Only the three US-delimited header fields
# (kind/host/ts), which never contain NULs, are lifted into variables.
manifest_parse() {
  _replyfile=$1
  _status=$(dd bs=1 count=1 2>/dev/null < "$_replyfile")
  if [ -z "$_status" ]; then
    echo "pbpaste: clipboard bridge not reachable (reverse SSH tunnel down?)" >&2
    return 1
  fi
  _lenbytes=$(dd bs=1 skip=1 count=4 2>/dev/null < "$_replyfile" | od -An -tu1)
  set -- $_lenbytes
  _len=$(( ${1:-0} * 16777216 + ${2:-0} * 65536 + ${3:-0} * 256 + ${4:-0} ))

  if [ "$_status" != "O" ]; then
    _msg=$(dd bs=1 skip=5 count="$_len" 2>/dev/null < "$_replyfile")
    echo "pbpaste: ${_msg:-bridge reported an error}" >&2
    return 1
  fi

  _payloadfile=$(mktemp "${TMPDIR:-/tmp}/pbpaste-manifest-payload.XXXXXX") || {
    echo "pbpaste: mktemp failed" >&2
    return 1
  }
  dd bs=1 skip=5 count="$_len" 2>/dev/null < "$_replyfile" > "$_payloadfile"

  # Only the 3 header-field separators are \037 (US) -- real filesystem paths
  # don't contain that byte -- so this tr is a safe field split even though
  # the tail (the path blob) keeps flowing through unchanged.
  _fieldsfile=$(mktemp "${TMPDIR:-/tmp}/pbpaste-manifest-fields.XXXXXX") || {
    rm -f "$_payloadfile"
    echo "pbpaste: mktemp failed" >&2
    return 1
  }
  tr '\037' '\n' < "$_payloadfile" > "$_fieldsfile"
  rm -f "$_payloadfile"

  MANIFEST_KIND=$(sed -n '1p' "$_fieldsfile")
  MANIFEST_HOST=$(sed -n '2p' "$_fieldsfile")
  MANIFEST_TS=$(sed -n '3p' "$_fieldsfile")

  MANIFEST_PATHFILE=$(mktemp "${TMPDIR:-/tmp}/pbpaste-manifest-paths.XXXXXX") || {
    rm -f "$_fieldsfile"
    echo "pbpaste: mktemp failed" >&2
    return 1
  }
  tail -n +4 "$_fieldsfile" > "$MANIFEST_PATHFILE"
  rm -f "$_fieldsfile"
  return 0
}

# pbpaste_manifest -- the --manifest entry point: fetch + parse + print the
# four-line kind/host/ts/path* format, or exit 1 with a stderr reason and
# nothing on stdout.
pbpaste_manifest() {
  _replyfile=$(mktemp "${TMPDIR:-/tmp}/pbpaste-manifest-reply.XXXXXX") || {
    echo "pbpaste: mktemp failed" >&2
    exit 1
  }
  manifest_fetch "$_replyfile"
  if ! manifest_parse "$_replyfile"; then
    rm -f "$_replyfile"
    exit 1
  fi
  rm -f "$_replyfile"

  printf 'kind\t%s\n' "$MANIFEST_KIND"
  printf 'host\t%s\n' "$MANIFEST_HOST"
  printf 'ts\t%s\n' "$MANIFEST_TS"
  # NUL -> newline conversion happens ONLY here, at the final print (paths may
  # contain spaces; a path containing a literal newline is a known, accepted
  # limit -- see header comment).
  tr '\000' '\n' < "$MANIFEST_PATHFILE" | while IFS= read -r _p || [ -n "$_p" ]; do
    printf 'path\t%s\n' "$_p"
  done
  rm -f "$MANIFEST_PATHFILE"
  exit 0
}

# --- --files (files-yazi design §5/§8, T5) -----------------------------------
#
# pbpaste_files_size <path> -- bytes for the progress/porcelain fields. Exact
# byte count for a regular file (`wc -c`); disk-usage estimate (`du -sk`,
# rounded to 1K blocks) for a directory, since there is no single "size of a
# tree" syscall. Both the "done" and "total" fields for an item are computed
# by calling this ONCE and reusing the value, so bytes_done == bytes_total
# always holds for these instant local tiers, even though the directory
# figure itself is only an estimate.
pbpaste_files_size() {
  _p=$1
  if [ -d "$_p" ]; then
    _sz=$(du -sk -- "$_p" 2>/dev/null | awk '{print $1*1024}')
  else
    _sz=$(wc -c < "$_p" 2>/dev/null | tr -d ' ')
  fi
  # An unreadable subtree (permissions, a mid-copy race) can make `du`/`wc`
  # come back empty; that must not blow up the caller's arithmetic.
  printf '%s' "${_sz:-0}"
}

# pbpaste_files_human <bytes> -- compact human size for the TTY per-item line
# (`✓ name (12.3M)`). Not used by --porcelain, which reports raw bytes.
pbpaste_files_human() {
  _b=$1
  if [ "$_b" -ge 1073741824 ]; then
    awk -v b="$_b" 'BEGIN { printf "%.1fG", b / 1073741824 }'
  elif [ "$_b" -ge 1048576 ]; then
    awk -v b="$_b" 'BEGIN { printf "%.1fM", b / 1048576 }'
  elif [ "$_b" -ge 1024 ]; then
    awk -v b="$_b" 'BEGIN { printf "%.1fK", b / 1024 }'
  else
    printf '%sB' "$_b"
  fi
}

# pbpaste_files_copy <src> <stagedst> -- the tiered engine (see the header
# comment for the full rationale). Reads the caller's PF_SHOW (whether the
# rsync tier may render its live meter -- on stderr, so a --porcelain stdout
# stream stays parseable) and reads/writes PF_CPA_NOTED (so the tier-3 "no
# live meter" note prints at most once per invocation, not once per item).
pbpaste_files_copy() {
  _src=$1 _dst=$2
  if [ "$(uname -s)" = "Darwin" ] && cp -Rc -- "$_src" "$_dst" 2>/dev/null; then
    return 0
  fi
  # A failed tier can leave a PARTIAL $_dst behind (cp/rsync dying mid-tree
  # on a quota or permission error). Clear it before trying the next tier:
  # rsync would silently merge into the partial result, and `cp -a src dst`
  # with dst already existing as a directory nests src one level deep
  # (dst/src/...) instead of replacing it. Staging content is disposable by
  # design, so an rm between tiers is always safe.
  rm -rf -- "$_dst" 2>/dev/null || true
  if [ -x /opt/homebrew/bin/rsync ]; then
    # Trailing-slash "contents into a pre-made dst" for a directory is
    # byte-equivalent to `cp -R src dst`; a plain file needs neither.
    if [ -d "$_src" ]; then
      _from="$_src/"
      mkdir -p "$_dst" || return 1
    else
      _from=$_src
    fi
    if [ "$PF_SHOW" -eq 1 ]; then
      # The §8 tier-2 promise is brew rsync's live overall meter -- let it
      # through on stderr, keeping stdout reserved for the per-item lines.
      /opt/homebrew/bin/rsync -a --info=progress2 -- "$_from" "$_dst" 1>&2 && return 0
    else
      /opt/homebrew/bin/rsync -a --info=progress2 -- "$_from" "$_dst" >/dev/null 2>&1 && return 0
    fi
    rm -rf -- "$_dst" 2>/dev/null || true
  fi
  if [ "$PF_CPA_NOTED" -eq 0 ] && [ "$PF_SHOW" -eq 1 ]; then
    echo "pbpaste: no live progress meter for this transfer (cp -a fallback)" >&2
    PF_CPA_NOTED=1
  fi
  cp -a -- "$_src" "$_dst"
}

# pbpaste_files [--force] [--quiet|--progress|--porcelain] [dir] -- the
# --files entry point.
pbpaste_files() {
  PF_FORCE=0
  PF_MODE=auto
  PF_DIR=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) PF_FORCE=1 ;;
      --quiet) PF_MODE=quiet ;;
      --progress) PF_MODE=progress ;;
      --porcelain) PF_MODE=porcelain ;;
      --)
        shift
        for _a in "$@"; do
          if [ -z "$PF_DIR" ]; then
            PF_DIR=$_a
          else
            echo "pbpaste: too many arguments" >&2
            exit 1
          fi
        done
        break
        ;;
      -*)
        echo "pbpaste: unknown option: $1" >&2
        exit 1
        ;;
      *)
        if [ -z "$PF_DIR" ]; then
          PF_DIR=$1
        else
          echo "pbpaste: too many arguments" >&2
          exit 1
        fi
        ;;
    esac
    shift
  done
  [ -n "$PF_DIR" ] || PF_DIR=.

  [ -d "$PF_DIR" ] || { echo "pbpaste: no such directory: $PF_DIR" >&2; exit 1; }

  PF_HOST=$(scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null || true)

  PF_REPLYFILE=$(mktemp "${TMPDIR:-/tmp}/pbpaste-files-reply.XXXXXX") || {
    echo "pbpaste: mktemp failed" >&2
    exit 1
  }
  manifest_fetch "$PF_REPLYFILE"
  PF_ERRFILE=$(mktemp "${TMPDIR:-/tmp}/pbpaste-files-err.XXXXXX") || {
    rm -f "$PF_REPLYFILE"
    echo "pbpaste: mktemp failed" >&2
    exit 1
  }
  if ! manifest_parse "$PF_REPLYFILE" 2>"$PF_ERRFILE"; then
    rm -f "$PF_REPLYFILE"
    if grep -q 'not-files' "$PF_ERRFILE" 2>/dev/null; then
      echo "pbpaste: current clipboard entry is not a files clip -- use plain pbpaste to read it as text" >&2
    else
      cat "$PF_ERRFILE" >&2
    fi
    rm -f "$PF_ERRFILE"
    exit 1
  fi
  rm -f "$PF_REPLYFILE" "$PF_ERRFILE"

  if [ -n "$MANIFEST_HOST" ] && [ "$MANIFEST_HOST" != "$PF_HOST" ]; then
    rm -f "$MANIFEST_PATHFILE"
    echo "pbpaste: remote file clips land in a later milestone" >&2
    exit 1
  fi

  # NUL -> newline, same rule as pbpaste_manifest's own final print: real
  # paths never carry NULs, so this is a lossless, safe split; a path with a
  # literal newline is a known, accepted limit (see manifest_parse's header).
  PF_PATHLIST=$(mktemp "${TMPDIR:-/tmp}/pbpaste-files-list.XXXXXX") || {
    echo "pbpaste: mktemp failed" >&2
    exit 1
  }
  tr '\000' '\n' < "$MANIFEST_PATHFILE" > "$PF_PATHLIST"
  rm -f "$MANIFEST_PATHFILE"

  # Sweep any staging dir orphaned by a previous SIGKILLed run (untrappable,
  # so its own EXIT trap never fired) before this run creates its own. PID-
  # gated, not a blind wildcard rm: a SECOND, genuinely concurrent `pbpaste
  # --files` targeting the same dir has its own live `.pbpaste-staging.<pid>`
  # -- only remove one whose pid is no longer running.
  for PF_STALE in "$PF_DIR"/.pbpaste-staging.*; do
    [ -e "$PF_STALE" ] || continue
    PF_STALE_PID=${PF_STALE##*.}
    case "$PF_STALE_PID" in
      '' | *[!0-9]*) rm -rf -- "$PF_STALE" ;;
      *) kill -0 "$PF_STALE_PID" 2>/dev/null || rm -rf -- "$PF_STALE" ;;
    esac
  done

  # --- conflict check, BEFORE any transfer: list every conflicting name. ---
  # Two flavors, both fatal here: a name that already exists in the target
  # (waived by --force), and two manifest entries sharing one basename
  # (e.g. /a/notes.txt + /b/notes.txt from a multi-dir selection) -- NOT
  # waived by --force, since materializing both into one flat dir would
  # silently make the last one win.
  PF_CONFLICTS=""
  PF_DUPES=""
  PF_SEEN="
"
  PF_MISSING=0
  while IFS= read -r PF_P || [ -n "$PF_P" ]; do
    [ -n "$PF_P" ] || continue
    if [ ! -e "$PF_P" ]; then
      echo "pbpaste: source no longer exists: $PF_P" >&2
      PF_MISSING=1
      continue
    fi
    PF_NAME=$(basename -- "$PF_P")
    case "$PF_SEEN" in
      *"
$PF_NAME
"*) PF_DUPES="$PF_DUPES$PF_NAME
" ;;
      *) PF_SEEN="$PF_SEEN$PF_NAME
" ;;
    esac
    if [ -e "$PF_DIR/$PF_NAME" ] && [ "$PF_FORCE" -eq 0 ]; then
      PF_CONFLICTS="$PF_CONFLICTS$PF_NAME
"
    fi
  done < "$PF_PATHLIST"

  if [ "$PF_MISSING" -eq 1 ]; then
    rm -f "$PF_PATHLIST"
    exit 1
  fi

  if [ -n "$PF_DUPES" ]; then
    echo "pbpaste: clip contains multiple items with the same name -- cannot paste into one directory:" >&2
    printf '%s' "$PF_DUPES" | while IFS= read -r PF_C; do
      [ -n "$PF_C" ] && echo "  $PF_C" >&2
    done
    rm -f "$PF_PATHLIST"
    exit 1
  fi

  if [ -n "$PF_CONFLICTS" ]; then
    echo "pbpaste: refusing to overwrite existing items (use --force):" >&2
    printf '%s' "$PF_CONFLICTS" | while IFS= read -r PF_C; do
      [ -n "$PF_C" ] && echo "  $PF_C" >&2
    done
    rm -f "$PF_PATHLIST"
    exit 1
  fi

  # --- materialize: stage every item, then mv each into place. ---
  PF_STAGING="$PF_DIR/.pbpaste-staging.$$"
  mkdir -p "$PF_STAGING" || {
    echo "pbpaste: could not create staging dir under $PF_DIR" >&2
    rm -f "$PF_PATHLIST"
    exit 1
  }
  # Catchable interrupt (Ctrl+C, a plain TERM) cleans up on the spot. An
  # untrappable SIGKILL skips this -- the sweep at the top of the NEXT
  # invocation is what handles that case (see above).
  trap 'rm -rf -- "$PF_STAGING" 2>/dev/null' EXIT INT TERM

  PF_IS_TTY=0
  [ -t 1 ] && PF_IS_TTY=1
  case "$PF_MODE" in
    quiet) PF_SHOW=0; PF_PORCELAIN=0 ;;
    porcelain) PF_SHOW=0; PF_PORCELAIN=1 ;;
    progress) PF_SHOW=1; PF_PORCELAIN=0 ;;
    auto)
      PF_PORCELAIN=0
      if [ "$PF_IS_TTY" -eq 1 ]; then PF_SHOW=1; else PF_SHOW=0; fi
      ;;
  esac

  PF_CPA_NOTED=0
  PF_START=$(date +%s)
  PF_TOTAL_BYTES=0
  PF_TOTAL_FILES=0
  PF_IDX=0

  while IFS= read -r PF_P || [ -n "$PF_P" ]; do
    [ -n "$PF_P" ] || continue
    PF_IDX=$((PF_IDX + 1))
    PF_NAME=$(basename -- "$PF_P")
    PF_STAGE_TARGET="$PF_STAGING/$PF_NAME"
    PF_SIZE=$(pbpaste_files_size "$PF_P")

    if ! pbpaste_files_copy "$PF_P" "$PF_STAGE_TARGET"; then
      echo "pbpaste: failed to copy $PF_P" >&2
      rm -f "$PF_PATHLIST"
      exit 1
    fi

    PF_FINAL="$PF_DIR/$PF_NAME"
    # --force replacement is rename-aside, NOT delete-then-move: `rm -rf` of
    # a directory target is a recursive, non-atomic delete, so a kill inside
    # that window would leave a half-shredded old tree in the destination --
    # exactly the partial state staging exists to prevent. Instead the old
    # item is renamed INTO the staging dir (same filesystem, atomic), so
    # every destination-visible step is a rename: a kill between the two
    # renames leaves the name briefly absent but the old tree fully intact
    # inside staging, and the EXIT/INT/TERM trap (or, after SIGKILL, the
    # next run's stale-staging sweep) reaps it from there. The `.replaced.`
    # names can't collide with staged items ($$ + index) and die with the
    # staging dir.
    PF_BAK=""
    if [ -e "$PF_FINAL" ]; then
      PF_BAK="$PF_STAGING/.replaced.$$.$PF_IDX"
      mv -- "$PF_FINAL" "$PF_BAK" || {
        echo "pbpaste: failed to displace existing $PF_NAME in $PF_DIR" >&2
        rm -f "$PF_PATHLIST"
        exit 1
      }
    fi
    mv -- "$PF_STAGE_TARGET" "$PF_FINAL" || {
      # Put the displaced original back before bailing; best-effort (the
      # trap still reaps it from staging if even this rename fails).
      [ -n "$PF_BAK" ] && mv -- "$PF_BAK" "$PF_FINAL" 2>/dev/null
      echo "pbpaste: failed to move $PF_NAME into $PF_DIR" >&2
      rm -f "$PF_PATHLIST"
      exit 1
    }

    PF_TOTAL_BYTES=$((PF_TOTAL_BYTES + PF_SIZE))
    PF_TOTAL_FILES=$((PF_TOTAL_FILES + 1))

    if [ "$PF_PORCELAIN" -eq 1 ]; then
      printf 'progress\t%s\t%s\t%s\n' "$PF_FINAL" "$PF_SIZE" "$PF_SIZE"
    elif [ "$PF_SHOW" -eq 1 ]; then
      printf '\342\234\223 %s (%s)\n' "$PF_NAME" "$(pbpaste_files_human "$PF_SIZE")"
    fi
  done < "$PF_PATHLIST"

  rm -f "$PF_PATHLIST"

  PF_ELAPSED=$(( $(date +%s) - PF_START ))

  if [ "$PF_PORCELAIN" -eq 1 ]; then
    printf 'done\t%s\t%s\t%s\n' "$PF_TOTAL_FILES" "$PF_TOTAL_BYTES" "$PF_ELAPSED"
  elif [ "$PF_SHOW" -eq 1 ]; then
    printf 'done: %s file(s), %s in %ss\n' "$PF_TOTAL_FILES" "$(pbpaste_files_human "$PF_TOTAL_BYTES")" "$PF_ELAPSED"
  fi

  exit 0
}

if [ "${1:-}" = "--manifest" ]; then
  pbpaste_manifest
fi

if [ "${1:-}" = "--files" ]; then
  shift
  pbpaste_files "$@"
fi

if [ -z "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]; then
  # Absolute path, not a PATH lookup — see pbcopy for why.
  if [ -x /usr/bin/pbpaste ]; then
    exec /usr/bin/pbpaste
  elif command -v wl-paste >/dev/null 2>&1; then
    exec wl-paste
  elif command -v xclip >/dev/null 2>&1; then
    exec xclip -selection clipboard -o
  else
    echo "pbpaste: no local clipboard tool found (pbpaste/wl-paste/xclip)" >&2
    exit 1
  fi
fi

# The peer (Mac) clipboard, reverse-forwarded to loopback :2490 by
# system-onboard's RemoteForward. Keep the port in sync with that forward,
# clipboard-bridge-client.zsh, and nvim's lua/clipboard/universal.lua.
port="${CLIPBOARD_BRIDGE_PORT:-2490}"

nc -z -w 1 127.0.0.1 "$port" 2>/dev/null || {
  echo "pbpaste: clipboard bridge not reachable on 127.0.0.1:$port (reverse SSH tunnel down?)" >&2
  exit 1
}

# `G` (get) + big-endian length 0, empty payload; the reply is
# <status><BE32 length><text> — drop the 5-byte header, emit the text.
printf 'G\000\000\000\000' | nc -w 2 127.0.0.1 "$port" | { dd bs=1 count=5 of=/dev/null 2>/dev/null; cat; }
