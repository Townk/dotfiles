#!/bin/sh
# pbpaste — universal clipboard paste. Read side of the pbcopy/pbpaste pair;
# see pbcopy for the full picture.
#
# Local (no SSH): delegates straight to the real platform clipboard tool
# (macOS's own /usr/bin/pbpaste, or wl-paste/xclip on Linux).
#
# Over SSH: reads the Mac's clipboard back through a reverse SSH tunnel
# instead of OSC 52 (which Zellij refuses to answer — a terminal-based read
# would just hang). system-onboard's RemoteForward (in the loose
# ~/.ssh/config.d/<alias>.conf; default on) tunnels the Mac's clipboard-bridge
# (launchd `clipboard-bridge` -> socat on 127.0.0.1:2489) to loopback :2490 on
# this host. We speak its framing protocol — a one-byte `G` (get) op — and strip
# the 5-byte <status><length> header off the reply. TCP, not a unix socket:
# macOS OpenSSH silently ignores StreamLocalBindUnlink for remote (-R) socket
# forwards, so a dropped session would strand a stale socket. When the tunnel is
# down there is no local clipboard to fall back to, so this fails loudly instead
# of silently returning nothing.
#
# `pbpaste --manifest` (files-yazi design §5): instead of the clipboard text,
# print the CURRENT clipboard entry's file manifest via bridge op `L`
# (list-files, T2) -- a pure store query, no pasteboard access. Four lines to
# stdout: `kind\t<type_kind>`, `host\t<source_host>`, `ts\t<last_ts>`, then one
# `path\t<path>` line per file. Non-files clip / bridge error / bridge down:
# exit 1, nothing on stdout, reason on stderr. Same port convention as
# pbcopy's U/P frames and this file's own G frame: 2489 locally (this
# machine's own bridge), CLIPBOARD_BRIDGE_PORT (default 2490) over SSH (the
# reverse-tunneled peer bridge). Callers: the Alt+p widget (T6), the yazi
# smart-paste plugin (T8); `pbpaste --files` (T5) reuses the same fetch/parse
# functions below, only the final rendering differs.
#
# `pbpaste --files [--force] [--quiet|--progress|--porcelain] [dir]` (T5,
# design §5/§8): materializes the CURRENT file clip into `dir` (default cwd).
# This task implements ONLY manifests whose host is THIS host -- a manifest
# from a different host exits 1 pointing at the future cross-machine
# milestone (T13). Local engine, tiered (§8):
#   1. darwin: `cp -Rc` (APFS clonefile). Per `man cp`, `-c` transparently
#      falls back to a plain byte copy when cloning isn't possible
#      (cross-volume, non-APFS) and STILL returns success -- tier 2 is only
#      reached if the `cp -c` invocation itself errors (non-darwin, a real
#      cp failure), not merely "cross-volume".
#   2. `/opt/homebrew/bin/rsync -a --info=progress2`, if that exact binary is
#      executable (stock macOS openrsync lacks --info=progress2).
#   3. `cp -a`, with an honest one-line stderr note that there is no live
#      meter for this transfer.
# Everything materializes into `<dir>/.pbpaste-staging.$$/` first; each item
# is `mv`d into its final name individually, so a kill at any point --
# including inside the OS copy syscalls -- never leaves a partial entry in
# the target, only in the (disposable) staging dir. Catchable signals
# (INT/TERM) clean the staging dir on the spot via a trap; an untrappable
# SIGKILL can leave one behind, so every invocation sweeps any stale
# `.pbpaste-staging.*` left by a previous killed run before starting its own.
# Existing target names are refused (all conflicts listed on one stderr
# message) unless `--force`, checked BEFORE any transfer. Output is the
# progress skeleton this task establishes (§8): TTY (or `--progress`) prints
# a `✓ name (size)` line per item plus a final summary; non-TTY (or
# `--quiet`) is silent; `--porcelain` prints
# `progress\t<path>\t<bytes_done>\t<bytes_total>` per item and a terminal
# `done\t<files>\t<bytes>\t<seconds>` -- a CONTRACT later tasks and tests
# parse, so it may only grow columns, never reshape existing ones. For these
# local tiers every item is a single instant operation, so bytes_done always
# equals bytes_total (no partial in-flight progress to report yet). Like the
# accepted literal-newline limit on paths (see manifest_parse), a path
# containing a literal TAB would break the porcelain field count -- accepted,
# not engineered around.
#
# --files, REMOTE branch (T13, design §5/§8): when the manifest's host is a
# DIFFERENT machine (this host is over SSH, the clip lives on the Mac), the
# tiered local engine above cannot run -- there is no shared filesystem.
# Instead, for each manifest path, this streams the item over the SAME
# reverse-tunneled bridge connection (2489 locally / CLIPBOARD_BRIDGE_PORT,
# default 2490, over SSH -- manifest_port()'s existing convention, reused
# unchanged) via two opcodes:
#   F  fetch-file     -- tried first. `O` + BE32 len (the file's EXACT byte
#                         count, known up front) + raw bytes. `E is-directory`
#                         (that EXACT string) means the path is a directory
#                         instead -- retried as an A archive-stream.
#   A  archive-stream  -- `O` + BE32 len=8 + BE64 total (a `du`-based
#                         ESTIMATE, no directional guarantee -- see
#                         clip::op_archive_stream) + a raw `tar` stream with
#                         NO trailing frame: read until EOF, never trust the
#                         estimate to know when to stop. Piped into
#                         `tar -xf -` inside the staging dir; a nonzero tar
#                         exit is the truncation/corruption signal (an
#                         in-flight I/O error on the far end can silently
#                         truncate the stream with no error frame left to
#                         send once the O header is out).
# Same staging + atomic-move + conflict/--force/dup-basename semantics as
# the local engine (shared pbpaste_files_place tail, see below) -- only the
# "fill the staging entry" step differs. Progress (§8): completed items
# print a permanent `✓ name (size)` line; the in-flight item is ONE
# `\r`-rewritten line (name, bytes done/total, percent, throughput) updated
# from the same byte counter driving the read loop, at least every 64 KiB;
# percent is clamped at 100 (an A total is only an estimate). `--porcelain`
# emits the same `progress`/`done` contract lines from that counter -- for
# an in-flight A item, `done` may transiently exceed the estimated `total`
# (porcelain consumers are expected to clamp; this shim doesn't lie about
# the raw counter). Per-item size cap (design §11): a declared total (F's
# exact size, or A's estimate) over `${CLIP_FILE_MAX:-209715200}` bytes
# (200 MB) prompts `continue? [y/N]` on an interactive TTY (`gum confirm` if
# on PATH, else a plain `read -r`); non-interactive callers fail naming the
# cap and the item, before any bytes are pulled.
#
# Standalone POSIX sh, no library sourcing — see pbcopy.
#
# Usage: text=$(pbpaste)
#        pbpaste --manifest
#        pbpaste --files [--force] [--quiet|--progress|--porcelain] [dir]

set -eu

case "${1:-}" in
  -h | --help)
    cat <<'EOF'
Universal clipboard paste — the read side of the pbcopy/pbpaste pair. Prints the
Mac's clipboard to stdout, whether you're at the Mac or SSH'd in.

Local: delegates to the platform tool (/usr/bin/pbpaste, wl-paste, or xclip).
Over SSH: reads the Mac's clipboard back over the clipboard-bridge reverse tunnel
(loopback TCP :2490, set up by system-onboard) instead of OSC 52, which would
hang. Fails loudly when the tunnel is down. See pbcopy for the write side.

--manifest: print the current clipboard entry's file manifest (kind/host/ts/
path lines) instead of its text. Exits 1 (nothing on stdout) if the current
clip isn't a files clip, or the bridge is down.

--files [--force] [--quiet|--progress|--porcelain] [dir]: materialize the
current file clip into dir (default: cwd). Refuses existing names unless
--force. Only manifests originating on this host are supported so far
(remote hosts land in a later milestone). TTY prints a line per item plus a
summary; --porcelain prints a stable machine-readable progress/done stream;
--quiet is silent; non-TTY is silent by default.

Usage: text=$(pbpaste)
       pbpaste --manifest
       pbpaste --files [--force] [--quiet|--progress|--porcelain] [dir]
EOF
    exit 0
    ;;
esac

# self_host — resolve the identity THIS machine compares manifest rows'
# host field against (PF_HOST below). Deliberate DUPLICATE of pbcopy's
# self_host() (these shims are standalone POSIX sh by design -- no library
# sourcing, see pbcopy's "Standalone POSIX sh" rationale -- so shared logic
# is mirrored, not imported; keep the two copies in sync). Why it exists
# (R-batch Task B amendment): an ephemeral cloud dev-shell's `hostname -s`
# changes daily, so manifest rows written by pbcopy carry the STABLE
# self-name identity ssh-prepare-connection's step_mount pushed into
# $XDG_STATE_HOME/clipboard/self-name -- if pbpaste --files on that same
# machine kept resolving the raw ephemeral hostname, its own rows would
# misclassify as REMOTE (PF_REMOTE=1) and route to the peer-fetch engine
# instead of the local cp tiers. Preference order:
#   1. $XDG_STATE_HOME/clipboard/self-name, if present, a SINGLE line, and
#      containing only safe hostname characters with an alphanumeric first
#      character -- validated defensively (shared dev box; the value is also
#      a mount-key/ssh-target shape elsewhere).
#   2. scutil --get LocalHostName.
#   3. hostname -s.
self_host() {
  _sh_file="${XDG_STATE_HOME:-$HOME/.local/state}/clipboard/self-name"
  if [ -f "$_sh_file" ]; then
    _sh_name=$(cat "$_sh_file" 2>/dev/null) || _sh_name=""
    # Embedded newline = a second line survived the command substitution
    # (only TRAILING newlines are stripped): reject the whole file.
    _sh_nl='
'
    case "$_sh_name" in
      *"$_sh_nl"*) _sh_name="" ;;
    esac
    # Two NEGATIVE checks, not one positive [A-Za-z0-9][A-Za-z0-9.-]*
    # pattern: in POSIX `case` syntax `*` is a WILDCARD (unlike zsh's `#`
    # quantifier), so that positive pattern would anchor only the first two
    # characters and let "ab; rm -rf /tmp" through. (a) no character outside
    # the allowlist anywhere; (b) alphanumeric first character.
    case "$_sh_name" in
      *[!A-Za-z0-9.-]*) _sh_name="" ;;
    esac
    case "$_sh_name" in
      [!A-Za-z0-9]*) _sh_name="" ;;
    esac
    if [ -n "$_sh_name" ]; then
      printf '%s' "$_sh_name"
      return 0
    fi
  fi
  scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null
}

# --- --manifest (files-yazi design §5) --------------------------------------
#
# manifest_port: 2489 (this machine's own bridge) locally, else
# CLIPBOARD_BRIDGE_PORT (default 2490, the reverse-tunneled peer bridge --
# same var the plain-paste G frame below honors).
manifest_port() {
  if [ -z "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]; then
    echo 2489
  else
    echo "${CLIPBOARD_BRIDGE_PORT:-2490}"
  fi
}

# manifest_fetch <replyfile> -- sends an empty `L` frame to the manifest port
# and captures the raw <status><BE32 len><payload> reply into <replyfile>.
# Best-effort: a down bridge / missing nc just leaves the file short or
# empty, which manifest_parse's status check below reports as a normal error
# (mirrors pbcopy's send_frame `|| true` rationale: under `set -e` a
# connection-refused failure here must not kill the script before the reply
# check runs).
manifest_fetch() {
  _replyfile=$1
  _port=$(manifest_port)
  printf 'L\000\000\000\000' | nc -w 2 127.0.0.1 "$_port" > "$_replyfile" 2>/dev/null || true
}

# manifest_parse <replyfile> -- on an `O` reply, sets $MANIFEST_KIND /
# $MANIFEST_HOST / $MANIFEST_TS and writes the NUL-joined path list to
# $MANIFEST_PATHFILE; returns 0. On any failure (bridge down, `E` status,
# empty reply) prints a reason to stderr and returns 1 -- caller must not
# print anything to stdout in that case.
#
# Byte-level, not string-level: the payload can hold embedded NULs (the path
# separators), which a POSIX shell variable can't carry intact through
# command substitution (truncates at the first NUL) -- so the payload is
# sliced and split entirely at the file level (dd/tr), never read into a
# shell scalar as a whole. Only the three US-delimited header fields
# (kind/host/ts), which never contain NULs, are lifted into variables.
manifest_parse() {
  _replyfile=$1
  _status=$(dd bs=1 count=1 2>/dev/null < "$_replyfile")
  if [ -z "$_status" ]; then
    echo "pbpaste: clipboard bridge not reachable (reverse SSH tunnel down?)" >&2
    return 1
  fi
  _lenbytes=$(dd bs=1 skip=1 count=4 2>/dev/null < "$_replyfile" | od -An -tu1)
  set -- $_lenbytes
  _len=$(( ${1:-0} * 16777216 + ${2:-0} * 65536 + ${3:-0} * 256 + ${4:-0} ))

  if [ "$_status" != "O" ]; then
    _msg=$(dd bs=1 skip=5 count="$_len" 2>/dev/null < "$_replyfile")
    echo "pbpaste: ${_msg:-bridge reported an error}" >&2
    return 1
  fi

  _payloadfile=$(mktemp "${TMPDIR:-/tmp}/pbpaste-manifest-payload.XXXXXX") || {
    echo "pbpaste: mktemp failed" >&2
    return 1
  }
  dd bs=1 skip=5 count="$_len" 2>/dev/null < "$_replyfile" > "$_payloadfile"

  # Only the 3 header-field separators are \037 (US) -- real filesystem paths
  # don't contain that byte -- so this tr is a safe field split even though
  # the tail (the path blob) keeps flowing through unchanged.
  _fieldsfile=$(mktemp "${TMPDIR:-/tmp}/pbpaste-manifest-fields.XXXXXX") || {
    rm -f "$_payloadfile"
    echo "pbpaste: mktemp failed" >&2
    return 1
  }
  tr '\037' '\n' < "$_payloadfile" > "$_fieldsfile"
  rm -f "$_payloadfile"

  MANIFEST_KIND=$(sed -n '1p' "$_fieldsfile")
  MANIFEST_HOST=$(sed -n '2p' "$_fieldsfile")
  MANIFEST_TS=$(sed -n '3p' "$_fieldsfile")

  MANIFEST_PATHFILE=$(mktemp "${TMPDIR:-/tmp}/pbpaste-manifest-paths.XXXXXX") || {
    rm -f "$_fieldsfile"
    echo "pbpaste: mktemp failed" >&2
    return 1
  }
  tail -n +4 "$_fieldsfile" > "$MANIFEST_PATHFILE"
  rm -f "$_fieldsfile"
  return 0
}

# pbpaste_manifest -- the --manifest entry point: fetch + parse + print the
# four-line kind/host/ts/path* format, or exit 1 with a stderr reason and
# nothing on stdout.
pbpaste_manifest() {
  _replyfile=$(mktemp "${TMPDIR:-/tmp}/pbpaste-manifest-reply.XXXXXX") || {
    echo "pbpaste: mktemp failed" >&2
    exit 1
  }
  manifest_fetch "$_replyfile"
  if ! manifest_parse "$_replyfile"; then
    rm -f "$_replyfile"
    exit 1
  fi
  rm -f "$_replyfile"

  printf 'kind\t%s\n' "$MANIFEST_KIND"
  printf 'host\t%s\n' "$MANIFEST_HOST"
  printf 'ts\t%s\n' "$MANIFEST_TS"
  # NUL -> newline conversion happens ONLY here, at the final print (paths may
  # contain spaces; a path containing a literal newline is a known, accepted
  # limit -- see header comment).
  tr '\000' '\n' < "$MANIFEST_PATHFILE" | while IFS= read -r _p || [ -n "$_p" ]; do
    printf 'path\t%s\n' "$_p"
  done
  rm -f "$MANIFEST_PATHFILE"
  exit 0
}

# --- --files (files-yazi design §5/§8, T5) -----------------------------------
#
# pbpaste_files_size <path> -- bytes for the progress/porcelain fields. Exact
# byte count for a regular file (`wc -c`); disk-usage estimate (`du -sk`,
# rounded to 1K blocks) for a directory, since there is no single "size of a
# tree" syscall. Both the "done" and "total" fields for an item are computed
# by calling this ONCE and reusing the value, so bytes_done == bytes_total
# always holds for these instant local tiers, even though the directory
# figure itself is only an estimate.
pbpaste_files_size() {
  _p=$1
  if [ -d "$_p" ]; then
    _sz=$(du -sk -- "$_p" 2>/dev/null | awk '{print $1*1024}')
  else
    _sz=$(wc -c < "$_p" 2>/dev/null | tr -d ' ')
  fi
  # An unreadable subtree (permissions, a mid-copy race) can make `du`/`wc`
  # come back empty; that must not blow up the caller's arithmetic.
  printf '%s' "${_sz:-0}"
}

# pbpaste_files_human <bytes> -- compact human size for the TTY per-item line
# (`✓ name (12.3M)`). Not used by --porcelain, which reports raw bytes.
pbpaste_files_human() {
  _b=$1
  if [ "$_b" -ge 1073741824 ]; then
    awk -v b="$_b" 'BEGIN { printf "%.1fG", b / 1073741824 }'
  elif [ "$_b" -ge 1048576 ]; then
    awk -v b="$_b" 'BEGIN { printf "%.1fM", b / 1048576 }'
  elif [ "$_b" -ge 1024 ]; then
    awk -v b="$_b" 'BEGIN { printf "%.1fK", b / 1024 }'
  else
    printf '%sB' "$_b"
  fi
}

# pbpaste_files_copy <src> <stagedst> -- the tiered engine (see the header
# comment for the full rationale). Reads the caller's PF_SHOW (whether the
# rsync tier may render its live meter -- on stderr, so a --porcelain stdout
# stream stays parseable) and reads/writes PF_CPA_NOTED (so the tier-3 "no
# live meter" note prints at most once per invocation, not once per item).
pbpaste_files_copy() {
  _src=$1 _dst=$2
  if [ "$(uname -s)" = "Darwin" ] && cp -Rc -- "$_src" "$_dst" 2>/dev/null; then
    return 0
  fi
  # A failed tier can leave a PARTIAL $_dst behind (cp/rsync dying mid-tree
  # on a quota or permission error). Clear it before trying the next tier:
  # rsync would silently merge into the partial result, and `cp -a src dst`
  # with dst already existing as a directory nests src one level deep
  # (dst/src/...) instead of replacing it. Staging content is disposable by
  # design, so an rm between tiers is always safe.
  rm -rf -- "$_dst" 2>/dev/null || true
  if [ -x /opt/homebrew/bin/rsync ]; then
    # Trailing-slash "contents into a pre-made dst" for a directory is
    # byte-equivalent to `cp -R src dst`; a plain file needs neither.
    if [ -d "$_src" ]; then
      _from="$_src/"
      mkdir -p "$_dst" || return 1
    else
      _from=$_src
    fi
    if [ "$PF_SHOW" -eq 1 ]; then
      # The §8 tier-2 promise is brew rsync's live overall meter -- let it
      # through on stderr, keeping stdout reserved for the per-item lines.
      /opt/homebrew/bin/rsync -a --info=progress2 -- "$_from" "$_dst" 1>&2 && return 0
    else
      /opt/homebrew/bin/rsync -a --info=progress2 -- "$_from" "$_dst" >/dev/null 2>&1 && return 0
    fi
    rm -rf -- "$_dst" 2>/dev/null || true
  fi
  if [ "$PF_CPA_NOTED" -eq 0 ] && [ "$PF_SHOW" -eq 1 ]; then
    echo "pbpaste: no live progress meter for this transfer (cp -a fallback)" >&2
    PF_CPA_NOTED=1
  fi
  cp -a -- "$_src" "$_dst"
}

# --- --files, REMOTE engine (T13, design §5/§8) ------------------------------
#
# pbpaste_send_path_request <op> <path> -- writes the raw
# <op><BE32 len><path> request bytes (no trailing NUL) for an F/A call to
# stdout. Same octal-escape BE32 technique as pbcopy's own send_frame,
# specialized to a single absolute-path payload (F/A take nothing else).
pbpaste_send_path_request() {
  _op=$1 _path=$2
  _len=$(printf '%s' "$_path" | wc -c | tr -d ' ')
  printf '%s' "$_op"
  printf "\\$(printf %03o $(((_len>>24)&255)))\\$(printf %03o $(((_len>>16)&255)))\\$(printf %03o $(((_len>>8)&255)))\\$(printf %03o $((_len&255)))"
  printf '%s' "$_path"
}

# pbpaste_read_n <need> <outfile> -- reads exactly <need> bytes from fd 3
# (the current F/A connection, opened by the caller) into <outfile>
# (truncated first), byte-exact via dd -- never through a shell scalar (see
# manifest_parse's own embedded-NUL rationale: these header/body bytes can
# be anything, including NUL). A single `dd bs=N count=1` read(2) on a pipe
# can return FEWER bytes than requested even mid-stream, not just at EOF --
# verified empirically against this exact fifo-based setup -- so dd's exit
# status is never trusted (a short read is not a dd error at all), and the
# loop keeps requesting the remainder until <need> is satisfied. The byte
# counter derives from the ARTIFACT (`wc -c` of the file dd appends to),
# NEVER from dd's stderr summary: that summary's wording is dialect-
# specific (BSD dd prints "bytes transferred", GNU dd prints "bytes
# copied"), and the primary consumer of this remote branch IS a Linux dev
# shell -- parsing either dialect would zero out every read on the other.
# Returns 1 (outfile left short) the moment a read makes no progress --
# the connection hit EOF before <need> bytes arrived, the caller's
# truncation signal.
pbpaste_read_n() {
  _need=$1 _outfile=$2
  : > "$_outfile"
  _got=0
  while [ "$_got" -lt "$_need" ]; do
    _want=$((_need - _got))
    dd bs="$_want" count=1 2>/dev/null 1>>"$_outfile" <&3 || true
    _now=$(wc -c < "$_outfile" | tr -d ' ')
    [ "$_now" -gt "$_got" ] || return 1
    _got=$_now
  done
  return 0
}

# pbpaste_cap_theme <field> -- resolves one hex color for the size-cap gum
# dialog below. This is standalone POSIX sh, so it can't see the zsh-only
# C_HEX_* palette vars (dot_zshrc:57-65's own themed-gum-confirm idiom) --
# they're never exported. Instead this reads the SAME generated JSON palette
# those vars come from (${THEME_PALETTE_JSON:-~/.config/theme/chezmoi-system.json},
# shape `{"palette": {...}, "extended": {"dialog": {...}}}` -- see
# ics-view's _PALETTE_FALLBACK/_load_palette for the identical
# read-json-or-fall-back-to-literals precedent for a non-zsh consumer) via
# jq, falling back to the literal Catppuccin Mocha value on ANY failure
# (jq missing, file missing/unreadable, bad JSON, key absent) -- jq is
# best-effort, zero new hard dependencies, and a stale/missing palette file
# must never block the confirm dialog itself.
pbpaste_cap_theme() {
  case $1 in
    dialog_warning) _ct_path=.extended.dialog.warning _ct_fallback='#e5bf7b' ;;
    crust) _ct_path=.palette.crust _ct_fallback='#11111b' ;;
    subtext0) _ct_path=.palette.subtext0 _ct_fallback='#a6adc8' ;;
    surface0) _ct_path=.palette.surface0 _ct_fallback='#313244' ;;
  esac
  _ct_file=${THEME_PALETTE_JSON:-$HOME/.config/theme/chezmoi-system.json}
  _ct_val=""
  if command -v jq >/dev/null 2>&1 && [ -r "$_ct_file" ]; then
    _ct_val=$(jq -r "${_ct_path} // empty" "$_ct_file" 2>/dev/null) || _ct_val=""
  fi
  case $_ct_val in
    '#'*) printf '%s' "$_ct_val" ;;
    *) printf '%s' "$_ct_fallback" ;;
  esac
}

# pbpaste_files_cap_check <label> <bytes> -- design §11's per-item size cap:
# a declared total (F's exact size, or A's estimate) over
# ${CLIP_FILE_MAX:-209715200} bytes (200 MB) prompts on an interactive
# terminal, `gum confirm` if it's on PATH, else a plain `read -r` fallback;
# non-interactive callers fail naming the cap and the item. Returns 0 to
# proceed, 1 to abort (a message is always on stderr in the 1 case).
#
# PARSE CONTRACT (clipboard-phase6 W1): smart-paste.yazi's remote paste path
# runs this shim as a background `Command` with no controlling terminal, so
# it ALWAYS takes the non-interactive-refusal branch below -- that plugin
# greps this exact stderr line (parse_cap_refusal in
# home/dot_config/yazi/plugins/smart-paste.yazi/main.lua) to recognize a cap
# refusal and raise its own native confirm dialog. Only the fixed substring
# up through "-- refusing" is load-bearing (label, then the parenthesized
# CLIP_FILE_MAX/item byte counts, then " -- refusing"); the free-form text
# AFTER "refusing" is for human eyes only (varies by context) and MUST NOT
# be relied on by anything parsing this line. Keep both sides' comments in
# sync if this shape ever changes.
#
# Interactivity is decided via /dev/tty, NOT `[ -t 0 ]`: every call site
# (pbpaste_remote_materialize/_dir) runs from inside main's per-item
# `while read PF_P ... done < "$PF_PATHLIST"` loop, so stdin is ALWAYS the
# pathlist file here, never a tty -- `[ -t 0 ]` read false even at a live
# interactive terminal, silently forcing the non-interactive refusal every
# time; a stdin `read` for the answer would additionally have eaten
# pathlist lines out from under the loop. `[ -t 1 ] && [ -r /dev/tty ]`
# instead asks "does this invocation have a usable controlling terminal at
# all" -- true whenever one exists, regardless of what stdin is currently
# wired to -- and the prompt/answer are read/written through /dev/tty
# directly so they never touch the redirected stdin or the porcelain-
# reserved stdout.
pbpaste_files_cap_check() {
  _label=$1 _bytes=$2
  _cap=${CLIP_FILE_MAX:-209715200}
  [ "$_bytes" -gt "$_cap" ] || return 0
  if [ -t 1 ] && [ -r /dev/tty ] && [ -w /dev/tty ]; then
    if command -v gum >/dev/null 2>&1; then
      # Same env-prefix theming idiom as dot_zshrc's own gum confirm
      # (dot_zshrc:57-65), just resolved from the JSON palette instead of
      # C_HEX_* (see pbpaste_cap_theme above for why).
      if COLORTERM=truecolor \
         GUM_CONFIRM_PROMPT_FOREGROUND="$(pbpaste_cap_theme dialog_warning)" \
         GUM_CONFIRM_SELECTED_BACKGROUND="$(pbpaste_cap_theme dialog_warning)" \
         GUM_CONFIRM_SELECTED_FOREGROUND="$(pbpaste_cap_theme crust)" \
         GUM_CONFIRM_UNSELECTED_FOREGROUND="$(pbpaste_cap_theme subtext0)" \
         GUM_CONFIRM_UNSELECTED_BACKGROUND="$(pbpaste_cap_theme surface0)" \
         gum confirm "pbpaste: $_label ($_bytes bytes) exceeds CLIP_FILE_MAX ($_cap bytes) -- continue?" </dev/tty >/dev/tty 2>&1; then
        return 0
      fi
    else
      printf 'pbpaste: %s (%s bytes) exceeds CLIP_FILE_MAX (%s bytes) -- continue? [y/N] ' "$_label" "$_bytes" "$_cap" >/dev/tty
      IFS= read -r _reply </dev/tty || _reply=""
      case "$_reply" in
        [Yy]*) return 0 ;;
      esac
    fi
    echo "pbpaste: aborted at user request ($_label)" >&2
    return 1
  fi
  echo "pbpaste: $_label exceeds size cap (CLIP_FILE_MAX=$_cap bytes, item is $_bytes bytes) -- refusing (no interactive confirm available; set CLIP_FILE_MAX=$_bytes or higher to allow)" >&2
  return 1
}

# pbpaste_progress_tick <final> <done> <total> -- the shared in-flight
# renderer for the remote engine (design §8). Porcelain emits the raw
# contract line straight from the byte counter (an in-flight A item's
# `done` may transiently exceed `total`, since `total` is only a `du`
# estimate -- consumers clamp, this shim doesn't lie about the counter).
# Human/TTY mode rewrites ONE line with a bare `\r` (no trailing newline --
# pbpaste_files_place clears it with its own leading `\r` + ANSI
# clear-to-EOL before printing the item's permanent `✓` line), percent
# clamped at 100 for the same A-estimate reason.
pbpaste_progress_tick() {
  _final=$1 _done=$2 _total=$3
  if [ "$PF_PORCELAIN" -eq 1 ]; then
    printf 'progress\t%s\t%s\t%s\n' "$_final" "$_done" "$_total"
  elif [ "$PF_SHOW" -eq 1 ]; then
    _pct=0
    if [ "$_total" -gt 0 ]; then
      _pct=$(( _done * 100 / _total ))
      [ "$_pct" -gt 100 ] && _pct=100
    fi
    _now=$(date +%s)
    _elapsed=$(( _now - PF_ITEM_START ))
    [ "$_elapsed" -lt 1 ] && _elapsed=1
    _rate=$(( _done / _elapsed ))
    printf '\r%s  %s/%s  %s%%  %s/s' "$(basename -- "$_final")" "$_done" "$_total" "$_pct" "$(pbpaste_files_human "$_rate")"
    PF_INFLIGHT_PRINTED=1
  fi
}

# pbpaste_stream_file_body <destfile> <total> <final> -- the F engine's body
# reader: copies exactly <total> bytes from fd 3 into <destfile> (truncated
# first), ticking progress at least every 64 KiB and on the final chunk.
# Byte counter from the growing destfile's own `wc -c`, never dd stderr --
# see pbpaste_read_n's dialect rationale. Sets PF_STREAM_DONE to the bytes
# actually copied. Returns 1 (message already on stderr) if EOF arrives
# before <total> bytes -- a truncated F stream, which (unlike A) has no
# tar-exit integrity check to fall back on, so this loop IS the truncation
# detector for F.
pbpaste_stream_file_body() {
  _dest=$1 _total=$2 _final=$3
  : > "$_dest"
  _done=0
  _since=0
  while [ "$_done" -lt "$_total" ]; do
    _want=$(( _total - _done )); [ "$_want" -gt 65536 ] && _want=65536
    dd bs="$_want" count=1 2>/dev/null 1>>"$_dest" <&3 || true
    _now=$(wc -c < "$_dest" | tr -d ' ')
    _n=$(( _now - _done ))
    if [ "$_n" -le 0 ]; then
      echo "pbpaste: truncated stream for $_final (got $_done of $_total bytes)" >&2
      PF_STREAM_DONE=$_done
      return 1
    fi
    _done=$_now
    _since=$((_since + _n))
    if [ "$_since" -ge 65536 ] || [ "$_done" -ge "$_total" ]; then
      pbpaste_progress_tick "$_final" "$_done" "$_total"
      _since=0
    fi
  done
  PF_STREAM_DONE=$_done
  return 0
}

# pbpaste_stream_dir_body <final> <est_total> -- the A engine's body reader:
# copies bytes from fd 3 into fd 4 (the tar-extraction fifo, already open by
# the caller) until EOF -- an A stream carries NO trailing frame or length,
# the server just closes the connection (see clip::op_archive_stream), so
# EOF here is the NORMAL end, not an error. Each chunk spools through a
# small on-disk file so the byte counter can come from the artifact
# (`wc -c` of the chunk) instead of dd's dialect-specific stderr summary
# (see pbpaste_read_n) -- fd 4 is a pipe, so there is no growing output
# file to measure the way the F reader does. tar itself can also stop
# reading and close ITS end early, the moment it has consumed a complete
# valid archive (its own end-of-archive markers) -- verified empirically
# this can happen well before fd 3 hits EOF (bsdtar's blocking-factor
# padding isn't fully drained) -- so the write side's broken pipe (now on
# the `cat` forwarding the chunk) is ALSO normal, not an error: `|| break`
# just stops the copy. Either way, tar's own exit status (checked by the
# caller after this returns) is the real truncation/corruption signal,
# never this loop's byte count.
pbpaste_stream_dir_body() {
  _final=$1 _total=$2
  _chunk="$PF_STAGING/.chunk.$$.$PF_IDX"
  _done=0
  _since=0
  while :; do
    dd bs=65536 count=1 2>/dev/null 1>"$_chunk" <&3 || true
    _n=$(wc -c < "$_chunk" | tr -d ' ')
    [ "$_n" -gt 0 ] || break
    cat "$_chunk" 1>&4 2>/dev/null || break
    _done=$((_done + _n))
    _since=$((_since + _n))
    if [ "$_since" -ge 65536 ]; then
      pbpaste_progress_tick "$_final" "$_done" "$_total"
      _since=0
    fi
  done
  rm -f "$_chunk"
  pbpaste_progress_tick "$_final" "$_done" "$_total"
  PF_STREAM_DONE=$_done
}

# pbpaste_remote_open_stream <op> <path> <final> -- the shared
# open-connection-and-read-reply-header front half of BOTH remote engines:
# fifo + nc spawn (request built by pbpaste_send_path_request), then the
# <status><BE32 len> reply header off fd 3. One call site to change if the
# reply framing ever does. Returns:
#   0 -- `O` reply. fd 3 is OPEN on the reply body, the nc job is running as
#        $PF_NCPID, and $PF_REPLY_LEN holds the decoded BE32 length. The
#        CALLER owns `exec 3<&-` + `wait $PF_NCPID` on every subsequent
#        path.
#   1 -- connection closed before a full header (message on stderr);
#        fd 3 closed, nc reaped. Nothing further for the caller to clean.
#   2 -- `E` reply; $PF_REPLY_ERR holds the error text (fd 3 closed, nc
#        reaped). The caller decides what it means (e.g. F's is-directory
#        retry) and owns the user-facing message.
pbpaste_remote_open_stream() {
  _rh_op=$1 _rh_path=$2 _rh_final=$3

  _rh_fifo="$PF_STAGING/.netfifo.$$.$PF_IDX"
  rm -f "$_rh_fifo"
  mkfifo "$_rh_fifo" || { echo "pbpaste: mkfifo failed" >&2; return 1; }
  ( pbpaste_send_path_request "$_rh_op" "$_rh_path" | nc -w "${PF_NC_TIMEOUT:-10}" 127.0.0.1 "$PF_PORT" > "$_rh_fifo" ) &
  PF_NCPID=$!
  exec 3< "$_rh_fifo"
  rm -f "$_rh_fifo"

  _rh_hdr1="$PF_STAGING/.hdr1.$$.$PF_IDX"
  _rh_hdr4="$PF_STAGING/.hdr4.$$.$PF_IDX"
  if ! pbpaste_read_n 1 "$_rh_hdr1" || ! pbpaste_read_n 4 "$_rh_hdr4"; then
    exec 3<&-
    wait "$PF_NCPID" 2>/dev/null || true
    rm -f "$_rh_hdr1" "$_rh_hdr4"
    echo "pbpaste: connection closed unexpectedly fetching $_rh_final" >&2
    return 1
  fi
  _rh_status=$(cat "$_rh_hdr1")
  _rh_lenbytes=$(od -An -tu1 < "$_rh_hdr4")
  rm -f "$_rh_hdr1" "$_rh_hdr4"
  set -- $_rh_lenbytes
  PF_REPLY_LEN=$(( ${1:-0} * 16777216 + ${2:-0} * 65536 + ${3:-0} * 256 + ${4:-0} ))

  if [ "$_rh_status" = "E" ]; then
    _rh_errbody="$PF_STAGING/.errbody.$$.$PF_IDX"
    pbpaste_read_n "$PF_REPLY_LEN" "$_rh_errbody" || true
    PF_REPLY_ERR=$(cat "$_rh_errbody" 2>/dev/null)
    rm -f "$_rh_errbody"
    exec 3<&-
    wait "$PF_NCPID" 2>/dev/null || true
    return 2
  fi
  return 0
}

# pbpaste_remote_materialize_dir <src> <stage> <final> -- the A-archive
# retry path (see pbpaste_remote_materialize below): a FRESH connection, a
# fresh A request, tar extraction into PF_STAGING via a second fifo (fd 4)
# so tar's own exit status is the truncation-integrity check (see the
# header comment on pbpaste_stream_dir_body and clip::op_archive_stream's
# own comment on why a mid-stream I/O error on the Mac has no error frame
# left to send). `tar -xf - -C PF_STAGING` on an archive rooted at
# <src>'s basename produces exactly PF_STAGING/<basename> == <stage> --
# nothing further to place on success.
pbpaste_remote_materialize_dir() {
  _src=$1 _stage=$2 _final=$3

  _rc=0
  pbpaste_remote_open_stream A "$_src" "$_final" || _rc=$?
  if [ "$_rc" -eq 2 ]; then
    echo "pbpaste: ${PF_REPLY_ERR:-archive fetch failed} ($_final)" >&2
    return 1
  fi
  [ "$_rc" -eq 0 ] || return 1

  _hdr8="$PF_STAGING/.hdr8.$$.$PF_IDX"
  if ! pbpaste_read_n 8 "$_hdr8"; then
    exec 3<&-
    wait "$PF_NCPID" 2>/dev/null || true
    rm -f "$_hdr8"
    echo "pbpaste: connection closed unexpectedly fetching $_final" >&2
    return 1
  fi
  _szbytes=$(od -An -tu1 < "$_hdr8")
  rm -f "$_hdr8"
  set -- $_szbytes
  _est=$(( (${1:-0} * 72057594037927936) + (${2:-0} * 281474976710656) + (${3:-0} * 1099511627776) \
    + (${4:-0} * 4294967296) + (${5:-0} * 16777216) + (${6:-0} * 65536) + (${7:-0} * 256) + ${8:-0} ))

  if ! pbpaste_files_cap_check "$_final" "$_est"; then
    exec 3<&-
    wait "$PF_NCPID" 2>/dev/null || true
    return 1
  fi

  _tarfifo="$PF_STAGING/.tarfifo.$$.$PF_IDX"
  rm -f "$_tarfifo"
  mkfifo "$_tarfifo" || {
    exec 3<&-
    wait "$PF_NCPID" 2>/dev/null || true
    echo "pbpaste: mkfifo failed" >&2
    return 1
  }
  ( tar -xf - -C "$PF_STAGING" < "$_tarfifo" ) &
  _tarpid=$!
  exec 4> "$_tarfifo"
  rm -f "$_tarfifo"

  PF_ITEM_START=$(date +%s)
  pbpaste_stream_dir_body "$_final" "$_est"

  exec 4>&-
  exec 3<&-
  wait "$PF_NCPID" 2>/dev/null || true
  _tarrc=0
  wait "$_tarpid" || _tarrc=$?

  if [ "$_tarrc" -ne 0 ]; then
    echo "pbpaste: archive extraction failed for $_final (truncated or corrupt stream)" >&2
    rm -rf -- "$_stage"
    return 1
  fi
  return 0
}

# pbpaste_remote_materialize <src> <stage> <final> -- the M3 remote engine
# (design §5/§8): stream <src> from the peer bridge into <stage> (inside
# PF_STAGING; the caller's pbpaste_files_place does the same atomic-move
# tail as the local engine). Tries F first; retries the SAME path as A on
# the dispatcher's EXACT "is-directory" error text (see
# clip::op_fetch_file). Sets PF_STREAM_DONE on success; on failure a message
# is already on stderr and this returns 1.
pbpaste_remote_materialize() {
  _src=$1 _stage=$2 _final=$3

  _rc=0
  pbpaste_remote_open_stream F "$_src" "$_final" || _rc=$?
  if [ "$_rc" -eq 2 ]; then
    if [ "$PF_REPLY_ERR" = "is-directory" ]; then
      pbpaste_remote_materialize_dir "$_src" "$_stage" "$_final"
      return $?
    fi
    echo "pbpaste: ${PF_REPLY_ERR:-fetch failed} ($_final)" >&2
    return 1
  fi
  [ "$_rc" -eq 0 ] || return 1

  if ! pbpaste_files_cap_check "$_final" "$PF_REPLY_LEN"; then
    exec 3<&-
    wait "$PF_NCPID" 2>/dev/null || true
    return 1
  fi

  PF_ITEM_START=$(date +%s)
  if ! pbpaste_stream_file_body "$_stage" "$PF_REPLY_LEN" "$_final"; then
    exec 3<&-
    wait "$PF_NCPID" 2>/dev/null || true
    rm -f "$_stage"
    return 1
  fi
  exec 3<&-
  wait "$PF_NCPID" 2>/dev/null || true
  return 0
}

# pbpaste_files_place <name> <size> <stage> <final> -- the shared atomic-move
# tail for BOTH the local (pbpaste_files_copy) and remote
# (pbpaste_remote_materialize/_dir) engines: renames <stage> into <final>
# (displacing any existing target aside first, same rename-aside rationale
# as before -- never delete-then-move), then emits the item's totals and
# permanent output line. A remote item may have just been rendering an
# in-flight `\r` line (PF_INFLIGHT_PRINTED): clear it with a fresh `\r` +
# ANSI clear-to-EOL before printing the permanent `✓` line, so the two never
# visually collide. Local-only invocations never set PF_INFLIGHT_PRINTED, so
# their output is byte-identical to before this task.
pbpaste_files_place() {
  _name=$1 _size=$2 _stage=$3 _final=$4
  _bak=""
  if [ -e "$_final" ]; then
    _bak="$PF_STAGING/.replaced.$$.$PF_IDX"
    mv -- "$_final" "$_bak" || {
      echo "pbpaste: failed to displace existing $_name in $PF_DIR" >&2
      rm -f "$PF_PATHLIST"
      exit 1
    }
  fi
  mv -- "$_stage" "$_final" || {
    [ -n "$_bak" ] && mv -- "$_bak" "$_final" 2>/dev/null
    echo "pbpaste: failed to move $_name into $PF_DIR" >&2
    rm -f "$PF_PATHLIST"
    exit 1
  }

  PF_TOTAL_BYTES=$((PF_TOTAL_BYTES + _size))
  PF_TOTAL_FILES=$((PF_TOTAL_FILES + 1))

  if [ "$PF_PORCELAIN" -eq 1 ]; then
    printf 'progress\t%s\t%s\t%s\n' "$_final" "$_size" "$_size"
  elif [ "$PF_SHOW" -eq 1 ]; then
    if [ "${PF_INFLIGHT_PRINTED:-0}" -eq 1 ]; then
      printf '\r\033[K'
      PF_INFLIGHT_PRINTED=0
    fi
    printf '\342\234\223 %s (%s)\n' "$_name" "$(pbpaste_files_human "$_size")"
  fi
}

# pbpaste_files [--force] [--quiet|--progress|--porcelain] [dir] -- the
# --files entry point.
pbpaste_files() {
  PF_FORCE=0
  PF_MODE=auto
  PF_DIR=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) PF_FORCE=1 ;;
      --quiet) PF_MODE=quiet ;;
      --progress) PF_MODE=progress ;;
      --porcelain) PF_MODE=porcelain ;;
      --)
        shift
        for _a in "$@"; do
          if [ -z "$PF_DIR" ]; then
            PF_DIR=$_a
          else
            echo "pbpaste: too many arguments" >&2
            exit 1
          fi
        done
        break
        ;;
      -*)
        echo "pbpaste: unknown option: $1" >&2
        exit 1
        ;;
      *)
        if [ -z "$PF_DIR" ]; then
          PF_DIR=$1
        else
          echo "pbpaste: too many arguments" >&2
          exit 1
        fi
        ;;
    esac
    shift
  done
  [ -n "$PF_DIR" ] || PF_DIR=.

  [ -d "$PF_DIR" ] || { echo "pbpaste: no such directory: $PF_DIR" >&2; exit 1; }

  # self_host(), not raw scutil/hostname: rows written by pbcopy on an
  # ephemeral-hostname box carry the pushed self-name identity, so the
  # LOCAL/REMOTE comparison below must resolve the same way or this
  # machine's own rows would misroute to the remote engine (see self_host's
  # comment). The trailing `|| true` keeps the original guarantee that a
  # host resolution failure leaves PF_HOST empty rather than tripping set -e.
  PF_HOST=$(self_host 2>/dev/null || true)
  # Same port manifest_fetch already used for its own L frame (T13
  # requirement 4): 2489 locally, CLIPBOARD_BRIDGE_PORT (default 2490) over
  # SSH -- captured once here and reused by every F/A call below instead of
  # recomputing it per item.
  PF_PORT=$(manifest_port)

  PF_REPLYFILE=$(mktemp "${TMPDIR:-/tmp}/pbpaste-files-reply.XXXXXX") || {
    echo "pbpaste: mktemp failed" >&2
    exit 1
  }
  manifest_fetch "$PF_REPLYFILE"
  PF_ERRFILE=$(mktemp "${TMPDIR:-/tmp}/pbpaste-files-err.XXXXXX") || {
    rm -f "$PF_REPLYFILE"
    echo "pbpaste: mktemp failed" >&2
    exit 1
  }
  if ! manifest_parse "$PF_REPLYFILE" 2>"$PF_ERRFILE"; then
    rm -f "$PF_REPLYFILE"
    if grep -q 'not-files' "$PF_ERRFILE" 2>/dev/null; then
      echo "pbpaste: current clipboard entry is not a files clip -- use plain pbpaste to read it as text" >&2
    else
      cat "$PF_ERRFILE" >&2
    fi
    rm -f "$PF_ERRFILE"
    exit 1
  fi
  rm -f "$PF_REPLYFILE" "$PF_ERRFILE"

  # Explicit LOCAL/REMOTE decision (T5 review ledger: an empty MANIFEST_HOST
  # must be treated as local ON PURPOSE, not merely because the old
  # single-line `-n MANIFEST_HOST && != PF_HOST` guard happened to fall
  # through unevaluated for it) -- a row predating source_host tracking, or
  # a same-host synthetic x-resolved-path row, carries no host at all and
  # certainly didn't cross the bridge from another machine.
  if [ -z "$MANIFEST_HOST" ] || [ "$MANIFEST_HOST" = "$PF_HOST" ]; then
    PF_REMOTE=0
  else
    PF_REMOTE=1
  fi

  # Mac-side pbpaste --files on a remote manifest, NOT over SSH: refuse. The
  # T13 remote engine (F/A opcodes) only exists on the ORIGIN machine's own
  # bridge (port 2489, reachable over the loopback reverse tunnel from an
  # SSH'd-in dev shell) -- sitting at this Mac directly, `manifest_port`
  # would still resolve to 2489, i.e. THIS Mac's own bridge, which has never
  # heard of a path that lives on $MANIFEST_HOST. The spec §12 "Mac-side
  # pbpaste rsync-from-source_host" branch was descoped (quietly, see the
  # §12 as-built note); without it this used to fall through to the F/A
  # engine anyway, producing a confusing per-item "cannot read" at best and,
  # whenever the manifest's absolute path happens to also exist on this
  # Mac (the Mac-to-Mac mirror case), silently materializing a STALE LOCAL
  # TWIN at worst. pick-clipboard's own Ctrl-Y (clip::copy_files_by_id's
  # rsync pull) is the supported Mac-side localization path.
  if [ "$PF_REMOTE" -eq 1 ] && [ -z "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]; then
    echo "pbpaste: manifest lives on $MANIFEST_HOST -- use pick-clipboard Ctrl-Y to localize it on this Mac" >&2
    rm -f "$MANIFEST_PATHFILE"
    exit 1
  fi

  # NUL -> newline, same rule as pbpaste_manifest's own final print: real
  # paths never carry NULs, so this is a lossless, safe split; a path with a
  # literal newline is a known, accepted limit (see manifest_parse's header).
  PF_PATHLIST=$(mktemp "${TMPDIR:-/tmp}/pbpaste-files-list.XXXXXX") || {
    echo "pbpaste: mktemp failed" >&2
    exit 1
  }
  tr '\000' '\n' < "$MANIFEST_PATHFILE" > "$PF_PATHLIST"
  rm -f "$MANIFEST_PATHFILE"

  # Sweep any staging dir orphaned by a previous SIGKILLed run (untrappable,
  # so its own EXIT trap never fired) before this run creates its own. PID-
  # gated, not a blind wildcard rm: a SECOND, genuinely concurrent `pbpaste
  # --files` targeting the same dir has its own live `.pbpaste-staging.<pid>`
  # -- only remove one whose pid is no longer running.
  for PF_STALE in "$PF_DIR"/.pbpaste-staging.*; do
    [ -e "$PF_STALE" ] || continue
    PF_STALE_PID=${PF_STALE##*.}
    case "$PF_STALE_PID" in
      '' | *[!0-9]*) rm -rf -- "$PF_STALE" ;;
      *) kill -0 "$PF_STALE_PID" 2>/dev/null || rm -rf -- "$PF_STALE" ;;
    esac
  done

  # --- conflict check, BEFORE any transfer: list every conflicting name. ---
  # Two flavors, both fatal here: a name that already exists in the target
  # (waived by --force), and two manifest entries sharing one basename
  # (e.g. /a/notes.txt + /b/notes.txt from a multi-dir selection) -- NOT
  # waived by --force, since materializing both into one flat dir would
  # silently make the last one win.
  PF_CONFLICTS=""
  PF_DUPES=""
  PF_SEEN="
"
  PF_MISSING=0
  while IFS= read -r PF_P || [ -n "$PF_P" ]; do
    [ -n "$PF_P" ] || continue
    # This machine can only stat a LOCAL source path -- a remote manifest's
    # paths live on the OTHER machine, so existence is discovered from the
    # F/A opcode's own reply instead (missing source there is just another
    # bridge error, surfaced per-item during materialization below).
    if [ "$PF_REMOTE" -eq 0 ] && [ ! -e "$PF_P" ]; then
      echo "pbpaste: source no longer exists: $PF_P" >&2
      PF_MISSING=1
      continue
    fi
    PF_NAME=$(basename -- "$PF_P")
    case "$PF_SEEN" in
      *"
$PF_NAME
"*) PF_DUPES="$PF_DUPES$PF_NAME
" ;;
      *) PF_SEEN="$PF_SEEN$PF_NAME
" ;;
    esac
    if [ -e "$PF_DIR/$PF_NAME" ] && [ "$PF_FORCE" -eq 0 ]; then
      PF_CONFLICTS="$PF_CONFLICTS$PF_NAME
"
    fi
  done < "$PF_PATHLIST"

  if [ "$PF_MISSING" -eq 1 ]; then
    rm -f "$PF_PATHLIST"
    exit 1
  fi

  if [ -n "$PF_DUPES" ]; then
    echo "pbpaste: clip contains multiple items with the same name -- cannot paste into one directory:" >&2
    printf '%s' "$PF_DUPES" | while IFS= read -r PF_C; do
      [ -n "$PF_C" ] && echo "  $PF_C" >&2
    done
    rm -f "$PF_PATHLIST"
    exit 1
  fi

  if [ -n "$PF_CONFLICTS" ]; then
    echo "pbpaste: refusing to overwrite existing items (use --force):" >&2
    printf '%s' "$PF_CONFLICTS" | while IFS= read -r PF_C; do
      [ -n "$PF_C" ] && echo "  $PF_C" >&2
    done
    rm -f "$PF_PATHLIST"
    exit 1
  fi

  # --- materialize: stage every item, then mv each into place. ---
  PF_STAGING="$PF_DIR/.pbpaste-staging.$$"
  mkdir -p "$PF_STAGING" || {
    echo "pbpaste: could not create staging dir under $PF_DIR" >&2
    rm -f "$PF_PATHLIST"
    exit 1
  }
  # Catchable interrupt (Ctrl+C, a plain TERM) cleans up on the spot. An
  # untrappable SIGKILL skips this -- the sweep at the top of the NEXT
  # invocation is what handles that case (see above).
  trap 'rm -rf -- "$PF_STAGING" 2>/dev/null' EXIT INT TERM

  PF_IS_TTY=0
  [ -t 1 ] && PF_IS_TTY=1
  case "$PF_MODE" in
    quiet) PF_SHOW=0; PF_PORCELAIN=0 ;;
    porcelain) PF_SHOW=0; PF_PORCELAIN=1 ;;
    progress) PF_SHOW=1; PF_PORCELAIN=0 ;;
    auto)
      PF_PORCELAIN=0
      if [ "$PF_IS_TTY" -eq 1 ]; then PF_SHOW=1; else PF_SHOW=0; fi
      ;;
  esac

  PF_CPA_NOTED=0
  PF_START=$(date +%s)
  PF_TOTAL_BYTES=0
  PF_TOTAL_FILES=0
  PF_IDX=0

  PF_INFLIGHT_PRINTED=0

  while IFS= read -r PF_P || [ -n "$PF_P" ]; do
    [ -n "$PF_P" ] || continue
    PF_IDX=$((PF_IDX + 1))
    PF_NAME=$(basename -- "$PF_P")
    PF_STAGE_TARGET="$PF_STAGING/$PF_NAME"
    PF_FINAL="$PF_DIR/$PF_NAME"

    if [ "$PF_REMOTE" -eq 1 ]; then
      if ! pbpaste_remote_materialize "$PF_P" "$PF_STAGE_TARGET" "$PF_FINAL"; then
        rm -f "$PF_PATHLIST"
        exit 1
      fi
      PF_SIZE=$PF_STREAM_DONE
    else
      PF_SIZE=$(pbpaste_files_size "$PF_P")
      if ! pbpaste_files_copy "$PF_P" "$PF_STAGE_TARGET"; then
        echo "pbpaste: failed to copy $PF_P" >&2
        rm -f "$PF_PATHLIST"
        exit 1
      fi
    fi

    # --force replacement is rename-aside, NOT delete-then-move: `rm -rf` of
    # a directory target is a recursive, non-atomic delete, so a kill inside
    # that window would leave a half-shredded old tree in the destination --
    # exactly the partial state staging exists to prevent. Instead the old
    # item is renamed INTO the staging dir (same filesystem, atomic), so
    # every destination-visible step is a rename: a kill between the two
    # renames leaves the name briefly absent but the old tree fully intact
    # inside staging, and the EXIT/INT/TERM trap (or, after SIGKILL, the
    # next run's stale-staging sweep) reaps it from there. The `.replaced.`
    # names can't collide with staged items ($$ + index) and die with the
    # staging dir. (See pbpaste_files_place, shared by both engines.)
    pbpaste_files_place "$PF_NAME" "$PF_SIZE" "$PF_STAGE_TARGET" "$PF_FINAL"
  done < "$PF_PATHLIST"

  rm -f "$PF_PATHLIST"

  PF_ELAPSED=$(( $(date +%s) - PF_START ))

  if [ "$PF_PORCELAIN" -eq 1 ]; then
    printf 'done\t%s\t%s\t%s\n' "$PF_TOTAL_FILES" "$PF_TOTAL_BYTES" "$PF_ELAPSED"
  elif [ "$PF_SHOW" -eq 1 ]; then
    printf 'done: %s file(s), %s in %ss\n' "$PF_TOTAL_FILES" "$(pbpaste_files_human "$PF_TOTAL_BYTES")" "$PF_ELAPSED"
  fi

  exit 0
}

# Test-only escape hatch: sourcing this file with PBPASTE_TEST_SOURCE_ONLY=1
# defines every function above (manifest_port .. pbpaste_files) and then
# returns here, before the real dispatch/exec logic below ever runs -- lets
# the test suite call an internal helper (e.g. pbpaste_cap_theme) directly
# without tripping the local/SSH branches' real side effects (which would
# otherwise exec into the actual platform pbpaste). Never set by anything
# except the test harness.
if [ "${PBPASTE_TEST_SOURCE_ONLY:-0}" = "1" ]; then
  return 0 2>/dev/null || exit 0
fi

if [ "${1:-}" = "--manifest" ]; then
  pbpaste_manifest
fi

if [ "${1:-}" = "--files" ]; then
  shift
  pbpaste_files "$@"
fi

if [ -z "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]; then
  # Absolute path, not a PATH lookup — see pbcopy for why.
  if [ -x /usr/bin/pbpaste ]; then
    exec /usr/bin/pbpaste
  elif command -v wl-paste >/dev/null 2>&1; then
    exec wl-paste
  elif command -v xclip >/dev/null 2>&1; then
    exec xclip -selection clipboard -o
  else
    echo "pbpaste: no local clipboard tool found (pbpaste/wl-paste/xclip)" >&2
    exit 1
  fi
fi

# The peer (Mac) clipboard, reverse-forwarded to loopback :2490 by
# system-onboard's RemoteForward. Keep the port in sync with that forward,
# clipboard-bridge-client.zsh, and nvim's lua/clipboard/universal.lua.
port="${CLIPBOARD_BRIDGE_PORT:-2490}"

nc -z -w 1 127.0.0.1 "$port" 2>/dev/null || {
  echo "pbpaste: clipboard bridge not reachable on 127.0.0.1:$port (reverse SSH tunnel down?)" >&2
  exit 1
}

# `G` (get) + big-endian length 0, empty payload; the reply is
# <status><BE32 length><text> — drop the 5-byte header, emit the text.
printf 'G\000\000\000\000' | nc -w 2 127.0.0.1 "$port" | { dd bs=1 count=5 of=/dev/null 2>/dev/null; cat; }
