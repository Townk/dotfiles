#!/bin/sh
# pbpaste — universal clipboard paste. The read side of the pair.
#
# A trampoline; see the header of `pbcopy` for why this is a file rather than
# an alias or a symlink. The implementation is `system-clip paste`, which keeps
# every flag this shim had: `--manifest`, and
# `--files [--force] [--quiet|--progress|--porcelain] [dir]`.
exec "${SYSTEM_CLIP_BIN:-$HOME/.local/bin/system-clip}" paste "$@"
