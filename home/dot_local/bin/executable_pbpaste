#!/bin/sh
# pbpaste — universal clipboard paste. Read side of the pbcopy/pbpaste pair;
# see pbcopy for the full picture.
#
# Local (no SSH): delegates straight to the real platform clipboard tool
# (macOS's own /usr/bin/pbpaste, or wl-paste/xclip on Linux).
#
# Over SSH: reads the Mac's clipboard back through a reverse SSH tunnel
# instead of OSC 52 (which Zellij refuses to answer — a terminal-based read
# would just hang). system-onboard's RemoteForward (in the loose
# ~/.ssh/config.d/<alias>.conf; default on) tunnels the Mac's clipboard-bridge
# (launchd `clipboard-bridge` -> socat on 127.0.0.1:2489) to loopback :2490 on
# this host. We speak its framing protocol — a one-byte `G` (get) op — and strip
# the 5-byte <status><length> header off the reply. TCP, not a unix socket:
# macOS OpenSSH silently ignores StreamLocalBindUnlink for remote (-R) socket
# forwards, so a dropped session would strand a stale socket. When the tunnel is
# down there is no local clipboard to fall back to, so this fails loudly instead
# of silently returning nothing.
#
# Standalone POSIX sh, no library sourcing — see pbcopy.
#
# Usage: text=$(pbpaste)

set -eu

case "${1:-}" in
  -h | --help)
    cat <<'EOF'
Universal clipboard paste — the read side of the pbcopy/pbpaste pair. Prints the
Mac's clipboard to stdout, whether you're at the Mac or SSH'd in.

Local: delegates to the platform tool (/usr/bin/pbpaste, wl-paste, or xclip).
Over SSH: reads the Mac's clipboard back over the clipboard-bridge reverse tunnel
(loopback TCP :2490, set up by system-onboard) instead of OSC 52, which would
hang. Fails loudly when the tunnel is down. See pbcopy for the write side.

Usage: text=$(pbpaste)
EOF
    exit 0
    ;;
esac

if [ -z "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]; then
  # Absolute path, not a PATH lookup — see pbcopy for why.
  if [ -x /usr/bin/pbpaste ]; then
    exec /usr/bin/pbpaste
  elif command -v wl-paste >/dev/null 2>&1; then
    exec wl-paste
  elif command -v xclip >/dev/null 2>&1; then
    exec xclip -selection clipboard -o
  else
    echo "pbpaste: no local clipboard tool found (pbpaste/wl-paste/xclip)" >&2
    exit 1
  fi
fi

# The peer (Mac) clipboard, reverse-forwarded to loopback :2490 by
# system-onboard's RemoteForward. Keep the port in sync with that forward,
# clipboard-bridge-client.zsh, and nvim's lua/clipboard/universal.lua.
port="${CLIPBOARD_BRIDGE_PORT:-2490}"

nc -z -w 1 127.0.0.1 "$port" 2>/dev/null || {
  echo "pbpaste: clipboard bridge not reachable on 127.0.0.1:$port (reverse SSH tunnel down?)" >&2
  exit 1
}

# `G` (get) + big-endian length 0, empty payload; the reply is
# <status><BE32 length><text> — drop the 5-byte header, emit the text.
printf 'G\000\000\000\000' | nc -w 2 127.0.0.1 "$port" | { dd bs=1 count=5 of=/dev/null 2>/dev/null; cat; }
