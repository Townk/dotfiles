#!/usr/bin/env zsh
# system-service-launchd — manage launchd user agents declared in
# ~/.config/packages/services.toml. Plists are rendered from the TOML
# entry and bootstrapped into the GUI domain (`gui/$(id -u)`), the same
# domain `brew services` uses for its formula-driven services.
#
# The manifest lives next to the package manifests because services are
# tightly coupled to the packages they wrap (cmd[0] is the binary one of
# the system-package-<eco> workers installs). `system-package-* sync`
# triggers a restart of any matching service that's currently running.
#
# Subcommands (public): list | start <name> | stop <name> | restart <name> |
#                       info <name> | sync | render <name>
# Subcommands (internal, used by dispatcher / workers):
#   declared           — print declared service names
#   matching <pkg>     — print declared service names whose key OR
#                        cmd[0] basename matches <pkg>
#   status   <name>    — print normalized status (running/stopped/error/none)
#
# `render` is a debug helper — emits the plist XML on stdout without
# touching launchctl. Used by tests.

set -eu -o pipefail

# SYS_PKG_LIB overrides the shared-lib dir (like backup's BKP_LIB) so the
# ShellSpec suite can point this at the worktree copy — needed now that
# svc::bootout relies on poll::until from common.zsh, which the suite must see
# before it is applied. Default unchanged.
source "${SYS_PKG_LIB:-$HOME/.local/lib}/system-package-common.zsh"
source "${SYS_PKG_LIB:-$HOME/.local/lib}/system-service-common.zsh"

# Overridable (like SVCFILE/PKG_DIR) so the suite can point plist writes and the
# orphan sweep at a throwaway dir instead of the real ~/Library/LaunchAgents.
LAUNCH_AGENTS="${LAUNCH_AGENTS:-$HOME/Library/LaunchAgents}"
DOMAIN="gui/$(id -u)"

# svc::label <name> → fully-qualified launchd label
svc::label() { printf '%s.%s\n' "$LABEL_PREFIX" "$1"; }

# svc::plist_path <name> → absolute path to the plist for a service
svc::plist_path() { printf '%s/%s.plist\n' "$LAUNCH_AGENTS" "$(svc::label "$1")"; }

# svc::render_json <name>
# Build the plist's JSON representation from the TOML entry. `~` prefixes
# in paths and env values are expanded to $HOME; cmd[0] is resolved to an
# absolute path. The rest of cmd is passed through verbatim.
svc::render_json() {
  local name="$1"
  local json
  json=$(svc::toml_json)
  local cmd0
  cmd0=$(printf '%s' "$json" | jq -r --arg n "$name" '.[$n].cmd[0] // empty')
  [[ -n "$cmd0" ]] || die "service '$name' has no cmd"
  local cmd0_abs
  cmd0_abs=$(svc::resolve_cmd0 "$cmd0")
  local label
  label=$(svc::label "$name")

  printf '%s' "$json" | jq \
    --arg n "$name" \
    --arg label "$label" \
    --arg cmd0 "$cmd0_abs" \
    --arg home "$HOME" '
      def detilde:
        if type == "string" then sub("^~"; $home) else . end;
      .[$n] as $s
      | {
          Label: $label,
          ProgramArguments: ([$cmd0] + ($s.cmd[1:] // [])),
          KeepAlive: ($s.keep_alive // false),
          RunAtLoad:  ($s.run_at_load // false)
        }
      | if $s.working_dir    then . + {WorkingDirectory:    ($s.working_dir    | detilde)} else . end
      | if $s.log_path       then . + {StandardOutPath:     ($s.log_path       | detilde)} else . end
      | if $s.error_log_path then . + {StandardErrorPath:   ($s.error_log_path | detilde)} else . end
      | if $s.env            then . + {EnvironmentVariables:($s.env | with_entries(.value |= detilde))} else . end
      # Optional scheduling / QoS keys (added for system-backup agents).
      # low_priority_io compares against null, not truthiness, so an explicit
      # `false` still renders (the other five have no meaningful falsy value).
      | if $s.start_interval          then . + {StartInterval:         $s.start_interval} else . end
      | if $s.start_calendar_interval then . + {StartCalendarInterval: $s.start_calendar_interval} else . end
      | if $s.watch_paths             then . + {WatchPaths:            ($s.watch_paths | map(detilde))} else . end
      | if $s.process_type            then . + {ProcessType:           $s.process_type} else . end
      | if $s.low_priority_io != null then . + {LowPriorityIO:         $s.low_priority_io} else . end
      | if $s.nice                    then . + {Nice:                  $s.nice} else . end
    '
}

# svc::render_plist <name> → emit the plist XML
svc::render_plist() {
  svc::render_json "$1" | plutil -convert xml1 -o - -- -
}

# svc::write_plist <name>
# Render the plist and write it atomically to ~/Library/LaunchAgents.
# Returns "wrote" or "unchanged" on stdout so callers can decide whether
# to bootout+bootstrap (config drift) vs leave the running service alone.
svc::write_plist() {
  local name="$1"
  local target
  target=$(svc::plist_path "$name")
  mkdir -p "$LAUNCH_AGENTS"
  local rendered
  rendered=$(svc::render_plist "$name")
  if [[ -f "$target" ]] && diff -q <(printf '%s' "$rendered") "$target" >/dev/null 2>&1; then
    printf 'unchanged\n'
    return 0
  fi
  local tmp
  tmp=$(mktemp)
  printf '%s' "$rendered" >"$tmp"
  mv "$tmp" "$target"
  printf 'wrote\n'
}

# svc::is_bootstrapped <name>
svc::is_bootstrapped() {
  launchctl print "$DOMAIN/$(svc::label "$1")" >/dev/null 2>&1
}

# svc::pid <name> → PID of the running service, or empty if not running
svc::pid() {
  launchctl print "$DOMAIN/$(svc::label "$1")" 2>/dev/null |
    awk '/^[[:space:]]*pid =/ {print $3; exit}'
}

# svc::status <name>
# Normalised status string for the unified list table. Values:
#   running  — bootstrapped with a live PID
#   stopped  — bootstrapped, no PID (on-demand idle, never run, KeepAlive
#              wait, or a clean exit)
#   error    — bootstrapped, no PID, last exit code is a nonzero integer
#   none     — declared but never bootstrapped (or boot'd-out)
svc::status() {
  local name="$1"
  svc::is_bootstrapped "$name" || {
    printf 'none\n'
    return
  }
  local pid
  pid=$(svc::pid "$name")
  if [[ -n "$pid" && "$pid" != "0" ]]; then
    printf 'running\n'
    return
  fi
  # Bootstrapped but no PID. Inspect the last exit code. launchctl prints
  # either an integer ("0", "2", ...) or the literal "(never exited)" for a
  # service that was loaded but has not run yet (on-demand: RunAtLoad=false).
  # Capture the whole value after "= " — splitting on whitespace would slice
  # "(never exited)" into "(never", which reads as a bogus nonzero code and
  # paints every idle on-demand service "error". Only a nonzero integer is a
  # real failure.
  local rc
  rc=$(launchctl print "$DOMAIN/$(svc::label "$name")" 2>/dev/null |
    awk -F ' = ' '/^[[:space:]]*last exit code =/ {print $2; exit}')
  if [[ "$rc" == <-> && "$rc" != "0" ]]; then
    printf 'error\n'
  else
    printf 'stopped\n'
  fi
}

# svc::bootstrap <name> → idempotent; no-op if already loaded
svc::bootstrap() {
  local name="$1"
  if svc::is_bootstrapped "$name"; then
    log_info "launchd: $(svc::label "$name") already bootstrapped"
    return 0
  fi
  launchctl bootstrap "$DOMAIN" "$(svc::plist_path "$name")"
}

# svc::bootout <name> → idempotent, and SYNCHRONOUS.
# `launchctl bootout` returns before the service has finished tearing down, so
# the instance can still be draining when the command exits. A follow-up
# `bootstrap` (e.g. from `restart`, or `start` after a plist rewrite) would
# then see the half-gone instance via `is_bootstrapped`, decide it's "already
# bootstrapped", skip itself, and leave nothing running once the drain
# completes. Poll until launchd really has dropped it (≤5s) so callers can
# safely re-bootstrap.
svc::bootout() {
  local name="$1"
  local target="$DOMAIN/$(svc::label "$name")"
  svc::is_bootstrapped "$name" || return 0
  launchctl bootout "$target" 2>/dev/null || true
  # Poll until launchd really has dropped it (≤5s) so callers can safely
  # re-bootstrap. svc::_dropped closes over $name via dynamic scope.
  svc::_dropped() { ! svc::is_bootstrapped "$name" }
  poll::until 5 0.1 svc::_dropped
  return 0
}

# svc::kickstart <name> → run the service now, regardless of launch conditions.
# `bootstrap` only *registers* the plist; for a daemon (RunAtLoad=true) that
# also starts it, but an on-demand service (RunAtLoad=false) stays idle until
# something triggers it. An explicit `start` should mean "running now" for
# both kinds, so kickstart after bootstrap. No `-k`: kickstart on an already-
# running service is a harmless no-op (exit 0), so this never disturbs a live
# instance — `restart` is the way to recycle one.
svc::kickstart() {
  launchctl kickstart "$DOMAIN/$(svc::label "$1")"
}

# --- subcommands ------------------------------------------------------------

do_render() {
  [[ $# -eq 1 ]] || die "usage: render <name>"
  svc::declared "$1" || die "no such service in $SVCFILE: $1"
  svc::render_plist "$1"
}

do_start() {
  [[ $# -eq 1 ]] || die "usage: start <name>"
  local name="$1"
  svc::declared "$name" || die "no such service in $SVCFILE: $name"
  svc::ensure_dirs "$name"
  local changed
  changed=$(svc::write_plist "$name")
  if [[ "$changed" == "wrote" ]]; then
    # Plist content changed — bootout any existing instance so the new
    # plist actually takes effect on bootstrap.
    svc::bootout "$name"
  fi
  svc::bootstrap "$name"
  svc::kickstart "$name"
  log_info "started $(svc::label "$name")"
}

do_stop() {
  [[ $# -eq 1 ]] || die "usage: stop <name>"
  svc::bootout "$1"
  log_info "stopped $(svc::label "$1")"
}

do_restart() {
  [[ $# -eq 1 ]] || die "usage: restart <name>"
  do_stop "$1"
  do_start "$1"
}

do_info() {
  [[ $# -eq 1 ]] || die "usage: info <name>"
  local name="$1"
  svc::declared "$name" || die "no such service in $SVCFILE: $name"
  printf '%s%s%s\n' "$C_BWH" "$(svc::label "$name")" "$C_RES"
  printf '  status:   %s\n' "$(svc::status "$name")"
  printf '  plist:    %s\n' "$(svc::plist_path "$name")"
  printf '  manifest entry:\n'
  svc::toml_json | jq --arg n "$name" '.[$n]' | sed 's/^/    /'
  if svc::is_bootstrapped "$name"; then
    printf '\n  launchctl print:\n'
    launchctl print "$DOMAIN/$(svc::label "$name")" 2>/dev/null | sed 's/^/    /'
  fi
}

# svc::schedule_label <name>
# Human-readable schedule for a timer-driven service — "every 30m",
# "daily 03:17", "watch", joined with " + " when combined; empty for plain
# on-demand/keep-alive services. Intervals print as hours when they divide
# evenly, minutes otherwise.
svc::schedule_label() {
  svc::toml_json | jq -r --arg n "$1" '
    def pad2: tostring | if length < 2 then "0" + . else . end;
    .[$n] as $s
    | [ (if $s.start_interval then
           (if ($s.start_interval % 3600) == 0
            then "every \($s.start_interval / 3600 | floor)h"
            else "every \($s.start_interval / 60 | floor)m"
            end)
         else empty end),
        (if $s.start_calendar_interval then
           "daily \($s.start_calendar_interval.Hour // 0 | pad2):\($s.start_calendar_interval.Minute // 0 | pad2)"
         else empty end),
        (if $s.watch_paths then "watch" else empty end) ]
    | join(" + ")'
}

# do_list — TSV rows: Service\tStatus\tUser\tFile (Source is prepended
# by the dispatcher). A bootstrapped timer/watch agent between fires is
# launchd "not running", but "stopped" reads as broken to a human — those
# render as "idle (<schedule>)". Display only: the `status` verb keeps the
# running/stopped/error/none vocabulary (restart-for's contract).
do_list() {
  # NB: "st", not "status" — status is zsh's read-only alias for $?.
  local user st label
  user=$(id -un)
  svc::names | while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    st=$(svc::status "$name")
    if [[ "$st" == stopped ]]; then
      label=$(svc::schedule_label "$name")
      [[ -n "$label" ]] && st="idle ($label)"
    fi
    printf '%s\t%s\t%s\t%s\n' "$name" "$st" "$user" "$(svc::plist_path "$name")"
  done
}

# do_sync — reconcile declared (services.toml) ↔ bootstrapped state.
#   declared, not bootstrapped → write plist + bootstrap
#   declared, plist drifted    → write plist + bootout + bootstrap
#   not declared, plist exists → bootout + rm plist
do_sync() {
  log_info "Syncing launchd services..."

  local -a declared
  declared=(${(f)"$(svc::names)"})

  # Apply declared entries
  local name=""
  for name in "${declared[@]}"; do
    [[ -z "$name" ]] && continue
    svc::ensure_dirs "$name"
    local changed
    changed=$(svc::write_plist "$name")
    if [[ "$changed" == "wrote" ]] && svc::is_bootstrapped "$name"; then
      # Plist drifted on a bootstrapped service. Capture whether it was
      # actually running BEFORE we boot it out: bootstrap only re-registers the
      # new plist, so an on-demand service (RunAtLoad=false) that was running
      # would come back idle and its endpoint would silently go down. Kickstart
      # it back — but only if it was running, never a stopped/errored one (that
      # matches do_start's tail and honours the "don't resurrect" contract).
      local was_running=""
      [[ "$(svc::status "$name")" == running ]] && was_running=1
      svc::bootout "$name"
      svc::bootstrap "$name" || log_warn "failed to bootstrap $(svc::label "$name")"
      [[ -n "$was_running" ]] && svc::kickstart "$name"
      continue
    fi
    svc::bootstrap "$name" || log_warn "failed to bootstrap $(svc::label "$name")"
  done

  # Remove orphans: any com.system-service.*.plist no longer in TOML.
  local existing="" base="" plist=""
  for plist in "$LAUNCH_AGENTS"/${LABEL_PREFIX}.*.plist(N); do
    base="${plist:t:r}"             # com.system-service.foo
    name="${base#${LABEL_PREFIX}.}" # foo
    local found=0 d=""
    for d in "${declared[@]}"; do [[ "$d" == "$name" ]] && {
      found=1
      break
    }; done
    ((found)) && continue
    log_info "removing orphan $(svc::label "$name")"
    svc::bootout "$name"
    rm -f "$plist"
  done
}

# do_matching <pkg>
# Internal: print declared service names whose top-level key OR cmd[0]
# basename matches <pkg>. Used by `system-service restart-for` to map an
# upgraded package name back to the services it owns.
do_matching() {
  [[ $# -eq 1 ]] || die "usage: matching <pkg>"
  svc::matching "$1"
}

# do_status <name>
# Internal: print the normalized status string. Wrapper around svc::status
# exposed as a subcommand so external callers (system-service) don't have
# to source this script.
do_status() {
  [[ $# -eq 1 ]] || die "usage: status <name>"
  svc::status "$1"
}

case "${1:-}" in
  list)
    shift
    do_list "$@"
    ;;
  start)
    shift
    do_start "$@"
    ;;
  stop)
    shift
    do_stop "$@"
    ;;
  restart)
    shift
    do_restart "$@"
    ;;
  info)
    shift
    do_info "$@"
    ;;
  sync)
    shift
    do_sync "$@"
    ;;
  render)
    shift
    do_render "$@"
    ;;
  declared)
    shift
    svc::names
    ;; # internal: used by the dispatcher
  matching)
    shift
    do_matching "$@"
    ;; # internal: used by restart-for
  status)
    shift
    do_status "$@"
    ;; # internal: used by restart-for
  -h | --help | help)
    cat <<'EOF'
Manage launchd user agents declared in ~/.config/packages/services.toml: each
plist is rendered from its TOML entry and bootstrapped into the GUI domain.
Usually driven by the unified `system-service` CLI, not called directly.

Usage:
  system-service-launchd list                       declared launchd services
  system-service-launchd start|stop|restart|info <name>
  system-service-launchd sync                        reconcile plists with services.toml
EOF
    exit 0
    ;;
  *) die "usage: system-service-launchd {list|start|stop|restart|info|sync|render|declared|matching|status} [args]" ;;
esac
