#!/usr/bin/env zsh
# system-service-launchd — manage launchd user agents declared in
# ~/.config/packages/services.toml. Plists are rendered from the TOML
# entry and bootstrapped into the GUI domain (`gui/$(id -u)`), the same
# domain `brew services` uses for its formula-driven services.
#
# The manifest lives next to the package manifests because services are
# tightly coupled to the packages they wrap (cmd[0] is the binary one of
# the system-package-<eco> workers installs). `system-package-* sync`
# triggers a restart of any matching service that's currently running.
#
# Subcommands (public): list | start <name> | stop <name> | restart <name> |
#                       info <name> | sync | render <name>
# Subcommands (internal, used by dispatcher / workers):
#   declared           — print declared service names
#   matching <pkg>     — print declared service names whose key OR
#                        cmd[0] basename matches <pkg>
#   status   <name>    — print normalized status (running/stopped/error/none)
#
# `render` is a debug helper — emits the plist XML on stdout without
# touching launchctl. Used by tests.

set -eu -o pipefail

source "$HOME/.local/lib/system-package-common.sh"

# services.toml lives in $PKG_DIR (~/.config/packages by default) so all
# system-package-* state stays in one directory.
SVCFILE="${SVCFILE:-$PKG_DIR/services.toml}"
LAUNCH_AGENTS="$HOME/Library/LaunchAgents"
LABEL_PREFIX="com.system-service"
DOMAIN="gui/$(id -u)"

# svc::label <name> → fully-qualified launchd label
svc::label() { printf '%s.%s\n' "$LABEL_PREFIX" "$1"; }

# svc::plist_path <name> → absolute path to the plist for a service
svc::plist_path() { printf '%s/%s.plist\n' "$LAUNCH_AGENTS" "$(svc::label "$1")"; }

# svc::toml_json — cached JSON view of services.toml. Empty `{}` if the
# manifest doesn't exist (chezmoi may not have rendered it yet on a
# fresh machine).
svc::toml_json() {
  if [[ -f "$SVCFILE" ]]; then
    yq -p toml -o json '.' "$SVCFILE"
  else
    printf '{}\n'
  fi
}

# svc::names — top-level keys of services.toml, one per line
svc::names() {
  svc::toml_json | jq -r 'keys[]' 2>/dev/null || true
}

# svc::declared <name> → returns 0 iff <name> exists in services.toml
svc::declared() {
  svc::toml_json | jq -e --arg n "$1" 'has($n)' >/dev/null 2>&1
}

# svc::resolve_cmd0 <cmd0_token>
# Resolve the first cmd token (typically a bare binary name like "omlx") to
# an absolute path. `launchctl` cannot search PATH; ProgramArguments[0]
# must resolve as-given. Falls back to the literal value when `command -v`
# can't find it — that error surfaces at bootstrap time rather than here
# so the user gets a clean message.
svc::resolve_cmd0() {
  local cmd0="$1"
  if [[ "$cmd0" == /* ]]; then
    printf '%s\n' "$cmd0"
  else
    command -v "$cmd0" 2>/dev/null || printf '%s\n' "$cmd0"
  fi
}

# svc::render_json <name>
# Build the plist's JSON representation from the TOML entry. `~` prefixes
# in paths and env values are expanded to $HOME; cmd[0] is resolved to an
# absolute path. The rest of cmd is passed through verbatim.
svc::render_json() {
  local name="$1"
  local json; json=$(svc::toml_json)
  local cmd0; cmd0=$(printf '%s' "$json" | jq -r --arg n "$name" '.[$n].cmd[0] // empty')
  [[ -n "$cmd0" ]] || die "service '$name' has no cmd"
  local cmd0_abs; cmd0_abs=$(svc::resolve_cmd0 "$cmd0")
  local label; label=$(svc::label "$name")

  printf '%s' "$json" | jq \
    --arg n "$name" \
    --arg label "$label" \
    --arg cmd0 "$cmd0_abs" \
    --arg home "$HOME" '
      def detilde:
        if type == "string" then sub("^~"; $home) else . end;
      .[$n] as $s
      | {
          Label: $label,
          ProgramArguments: ([$cmd0] + ($s.cmd[1:] // [])),
          KeepAlive: ($s.keep_alive // false),
          RunAtLoad:  ($s.run_at_load // false)
        }
      | if $s.working_dir    then . + {WorkingDirectory:    ($s.working_dir    | detilde)} else . end
      | if $s.log_path       then . + {StandardOutPath:     ($s.log_path       | detilde)} else . end
      | if $s.error_log_path then . + {StandardErrorPath:   ($s.error_log_path | detilde)} else . end
      | if $s.env            then . + {EnvironmentVariables:($s.env | with_entries(.value |= detilde))} else . end
    '
}

# svc::render_plist <name> → emit the plist XML
svc::render_plist() {
  svc::render_json "$1" | plutil -convert xml1 -o - -- -
}

# svc::write_plist <name>
# Render the plist and write it atomically to ~/Library/LaunchAgents.
# Returns "wrote" or "unchanged" on stdout so callers can decide whether
# to bootout+bootstrap (config drift) vs leave the running service alone.
svc::write_plist() {
  local name="$1"
  local target; target=$(svc::plist_path "$name")
  mkdir -p "$LAUNCH_AGENTS"
  local rendered; rendered=$(svc::render_plist "$name")
  if [[ -f "$target" ]] && diff -q <(printf '%s' "$rendered") "$target" >/dev/null 2>&1; then
    printf 'unchanged\n'
    return 0
  fi
  local tmp; tmp=$(mktemp)
  printf '%s' "$rendered" > "$tmp"
  mv "$tmp" "$target"
  printf 'wrote\n'
}

# svc::ensure_dirs <name>
# Make sure WorkingDirectory and the parent dirs of StandardOut/ErrorPath
# exist before bootstrapping — launchd errors out with EX_NOENT (78) when
# these don't exist, and the error surfaces as a cryptic "spawn failed"
# instead of "missing dir".
svc::ensure_dirs() {
  local name="$1"
  svc::toml_json | jq -r --arg n "$name" --arg home "$HOME" '
    .[$n] as $s
    | ($s.working_dir, $s.log_path, $s.error_log_path)
    | select(. != null)
    | sub("^~"; $home)
  ' | while IFS= read -r p; do
    [[ -z "$p" ]] && continue
    # log/error paths point at the file itself — strip the basename.
    [[ "$p" == *.log || "$p" == *.out || "$p" == *.err ]] && p="${p:h}"
    mkdir -p "$p"
  done
}

# svc::is_bootstrapped <name>
svc::is_bootstrapped() {
  launchctl print "$DOMAIN/$(svc::label "$1")" >/dev/null 2>&1
}

# svc::pid <name> → PID of the running service, or empty if not running
svc::pid() {
  launchctl print "$DOMAIN/$(svc::label "$1")" 2>/dev/null \
    | awk '/^[[:space:]]*pid =/ {print $3; exit}'
}

# svc::status <name>
# Normalised status string for the unified list table. Values:
#   running  — bootstrapped with a live PID
#   stopped  — bootstrapped, no PID (waiting for KeepAlive trigger / crashed)
#   error    — bootstrapped, last_exit_code != 0
#   none     — declared but never bootstrapped (or boot'd-out)
svc::status() {
  local name="$1"
  svc::is_bootstrapped "$name" || { printf 'none\n'; return; }
  local pid; pid=$(svc::pid "$name")
  if [[ -n "$pid" && "$pid" != "0" ]]; then
    printf 'running\n'; return
  fi
  # Bootstrapped but no PID — check last exit code; non-zero = error
  local rc
  rc=$(launchctl print "$DOMAIN/$(svc::label "$name")" 2>/dev/null \
       | awk '/^[[:space:]]*last exit code =/ {print $5; exit}')
  if [[ -n "$rc" && "$rc" != "0" && "$rc" != "-" ]]; then
    printf 'error\n'
  else
    printf 'stopped\n'
  fi
}

# svc::bootstrap <name> → idempotent; no-op if already loaded
svc::bootstrap() {
  local name="$1"
  if svc::is_bootstrapped "$name"; then
    log_info "launchd: $(svc::label "$name") already bootstrapped"
    return 0
  fi
  launchctl bootstrap "$DOMAIN" "$(svc::plist_path "$name")"
}

# svc::bootout <name> → idempotent
svc::bootout() {
  local name="$1"
  local target="$DOMAIN/$(svc::label "$name")"
  if svc::is_bootstrapped "$name"; then
    launchctl bootout "$target"
  fi
}

# --- subcommands ------------------------------------------------------------

do_render() {
  [[ $# -eq 1 ]] || die "usage: render <name>"
  svc::declared "$1" || die "no such service in $SVCFILE: $1"
  svc::render_plist "$1"
}

do_start() {
  [[ $# -eq 1 ]] || die "usage: start <name>"
  local name="$1"
  svc::declared "$name" || die "no such service in $SVCFILE: $name"
  svc::ensure_dirs "$name"
  local changed; changed=$(svc::write_plist "$name")
  if [[ "$changed" == "wrote" ]]; then
    # Plist content changed — bootout any existing instance so the new
    # plist actually takes effect on bootstrap.
    svc::bootout "$name"
  fi
  svc::bootstrap "$name"
  log_info "started $(svc::label "$name")"
}

do_stop() {
  [[ $# -eq 1 ]] || die "usage: stop <name>"
  svc::bootout "$1"
  log_info "stopped $(svc::label "$1")"
}

do_restart() {
  [[ $# -eq 1 ]] || die "usage: restart <name>"
  do_stop "$1"
  do_start "$1"
}

do_info() {
  [[ $# -eq 1 ]] || die "usage: info <name>"
  local name="$1"
  svc::declared "$name" || die "no such service in $SVCFILE: $name"
  printf '%s%s%s\n' "$C_BWH" "$(svc::label "$name")" "$C_RES"
  printf '  status:   %s\n' "$(svc::status "$name")"
  printf '  plist:    %s\n' "$(svc::plist_path "$name")"
  printf '  manifest entry:\n'
  svc::toml_json | jq --arg n "$name" '.[$n]' | sed 's/^/    /'
  if svc::is_bootstrapped "$name"; then
    printf '\n  launchctl print:\n'
    launchctl print "$DOMAIN/$(svc::label "$name")" 2>/dev/null | sed 's/^/    /'
  fi
}

# do_list — TSV rows: Service\tStatus\tUser\tFile (Source is prepended
# by the dispatcher).
do_list() {
  local user; user=$(id -un)
  svc::names | while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    printf '%s\t%s\t%s\t%s\n' "$name" "$(svc::status "$name")" "$user" "$(svc::plist_path "$name")"
  done
}

# do_sync — reconcile declared (services.toml) ↔ bootstrapped state.
#   declared, not bootstrapped → write plist + bootstrap
#   declared, plist drifted    → write plist + bootout + bootstrap
#   not declared, plist exists → bootout + rm plist
do_sync() {
  log_info "Syncing launchd services..."

  local -a declared
  declared=( ${(f)"$(svc::names)"} )

  # Apply declared entries
  local name=""
  for name in "${declared[@]}"; do
    [[ -z "$name" ]] && continue
    svc::ensure_dirs "$name"
    local changed; changed=$(svc::write_plist "$name")
    if [[ "$changed" == "wrote" ]] && svc::is_bootstrapped "$name"; then
      svc::bootout "$name"
    fi
    svc::bootstrap "$name" || log_warn "failed to bootstrap $(svc::label "$name")"
  done

  # Remove orphans: any com.system-service.*.plist no longer in TOML.
  local existing="" base="" plist=""
  for plist in "$LAUNCH_AGENTS"/${LABEL_PREFIX}.*.plist(N); do
    base="${plist:t:r}"             # com.system-service.foo
    name="${base#${LABEL_PREFIX}.}"  # foo
    local found=0 d=""
    for d in "${declared[@]}"; do [[ "$d" == "$name" ]] && { found=1; break } done
    (( found )) && continue
    log_info "removing orphan $(svc::label "$name")"
    svc::bootout "$name"
    rm -f "$plist"
  done
}

# do_matching <pkg>
# Internal: print declared service names whose top-level key OR cmd[0]
# basename matches <pkg>. Used by `system-service restart-for` to map an
# upgraded package name back to the services it owns.
do_matching() {
  [[ $# -eq 1 ]] || die "usage: matching <pkg>"
  local pkg="$1"
  svc::toml_json | jq -r --arg p "$pkg" '
    to_entries[]
    | select(
        .key == $p
        or ((.value.cmd[0] // "") | split("/") | .[length-1] == $p)
      )
    | .key'
}

# do_status <name>
# Internal: print the normalized status string. Wrapper around svc::status
# exposed as a subcommand so external callers (system-service) don't have
# to source this script.
do_status() {
  [[ $# -eq 1 ]] || die "usage: status <name>"
  svc::status "$1"
}

case "${1:-}" in
  list)     shift; do_list     "$@" ;;
  start)    shift; do_start    "$@" ;;
  stop)     shift; do_stop     "$@" ;;
  restart)  shift; do_restart  "$@" ;;
  info)     shift; do_info     "$@" ;;
  sync)     shift; do_sync     "$@" ;;
  render)   shift; do_render   "$@" ;;
  declared) shift; svc::names ;;            # internal: used by the dispatcher
  matching) shift; do_matching "$@" ;;     # internal: used by restart-for
  status)   shift; do_status   "$@" ;;     # internal: used by restart-for
  *) die "usage: system-service-launchd {list|start|stop|restart|info|sync|render|declared|matching|status} [args]" ;;
esac
