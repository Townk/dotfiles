#!/usr/bin/env zsh
#
# system-update — Bring all tools managed outside of chezmoi to their
# latest versions, and keep the chezmoi repo in sync across machines.
#
# Idempotent — safe to run periodically. Also called by chezmoi's bootstrap
# (run_once_after_10-setup-bootstrap-tools.sh.tmpl) so that fresh-machine
# setup and "everything-already-installed" applies converge to the same
# end state.
#
# Step order matters on fresh installs: `system-package sync` runs FIRST
# to install everything in the Brewfiles / Uvfile / Npmfile / Gofile;
# only after that do tools like `ya` and `nvim` exist and become safe
# to upgrade. Steady-state runs see the same end state because
# `system-package sync` uses brew bundle's `--upgrade` and the
# uv/npm/go workers re-run their upgrade commands.
#
# When tools rewrite chezmoi-tracked lockfiles (currently just
# yazi's package.toml), this script re-adds them into chezmoi source
# and commits/pushes the bumped state so the next `chezmoi update` on
# another machine reproduces them.

set -eu -o pipefail

usage() {
  cat <<'EOF'
Brings every externally-managed tool to its latest version and keeps the
chezmoi source repo in sync across machines. Idempotent and safe to run
periodically. Also invoked by chezmoi's run_once bootstrap so a fresh
machine converges to the same end state as a steady-state run.

Usage:
  system-update                    run a full update pass
  system-update -h | --help | help show this help

Update order (each step is best-effort; failures are reported but never
block later steps unless explicitly fatal):
  1. git pull --rebase the chezmoi source, then `chezmoi apply`
     (skipped under chezmoi's own run_once to avoid lock contention)
  2. `brew update`            refresh formula metadata
  3. `mise install && mise upgrade && mise prune -y`
                              converge mise-managed toolchains to their
                              declared versions BEFORE the package syncs
  4. `system-package sync`    install/upgrade across every ecosystem,
                              then restart services tied to upgraded
                              packages (see `system-service --help`)
  5. `brew cleanup --prune=all`
  6. `system-service sync`    reconcile launchd plists with services.toml
  7. `ya pkg upgrade --discard`  + commit any package.toml bumps to chezmoi
  8. NeoVim: `Lazy! sync` + `MasonToolsUpdateSync`
  9. Pi: `pi update --extensions` for the cloud + local config homes
 10. `git pull` the zsh plugins in ~/.local/share/zsh/plugins
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help | help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      printf 'error: unknown argument: %s\n' "$1" >&2
      exit 1
      ;;
  esac
  shift
done

# Colors / logging come from the shared base (C_*, log_warn/die).
source "$HOME/.local/lib/common.zsh"

# The Rust XDG migration moved Cargo/Rustup state out of ~/.cargo. Machines that
# had already installed mise-managed Rust can be left with install entries
# symlinked to the old ~/.cargo/bin. Drop only those legacy links after
# MISE_CARGO_HOME has moved; mise will recreate them against the current
# MISE_* homes.
repair_mise_rust_legacy_links() {
  command -v mise >/dev/null 2>&1 || return 0
  [[ "${MISE_CARGO_HOME:-}" != "$HOME/.cargo" ]] || return 0
  local spec dir target repaired=0
  for spec in rust rust@nightly; do
    dir="$(mise where "$spec" 2>/dev/null || true)"
    [[ -n "$dir" && -L "$dir" ]] || continue
    target="$(readlink "$dir" 2>/dev/null || true)"
    [[ "$target" == "$HOME/.cargo/bin" ]] || continue
    rm -f "$dir" || {
      log_warn "could not remove stale mise Rust link: $dir"
      continue
    }
    repaired=1
  done
  ((repaired == 0)) || log_warn "Removed stale mise Rust link(s); reinstalling Rust with current XDG paths."
}

# Re-point the gpgconf pinentry backend at pinentry-mac. `brew upgrade pinentry`
# reverts the `pinentry` → pinentry-mac symlink to pinentry-curses independently
# of any chezmoi-managed source, silently degrading the Touch ID / GUI unlock. We
# inspect the managed symlink directly rather than calling `pinentry-touchid
# -check`: in 0.0.3 that probe never exits (it launches pinentry-mac and blocks on
# the Assuan protocol), which is what froze this script mid-run. Only when the
# symlink points at the wrong backend do we invoke `-fix`, bounded by a timeout
# with stdin closed so a misbehaving pinentry can't wedge the update.
reassert_pinentry_mac_backend() {
  command -v pinentry-touchid >/dev/null 2>&1 || return 0
  local mac link to
  mac="$(command -v pinentry-mac 2>/dev/null || true)"
  [[ -n "$mac" ]] || return 0
  link="$(gpgconf --list-components 2>/dev/null | awk -F: '$1 == "pinentry" { print $3 }' || true)"
  [[ -n "$link" ]] || link="$(brew --prefix 2>/dev/null || echo /opt/homebrew)/opt/pinentry/bin/pinentry"
  [[ "$(realpath "$link" 2>/dev/null || true)" == "$(realpath "$mac" 2>/dev/null || true)" ]] && return 0
  to="$(command -v gtimeout || command -v timeout || true)"
  if [[ -n "$to" ]]; then
    "$to" 20 pinentry-touchid -fix >/dev/null 2>&1 </dev/null || log_warn "pinentry-touchid -fix failed"
  else
    pinentry-touchid -fix >/dev/null 2>&1 </dev/null || log_warn "pinentry-touchid -fix failed"
  fi
}

# Bring the git-cloned zsh plugins to latest. These live in
# ~/.local/share/zsh/plugins (cloned by run_onchange_after_20-setup-zsh-plugins)
# and replace what zsh4humans used to bundle + self-update via `z4h update`.
# Best-effort: a single unreachable remote never blocks the rest of the update.
update_zsh_plugins() {
  local dir="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins"
  [[ -d "$dir" ]] || return 0
  print -P -- "\n🔌 Update zsh plugins...\n"
  local p
  for p in "$dir"/*(/N); do
    [[ -d "$p/.git" ]] || continue
    git -C "$p" pull --ff-only --recurse-submodules --quiet \
      || log_warn "zsh plugin update failed: ${p:t}"
  done
}

# Update Pi coding-agent extensions for both config homes — the cloud default
# (~/.pi/agent) and the local 32K home (~/.pi/agent-local, normally reached via
# the `pi-local` shell function; that function isn't loaded in this script, so
# we set PI_CODING_AGENT_DIR directly, exactly as the launcher does). This
# mirrors the NeoVim/Yazi "update the app's managed packages" steps. The pi
# BINARY itself is updated by the npm worker in `system-package sync` (Npmfile
# lists @earendil-works/pi-coding-agent), so we scope to --extensions only.
# Best-effort: a network hiccup updating extensions never blocks the rest.
update_pi_extensions() {
  command -v pi >/dev/null 2>&1 || return 0
  print -P -- "\n🥧 Upgrade Pi extensions...\n"
  pi update --extensions || log_warn "pi extension upgrade (cloud home) had failures"
  if [[ -d "$HOME/.pi/agent-local" ]]; then
    PI_CODING_AGENT_DIR="$HOME/.pi/agent-local" pi update --extensions \
      || log_warn "pi extension upgrade (local home) had failures"
  fi
}

# Wrap up a successful run. The interactive zsh wrapper owns any parent-shell
# refresh (`exec zsh`); this external script must always return to its caller.
finalize_session() {
  print -P -- "\n👍 System updated ${C_BWH}successfully${C_RES}!\n"
}

# Resolve chezmoi source dir once. Returns "" only when neither chezmoi
# nor the standard layout produces a git repo (so the sync hooks no-op
# safely on truly-unmanaged machines).
#
# We try `chezmoi source-path` first, but DON'T trust it as the sole
# signal — when the config template has changed (a `chezmoi init` is
# pending), the command may exit non-zero or smear warnings into its
# output, leaving `_path` empty or invalid. Past incident: the new
# yazi cp+commit block was silently skipped under exactly that
# condition. Fallback to `$HOME/.local/share/chezmoi` (chezmoi's
# default source dir on macOS/Linux) keeps the script working through
# stale-config windows.
chezmoi_repo=""
_default_src="$HOME/.local/share/chezmoi"
if command -v chezmoi >/dev/null 2>&1; then
  _path=$(chezmoi source-path 2>/dev/null || true)
  if [[ -n "$_path" && -d "${_path}/.git" ]]; then
    chezmoi_repo="$_path"
  elif [[ -d "${_default_src}/.git" ]]; then
    chezmoi_repo="$_default_src"
  fi
fi

# Detect re-entrancy: when this script is invoked from a chezmoi run_once
# script, CHEZMOI=1 is set in the env. In that case we skip the pull/apply
# (would deadlock on chezmoi's own lock) and the push (the source state
# is whatever chezmoi just deployed — nothing to publish yet).
running_under_chezmoi=0
[[ -n "${CHEZMOI:-}" ]] && running_under_chezmoi=1

print -P -- "\n${C_BLU}System Update\n-------------${C_RES}"

# Fetch latest chezmoi source and apply, so cross-machine updates (e.g.
# another machine bumped a tracked lockfile) land BEFORE the package syncs
# decide what to install.
#
# Do not auto-rebase here: this repo commonly carries local commits/merges
# before they are pushed. `git pull --rebase` would flatten merge commits and
# can replay already-merged profile branches, reintroducing conflicts during a
# routine system update.
if [[ -n "$chezmoi_repo" && "$running_under_chezmoi" -eq 0 ]]; then
  print -P -- "\n📥 Sync chezmoi source from origin...\n"
  _pre_rev=$(git -C "$chezmoi_repo" rev-parse HEAD 2>/dev/null || true)
  if (
    cd "$chezmoi_repo" || exit 1

    branch=$(git branch --show-current)
    remote=$(git config --get "branch.${branch}.remote" || true)
    upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
    if [[ -z "$remote" || -z "$upstream" ]]; then
      print -P -- "No upstream configured for ${branch}; skipping source sync." >&2
      exit 0
    fi

    git fetch --prune "$remote" || exit 1

    local_rev=$(git rev-parse HEAD)
    upstream_rev=$(git rev-parse "$upstream")
    base_rev=$(git merge-base HEAD "$upstream")

    if [[ "$local_rev" == "$upstream_rev" ]]; then
      exit 0
    elif [[ "$base_rev" == "$local_rev" ]]; then
      git merge --ff-only "$upstream"
    elif [[ "$base_rev" == "$upstream_rev" ]]; then
      print -P -- "chezmoi source is ahead of ${upstream}; skipping pull/rebase."
      exit 0
    else
      print -P -- "chezmoi source has diverged from ${upstream}; resolve manually." >&2
      exit 1
    fi
  ); then
    chezmoi apply || log_warn "chezmoi apply failed after pull (continuing)"

    # Hand off to the freshly-applied script when the source actually
    # advanced. A running shell keeps executing the code it loaded at
    # startup, so a fix in the just-pulled version (this re-exec included)
    # would otherwise only take effect on the NEXT invocation — the trap
    # where an already-running update can't benefit from its own pull. Re-exec
    # the canonical applied path so the REST of this run uses current code.
    # SYSTEM_UPDATE_REEXECED guards against an exec loop (the re-run finds
    # itself up-to-date, but the sentinel makes that unconditional).
    _post_rev=$(git -C "$chezmoi_repo" rev-parse HEAD 2>/dev/null || true)
    if [[ -z "${SYSTEM_UPDATE_REEXECED:-}" && -n "$_pre_rev" && -n "$_post_rev" &&
      "$_pre_rev" != "$_post_rev" ]]; then
      print -P -- "\n♻️  Source advanced (${_pre_rev} → ${_post_rev}); re-running updated system-update...\n"
      export SYSTEM_UPDATE_REEXECED=1
      exec "$HOME/.local/bin/system-update"
    fi
  else
    log_warn "Failed to sync chezmoi source from origin (continuing)"
  fi
fi

# Homebrew-less hosts (e.g. the Linux dev-shell profile) have no brew /
# Brewfile pipeline. Converge the package ecosystems rendered for this
# host, then skip the brew/launchd-specific steps.
if ! command -v brew >/dev/null 2>&1; then
  log_warn "Homebrew not found — running the Homebrew-less update path."
  system_package_synced=0
  if command -v mise >/dev/null 2>&1; then
    print -P -- "\n🛠️ Sync Mise tools...\n"
    repair_mise_rust_legacy_links
    # install first so a declared-but-missing toolchain (e.g. `go`, needed by
    # the package workers below) exists before `system-package sync` runs.
    mise install && mise upgrade && mise prune -y || log_warn "mise sync had failures"
  fi
  if command -v system-package >/dev/null 2>&1; then
    print -P -- "\n📦 Sync system packages...\n"
    system-package sync || die "Failed to sync system packages!"
    system_package_synced=1
  fi
  if [[ "$system_package_synced" -ne 1 ]] && command -v snap >/dev/null 2>&1; then
    print -P -- "\n📦 Refresh snap packages...\n"
    sudo snap refresh || log_warn "snap refresh had failures"
  fi
  if command -v nvim >/dev/null 2>&1; then
    print -P -- "\n📝 Upgrade NeoVim plugins...\n"
    # Bounded with `timeout`: headless plugin sync can hang indefinitely
    # if a background task (e.g. a treesitter parser build) never settles.
    timeout 300 nvim --headless "+Lazy! sync" "+Lazy load mason-tool-installer.nvim" "+MasonToolsUpdateSync" "+quitall" ||
      log_warn "NeoVim plugin upgrade timed out or had failures"
  fi
  update_pi_extensions
  update_zsh_plugins
  finalize_session
  exit 0
fi

print -P -- "\n  Updating Homebrew sources...\n"
brew update || die "Failed to update Homebrew!"

# Converge mise-managed toolchains BEFORE the package syncs, for two reasons:
#   1. Package workers shell out to tools mise provides (e.g. the Go worker
#      needs `go` on PATH), so those must exist before `system-package sync`
#      runs — otherwise the worker dies with "command not found".
#   2. `mise upgrade`/`prune` must run BEFORE globals are laid down. mise-managed
#      node stores npm globals under a version-pinned prefix
#      (~/.local/share/mise/installs/node/<VERSION>/lib/node_modules) with no
#      shared store across versions. Upgrading node after the npm sync would
#      activate a fresh, empty prefix — silently orphaning every npm global
#      the sync just installed (recovered only by re-running `system-package
#      npm sync`). `mise install` only adds declared-but-missing tools (a no-op
#      when all present); `mise upgrade` bumps versions and `prune` drops the
#      now-orphaned old installs. Doing all three here means the npm worker
#      installs globals into the prefix that will actually remain active.
if command -v mise >/dev/null 2>&1; then
  print -P -- "\n🛠️ Converging mise toolchains...\n"
  repair_mise_rust_legacy_links
  mise install || log_warn "mise install had failures"
  mise upgrade || log_warn "mise upgrade had failures"
  mise prune -y || log_warn "mise prune had failures"
fi

# Install/upgrade declared packages across every ecosystem. This is the
# only step that turns a fresh machine into a populated one. Everything
# below assumes the binaries it touches now exist on PATH.
print -P -- "\n📦 Sync system packages...\n"
system-package sync || die "Failed to sync system packages!"

print -P -- "\n🧹 Cleaning up Homebrew artifacts...\n"
brew cleanup -q --prune=all || die "Failed to clean up Homebrew files!"

# Re-assert pinentry-touchid's pinentry-mac backend after `system-package sync`
# may have run `brew upgrade pinentry`, which reverts the gpgconf `pinentry`
# symlink to pinentry-curses. See reassert_pinentry_mac_backend for why we probe
# the symlink directly instead of `pinentry-touchid -check`.
#
# SKIP over SSH: the repair only matters for a LOCAL Touch ID / GUI session, and
# keeping it off remote/notty runs avoids any chance of a pinentry GUI on a
# headless desktop. Leave it to the next interactive run.
if [[ -z "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ]]; then
  reassert_pinentry_mac_backend
fi

# Reconcile launchd-managed services with ~/.config/packages/services.toml.
# Soft failure — a misconfigured service shouldn't block the rest of
# system-update. Note: services tied to packages just upgraded by the
# preceding `system-package sync` have already been restarted by the
# worker that owns them (see pkg::restart_services_for in common.zsh).
if command -v system-service >/dev/null 2>&1; then
  print -P -- "\n📡 Sync system services...\n"
  system-service sync || log_warn "system-service sync had failures"
fi

if command -v ya >/dev/null 2>&1; then
  print -P -- "\n🦆 Upgrade Yazi plugins...\n"
  # --discard: drop any local edits inside cloned plugin dirs before pulling,
  # so stray dirt (e.g. a plugin that wrote a cache/log into its own tree)
  # can't make `ya pkg upgrade` fail mid-update and block everything after it.
  ya pkg upgrade --discard || die "Failed to upgrade Yazi plugins!"

  # Capture any rev/hash bumps `ya pkg upgrade` just wrote into the
  # live package.toml back into the chezmoi source, then commit and
  # push as the very next step so the bump never lingers as drift.
  #
  # Implementation note: we `cp` directly into the source rather than
  # calling `chezmoi re-add` because re-add takes chezmoi's apply
  # lock — and when this script is invoked from chezmoi's own
  # run_once bootstrap, that lock is already held by the parent
  # process. Pre-fix, the nested chezmoi call failed, the
  # `2>/dev/null` swallowed the error, and the warn scrolled by in
  # the bootstrap noise; the source silently drifted. `cp` bypasses
  # chezmoi entirely. The dot_*/package.toml mapping is 1:1 because
  # the file is non-encrypted and non-templated, so a plain copy is
  # equivalent to what re-add would write.
  yazi_pkg_target="$HOME/.config/yazi/package.toml"
  # Honor .chezmoiroot: when present, the source tree is rooted at that
  # subdir (here "home/"), so the file lives at <root>/dot_config/... .
  # Hardcoding "dot_config/..." pointed cp at a directory that doesn't
  # exist and the copy silently failed.
  yazi_pkg_source_rel="dot_config/yazi/package.toml"
  if [[ -f "$chezmoi_repo/.chezmoiroot" ]]; then
    yazi_pkg_source_rel="$(<"$chezmoi_repo/.chezmoiroot")/$yazi_pkg_source_rel"
  fi
  if [[ -n "$chezmoi_repo" && -f "$yazi_pkg_target" ]]; then
    if cp "$yazi_pkg_target" "$chezmoi_repo/$yazi_pkg_source_rel"; then
      (
        cd "$chezmoi_repo"
        if ! git diff --quiet HEAD -- "$yazi_pkg_source_rel" 2>/dev/null; then
          print -P -- "\n📤 Publishing yazi package state...\n"
          git commit -m "chore(yazi): update dependencies" -- "$yazi_pkg_source_rel" ||
            log_warn "Failed to commit yazi/package.toml"
          git push 2>/dev/null || log_warn "Push failed (commit kept locally)"
        fi
      )
    else
      log_warn "Failed to copy yazi/package.toml into chezmoi source"
    fi
  fi
fi

if command -v nvim >/dev/null 2>&1; then
  print -P -- "\n📝 Upgrade NeoVim plugins...\n"
  # Bounded with `timeout`: headless plugin sync can hang indefinitely
  # if a background task (e.g. a treesitter parser build) never settles.
  timeout 300 nvim --headless "+Lazy! sync" "+Lazy load mason-tool-installer.nvim" "+MasonToolsUpdateSync" "+quitall" ||
    log_warn "NeoVim plugin upgrade timed out or had failures"
fi

update_pi_extensions
update_zsh_plugins
finalize_session
