#!/usr/bin/env zsh
#
# system-update — Bring all tools managed outside of chezmoi to their
# latest versions, and keep the chezmoi repo in sync across machines.
#
# Idempotent — safe to run periodically. Also called by chezmoi's bootstrap
# (run_once_after_10-setup-bootstrap-tools.sh.tmpl) so that fresh-machine
# setup and "everything-already-installed" applies converge to the same
# end state.
#
# Step order matters on fresh installs: `system-package sync` runs FIRST
# to install everything in the Brewfiles / Uvfile / Npmfile / Gofile;
# only after that do tools like `ya` and `nvim` exist and become safe
# to upgrade. Steady-state runs see the same end state because
# `system-package sync` uses brew bundle's `--upgrade` and the
# uv/npm/go workers re-run their upgrade commands.
#
# When tools rewrite chezmoi-tracked lockfiles (currently just
# yazi's package.toml), this script re-adds them into chezmoi source
# and commits/pushes the bumped state so the next `chezmoi update` on
# another machine reproduces them.

set -eu -o pipefail

usage() {
  cat <<'EOF'
Brings every externally-managed tool to its latest version and keeps the
chezmoi source repo in sync across machines. Idempotent and safe to run
periodically. Also invoked by chezmoi's run_once bootstrap so a fresh
machine converges to the same end state as a steady-state run.

Usage:
  system-update                    run a full update pass
  system-update -v | --verbose     show each tool's own output
  system-update -h | --help | help show this help

By default the steps this script drives directly (mise, Yazi, NeoVim, Pi)
run quiet behind a spinner and report what actually changed, measured from
before/after snapshots rather than from the tools' own prose. --verbose
streams their raw output instead, and is forwarded to `system-package sync`.

Update order (each step is best-effort; failures are reported but never
block later steps unless explicitly fatal):
  1. git pull --rebase the chezmoi source, then `chezmoi apply`
     (skipped under chezmoi's own run_once to avoid lock contention)
  2. `brew update`            refresh formula metadata
  3. `mise install && mise upgrade && mise prune -y`
                              converge mise-managed toolchains to their
                              declared versions BEFORE the package syncs
  4. `system-package sync`    install/upgrade across every ecosystem,
                              then restart services tied to upgraded
                              packages (see `system-service --help`)
  5. `brew cleanup --prune=all`
  6. `system-service sync`    reconcile services with services.toml (launchd/systemd)
  7. `ya pkg upgrade --discard`  + commit any package.toml bumps to chezmoi
  8. NeoVim: `Lazy! sync` + `MasonToolsUpdateSync`
  9. Pi: `pi update --extensions` for the cloud + local config homes
 10. `git pull` the zsh plugins in ~/.local/share/zsh/plugins
EOF
}

VERBOSE=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help | help)
      usage
      exit 0
      ;;
    -v | --verbose)
      VERBOSE=1
      ;;
    *)
      usage >&2
      printf 'error: unknown argument: %s\n' "$1" >&2
      exit 1
      ;;
  esac
  shift
done

# Colors / logging come from the shared base (C_*, log_warn/die).
source "$HOME/.local/lib/common.zsh"
# Canonical remote detection (mux::is_remote): the dependency-free mux layer.
source "$HOME/.local/lib/mux-bootstrap.zsh"

# Flags forwarded to `system-package sync`, so one --verbose covers the whole
# run rather than only the steps this script drives itself.
sync_flags=()
((VERBOSE)) && sync_flags=(--verbose)

# run_step <title> <cmd...>
# Run one directly-driven update step: quiet behind a spinner by default (the
# per-step report says what moved), streamed raw under --verbose. Mirrors
# pkg::run_tool in the package workers.
run_step() {
  if ((VERBOSE)); then
    spin::streamed "$@"
  else
    spin::quiet "$@"
  fi
}

# _sudo_has_askpass
# Whether sudo has a helper to ask through, which decides whether the password
# below is typed at this terminal or answered in the float.
#
# The variable alone is not the test. It is exported only where the helper is
# built, but it can also be inherited from a session that set it for a machine
# this one is not — and a helper that is not there fails closed, with nothing
# underneath it. Naming the file, not the variable, is the same lesson the
# askpass exports learned the hard way.
_sudo_has_askpass() {
  [[ -n "${SUDO_ASKPASS:-}" && -x "${SUDO_ASKPASS}" ]]
}

# preauthorize_sudo
# Take the sudo password ONCE, here, where the prompt is legible — then hold the
# timestamp for the rest of the run.
#
# The steps below shell out to sudo from deep inside a spinner: `chezmoi apply`
# writes /etc/pam.d/sudo_local, and Homebrew's cask upgrades run `launchctl` as
# root. sudo asks on the terminal device rather than on the captured streams, so
# down there the ask is repainted over within 100ms and the run just sits
# there. spin::stream now notices and stands down, but that is the safety net;
# this is the fix.
#
# Best-effort throughout. Nothing here is required for the run to work — a
# declined or impossible authorization only means the later sudo asks for
# itself, exactly as it does today.
preauthorize_sudo() {
  command -v sudo >/dev/null 2>&1 || return 0

  # Which surface, asked fresh from the presence helper rather than read
  # from this shell's SSH markers — a pane outlives the attach that set
  # them, and a stale marker here is exactly how this prompt once landed in
  # a mux float while the user sat at the keyboard (docs/superpowers/specs/
  # 2026-08-31-presence-aware-pinentry-design.md).
  #
  # Present: the stale markers are UNSET for the WHOLE RUN, not dodged for
  # one call — and unconditionally, not only when a prompt is needed,
  # because the run's children read them on their own schedule: Homebrew
  # adds `sudo -A` purely because SUDO_ASKPASS exists in its environment
  # (system_command.rb, measured the night a cask upgrade floated a prompt
  # past a user sitting at the keyboard), pam_reattach's ignore_ssh keys
  # off the SSH triple, git and ssh reach for their askpass variables the
  # same way, and sec::op_use_service reads the triple to pick service
  # mode. Scrubbed, every one of them lands on the surface the human is
  # actually at, and a mid-run re-auth (brew invalidates timestamps) is a
  # Touch ID tap at the desk instead of a float.
  local lane=""
  [[ -x "$HOME/.local/libexec/presence" ]] &&
    lane="$("$HOME/.local/libexec/presence" 2>/dev/null)"
  case "$lane" in
    touchid | gui | vnc)
      unset SUDO_ASKPASS GIT_ASKPASS SSH_ASKPASS SSH_ASKPASS_REQUIRE \
        SSH_TTY SSH_CONNECTION SSH_CLIENT
      ;;
    remote)
      [[ -x "$HOME/.local/libexec/askpass-auto" ]] &&
        export SUDO_ASKPASS="${SUDO_ASKPASS:-$HOME/.local/libexec/askpass-auto}"
      ;;
  esac

  # Already authorized (or passwordless): nothing to ask, just hold it.
  if ! sudo -n true 2>/dev/null; then
    # No terminal to ask on (cron, the launchd agent, a chezmoi run_once with
    # stdin closed). Prompting is impossible, so don't try.
    [[ -t 0 ]] || return 0
    # Present: pam_tid answers the plain `sudo -v` with Touch ID — the
    # scrub above is what lets pam_reattach do its job — or, without a
    # sensor, the password is typed right here where the prompt is legible.
    #
    # Remote (and the helper-missing fallback, which is the pre-presence
    # behavior verbatim): through the same dialog as every other password. A
    # plain `sudo -v` ignores SUDO_ASKPASS entirely — measured, with a
    # terminal and without — so reaching the float takes an explicit -A. The
    # gate above stays as it was: an unattended run must not stall on a
    # prompt nobody is there to answer, whichever surface it would appear on.
    local -a ask=()
    if [[ "$lane" == (touchid|gui|vnc) ]]; then
      log_info "Authorizing sudo up front — Touch ID, or the prompt below..."
    elif _sudo_has_askpass; then
      ask=(-A)
      log_info "Authorizing sudo up front — answer the floating prompt..."
    else
      log_info "Authorizing sudo up front, so nothing stalls behind a spinner later..."
    fi
    sudo "${ask[@]}" -v || { log_warn "sudo not authorized; steps that need it will ask on their own"; return 0 }
  fi
  # sudo forgets the timestamp after timestamp_timeout (5 minutes by default),
  # and a full run outlasts that many times over. Refresh well inside the
  # window. `kill -0 $$` — $$ stays the PARENT's pid inside a subshell — bounds
  # the keeper's life to the run's, so it needs no trap to be torn down, and it
  # gives up the moment the timestamp stops being renewable (e.g. `sudo -k`).
  ( while kill -0 $$ 2>/dev/null; do sudo -n true 2>/dev/null || break; sleep 30; done ) &!
}

# snapshot_mise / snapshot_yazi / snapshot_nvim / snapshot_pi
# "name<TAB>version" TSV for report::changes. Each is cheap enough (tens of
# milliseconds) to run twice per step. All are best-effort: a missing tool
# yields an empty snapshot, which reports as "nothing changed" rather than
# failing the update.
# step_snapshot <snapshot_fn>
# Take a "before" snapshot into a temp file and print its path. Snapshot
# failures are swallowed: an empty before-file makes report::changes treat
# everything as newly installed, which is noisy but never wrong, whereas
# aborting the update over a failed status query would be.
step_snapshot() {
  local f
  f=$(common::tmpfile)
  "$1" >"$f" 2>/dev/null || true
  print -r -- "$f"
}

# step_report <before_file> <snapshot_fn> <singular_noun>
# Take the matching "after" snapshot, report what moved, and clean up.
step_report() {
  local before="$1" fn="$2" noun="$3" after
  after=$(common::tmpfile)
  "$fn" >"$after" 2>/dev/null || true
  report::changes "$before" "$after" "$noun"
  rm -f "$before" "$after"
}

snapshot_mise() {
  # mise prints one row per installed VERSION, and a tool legitimately carries
  # several at once (python 3.9 / 3.12 / 3.14). report::changes keys its map on
  # the first field, so duplicate names would keep only the last version and
  # misreport every other one as a change — identical snapshots would claim
  # "python 3.14.6 → 3.9.25". Collapse to one row per tool so the key is unique
  # and the tool tally stays a count of tools.
  # Bracket only the multi-version tools: "rust nightly, 1.97.1 → 1.97.1" reads
  # as a no-op change, while "rust [nightly, 1.97.1] → [1.97.1]" shows a version
  # being dropped. Single-version tools stay bare, which is nearly all of them.
  mise ls --installed 2>/dev/null |
    awk 'NF >= 2 { v[$1] = ($1 in v) ? v[$1] ", " $2 : $2; n[$1]++ }
         END { for (t in v) print t "\t" (n[t] > 1 ? "[" v[t] "]" : v[t]) }'
}

snapshot_yazi() {
  # `ya pkg list` prints "  owner/repo:plugin (hash)" under Plugins:/Flavors:
  # headers; keep the indented entries and split name from hash.
  ya pkg list 2>/dev/null |
    awk '/^\t| {2,}/ { gsub(/^[ \t]+/, ""); if (match($0, /\(([^)]+)\)$/)) {
           hash = substr($0, RSTART + 1, RLENGTH - 2)
           name = $1
           print name "\t" hash
         } }'
}

snapshot_zsh_plugins() {
  local dir="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins" p
  [[ -d "$dir" ]] || return 0
  for p in "$dir"/*(/N); do
    [[ -d "$p/.git" ]] || continue
    printf '%s\t%s\n' "${p:t}" \
      "$(git -C "$p" rev-parse --short HEAD 2>/dev/null || print '?')"
  done
}

snapshot_nvim() {
  local lock="$HOME/.config/nvim/lazy-lock.json"
  [[ -f "$lock" ]] || return 0
  jq -r 'to_entries[] | "\(.key)\t\(.value.commit // .value.version // "?")"' \
    "$lock" 2>/dev/null || true
}

snapshot_pi() {
  # `pi list` alternates "  npm:<name>" with the install path on the next line;
  # the version lives in that directory's package.json.
  #
  # NB: the loop variable must NOT be named `path` — in zsh that is the array
  # tied to $PATH, so reading a directory into it wipes the command search path
  # for the rest of the function (awk/jq stop resolving).
  local home_dir="${1:-}" pkg_dir
  {
    if [[ -n "$home_dir" ]]; then
      PI_CODING_AGENT_DIR="$home_dir" timeout 30 pi list </dev/null 2>/dev/null
    else
      timeout 30 pi list </dev/null 2>/dev/null
    fi
  } |
    awk '/^ +\// { print $1 }' |
    while IFS= read -r pkg_dir; do
      [[ -f "$pkg_dir/package.json" ]] || continue
      # Everything after node_modules/, so a scoped package keeps its @scope.
      printf '%s\t%s\n' "${pkg_dir#*/node_modules/}" \
        "$(jq -r '.version // "?"' "$pkg_dir/package.json" 2>/dev/null)"
    done
  return 0
}

# The Rust XDG migration moved Cargo/Rustup state out of ~/.cargo. Machines that
# had already installed mise-managed Rust can be left with install entries
# symlinked to the old ~/.cargo/bin. Drop only those legacy links after
# MISE_CARGO_HOME has moved; mise will recreate them against the current
# MISE_* homes.
repair_mise_rust_legacy_links() {
  command -v mise >/dev/null 2>&1 || return 0
  [[ "${MISE_CARGO_HOME:-}" != "$HOME/.cargo" ]] || return 0
  local spec dir target repaired=0
  for spec in rust rust@nightly; do
    dir="$(mise where "$spec" 2>/dev/null || true)"
    [[ -n "$dir" && -L "$dir" ]] || continue
    target="$(readlink "$dir" 2>/dev/null || true)"
    [[ "$target" == "$HOME/.cargo/bin" ]] || continue
    rm -f "$dir" || {
      log_warn "could not remove stale mise Rust link: $dir"
      continue
    }
    repaired=1
  done
  ((repaired == 0)) || log_warn "Removed stale mise Rust link(s); reinstalling Rust with current XDG paths."
}

# Re-sync mise-managed environment after `mise upgrade` + `mise prune`. The
# shell that launched this run exported version-pinned values at prompt time
# (GOROOT/GOBIN, JAVA_HOME, KOTLIN_HOME, LUA_INIT, RUSTUP_TOOLCHAIN, plus
# install-dir PATH entries), and the converge step may have just deleted the
# dirs those point at. Children that read them directly then die against a
# pruned toolchain — e.g. the Go package worker invokes "$GOROOT/bin/go"
# WITHOUT the shim that would re-resolve the env per invocation, so an
# inherited GOROOT pointing into the pruned go install fails every install
# with "go: cannot find GOROOT directory". hook-env is the same re-sync
# `mise activate` performs at every prompt: export the versions that exist
# NOW, unset what no longer does, and drop pruned dirs from PATH.
refresh_mise_env() {
  command -v mise >/dev/null 2>&1 || return 0
  eval "$(mise hook-env -s zsh 2>/dev/null)" || true
}

# Re-point the gpgconf pinentry backend at pinentry-mac. `brew upgrade pinentry`
# reverts the `pinentry` → pinentry-mac symlink to pinentry-curses independently
# of any chezmoi-managed source, silently degrading the Touch ID / GUI unlock. We
# inspect the managed symlink directly rather than calling `pinentry-touchid
# -check`: in 0.0.3 that probe never exits (it launches pinentry-mac and blocks on
# the Assuan protocol), which is what froze this script mid-run. Only when the
# symlink points at the wrong backend do we invoke `-fix`, bounded by a timeout
# with stdin closed so a misbehaving pinentry can't wedge the update.
reassert_pinentry_mac_backend() {
  command -v pinentry-touchid >/dev/null 2>&1 || return 0
  local mac link to
  mac="$(command -v pinentry-mac 2>/dev/null || true)"
  [[ -n "$mac" ]] || return 0
  link="$(gpgconf --list-components 2>/dev/null | awk -F: '$1 == "pinentry" { print $3 }' || true)"
  [[ -n "$link" ]] || link="$(brew --prefix 2>/dev/null || echo /opt/homebrew)/opt/pinentry/bin/pinentry"
  [[ "$(realpath "$link" 2>/dev/null || true)" == "$(realpath "$mac" 2>/dev/null || true)" ]] && return 0
  to="$(command -v gtimeout || command -v timeout || true)"
  if [[ -n "$to" ]]; then
    "$to" 20 pinentry-touchid -fix >/dev/null 2>&1 </dev/null || log_warn "pinentry-touchid -fix failed"
  else
    pinentry-touchid -fix >/dev/null 2>&1 </dev/null || log_warn "pinentry-touchid -fix failed"
  fi
  # Verify the repair actually took: `-fix` can exit 0 without re-pointing the
  # symlink, and fire-and-forget surfaced that only as a future curses prompt
  # (or a blocked signed commit). Same re-check run_after_26 already does.
  link="$(gpgconf --list-components 2>/dev/null | awk -F: '$1 == "pinentry" { print $3 }' || true)"
  [[ -n "$link" ]] || link="$(brew --prefix 2>/dev/null || echo /opt/homebrew)/opt/pinentry/bin/pinentry"
  if [[ "$(realpath "$link" 2>/dev/null || true)" == "$(realpath "$mac" 2>/dev/null || true)" ]]; then
    log_info "pinentry backend repaired -> pinentry-mac"
  else
    log_warn "pinentry backend still not pinentry-mac after -fix; run 'pinentry-touchid -fix' manually"
  fi
}

# Bring the git-cloned zsh plugins to latest. These live in
# ~/.local/share/zsh/plugins (cloned by run_onchange_after_20-setup-zsh-plugins)
# and replace what zsh4humans used to bundle + self-update via `z4h update`.
# Best-effort: a single unreachable remote never blocks the rest of the update.
update_zsh_plugins() {
  local dir="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins"
  [[ -d "$dir" ]] || return 0
  print -P -- "\n🔌 Update zsh plugins...\n"
  # Each --quiet pull is a silent ~0.6s network round-trip, so the whole loop
  # is several seconds of dead air. Head commits are the snapshot, so the
  # report names the plugins that actually moved. --verbose drops --quiet and
  # lets git narrate instead.
  local before p
  local -a git_quiet=(--quiet)
  ((VERBOSE)) && git_quiet=()
  before=$(step_snapshot snapshot_zsh_plugins)
  for p in "$dir"/*(/N); do
    [[ -d "$p/.git" ]] || continue
    run_step "zsh: ${p:t}" \
      git -C "$p" pull --ff-only --recurse-submodules "${git_quiet[@]}" \
      || log_warn "zsh plugin update failed: ${p:t}"
  done
  step_report "$before" snapshot_zsh_plugins plugin
}

# Update Pi coding-agent extensions for both config homes — the cloud default
# (~/.pi/agent) and the local 32K home (~/.pi/agent-local, normally reached via
# the `pi-local` shell function; that function isn't loaded in this script, so
# we set PI_CODING_AGENT_DIR directly, exactly as the launcher does). This
# mirrors the NeoVim/Yazi "update the app's managed packages" steps. The pi
# BINARY itself is updated by the npm worker in `system-package sync` (Npmfile
# lists @earendil-works/pi-coding-agent), so we scope to --extensions only.
# Best-effort: a network hiccup updating extensions never blocks the rest.
update_pi_extensions() {
  command -v pi >/dev/null 2>&1 || return 0
  print -P -- "\n🥧 Upgrade Pi extensions...\n"
  local before
  before=$(step_snapshot snapshot_pi)
  run_step "pi: upgrading extensions (cloud home)" pi update --extensions \
    || log_warn "pi extension upgrade (cloud home) had failures"
  step_report "$before" snapshot_pi extension
  if [[ -d "$HOME/.pi/agent-local" ]]; then
    before=$(step_snapshot snapshot_pi_local)
    run_step "pi: upgrading extensions (local home)" \
      env PI_CODING_AGENT_DIR="$HOME/.pi/agent-local" pi update --extensions \
      || log_warn "pi extension upgrade (local home) had failures"
    step_report "$before" snapshot_pi_local extension
  fi
}

# snapshot_pi bound to the local config home, so step_report can call it with
# the single-argument signature it expects.
snapshot_pi_local() {
  snapshot_pi "$HOME/.pi/agent-local"
}

# Wrap up a successful run. The interactive zsh wrapper owns any parent-shell
# refresh (`exec zsh`); this external script must always return to its caller.
finalize_session() {
  # When this run was started by the bootstrap inside an outer system-update's
  # `chezmoi apply`, tell the waiting outer process that full convergence is
  # already complete. The outer process can then return instead of repeating
  # this entire update pass.
  if [[ -n "${SYSTEM_UPDATE_HANDOFF_FILE:-}" ]]; then
    print -r -- complete >"$SYSTEM_UPDATE_HANDOFF_FILE"
  fi
  print -P -- "\n👍 System updated ${C_BWH}successfully${C_RES}!\n"
}

# publish_yazi_bump <repo> <source_rel> <target>
# Copy the live yazi package.toml back into the chezmoi source, commit just
# that file, and publish the bump so the next `chezmoi update` on another
# machine reproduces it. Extracted from the inline Yazi step so its push
# gating is unit-testable against a throwaway repo (SYSTEM_UPDATE_NO_RUN).
publish_yazi_bump() {
  local repo="$1" source_rel="$2" target="$3"
  [[ -n "$repo" && -f "$target" ]] || return 0
  if ! cp "$target" "$repo/$source_rel"; then
    log_warn "Failed to copy yazi/package.toml into chezmoi source"
    return 0
  fi
  (
    cd "$repo" || exit 0
    # Nothing changed vs HEAD → no bump to publish.
    if git diff --quiet HEAD -- "$source_rel" 2>/dev/null; then
      exit 0
    fi
    print -P -- "\n📤 Publishing yazi package state...\n"
    git commit -m "chore(yazi): update dependencies" -- "$source_rel" ||
      log_warn "Failed to commit yazi/package.toml"
    # Gate the push on ahead-count. A bare `git push` (push.default=simple)
    # publishes the WHOLE branch, and this repo commonly carries unrelated
    # local commits/merges before they're pushed (see the source-sync note
    # above): a routine yazi bump would drag them all upstream. Only auto-push
    # when the just-made bump is the sole unpushed commit; otherwise keep
    # everything local and say so. `rev-list --count @{upstream}..HEAD` needs a
    # configured upstream — on a branch without one it exits non-zero, so we
    # fall through to the guarded push (which no-ops or warns as before).
    local ahead
    ahead=$(git rev-list --count '@{upstream}..HEAD' 2>/dev/null || true)
    if [[ -n "$ahead" ]] && ((ahead > 1)); then
      log_warn "commit kept locally; ${ahead} unpushed commits, not auto-pushing"
      exit 0
    fi
    git push 2>/dev/null || log_warn "Push failed (commit kept locally)"
  )
}

# SYSTEM_UPDATE_NO_RUN (test-only escape hatch, same convention as
# SYSTEM_ONBOARD_NO_RUN / PICK_CLIPBOARD_NO_RUN): a test harness sources this
# file with it set so it can call helpers like publish_yazi_bump directly,
# without the main update body running (no brew, mise, git pull, or push of the
# real repo). Every helper above is already defined; the main body follows.
# `return` unwinds a sourced file; `exit` covers running the script directly.
if [[ -n "${SYSTEM_UPDATE_NO_RUN:-}" ]]; then
  return 0 2>/dev/null || exit 0
fi

# Resolve chezmoi source dir once. Returns "" only when neither chezmoi
# nor the standard layout produces a git repo (so the sync hooks no-op
# safely on truly-unmanaged machines).
#
# We try `chezmoi source-path` first, but DON'T trust it as the sole
# signal — when the config template has changed (a `chezmoi init` is
# pending), the command may exit non-zero or smear warnings into its
# output, leaving `_path` empty or invalid. Past incident: the new
# yazi cp+commit block was silently skipped under exactly that
# condition. Fallback to `$HOME/.local/share/chezmoi` (chezmoi's
# default source dir on macOS/Linux) keeps the script working through
# stale-config windows.
chezmoi_repo=""
_default_src="$HOME/.local/share/chezmoi"
if command -v chezmoi >/dev/null 2>&1; then
  _path=$(chezmoi source-path 2>/dev/null || true)
  if [[ -n "$_path" && -d "${_path}/.git" ]]; then
    chezmoi_repo="$_path"
  elif [[ -d "${_default_src}/.git" ]]; then
    chezmoi_repo="$_default_src"
  fi
fi

# Detect re-entrancy: when this script is invoked from a chezmoi run_once
# script, CHEZMOI=1 is set in the env. In that case we skip the pull/apply
# (would deadlock on chezmoi's own lock) and the push (the source state
# is whatever chezmoi just deployed — nothing to publish yet).
running_under_chezmoi=0
[[ -n "${CHEZMOI:-}" ]] && running_under_chezmoi=1

print -P -- "\n${C_BLU}System Update\n-------------${C_RES}"

preauthorize_sudo

# Fetch latest chezmoi source and apply, so cross-machine updates (e.g.
# another machine bumped a tracked lockfile) land BEFORE the package syncs
# decide what to install.
#
# Do not auto-rebase here: this repo commonly carries local commits/merges
# before they are pushed. `git pull --rebase` would flatten merge commits and
# can replay already-merged profile branches, reintroducing conflicts during a
# routine system update.
if [[ -n "$chezmoi_repo" && "$running_under_chezmoi" -eq 0 ]]; then
  print -P -- "\n📥 Sync chezmoi source from origin...\n"
  _pre_rev=$(git -C "$chezmoi_repo" rev-parse HEAD 2>/dev/null || true)
  if (
    cd "$chezmoi_repo" || exit 1

    branch=$(git branch --show-current)
    remote=$(git config --get "branch.${branch}.remote" || true)
    upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
    if [[ -z "$remote" || -z "$upstream" ]]; then
      print -P -- "No upstream configured for ${branch}; skipping source sync." >&2
      exit 0
    fi

    git fetch --prune "$remote" || exit 1

    local_rev=$(git rev-parse HEAD)
    upstream_rev=$(git rev-parse "$upstream")
    base_rev=$(git merge-base HEAD "$upstream")

    if [[ "$local_rev" == "$upstream_rev" ]]; then
      exit 0
    elif [[ "$base_rev" == "$local_rev" ]]; then
      git merge --ff-only "$upstream"
    elif [[ "$base_rev" == "$upstream_rev" ]]; then
      print -P -- "chezmoi source is ahead of ${upstream}; skipping pull/rebase."
      exit 0
    else
      print -P -- "chezmoi source has diverged from ${upstream}; resolve manually." >&2
      exit 1
    fi
  ); then
    # A changed run_once bootstrap may invoke system-update from inside this
    # apply. Pass it a private handoff file: if that nested run completes, it
    # has already performed every update step and this outer run must not
    # repeat them after apply returns.
    _apply_handoff=$(mktemp)
    print -r -- pending >"$_apply_handoff"
    _apply_ok=1
    SYSTEM_UPDATE_HANDOFF_FILE="$_apply_handoff" chezmoi apply || {
      _apply_ok=0
      log_warn "chezmoi apply failed after pull (continuing)"
    }
    if ((_apply_ok)) && [[ "$(<"$_apply_handoff")" == complete ]]; then
      rm -f "$_apply_handoff"
      finalize_session
      exit 0
    fi
    rm -f "$_apply_handoff"

    # Hand off to the freshly-applied script when the source actually
    # advanced. A running shell keeps executing the code it loaded at
    # startup, so a fix in the just-pulled version (this re-exec included)
    # would otherwise only take effect on the NEXT invocation — the trap
    # where an already-running update can't benefit from its own pull. Re-exec
    # the canonical applied path so the REST of this run uses current code.
    # SYSTEM_UPDATE_REEXECED guards against an exec loop (the re-run finds
    # itself up-to-date, but the sentinel makes that unconditional).
    _post_rev=$(git -C "$chezmoi_repo" rev-parse HEAD 2>/dev/null || true)
    if [[ -z "${SYSTEM_UPDATE_REEXECED:-}" && -n "$_pre_rev" && -n "$_post_rev" &&
      "$_pre_rev" != "$_post_rev" ]]; then
      print -P -- "\n♻️  Source advanced (${_pre_rev} → ${_post_rev}); re-running updated system-update...\n"
      export SYSTEM_UPDATE_REEXECED=1
      exec "$HOME/.local/bin/system-update"
    fi
  else
    log_warn "Failed to sync chezmoi source from origin (continuing)"
  fi
fi

# Converge the pinentry signing/keychain stack now that apply has (re)built
# the binary. Runs in the foreground, never behind a spinner: its whole job
# is raising the occasional consent dialog a human must click, and it gates
# itself on presence and no-ops in seconds once a machine is converged. Soft
# like everything else — a skipped or failed setup only means prompts instead
# of silence.
if command -v system-pinentry-setup >/dev/null 2>&1; then
  system-pinentry-setup || log_warn "pinentry setup incomplete — run system-pinentry-setup at the console"
fi

# Homebrew-less hosts (e.g. the Linux dev-shell profile) have no brew /
# Brewfile pipeline. Converge the package ecosystems rendered for this
# host and reconcile services (systemd worker), then skip the
# brew-specific steps.
if ! command -v brew >/dev/null 2>&1; then
  log_warn "Homebrew not found — running the Homebrew-less update path."
  system_package_synced=0
  if command -v mise >/dev/null 2>&1; then
    print -P -- "\n🛠️ Sync Mise tools...\n"
    repair_mise_rust_legacy_links
    # install first so a declared-but-missing toolchain (e.g. `go`, needed by
    # the package workers below) exists before `system-package sync` runs.
    mise_before=$(step_snapshot snapshot_mise)
    spin::streamed "mise: converging toolchains" \
      zsh -c 'mise install && mise upgrade && mise prune -y' \
      || log_warn "mise sync had failures"
    refresh_mise_env
    step_report "$mise_before" snapshot_mise tool
  fi
  if command -v system-package >/dev/null 2>&1; then
    print -P -- "\n📦 Sync system packages...\n"
    system-package sync "${sync_flags[@]}" || die "Failed to sync system packages!"
    system_package_synced=1
  fi
  if [[ "$system_package_synced" -ne 1 ]] && command -v snap >/dev/null 2>&1; then
    print -P -- "\n📦 Refresh snap packages...\n"
    sudo snap refresh || log_warn "snap refresh had failures"
  fi
  if command -v system-service >/dev/null 2>&1; then
    print -P -- "\n📡 Sync system services...\n"
    # Deliberately unwrapped, matching the Homebrew path: system-service
    # narrates every service immediately, so there is no dead air for a
    # spinner to cover, and capturing its stdout would cost the colored log
    # output (common.zsh only paints on a TTY).
    system-service sync || log_warn "system-service sync had failures"
  fi
  if command -v nvim >/dev/null 2>&1; then
    print -P -- "\n📝 Upgrade NeoVim plugins...\n"
    # Bounded with `timeout`: headless plugin sync can hang indefinitely
    # if a background task (e.g. a treesitter parser build) never settles.
    # Report covers Lazy plugins only (see the Homebrew path's note).
    nvim_before=$(step_snapshot snapshot_nvim)
    run_step "nvim: syncing plugins" \
      timeout 300 nvim --headless "+Lazy! sync" "+Lazy load mason-tool-installer.nvim" "+MasonToolsUpdateSync" "+quitall" ||
      log_warn "NeoVim plugin upgrade timed out or had failures"
    step_report "$nvim_before" snapshot_nvim plugin
  fi
  update_pi_extensions
  update_zsh_plugins
  finalize_session
  exit 0
fi

print -P -- "\n🍺 Updating Homebrew sources...\n"
run_step "brew: updating sources" brew update || die "Failed to update Homebrew!"

# Converge mise-managed toolchains BEFORE the package syncs, for two reasons:
#   1. Package workers shell out to tools mise provides (e.g. the Go worker
#      needs `go` on PATH), so those must exist before `system-package sync`
#      runs — otherwise the worker dies with "command not found".
#   2. `mise upgrade`/`prune` must run BEFORE globals are laid down. mise-managed
#      node stores npm globals under a version-pinned prefix
#      (~/.local/share/mise/installs/node/<VERSION>/lib/node_modules) with no
#      shared store across versions. Upgrading node after the npm sync would
#      activate a fresh, empty prefix — silently orphaning every npm global
#      the sync just installed (recovered only by re-running `system-package
#      npm sync`). `mise install` only adds declared-but-missing tools (a no-op
#      when all present); `mise upgrade` bumps versions and `prune` drops the
#      now-orphaned old installs. Doing all three here means the npm worker
#      installs globals into the prefix that will actually remain active.
if command -v mise >/dev/null 2>&1; then
  print -P -- "\n🛠️ Converging mise toolchains...\n"
  repair_mise_rust_legacy_links
  mise_before=$(step_snapshot snapshot_mise)
  # Mise's success output includes download/build progress that users need
  # during long runtime installs. Stream it once it speaks; the spinner returns
  # automatically during quiet stretches.
  spin::streamed "mise: installing declared tools" mise install || log_warn "mise install had failures"
  spin::streamed "mise: upgrading tools" mise upgrade || log_warn "mise upgrade had failures"
  spin::streamed "mise: pruning old installs" mise prune -y || log_warn "mise prune had failures"
  refresh_mise_env
  step_report "$mise_before" snapshot_mise tool
fi

# Install/upgrade declared packages across every ecosystem. This is the
# only step that turns a fresh machine into a populated one. Everything
# below assumes the binaries it touches now exist on PATH.
print -P -- "\n📦 Sync system packages...\n"
system-package sync "${sync_flags[@]}" || die "Failed to sync system packages!"

print -P -- "\n🧹 Cleaning up Homebrew artifacts...\n"
run_step "brew: cleaning artifacts" brew cleanup -q --prune=all \
  || die "Failed to clean up Homebrew files!"

# Re-assert pinentry-touchid's pinentry-mac backend after `system-package sync`
# may have run `brew upgrade pinentry`, which reverts the gpgconf `pinentry`
# symlink to pinentry-curses. See reassert_pinentry_mac_backend for why we probe
# the symlink directly instead of `pinentry-touchid -check`.
#
# SKIP over SSH: the repair only matters for a LOCAL Touch ID / GUI session, and
# keeping it off remote/notty runs avoids any chance of a pinentry GUI on a
# headless desktop. Leave it to the next interactive run.
if ! mux::is_remote; then
  reassert_pinentry_mac_backend
fi

# Reconcile services (launchd/systemd) with ~/.config/packages/services.toml.
# Soft failure — a misconfigured service shouldn't block the rest of
# system-update. Note: services tied to packages just upgraded by the
# preceding `system-package sync` have already been restarted by the
# worker that owns them (see pkg::restart_services_for in common.zsh).
if command -v system-service >/dev/null 2>&1; then
  print -P -- "\n📡 Sync system services...\n"
  # Deliberately unwrapped: system-service narrates every service immediately,
  # so there is no dead air for a spinner to cover, and capturing its stdout
  # would cost the colored log output (common.zsh only paints on a TTY).
  system-service sync || log_warn "system-service sync had failures"
fi

if command -v ya >/dev/null 2>&1; then
  print -P -- "\n🦆 Upgrade Yazi plugins...\n"
  # --discard: drop any local edits inside cloned plugin dirs before pulling,
  # so stray dirt (e.g. a plugin that wrote a cache/log into its own tree)
  # can't make `ya pkg upgrade` fail mid-update and block everything after it.
  #
  # Fetching ten plugin repos is a slow, mostly silent stretch. The commit
  # hashes in `ya pkg list` are the snapshot, so the report names the plugins
  # that actually moved and --verbose is there when the raw log is wanted.
  yazi_before=$(step_snapshot snapshot_yazi)
  run_step "yazi: upgrading plugins" ya pkg upgrade --discard \
    || die "Failed to upgrade Yazi plugins!"
  step_report "$yazi_before" snapshot_yazi plugin

  # Capture any rev/hash bumps `ya pkg upgrade` just wrote into the
  # live package.toml back into the chezmoi source, then commit and
  # push as the very next step so the bump never lingers as drift.
  #
  # Implementation note: we `cp` directly into the source rather than
  # calling `chezmoi re-add` because re-add takes chezmoi's apply
  # lock — and when this script is invoked from chezmoi's own
  # run_once bootstrap, that lock is already held by the parent
  # process. Pre-fix, the nested chezmoi call failed, the
  # `2>/dev/null` swallowed the error, and the warn scrolled by in
  # the bootstrap noise; the source silently drifted. `cp` bypasses
  # chezmoi entirely. The dot_*/package.toml mapping is 1:1 because
  # the file is non-encrypted and non-templated, so a plain copy is
  # equivalent to what re-add would write.
  yazi_pkg_target="$HOME/.config/yazi/package.toml"
  # Honor .chezmoiroot: when present, the source tree is rooted at that
  # subdir (here "home/"), so the file lives at <root>/dot_config/... .
  # Hardcoding "dot_config/..." pointed cp at a directory that doesn't
  # exist and the copy silently failed.
  yazi_pkg_source_rel="dot_config/yazi/package.toml"
  if [[ -f "$chezmoi_repo/.chezmoiroot" ]]; then
    yazi_pkg_source_rel="$(<"$chezmoi_repo/.chezmoiroot")/$yazi_pkg_source_rel"
  fi
  publish_yazi_bump "$chezmoi_repo" "$yazi_pkg_source_rel" "$yazi_pkg_target"
fi

if command -v nvim >/dev/null 2>&1; then
  print -P -- "\n📝 Upgrade NeoVim plugins...\n"
  # Bounded with `timeout`: headless plugin sync can hang indefinitely
  # if a background task (e.g. a treesitter parser build) never settles.
  #
  # The report is built from lazy-lock.json, so it covers Lazy plugins only —
  # the Mason tool updates this same command performs are NOT reflected there.
  nvim_before=$(step_snapshot snapshot_nvim)
  run_step "nvim: syncing plugins" \
    timeout 300 nvim --headless "+Lazy! sync" "+Lazy load mason-tool-installer.nvim" "+MasonToolsUpdateSync" "+quitall" ||
    log_warn "NeoVim plugin upgrade timed out or had failures"
  step_report "$nvim_before" snapshot_nvim plugin
fi

update_pi_extensions
update_zsh_plugins

# Converge this machine's secret set with the pulled manifest: scrub names
# the profile no longer requires, collect what is missing or was rotated on
# another machine. Runs in the terminal (not behind a spinner) so a value
# prompt can surface right here — the same reason the final convergence pass
# streams `chezmoi apply` — and AFTER the package ecosystems, so the tools
# sync leans on (1Password app, sops/age) have already been upgraded: a
# 1Password needing an update blocked the whole reconcile when this step ran
# right after the source pull (observed 2026-08-14). sync's own tty gate
# keeps unattended runs from stalling: they scrub + report instead.
if command -v system-secrets >/dev/null 2>&1; then
  print -P -- "\n🔑 Sync secrets...\n"
  system-secrets sync || log_warn "secrets sync had failures (continuing)"
fi

# Log atuin into the homelab sync server (spec:
# docs/superpowers/specs/2026-08-17-atuin-homelab-sync-design.md).
# Idempotent: a session file means logged in — skip. The secrets may have
# been collected by the sync step just above, AFTER this process captured
# its environment, so the subshell re-sources the loader itself.
# Trade-off, eyes open: -u/-p/-k put the values on the subprocess argv,
# briefly visible to `ps` for THIS user on THIS single-user machine. atuin
# login offers no stdin/env path; accepted in the spec review.
if command -v atuin >/dev/null 2>&1 && [[ ! -f "$HOME/.local/share/atuin/session" ]]; then
  print -P -- "\n🐢 Atuin sync login...\n"
  run_step "atuin: logging into the homelab server" zsh -c '
    source "$HOME/.config/zsh/secrets.sh" 2>/dev/null || true
    if [[ -z "${ATUIN_SYNC_ADDRESS:-}" || -z "${HOMELAB_ATUIN_USERNAME:-}" ||
          -z "${HOMELAB_ATUIN_PASSWORD:-}" || -z "${HOMELAB_ATUIN_KEY:-}" ]]; then
      echo "atuin secrets not onboarded on this machine; skipping login"
      exit 0
    fi
    atuin login -u "$HOMELAB_ATUIN_USERNAME" -p "$HOMELAB_ATUIN_PASSWORD" -k "$HOMELAB_ATUIN_KEY"
  ' || log_warn "atuin login had failures (continuing)"
fi

# Final convergence apply. The step-1 apply runs BEFORE brew/system-package
# touch anything, so runtime-detected triggers (a font-fontawesome cask bump
# feeding run_after_80's font-build prompt, a WezTerm upgrade shifting the
# symbols-DB probe signature) are invisible to it and would otherwise wait
# for the next manual `chezmoi apply`. Re-applying here, in the user's
# terminal, surfaces those prompts inside the update run itself.
if [[ -n "$chezmoi_repo" && "$running_under_chezmoi" -eq 0 ]]; then
  print -P -- "\n🏠 Final chezmoi convergence pass...\n"
  chezmoi apply || log_warn "final chezmoi apply had failures"
fi

finalize_session
