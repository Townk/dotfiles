#!/usr/bin/env zsh
#
# commit-cursor — AI-driven git commits via Cursor Agent's commit skill.
#
# Asks cursor-agent to analyze the working tree, group changes into logical
# commits, and produce Conventional Commits-format messages. The script owns
# every git operation. Dry-runs and --no-commit save the plan in .git so a
# later run can execute the same plan without asking the model again.
#
# Agent contract: cursor-agent reads the diff, writes a JSON plan to a
# tempfile, then exits. It never runs `git add` or `git commit`. The script
# reads the plan and stages + commits one group at a time.

set -eu -o pipefail

# ────────────────────────────────────────────────────────────────────
# Defaults — overridable via env or flags
# ────────────────────────────────────────────────────────────────────
: "${COMMIT_CURSOR_BIN:=cursor-agent}"
: "${COMMIT_CURSOR_MODEL:=}"
: "${COMMIT_CURSOR_SKILL_PATH:=$HOME/.cursor/skills/code-commit/SKILL.md}"
: "${COMMIT_CURSOR_SANDBOX:=}"

# ────────────────────────────────────────────────────────────────────
# Colors / logging from the shared base (C_*, log_info/log_ok/log_warn/die);
# prompt::confirm from the prompt module.
# ────────────────────────────────────────────────────────────────────
source "$HOME/.local/lib/common.sh"
source "$HOME/.local/lib/prompt-common.zsh"

usage() {
  cat <<EOF
Usage: commit-cursor [options] [-- extra-guidance...]

Use Cursor Agent headless mode to group the working tree's changes into one
or more logical commits and create them using the local code-commit skill.

Options:
  -u, --untracked     Also include untracked files in the commits.
  -d, --dry-run       Print the plan (groupings + messages) without
                      staging or committing anything.
  -n, --no-commit     For each planned commit: stage the files, open
                      \$EDITOR with the message, then prompt to commit.
                      Saying No aborts without creating the commit.
  -f, --force-refresh
      --replan        Ignore any cached commit plan and ask Cursor Agent to
                      analyze the current working tree again.
  -m, --model <id>    Override Cursor model. If omitted, Cursor Agent uses
                      its configured default. Can also be set with
                      COMMIT_CURSOR_MODEL.
  -L, --list-models   List available Cursor Agent models for use with -m,
                      then exit. Does not require a git repository.
      --sandbox <m>   Pass Cursor Agent sandbox mode: enabled|disabled.
                      Can also be set with COMMIT_CURSOR_SANDBOX.
  -v, --verbose       Show cursor-agent output as it plans.
  -h, --help          Show this help.

Extra positional args (after \`--\`) are passed to the agent as
additional commit guidance — file globs to scope to, scope hints,
JIRA references, etc.

Environment:
  COMMIT_CURSOR_BIN         Cursor Agent binary (default: cursor-agent).
  COMMIT_CURSOR_MODEL       Default model. Empty means Cursor's default.
  COMMIT_CURSOR_SKILL_PATH  Path to the code-commit skill.
  COMMIT_CURSOR_SANDBOX     Cursor sandbox mode: enabled|disabled.

Logs:
  cursor-agent's stdout+stderr is appended to
  \${XDG_STATE_HOME:-\$HOME/.local/state}/commit-cursor/errors.log
EOF
}

# ────────────────────────────────────────────────────────────────────
# Parse args
# ────────────────────────────────────────────────────────────────────
include_untracked=0
dry_run=0
no_commit=0
force_refresh=0
verbose=0
list_models=0
model="$COMMIT_CURSOR_MODEL"
sandbox="$COMMIT_CURSOR_SANDBOX"
extra_guidance=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -u|--untracked) include_untracked=1; shift ;;
    -d|--dry-run)   dry_run=1; shift ;;
    -n|--no-commit) no_commit=1; shift ;;
    -f|--force-refresh|--replan) force_refresh=1; shift ;;
    -m|--model)     [[ $# -ge 2 ]] || die "--model needs a value"; model="$2"; shift 2 ;;
    -L|--list-models) list_models=1; shift ;;
    --sandbox)      [[ $# -ge 2 ]] || die "--sandbox needs a value"; sandbox="$2"; shift 2 ;;
    -v|--verbose)   verbose=1; shift ;;
    -h|--help)      usage; exit 0 ;;
    --)             shift; extra_guidance=("$@"); break ;;
    -*)             usage >&2; die "unknown flag: $1" ;;
    *)              extra_guidance=("$@"); break ;;
  esac
done

[[ "$dry_run" -eq 1 && "$no_commit" -eq 1 ]] \
  && die "--dry-run and --no-commit are mutually exclusive"

case "$sandbox" in
  ""|enabled|disabled) ;;
  *) die "--sandbox must be enabled or disabled" ;;
esac

if [[ "$list_models" -eq 1 ]]; then
  command -v "$COMMIT_CURSOR_BIN" >/dev/null 2>&1 || die "Cursor Agent ($COMMIT_CURSOR_BIN) not on PATH"
  "$COMMIT_CURSOR_BIN" --list-models
  exit $?
fi

# ────────────────────────────────────────────────────────────────────
# Pre-flight
# ────────────────────────────────────────────────────────────────────
command -v git >/dev/null 2>&1 || die "git not on PATH"
command -v jq  >/dev/null 2>&1 || die "jq is required to parse the agent's plan"

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" \
  || die "not inside a git repository"
builtin cd "$repo_root" || die "could not cd to repository root: $repo_root"

cache_file="$(git rev-parse --git-path commit-cursor-plan.json)" \
  || die "could not resolve git cache path"
cache_file="${cache_file:a}"
use_cached_plan=0
if [[ -s "$cache_file" && "$force_refresh" -eq 0 ]]; then
  use_cached_plan=1
fi

# Refuse pre-existing staged changes — keeps dry-run / no-commit / default
# modes from getting tangled with whatever the user had half-staged. The
# user can `git reset` (to unstage) or `git commit` (to commit them) first.
if ! git diff --cached --quiet; then
  die "you already have staged changes; \`git reset\` to unstage (or commit them) first"
fi

have_modified=0
git diff --quiet || have_modified=1

have_untracked=0
[[ -n "$(git ls-files --others --exclude-standard)" ]] && have_untracked=1

if [[ "$have_modified" -eq 0 && "$have_untracked" -eq 0 ]]; then
  [[ -e "$cache_file" ]] && rm -f "$cache_file"
  log_ok "nothing to commit, working tree clean"
  exit 0
fi
if [[ "$have_modified" -eq 0 && "$include_untracked" -eq 0 && "$use_cached_plan" -eq 0 ]]; then
  log_warn "only untracked files present; pass -u/--untracked to include them"
  exit 0
fi

# ────────────────────────────────────────────────────────────────────
# Build prompt
# ────────────────────────────────────────────────────────────────────
tmpdir="$(mktemp -d -t commit-cursor.XXXXXX)"
cursor_pid=""
cleanup() {
  [[ -n "$cursor_pid" ]] && kill "$cursor_pid" 2>/dev/null
  rm -rf "$tmpdir"
}
trap cleanup EXIT INT TERM

plan_file="$tmpdir/plan.json"

validate_plan() {
  local file="$1"
  jq -e '
    .commits | type == "array" and length > 0 and
    all(.[]; (.files | type == "array" and length > 0) and
             (.message | type == "string" and length > 0))
  ' "$file" >/dev/null 2>&1
}

save_plan_cache() {
  mkdir -p "${cache_file:h}"
  cp "$plan_file" "$cache_file"
  log_ok "saved commit plan cache: $cache_file"
}

clear_plan_cache() {
  [[ -e "$cache_file" ]] && rm -f "$cache_file"
}

save_remaining_plan_cache() {
  local next_idx="$1"
  local remaining=$((commit_count - next_idx))
  local tmp_cache

  if [[ "$remaining" -le 0 ]]; then
    clear_plan_cache
    return 0
  fi

  mkdir -p "${cache_file:h}"
  tmp_cache="${cache_file}.$$"
  jq --argjson start "$next_idx" '{commits: .commits[$start:]}' "$plan_file" > "$tmp_cache"
  mv "$tmp_cache" "$cache_file"
  log_info "updated commit plan cache with ${remaining} remaining commit(s)"
}

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/commit-cursor"
mkdir -p "$state_dir"
log_file="$state_dir/errors.log"

scope_clause="modified (tracked) files only"
[[ "$include_untracked" -eq 1 ]] && scope_clause="modified files AND untracked files"

extra_block=""
if [[ ${#extra_guidance[@]} -gt 0 ]]; then
  extra_block=$'\n\nAdditional guidance from the caller:\n'"${extra_guidance[*]}"
fi

if [[ "$use_cached_plan" -eq 1 ]]; then
  cp "$cache_file" "$plan_file"
  log_info "Using cached commit plan: $cache_file"
else
  command -v "$COMMIT_CURSOR_BIN" >/dev/null 2>&1 || die "Cursor Agent ($COMMIT_CURSOR_BIN) not on PATH"
  [[ -r "$COMMIT_CURSOR_SKILL_PATH" ]] \
    || die "commit skill not readable: $COMMIT_CURSOR_SKILL_PATH"

prompt=$(cat <<EOF
You are PLANNING a series of git commits for the repository at:

\`${repo_root}\`

Before planning, read and follow the Cursor Agent skill at:

\`${COMMIT_CURSOR_SKILL_PATH}\`

Use that skill for commit selection and message-format conventions
(Conventional Commits subject, optional Markdown body, no sign-offs, etc.).

Important: DO NOT execute any \`git add\`, \`git commit\`, \`git push\`,
or other write operation in the repository. The calling script does all git
operations after you finish. You may run read-only git commands and read files
as needed. The only file you may create or modify is the JSON plan file below:

\`${plan_file}\`

Workflow:

1. Inspect the working tree with \`git status\`, \`git diff\`,
   \`git log\`, and per-file reads as needed. Scope: ${scope_clause}.
2. Group the changes into one or more logical commits. Prefer ONE
   commit when changes are coherent; only split when topics are
   clearly independent.
3. For each group, draft a polished message per the code-commit skill
   (subject + Markdown body sized to the change).
4. Write the plan as JSON at the absolute path \`${plan_file}\`.
   Do not just describe the plan in your reply — the calling script
   reads it from disk. The file MUST exist when you finish. Shape MUST
   be EXACTLY:

\`\`\`json
{
  "commits": [
    {
      "files": ["relative/path/one", "relative/path/two"],
      "message": "feat(scope): subject\\n\\n## Changes Description\\n\\n..."
    }
  ]
}
\`\`\`

Rules:
- File paths must be repo-relative, exactly as \`git status --short\` would
  identify them when run from the repository root.
- Every in-scope changed file must appear in exactly one commit's
  \`files\` array. No duplicates, no omissions.
- Do not include files outside the requested scope.
- \`message\` is the full commit message (subject + blank line + body
  when warranted); use JSON \`\\n\` for newlines.
- Do NOT stage. Do NOT commit. Do NOT push.
- When you are done, reply with the literal text \`PLAN_WRITTEN\` and
  nothing else.${extra_block}
EOF
)

# ────────────────────────────────────────────────────────────────────
# Run agent
# ────────────────────────────────────────────────────────────────────
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/commit-cursor"
mkdir -p "$state_dir"
log_file="$state_dir/errors.log"

{
  print -- ""
  print -- "─── $(date '+%Y-%m-%d %H:%M:%S') ─────────────────────────"
  print -- "bin=$COMMIT_CURSOR_BIN model=${model:-<default>} sandbox=${sandbox:-<config>} untracked=$include_untracked dry_run=$dry_run no_commit=$no_commit force_refresh=$force_refresh cache=$cache_file"
} >> "$log_file"

if [[ -n "$model" ]]; then
  log_info "Planning commits with Cursor Agent ${C_BWH}${model}${C_RES}…"
else
  log_info "Planning commits with Cursor Agent's configured model…"
fi

cursor_args=(
  --print
  --output-format text
  --trust
  --force
  --workspace "$repo_root"
)

[[ -n "$model" ]] && cursor_args+=(--model "$model")
[[ -n "$sandbox" ]] && cursor_args+=(--sandbox "$sandbox")

if [[ "$verbose" -eq 1 ]]; then
  "$COMMIT_CURSOR_BIN" "${cursor_args[@]}" "$prompt" 2>&1 | tee -a "$log_file"
  rc=${pipestatus[1]}
else
  "$COMMIT_CURSOR_BIN" "${cursor_args[@]}" "$prompt" >>"$log_file" 2>&1 &
  cursor_pid=$!

  # Spinner with elapsed seconds so the user knows the model is still thinking.
  # Skipped when stderr isn't a TTY (piped / non-interactive).
  if [[ -t 2 ]]; then
    spinner=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
    start=$SECONDS
    s=1
    while kill -0 "$cursor_pid" 2>/dev/null; do
      elapsed=$((SECONDS - start))
      print -nu2 -- "\r  ${C_BLU}${spinner[s]}${C_RES} ${elapsed}s  "
      sleep 0.1
      s=$(( s % 10 + 1 ))
    done
    print -nu2 -- "\r\e[K"
  fi

  wait "$cursor_pid"
  rc=$?
  cursor_pid=""
fi

[[ "$rc" -eq 0 ]] || die "cursor-agent failed (see $log_file)"
fi

if [[ ! -s "$plan_file" ]]; then
  if [[ "$use_cached_plan" -eq 1 ]]; then
    log_warn "the cached commit plan disappeared or is empty: $cache_file"
    log_warn "Regenerate it with:"
    log_warn "  commit-cursor --force-refresh $*"
  else
    log_warn "Cursor Agent returned a reply but did not create $plan_file."
    log_warn "Try a stronger model or verbose mode:"
    log_warn "  commit-cursor --model gpt-5 --verbose $*"
  fi
  die "no plan written (see $log_file)"
fi

if ! validate_plan "$plan_file"; then
  if [[ "$use_cached_plan" -eq 1 ]]; then
    die "cached commit plan is invalid; rerun with --force-refresh (cache: $cache_file)"
  fi
  die "agent produced an invalid plan (see $log_file and $plan_file)"
fi

total_files=$(jq '[.commits[].files[]] | length' "$plan_file")
[[ "$total_files" -gt 0 ]] || die "plan groups have no files"

commit_count=$(jq -r '.commits | length' "$plan_file")

# ────────────────────────────────────────────────────────────────────
# Plan summary
# ────────────────────────────────────────────────────────────────────
print -P -- "\n${C_BWH}Planned ${commit_count} commit(s)${C_RES}\n"

jq -r '
  .commits | to_entries[] |
  "── #\(.key + 1) ──\n" +
  (.value.message | split("\n")[0]) + "\n" +
  (.value.files | map("  " + .) | join("\n")) + "\n"
' "$plan_file"

if [[ "$dry_run" -eq 1 || "$no_commit" -eq 1 ]]; then
  save_plan_cache
fi

# ────────────────────────────────────────────────────────────────────
# Execute
# ────────────────────────────────────────────────────────────────────
if [[ "$dry_run" -eq 1 ]]; then
  print -P -- "${C_DIM}(dry run — no commits created)${C_RES}\n"
  jq -r '
    .commits | to_entries[] |
    "──────────── commit #\(.key + 1) ────────────\n" +
    "Files (\(.value.files | length)):\n" +
    (.value.files | map("  " + .) | join("\n")) + "\n\n" +
    "Message:\n" +
    .value.message + "\n"
  ' "$plan_file"
  exit 0
fi

unstage_all() { git reset --quiet 2>/dev/null || true; }

stage_commit() {
  local idx="$1"
  local files
  files=("${(@f)$(jq -r ".commits[$idx].files[]" "$plan_file")}")
  files=(${files:#})   # drop empty elements (a zero-file group splits to one "")
  [[ ${#files[@]} -gt 0 ]] || { log_warn "commit $((idx + 1)) has no files; skipping"; return 1; }
  git add -- "${files[@]}"
}

i=0
while [[ "$i" -lt "$commit_count" ]]; do
  msg_file="$tmpdir/msg-$i.txt"
  jq -r ".commits[$i].message" "$plan_file" > "$msg_file"

  print -P -- "${C_BLU}── commit $((i + 1)) of ${commit_count} ──${C_RES}"

  stage_commit "$i" || { unstage_all; die "failed to stage files for commit $((i + 1))"; }

  if [[ "$no_commit" -eq 1 ]]; then
    "${EDITOR:-vi}" "$msg_file"

    # Re-empty check: if the editor leaves a blank file, abort that commit.
    if ! grep -q '[^[:space:]]' "$msg_file"; then
      log_warn "empty commit message; aborting"
      unstage_all
      exit 0
    fi

    if prompt::confirm "Create this commit?"; then
      git commit --quiet -F "$msg_file" \
        || { unstage_all; die "git commit failed"; }
      save_remaining_plan_cache $((i + 1))
      log_ok "committed: $(git log -1 --pretty=%s)"
    else
      unstage_all
      log_info "aborted at commit $((i + 1)); no further commits will be created"
      exit 0
    fi
  else
    git commit --quiet -F "$msg_file" \
      || { unstage_all; die "git commit failed"; }
    save_remaining_plan_cache $((i + 1))
    log_ok "committed: $(git log -1 --pretty=%s)"
  fi

  i=$((i + 1))
done

print -P -- "\n${C_GRN}Done.${C_RES} Created ${commit_count} commit(s)."
