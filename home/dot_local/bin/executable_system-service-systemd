#!/usr/bin/env zsh
# system-service-systemd — manage systemd USER units declared in
# ~/.config/packages/services.toml. The Linux counterpart of
# system-service-launchd: same manifest, same CLI contract, same
# normalized status vocabulary (running/stopped/error/none).
#
# Two kinds of declared entries:
#   rendered — the entry carries `cmd` (+ the shared schema keys); the
#              worker renders ~/.config/systemd/user/com.system-service.
#              <name>.service and owns that file's whole lifecycle.
#   adopted  — the entry carries `unit = "<unit-file-name>"`; the unit file
#              is chezmoi-managed elsewhere (e.g. the Accept=yes clipboard
#              sockets). The worker manages lifecycle ONLY: it never writes,
#              rewrites, or deletes the file, and the orphan sweep cannot
#              touch it (sweep is scoped to com.system-service.*).
#
# Subcommands (public): list | start <name> | stop <name> | restart <name> |
#                       info <name> | sync | render <name>
# Subcommands (internal, used by dispatcher / workers):
#   declared | matching <pkg> | status <name>

set -eu -o pipefail

source "${SYS_PKG_LIB:-$HOME/.local/lib}/system-package-common.zsh"
source "${SYS_PKG_LIB:-$HOME/.local/lib}/system-service-common.zsh"

# Overridable (like SVCFILE) so the suite can point unit writes and the
# orphan sweep at a throwaway dir instead of the real user unit dir.
SYSTEMD_USER_DIR="${SYSTEMD_USER_DIR:-$HOME/.config/systemd/user}"
SYSCTL=(systemctl --user)

# svc::entry_json <name> → the entry's JSON object (empty output if absent)
svc::entry_json() {
  svc::toml_json | jq --arg n "$1" '.[$n] // empty'
}

# svc::is_adopted <name> → 0 iff the entry declares `unit = "..."`
svc::is_adopted() {
  svc::toml_json | jq -e --arg n "$1" '.[$n] | has("unit")' >/dev/null 2>&1
}

# svc::assert_one_kind <name> — a section is adopted (unit=) XOR rendered
# (cmd=); both at once is a manifest authoring error (spec: "die loudly on
# conflict"). Called by every per-name verb before acting.
svc::assert_one_kind() {
  local name="$1"
  svc::toml_json | jq -e --arg n "$name" \
    '.[$n] | (has("unit") and has("cmd"))' >/dev/null 2>&1 &&
    die "service '$name' declares BOTH unit= (adopted) and cmd= (rendered) in $SVCFILE — pick one"
  return 0
}

# svc::unit_name <name> → the systemd unit this entry maps to.
# Adopted entries name their unit file verbatim; rendered entries get the
# generated com.system-service.<name>.service.
svc::unit_name() {
  local name="$1"
  if svc::is_adopted "$name"; then
    svc::entry_json "$name" | jq -r '.unit'
  else
    printf '%s.%s.service\n' "$LABEL_PREFIX" "$name"
  fi
}

# svc::unit_path <name> → where the unit file lives (rendered and adopted
# units both live in the user unit dir; chezmoi deploys adopted ones there).
svc::unit_path() { printf '%s/%s\n' "$SYSTEMD_USER_DIR" "$(svc::unit_name "$1")"; }

# svc::status <name>
# Normalised status for the unified vocabulary (running/stopped/error/none):
#   running — ActiveState active (covers SubState running, a socket's
#             listening, and a RemainAfterExit oneshot's exited) or
#             activating/reloading (coming up counts as up, matching
#             launchd's live-PID reading)
#   error   — ActiveState failed
#   stopped — loaded but inactive/deactivating with a clean Result
#   none    — unit not known to systemd (LoadState not-found; also the
#             `show` command itself failing: no user manager reachable)
svc::status() {
  local name="$1"
  local props
  props=$("${SYSCTL[@]}" show -p LoadState,ActiveState -- "$(svc::unit_name "$name")" 2>/dev/null) || {
    printf 'none\n'
    return
  }
  local load active
  load=$(printf '%s\n' "$props" | awk -F= '/^LoadState=/ {print $2; exit}')
  active=$(printf '%s\n' "$props" | awk -F= '/^ActiveState=/ {print $2; exit}')
  if [[ "$load" == "not-found" || -z "$active" ]]; then
    printf 'none\n'
  elif [[ "$active" == active || "$active" == activating || "$active" == reloading ]]; then
    printf 'running\n'
  elif [[ "$active" == failed ]]; then
    printf 'error\n'
  else
    printf 'stopped\n'
  fi
}

# svc::quote_exec <arg> — systemd ExecStart quoting: wrap in double quotes,
# escape backslash and double-quote, and double '%' (unit-file specifier
# escape; a literal % in an argv otherwise becomes a specifier).
svc::quote_exec() {
  local a="$1"
  a="${a//\\/\\\\}"
  a="${a//\"/\\\"}"
  a="${a//\%/%%}"
  printf '"%s"' "$a"
}

# svc::render_unit <name> — emit the generated unit text on stdout.
# Rendered entries only; adopted entries are chezmoi-owned files.
svc::render_unit() {
  local name="$1"
  svc::is_adopted "$name" && die "'$name' is an adopted unit ($(svc::unit_name "$name")) — its file is chezmoi-managed, not rendered"
  local json
  json=$(svc::entry_json "$name")
  [[ -n "$json" ]] || die "no such service in $SVCFILE: $name"
  # launchd scheduling/QoS keys have no unit-file equivalent (they'd need a
  # .timer / path unit). Fail loudly rather than render a lying unit.
  local badkey
  badkey=$(printf '%s' "$json" | jq -r '
    keys[] | select(. == ("start_interval","start_calendar_interval",
                          "watch_paths","process_type","low_priority_io","nice"))' | head -1)
  [[ -z "$badkey" ]] || die "key '$badkey' is launchd-only; on systemd declare a timer/path unit file and adopt it (unit = \"...\")"

  local cmd0
  cmd0=$(printf '%s' "$json" | jq -r '.cmd[0] // empty')
  [[ -n "$cmd0" ]] || die "service '$name' has no cmd"
  local cmd0_abs
  cmd0_abs=$(svc::resolve_cmd0 "$cmd0")

  # Build ExecStart from the resolved argv, each token exec-quoted.
  local -a argv
  argv=("$cmd0_abs" ${(f)"$(printf '%s' "$json" | jq -r '.cmd[1:][]?')"})
  local exec_start="" tok=""
  for tok in "${argv[@]}"; do
    exec_start+="${exec_start:+ }$(svc::quote_exec "$tok")"
  done

  local desc keep run_at wd lp elp
  desc=$(printf '%s' "$json" | jq -r --arg name "$name" '.description // $name')
  keep=$(printf '%s' "$json" | jq -r '.keep_alive // false')
  run_at=$(printf '%s' "$json" | jq -r '.run_at_load // false')
  wd=$(printf '%s' "$json" | jq -r --arg home "$HOME" '(.working_dir // empty) | sub("^~"; $home)')
  lp=$(printf '%s' "$json" | jq -r --arg home "$HOME" '(.log_path // empty) | sub("^~"; $home)')
  elp=$(printf '%s' "$json" | jq -r --arg home "$HOME" '(.error_log_path // empty) | sub("^~"; $home)')

  printf '# Generated by system-service-systemd from %s — do not edit.\n' "$SVCFILE"
  printf '[Unit]\nDescription=%s\n\n' "$desc"
  printf '[Service]\n'
  printf 'ExecStart=%s\n' "$exec_start"
  if [[ "$keep" == true ]]; then printf 'Restart=always\n'; else printf 'Restart=no\n'; fi
  [[ -n "$wd" ]] && printf 'WorkingDirectory=%s\n' "$wd"
  [[ -n "$lp" ]] && printf 'StandardOutput=append:%s\n' "$(printf '%s' "$lp" | sed 's/%/%%/g')"
  [[ -n "$elp" ]] && printf 'StandardError=append:%s\n' "$(printf '%s' "$elp" | sed 's/%/%%/g')"
  # Environment lines: one per key, systemd-quoted, % doubled.
  printf '%s' "$json" | jq -r --arg home "$HOME" '
    (.env // {}) | to_entries[]
    | "\(.key)=\(.value | if type == "string" then sub("^~"; $home) else . end)"' |
    while IFS= read -r kv; do
      [[ -z "$kv" ]] && continue
      # Same escape set as ExecStart tokens: backslash first (so the later
      # quote-escape's own backslashes are not re-doubled), then quote, then
      # the %-specifier doubling.
      kv="${kv//\\/\\\\}"
      kv="${kv//\"/\\\"}"
      kv="${kv//\%/%%}"
      printf 'Environment="%s"\n' "$kv"
    done
  if [[ "$run_at" == true ]]; then
    printf '\n[Install]\nWantedBy=default.target\n'
  fi
}

do_render() {
  [[ $# -eq 1 ]] || die "usage: render <name>"
  svc::assert_one_kind "$1"
  svc::render_unit "$1"
}

# svc::write_unit <name>
# Render and write atomically to the user unit dir. Prints "wrote" or
# "unchanged" so callers can decide whether a daemon-reload + restart is
# needed (the launchd write_plist contract).
# NOTE: printf '%s\n' (trailing newline) must match on both the diff side and
# the write side, or drift detection false-positives forever.
svc::write_unit() {
  local name="$1"
  local target
  target=$(svc::unit_path "$name")
  mkdir -p "$SYSTEMD_USER_DIR"
  local rendered
  rendered=$(svc::render_unit "$name")
  if [[ -f "$target" ]] && diff -q <(printf '%s\n' "$rendered") "$target" >/dev/null 2>&1; then
    printf 'unchanged\n'
    return 0
  fi
  local tmp
  # Colocate the temp file with the unit dir: on Linux /tmp is tmpfs, so a
  # cross-filesystem mv degrades to copy+unlink and loses atomicity.
  tmp=$(mktemp "$SYSTEMD_USER_DIR/.tmp.XXXXXX")
  printf '%s\n' "$rendered" >"$tmp"
  mv "$tmp" "$target"
  printf 'wrote\n'
}

# svc::has_install <name> → rendered entry wants [Install] (run_at_load)?
# Adopted units answer via their file: chezmoi ships them with [Install].
svc::has_install() {
  local name="$1"
  if svc::is_adopted "$name"; then
    return 0
  fi
  [[ "$(svc::entry_json "$name" | jq -r '.run_at_load // false')" == true ]]
}

# svc::enable <name> — idempotent; only for units with an [Install] section
# (enable fails loudly on install-less units).
svc::enable() {
  local unit
  unit=$(svc::unit_name "$1")
  svc::has_install "$1" || return 0
  "${SYSCTL[@]}" enable --quiet -- "$unit" 2>/dev/null ||
    log_warn "failed to enable $unit"
}

do_start() {
  [[ $# -eq 1 ]] || die "usage: start <name>"
  local name="$1"
  svc::declared "$name" || die "no such service in $SVCFILE: $name"
  svc::assert_one_kind "$name"
  local unit
  unit=$(svc::unit_name "$name")
  if svc::is_adopted "$name"; then
    svc::enable "$name"
    "${SYSCTL[@]}" start -- "$unit"
  else
    svc::ensure_dirs "$name"
    local changed
    changed=$(svc::write_unit "$name")
    if [[ "$changed" == "wrote" ]]; then
      "${SYSCTL[@]}" daemon-reload
      svc::enable "$name"
      "${SYSCTL[@]}" restart -- "$unit"
    else
      svc::enable "$name"
      "${SYSCTL[@]}" start -- "$unit"
    fi
  fi
  log_info "started $unit"
}

do_stop() {
  [[ $# -eq 1 ]] || die "usage: stop <name>"
  local name="$1"
  svc::declared "$name" || die "no such service in $SVCFILE: $name"
  svc::assert_one_kind "$name"
  local unit
  unit=$(svc::unit_name "$name")
  "${SYSCTL[@]}" stop -- "$unit" 2>/dev/null || true
  # disable only if enabled — `disable` on a never-enabled unit warns.
  if "${SYSCTL[@]}" is-enabled --quiet -- "$unit" 2>/dev/null; then
    "${SYSCTL[@]}" disable --quiet -- "$unit" 2>/dev/null || true
  fi
  log_info "stopped $unit"
}

do_restart() {
  [[ $# -eq 1 ]] || die "usage: restart <name>"
  svc::assert_one_kind "$1"
  do_stop "$1"
  do_start "$1"
}

do_list() {
  # NB: "st", not "status" — status is zsh's read-only alias for $?.
  local user st name
  user=$(id -un)
  svc::names | while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    st=$(svc::status "$name")
    printf '%s\t%s\t%s\t%s\n' "$name" "$st" "$user" "$(svc::unit_path "$name")"
  done
}

do_info() {
  [[ $# -eq 1 ]] || die "usage: info <name>"
  local name="$1"
  svc::declared "$name" || die "no such service in $SVCFILE: $name"
  svc::assert_one_kind "$name"
  printf '%s%s%s\n' "$C_BWH" "$(svc::unit_name "$name")" "$C_RES"
  printf '  status:   %s\n' "$(svc::status "$name")"
  printf '  unit:     %s\n' "$(svc::unit_path "$name")"
  svc::is_adopted "$name" && printf '  kind:     adopted (file is chezmoi-managed)\n'
  printf '  manifest entry:\n'
  svc::toml_json | jq --arg n "$name" '.[$n]' | sed 's/^/    /'
  printf '\n  systemctl show:\n'
  "${SYSCTL[@]}" show -p LoadState,ActiveState,SubState,Result,ExecMainStatus,MainPID,FragmentPath -- "$(svc::unit_name "$name")" 2>/dev/null | sed 's/^/    /' || true
}

do_matching() {
  [[ $# -eq 1 ]] || die "usage: matching <pkg>"
  svc::matching "$1"
}

# do_sync — reconcile declared (services.toml) ↔ unit state.
#   rendered, fresh          → write + enable (+ start iff run_at_load)
#   rendered, drifted        → write + re-enable + restart iff it was running
#   adopted                  → enable + start if not running
#   generated file, undeclared → stop + disable + rm (adopted files are
#                                untouchable: sweep is scoped to LABEL_PREFIX)
do_sync() {
  log_info "Syncing systemd user services..."

  local -a declared
  declared=(${(f)"$(svc::names)"})

  # Phase 1a: write all rendered units first, capturing pre-write status,
  # so one daemon-reload covers every file change.
  local name="" reload_needed=0
  local -A pre_status changed adopted
  for name in "${declared[@]}"; do
    [[ -z "$name" ]] && continue
    svc::assert_one_kind "$name"
    # Cache the adoption verdict: svc::is_adopted re-parses the manifest
    # (yq+jq) on every call, and phase 1b needs the same answer.
    if svc::is_adopted "$name"; then
      adopted[$name]=1
      continue
    fi
    adopted[$name]=""
    pre_status[$name]=$(svc::status "$name")
    svc::ensure_dirs "$name"
    changed[$name]=$(svc::write_unit "$name")
    [[ "${changed[$name]}" == "wrote" ]] && reload_needed=1
  done
  ((reload_needed)) && "${SYSCTL[@]}" daemon-reload

  # Phase 1b: activate.
  for name in "${declared[@]}"; do
    [[ -z "$name" ]] && continue
    # local WITH assignment: a bare `local` re-declared on later loop
    # iterations prints name=value in zsh.
    local unit=""
    unit=$(svc::unit_name "$name")
    if [[ -n "${adopted[$name]}" ]]; then
      svc::enable "$name"
      if [[ "$(svc::status "$name")" != running ]]; then
        "${SYSCTL[@]}" start -- "$unit" 2>/dev/null ||
          log_warn "failed to start $unit"
      fi
      continue
    fi
    # Runs for unchanged entries too, deliberately: enable is idempotent and
    # re-asserts [Install] linkage for a unit disabled out-of-band.
    svc::enable "$name"
    if [[ "${changed[$name]}" == "wrote" ]]; then
      if [[ "${pre_status[$name]}" == running ]]; then
        "${SYSCTL[@]}" restart -- "$unit" 2>/dev/null ||
          log_warn "failed to restart $unit"
      elif [[ "${pre_status[$name]}" == none ]]; then
        # Fresh install: honor run_at_load the way bootstrap+RunAtLoad does.
        if [[ "$(svc::entry_json "$name" | jq -r '.run_at_load // false')" == true ]]; then
          "${SYSCTL[@]}" start -- "$unit" 2>/dev/null ||
            log_warn "failed to start $unit"
        fi
      fi
      # drifted-but-stopped/errored: leave it down (never resurrect).
    fi
  done

  # Phase 2: orphan sweep — generated files only.
  local unit_file="" base="" swept=0
  for unit_file in "$SYSTEMD_USER_DIR"/${LABEL_PREFIX}.*.service(N); do
    base="${unit_file:t}"                       # com.system-service.foo.service
    name="${${base#${LABEL_PREFIX}.}%.service}" # foo
    local found=0 d=""
    for d in "${declared[@]}"; do [[ "$d" == "$name" ]] && {
      found=1
      break
    }; done
    ((found)) && continue
    log_info "removing orphan $base"
    "${SYSCTL[@]}" stop -- "$base" 2>/dev/null || true
    if "${SYSCTL[@]}" is-enabled --quiet -- "$base" 2>/dev/null; then
      "${SYSCTL[@]}" disable --quiet -- "$base" 2>/dev/null || true
    fi
    rm -f "$unit_file"
    swept=1
  done
  ((swept)) && "${SYSCTL[@]}" daemon-reload
  return 0
}

# --- subcommands ------------------------------------------------------------

do_status() {
  [[ $# -eq 1 ]] || die "usage: status <name>"
  svc::declared "$1" || die "no such service in $SVCFILE: $1"
  svc::status "$1"
}

case "${1:-}" in
  status)
    shift
    do_status "$@"
    ;;
  start)
    shift
    do_start "$@"
    ;;
  stop)
    shift
    do_stop "$@"
    ;;
  restart)
    shift
    do_restart "$@"
    ;;
  list)
    shift
    do_list "$@"
    ;;
  info)
    shift
    do_info "$@"
    ;;
  matching)
    shift
    do_matching "$@"
    ;;
  sync)
    shift
    do_sync "$@"
    ;;
  declared)
    shift
    svc::names
    ;; # internal: used by the dispatcher
  render)
    shift
    do_render "$@"
    ;;
  -h | --help | help)
    cat <<'EOF'
Manage systemd user units declared in ~/.config/packages/services.toml:
rendered entries generate com.system-service.<name>.service; adopted entries
(`unit = "..."`) are lifecycle-managed only. Usually driven by the unified
`system-service` CLI, not called directly.

Usage:
  system-service-systemd list                       declared systemd services
  system-service-systemd start|stop|restart|info <name>
  system-service-systemd sync                        reconcile units with services.toml
EOF
    exit 0
    ;;
  *) die "usage: system-service-systemd {list|start|stop|restart|info|sync|render|declared|matching|status} [args]" ;;
esac
