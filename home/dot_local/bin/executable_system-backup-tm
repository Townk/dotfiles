#!/usr/bin/env zsh
# system-backup-tm — tm scrub session worker (spec 2026-07-04).
# Verbs: timeline <session> | lens <session> | ctl <session> <older|newer|end>
#        route <key> <pane-pid> | apply <session> [path…] | confirm-apply <session>
# The dispatcher/tm front-end creates sessions; zj-context-keys fires route;
# yazi bindings fire ctl/apply. BKP_TM_SESSIONS overrides the state root.

set -u -o pipefail
source "${BKP_LIB:-$HOME/.local/lib}/backup-tm.zsh"

# tl_focused — 1 when this pane is the zellij-focused pane, else 0.
# (Outside zellij, always 1.) Cheap enough to poll once per loop tick.
tl_focused() {
  [[ -n "${ZELLIJ:-}" && -n "${ZELLIJ_PANE_ID:-}" ]] || { print 1; return }
  local f
  f=$(zellij action list-clients 2>/dev/null | awk 'NR == 2 { print $2; exit }')
  if [[ "$f" == "terminal_${ZELLIJ_PANE_ID}" ]]; then print 1; else print 0; fi
}

tm_timeline() {
  local s="$1" staging anchor
  staging=$(bkp::config::staging_path) || exit 2
  anchor=$(<"$s/anchor")
  print -r -- $$ > "$s/timeline.pid"
  # Alt-screen: prep narration and frames never pollute the shell's
  # scrollback, and the prompt view is restored intact on exit. Cursor
  # hidden and tty echo off for the whole session (read -k leaves echo
  # on, so keypresses were being drawn into the frame).
  printf '\e[?1049h\e[2J\e[H\e[?25l'
  local _stty=""
  [[ -t 0 ]] && { _stty=$(stty -g); stty -echo; }
  # Session prep runs HERE, in the visible pane, with narration — the
  # invoking prompt only creates metadata and splits, so nothing freezes.
  if [[ ! -e "$s/ready" ]]; then
    # Mount before the ladder: the scope-aware pass signs rungs off this
    # mount, so its index loads once here rather than per snapshot.
    if bkp::ux::has_fuse; then
      printf '%s⏳ mounting snapshot repository…%s\n' "$C_DIM" "$C_RES"
      bkp::mount "$staging" "$s/mnt" || exit 1
      print -r -- "$REPLY" > "$s/mount.pid"
    fi
    printf '%s⏳ reading the snapshot ladder…%s\n' "$C_DIM" "$C_RES"
    bkp::tm::ladder_fill "$s" || {
      # The mount is up by now (built above) — release it before rm, or a
      # dead FUSE server wedges the mount-table entry.
      [[ -f "$s/mount.pid" ]] && bkp::umount "$(<"$s/mount.pid")" "$s/mnt"
      bkp::tm::end "$s"; rm -rf "$s"; exit 2
    }
  fi
  # Tab/pane close sends HUP (zellij) — flag the session closed so the loop
  # breaks into the always-teardown instead of dying mid-frame.
  trap 'touch "$s/closed"' HUP TERM INT
  {
    touch "$s/ready"
    # The first changeset normally arrives pre-built by launch's inline
    # spinner stage. When it isn't there (fallback paths), build it in
    # the background — the lens pane shows the build spinner meanwhile
    # (errors land in refresh.log, never on the timeline's alt screen).
    # Explore starts at the right rung by argv — an eager refresh would
    # race yazi's startup and flag a respawn.
    if [[ "$(<"$s/lens")" == diff && ! -f "$s/current.patch" ]]; then
      : > "$s/current.patch"
      ( bkp::tm::refresh "$s" || : ) >> "$s/refresh.log" 2>&1 &!
    fi
    # Pane geometry is settled by launch BEFORE this verb runs: resize
    # acts on the focused pane, and by now the user may be focused on a
    # different pane or tab entirely — resizing from here would mangle
    # whatever they are looking at.
    local tlbin="${BKP_TM_TIMELINE_BIN:-$HOME/.local/libexec/tm-timeline}"
    if [[ -t 0 && -x "$tlbin" ]]; then
      # Compiled timeline pane (custom-builds/tm-timeline, pty-frame
      # pattern): raw input, event-driven redraw, instant focus tracking.
      # Theme flows in as flags from the single-source palette. The shell
      # loop below remains the no-Go fallback.
      "$tlbin" --active-bg "${C_HEX_TAB_ACTIVE_BG:-}" --inactive-bg "${C_HEX_TAB_BG:-}" \
        --key-fg "${C_ROLE_UI_KEY:-}" --hint-fg "${C_ROLE_UI_HINT:-}" \
        --title-fg "${C_ROLE_UI_ACCENT:-}" --sep-fg "${C_ROLE_UI_SEPARATOR:-}" "$s" || :
      return 0
    fi
    local key rest last_state="" rung focused height width interactive=1
    local kc hc
    kc=$(bkp::tm::_sgr fg "$C_ROLE_UI_KEY")
    hc=$(bkp::tm::_sgr fg "$C_ROLE_UI_HINT")
    # No tty on stdin (headless run): read would return instantly on EOF
    # forever — wait on the closed flag instead of busy-polling keys.
    [[ -t 0 ]] || interactive=0
    while [[ ! -e "$s/closed" ]]; do
      rung=$(<"$s/rung")
      focused=$(tl_focused)
      if [[ "$rung:$focused" != "$last_state" ]]; then
        height=$(( LINES - 5 ))
        (( height < 3 )) && height=16
        width=$(( COLUMNS - 1 ))
        (( width < 10 )) && width=24
        # Flicker-free repaint: build the frame, then home + per-line
        # erase-to-EOL + erase-below, atomically via synchronized update
        # (\e[?2026 — same mechanism hunk uses). No full-screen clear.
        local frame line out=""
        frame="$(
          printf ' %s⏱ tm%s %s%s%s\n\n' "$C_BWH" "$C_RES" "$C_DIM" "${anchor/#$HOME/~}" "$C_RES"
          bkp::tm::timeline_render "$s" "$height" "$width" "$focused"
          printf '\n %sj/k%s%s : scrub%s\n %sa%s%s : apply%s %s·%s %sq%s%s : quit%s' \
            "$kc" "$C_RES" "$hc" "$C_RES" \
            "$kc" "$C_RES" "$hc" "$C_RES" "$hc" "$C_RES" "$kc" "$C_RES" "$hc" "$C_RES"
        )"
        for line in "${(@f)frame}"; do
          out+="$line"$'\e[K\n'
        done
        printf '\e[?2026h\e[H%s\e[J\e[?2026l' "$out"
        last_state="$rung:$focused"
      fi
      if (( ! interactive )); then
        sleep 1
        continue
      fi
      read -t 0.25 -k 1 key 2>/dev/null || continue
      case "$key" in
        j) bkp::tm::step "$s" older ;;
        k) bkp::tm::step "$s" newer ;;
        a) tm_apply "$s" ;;
        q) break ;;
        $'\e')
          # arrow keys arrive as ESC [ A/B; bare ESC ends the session
          if read -t 0.05 -k 2 rest 2>/dev/null; then
            case "$rest" in
              '[A') bkp::tm::step "$s" newer ;;
              '[B') bkp::tm::step "$s" older ;;
            esac
          else
            break
          fi
          ;;
      esac
    done
  } always {
    printf '\e[?25h\e[?1049l'
    [[ -n "$_stty" ]] && stty "$_stty" 2>/dev/null
    bkp::tm::end "$s"
    bkp::tm::kill_lens "$s"
    tm_kill_refresh "$s"
    [[ -f "$s/mount.pid" ]] && bkp::umount "$(<"$s/mount.pid")" "$s/mnt"
    bkp::tm::session_rm "$s"
  }
}

# tm_kill_refresh <session>
# Reap a still-running changeset synthesis (recorded in refresh.pid by
# bkp::tm::refresh) — scrub steps run as orphaned ctl processes, so
# without this a slow synthesis outlives the session (the 200-rsync
# incident). The kill must cover the WHOLE descendant tree and wait for
# it to die: rsync receivers are grandchildren, and rm -rf racing a
# live receiver spews "Directory not empty". Safe when nothing runs.
tm_kill_refresh() {
  local s="$1" rp=""
  [[ -f "$s/refresh.pid" ]] && rp=$(<"$s/refresh.pid")
  [[ -n "$rp" ]] || return 0
  local -a pids=("$rp") queue=("$rp")
  local p k kids
  while (( ${#queue} )); do
    p="${queue[1]}"
    queue=("${queue[@]:1}")
    kids=$(pgrep -P "$p" 2>/dev/null) || kids=""
    for k in ${(f)kids}; do
      [[ -n "$k" ]] && { pids+=("$k"); queue+=("$k") }
    done
  done
  kill "${pids[@]}" 2>/dev/null
  local i
  for i in {1..20}; do
    kill -0 "${pids[@]}" 2>/dev/null || break
    sleep 0.05
  done
  return 0
}

tm_lens() {
  local s="$1" i lens
  lens=$(<"$s/lens")
  print -r -- $$ > "$s/lens.pid"
  print -r -- $$ > "$s/yazi.id"
  if [[ ! -e "$s/ready" ]]; then
    printf '%s⏳ waiting for the snapshot mount…%s\n' "$C_DIM" "$C_RES"
    for (( i = 0; i < 100; i++ )); do
      [[ -e "$s/ready" ]] && break
      sleep 0.1
    done
  fi
  [[ -e "$s/ready" ]] || { log_error "bkp: session mount never came up"; bkp::tm::end "$s"; exit 1 }
  # Explore owns the session's only pane, so this worker owns teardown
  # too. Pane close sends HUP — flag the session closed so the loop
  # breaks into the always-teardown instead of leaking the FUSE mount.
  # (Diff keeps the timeline pane as the teardown owner.)
  [[ "$lens" == explore ]] && trap 'touch "$s/closed"' HUP TERM INT
  local -a cmd
  {
    while [[ ! -e "$s/closed" ]]; do
      # Diff build in flight: this pane becomes the build spinner until
      # the patch lands (or the rung changes — the title follows).
      if [[ "$lens" == diff && -e "$s/building" ]]; then
        bkp::tm::build_wait "$s"
        continue
      fi
      cmd=("${(@f)$(bkp::tm::lens_cmd "$s")}") || break
      ( cd "$s" && "${cmd[@]}" )
      local lens_rc=$?
      # One breadcrumb per lens exit — the only way to see WHY a lens
      # bounced (respawn churn, instant crashes) after the session dir
      # is swept.
      print -r -- "$(date +%T) ${s:t} lens-exit rc=$lens_rc respawn=$([[ -e "$s/respawn" ]] && print y || print n) building=$([[ -e "$s/building" ]] && print y || print n) closed=$([[ -e "$s/closed" ]] && print y || print n)" >> "$BKP_STATE_DIR/lens.log" 2>/dev/null || :
      # a build just took the UI down (build_signal fired mid-hunk):
      # loop back into the spinner phase, not out of the session
      if [[ "$lens" == diff && -e "$s/building" && ! -e "$s/closed" ]]; then
        continue
      fi
      # explore lens: a failed DDS cd flags a respawn; anything else ends
      if [[ -e "$s/respawn" && ! -e "$s/closed" ]]; then
        rm -f "$s/respawn"
        continue
      fi
      break
    done
  } always {
    bkp::tm::end "$s"
    if [[ "$lens" == explore ]]; then
      tm_kill_refresh "$s"
      [[ -f "$s/mount.pid" ]] && bkp::umount "$(<"$s/mount.pid")" "$s/mnt"
      bkp::tm::session_rm "$s"
    fi
  }
}

# tm_ctl <session> <older|newer|end> [hovered]
# Fired by the yazi overlay bindings, which run with yazi's cwd and pass
# the hovered entry — recorded (anchor-relative) so the refresh can keep
# the user's place across rungs.
tm_ctl() {
  local s="$1" op="$2" hovered="${3:-}"
  [[ -d "$s" ]] || exit 0
  case "$op" in
    older | newer)
      if [[ "$(<"$s/lens")" == explore ]]; then
        local REPLY
        if bkp::tm::rung_path "$s" 2>/dev/null; then
          local base="$REPLY$(<"$s/anchor")"
          if [[ "$PWD" == "$base"* ]]; then
            local relh=""
            [[ -n "$hovered" && "$hovered" == "$base"* ]] && relh="${hovered#$base}"
            print -r -- "${PWD#$base}"$'\t'"$relh" > "$s/yazi.loc"
          fi
        fi
      fi
      bkp::tm::step "$s" "$op"
      ;;
    end) bkp::tm::end "$s" ;;
  esac
}

# tm_route <key> <pane-pid>
# zj-context-keys fires this for Shift+Up/Down/Enter over yazi/hunk panes.
# If the pane belongs to a scrub session, drive it; otherwise write the
# original key through so non-session panes lose nothing.
tm_route() {
  local key="$1" pid="$2" s lpid tpid
  for s in "$BKP_TM_SESSIONS"/s.*(/N); do
    lpid="" tpid=""
    [[ -f "$s/lens.pid" ]] && lpid=$(<"$s/lens.pid")
    [[ -f "$s/timeline.pid" ]] && tpid=$(<"$s/timeline.pid")
    if [[ "$lpid" == "$pid" || "$tpid" == "$pid" ]]; then
      case "$key" in
        shift+up)   bkp::tm::step "$s" newer ;;
        shift+down) bkp::tm::step "$s" older ;;
        apply)      tm_apply "$s" ;;
      esac
      return 0
    fi
  done
  local seq=""
  case "$key" in
    shift+up)   seq=$'\e[1;2A' ;;
    shift+down) seq=$'\e[1;2B' ;;
    apply)      seq=$'\r' ;;
  esac
  [[ -n "$seq" ]] && zellij action write-chars -- "$seq" 2>/dev/null
  return 0
}

# tm_apply <session> [selected-path…]
# Assemble the apply selection (spec §6) and open the confirm gate in a
# floating pane (inline when not under Zellij).
tm_apply() {
  setopt local_options pipe_fail
  local s="$1"; shift 2>/dev/null || :
  local lens="" REPLY
  [[ -f "$s/lens" ]] && lens=$(<"$s/lens")
  bkp::tm::rung_id "$s" || return 1
  local short="${REPLY[1,8]}"
  local -a live=()
  if (( $# )); then
    local p
    for p in "$@"; do
      if [[ "$p" == "$s/mnt/ids/$short"/* ]]; then
        live+=("${p#$s/mnt/ids/$short}")
      else
        log_error "bkp: selection is not under the current rung's mount: $p"
        return 1
      fi
    done
  elif [[ "$lens" == diff ]]; then
    # Multi-pick over the current patch's files. Parsed from the +++ b/
    # --- a header lines (not the `diff --git` summary line's last field)
    # so paths containing spaces survive intact; deleted files appear via
    # their `--- a/` line, /dev/null lines never match either pattern.
    local -a cands=() picked=()
    if [[ -f "$s/current.patch" ]]; then
      cands=("${(@f)$(awk '
          /^\+\+\+ b\// { s = substr($0, 6); sub(/\t$/, "", s); print s; next }
          /^--- a\// { s = substr($0, 6); sub(/\t$/, "", s); print s }
        ' "$s/current.patch" | sort -u)}")
    fi
    if (( ! ${#cands} )) || [[ -z "${cands[1]}" ]]; then
      # Apply fires from the timeline pane's ctl, whose stderr is
      # /dev/null — a bare warning here IS "nothing happens". Show a
      # transient notice float instead.
      if [[ -n "${ZELLIJ:-}" ]]; then
        zellij action new-pane --floating --close-on-exit --name "" \
          --borderless true --pinned true --width 52 --height 3 -- \
          zsh -c 'print; print -r -- "  this snapshot shows no changes — nothing to apply"; sleep 2' \
          2>/dev/null || :
      fi
      log_warn "bkp: this rung shows no changes — nothing to apply"
      return 0
    fi
    if [[ -n "${ZELLIJ:-}" ]]; then
      # Floating picker: apply fires from the timeline pane's ctl, which
      # has no tty of its own — an inline fzf would die silently there.
      source "$HOME/.local/lib/zellij.zsh"
      # Explicit hints: the defaults prepend open/cancel/clear, which
      # blows past the pane width — the multi-select trio is the part
      # that matters here.
      picked=("${(@f)$(print -rl -- "${cands[@]}" | PICK_NAME=tm-apply zj::pick \
        --pane-width 75 --pane-height 16 --multi \
        --hints "$(pick::hints "󰘴 󱁐" select ⭾ select-and-next "󰘴 A" select-all)" \
        --header "Restore from snapshot")}") || return 0
    else
      picked=("${(@f)$(print -rl -- "${cands[@]}" | fzf --multi --prompt='apply> ')}") || return 0
    fi
    (( ${#picked} )) && [[ -n "${picked[1]}" ]] || return 0
    live+=("${picked[@]}")
  else
    log_warn "bkp: nothing selected — select in yazi and press a to apply"
    return 0
  fi
  (( ${#live} )) || return 0
  print -rl -- "${live[@]}" > "$s/apply.list"
  if [[ -n "${ZELLIJ:-}" ]]; then
    # Size the float from the ACTUAL prompt (the _zj::float convention):
    # the confirm box grows to its longest content line and does not
    # clamp to the pane, so hardcoded geometry clips top and right.
    # Width = longest prompt line + chrome; height = --measure at that
    # width. Borderless: the dialog draws its own chrome, a pane frame
    # double-borders and misaligns it. COLORTERM must be carried through
    # explicitly: new-pane doesn't propagate it, and gum falls back to
    # 256-color approximations.
    source "$HOME/.local/lib/input-common.zsh"
    local prompt line pane_w=0 pane_h
    prompt=$(tm_apply_prompt "$s") || return 1
    for line in ${(f)prompt}; do
      (( ${#line} > pane_w )) && pane_w=${#line}
    done
    pane_w=$(( pane_w + 6 ))
    (( pane_w < 54 )) && pane_w=54
    (( pane_w > 100 )) && pane_w=100
    pane_h=$(input::confirm "$prompt" --title "Apply from the past" --warning \
      --default no --affirmative "Restore" --negative "Cancel" \
      --measure --width "$pane_w" </dev/null 2>/dev/null)
    [[ "$pane_h" == <-> ]] || pane_h=18
    zellij action new-pane --floating --close-on-exit \
      --name "" --borderless true --pinned true \
      --width "$pane_w" --height "$pane_h" \
      -- env "COLORTERM=${COLORTERM:-truecolor}" \
      "$HOME/.local/bin/system-backup-tm" confirm-apply "$s"
  else
    tm_confirm_apply "$s"
  fi
}

# tm_apply_prompt <session>
# The confirm-gate prompt, built once and shared by the float sizing
# (tm_apply) and the dialog itself (tm_confirm_apply). Paths display
# ~-collapsed and middle-ellipsized so no single line blows the box
# width past the pane; past 8 entries the remainder is summarized
# instead of silently dropped.
tm_apply_prompt() {
  local s="$1" REPLY
  local -a live=() shown=()
  [[ -f "$s/apply.list" ]] && live=("${(@f)$(<"$s/apply.list")}")
  (( ${#live} )) || return 1
  # The rung's timestamp, not its id — "snapshot c8a9b39d" means nothing
  # to a human; "the snapshot at Fri, Jul 3 2026 at 6:33pm" does.
  bkp::tm::rung_line "$s" || return 1
  local epoch="${${REPLY#*$'\t'}%%$'\t'*}" when time_s p
  strftime -s when '%a, %b %e %Y' "$epoch"
  when="${when//  / }"             # %e space-pads single-digit days
  strftime -s time_s '%I:%M %p' "$epoch"
  time_s="${(L)time_s}"
  time_s="${time_s#0}"             # 06:33 pm -> 6:33 pm
  time_s="${time_s/ /}"            # 6:33 pm  -> 6:33pm
  # Cap paths at the width of the warning block's longest line (52) so
  # the float never grows past it; the dialog lands at 52 + 6 chrome.
  for p in "${live[@]:0:8}"; do
    p="${p/#$HOME/~}"
    (( ${#p} > 52 )) && p="${p[1,25]}…${p[-26,-1]}"
    shown+=("$p")
  done
  (( ${#live} > 8 )) && shown+=("…and $(( ${#live} - 8 )) more")
  local noun="paths"
  (( ${#live} == 1 )) && noun="path"
  print -r -- "Restore ${#live} $noun onto your live filesystem
from the snapshot at $when at $time_s?

$(print -rl -- "${shown[@]}")

This replaces the selected live files with their
snapshot versions. Your current state is snapshotted
first — \`system-backup undo\` brings it back."
}

# tm_confirm_apply <session>
# The gate: show the selection, warn (data loss + the bkp-undo safety
# line), and only on explicit confirmation restore --force from the
# current rung. The dialog IS the --force consent (spec §6).
tm_confirm_apply() {
  setopt local_options pipe_fail
  local s="$1" REPLY
  local -a live=()
  [[ -f "$s/apply.list" ]] && live=("${(@f)$(<"$s/apply.list")}")
  (( ${#live} )) || return 0
  bkp::tm::rung_id "$s" || return 1
  local snap="$REPLY"
  if [[ "${BKP_TM_ASSUME_YES:-}" != 1 ]]; then
    source "$HOME/.local/lib/input-common.zsh"
    local prompt
    prompt=$(tm_apply_prompt "$s") || return 1
    # --warning, not --danger: nothing is lost (the undo snapshot fires
    # first), but --default no keeps Enter from confirming accidentally —
    # only --danger forces that on its own.
    input::confirm "$prompt" --title "Apply from the past" --warning \
      --default no --affirmative "Restore" --negative "Cancel" >/dev/null || return 0
  fi
  bkp::restore::paths "$snap" --force "${live[@]}" || return $?
  # The live side just changed: every cached rung patch AND the session
  # live view are stale, and
  # the visible changeset should reflect the new reality — rebuild in
  # the background (the float must not hang on a slow synthesis). Only
  # when a lens is actually up: without one there is nobody to show it,
  # and the orphaned build would race the session teardown.
  rm -rf "$s/patches" "$s/liveview"
  if [[ -f "$s/lens.pid" && ! -e "$s/closed" ]]; then
    ( bkp::tm::refresh "$s" || : ) >> "$s/refresh.log" 2>&1 &!
  fi
  return 0
}

main() {
  local verb="${1:-}"
  shift 2>/dev/null || true
  case "$verb" in
    timeline)      tm_timeline "$1" ;;
    lens)          tm_lens "$1" ;;
    ctl)           tm_ctl "$@" ;;
    route)         tm_route "$@" ;;          # Task 9
    apply)         tm_apply "$@" ;;          # Task 10
    confirm-apply) tm_confirm_apply "$@" ;;  # Task 10
    *) die "system-backup-tm: unknown verb: $verb" ;;
  esac
}

main "$@"
