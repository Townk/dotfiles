#!/usr/bin/env zsh
# tm-tab [tm-args…] — open a Terminal Time Machine session in a NEW zellij
# tab (yazi's `g t` lands here; works from any shell inside zellij too).
# Args are tm's: a path (dir = explore, file = scoped diff), --diff, etc.
#
# A plain `new-tab` + typing the command into its shell, NOT a layout
# with a command pane: a layout replaces the default tab template (chrome
# panes and all), and a command pane runs outside the user's shell env —
# both break the session. The typed route is byte-identical to running
# `tm` by hand, which is the proven path.
emulate -L zsh
set -u

# Empty positionals happen (yazi's "$0" in an empty directory) — drop them.
set -- "${(@)@:#}"

# Outside zellij there is no tab to make: degrade to an inline session.
if [[ -z "${ZELLIJ:-}" ]]; then
  exec system-backup browse "${@:-$PWD}"
fi

# Tab title from the anchor (last non-flag arg, PWD when none).
local a anchor="$PWD"
for a in "$@"; do
  [[ "$a" == --* ]] || anchor="$a"
done
local name="${${anchor:a}:t}"

zellij action new-tab --name "tm: $name" || exit 1
# new-tab focuses the fresh pane; give its shell a beat to come up. Early
# keystrokes only land in the TTY buffer, so this is comfort, not a lock.
sleep 0.3
# exec: the session replaces the shell, so quitting it closes the tab.
# The (q) flag shell-quotes each arg against the typed command line, and
# the leading space keeps the line out of shell history.
local -a cmd=("${@:-$PWD}")
zellij action write-chars " exec system-backup browse ${(j: :)${(@q)cmd}}"
zellij action write 13
