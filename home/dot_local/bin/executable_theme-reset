#!/usr/bin/env zsh
# theme-reset — drop this machine's loose per-session tint override and revert the
# effective theme to canonical, reloading any running Zellij session live.
#
# Why: the tint override (~/.config/theme/override.toml) is pushed by a REMOTE
# client on connect (sync-remote-assets' theme step) so this machine's theme
# matches that client's window tint. It is machine-wide, so a later session from a
# DIFFERENT client inherits the previous client's tint — e.g. after a work laptop
# SSHes in and tints the box, a Blink-shell session sees that same tint. Run this
# from such a session to clear the override and return to the canonical palette.
#
# Note: the override is machine-wide (not per-session), so this reverts EVERY
# session on this box; the other client re-pushes its own tint on its next connect.
emulate -L zsh
set -uo pipefail

case "${1:-}" in
  -h | --help | help)
    cat <<'EOF'
Drop this machine's loose per-session tint override and revert to the canonical
theme, reloading any running Zellij session live.

A remote client can push a tint override (~/.config/theme/override.toml) on
connect so this box matches that client's window color. The override is
machine-wide, so a later session from a different client inherits the previous
one's tint — run theme-reset from such a session to clear it and return to the
canonical palette.

Usage: theme-reset            (takes no arguments)
EOF
    exit 0
    ;;
esac

theme_dir="${XDG_CONFIG_HOME:-$HOME/.config}/theme"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/theme"

# Drop the override, and the staleness stamp so theme-apply is FORCED to regenerate
# the canonical effective theme (and bump the reload nonce) even if it would
# otherwise decide nothing changed.
rm -f "$theme_dir/override.toml" "$cache/.stamp"

# Re-resolve → canonical effective files + a live Zellij reload (theme-apply's
# nonce bump re-applies config.kdl). theme-apply is an internal helper in libexec.
exec "$HOME/.local/libexec/theme-apply"
