# Belt-and-suspenders against accidentally committing secrets.
#
# `.chezmoiignore` prevents `chezmoi apply` from touching these paths
# in the destination, but it doesn't stop `chezmoi add` from copying
# the file into the chezmoi source. Git itself ignores the path here
# so the file can't be committed even if it ends up in the source.

# pi-coding-agent credentials (mode 600)
home/dot_pi/agent/auth.json

# Generic credential file patterns. Match anywhere in the tree.
**/.env
**/.env.local
**/.env.*.local
**/*.pem
**/*.key
**/*.p12
**/secrets.json
**/credentials.json

# macOS noise (only emitted in some chezmoi-source directories)
**/.DS_Store

# Python bytecode caches from local helper validation.
**/__pycache__/

# Agent hand-off notes (ephemeral context docs, not for the repo)
HAND-OFF.md

# Local agent runtime memory, CCR caches, and benchmark logs.
home/dot_headroom/
home/dot_local/private_state/headroom/
home/dot_local/private_state/local-llm/

# Superpowers planning/spec artifacts (agent working notes, kept on disk only)
docs/superpowers/

# Local-only Cursor rules that reference work-specific tooling/remotes.
# Kept on disk so the agent still picks them up, but never committed.
.cursor/rules/dev-shell-sync.mdc

# Local-only pattern list for the pre-commit leak guard (.git/hooks/pre-commit).
# Holds the actual work/company identifiers to block — must NEVER be committed,
# or it would re-leak the very strings it exists to catch.
/.leak-patterns

# Editor backups / swap files
*.swp
*.swo
*~

# Generated theme artifacts — built into $HOME (and assets/) by
# custom-builds/theme/generate-theme.sh. Never committed; theme.yaml is the
# single source. Guard the source-equivalent paths so a stray `chezmoi add`
# of a generated output can't be committed.
home/dot_config/theme/chezmoi-system.*
home/dot_config/ghostty/themes/chezmoi-system
home/dot_config/wezterm/colors/chezmoi-system.toml
home/dot_config/wezterm/tint-palette.toml
home/dot_config/bat/themes/chezmoi-system.tmTheme
home/dot_config/glow/chezmoi-system.json
home/dot_config/zellij/themes/chezmoi-system*.kdl
home/dot_config/yazi/flavors/chezmoi-system.yazi/
home/dot_config/yazi/theme.toml
home/dot_config/zsh/themes.sh
home/dot_pi/agent/themes/chezmoi-system.json
home/dot_claude/themes/chezmoi-system.json
home/dot_config/nvim/colors/chezmoi-system.lua
home/dot_config/nvim/lua/chezmoi_theme/
assets/blink-shell/chezmoi-system.js

# shellspec artifacts: `--profile` writes report/, and the fake scp stubs in
# the pick-clipboard specs create host:path directories when a test drives a
# REMOTE destination (they mkdir the literal "mini:.config" relative to cwd).
report/
*:.config/
*:.local/

.omo
