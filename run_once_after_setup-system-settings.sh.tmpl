#!/bin/bash
set -eufo pipefail

{{- if eq .chezmoi.os "darwin" }}
echo "🍏  Setting macOS defaults"

osascript -e 'tell application "System Settings" to quit'

# Keyboard
echo "⌨️  Set AppleEnabledInputSources (US Keyboard Layout)"
defaults write com.apple.HIToolbox AppleEnabledInputSources -array \
  '<dict>
    <key>InputSourceKind</key><string>Keyboard Layout</string>
    <key>KeyboardLayout ID</key><integer>0</integer>
    <key>KeyboardLayout Name</key><string>U.S.</string>
  </dict>' \
  '<dict>
    <key>InputSourceKind</key><string>Keyboard Layout</string>
    <key>KeyboardLayout ID</key><integer>15000</integer>
    <key>KeyboardLayout Name</key><string>USInternational-PC</string>
  </dict>'

echo "⌨️  Set AppleSelectedInputSources (US Keyboard Layout)"
defaults write com.apple.HIToolbox AppleSelectedInputSources -array \
  '<dict>
    <key>InputSourceKind</key><string>Keyboard Layout</string>
    <key>KeyboardLayout ID</key><integer>0</integer>
    <key>KeyboardLayout Name</key><string>U.S.</string>
  </dict>'

echo "⌨️  Set AppleCurrentKeyboardLayoutInputSourceID to ABC"
defaults write com.apple.HIToolbox AppleCurrentKeyboardLayoutInputSourceID -string "com.apple.keylayout.US"

echo "⌨️  Enable keyboard navigation"
defaults write NSGlobalDomain AppleKeyboardUIMode -int 2

echo "⌨️  Make keyboard repeat-rate as fast as it can be"
defaults write -g KeyRepeat -int 1
defaults write -g InitialKeyRepeat -int 20

# Trackpad
echo "🖱️  Enable trackpad tap to click"
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad Clicking -bool true
defaults write com.apple.AppleMultitouchTrackpad Clicking -bool true

# Dock
echo "💈  Keep the dock always visible (no auto-hide)"
defaults write com.apple.dock autohide -bool false
defaults write com.apple.dock show-recents -bool false


# Finder + global filesystem behavior
echo "📁  Show all file extensions in Finder"
defaults write NSGlobalDomain AppleShowAllExtensions -bool true

echo "📁  Show Finder pathbar and statusbar"
defaults write com.apple.finder ShowPathbar -bool true
defaults write com.apple.finder ShowStatusBar -bool true

echo "📁  Suppress .DS_Store on network shares and USB volumes"
defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true
defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true

# PlistBuddy `Set` errors when the key is missing (which crashes under
# `set -e` on a fresh user account). Try `Set` first, fall back to `Add`
# so the command works whether or not the key already exists.
plist=~/Library/Preferences/com.apple.finder.plist

set_or_add() {
  local cmd_path="$1" type="$2" value="$3"
  if ! /usr/libexec/PlistBuddy -c "Set ${cmd_path} ${value}" "$plist" 2>/dev/null; then
    /usr/libexec/PlistBuddy -c "Add ${cmd_path} ${type} ${value}" "$plist"
  fi
}

echo "📁  Sort Finder icons by name"
set_or_add ":DesktopViewSettings:IconViewSettings:arrangeBy"      string  name
set_or_add ":FK_StandardViewSettings:IconViewSettings:arrangeBy"  string  name
set_or_add ":StandardViewSettings:IconViewSettings:arrangeBy"     string  name

echo "📁  Set Finder icons size"
set_or_add ":DesktopViewSettings:IconViewSettings:iconSize"       integer 64
set_or_add ":FK_StandardViewSettings:IconViewSettings:iconSize"   integer 64
set_or_add ":StandardViewSettings:IconViewSettings:iconSize"      integer 64

echo "📁  Set Finder preferred view style to columns"
defaults write com.apple.finder FXPreferredViewStyle -string "clmv"
defaults write com.apple.finder FXPreferredGroupBy -string "Name"
defaults write com.apple.finder _FXSortFoldersFirst -bool true

# Screenshots
echo "📸  Route screenshots to ~/Pictures/Screenshots"
mkdir -p "$HOME/Pictures/Screenshots"
defaults write com.apple.screencapture location -string "$HOME/Pictures/Screenshots"
defaults write com.apple.screencapture type -string "png"
defaults write com.apple.screencapture disable-shadow -bool true

echo "📱  Set 'Open at login' applications"

# `make login item` blindly duplicates entries on each run. Fetch the
# current list once and skip apps that are already registered.
existingLoginItems=$(osascript -e 'tell application "System Events" to get name of every login item' 2>/dev/null || echo "")

loginItems=(
  "Dropbox"
  "Hammerspoon"
  "Raycast"
  "SoundSource"
)

for app in "${loginItems[@]}"; do
  if printf '%s\n' "$existingLoginItems" | tr ',' '\n' | grep -qx " *$app *"; then
    echo "ℹ️  $app already in login items"
  elif [ -d "/Applications/$app.app" ]; then
    osascript -e "tell application \"System Events\" to make login item at end with properties {name: \"$app\", path: \"/Applications/$app.app\", hidden:true}"
    echo "✅  $app added to login items"
  else
    echo "❌  $app not found in /Applications"
  fi
done

echo "🔨  Making Hammerspoon use XDG config directories"
defaults write org.hammerspoon.Hammerspoon MJConfigFile "~/.config/hammerspoon/init.lua"

{{ end -}}

# vim:ft=sh
