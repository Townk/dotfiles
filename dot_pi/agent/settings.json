{
  "defaultThinkingLevel": "high",
  "theme": "catppuccin-mocha",
  "editorPaddingX": 1,
  "collapseChangelog": true,
  "npmCommand": [
    "mise",
    "exec",
    "node@latest",
    "--",
    "npm"
  ],
  "extensions": [
    "~/.pi/agent/extensions/pi-cockpit/src/index.ts"
  ],
  "skills": [
    "~/.pi/agent/skills",
    "~/Projects/AI/Skills"
  ],
  "lastChangelogVersion": "0.75.3",
  "packages": [
    "npm:pi-web-access",
    "npm:pi-rtk-optimizer",
    "npm:pi-cymbal",
    "npm:pi-lsp",
    "npm:glimpseui",
    "git:github.com/Michaelliv/pi-generative-ui",
    "npm:pi-cursor-provider",
    "npm:@tintinweb/pi-subagents"
  ],
  "defaultProvider": "cursor",
  "defaultModel": "claude-4.6-opus-thinking",
  "hideThinkingBlock": false,
  "quietStartup": true,
  "terminal": {
    "showTerminalProgress": true
  }
}