{
  "version": 1,
  "servers": [
    {
      "id": "typescript",
      "enabled": true,
      "include": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.js",
        "**/*.jsx",
        "**/*.cts",
        "**/*.mts",
        "**/*.cjs",
        "**/*.mjs"
      ],
      "rootMarkers": ["tsconfig.json", "jsconfig.json", "package.json"],
      "bin": "typescript-language-server",
      "args": ["--stdio"],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".cts": "typescript",
        ".mts": "typescript",
        ".cjs": "javascript",
        ".mjs": "javascript"
      },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 1500,
      "initializationOptions": {},
      "settings": {}
    },
    {
      "id": "basedpyright",
      "enabled": true,
      "include": ["**/*.py", "**/*.pyi"],
      "rootMarkers": [
        "pyproject.toml",
        "pyrightconfig.json",
        "setup.py",
        "setup.cfg",
        "requirements.txt",
        "Pipfile",
        ".venv"
      ],
      "bin": "basedpyright-langserver",
      "args": ["--stdio"],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".py": "python",
        ".pyi": "python"
      },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 2000,
      "initializationOptions": {},
      "settings": {}
    },
    {
      "id": "clangd",
      "enabled": true,
      "include": [
        "**/*.c",
        "**/*.h",
        "**/*.cpp",
        "**/*.hpp",
        "**/*.cc",
        "**/*.cxx",
        "**/*.m",
        "**/*.mm"
      ],
      "rootMarkers": ["compile_commands.json", ".clangd"],
      "bin": "/opt/homebrew/opt/llvm/bin/clangd",
      "args": ["--background-index"],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".c": "c",
        ".h": "c",
        ".cpp": "cpp",
        ".hpp": "cpp",
        ".cc": "cpp",
        ".cxx": "cpp",
        ".m": "objective-c",
        ".mm": "objective-cpp"
      },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 2000,
      "initializationOptions": {},
      "settings": {}
    },
    {
      "id": "lua-ls",
      "enabled": true,
      "include": ["**/*.lua"],
      "rootMarkers": [
        ".luarc.json",
        ".luarc.jsonc",
        "stylua.toml",
        ".stylua.toml"
      ],
      "bin": "lua-language-server",
      "args": [],
      "cwd": "{root}",
      "languageIdByExtension": {
        ".lua": "lua"
      },
      "startupTimeoutMs": 45000,
      "diagnosticsWaitMs": 1500,
      "initializationOptions": {},
      "settings": {}
    }
  ]
}
