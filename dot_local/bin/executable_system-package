#!/usr/bin/env zsh
# system-package — dispatcher for system-package-<ecosystem> workers.
#
# Usage:
#   system-package <subcommand>              # run for every ecosystem
#   system-package <ecosystem> <subcommand>  # run for one ecosystem
#
# Ecosystems: brew, uv, npm, go, cargo
# Subcommands: list, sync

set -eu -o pipefail

source "$HOME/.local/lib/system-package-common.sh"

ECOSYSTEMS=(brew uv npm go cargo)
SUBCOMMANDS=(list sync)

usage() {
  cat <<EOF
Usage:
  system-package <subcommand> [args...]              run for every ecosystem
  system-package <ecosystem> [<subcommand> [args...]] run for one ecosystem
  system-package -h | --help | help                  show this help

Ecosystems:  ${ECOSYSTEMS[*]}
Subcommands: ${SUBCOMMANDS[*]}

list flags:
  -u, --update   show available updates
  -a, --all      include brew transient dependencies (no-op for other tools)

Per-form help:
  system-package <subcommand>  --help    aggregated subcommand help
  system-package <ecosystem>   --help    ecosystem-specific help
  system-package <ecosystem> <subcommand> --help
                                          ecosystem-specific subcommand help
EOF
}

usage_list() {
  cat <<EOF
Usage:
  system-package list [-u|--update] [-a|--all]              all ecosystems
  system-package <ecosystem> list [-u|--update] [-a|--all]  one ecosystem

Lists installed packages as a Tool/Package/Version table, grouped by Tool.
brew rows fold the type (formula/dep/cask/mas) into the Tool column.

Flags:
  -u, --update   annotate each row with the latest available version
  -a, --all      include brew transient (non-direct) dependencies;
                 no-op for non-brew ecosystems

Ecosystems: ${ECOSYSTEMS[*]}
EOF
}

usage_sync() {
  cat <<EOF
Usage:
  system-package sync                       sync every ecosystem
  system-package <ecosystem> sync           sync one ecosystem

Reconciles installed packages against the manifest in ~/.config/packages/:
  brew  → Brewfile.bootstrap + Brewfile (\`brew bundle install --upgrade\`)
  uv    → Uvfile
  npm   → Npmfile
  go    → Gofile
  cargo → Cargofile

After each ecosystem sync, any system service (launchd or brew) whose
backing package was just upgraded and is currently running is restarted.
See \`system-service --help\` for the service side.

Ecosystems: ${ECOSYSTEMS[*]}
EOF
}

is_in() {
  local needle="$1"; shift
  local item
  for item in "$@"; do
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

worker_check() {
  command -v "system-package-$1" >/dev/null \
    || pkg_die "worker not found: system-package-$1"
}

# list_one <eco> [args...]
# Format one ecosystem's raw TSV output as a table. brew emits 3-column
# rows (type/name/version) and groups by Type; other ecosystems emit 2-column
# rows (name/version) with no grouping.
list_one() {
  local eco="$1"; shift
  worker_check "$eco"
  if [[ "$eco" == "brew" ]]; then
    "system-package-$eco" list "$@" | pkg_table_print $'Type\tPackage\tVersion' 1
  else
    "system-package-$eco" list "$@" | pkg_table_print $'Package\tVersion'
  fi
}

# list_all [args...]
# Merge every ecosystem's raw TSV output into a single Tool/Package/Version
# table, grouped by Tool. brew rows already carry a type (formula/dep/cask/mas)
# as their first cell; we fold that into the Tool column as "brew:formula" /
# "brew:dep" / "brew:cask" / "brew:mas". pkg_table_print's group-by-column
# feature emits separators automatically wherever the Tool value changes.
list_all() {
  local args=("$@")
  {
    local eco rows
    for eco in "${ECOSYSTEMS[@]}"; do
      worker_check "$eco"
      if [[ "$eco" == "brew" ]]; then
        rows=$("system-package-$eco" list "${args[@]}" | sed 's/^/brew:/')
      else
        rows=$("system-package-$eco" list "${args[@]}" | awk -v t="$eco" '{print t "\t" $0}')
      fi
      [[ -n "$rows" ]] && printf '%s\n' "$rows"
    done
  } | pkg_table_print $'Tool\tPackage\tVersion' 1
}

# sync_one <eco> [args...]
sync_one() {
  local eco="$1"; shift
  worker_check "$eco"
  "system-package-$eco" sync "$@"
}

# sync_all [args...]
# Run sync for every ecosystem, with a banner before each one. Banners stay
# in the merged-output flow because sync emits log-style output, not a table.
sync_all() {
  local eco
  for eco in "${ECOSYSTEMS[@]}"; do
    pkg_info "${PKG_C_BWH}── $eco ──${PKG_C_RES}"
    sync_one "$eco" "$@"
  done
}

main() {
  # No args at all → top-level help (exit 0; this isn't an error).
  [[ $# -ge 1 ]] || { usage; exit 0; }

  # Top-level help: `-h`, `--help`, or `help`.
  if pkg_is_help "$1"; then
    usage; exit 0
  fi

  if is_in "$1" "${SUBCOMMANDS[@]}"; then
    local cmd="$1"; shift
    # `system-package <subcommand> --help` → subcommand help, no side effects.
    if pkg_args_contain_help "$@"; then
      case "$cmd" in
        list) usage_list ;;
        sync) usage_sync ;;
      esac
      exit 0
    fi
    case "$cmd" in
      list) list_all "$@" ;;
      sync) sync_all "$@" ;;
    esac
  elif is_in "$1" "${ECOSYSTEMS[@]}"; then
    local eco="$1"; shift
    worker_check "$eco"
    # `system-package <eco>` (no subcommand) or `system-package <eco> --help`
    # → defer to worker's top-level help. Same for the subcommand layer.
    if [[ $# -eq 0 ]] || pkg_is_help "$1"; then
      "system-package-$eco" --help
      exit 0
    fi
    local cmd="$1"; shift
    is_in "$cmd" "${SUBCOMMANDS[@]}" \
      || { usage; pkg_die "unknown subcommand: $cmd"; }
    # `system-package <eco> <cmd> --help` → forward to worker so the user
    # sees ecosystem-specific flag semantics rather than the aggregated text.
    if pkg_args_contain_help "$@"; then
      "system-package-$eco" "$cmd" --help
      exit 0
    fi
    case "$cmd" in
      list) list_one "$eco" "$@" ;;
      sync) sync_one "$eco" "$@" ;;
    esac
  else
    usage
    pkg_die "unknown argument: $1"
  fi
}

main "$@"
