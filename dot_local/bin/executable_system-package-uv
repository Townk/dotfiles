#!/usr/bin/env zsh
# system-package-uv — sync Python tools (via uv tool) against
# ~/.config/packages/Uvfile, with Python-version drift detection.

set -eu -o pipefail

source "$HOME/.local/lib/system-package-common.sh"

UVFILE="$PKG_DIR/Uvfile"
PYTHON_STAMP="$PKG_STATE_DIR/uv.python"

uv_list_installed() {
  # `uv tool list` prints one tool name per "block"; the tool name is the
  # first column on lines that don't begin with whitespace and aren't headers.
  uv tool list 2>/dev/null | awk '/^[a-zA-Z0-9_]/ && !/^No tools/ {print $1}'
}

uv_current_python() {
  if command -v mise >/dev/null 2>&1; then
    mise current python 2>/dev/null
  else
    python --version 2>&1 | awk '{print $2}'
  fi
}

uv_python_drifted() {
  local current; current=$(uv_current_python)
  [[ -z "$current" ]] && return 1
  if [[ -f "$PYTHON_STAMP" ]]; then
    local last; last=$(<"$PYTHON_STAMP")
    [[ "$current" != "$last" ]]
  else
    return 0
  fi
}

uv_write_stamp() {
  mkdir -p "$PKG_STATE_DIR"
  uv_current_python > "$PYTHON_STAMP"
}

# uv_list_rows <outdated:true|false>
# Output one "name\tversion[annotation]" TSV row per installed tool.
uv_list_rows() {
  local outdated="${1:-false}"

  uv tool list 2>/dev/null \
    | awk '/^[a-zA-Z0-9_]/ && !/^No tools/ {
        name=$1
        ver=$2
        # strip leading "v"
        sub(/^v/, "", ver)
        print name "\t" ver
      }' \
    | while IFS=$'\t' read -r name ver; do
        if [[ "$outdated" == true ]]; then
          local latest=""
          latest=$(curl -fsSL "https://pypi.org/pypi/${name}/json" 2>/dev/null \
                   | jq -r '.info.version // empty' 2>/dev/null || true)
          if [[ -n "$latest" && "$latest" != "$ver" ]]; then
            ver="${ver} ${PKG_C_YEL}(update available: ${latest})${PKG_C_RES}"
          fi
        fi
        printf '%s\t%s\n' "$name" "$ver"
      done
}

do_list() {
  local outdated=false
  [[ "${1:-}" == "-u" ]] && outdated=true
  uv_list_rows "$outdated"
}

do_sync() {
  pkg_info "Syncing uv tools..."

  local declared installed
  declared=$(mktemp); installed=$(mktemp)
  trap "rm -f '$declared' '$installed'" EXIT

  if uv_python_drifted; then
    pkg_warn "Python version changed since last sync — rebuilding uv tool venvs"
    uv tool upgrade --all --reinstall || true
  fi

  pkg_manifest_read "$UVFILE" > "$declared"
  uv_list_installed > "$installed"

  pkg_diff_only_in "$declared" "$installed" | while IFS= read -r tool; do
    [[ -n "$tool" ]] && uv tool install "$tool"
  done
  pkg_diff_only_in "$installed" "$declared" | while IFS= read -r tool; do
    [[ -n "$tool" ]] && uv tool uninstall "$tool"
  done

  uv tool upgrade --all || true

  uv_write_stamp
}

case "${1:-}" in
  list) shift; do_list "$@" ;;
  sync) do_sync ;;
  *)    pkg_die "usage: system-package-uv {list [-u]|sync}" ;;
esac
