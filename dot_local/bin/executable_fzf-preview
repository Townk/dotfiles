#!/bin/zsh
#
# fzf-preview — render a preview for fzf's `--preview` hook.
#
# Dispatch mirrors the Yazi previewer chain in ~/.config/yazi/yazi.toml
# so previews here behave the same way they do in Yazi:
#
#   archives                       → ouch list
#   audio/video/image/subrip/ps    → mediainfo
#   csv / md / rst / ipynb / json  → rich (fancy renderer)
#   regular text                   → bat (syntax-highlighted)
#   binary                         → hexyl (hex dump)
#
# Lives as a script (not a zsh function) so fzf's preview subshell —
# spawned via `$SHELL -c '<cmd>'`, non-interactive, no ~/.zshrc — can
# find it via PATH.

set -u

# z4h's tab-complete sends fzf two different formats depending on the
# code path:
#   -z4h-comp-files  →  <raw-path>\0<colored-or-quoted-display>
#   -z4h-comp-words  →  <numeric-index>\0<shell-quoted-name>
# Both put the *display* form in the last field, which is what `{-1}`
# in the preview command resolves to. The display form is shell-quoted
# (e.g. `2\ color\ sign\ .2mm.3mf`), so the script's $1 inherits those
# backslashes verbatim. `${(Q)var}` strips one level of shell quoting
# — converting `2\ color\ sign\ .2mm.3mf` back to `2 color sign .2mm.3mf`
# — which lets the subsequent -d / -f checks find the actual file.
target=${(Q)${1:-}}

# Render a centered, bannered status message inside the preview pane.
# Used for placeholder text like "Nothing to preview" or "<Empty File>"
# — single-line strings that look out of place rendered raw at column 0.
#
# Tries figlet first with the user's `phm-minecraft.flf` font, then
# falls back to plain text if (a) figlet isn't on PATH or (b) the
# rendered banner would overflow `box_w`. Either way the output is
# centered horizontally and vertically inside the requested box.
#
# Args:
#   $1   text to render (single line; figlet handles word art)
#   $2   box width in columns (default 80)
#   $3   box height in lines  (default 24)
function stamp-msg() {
  local text="$1"
  local box_w="${2:-80}"
  local box_h="${3:-24}"

  local figlet_fonts_dir="$XDG_DATA_HOME/fonts/figlet/FIGfonts/fonts"
  local figlet_font="phm-minecraft.flf"

  local use_fallback=0
  local text_w=0
  local text_h=0
  local final_output=""

  if command -v figlet >/dev/null 2>&1; then
    # 1. Force figlet to render with massive limits to prevent premature wrapping
    local raw_figlet
    raw_figlet=$(figlet -d "$figlet_fonts_dir" -f "$figlet_font" -w 9999 "$text")

    # Measure figlet's true footprint. Split into a line array with
    # zsh's (f) flag, then take ${#first_line} for width and $#array
    # for height — no subprocess overhead vs. the previous wc pipes.
    local -a raw_lines=( ${(f)raw_figlet} )
    local figlet_true_w=${#raw_lines[1]}

    # 2. Check if the banner breaks out of your boundaries
    if (( figlet_true_w > box_w )); then
      use_fallback=1
    else
      # If it fits perfectly, commit the cached output
      final_output="$raw_figlet"
      text_h=$#raw_lines
      text_w=$figlet_true_w
    fi
  else
    use_fallback=1
  fi

  # 3. Fallback logic (Plain text configuration)
  if (( use_fallback )); then
    # Re-measure raw single-line text width
    text_w=${#text}

    # If even the standard text is too wide for box_w, truncate or clamp width
    if (( text_w > box_w )); then
        text_w=$box_w
    fi
    local -a text_lines=( ${(f)text} )
    text_h=$#text_lines
    final_output="$text"
  fi

  # 4. Geometry Centering Calculations
  local pad_top=$(( (box_h - text_h) / 2 ))
  local pad_left=$(( (box_w - text_w) / 2 ))

  (( pad_top < 0 )) && pad_top=0
  (( pad_left < 0 )) && pad_left=0

  # Print layout vertical padding. Guard against pad_top=0: `printf` runs
  # its format string once even with zero args, which would emit a stray
  # newline.
  (( pad_top > 0 )) && printf '\n%.0s' $(seq 1 "$pad_top")

  # Generate spacing padding matching the offset
  local left_space=$(printf '%*s' "$pad_left" "")

  # 5. Output rendering loop
  printf '%s\n' "$final_output" | while IFS= read -r line; do
      # If line truncation is needed for plain text overflowing box_w:
      if (( use_fallback && ${#line} > box_w )); then
          printf '%s%s\n' "$left_space" "${line:0:$box_w}"
      else
          printf '%s%s\n' "$left_space" "$line"
      fi
  done
}

# Run a command as if it were attached to an interactive TTY, even
# though fzf has handed us pipe stdio. Some tools (notably `ouch list
# -t` and other tree/colorized renderers) detect "stdout is not a tty"
# and silently downgrade to a plain, scriptable format that strips
# colors and structure — useless for a fancy preview. Wrapping them
# through `unbuffer(1)` or `script(1)` allocates a pseudo-tty so the
# tool produces its full output, which fzf can then render.
#
# Prefers `unbuffer` (from the `expect` package) when available.
# Otherwise falls back to `script(1)`, using BSD-style invocation on
# macOS and GNU-style on Linux (the two flavors take different args).
#
# Args:
#   $1   command to run
#   $2+  arguments to pass to the command
function force-tty() {
  if (( $# < 1 )); then
    echo "Usage: force-tty <command> [args...]" >&2
    return 2
  fi

  local cmd="$1"
  shift

  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "force-tty: command not found: $cmd" >&2
    return 127
  fi

  if command -v unbuffer >/dev/null 2>&1; then
    unbuffer "$cmd" "$@"
  elif [[ "$(uname -s)" = "Darwin" ]]; then
    script -q /dev/null "$cmd" "$@"
  else
    local quoted
    printf -v quoted '%q ' "$cmd" "$@"
    script -q -c "$quoted" /dev/null
  fi
}

# Width/height hints. fzf exports these to every preview invocation.
# FZF_PREVIEW_COLUMNS is the pane width, but fzf overlays a scrollbar
# on the rightmost column once content exceeds the viewport — so we
# subtract 1 to keep the last visible column intact.
h=${FZF_PREVIEW_LINES:-40}
w=${FZF_PREVIEW_COLUMNS:-80}
(( w > 4 )) && (( w-- ))

# Empty selection: nothing to do.
if [[ -z "$target" ]]; then
  stamp-msg "Nothing to preview" "$w" "$h"
  exit
fi

# Directory: tree listing via eza.
if [[ -d "$target" ]]; then
  eza -F -h --group-directories-first --icons --hyperlink --tree \
      --color=always --level=2 "$target" | head -200
  exit
fi

# Not a regular file (broken symlink, device, etc.): give up gracefully.
if [[ ! -f "$target" ]]; then
  stamp-msg "Nothing to preview" "$w" "$h"
  exit
fi

# Cap the height we emit so head -N matches the visible area and fzf
# doesn't waste time rendering off-screen content. Pad slightly so
# scrolling has room.
#
# When the FZF_PREVIEW_FULL env var is set (toggled via the ctrl-f
# binding in zshrc), use an effectively-unbounded cap so the full file
# flows in. The opposite binding (ctrl-alt-f) re-runs the preview
# without the env var, restoring the cap.
if [[ -n ${FZF_PREVIEW_FULL:-} ]]; then
  max_lines=999999
else
  max_lines=$((h * 3))
fi

# By-extension dispatch — keep in sync with `prepend_previewers` in
# ~/.config/yazi/yazi.toml.
case "${target:l}" in
  *.csv)
    if command -v tv >/dev/null 2>&1; then
      tv -a --no-streaming -f -j -D "$target" | head -"$max_lines"
      exit
    fi
    ;;
  *.md)
    if command -v glow >/dev/null 2>&1; then
      glow -w "$w" "$target" | head -"$max_lines"
      exit
    fi
    ;;
  *.rst|*.ipynb)
    if command -v rich >/dev/null 2>&1; then
      rich -w "$w" -j --left --guides --line-numbers \
        --force-terminal "$target" | head -"$max_lines"
      exit
    fi
    ;;
  *.json|*.vil|*.kbi)
    if command -v jq >/dev/null 2>&1; then
      \cat "$target" | jq -C --indent 2 | head -"$max_lines"
      exit
    fi
    ;;
  *.yml|*.yaml)
    if command -v yq >/dev/null 2>&1; then
      \cat "$target" | yq -C --indent 2 | head -"$max_lines"
      exit
    fi
    ;;
  *.xml)
    if command -v xq >/dev/null 2>&1; then
      \cat "$target" | xq -c --indent 2 | head -"$max_lines"
      exit
    fi
    ;;
  *.dmg)
    if [[ "$(uname -s)" = "Darwin" ]]; then
      dmg-info "$target" "$w" | head -"$max_lines"
      exit
    fi
    ;;
  *.ics)
    if command -v ics-view >/dev/null 2>&1; then
      ics-view "$target" -W "$w" | head -"$max_lines"
      exit
    fi
    ;;
esac

# By-MIME dispatch.
mime=$(file --mime-type --brief --dereference "$target" 2>/dev/null)
encoding=$(file --mime-encoding --brief --dereference "$target" 2>/dev/null)

case $mime in
  inode/x-empty)
    stamp-msg "<Empty File>" "$w" "$h"
    exit
    ;;
  application/zip | \
  application/*zip* | \
  application/x-tar | \
  application/x-bzip2 | \
  application/x-7z-compressed | \
  application/x-rar | \
  application/x-xz)
    if command -v ouch >/dev/null 2>&1; then
      force-tty ouch list -q -y -t "$target" 2>&1 | head -"$max_lines"
      exit
    fi
    ;;
  application/pdf)
    if command -v chafa >/dev/null 2>&1 && command -v pdftocairo >/dev/null 2>&1; then
      pdftocairo -png -singlefile "$target" - 2>/dev/null | chafa -f iterm -s "${w}x${h}" - 2>/dev/null
      exit
    fi
    ;;
  image/*)
    # `chafa` alone is enough to preview the image; `mediainfo` adds the
    # nice metadata footer but isn't a hard requirement.
    if command -v chafa >/dev/null 2>&1; then
      chafa -f iterm -s "${w}x${h}" "$target" 2>/dev/null
      if command -v mediainfo >/dev/null 2>&1; then
        mediainfo "$target" | head -"$max_lines"
      fi
      exit
    fi
    ;;
  audio/* | video/* | application/subrip | application/postscript)
    if command -v mediainfo >/dev/null 2>&1; then
      mediainfo "$target" | head -"$max_lines"
      exit
    fi
    ;;
esac

# Binary files that didn't match a media/archive rule: hex dump.
# `--terminal-width` alone expands hexyl to as many byte-panels as
# fit (2 panels ~76 cols, 3 panels ~100 cols, 4 panels ~125 cols);
# `--panels=auto` is mutually exclusive with it and not needed.
if [[ $encoding == binary ]]; then
  if command -v hexyl >/dev/null 2>&1; then
    hexyl --color=always --terminal-width="$w" "$target" 2>/dev/null | head -"$max_lines"
  else
    stamp-msg "Binary file" "$w" "$h"
  fi
  exit
fi

# Default: syntax-highlighted text via bat. No head cap here — bat is
# fast on large files and fzf renders the preview lazily, so letting
# the whole file flow into the preview buffer just makes scrolling
# show real content instead of an arbitrary cutoff.
bat --theme=OneHalfDark --style=numbers,changes --color=always \
    --terminal-width="$w" "$target" 2>/dev/null | head -"$max_lines"
