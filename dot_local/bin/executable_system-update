#!/bin/zsh
#
# system-update — Bring all tools managed outside of chezmoi to their
# latest versions.
#
# Idempotent — safe to run periodically. Also called by chezmoi's bootstrap
# (run_once_after_setup-bootstrap-tools.sh.tmpl) so that fresh-machine
# setup and "everything-already-installed" applies converge to the same
# end state.
#
# Previously lived as a zsh function in ~/.config/zsh/functions.d/commands.sh.
# Promoted to a standalone script so the bootstrap can invoke it without
# having to enter an interactive shell.

set -eu -o pipefail

if [[ -t 1 ]]; then
  C_BLU=$'\e[34m'
  C_RED=$'\e[31m'
  C_BWH=$'\e[1;37m'
  C_RES=$'\e[0m'
else
  C_BLU=""; C_RED=""; C_BWH=""; C_RES=""
fi

die() {
  print -P -- "\n${C_RED}Error${C_RES}: $*"
  exit 1
}

print -P -- "\n${C_BLU}System Update\n-------------${C_RES}"

print -P -- "\n  Updating Homebrew sources...\n"
brew update || die "Failed to update Homebrew!"

print -P -- "\n🍻 Upgrade Homebrew Bundle...\n"
# Concatenate Brewfile.bootstrap and the main Brewfile so `--cleanup` sees
# their union. Running them separately would make the cleanup pass on the
# first file treat all packages from the second as "extra" and uninstall
# them.
cat ~/.config/brewfile/Brewfile.bootstrap ~/.config/brewfile/Brewfile \
  | brew bundle install -q --cleanup --upgrade --file=- \
  || die "Failed to upgrade Homebrew Bundle!"

print -P -- "\n🍺 Upgrade Homebrew formulas...\n"
brew upgrade || die "Failed to upgrade Homebrew formulas!"

print -P -- "\n🍺 Upgrade Homebrew casks...\n"
brew upgrade --cask --greedy-latest || die "Failed to upgrade Homebrew casks!"

print -P -- "\n🧹 Cleanning up Homebrew artifacts...\n"
brew cleanup -q --prune=all || die "Failed to clean up Homebrew files!"

print -P -- "\n🦆 Upgrade Yazi plugins...\n"
ya pkg upgrade || die "Failed to upgrade Yazi plugins!"

print -P -- "\n🛠️ Upgrade Mise tools...\n"
mise upgrade
mise prune -y

print -P -- "\n🛠️ Upgrade bin tools...\n"
bin update -a -y
bin prune -f

print -P -- "\n🛠️ Upgrade uv tools...\n"
uv tool upgrade --all

print -P -- "\n📝 Upgrade NeoVim plugins...\n"
nvim --headless "+Lazy! sync" "+Lazy load mason-tool-installer.nvim" "+MasonToolsUpdateSync" "+quitall" \
  || die "Failed to upgrade NeoVim plugins!"

print -P -- "\n🐚 Upgrade zsh4humans...\n"
z4h update || die "Failed to upgrade zsh4humans!"

print -P -- "\n👍 System updated ${C_BWH}successfully${C_RES}!\n"
