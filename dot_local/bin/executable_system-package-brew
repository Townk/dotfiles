#!/usr/bin/env zsh
# system-package-brew — sync Homebrew formulas, casks, and MAS apps
# against ~/.config/packages/Brewfile.bootstrap + Brewfile.

set -eu -o pipefail

source "$HOME/.local/lib/system-package-common.sh"

BREWFILE_BOOT="$PKG_DIR/Brewfile.bootstrap"
BREWFILE_MAIN="$PKG_DIR/Brewfile"

# brew_list_rows <outdated:true|false>
# Output one "type\tname\tversion[annotation]" TSV row per installed package.
# Type is one of: formula (user-installed), dep (transient dependency),
# cask, mas. Rows are sorted by (type, name) with type ordered
# formula → dep → cask → mas.
brew_list_rows() {
  local outdated="${1:-false}"
  local -A outdated_map
  local -A pkg_map
  local -A type_map
  local -A direct_set

  # Set of formulas where installed_on_request:true — i.e. the user (or a
  # Brewfile) explicitly installed them. Anything not in this set is a
  # transient dependency. Reading INSTALL_RECEIPT.json directly is ~100x
  # faster than `brew info --json=v2 --installed` for the same data.
  local cellar=""
  cellar=$(brew --cellar 2>/dev/null) || cellar=""
  if [[ -n "$cellar" ]]; then
    local receipts=("$cellar"/*/*/INSTALL_RECEIPT.json(N))
    if (( ${#receipts[@]} > 0 )); then
      local n=""
      while IFS= read -r n; do
        [[ -n "$n" ]] && direct_set[$n]=1
      done < <(jq -r 'select(.installed_on_request)
                      | input_filename | split("/")[-3]' \
                "${receipts[@]}" 2>/dev/null | sort -u || true)
    fi
  fi

  # Build outdated map (only if -u)
  if [[ "$outdated" == true ]]; then
    local formula_json="" cask_json=""
    formula_json=$(brew outdated --json --formula 2>/dev/null || printf '[]')
    cask_json=$(brew outdated --json --cask 2>/dev/null || printf '[]')

    # Parse formulas
    local name="" ver=""
    while IFS=$'\t' read -r name ver; do
      [[ -n "$name" ]] && outdated_map[$name]="$ver"
    done < <(printf '%s' "$formula_json" \
             | jq -r '.[] | "\(.name)\t\(.current_version)"' 2>/dev/null || true)

    # Parse casks
    while IFS=$'\t' read -r name ver; do
      [[ -n "$name" ]] && outdated_map[$name]="$ver"
    done < <(printf '%s' "$cask_json" \
             | jq -r '.[] | "\(.name)\t\(.current_version)"' 2>/dev/null || true)

    # MAS outdated: lines like "id name (oldver -> newver)"
    if command -v mas >/dev/null 2>&1; then
      local line="" mas_name="" mas_newver=""
      while IFS= read -r line; do
        mas_name=$(printf '%s' "$line" \
                   | sed 's/^[[:space:]]*[0-9][0-9 ]*//' \
                   | sed 's/ ([^)]*->[ ]*[^)]*) *$//')
        mas_newver=$(printf '%s' "$line" \
                     | grep -oE '\(.*->[ ]*([^)]+)\)$' \
                     | grep -oE '[^> ]+\)$' \
                     | tr -d ')' || true)
        [[ -n "$mas_name" && -n "$mas_newver" ]] && outdated_map[$mas_name]="$mas_newver"
      done < <(mas outdated 2>/dev/null || true)
    fi
  fi

  # Collect installed packages with their type
  # Formulas — split into "formula" (direct) vs "dep" (transient) using
  # the direct_set computed above.
  local name="" ver=""
  while IFS=' ' read -r name ver; do
    [[ -n "$name" && -n "$ver" ]] && {
      pkg_map[$name]="$ver"
      if [[ -n "${direct_set[$name]:-}" ]]; then
        type_map[$name]="formula"
      else
        type_map[$name]="dep"
      fi
    }
  done < <(brew list --versions --formula 2>/dev/null || true)

  # Casks
  while IFS=' ' read -r name ver; do
    [[ -n "$name" && -n "$ver" ]] && {
      pkg_map[$name]="$ver"
      type_map[$name]="cask"
    }
  done < <(brew list --versions --cask 2>/dev/null || true)

  # MAS apps: "id name (version)"
  if command -v mas >/dev/null 2>&1; then
    local line="" mas_name="" mas_ver=""
    while IFS= read -r line; do
      mas_name=$(printf '%s' "$line" \
                 | sed 's/^[[:space:]]*[0-9][0-9 ]*//' \
                 | sed 's/ ([^)]*) *$//')
      mas_ver=$(printf '%s' "$line" \
                | grep -oE '\([^)]+\)$' \
                | tr -d '()')
      [[ -n "$mas_name" && -n "$mas_ver" ]] && {
        pkg_map[$mas_name]="$mas_ver"
        type_map[$mas_name]="mas"
      }
    done < <(mas list 2>/dev/null || true)
  fi

  # Emit rows sorted by (type rank, name). Type rank: formula=1, cask=2, mas=3
  # so formulas appear first, then casks, then App Store apps.
  local k="" v="" t="" rank=0
  {
    for k in "${(@k)pkg_map}"; do
      v="${pkg_map[$k]}"
      t="${type_map[$k]}"
      if [[ "$outdated" == true && -n "${outdated_map[$k]:-}" ]]; then
        v="${v} ${PKG_C_YEL}(update available: ${outdated_map[$k]})${PKG_C_RES}"
      fi
      case "$t" in
        formula) rank=1 ;;
        dep)     rank=2 ;;
        cask)    rank=3 ;;
        mas)     rank=4 ;;
        *)       rank=9 ;;
      esac
      printf '%d\t%s\t%s\t%s\n' "$rank" "$t" "$k" "$v"
    done
  } | sort -t$'\t' -k1,1n -k3,3 | cut -f2-
}

do_list() {
  local outdated=false
  [[ "${1:-}" == "-u" ]] && outdated=true
  brew_list_rows "$outdated"
}

do_sync() {
  pkg_info "Syncing Homebrew packages..."
  cat "$BREWFILE_BOOT" "$BREWFILE_MAIN" \
    | brew bundle install -q --cleanup --upgrade --file=- \
    || pkg_die "brew bundle install failed"
}

case "${1:-}" in
  list) shift; do_list "$@" ;;
  sync) do_sync ;;
  *)    pkg_die "usage: system-package-brew {list [-u]|sync}" ;;
esac
