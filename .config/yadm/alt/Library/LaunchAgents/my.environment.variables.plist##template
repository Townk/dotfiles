<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>my.environment.variables</string>
    <key>ProgramArguments</key>
    <array>
        <string>sh</string>
        <string>-c</string>
        <string>
            launchctl setenv XDG_CONFIG_HOME {{ env.HOME }}/.config;
            launchctl setenv XDG_CACHE_HOME {{ env.HOME }}/.cache;
            launchctl setenv XDG_DATA_HOME {{ env.HOME }}/.local/share;
            launchctl setenv XDG_STATE_HOME {{ env.HOME }}/.local/state;
            launchctl setenv XDG_BIN_HOME {{ env.HOME }}/.local/bin;
        </string>
    </array>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
